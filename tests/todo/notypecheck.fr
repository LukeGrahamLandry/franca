
main :: fn() void = {
    S :: @rec @struct(tag: Str, body: []*S);
    a := temp().alloc_zeroed(S, 2);
    a[0].body = @slice(a[1]&);
    a[1].tag = "a";
    it := find_tag(a[0]&, "a").unwrap();
    @assert_eq(it.tag, "a");
    // missing typecheck !! should be ?**S
    find_tag :: fn(it: *S, name: Str) ?*S =
        it.body&.find(fn(it) => it.tag == name);
}
