/*
// this is unreasonable
## After register allocation:
function :T0 $F2392() {
 @b0_start
    swapd R36, R35
    swapd R34, R33
    R34 =d add R34, R36
    R33 =d add R33, R35
    R1 =l cast R34
    R2 =l cast R33
    R34 =d cast R2
    R33 =d cast R1
    ret0 C8
}
// and the 130 lines that come directly out of emit_ir are even worse. 
// enough of the recovery is in elide_abi_slots that it doesn't even think it's small enough to inline. 
*/
main :: fn() void = {
    V :: Array(f64, 2);
    f :: fn(a: V, b: V) V #log_ir("PRh") = {
        c := @uninitialized V;
        inline_range(0, 2) { $i | 
            c&[i] = a&[i] + b&[i]; 
        };
        c
    };
    
    f((0, 1), (2, 3));
}
