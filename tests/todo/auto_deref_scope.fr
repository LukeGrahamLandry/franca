
main :: fn() void = {
    A :: import("@/examples/import_c/ffi.fr")'include(SRC);
    SRC :: "struct { int a; } a;";
    B :: @struct { a :: @static_mut @anon_literal(a := 0); };
    C :: B.a;
    D := @static_mut @anon_literal(a := @static_mut @anon_literal(a := 0));

    //A.a.a = 123;  // "Type Error: field 'a' does not exist on type ScopeId"
    A.a[].a = 123;  // ok
    // B.a.a = 123;  // "Type Error: field 'a' does not exist on type Type"
    C.a = 123;  // ok
    D.a.a = 123;  // here autoderef works fine
    
    // this is correctly an error for missing [] but the error message is misleading: "field 'a' does not exist ..."
    // A.a = (a = 123);
}
