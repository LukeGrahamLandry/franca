
// Expr.String automatically coerces to CStr because it feels friendly 
// but string literals with escapes desugar to calling __string_escapes 
// so that doesn't happen. but maybe no solution because i think doing 
// it for any const known string value is too much magic.  
main :: fn() void = {
    f :: fn(a: CStr) void = ();
    f("abc");
    f("a\nc");
}
