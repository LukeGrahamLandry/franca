
// this loops instantiating more specializations of the $const arg as negative numbers. 
// which technically is right because in sema you don't know the recursive cofactor call doesn't keep going.
// but maybe should have an error after some number of instantiations to warn you about the footgun
main :: fn() void = {
    cofactor :: fn($s: i64) f32 = determinant(s - 1);
    determinant :: fn($s: i64) f32 = {
        // works if you write it this way because the condition folds and the recursion can stop in the compiler 
        // @if(s == 2) return(0);
        
        not_a_constant := s == 2;
        if not_a_constant {
            return(0);
        };
        cofactor(s)
    };
    x := cofactor(3);
    @assert_eq(x, 0);
}
