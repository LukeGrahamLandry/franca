fn giant_const_slice() #test = {
    n :: 200_000;
    s :: import({
        code := u8.list(n*5, ast_alloc());
        code&.push_all("{ get_a_number :: fn(i: i64) f64 = {\nfloats := @const_slice(");
        range(0, n) {i|
            @fmt(code&, "%.0, ", i);
        };
        @fmt(code&, ");\n floats[i] }; };");
        code.items()
    });
    i := s'get_a_number(n - 1);
    @assert_eq(i, n.float() - 1);
}

fn giant_const_base64() #test = {
    n :: 200_000;
    s :: import({
        code := u8.list(n*5, ast_alloc());
        code&.push_all("""{ 
            embed_bytes :: fn(in: Str) []u8 #fold = {
                out := u8.list(ast_alloc());
                import("@/lib/encoding/base64.fr")'base64_decode(out&, in);
                out.items()
            };
            
            get_a_number :: fn(i: i64) f64 = {
                floats := f64.reinterpret_bytes(embed_bytes(
        """);
        @fmt(code&, "\"");
        floats := f64.list(n, ast_alloc());
        range(0, n) {i|
            floats&.push(i.float());
        };
        import("@/lib/encoding/base64.fr")'encode(code&, floats.items().interpret_as_bytes());
        @fmt(code&, "\"));\n floats[i] }; };");
        code.items()
    });
    i := s'get_a_number(n - 1);
    @assert_eq(i, n.float() - 1);
}

fn giant_expression_fold() #test = {
    n :: 750;  // TODO: make compile_expr iterative so can go higher without running out of stack
    assert_eq(add_literals_to(n)(), n);
    add_literals_to :: fn(total: i64) (@Fn() i64) #fold = {
        src := u8.list(total * 4, ast_alloc());
        @fmt(src&, "{ f :: fn() i64 = 0 ");
        range(0, total) { _ |
            @fmt(src&, "+ %", 1);
        };
        @fmt(src&, "; };");
        s := import(src.items());
        (@Fn() i64).const_eval(@{ @[@literal s].f })
    };
}
