{deck}
version:1
card:0
size:[512,342]
name:"rss.deck"

{card:home}
{widgets}
posts_grid:{"type":"grid","size":[314,312],"pos":[6,22],"locked":1,"volatile":1,"script":"home.0"}
button1:{"type":"button","size":[47,16],"pos":[325,22],"script":"home.1","text":"Load"}
feeds_grid:{"type":"grid","size":[185,291],"pos":[325,43],"locked":1,"volatile":1,"script":"home.2"}

{script:home.0}
on click row do
  url: (rows me.value)[row].link
  go[url]
end
{end}

{script:home.1}
on click do
  dir: "target/rss"
  out: ()
  each file in rows danger.dir[dir]
    # TODO: use danger.path
    path: "" fuse dir,"/",file.name
    data: danger.read[path]
    new_row: (("name", "data") dict (file.name, data))
    out: out, list new_row
  end
  feeds_grid.value: table out
end
{end}

{script:home.2}
on click row do
  out: ()
  feed: (rows me.value)[row]
  posts: readxml[feed.data]  
  
  # todo: cope with the atom ones too
  if posts[0].tag = "rss"
    rss_keys: "title","link","pubdate"
    posts: get_by_tag[posts[0] "channel"]
    each post in posts.children
      if post.tag = "item"
        fields: rss_keys dict each t in rss_keys get_by_tag[post t].children[0] end
        out: out, list fields
      end
    end
  end
  posts_grid.value: table out
end

on get_by_tag self tag do
  (extract value where each v in value v.tag = tag end from self.children)[0]
end

{end}

