{deck}
version:1
card:0
size:[512,342]
name:"gallery.deck"

{card:home}
script:"home.0"
{widgets}
input:{"type":"field","size":[225,265],"pos":[7,47],"volatile":1,"scrollbar":1,"style":"code"}
run:{"type":"button","size":[124,18],"pos":[59,318],"script":"home.1","text":"open deck"}
field1:{"type":"field","size":[225,15],"pos":[7,24],"locked":1,"align":"center","value":"paste the contents of a .deck file in the box below"}
field2:{"type":"field","size":[225,15],"pos":[258,24],"locked":1,"align":"center","value":"or click a link to open an example"}
link_field:{"type":"field","size":[222,265],"pos":[260,46],"locked":1,"volatile":1,"script":"home.2","scrollbar":1}
field3:{"type":"field","size":[225,25],"pos":[259,315],"locked":1,"align":"center","value":"(in the franca build of decker)\npress cmd+shift+0 to return to this screen"}

{script:home.0}
on view do
  link_field.event["view"]
end
{end}

{script:home.1}
on click do
 script: input.text
 new: newdeck[script]
 danger.open[new]
end
{end}

{script:home.2}
on link val do
 danger.open[val]
end

on view do
  if rtext.len[me.text] = 0 
     input.text: deck.encoded
     dirs: ("tests/decks", "target/franca/deps/d66643b3e6e1893704b2b55750d08b989889b5afd6a401f4a7ea6aa3e478b0dd/examples/decks")
     each dir in dirs
       each file in rows danger.dir[dir]
         # TODO: use danger.path
         link: "" fuse dir,"/",file.name
         link: rtext.make[file.name "" link]
         me.value: rtext.cat[me.value "- " link "\n"]
       end
       me.value: rtext.cat[me.value "\n"]
     end
   end
end
{end}

