out_time:{"type":"field","size":[121,14],"pos":[376,166],"locked":1,"volatile":1,"style":"plain","align":"center"}

{script:home.0}
on draw_mandelbrot do
  start_t: (sys.ms,sys.ops)
  x:0
  scale:in_scale.value/10000
  start_pos:(in_x.value, in_y.value)/100
  
  my_colors: range((("black","white","brown","tan","lightgray","mediumgray","darkgray") drop colors))
  max_steps:20
  while x < me.lsize[0] 
     y:0
     while y < me.lsize[1] 
       i:0
       z: (0,0)
       c: start_pos + ((x,y)*scale)
       zSq: z*z
       while (i < max_steps) & ((sSq[0]+zSq[1]) < 4)
         z[1]: z[0] * 2 * z[1]
         z[0]: zSq[0] - zSq[1]
         z: z + c
         zSq: z * z
         i: i + 1
       end
       
       me[(x,y)]: if (i = max_steps) colors.black else my_colors[(count my_colors) % i] end
       
       y:y+1
      end
    x:x+1
  end
  end_t: (sys.ms, sys.ops)
  out_time.text: "%ims %iops" format (end_t-start_t)
end
{end}

{script:home.1}
on click do
 drawing.event.draw_mandelbrot[]
end
