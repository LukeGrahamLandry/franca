{card:home}
{widgets}
drawing:{"type":"canvas","size":[365,315],"pos":[5,21],"locked":1,"volatile":1,"script":"home.0","scale":5}
in_scale:{"type":"slider","size":[100,25],"pos":[389,31],"interval":[1,1000],"value":480,"format":"scale %f","style":"bar"}
in_x:{"type":"slider","size":[100,25],"pos":[389,66],"interval":[-300,150],"value":-230,"format":"X %f","style":"bar"}
in_y:{"type":"slider","size":[100,25],"pos":[389,100],"interval":[-300,50],"value":-147,"format":"Y %f","style":"bar"}
