// this program embeds https://beyondloom.com/decker/ which is 
// "a multimedia platform for creating and sharing interactive documents, with sound, images, hypertext, and scripted behavior". 
// it uses most of Native-Decker (so serves as a test of my c compiler) 
// but reimplements the io part (io_sdl2.h) with my @/graphics (instead of sdl). 
// not implemented: sound/recording, transparent window, window_set_size
// TODO: clipboard, open_url, base_path, embed resources, cursor, readimage, fullscreen, -DDANGER_ZONE
// TODO: don't send CHAR event when holding a modifier key that means copy or whatever
// TODO: cope if the window is too small
// TODO: make it work in web playground. examples/os/user/libc needs (stat.st_size, gmtime). 
// TODO: add this to tests/gpu.fr
// TODO: deck that is a gallary of the example decks 
//       and one for the lilt examples like http://beyondloom.com/tools/trylil.html
// TODO: run their tests/*.lil in autotest (because the point of this whole thing is to test my c compiler)

decker_src :: => import("@/examples/fetch.fr")'group(
    url = "https://github.com/JohnEarnest/Decker/archive/54c46bb0e596b1f12d92f99a75c1b8fc331e08c9.tar.gz",
    legacy = "4ab41baa074f2b3d1078c61950f920e10c18dda2201010d8724b7b1d53ebffdd",
);

driver :: fn(vtable: *ImportVTable) void = Easy'build_for_graphics(vtable, @source_file_name());
main :: fn() void = {
    io := Decker.io_vtable;
    io.run = fn() = Easy'start(State);
    io.get_texture = io_get_texture;
    io.process_events = io_process_events;
    
    args := cli_args();
    args = args.slice(int(args[1].str().ends_with(".fr")), args.len);  // :hack
    Syscall'exit(Decker'main(args.len().intcast(), bit_cast_unchecked(*CStr, **i8, args.as_ptr())));
};

io_get_texture :: fn(i, w, h) = {
    state := the_state[];
    it := state.textures&[i]&;
    n := intcast(w*h);
    if n != it.buf.len {
        state.sg.destroy(it.img);
        general_allocator().dealloc(u32, it.buf);
        it.img = state.sg.make(
            width = w,
            height = h,
            pixel_format = .BGRA8,
            data = zeroed(Sg.ImageData),
            usage = .DYNAMIC,
        );
        it.buf = general_allocator().alloc_zeroed(u32, n);
    };
    it.buf.ptr
};

io_process_events :: fn(disp, size, scale) = {
    state := the_state[];
    S :: fn(x) => bit_cast_unchecked(@type x, *i8, x);
    B :: fn(x) => x.int().intcast();
    I :: fn(x) => x.cast().int().intcast();
    each state.events& { event |
        @match(event.type) {
            fn QUIT_REQUESTED() => {
                if Decker.should_exit[] == 0 {
                    state.sapp.requests.quit = false;
                    Decker'event_quit();
                };
            }
            fn CHAR() => if event.char_code != 127 && event.char_code != 27 {
                buf := Arena'stack_alloc(16).alloc_zeroed(u8, 16);
                Utf8 :: import("@/examples/import_c/unicode.fr");
                Utf8'encode_utf8(buf, event.char_code);
                s := Decker'lmutf8(S(buf.ptr));
                Decker'field_input(s.sv);
            }
            fn MOUSE_MOVE() => {
                // TODO: this is fucked. presumably because im always drawing it in top left and big instead of using framebuffer_dest
                b: Decker.pair = (x = (disp.x-(size.x*scale))/2, y = (disp.y-(size.y*scale))/2);
                raw: Decker.pair = (x = I(event.mouse_x), y = I(event.mouse_y));
                scaled: Decker.pair = (x = (raw.x-b.x)/scale, y = (raw.y-b.y)/scale);
                Decker'event_pointer_move(raw, scaled);
            }
            fn MOUSE_SCROLL() => {
                Decker'event_scroll(x = I(event.scroll_x), y = I(event.scroll_y));
            }
            fn FILES_DROPPED() => for event.drop { path |
                x := path.as_cstr();
                Decker'event_file(S(path.as_cstr()));
            };
            @default => {
                if @is(event.type, .MOUSE_DOWN, .MOUSE_UP) {
                    Decker'event_pointer_button(B(event.mouse_button == .LEFT), B(event.mouse_button == .MIDDLE), B(event.type == .MOUSE_DOWN));
                };
                if @is(event.type, .KEY_DOWN, .KEY_UP) {
                    name := S(event.key_code.name_str().as_cstr());
                    (k: i32, m: i32) := (event.key_code.raw().int().intcast(), event.modifiers.repr.bitcast());
                    Decker'event_key(k, m, B(event.type == .KEY_DOWN), name);
                };
            };
        };
    };
    state.events&.clear();
};

the_state :: @static_mut zeroed(*State);

#use("@/graphics/lib.fr");
State :: @struct {
    HIGH_DPI :: false;
    NO_EXIT_ON_CMD_W :: true;
    draw: Sgl.Self;
    sg: *Sg.Self;
    sapp: *Sapp.Self;
    
    textures: Array(Texture, 3);
    events: List(Sapp.Event);
};

Texture :: @struct(img: Sg.Image, buf: []u32);

fn on_init(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    sapp.desc.enable_clipboard = true;
    sapp.desc.enable_dragndrop = true;
    the_state[] = state;
    state.sg = sg; state.sapp = sapp;
    Decker.io_vtable[].display_size = (x = sapp.width().intcast(), y = sapp.height().intcast());
    state.draw&.setup(
        allocator = general_allocator(),
        sg = sg,
    );
    state.events = list(general_allocator());
}

fn on_render(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    if Decker.should_exit[] != 0 {
        sapp.requests.quit = true;
        return();
    };
    Decker'tick(Decker.io_vtable[].env);
    Decker'sync();
    
    sgl := state.draw&;
    
    sgl.defaults();
    sgl.viewport(0.intcast(), 0.intcast(), sapp.width().intcast(), sapp.height().intcast(), true);
    
    // ughhh
    range(0, Decker.io_vtable.image_i) { i |
        it := state.textures&[i]&;
        sg.update_image(it.img, @ref SubImage(it.buf.interpret_as_bytes()));
        
        sgl.texturing_enabled = true;
        sgl.texture(it.img, (id = Sg.INVALID_ID));
        sgl.begin(.QUADS);
        sgl.load_identity();
        sgl.translate(-1, 1, 0.0);
        sgl.scale(2, 2, 0.0);
        sgl.rotate(PI, 1.0, 0.0, 0.0);
        
        ::Array(Decker.ImageX, 3);
        t := Decker.io_vtable[].images&[i]&;
        src_w := t.src_size.x.intcast().float().cast();
        src_h := t.src_size.y.intcast().float().cast();
        dst_x := t.dest.x.intcast().float().cast();
        dst_y := t.dest.y.intcast().float().cast();
        dst_w := t.dest.w.intcast().float().cast();
        dst_h := t.dest.h.intcast().float().cast();
        dsp_w := sapp.width().float().cast();
        dsp_h := sapp.height().float().cast();
        
        x1 := dst_x/dsp_w;
        x2 := x1 + dst_w/dsp_w;
        y1 := dst_y/dsp_h;
        y2 := y1 + dst_h/dsp_h;
        
        sgl.v2f_t2f(x1, y1, 0, 0);
        sgl.v2f_t2f(x2, y1, 1, 0);
        sgl.v2f_t2f(x2, y2, 1, 1);
        sgl.v2f_t2f(x1, y2, 0, 1);
        
        sgl.end();
    };
    Decker.io_vtable[].image_i = 0;
    
    Easy'glue_begin_pass(sapp, sg, zeroed(Sg.PassAction));
    sgl.draw_layer(sg, 0);
    sg.end_pass();
    sg.commit();
};

fn on_event(state: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = {
    state.events&.push(event[]);  // TODO: this is silly, they're already collected. should have a flag to not call on_event. 
    if event.type == .RESIZED {
        Decker.io_vtable[].display_size = (x = sapp.width().intcast(), y = sapp.height().intcast());
    };
}

Decker :: {
    root := decker_src();
    
    resources := """
        char *js_decker_html = "";
        int js_decker_html_len = 0;
        char *js_lil_js = "";
        int js_lil_js_len = 0;
        char *js_danger_js = "";
        int js_danger_js_len = 0;
        char *js_decker_js = "";
        int js_decker_js_len = 0;
        char *examples_decks_tour_deck = "";
        int examples_decks_tour_deck_len = 0;
        
    """;  // TODO: generated
    write_entire_file_or_crash(@tfmt("%/c/resources.h", root), resources);
    write_entire_file_or_crash(@tfmt("%/c/SDL_version.h", root), "#define SDL_VERSION_ATLEAST(...) 1\n");
    write_entire_file_or_crash(@tfmt("%/c/io_sdl2.h", root), io_src);
    version := read_entire_file_or_crash(temp(), @tfmt("%/VERSION", root));
    import("@/examples/import_c/ffi.fr")'include(@tfmt(SRC, root, version))
};

SRC :: """
    #add_include_path "%/c/"
    #define VERSION "%"
    typedef unsigned char Uint8;
    typedef unsigned int Uint32;
    typedef short Sint16;
    #include "decker.c"
""";

io_src :: """

typedef struct {
    rect dest;
    pair src_size;
} ImageX;

struct {
    void (*run)();
    unsigned int *(*get_texture)(long i, int w, int h);
    void (*process_events)(pair disp, pair size, int scale); 
    pair display_size;
    lv *env;
    ImageX images[3];
    long image_i;
} io_vtable;

#include "assert.h"
int gil;  // TODO: no threads so doesn't matter?
void interpreter_lock() { gil = 1; }
void interpreter_unlock() { gil = 0; }
void window_set_title(char *title) {}
lv* readwav(char* name, int rawsamples) { return sound_make(lms(0)); }

lv* readimage(char*path, int grayscale) { 
    printf("TODO: readimage %s %d\n", path, grayscale);
    return image_empty(); 
}

// TODO: what's the difference? is get_display_size asking for my actual screen?
pair window_get_size(void) { return io_vtable.display_size; }
pair get_display_size(){ return io_vtable.display_size; }

void window_set_size(pair wsize, pair size, int scale) {
}

int framebuffer_flip(pair disp,pair size,int scale,int mask,int frame,char*pal,lv*buffer) {
    void *p = io_vtable.get_texture(io_vtable.image_i, size.x, size.y);
	draw_frame(pal,buffer,p,size.x*4,frame,mask);
    io_vtable.images[io_vtable.image_i] = (ImageX) {
        .dest = (rect) {(disp.x-scale*size.x)/2,(disp.y-scale*size.y)/2,scale*size.x,scale*size.y},
        .src_size = size,  // TODO: *scale?
    };
    io_vtable.image_i += 1;
    return 1;
}

void toolbar_flip(lv*buffer,int frame,char*pal,rect dest) {
    pair size=buff_size(buffer);
    void *p = io_vtable.get_texture(io_vtable.image_i, size.x, size.y);
    draw_frame(pal,buffer,p,size.x*4,frame,0);
    io_vtable.images[io_vtable.image_i] = (ImageX) { .dest = dest, .src_size = size };
    io_vtable.image_i += 1;
}

void finish_flip(void) {}

void process_events(pair disp, pair size, int scale) { 
    io_vtable.process_events(disp, size, scale);
}

void window_set_fullscreen(int) {}
void window_set_opacity(float) {}
void window_set_cursor(int) {}
void io_init(void) {}

void io_run(lv*env) {
    io_vtable.env = env;
    io_vtable.run();
}

int nosound = 1;

// from io_sdl1.h
char*clip_data=NULL;
int clip_size=0;
lv* get_clip(void){return clip_data?lmcstr(clip_data): lmistr("");}
void set_clip(lv*x){
	x=ls(x);
	if(!clip_data    ){clip_size=x->c,clip_data=malloc(x->c);}
	if(clip_size<x->c){clip_size=x->c,clip_data=realloc(clip_data,x->c);}
	memcpy(clip_data,x->sv,clip_size);
}

