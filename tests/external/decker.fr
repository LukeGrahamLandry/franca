FEAT_DANGER_ZONE :: true;

driver :: fn(vtable: *ImportVTable) void = Easy'build_for_graphics(vtable, @source_file_name());
main :: fn() void = {
    io := Decker.io_vtable;
    io.run = fn() = Easy'start(State);
    io.get_texture = io_get_texture;
    io.process_events = io_process_events;
    io.read_image = io_read_image;
    io.get_clip = io_get_clip;
    io.set_clip = io_set_clip;
    io.set_title = io_set_title;
    
    @if(query_current_arch() == .wasm32) @eprintln("warning: THIS (running in web playground) IS VERY UNFINISHED. i need to do more libc stuff");
    
    args := cli_args();
    args = args.slice(int(args.len >= 2 && args[1].str().ends_with(".fr")), args.len);  // :hack
    Syscall'exit(Decker'main(args.len().intcast(), bit_cast_unchecked(*CStr, **i8, args.as_ptr())));
};

io_get_texture :: fn(i, w, h) = {
    state := the_state[];
    it := state.textures&[i]&;
    n := intcast(w*h);
    if n != it.buf.len {
        state.sg.destroy(it.img);
        general_allocator().dealloc(u32, it.buf);
        it.img = state.sg.make(
            width = w,
            height = h,
            pixel_format = .BGRA8,
            data = zeroed(Sg.ImageData),
            usage = .DYNAMIC,
        );
        it.buf = general_allocator().alloc_zeroed(u32, n);
    };
    it.buf.ptr
};

io_process_events :: fn(disp, size, scale) = {
    state := the_state[];
    S :: fn(x) => bit_cast_unchecked(@type x, *i8, x);
    B :: fn(x) => x.int().intcast();
    I :: fn(x) => x.cast().int().intcast();
    each state.events& { event |
        @match(event.type) {
            fn QUIT_REQUESTED() => {
                if Decker.should_exit[] == 0 {
                    state.sapp.requests.quit = false;
                    Decker'event_quit();
                };
            }
            fn CHAR() => if event.char_code != 127 && event.char_code != 27 && event.modifiers.get(.super) == 0 && event.modifiers.get(.control) == 0 {
                buf := Arena'stack_alloc(16).alloc_zeroed(u8, 16);
                Utf8 :: import("@/examples/import_c/unicode.fr");
                buf.len = Utf8'encode_utf8(buf, event.char_code);
                s := buf.lil_str();
                Decker'field_input(s.sv);
            }
            fn MOUSE_MOVE() => {
                b: Decker.pair = (x = (disp.x-(size.x*scale))/2, y = (disp.y-(size.y*scale))/2);
                raw: Decker.pair = (x = I(event.mouse_x), y = I(event.mouse_y));
                scaled: Decker.pair = (x = (raw.x-b.x)/scale, y = (raw.y-b.y)/scale);
                Decker'event_pointer_move(raw, scaled);
            }
            fn MOUSE_SCROLL() => {
                Decker'event_scroll(x = I(event.scroll_x), y = I(event.scroll_y));
            }
            fn FILES_DROPPED() => for event.drop { path |
                Decker'event_file(S(path.as_cstr()));
            };
            @default => {
                if @is(event.type, .MOUSE_DOWN, .MOUSE_UP) {                
                    Decker'event_pointer_button(B(event.mouse_button == .LEFT), B(event.mouse_button == .MIDDLE), B(event.type == .MOUSE_DOWN));
                };
                if @is(event.type, .KEY_DOWN, .KEY_UP) {
                    name := S(event.key_code.name_str().as_cstr());
                    (k: i64, m: i32) := (event.key_code.raw().int(), event.modifiers.repr.bitcast());
                    if k >= "A".char() && k <= "Z".char() {
                        k -= ("A".char() - "a".char());
                    };
                    Decker'event_key(k.intcast(), m, B(event.type == .KEY_DOWN), name);
                };
                
                // relies on running in the franca source directory
                decks := example_deck_paths;
                @if(decks.len() > 0)
                if event.type == .KEY_DOWN && event.modifiers.get(.shift) == 1 && event.modifiers.get(.super) == 1 {
                    I :: @static_mut 0;
                    if !event.key_repeat && @is(event.key_code, .COMMA, .PERIOD) {
                        I[] = I[].add(@if(event.key_code == .COMMA, 1, -1)).add(decks.len()).mod(decks.len());
                        deck_path := decks[I[]].as_cstr();
                        Decker'open_deck_by_path(deck_path.ptr);
                    };
                };
            };
        };
    };
    state.events&.clear();
};

// this is only used for importing images. the %%IMG... strings in decks are already a format it understands.
io_read_image :: fn(path_cstr: *u8, grayscale: i32) = {
    path: CStr = (ptr = path_cstr);
    img := read_entire_file(temp(), path.str()) 
        || return(Decker'image_empty());
    pixels, w, h := Viewer'stbi_load(img).or(fn(err) => {
        return(Decker'image_empty());
    });
    it := Decker'convert_image(pixels.ptr, w, h, grayscale);
    @if(Viewer.FEAT_PNG) Viewer'Stb'stbi_image_free(u8.raw_from_ptr(pixels.ptr));
    it
}
Viewer :: import("@/examples/gpu/viewer.fr");

io_set_title :: fn(s) = {
    ::ptr_utils(@type the_state[][]);
    @if(the_state[].is_null()) return();  // called before init. TODO: save it?
    
    s: CStr = (ptr = s);
    s := s.str().shallow_copy(temp());  // called with stack memory
    the_state.sapp.set_window_title(s);
}

the_state :: @static_mut zeroed(*State);

#use("@/graphics/lib.fr");
State :: @struct {
    HIGH_DPI :: false;
    NO_EXIT_ON_CMD_W :: true;
    draw: Sgl.Self;
    sg: *Sg.Self;
    sapp: *Sapp.Self;
    
    textures: Array(Texture, 3);
    events: List(Sapp.Event);
    clipboard: List(u8);
};

Texture :: @struct(img: Sg.Image, buf: []u32);

fn on_init(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    sapp.desc.enable_clipboard = true;
    sapp.desc.enable_dragndrop = true;
    
    the_state[] = state;
    state.sg = sg; state.sapp = sapp;
    Decker.io_vtable[].window_size = (x = sapp.width().intcast(), y = sapp.height().intcast());
    state.draw&.setup(
        allocator = general_allocator(),
        sg = sg,
    );
    state.events = list(general_allocator());
    state.clipboard = list(general_allocator());
    sapp.set_window_title("Decker");
    
    @if(Viewer.FEAT_PNG) @if_let(Viewer'stbi_load(app_icon_png[])) fn Ok(pixels, w, h) => {
        sapp.set_icon(temp().alloc_init(Sapp.ImageDesc, 1, fn(_) => 
            (pixels = pixels.shallow_copy(temp()), width = w.intcast(), height = h.intcast())));
        Viewer'Stb'stbi_image_free(u8.raw_from_ptr(pixels.ptr));
    };
    
    sapp.requests.fake_paste_event = true;  // see fn FOCUSED() =>
}

fn on_render(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    if Decker.should_exit[] != 0 {
        sapp.requests.quit = true;
        return();
    };
    Decker'tick(Decker.io_vtable[].env);
    Decker'sync();
    
    sgl := state.draw&;
    
    sgl.defaults();
    sgl.viewport(0.intcast(), 0.intcast(), sapp.width().intcast(), sapp.height().intcast(), true);
    
    range(0, Decker.io_vtable.image_i) { i |
        it := state.textures&[i]&;
        sg.update_image(it.img, @ref SubImage(it.buf.interpret_as_bytes()));
        
        sgl.texturing_enabled = true;
        sgl.texture(it.img, (id = Sg.INVALID_ID));
        sgl.begin(.QUADS);
        sgl.load_identity();
        sgl.translate(-1, 1, 0.0);
        sgl.scale(2, 2, 0.0);
        sgl.rotate(PI, 1.0, 0.0, 0.0);
        
        ::Array(Decker.rect, 3);
        t := @anon_literal(dest := Decker.io_vtable[].images&[i]&);
        dst_x := t.dest.x.intcast().float().cast();
        dst_y := t.dest.y.intcast().float().cast();
        dst_w := t.dest.w.intcast().float().cast();
        dst_h := t.dest.h.intcast().float().cast();
        dsp_w := sapp.width().float().cast();
        dsp_h := sapp.height().float().cast();
        
        x1 := dst_x/dsp_w;
        x2 := x1 + dst_w/dsp_w;
        y1 := dst_y/dsp_h;
        y2 := y1 + dst_h/dsp_h;
        
        sgl.v2f_t2f(x1, y1, 0, 0);
        sgl.v2f_t2f(x2, y1, 1, 0);
        sgl.v2f_t2f(x2, y2, 1, 1);
        sgl.v2f_t2f(x1, y2, 0, 1);
        
        sgl.end();
    };
    Decker.io_vtable[].image_i = 0;
    
    Easy'glue_begin_pass(sapp, sg, zeroed(Sg.PassAction));
    sgl.draw_layer(sg, 0);
    sg.end_pass();
    sg.commit();
};

fn on_event(state: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = {
    @match(event.type) {
        fn RESIZED() => {
            Decker.io_vtable[].window_size = (x = sapp.width().intcast(), y = sapp.height().intcast());
        }
        fn CLIPBOARD_PASTED() => {
            // the paste event is after the key down event that decker responds to so can't do this when iterating events later
            state.clipboard&.clear();
            state.clipboard&.push_all(event.pasted);
        }
        fn FOCUSED() => {
            // rn i don't let you ask for the clipboard in the middle of the frame. 
            // this makes it work if you copy something from another app and then come back 
            // and paste with the menu instead of the shortcut. 
            sapp.requests.fake_paste_event = true;
        }
        // TODO: this is silly, they're already collected. should have a flag to not call on_event. 
        @default => state.events&.push(event[]);
    };
}

io_get_clip :: fn() = the_state.clipboard.items().lil_str();
io_set_clip :: fn(it) = {
    it := Decker'drom_to_utf8(it);
    it := bit_cast_unchecked(*i8, *u8, it.sv).slice(it.c.intcast());
    @debug_assert_eq(it.end_pointer()[], 0);

    state := the_state[];
    clip := state.clipboard&;
    clip.clear();
    clip.push_all(it);
    state.sapp.set_clipboard_string(clip.items());
}

fn on_cleanup(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    // TODO
}

example_deck_paths :: @static_mut @as([]Str) empty();
app_icon_png :: @static_mut "";
Decker :: {
    root := Foreign'decker();
    if read_entire_file(ast_alloc(), @tfmt("%/icon_32x32.png", root)) { it |
        app_icon_png[] = it;
    };
    example_deck_paths[] = collect_deck_paths(root);
    
    resources := ra(root, @const_slice("js/decker.html", "js/lil.js", "js/danger.js", "js/decker.js", "examples/decks/tour.deck"));
    write_entire_file_or_crash(@tfmt("%/c/resources.h", root), resources);
    write_entire_file_or_crash(@tfmt("%/c/SDL_version.h", root), "#define SDL_VERSION_ATLEAST(...) 1\n");
    write_entire_file_or_crash(@tfmt("%/c/io_sdl2.h", root), io_src);
    version := read_entire_file_or_crash(temp(), @tfmt("%/VERSION", root));
    danger := @if(FEAT_DANGER_ZONE, "#define DANGER_ZONE 1", "");
    import("@/examples/import_c/ffi.fr")'include(@tfmt(SRC, danger, root, version))
};

collect_deck_paths :: fn(root: Str) []Str = {
    out := Str.list(ast_alloc());
    add_decks(@tfmt("%/examples/decks", root));
    add_decks("tests/decks");
    add_decks :: fn(dir) => {
        @if_let(collect_directory_ordered(dir, temp(), temp())) fn Ok(files) => {
            for files { it |
                if it.name.ends_with(".deck") {
                    out&.push(@afmt(ast_alloc(), "%/%", dir, it.name));
                };
            };
        };
    };
    out.items()
}

SRC :: """
    %
    #add_include_path "%/c"
    #define VERSION "%"
    typedef unsigned char Uint8;
    typedef unsigned int Uint32;
    typedef short Sint16;
    #include "decker.c"
    
    void open_deck_by_path(Uint8 *file) {
        if(kiosk||menus_off())return;
       	if(autosave&&strlen(document_path)){save_deck(lmcstr(document_path));}
        // TODO: if(dirty) show warning popup
        load_deck(deck_get(n_read(NULL,l_list(lmcstr(file))))),set_path(file);
    }
""";

io_src :: """
struct {
    void (*run)(void);
    unsigned int *(*get_texture)(long i, int w, int h);
    void (*process_events)(pair disp, pair size, int scale); 
    lv *(*read_image)(unsigned char* path, int grayscale);
    lv *(*get_clip)(void);
    void (*set_clip)(lv *x);
    void (*set_title)(unsigned char*);
    pair window_size;
    lv *env;
    rect images[3];
    long image_i;
} io_vtable;

#include "assert.h"
int gil;  // TODO: no threads so doesn't matter?
void interpreter_lock() { gil = 1; }
void interpreter_unlock() { gil = 0; }
void window_set_title(char *title) { io_vtable.set_title(title); }
// TODO: at least use lilt.c/n_readwav
lv* readwav(char* name, int rawsamples) { return sound_make(lms(0)); }

lv* readimage(char*path, int grayscale) { return io_vtable.read_image(path, grayscale); }

// TODO: get_display_size asking for my actual screen? why?
pair window_get_size(void) { return io_vtable.window_size; }
pair get_display_size(){ return io_vtable.window_size; }

void window_set_size(pair wsize, pair size, int scale) {
}

int framebuffer_flip(pair disp,pair size,int scale,int mask,int frame,char*pal,lv*buffer) {
    void *p = io_vtable.get_texture(io_vtable.image_i, size.x, size.y);
	draw_frame(pal,buffer,p,size.x*4,frame,mask);
	frame_count++;
    io_vtable.images[io_vtable.image_i] =
        (rect) {(disp.x-scale*size.x)/2,(disp.y-scale*size.y)/2,scale*size.x,scale*size.y};
    io_vtable.image_i += 1;
    return 1;
}

void toolbar_flip(lv*buffer,int frame,char*pal,rect dest) {
    pair size=buff_size(buffer);
    void *p = io_vtable.get_texture(io_vtable.image_i, size.x, size.y);
    draw_frame(pal,buffer,p,size.x*4,frame,0);
    io_vtable.images[io_vtable.image_i] = dest;
    io_vtable.image_i += 1;
}

void process_events(pair disp, pair size, int scale) { 
    io_vtable.process_events(disp, size, scale);
}

void finish_flip(void) {}
void window_set_fullscreen(int) {}
void window_set_opacity(float) {}
void window_set_cursor(int) {}
void io_init(void) {}

void io_run(lv*env) {
    io_vtable.env = env;
    io_vtable.run();
}

lv* get_clip(void) { return io_vtable.get_clip(); }
void set_clip(lv* x) { io_vtable.set_clip(x); }

int nosound = 1;

// from io_sdl1.h

lv *convert_image(Uint8*p,int w,int h,int grayscale) {
    Uint32 *pixels = p;
    lv*i=lmbuff((pair){w,h});
    for(int y=0;y<h;y++)for(int x=0;x<w;x++){
        Uint32 v=pixels[x+(y*w)];Uint8 cr,cg,cb,ca;
        cr=v&0xff;cg=(v>>8)&0xff;cb=(v>>16)&0xff;ca=(v>>24)&0xff;
        i->sv[x+y*w]=(ca!=0xFF)?(grayscale?0xFF:0x00):readcolor(cr,cg,cb,grayscale);
    }
    return image_make(i);
}

