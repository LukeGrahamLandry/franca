""";

// TODO: this would be less annoying if it was easy to import franca constants from the c. 
//       for this situation it would almost work with just having them be multable globals 
//       and setting them at comptime from franca but i don't rebake so not good enough. 
ra :: fn(root: Str, resource_paths: []Str) Str = {
    out := @ref u8.list(2_700_000, temp());
    for resource_paths { path |
        data := read_entire_file_or_crash(temp(), @tfmt("%/%", root, path));
        name := temp().alloc_init(u8, path.len, fn(i) => 
            @if("/.".contains(path[i]), "_".ascii(), path[i]));
        @fmt(out, "unsigned char %[] = {", name);
        for data { c |
            @fmt(out, "%,", fmt_hex(c));
        };
        @fmt(out, "};\nint %_len = sizeof(%);\n", name, name);
    };
    out.items()
}

lil_str :: fn(s: Str) *Decker.lv = {
    r := Decker'str_new();
    p := bit_cast_unchecked(*u8, *i8, s.ptr);
    Decker'utf8_to_drom(r&, p, s.len.intcast());
    return Decker'lmstr(r);
}
