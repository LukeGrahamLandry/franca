
main :: fn() void = {
    @assert(import("@/lib/sys/process.fr")'query_current_arch() == .aarch64 && query_current_os() == .linux);
    d, i := get_cacheline_size();
    @println("dcache,icache = %,%", d, i);
}

get_cacheline_size :: AsmFunctionArmOnly(fn() Ty(i64, i64) = (), { 
    #use("@/backend/arm64/bits.fr"); 
@const_slice(
    movz(.X64, x3, 4, .Left0),
    mrs(x2, .CTR_EL0),  // DminLine = info[19..=16]; IminLine = info[3..=0] ("log2 of the number of words")

    add_sr(.X64, x0, xzr, x2, .LSL, @as(u6) @as(i64) 63-19),
    add_sr(.X64, x0, xzr, x0, .LSR, @as(u6) @as(i64) 63-(19-16)),
    lslv(.X64, x0, x3, x0),
    
    add_sr(.X64, x1, xzr, x2, .LSL, @as(u6) @as(i64) 63-3),
    add_sr(.X64, x1, xzr, x1, .LSR, @as(u6) @as(i64) 63-(3-0)),
    lslv(.X64, x1, x3, x1),
    
    ret(),
)});
