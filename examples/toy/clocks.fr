main :: fn() void = {
    clock_getres :: @(Syscall'S) ("clock_getres") fn(clk_id: i64, out: *TimeSpec) i32 #libc #syscall(114, 229, NOSYS);
    S :: Type.scope_of(Posix.CLOCK);
    inline_for get_constants(S) { $name |
        clock_id := @run i64.get_constant(S, name[]).unwrap();
        t := zeroed(TimeSpec);
        Posix'clock_gettime(clock_id, t&);
        clock_id := Posix'fix_number(MacosLibc.CLOCK, LinuxLibc.CLOCK, Posix.CLOCK, clock_id);
        r := zeroed(TimeSpec);
        clock_getres(clock_id, r&);
        @println("(name=%, resolution=%, current=%)", @run name[].str(), r, t);
    };
}
