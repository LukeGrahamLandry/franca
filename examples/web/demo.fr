
main :: fn() void = {
    // TODO: don't read+write if already a path
    args := get_args();
    lang := args.lang;
    path := @match(args.input) {
        fn None() => panic("missing -file or ---literal_input");
        fn File(it) => it;
        fn Src(it) => {
            ext := @switch(args.lang) {
                @case("franca") => "fr";
                @case("qbe") => "ssa";
                @default => args.lang;
            };
            path := @tfmt("target/demo_input.%", ext);
            write_entire_file_or_crash(path, it);
            path
        };
    };
    @if(lang != "franca") @eprint(">>> to make an apple pie from scratch you must first jit the compiler.\n");
    
    dest_path := "target/a.out";
    a := @ref Str.list(temp());
    @switch(lang) {
        @case("franca") => run_franca(args, path, dest_path, a);
        @case("c") => run_c(args, path, dest_path, a);
        @case("qbe") => run_qbe(args, path, dest_path, a);
        @case("kaleidoscope") => {
            @assert_eq(args.target.type, .JitOnly, "% aot not implemented", args.lang);
            a.push_all(@slice("examples/kaleidoscope.fr", "-file", path));
        };
        @case("lox") => {
            @assert_eq(args.target.type, .JitOnly, "% aot not implemented", args.lang);
            a.push_all(@slice("examples/lox/lox_main.fr", "-file", path));
        };
        @case("") => panic("USAGE: -lang [franca, c, qbe] -file [examples/toy/hello.fr]");
        @default => @panic("unknown -lang %", lang);
    };
    if a.len != 0 {
        ok := run_cmd_blocking("franca", a.items());
        @assert(ok);
    };
    if args.target.type != .JitOnly {
        bytes := read_entire_file_or_crash(temp(), dest_path);
        yield_file(bytes);
    };
}

yield_file :: fn(bytes: Str) void = {
    js_write :: fn(id: i64, ptr: *u8, len: i64) i64 #weak #import("libc");
    r := js_write(0xBBBB0001, bytes.ptr, bytes.len);
    @assert_eq(r, bytes.len, "failed yield_file");
}

CompileArgs :: @struct {
    logging: Str;
    target: QbeTargetEnv;
    input: @tagged(None: void, File: Str, Src: Str);
    lang: Str;
    gfx: bool;
    unsafe: bool;
};

get_args :: fn() CompileArgs = {
    a := cli_args();
    out: CompileArgs = (logging = "", target = (
        arch = query_current_arch(), 
        os = query_current_os(), 
        type = .JitOnly,
    ), lang = "", input = .None, gfx = false, unsafe = false);
    range(0, a.len) { i |
        value := @if(i + 1 < a.len, a[i + 1].str(), "");
        if a[i] == "---literal_input" {
            out.input = (Src = value);
        }
        if a[i] == "-d" {
            out.logging = value;
        }
        if a[i] == "-lang" {| out.lang = value; };
        if a[i] == "-gfx" {| out.gfx = true; };
        if a[i] == "-unsafe" {| out.unsafe = true; };
        
        if a[i] == "-file" {
            out.input = (File = value);
        }
        if a[i] == "-target" {
            out.target.type = @if(value == "wasm-jit", .JitOnly, .Exe);
            // TODO: decide what OS to say for wasm... wasi? freestanding? 
            (ar: Arch, os: Os) := @switch(value) {
                @case("wasm-jit") => (.wasm32, .linux);
                @case("wasm-aot") => (.wasm32, .linux);
                @case("arm64-macos") => (.aarch64, .macos);
                @case("amd64-macos") => (.x86_64, .macos);
                @case("arm64-linux") => (.aarch64, .linux);
                @case("amd64-linux") => (.x86_64, .linux);
                @case("riscv64-linux") => (.rv64, .linux);
                @default => @panic("invalid -target '%'", value);
            };
            out.target.arch = ar;
            out.target.os = os;
        }
    };
    out
}

run_franca :: fn(args: CompileArgs, path: Str, dest_path: Str, a: *List(Str)) void = {
    gfx := args.gfx;  // :HackyGraphicsDetection
    if args.target.type != .JitOnly {
        if !gfx {
            a.push_all(@slice("examples/default_driver.fr", "build"));
        }; // else: relies on it using graphics/easy.fr/build_for_graphics as the driver. 
        a.push_all(@slice(path, "-arch", @tfmt("%", args.target.arch), "-os", @tfmt("%", args.target.os), "-o", dest_path, @if(args.unsafe, "-unsafe", "-safe")));
        return();
    };
    
    a := general_allocator();
    vtable := init_driver_vtable();
    opts := vtable.default_build_options();
    opts.retain_function_names = true;
    ;{
        args := cli_args();
        if args.index_of(fn(it) => it[] == "-D") { i |
            if i < args.len() - 1 {
                opts.frontend_logging = args[i + 1].str();
            };
        };
    };
    set_unsafe(opts, args.unsafe);
    comp := {vtable.init_compiler}(opts); // TODO: comptime get the current arch
    c := vtable.with(comp);
    
    src := u8.list(c.get_alloc());
    src&.push_all("""#include_std("lib/core.fr");""");
    @fmt(src&, """#include_std("%");""", path);
    if gfx {
        src&.push_all("\n:: import(\"@/graphics/app.fr\").Wgpu;\n");
        src&.push_all("\nSOKOL_BACKEND :: import(\"@/graphics/lib.fr\").RenderBackend.WGPU;");
        src&.push_all("\nGRAPHICS_TARGET_WEB :: true;");
    };
    src := src.items();
    
    file := c.add_file("repl!", src);
    self := c.data.cast()[][];
    self.comptime_codegen.m.set_debug_types(args.logging, true);
        
    if gfx {
        self.comptime_libraries&.insert(
            self.pool.insert_owned("webgpu"), 
            self.comptime_libraries&.get(self.pool.insert_owned("libc")).unwrap(),
        );
    };
    
    id := self.parser.push_parse(src, file);
    stmts := self.parser.finish_pending_stmts(id);
    stmts := self.unwrap_report_error(RawList(FatStmt), stmts);
    stmts := stmts.items();
    r := {c.vtable.make_and_resolve_and_compile_top_level}(c.data, stmts);
    self.unwrap_report_error(void, r);
    
    fid := c.get_unique_named("main") || @panic("no function called 'main'");
    
    m := general_allocator().box_uninit(QbeModule);
    name := c.fmt_fn_name(fid);

    backend'init_module(m, args.target);
    m.set_debug_types(args.logging, true);
    self.other_module&.push(m, self.get_alloc());
    shared := init_codegen(m, self.get_alloc(), true);
    main_thread_pump(self, shared, @slice(fid), false);
    each self.comptime_libraries& { _, lib |
        Qbe'fill_pending_dynamic_imports(m, lib[]);
    };
    Qbe'seal_imports(m);
    m.make_exec();
    f := m.get_addr(name) || @panic("ICE: lost %", name);
    f := bit_cast_unchecked(rawptr, @FnPtr() void, f);
    
    c'vtable'destroy_compiler(c.data);  // early because wasm is memory poor
    push_tls_value(.cli_arguments, empty()) {
        f();
    };
    drop(m);
}

run_c :: fn(args: CompileArgs, path: Str, dest_path: Str, a: *List(Str)) void = {
    a.push_all(@slice("examples/import_c/cc.fr", path, 
        "-arch", args.target.arch.name_str(), "-os", args.target.os.name_str()));
    a.push_all(@slice("-Itests/c"));
    @match(args.target.type) {
        fn JitOnly() => a.push("-r");
        fn Exe() => a.push_all(@slice("-o", dest_path));
        @default => unreachable();
    };
}

run_qbe :: fn(args: CompileArgs, path: Str, dest_path: Str, a: *List(Str)) void = {
    a.push_all(@slice("backend/meta/qbe_frontend.fr", path, "-cc", "-t"));
    if args.target.arch == .wasm32 {
        a.push("wasm32");
        a.push("-wasm_threads");
    } else {
        @match(args.target.arch) {
            fn wasm32() => a.push("wasm32");
            fn aarch64() => @match(args.target.os) {
                fn macos() => a.push("arm64_apple");
                fn linux() => a.push("arm64");
            };
            fn x86_64() => @match(args.target.os) {
                fn macos() => a.push("amd64_apple");
                fn linux() => a.push("amd64");
            };
            fn rv64() => a.push("rv64");
        }
    };
    @match(args.target.type) {
        fn JitOnly() => a.push("-r");
        fn Exe() => a.push_all(@slice("-o", dest_path));
        @default => unreachable();
    };
};
