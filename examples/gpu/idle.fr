// TODO: only return the one next step if that's all im using
//       (maybe an upgrade that lets you see the path?)
// TODO: if get stuck waiting in line behind other monsters, 
//       change target (to an exposed turret/collector) if possible 
//       and remember it for longer so don't keep going back and forth as the blockers move. 

// https://en.wikipedia.org/wiki/A*_search_algorithm#Pseudocode
a_star :: fn(f: *Factory, start: Node, goal: Node) []Node = {
    // estimate of total weight on path to goal 
    h :: fn(node) => {  
        it := abs(goal.pos - node.pos);
        it.x + it.y
    };
    // exact weight for this one edge
    d :: fn(_current, neighbor) f32 => @if(neighbor.i == -1, 1, {
        it := f.buildings[neighbor.i]&;
        @match(it.kind) {
            fn Monster() => 5;
            fn Spawner() => infinity;
            @default => 1 + it.hp.float().cast().max(0)/10;
        }
    });
    Get :: fn(map, key) => map.get(key) || infinity;
    infinity: f32 = 1.0/0.0;
    
    open_set := Node.list(temp());
    open_set&.push(start);
    
    came_from: HashMap(Node, Node) = init(temp());

    g_score: HashMap(Node, f32) = init(temp());
    g_score&.insert(start, 0);

    f_score: HashMap(Node, f32) = init(temp());
    f_score&.insert(start, h(start));

    while => open_set.len > 0 {
        // :SLOW
        current_i := 0;
        best_score := f_score&.Get(open_set[current_i]);
        range(0, open_set.len) { i |
            score := f_score&.Get(open_set[i]);
            if score < best_score {
                best_score = score;
                current_i = i;
            };
        };
        
        current := open_set[current_i];
        if current.pos == goal.pos {
            return reconstruct_path(came_from&, current);
        };

        open_set&.unordered_remove(current_i);
        neighbors := get_neighbors(f, current);
        for neighbors& { neighbor |
            continue :: local_return;
            @if(neighbor.pos.x < 0) continue();
            current_score := g_score&.Get(current);
            neighbor_score := g_score&.Get(neighbor);
            tentative_g_score := current_score + d(current, neighbor);
            if tentative_g_score < neighbor_score {
                came_from&.insert(neighbor, current);
                g_score&.insert(neighbor, tentative_g_score);
                f_score&.insert(neighbor, tentative_g_score + h(neighbor));
                if !open_set.contains(neighbor) {
                    open_set&.push(neighbor);
                };
            };
        };
    };
    
    reconstruct_path :: fn(came_from: *HashMap(Node, Node), current: Node) []Node = {
        total_path := Node.list(temp());
        total_path&.push(current);
        while => came_from.get(current) { next |
            current = next;
            total_path&.push(current);
        };
        total_path.items().reverse();
        total_path.items()
    };

    empty()
}

Node :: @struct(pos: Vec2, i: i64);
fn get_neighbors(f: *Factory, start: Node) Array(Node, 4) = {
    F :: fn(x: f32, y: f32) Node => (pos = vec2(x, y), i = -1);
    out: Array(Node, 4) = (F(1, 0), F(0, 1), F(-1, 0), F(0, -1));
    each out& { it |
        pos := start.pos + it.pos;
        // :SLOW TODO: if start.i!=-1 can use the sortedness to be faster ex. x+/-1 will be i+/-1 if there
        //             (but can't do that when moved=true earlier in the loop)
        it.i = f.buildings&.index_of(fn(it) => it.pos == pos) || -1;
        it.pos = pos;
        if !f.in_bounds(it.pos) {
            it.pos.x = -1;
        };
    };
    out
}

fn in_bounds(f: *Factory, x: Vec2) bool #inline = 
    x.x > 0 && x.y > 0 && x.x < f.dimensions.x && x.y < f.dimensions.y;
    
::AutoEq(Node); 
fn hash(h: *TrivialHasher, s: *Node) void = {
    h.hash(@ref @as(u32) s.pos.x.bitcast());
    h.hash(@ref @as(u32) s.pos.y.bitcast());
}

