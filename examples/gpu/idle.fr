    ("FusionReactor", "let 5 monsters fuse into one", "a monster that can't move because its surrounded by 4 others will absorb their hp and do extra damage (and be worth extra resources when collected)"),
    ("SpeedIsTheKeyHere", "let a spawner level up until it spawns a monster every second", "your turrets have longer range than spawners. try to kill them before they get too strong."),
