
State :: @struct {
    ui: Ui.State;
    dirty: bool;
    sim: Simulation #use;
    
    save_is_dirty: i64;
    prev_save_time: i64;
    
    action: @enum(None, PasteSaveFile, CopySaveFile);
};

Clicker :: @struct {
    Generator :: @struct {
        name: Str; 
        price: Price; 
        production: Price; 
        auto_price: Price;
        
        level := 0;
        auto: @struct(allow := false, enable := false) = ();
    };
    Currency :: @struct(name: Str, amount: i64);
    currencies: []Currency;
    generators: []Generator;
    Price :: @struct(currency: i64, amount: i64);
    
    total_earnings: i64;
    
    prev_time: f64;
    delta_time: f64;
    warp_start_time: ?i64;
    prev_minimized: bool;
};

fn init_world(c: *Clicker, a: Alloc) void #use(Clicker) = {
    c.warp_start_time = .None;
    c.prev_time = timestamp_s();

    c.generators = a.alloc_zeroed(Generator, 4);
    c.currencies = a.alloc_zeroed(Currency, 4);
    c.generators[0] = (name = "X", price = (currency=0, amount=1), production = (currency=0, amount=1), auto_price=(currency=0, amount=50));
    c.generators[1] = (name = "Y", price = (currency=0, amount=500), production = (currency=0, amount=10), auto_price=(currency=0, amount=200));
    c.generators[2] = (name = "Z", price = (currency=0, amount=3500), production = (currency=1, amount=1), auto_price=(currency=1, amount=80));
    c.generators[3] = (name = "Q", price = (currency=2, amount=50), production = (currency=1, amount=5), auto_price=(currency=0, amount=10000));
    c.currencies[0] = (name = "A", amount = 1);
    c.currencies[building_currency_index] = (name = "B", amount = 0);
    c.currencies[collector_currency_index] = (name = "C", amount = 0);
    c.currencies[prestige_currency_index] = (name = "D", amount = 0);
}

fn on_init(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    sapp.desc.enable_clipboard = true;
    on_init(state.ui&, sg);
    state.dirty = true;
    init_world(state.sim&, general_allocator());
        
    if read_entire_file(temp(), save_file_path) { in |
        read_save_file(state.sim&, in);
    };
    state.prev_save_time = get_real_time();
    
    enumerate achievement_referenced { i, it |
        @if(!it[]) @println("achievement % cannot be completed", achievements[i]._0);
    };
    
}

fn consume_delta_time(sim: *Simulation) void = {
    @if(sim.completed_in_this_run("WasteOfAGoodSacrifice")) return();
    c := sim.clicker&;
    powers :: ast_alloc().alloc_init(i64, 6, fn(i) => powI(10, i));
    for_rev powers { scale |
        while => c.delta_time >= scale.float() {
            c.delta_time -= scale.float();
            each c.generators { it |
                if it.auto.enable {
                    delta := it.production.amount * it.level * scale;
                    add_earnings(c, it.production.currency, delta);
                };
            };
        };
    };
    
    @if(c.total_earnings < 1_000) return(); sim.completed("WhoWantsToBeAKillionaire");
    @if(c.total_earnings < 1_000_000) return(); sim.completed("WhoWantsToBeAMillionaire");
    @if(c.total_earnings < 1_000_000_000) return(); sim.completed("WhoWantsToBeABillionaire");
    @if(c.total_earnings < 1_000_000_000_000) return(); sim.completed("WhoWantsToBeATrillionaire");
    @if(c.total_earnings < 1_000_000_000_000_000) return(); sim.completed("WhoWantsToBeAQuadrillionaire");
}

fn add_earnings(c: *Clicker, currency: i64, delta: i64) void = {
    delta := c.adjust_for_prestige(delta);
    c.currencies[currency].amount += delta;
    c.total_earnings += delta;
}

fn adjust_for_prestige(c: *Clicker, delta: i64) i64 = {
    prestige := c.currencies[prestige_currency_index].amount;
    if prestige > 0 {
        delta += int(delta.float() * (prestige.float()/100));
    };
    delta
}

prestige_currency_index :: 3;
collector_currency_index :: 2;
building_currency_index :: 1;
fn reset_for_prestige(sim: *Simulation, grant_prestige: bool) void = {
    c, f := (sim.clicker&, sim.factory&);
    prestige := c.currencies[prestige_currency_index].amount;
    delta := @if(grant_prestige, c.calculate_next_prestige(), 0);
    
    each c.currencies { it |
        it.amount = 0;
    };
    each c.generators { it |
        it.auto = ();
        it.level = 0;
    };
    init_world(f, f.gpa);
    each sim.achievements { it |
        it.set(.complete_this_run, 0);
    };
    
    c.currencies[0].amount = 1;
    c.currencies[prestige_currency_index].amount = prestige + delta;
    c.total_earnings += delta;
    sim.time_since_reset = 0;    
}

fn calculate_next_prestige(c: *Clicker) i64 = {
    root :: fn(x: i64) i64 = x.float().sqrt().int();
    prestige := c.currencies[prestige_currency_index].amount;
    next := c.total_earnings.root() / 10 - prestige/5;
    @if(next < 0, 0, next)
}

fn on_render(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    c := state.clicker&;
    f := state.factory&;
    sim := state.sim&;
    if sapp.frame_count.umod(64) == 0 {
        break :: local_return;
        @if(c.warp_start_time.is_some()) break();
        now := timestamp_s();
        @if(now < c.prev_time) break();  // unreachable you'd hope
        
        c.delta_time += now - c.prev_time;
        c.prev_time = now;
        @if(c.delta_time < 1) break();
        state.dirty = true;
        
        // TODO: maybe an upgrade that lets you have this run in end_warp as well? 
        //       probably don't run while saved so you don't just auto die but could run more efficiently without rendering when idle just because unfocused. 
        dt := c.delta_time;
        sim.time_since_reset += dt;
        while => dt >= 1 {
            tick_factory(sim);
            dt -= 1;
        };
        
        sim.consume_delta_time();
    };
    
    @match(state.action) {
        fn None() => ();
        fn CopySaveFile() => {
            out := write_save_file(state.sim&);
            sapp.set_clipboard_string(out);
            state.action = .None;
        }
        fn PasteSaveFile() => {
            sapp.requests.fake_paste_event = true;
        }
    }
    
    if Easy'should_skip_frame(sapp, state.dirty&) {
        state.ui.idle_last_frame = true;
        return();
    };
    
    // autosave
    if state.save_is_dirty > 25 && state.prev_save_time + 120 > get_real_time() {
        state.save_to_file();
        state.save_is_dirty = 0;
        state.prev_save_time = get_real_time();
    };
    
    Easy'glue_begin_pass(sapp, sg, zeroed(Sg.PassAction));
    input_end_with_idle(state.ui&, => draw_ui(state));
    draw(state.ui&, sg, sapp);
    sg.end_pass();
    sg.commit();
}

fn on_event(state: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = {
    c := state.clicker&;
    sim := state.sim&;
    @if(@is(event.type, .UNFOCUSED, .ICONIFIED, .MOUSE_LEAVE)) c.start_warp();
    @if(@is(event.type, .FOCUSED, .RESTORED, .MOUSE_ENTER)) {
        @if(c.warp_start_time.is_some()) state.sim&.completed("BeachVacation");
        sim.end_warp();
    };
    if event.type == .CLIPBOARD_PASTED && state.action == .PasteSaveFile {
        state.action = .None;
        read_save_file(state.sim&, event.pasted);
        sim.completed("EtchedInStone");
    };
    @if(event.type == .QUIT_REQUESTED) state.save_to_file();

    on_event(state.ui&, sapp, event);
    state.dirty = true;
}

save_file_path :: "target/franca/idle.txt";
fn save_to_file(state: *State) void = {
    _ := make_dirs(pop_path_segment(save_file_path));
    _ := write_entire_file(save_file_path, write_save_file(state.sim&));
}

fn start_warp(c: *Clicker) void = {
    if c.warp_start_time.is_none() {
        t := get_real_time();
        c.warp_start_time = (Some =t);
    };
}

fn end_warp(sim: *Simulation) void = {
    c := sim.clicker&;
    @if(c.prev_minimized) return();
    prev_time := c.warp_start_time&.take() || return();
    t := get_real_time();
    delta := t - prev_time;
    @if(delta <= 0) return();
    amounts := temp().alloc_init(i64, c.currencies.len, fn(i) => c.currencies[i].amount);
    c.delta_time += float(delta);
    c.prev_time = timestamp_s();
    sim.consume_delta_time();
    @if(delta < 120) return();
    earned := sim.factory.gpa.alloc_init(i64, amounts.len, fn(i) => c.currencies[i].amount - amounts[i]);
    sim.notifications&.push((EndWarp = (t = delta, earned = earned)), sim.factory.gpa);
}

fn draw_ui(state: *State) void #use(Ui.Nuklear) = {
    ctx := state.ui.ctx&;
    flags := (@as(u32) nk_panel_flags.NK_WINDOW_MOVABLE).bit_or(@as(u32) nk_panel_flags.NK_WINDOW_SCALABLE).bit_or(@as(u32) nk_panel_flags.NK_WINDOW_MINIMIZABLE);
    c := state.clicker&;
    sim := state.sim&;
    f := state.factory&;
    
    if begin(ctx, "About", nk_rect(520, 10, 300, 200), flags) {
        if tree_push_hashed(ctx, .NK_TREE_NODE, "Save Game Data", .NK_MINIMIZED, "", 0) {
            nk_layout_row_dynamic(ctx, 0, 1);
            if button(ctx, "Copy to Clipboard") {
                state.action = .CopySaveFile;
            };
            if button(ctx, "Paste (replaces current game)") {
                println(write_save_file(state.sim&));
                state.action = .PasteSaveFile;
            };
            if button(ctx, "Restart (replaces current game)") {
                println(write_save_file(state.sim&));
                init_world(state.sim&, general_allocator());
            };
            nk_tree_pop(ctx);
        };
        
        if tree_push_hashed(ctx, .NK_TREE_NODE, @tfmt("Notifications (%)", sim.notifications.len), .NK_MINIMIZED, "", 4) {
            dismiss: ?i64 = .None;
            enumerate_rev sim.notifications { i, it |
                @match(it) {
                    fn Achievement(i) => {
                        nk_layout_row_dynamic(ctx, 0, 2);
                        text(ctx, achievements[i[]]._0);
                    }
                    fn EndWarp(it) => {
                        nk_layout_row_dynamic(ctx, 0, c.currencies.len.intcast() + 2);
                        text(ctx, @tfmt("%s", it.t));
                        enumerate c.currencies { i, kind |
                            text(ctx, @tfmt("% %", it.earned[i], kind.name));
                        };
                    }
                };
                if button(ctx, "ok") {
                    dismiss = (Some = i);
                };
            };
            if dismiss { i |
                it := sim.notifications&.ordered_remove(i).unwrap();
                @if_let(it) fn EndWarp(it) => f.gpa.dealloc(i64, it.earned);
            };
            
            nk_tree_pop(ctx);
        };
        if tree_push_hashed(ctx, .NK_TREE_NODE, "Achievements", .NK_MINIMIZED, "", 1) {
            complete := 0;
            for sim.achievements { it |
                complete += it.get(.complete);
            };
            
            wrapping_text_row(ctx, @tfmt("%/% Completed", complete, achievements.len()));
            wrapping_text_row(ctx, @tfmt("% Lifetime Earnings", c.total_earnings));
            
            enumerate sim.achievements { i, it |
                nk_layout_row_dynamic(ctx, 0.01, 1);
                name, pre_hint, post_hint := achievements[i]; 
                n := it[].get(.hint);
                title := @if(n > 0, name, "?");
                if tree_push_hashed(ctx, .NK_TREE_NODE, title, .NK_MINIMIZED, "achive", i) {
                    @if(it[].get(.complete) == 0) wrapping_text_row(ctx, "Not Yet Completed");
                    @if(n > 1) wrapping_text_row(ctx, pre_hint);
                    @if(n > 2) wrapping_text_row(ctx, post_hint);
                    if n < 3 {
                        price: Clicker.Price = (amount = powI(2, sim.total_hints), currency = 0);
                        buy_button(price, false, @tfmt("Buy Hint %/3", n+1)) {
                            it.set(.hint, n + 1);
                            sim.total_hints += 1;
                            sim.completed("WhenISayJumpYouSayHowHigh");
                        };
                    };
                    
                    nk_tree_pop(ctx);
                };
            };
            nk_tree_pop(ctx);
        };
        
        @if(sim.completed_in_this_run("InvestingInYourFuture"))
        if tree_push_hashed(ctx, .NK_TREE_NODE, "Altar Of Sacrifice", .NK_MINIMIZED, "", 2) {
            kind := c.currencies[prestige_currency_index]&;
            wrapping_text_row(ctx, @tfmt("currencies/miners/buildings will be lost. achievements and % are kept. all earnings are boosted by 1\% per %", kind.name, kind.name));
            nk_layout_row_dynamic(ctx, 0, 1);
            delta := c.calculate_next_prestige();
            disable_if(delta == 0 || sim.completed_in_this_run("WasteOfAGoodSacrifice")) {
            if button(ctx, @tfmt("Reset (+% %)", delta, kind.name)) {
                sim.reset_for_prestige(true);
                sim.completed("PhoenixFromTheAshes");
            };
            };
            nk_tree_pop(ctx);
        };
    };
    nk_end(ctx);
        
    minimized := true;
    if begin(ctx, "The Mines", nk_rect(10, 10, 500, 280), flags) {
        break :: local_return;
        minimized = false;
        if c.warp_start_time { _ |
            nk_layout_row_dynamic(ctx, 0, 1);
            text(ctx, "Warping To The Future!");
            break();
        };
        
        nk_layout_row_dynamic(ctx, 0, c.currencies.len.intcast());
        
        n := 0;
        enumerate c.currencies { i, it |
            text(ctx, @tfmt("% %", it.amount, it.name));
            n += int(it.amount != 0);
        };
        @if(n == c.currencies.len) sim.completed("VeritableCornucopia");
        
        enumerate c.generators { i, it |
            nk_layout_row_dynamic(ctx, 0, 4);
            
            text(ctx, @tfmt("% %", it.level, it.name));
            
            disable_if(it.level == 0 || it.auto.enable) {
            kind := c.currencies[it.production.currency]&;
            amount := it.level * it.production.amount;
            if button(ctx, @tfmt("+% %", c.adjust_for_prestige(amount), kind.name)) {
                c.add_earnings(it.production.currency, amount);
            };
            };
            
            price := int(it.price.amount.float() * (1 + (powI(2, it.level)-1).float()/10));
            price: Clicker.Price = (amount = price, currency = it.price.currency);
            buy_button(price, false, "Buy") {
                it.level += 1;
            };

            if it.auto.allow {
                checkbox(ctx, "Auto", it.auto.enable&);
            } else {
                buy_button(it.auto_price, it.level == 0, "Auto") {
                    it.auto.allow = true;
                    it.auto.enable = true;
                    sim.completed("TheyAreTakingOurJobs");
                };
            };
        };
        
        nk_layout_row_dynamic(ctx, 0, 1);
        
        n := 0 
            + sim.completed_in_this_run("TheDarkForest").int() 
            + sim.completed_in_this_run("InvestingInYourFuture").int()
        ;
        if n < 2 {
            price: Clicker.Price = (currency = building_currency_index, amount = 300);
            names := @const_slice("World Map", "Altar Of Sacrifice");
            buy_button(price, false, @tfmt("Buy %", names[n])) {
                @if(n == 0) { place_building(f, vec2(2), .Clicker); };
                @if(n == 0) sim.completed("TheDarkForest");
                @if(n == 1) sim.completed("InvestingInYourFuture");
                @if(sim.time_since_reset < 30) sim.completed("FastestHandsInTheWest");
            };
        };
    };
    nk_end(ctx);
    
    // TODO: there's a flicker when you place a building when there are a lot. 
    //       might have to switch to drawing to a texture directly instead of using buttons. 
    if sim.completed_in_this_run("TheDarkForest") {
        if begin(ctx, "World Map", nk_rect(10, 300, 800, 260), flags) {
            break :: local_return;
            if c.warp_start_time { _ |
                nk_layout_row_dynamic(ctx, 0, 1);
                text(ctx, "Paused!");
                break();
            };
            
            @run @assert_eq(building_colours.len(), Factory.Kind.enum_count());
            style := ctx.style.button;
            
            placeable := @const_slice(Factory.Kind.Empty, .Turret, .Wall, .Collector);
            nk_layout_row_dynamic(ctx, 0, placeable.len().intcast());
            for placeable { kind |
                style.normal = nk_style_item_color(building_colours[@as(i64) kind]);
                
                cur := c.currencies[f.templates&[kind].price.currency]&;
                price := f.templates&[kind].price.amount;
                // not disabling when can't afford because then its confusing if you try to switch too early and just wait to place, you end up buying the old thing
                disable := f.placing == kind;
                style.border = ctx.style.button.border * @if(disable, 6, 1);
                disable_if(f.placing == kind) {
                s := @if(kind == .Empty, "Sell", @tfmt("% (-% %)", kind, price, cur.name));
                if button_styled(ctx, style&, s) {
                    f.placing = kind;
                };
                };
            };
            
            style.rounding = 0;
            W, H := (f.dimensions.x.cast().int(), f.dimensions.y.cast().int());
            nk_layout_row_dynamic(ctx, 0, W.intcast());
            i := 0;
            range(0, H) { y |
                range(0, W) { x |
                    kind := Factory.Kind.Empty;
                    pos := vec2(x.float().cast(), y.float().cast());
                    level := 0;
                    if i < f.buildings.len && f.buildings[i].pos == pos {
                        kind = f.buildings[i].kind;
                        level = f.buildings[i].level - 1;
                        i += 1;
                    };
                    style.normal = nk_style_item_color(building_colours[@as(i64) kind]);
                    style.border = level.float().cast().div(2).min(5);
                    
                    can_sell := placeable.contains(fn(it) => it[] == kind);
                    priced_kind := @if(f.placing == .Empty, kind, f.placing);
                    cur := c.currencies[f.templates&[priced_kind].price.currency]&;
                    price := f.templates&[priced_kind].price.amount;
                    can_afford := cur.amount >= price;
                    disable := @if(f.placing == .Empty, 
                        kind == .Empty || !can_sell, 
                        kind != .Empty || !can_afford);
                    disable_if(disable) {
                    s := @if(kind == .Empty, "", @tfmt("%", f.buildings[i-1].hp));
                    if button_styled(ctx, style&, s) {
                        @match(f.placing) {
                            fn Empty() => sim.completed("CashBackGuarentee");
                            fn Wall() => sim.completed("AndMakeTheMonstersPayForIt");
                            fn Turret() => sim.completed("NowWeAreCookingWithBullets");
                            @default => ();
                        };
                        
                        prev := place_building(f, pos, f.placing);
                        if f.placing == .Empty {
                            prev := prev.unwrap();
                            cur.amount += int(price.float() * (prev.hp.float() / f.templates&[prev.kind].hp.float()));
                        } else {
                            cur.amount -= price;
                        };
                        state.save_is_dirty += 1;
                    };
                    };
                };
            };
            
            nk_layout_row_dynamic(ctx, 0, 2);
            price: Clicker.Price = (amount = 64 + powI(2, W+H-24+2), currency = collector_currency_index);
            buy_button(price, H >= 20, "Buy Row") {
                f.dimensions.y += 1;
                sim.completed("GentlyDownTheStream");
            };
            buy_button(price, W >= 20, "Buy Column") {
                f.dimensions.x += 1;
            };
            @if(W == H) sim.completed("AsWideAsItIsTall");
        };
        nk_end(ctx);
    };
    
    // feels jarring if you suddenly reset when you die so at least tell you what happened. 
    if sim.completed_in_this_run("WasteOfAGoodSacrifice") {
        if begin(ctx, "Alert", nk_rect(10, 300, 500, 120), flags) {
            prestige := c.currencies[prestige_currency_index]&;
            wrapping_text_row(ctx, "The mine was destroyed, progress will be reset.");
            if prestige.amount + c.calculate_next_prestige() > 0 {
                wrapping_text_row(ctx, @tfmt("Your % % will be kept but % % was wasted by not sacrificing.", 
                    prestige.amount, prestige.name, c.calculate_next_prestige(), prestige.name));
            };
            nk_layout_row_dynamic(ctx, 0, 1);
            if button(ctx, "Continue") {
                sim.reset_for_prestige(false);
            };
        };
        nk_end(ctx);
    };
    
    if minimized != c.prev_minimized {
        c.prev_minimized = minimized;
        @if(minimized, c.start_warp(), sim.end_warp());
    };
    
    buy_button :: fn(price: Clicker.Price, disable: bool, label: Str, $body: @Fn() void) => {
        kind := c.currencies[price.currency]&;
        price := price.amount;
        disable_if(price > kind.amount || disable) {
            if button(ctx, @tfmt("% (-% %)", label, price, kind.name)) {
                kind.amount -= price;
                state.save_is_dirty += 1;
                body();
            };
        };
    };
    
    disable_if :: fn(disable: bool, $body: @Fn() void) = {
        @if(disable) nk_widget_disable_begin(ctx);
        body();
        @if(disable) nk_widget_disable_end(ctx);
    };
}

get_real_time :: fn() i64 = { t := zeroed(TimeSpec); Posix'clock_gettime(Posix.CLOCK.REALTIME, t&); t.seconds };

// TODO: add more to save file if use it for suspend in maze_game:
//       sim.notifications,f.placing,c.delta_time,f.(fraction of a tick)
B64 :: import("@/lib/encoding/base64.fr");
fn write_save_file(sim: *Simulation) []u8 = {
    c, f := (sim.clicker&, sim.factory&);
    out := @ref u8.list(temp());
    
    // something trivial just so i can keep my progress between recompiling the game to tweak a number
    @fmt(out, "IDLE_FR,v=1,g=");
    enumerate c.generators { i, it |
        @fmt(out, "%:%:%:%|", i, it.level, it.auto.allow.int(), it.auto.enable.int());
    };
    @fmt(out, ",c=");
    enumerate c.currencies { i, it |
        @fmt(out, "%:%|", i, it.amount);
    };
    have_world_map := sim.completed_in_this_run("TheDarkForest");
    @fmt(out, ",t=%,w=%,", c.warp_start_time || get_real_time(), have_world_map.int());
    
    if have_world_map {
        @fmt(out, "f=");
        enumerate f.buildings { i, it |
            @fmt(out, "%:%:%:%:%:%|", i, @as(i64) it.kind, it.pos.x, it.pos.y, it.hp, it.level);
        };
        @fmt(out, ",");
    };
    
    @fmt(out, "a=");
    enumerate sim.achievements { i, it |
        if it.repr != 0 {
            @fmt(out, "%:%|", i, it.repr);
        };
    };
    @fmt(out, ",h=%,e=%,d=%:%,", sim.total_hints, c.total_earnings, f.dimensions.x, f.dimensions.y);
    
    in := out.items(); 
    @println("CopySaveFile(plain):  %", in);
    flip_encrypt(in, true);
    out := @ref u8.list(temp());
    B64'encode(out, in);
    @println("CopySaveFile(cipher): %", out.items());
    out.items()
}

fn read_save_file(sim: *Simulation, in: []u8) void = {
    while => in.len > 0 && in[in.len - 1].is_ascii_whitespace() {
        in.len -= 1;
    };
    while => in.len > 0 && in[0].is_ascii_whitespace() {
        in = in.rest(1);
    };
    @println("PasteSaveFile(cipher): %", in);
    out := @ref u8.list(temp());
    @if(in.len.umod(4) != 0) return();
    B64'base64_decode(out, in);
    in := out.items();
    flip_encrypt(in, false);
    @println("PasteSaveFile(plain):  %", in);
    
    c, f := (sim.clicker&, sim.factory&);
    sim.notifications&.clear();
    in := in.split(",", temp());
    @if(in.len < 5 || in[0] != "IDLE_FR" || in[1] != "v=1") return();
    if in[2].starts_with("g=") {
        in := in[2].rest(2).split("|", temp());
        enumerate c.generators.slice(0, min(c.generators.len, in.len - 1)) { i, it |
            in := in[i].split(":", temp());
            it.level = in[1].parse_int(); 
            it.auto.allow = in[2] == "1";
            it.auto.enable = in[3] == "1";
        };
    };
    if in[3].starts_with("c=") {
        in := in[3].rest(2).split("|", temp());
        enumerate c.currencies.slice(0, min(c.currencies.len, in.len - 1)) { i, it |
            in := in[i].split(":", temp());
            it.amount = in[1].parse_int(); 
        };
    };
    c.warp_start_time = .None;
    if in[4].starts_with("t=") {
        t := in[4].rest(2).parse_int();
        c.warp_start_time = (Some = t);
    };
    have_world_map := false;
    if in.len > 4 && in[5].starts_with("w=") {
        have_world_map = in[5] == "w=1";
    };
    
    if have_world_map && in.len > 5 && in[6].starts_with("f=") {
        f.buildings&.clear();
        in := in[6].rest(2).split("|", temp());
        for in { in |
            if in.len != 0 {
                in := in.split(":", temp());
                it: Factory.Building = (
                    kind = @as(Factory.Kind) @as(i64) in[1].parse_int(),
                    pos = vec2(in[2].parse_int().float().cast(), in[3].parse_int().float().cast()),
                    hp = in[4].parse_int(),
                    level = in[5].parse_int(),
                );
                f.buildings&.push(it, f.gpa);
            };
        };
        @fmt(out, ",");
    };
    I := 6 + int(have_world_map);
    if in.len > I && in[I].starts_with("a=") {
        in := in[I].rest(2).split("|", temp());
        sim.achievements.set_zeroed();
        for in { in |
            if in.len != 0 {
                in := in.split(":", temp());
                sim.achievements[in[0].parse_int()].repr = in[1].parse_int().trunc();
            };
        };
        I += 1;
    };
    
    if in.len > I && in[I].starts_with("h=") {
        sim.total_hints = in[I].rest(2).parse_int();
        I += 1;
    };
    if in.len > I && in[I].starts_with("e=") {
        c.total_earnings = in[I].rest(2).parse_int();
        I += 1;
    };
    if in.len > I && in[I].starts_with("d=") {
        in := in[I].rest(2).split(":", temp());
        f.dimensions = vec2(in[0].parse_int().float().cast(), in[1].parse_int().float().cast());
        I += 1;
    };
    
    sim.end_warp();
}

// cute way to make it inconvenient for myself to cheat by editing the save. 
// obviously nobody else is going to play this and if they did they could just look at the source and get the key.  
flip_encrypt :: fn(data: []u8, encrypting: bool) void = {
    rng: Random.Rng = @run Random.xoshiro256SS.new(42);
    iv: u64 = 0x123456789ABCDEF;
    while => data.len > 8 {
        it := data&.pop_type(u64);
        input := it[];
        it[] = it[].bit_xor(rng&.next()).bit_xor(iv);
        iv = @if(encrypting, it[], input);
    };
    if data.len != 0 {
        buf: u64 = 0;
        buf_s := buf&.slice(1).interpret_as_bytes().slice(0, data.len);
        buf_s.copy_from(data);
        buf = buf.bit_xor(rng&.next()).bit_xor(iv);
        data.copy_from(buf_s);
    };
}

driver :: fn(vtable: *ImportVTable) void = Easy'build_for_graphics2(vtable, @source_file_name(), true);
main :: fn() void = Easy'start(State);
#use("@/graphics/lib.fr");
Ui :: import("@/graphics/deps/nuklear.fr");

// TODO: wtf, can't call the int pow() overload :compiler
powI :: fn(base: i64, exp: i64) i64 = {  // :SLOW
    n := 1;
    range(0, exp) {_|
        n *= base;
    };
    n
}

Factory :: @struct {
    Kind :: @enum(Empty, Clicker, Turret, Wall, Collector, Spawner, Monster);
    Building :: @struct {
        pos: Vec2;
        kind: Kind;
        level: i64;
        hp: i64;
        trying_to_spawn := false;
    };
    Template :: @struct(hp: i64, price := zeroed(Clicker.Price));
    
    buildings: RawList(Building);
    templates: EnumMap(Kind, Template);
    placing: Kind;
    gpa: Alloc;
    dimensions: Vec2;
    rng: Random.Rng;
    
    trying_to_spawn_spawner: bool;
};

building_colours :: @const_slice(@as(Ui.Nuklear.nk_color) 
    (r=20,g=20,b=20,a=255), 
    (r=100,g=100,b=200,a=255),
    (r=10,g=100,b=0,a=255), 
    (r=0,g=50,b=0,a=255), 
    (r=0,g=0,b=100,a=255), 
    (r=100,g=100,b=0,a=255),
    (r=0,g=100,b=100,a=255),
);

base_factory_dimensions :: vec2(16, 8);
fn init_world(f: *Factory, a: Alloc) void = {
    f.gpa = a;
    f.rng = (s = (1,2,3,4), next = Random.xoshiro256SS);
    C :: building_currency_index;
    f.templates&[.Turret] = (hp = 25, price = (currency = C, amount = 50));
    f.templates&[.Wall] = (hp = 200, price = (currency = C, amount = 20));
    f.templates&[.Collector] = (hp = 20, price = (currency = C, amount = 40));
    f.templates&[.Monster] = (hp = 20);
    f.templates&[.Spawner] = (hp = 1000);
    f.templates&[.Clicker] = (hp = 5000);
    f.buildings&.clear();
    f.dimensions = base_factory_dimensions;
}

fn tick_factory(sim: *Simulation) void = {
    @if(!sim.completed_in_this_run("TheDarkForest")) return();
    @if(sim.completed_in_this_run("WasteOfAGoodSacrifice")) return();

    c, f := (sim.clicker&, sim.factory&);
    w, h := (f.dimensions.x.cast().int(), f.dimensions.y.cast().int());
    has_space := f.buildings.len != w*h;
    if !has_space && f.buildings.find(fn(it) => @is(it.kind, .Spawner, .Monster)).is_none() {
        sim.completed("EverythingTheLightTouches");
        return();  // don't let the spawner level up. so you can use this as a way to disable the factory if you want
    };
    
    clicker_i := f.buildings.index_of(fn(it) => it.kind == .Clicker).unwrap();
    clicker_pos := f.buildings[clicker_i].pos;
    moved, killed := (false, 0);
    
    if f.buildings.find(fn(it) => it.kind == .Spawner).is_none() {
        if f.rng&.rand_float() < 1.0/32.0 {
            f.trying_to_spawn_spawner = true;
        };
        if f.trying_to_spawn_spawner && has_space {
            pos := vec2(f.rng&.rand_int(w).float().cast(), f.rng&.rand_int(h).float().cast());
            if f.in_bounds(pos) && norm_sq(pos - clicker_pos) > 25 && f.buildings.find(fn(it) => it.pos == pos).is_none() {
                moved = true;
                f.buildings&.push(f.init_building(pos, .Spawner), f.gpa);
                f.trying_to_spawn_spawner = false;
            };
        };
    };
        
    range(0, f.buildings.len) { i |
        continue :: local_return;
        it := f.buildings[i]&;
        node: Node = (pos=it.pos,i=i);
        @match(it.kind) {
            fn Monster() => {
                path := a_star(f, node, (pos=clicker_pos,i=clicker_i));
                @if(path.len < 2) continue();
                if path[1].i == -1 {
                    it.pos = path[1].pos;
                    moved = true;
                    continue();
                };
                
                blocker := f.buildings[path[1].i]&;
                if blocker.kind == .Monster {
                    // this would be unreachable if i didn't have it treat other monsters as passable but then it's too indecisive
                    others := get_neighbors(f, node);
                    each others& { it |
                        if it.i != -1 && !@is(f.buildings[it.i].kind, .Spawner, .Monster) {
                            blocker = f.buildings[it.i]&;
                        };
                    };
                    @if(blocker.kind == .Monster) check_fusion(sim, it, others&, killed&);
                };
                
                if @is(blocker.kind, .Turret, .Wall, .Collector, .Clicker) {
                    deal_damage(sim, blocker, 10 * it.level, killed&);
                };
            }
            fn Spawner() => {
                if closest(f, it.pos, 1.5, fn(it) => @is(it.kind, .Turret, .Wall, .Collector, .Clicker)) { blocker |
                    deal_damage(sim, blocker, 20 * it.level, killed&);
                    sim.completed("SuspiciouslySpikey");
                };
                if closest(f, it.pos, 1.5, fn(it) => it.kind == .Monster) { target |
                    target.hp += it.level;
                    if target.hp > f.templates&[target.kind].hp + it.level*2 {  // don't give the achivement if could move away the whole time
                        sim.completed("DidYouGoToMedicalSchool?MeNeither!");
                    };
                };
                if f.rng&.rand_float() < 1.0/64.0 {
                    it.level += 1;
                };
                if it.trying_to_spawn {
                    pos := @const_slice(vec2(1, 0), vec2(0, 1), vec2(-1, 0), vec2(0, -1));
                    pos := it.pos + pos[f.rng&.rand_int(pos.len)];
                    if f.in_bounds(pos) && f.buildings.find(fn(it) => it.pos == pos).is_none() {
                        it.trying_to_spawn = false;
                        f.buildings&.push(f.init_building(pos, .Monster), f.gpa);
                        moved = true;
                    };
                    it := ();
                } else {
                    // saved so if there's no space this tick it doesn't have to wait for the random to recharge before trying again
                    spawn_chance := 1.0/8.0 + float(it.level)/40;
                    it.trying_to_spawn = f.rng&.rand_float() < spawn_chance;
                    @if(spawn_chance >= 1) sim.completed("SpeedIsTheKeyHere");
                };
                it := ();
            }
            fn Turret() => {
                blocker := closest(f, it.pos, 3, fn(it) => @is(it.kind, .Monster, .Spawner)) || continue();
                @if(!deal_damage(sim, blocker, it.level, killed&)) continue();
                n := 0;
                each f.buildings { it |
                    n += it.level * int(it.kind == .Collector && norm_sq(blocker.pos - it.pos) <= 3*3);
                };
                @if(n != 0) sim.completed("WasteNotWantNot");
                delta := n * blocker.level * @if(blocker.kind == .Spawner, 100, 1);
                add_earnings(c, collector_currency_index, delta);
            }
            @default => ();
        };
    };
    
    @if(killed > 0) f.buildings&.ordered_retain(fn(it) => it.hp > 0);
    @if(moved) f.resort();
}

fn deal_damage(sim: *Simulation, target: *Factory.Building, amount: i64, killed: *i64) bool = {
    target.hp -= amount;
    if target.kind == .Clicker {
        sim.completed("SticksAndStonesMayBreakMyBonesButLowHpExcitesMe");
        @if(target.hp <= 0) sim.completed("WasteOfAGoodSacrifice");
    };
    @if(target.kind == .Wall && target.hp <= 0) sim.completed("ElevenFootLadder");
    killed[] += int(target.hp <= 0);
    target.hp <= 0
}

// :SLOW the sorting matters for rendering. empty cells aren't saved as a building. 
fn place_building(f: *Factory, pos: Vec2, kind: Factory.Kind) ?Factory.Building = {
    if kind == .Empty {
        return(f.buildings&.ordered_remove(f.buildings&.index_of(fn(it) => it.pos == pos) || return(.None)));
    };
        f.buildings&.push(f.init_building(pos, kind), f.gpa);
        f.resort();
        .None
}

fn init_building(f: *Factory, pos: Vec2, kind: Factory.Kind) Factory.Building = 
    (pos=pos, kind=kind, hp = f.templates&[kind].hp, level = 1);

fn resort(f: *Factory) void = 
    Sort'default(Factory.Building, f.buildings&.items(), fn(a, b) => @if(a.pos.y == b.pos.y, a.pos.x <= b.pos.x, a.pos.y <= b.pos.y));

fn closest(f: *Factory, pos: Vec2, range: f32, $filter: @Fn(it: *Factory.Building) bool) ?*Factory.Building = {
    // TODO: once get_neighbors uses the sortedness to be faster, check those first
    best_i := -1;
    best_dist: f32 = range*range;
    enumerate f.buildings { i, it |
        if it.hp > 0 && filter(it) {
            dist := norm_sq(it.pos - pos);
            if dist <= best_dist {
                best_dist = dist;
                best_i = i;
            };
        };
    };
    @if(best_i != -1, (Some = f.buildings[best_i]&), .None)
}

fn check_fusion(sim: *Simulation, monster: *Factory.Building, others: *Array(Node, 4), killed: *i64) void = {
    n, level, hp := (0, 0, 0);
    each others { it |
        if it.i != -1 {
            other := sim.factory.buildings[it.i]&;
            n += int(other.kind == .Monster);
            level += other.level;
            hp += other.hp;
        };
    };
    @if(n != others.len()) return();
    
    monster.level += level + 1;
    monster.hp += hp;
    sim.completed("FusionReactor");
    each others { it |
        sim.factory.buildings[it.i].hp = 0;
    };
    killed[] += 4;
}

Simulation :: @struct {
    clicker: Clicker;
    factory: Factory;
    
    achievements: []Achivement;
    total_hints: i64;
    Achivement :: @(import("@/lib/bit_fields.fr")'bit_fields)(
        complete := 1,
        hint := 2,
        complete_this_run := 1,
        _ := 4,
    );
    notifications: RawList(Notification);
    time_since_reset: f64;
    Notification :: @tagged(
        Achievement: i64, 
        EndWarp: @struct(t: i64, earned: []i64),
    );
};

fn init_world(s: *Simulation, a: Alloc) void = {
    init_world(s.clicker&, a);
    init_world(s.factory&, a);
    s.achievements = a.alloc_zeroed(Simulation.Achivement, achievements.len());
    s.notifications&.clear();
}

achievement_referenced :: ast_alloc().alloc_zeroed(bool, achievements.len());
fn completed(s: *Simulation, $name: Str) void = {
    i :: achievements.index_of(fn(x) => x._0 == name) || @panic("invalid achivement name: %", name);
    @run { achievement_referenced[i] = true; };
    it := s.achievements[i]&;
    if it[].get(.complete) == 0 {
        s.notifications&.push((Achievement = i), s.factory.gpa);
        it.set(.complete, 1);
        it.set(.hint, 3);
    };
    it.set(.complete_this_run, 1);
}

fn completed_in_this_run(s: *Simulation, $name: Str) bool = {
    i :: achievements.index_of(fn(x) => x._0 == name) || @panic("invalid achivement name: %", name);
    s.achievements[i].get(.complete_this_run) == 1
}

