
State :: @struct {
    HIGH_DPI :: true;
    ui: Ui.State;
    dirty: bool;
    game_focused: bool;
    sprites_img: Sg.Image;
    sprites: []Ui.Nuklear.nk_image_t;
    world: Sim.World;
    selected_player: Sim.EntityId;
    prev_timestamp: f64;
};

Sim :: import("@/examples/gpu/auto/world.fr");

fn on_init(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    sapp.desc.enable_clipboard = true;
    on_init(state.ui&, sg);
    state.load_sprites(sg);
    state.prev_timestamp = timestamp_s();
    init(state.world&);
    state.world.is_client = false;
}

load_sprites :: fn(state: *State, sg: *Sg.Self) void = {
    Viewer :: import("@/examples/gpu/viewer.fr"); 
    pixels, w, h := Viewer'stbi_load(sprites_png).unwrap();
    state.sprites_img = sg.make(width = w, height = h, pixel_format = .RGBA8, data = SubImage(pixels));
    Viewer'Stb'stbi_image_free(u8.raw_from_ptr(pixels.ptr));
    handle := Ui'Nuklear'pack_nk_handle(state.sprites_img, state.ui.smp);
    state.sprites = general_allocator().alloc_init(@type state.sprites[0], intcast(w/32 * h/32)) { i |
        y, x := i.div_mod(w.intcast() / 32);
        Ui'Nuklear'nk_subimage_handle(handle, w.trunc(), h.trunc(), (x = x.float().cast()*32, y = y.float().cast()*32, w = 32, h = 32))
    };
}

fn on_render(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    t := timestamp_s();
    state.world.dt += t - state.prev_timestamp;
    state.prev_timestamp = t;
    update(state.world&);
    if state.world.dirty&.take() {
        state.dirty = true;
    };
    if Easy'should_skip_frame(sapp, state.dirty&) {
        state.ui.idle_last_frame = true;
        return();
    };
    
    Easy'glue_begin_pass(sapp, sg, ClearAction(r = 0, g = 0, b = 0));
    w, h := (sapp.width().float().cast() / sapp.dpi_scale, sapp.height().float().cast() / sapp.dpi_scale);
    input_end_with_idle(state.ui&, => draw_ui(state, w, h));
    draw(state.ui&, sg, sapp);
    sg.end_pass();
    sg.commit();
}

fn on_event(state: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = {
    on_event(state.ui&, sapp, event);
    state.dirty = true;
    if @is(event.type, .KEY_DOWN, .KEY_UP) {
        special := event.modifiers.get(.control) == 1 || event.modifiers.get(.super) == 1;
        down := event.type == .KEY_DOWN;
        if state.selected_player() { it |
        if !special && state.game_focused {
            // TODO: don't block if the other guy isn't servicing the pipe
            it.brain.send(Key = (char = event.key_code.raw().zext(), down = down));
        };
        
        if special && down && !event.key_repeat && @is(event.key_code, .R, .S) {
            it.recompile();
        };
        };
    };
    if @is(event.type, .FOCUSED, .RESTORED, .MOUSE_ENTER) {
        state.prev_timestamp = timestamp_s();
    };
}

fn selected_player(state: *State) ?*Sim.Player = {
    if state.world&.try_get(state.selected_player) { e |
        @if_let(e.info&) fn Player(it) => return(Some = it);
    };
    .None
}

fn draw_ui(state: *State, w: f32, h: f32) void #use(Ui.Nuklear) = {
    ctx := state.ui.ctx&;
    
    flags := (@as(u32) nk_panel_flags.NK_WINDOW_MOVABLE).bit_or(@as(u32) nk_panel_flags.NK_WINDOW_SCALABLE).bit_or(@as(u32) nk_panel_flags.NK_WINDOW_MINIMIZABLE);
    game_focused, edit_active := (false, false);
    white: nk_color = (r=255,g=255,b=255,a=255);
    if begin(ctx, "Output", nk_rect(0, 0, w/2, h), flags) {
        game_focused = nk_window_has_focus(ctx);
        draw := nk_window_get_canvas(ctx);
        nk_fill_rect(draw, draw.clip, 0, (r=10,g=10,b=10,a=255));
        size: f32 = 20;
        for state.world.entities& { it |
            p := it.pos * size + vec2(draw.clip.x, draw.clip.y);
            if !it.dead {
                at: nk_rect_t = nk_rect(p.x, p.y, size, size);
                nk_draw_image(draw, at, state.sprites[it.sprite()]&, white);
                @match(it.info&) {
                    fn Crop(it) => {
                        s := @tfmt("%", it.level);
                        nk_draw_text(draw, at, Ui'nk_string(s), s.len.intcast(), ctx.style.font, white, white);
                        if it.age > (it.level + 1) * 10 - 5 {
                            nk_draw_text(draw, at, Ui'nk_string("!"), 1, ctx.style.font, white, white);
                        };
                    }
                    @default => ();
                }
            };
        };
    };
    nk_end(ctx);
    
    if state.selected_player() { it |
    if it.errors.len > 0 {
        flags := flags.bit_or(@as(u32) nk_panel_flags.NK_WINDOW_CLOSABLE);
        if begin(ctx, "Error", nk_rect(0, 0, w/2, h), flags) {
            wrapping_text_row(ctx, it.errors.items());
        } else {
            if nk_window_is_hidden(ctx, Ui'nk_cstring("Error")) {
                it.errors&.clear();
            }
        };
        nk_end(ctx);
    };
    
    if begin(ctx, "Program", nk_rect(w/2, 0, w/2, h), flags) {
        n := it.inventory.slots.len;
        nk_layout_row_dynamic(ctx, 0, n.intcast());
        draw := nk_window_get_canvas(ctx);
        range(0, n) { i |
            area := zeroed(nk_rect_t);
            nk_widget(area&, ctx);
            slot := it.inventory.slots[i]&;
            if slot.count != 0 {
                nk_draw_image(draw, area, state.sprites[slot.item&.sprite()]&, white);
                if slot.count != 1 {
                    s := @tfmt("%", slot.count);
                    nk_draw_text(draw, area, Ui'nk_string(s), s.len.intcast(), ctx.style.font, white, white);
                };
                if nk_input_is_mouse_hovering_rect(ctx.input&, area) {
                    nk_tooltip(ctx, Ui'nk_cstring(slot.item&.display_name()));
                };
            };
        };
    
        nk_layout_row_dynamic(ctx, 0, 1);
        if button(ctx, "Recompile") {
            it.recompile();
        };
        
        size := nk_window_get_content_region(ctx);
        box_height := max(size.h - ctx.current.layout.at_y - ctx.style.edit.scrollbar_size.y - ctx.style.window.spacing.y - 20, 60);
        import("@/examples/gpu/cubes.fr")'text_box(ctx, it.edit&, box_height, size.w);
        edit_active = it.edit.active == 1;
    };
    };
    state.game_focused = game_focused || !edit_active;
    
    nk_end(ctx);
}

driver :: fn(vtable: *ImportVTable) void = Easy'build_for_graphics2(vtable, @source_file_name(), true);
main :: fn() void = Easy'start(State);
#use("@/graphics/lib.fr");
Ui :: import("@/graphics/deps/nuklear.fr");

sprites_png :: include_bytes("examples/gpu/auto/sprites.png");
