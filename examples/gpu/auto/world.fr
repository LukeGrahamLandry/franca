
World :: @rec @struct { 
    entities: List(*Entity);
    dirty: bool;
    next_id: *i64;
    dt: f64;
    is_client: bool;
    players: RawList(*Guest.Guest);
    camera: CameraPos;
    disk_dirty: bool;
};
CameraPos :: @struct(offset: Vec2, size: f32);

EntityId :: @struct(id: i64, hint: i64);
Entity :: @rec @struct {
    info: EntityInfo;
    pos: Vec2;
    id: EntityId;
    dead: bool;
};

Player :: @struct {
    brain: *Guest.Guest;
    errors: List(u8);
    source_disk_slot: i64;
    inventory: Inventory;
};

EntityInfo :: @tagged(
    Player: Player,
    Crop: @struct {
        type: CropType;
        level := 0;
        age := 0;
    },
    Chest: Inventory,
);

CropType :: @enum(nat, prime, fib);
Inventory :: @struct(slots: []ItemStack);
ItemStack :: @struct(item: Item, count: i64);
Item :: @tagged(
    Empty: void,
    Crop: CropType,
    Disk: @struct(data: RawList(u8), limit: i64),
    Keyboard,
    Robot,
    Chest,
);

fn init(w: *World, next_id: *i64) void = {
    a := general_allocator();
    w.entities = list(a);
    w.next_id = next_id;
    it := w.add_player();
    s := it.inventory.slots&;
    s[0] = (item = .Keyboard, count = 1);
    s[1] = (item = (Disk = (data = empty(), limit = 1.shift_left(14))), count = 1);
    s[2] = (item = (Crop = .fib), count = 5);
    s[3] = (item = (Crop = .nat), count = 5);
    s[4] = (item = .Robot, count = 1);
    s[5] = (item = .Chest, count = 1);
    it.source_disk_slot = 1;
    it.recompile(Guest.initial_program);
    w.dirty = true;
}

fn add_player(w: *World) *Player = {
    e := w.add_entity(i64.atomic_inc(w.next_id));
    init_player(w, e)
}

fn init_player(w: *World, e: *Entity) *Player = {
    a := general_allocator();
    e.info = (Player = zeroed(Player));
    it := e.info.Player&;
    it.inventory = (slots = a.alloc_zeroed(ItemStack, 16));
    if !w.is_client {
        it.errors = list(a);
        it.brain = a.box_zeroed(Guest.Guest);
        init(it.brain, e.id, w.next_id);
        w.players&.push(it.brain, a);
    };
    it
}

fn add_entity(w: *World, id: i64) *Entity = {
    e := w.entities.gpa.box_zeroed(Entity);
    w.entities&.push(e);
    e.id = (id = id, hint = w.entities.len);
    e
}

fn update(w: *World) void = {
    tick := w.dt > 1;
    if tick {
        w.dt -= 1;
        free_dead_entities(w);
    };
    range(0, w.entities.len) { i |
        e := w.entities[i];
        @if(tick) tick_entity(w, e);
        @match(e.info&) {
            fn Player(it) => {
                @if(tick) it.brain.send(.Tick);
                host_pipe(w, e, it);
            }
            @default => ();
        };
    };
}

fn free_dead_entities(w: *World) void = {
    a := general_allocator();
    w.entities&.unordered_retain(fn(it) => {
        dead := it.dead;
        if dead {
            if it[].inventory() { it |
                each it.slots { it |
                    @if_let(it.item&) fn Disk(it) => it.data&.drop(a);
                };
                a.dealloc(ItemStack, it.slots);
            };
            a.dealloc_one(Entity, it[]);
        };
        !dead
    });
}

fn tick_entity(w: *World, e: *Entity) void = {
    @if(e.dead) return();
    @match(e.info&) {
        fn Crop(it) => {
            it.age += 1;
            if it.age > (it.level + 1) * 10 {
                e.dead = true;
                w.dirty = true;
            };
        }
        @default => ();
    };
}

fn host_pipe(w: *World, e: *Entity, p: *Player) void = {
    a := general_allocator();
    while => p.brain.listen() { output |
        continue :: local_return;
        @match(output) {
            fn Move(it) => {
                move(e, it);
            }
            fn Error(msg) => {
                @fmt(p.errors&, "%\n", msg);
                a.dealloc(u8, msg);
            }
            fn CompileOk() => {
                if p.errors&.items() == compiling_message {
                    p.errors&.clear();
                };  // don't clear if there was a print at top level
                sync(w, p.brain, e);
            }
            fn Place(it) => {
                place(w, p, it.inventory_index, it.new_id.id);
            }
            fn Water(it) => {
                water(w, w.get(it.target), p, it.answer);
            }
            fn Harvest(it) => {
                harvest(w, w.get(it), p);
            }
            fn Camera(it) => {
                w.camera = it;
            }
            fn MoveItem(it) => {
                other := w.get(it.other);
                move_item(e, it.self_slot, other, it.other_slot, it.count);
                sync(w, e);
                sync(w, other);
            }
            fn DiskWrite(it) => {
                if e.get_disk(it.slot) { d |
                    if it.data.len <= d.limit {
                        d.data&.clear();
                        d.data&.push_all(it.data, a);
                        w.disk_dirty = true;
                    };
                };
                a.dealloc(u8, it.data);
            };
        };
        w.dirty = true;
    };
}

// positive count means other<-self
fn move_item(self: *Entity, self_slot: i64, other: *Entity, other_slot: i64, count: i64) bool = {
    @if(!within_range(self, other)) return(false);    
    self := self.inventory() || return(false);
    other := other.inventory() || return(false);
    @if(!self_slot.ult(self.slots.len) || !other_slot.ult(other.slots.len)) return(false);
    dest, src, d, s := (other, self, other_slot, self_slot);
    if count < 0 {| count = -count; t := src; src = dest; dest = t; t := s; s = d; d = t; };
    @if(src[s].count < count) return(false);
    if dest[d].item&.is(.Empty) {
        dest[d] = (item = src[s].item, count = count);
    } else {
        @if(dest[d].item& != src[s].item&) return(false);
        @if(dest[d].count + count > dest[d].item&.stack_limit()) return(false);
        dest[d].count += count;
    };
    src[s].count -= count;
    if src[s].count <= 0 {
        src[s].item = .Empty;
    };
    true
}

fn within_range(a: *Entity, b: *Entity) bool = norm_sq(a.pos - b.pos) < 2;

fn water(w: *World, e: *Entity, p: *Player, answer: f64) bool = {
    @if(e.dead) return(false);
    @match(e.info&) {
        fn Crop(it) => {
            ok := it.age >= it.level && it.level < max_crop_level;
            in_range := within_range(w.get(p.brain.id&), e);
            ok := in_range && ok && answer == sequence(it.type, it.level).float();
            it.level += int(ok);
            sync(w, e);
            ok
        };
        @default => false;
    }
}

fn harvest(w: *World, e: *Entity, p: *Player) bool = {
    @if(e.dead) return(false);
    pe := w.get(p.brain.id&);
    @match(e.info&) {
        fn Crop(it) => {
            ok := it.level > 0 && within_range(w.get(p.brain.id&), e);
            if ok {
                ok = insert_item(p.inventory&, (item = (Crop = it.type), count = it.level));
                if ok {
                    e.dead = true;
                };
            };
            sync(w, e);
            sync(w, pe);
            ok
        };
        @default => false;
    }
}

fn insert_item(inventory: *Inventory, new: ItemStack) bool = {
    if inventory.slots.find(fn(it) => it.item& == new.item&) { slot |
        if slot.count + new.count < slot.item&.stack_limit() {
            slot.count += new.count;
            return true;
        };
    };
    if inventory.slots.find(fn(it) => it.item&.is(.Empty)) { slot |
        slot[] = new;
        return true;
    };
    false
}

fn stack_limit(it: *Item) i64 = @if(it.is(.Disk), 1, 1000);

fn place(w: *World, p: *Player, inventory_index: i64, new_id: i64) bool = {
    @if(!inventory_index.ult(p.inventory.slots.len)) return(false);
    slot := p.inventory.slots[inventory_index]&;
    @if(slot.count <= 0) return(false);
    
    e := w.get(p.brain.id);
    for w.entities { it |
        if it.pos == e.pos && it.id.id != e.id.id && !it.dead {
            return false;
        };
    };
    
    a := general_allocator();
    new := @match(slot.item&) {
        fn Crop(type) => {
            new := w.add_entity(new_id);
            new.info = (Crop = (type = type[]));
            new
        }
        fn Chest() => {
            new := w.add_entity(new_id);
            new.info = (Chest = (slots = a.alloc_zeroed(ItemStack, 64)));
            new
        }
        fn Robot() => {
            new := w.add_entity(new_id);
            init_player(w, new);
            new
        }
        @default => return(false);
    };
    new.pos = e.pos;
    sync(w, new);
    
    slot.count -= 1;
    if slot.count <= 0 {
        slot.item = .Empty;
    };
    sync(w, e);
    true
}

fn move(e: *Entity, delta: Vec2) bool = {
    @if(delta.x.is_nan() || delta.y.is_nan() || abs(delta.x) > 1 || abs(delta.y) > 1) return(false);
    e.pos += delta;
    true
}

fn sync(w: *World, e: *Entity) void = {
    for w.players { it |
        sync(w, it, e);
    };
}

fn sync(w: *World, self: *Guest.Guest, e: *Entity) void = {
    @if(w.is_client) return();
    e := e[];
    a := general_allocator();
    if e&.inventory() { it |
        it.slots = it.slots.shallow_copy(a);
        each it.slots& { it |
            @if_let(it.item&) fn Disk(it) => {
                it.data = it.data.items().clone(a).as_raw();
            };
        };
    };
    self.send(SyncEntity = (shallow = e));
}

compiling_message :: "compiling\n";
fn recompile(it: *Player, source: Str) void = {
    it.errors&.clear();
    a := general_allocator();
    disk := it.inventory&[it.source_disk_slot]&;
    @if_let(disk.item&) fn Disk(d) => {
        if source.len < d.limit {
            it.errors&.push_all(compiling_message);
            d.data&.clear();
            d.data&.push_all(source, a);
            it.brain.send(Recompile = source.shallow_copy(a));
            return();
        };
        return it.errors&.push_all(@tfmt("program too large for this disk %/% bytes", source.len, d.limit));
    };
    it.errors&.push_all("disk not selected");
}

fn get(w: *World, id: EntityId) *Entity = get(w, id&);
fn get(w: *World, id: *EntityId) *Entity = {
    it := w.try_get(id); 
    it || @panic("invalid entity id %", id.id)
}

fn try_get(w: *World, id: EntityId) ?*Entity = try_get(w, id&);
fn try_get(w: *World, id: *EntityId) ?*Entity = {
    if id.hint.ult(w.entities.len) && w.entities[id.hint].id.id == id.id {
        return(Some = w.entities[id.hint]);
    };
    enumerate w.entities { i, it |
        if it.id.id == id.id {
            it.id.hint = i;
            id.hint = i;
            return(Some = it[]);
        };
    };
    .None
}

fn inventory(e: *Entity) ?*Inventory = {
    (Some = @match(e.info&) {
        fn Chest(it) => it;
        fn Player(it) => it.inventory&;
        @default => return(.None);
    })
}

fn index(e: *Inventory, i: i64) *ItemStack = e.slots.index(i);

fn sprite(e: *Entity) i64 = {
    @match(e.info&) {
        fn Player() => 0;
        fn Crop(it) => 1 + mod(it.type.raw(), 3);
        fn Chest() => 6;
    }
}

fn sprite(e: *Item) i64 = {
    @match(e) {
        fn Crop(it) => 1 + mod(it[].raw(), 3);
        fn Disk() => 7;
        fn Keyboard() => 8;
        fn Empty() => 9;
        fn Robot() => 0;
        fn Chest() => 6;
    }
}

fn display_name(e: *Item) Str = {
    @match(e) {
        fn Crop(it) => @match(it[]) {
            fn nat() => "Natural Carrots";
            fn fib() => "Leonardo 'Fibonacci' Bonacci's Beets";
            fn prime() => "Prime Protatoes";
        };
        fn Disk(it) => @tfmt("Disk (%/%)", it.data.len, it.limit);
        fn Empty() => "";
        @default => {
            t := e.tag();
            t.name_str()
        };
    }
}

max_crop_level :: 100;
fn sequence(type: CropType, i: i64) i64 = {
    @assert(i >= 0 && i < max_crop_level);
    @match(type) {
        fn nat() => i;
        fn prime() => {
            #use("@/lib/collections/bit_set.fr");
            n := 100;
            loop {
                // eratosthenes
                unprime: DynamicBitSet = empty(temp());
                k, primes := (2, 0);
                loop {
                    if !unprime&.get(k) {
                        primes += 1;
                        @if(primes == i) return(k);
                        j := k * k;
                        while => j < n {
                            unprime&.set(j);
                            j += i;
                        };
                    };
                    k += 1;
                };
                n *= n;
            };
            unreachable()
        }
        fn fib() => {
            a, b := (1, 1);
            range(0, i) { _ |
                c := a + b;
                a = b;
                b = c;
            };
            a
        }
    }
}

fn ne(a: *Item, b: *Item) bool = !eq(a, b);
fn eq(a: *Item, b: *Item) bool = {
    @if(a.tag() != b.tag()) return(false);
    @match(a) {
        fn Crop(aa) => aa[] == b.Crop;
        @default => true;
    }
}

#use("@/graphics/vec.fr");
Guest :: import("@/examples/gpu/auto/brain/guest.fr");
Ui :: import("@/graphics/deps/nuklear.fr");

fn get_disk(e: *Entity, slot: i64) ?*get_variant_type(Item, .Disk) = {
    get_disk(e.inventory() || return(.None), slot)
}

fn get_disk(e: *Inventory, slot: i64) ?*get_variant_type(Item, .Disk) = {
    @if(slot.ult(e.slots.len)) @if_let(e[slot].item&) fn Disk(it) =>
        return(Some = it);
    .None
}

fn get_disk(w: *World, e: EntityId) ?*get_variant_type(Item, .Disk) = {
    @if_let(w.get(e)[].info&) fn Player(it) => return(get_disk(it.inventory&, it.source_disk_slot));
    .None
}
