
World :: @rec @struct { 
    entities: List(*Entity);
    dirty: bool;
    next_id: i64;
};

EntityId :: @struct(id: i64, hint: i64);
Entity :: @rec @struct {
    pos: Vec2;
    id: EntityId;
    info: EntityInfo;
};

Player :: @struct {
    brain: *Guest.Guest;
    errors: List(u8);
    edit: Ui.Nuklear.nk_text_edit;
    inventory: Inventory;
};

EntityInfo :: @tagged(
    Player: Player,
    Crop: @struct {
        type: CropType;
        level := 0;
        age := 0;
    },
    Chest: Inventory,
);

CropType :: @enum(fib, fac, prime);
Inventory :: @struct(slots: []ItemStack);
ItemStack :: @struct(item: Item, count: i64);
Item :: @tagged(
    Empty: void,
    Crop: CropType,
    Disk: @struct(limit: i64),
    Keyboard,
);

fn init(w: *World) void = {
    a := general_allocator();
    w.entities = list(a);
    it := w.add_player();
    s := it.inventory.slots&;
    s[0] = (item = .Keyboard, count = 1);
    s[1] = (item = (Disk = (limit = 4096)), count = 1);
    s[2] = (item = (Crop = .fib), count = 5);
    s[3] = (item = (Crop = .fac), count = 5);
}

fn add_player(w: *World) *Player = {
    a := general_allocator();
    e := w.add_entity();
    e.info = (Player = zeroed(Player));
    it := e.info.Player&;
    it.inventory = (slots = a.alloc_zeroed(ItemStack, 16));
    it.errors = list(a);
    it.brain = a.box_zeroed(Guest.Guest);
    init(it.brain, e.id);
    Ui'Nuklear'nk_textedit_init_default(it.edit&);
    set_all(it.edit&, Guest.initial_program);
    it.recompile();
    it
}

fn add_entity(w: *World) *Entity = {
    e := w.entities.gpa.box_zeroed(Entity);
    w.entities&.push(e);
    e.id = (id = w.next_id, hint = w.entities.len - 1);
    w.next_id += 1;
    e
}

fn update(w: *World) void = {
    range(0, w.entities.len) { i |
        e := w.entities[i];
        @match(e.info&) {
            fn Player(it) => {
                host_pipe(w, e, it);
            }
            fn Crop(it) => {
                it.age += 1;
            }
            fn Chest() => ();
        };
    };
}

fn host_pipe(w: *World, e: *Entity, p: *Player) void = {
    a := general_allocator();
    while => p.brain.listen() { output |
        continue :: local_return;
        @match(output) {
            fn Move(it) => {
                move(e, it);
            }
            fn Error(msg) => {
                @fmt(p.errors&, "%\n", msg);
                a.dealloc(u8, msg);
            }
            fn CompileOk() => {
                p.errors&.clear();
                sync(p.brain, e);
            }
            fn Place(it) => {
                place(w, e, p, it.inventory_index);
            }
        };
        w.dirty = true;
    };
}

fn place(w: *World, e: *Entity, p: *Player, inventory_index: i64) bool = {
    @if(!inventory_index.ult(p.inventory.slots.len)) return(false);
    slot := p.inventory.slots[inventory_index]&;
    @if(slot.count <= 0) return(false);
    
    for w.entities { it |
        if it.pos == e.pos && it.id.id != e.id.id {
            return false;
        };
    };
    
    @match(slot.item&) {
        fn Crop(type) => {
            new := w.add_entity();
            new.pos = e.pos;
            new.info = (Crop = (type = type[]));
            sync(p.brain, new);
        }
        @default => return(false);
    };
    slot.count -= 1;
    if slot.count <= 0 {
        slot.item = .Empty;
    };
    sync(p.brain, e);
    true
}

fn move(e: *Entity, delta: Vec2) bool = {
    @if(delta.x.is_nan() || delta.y.is_nan() || abs(delta.x) > 1 || abs(delta.y) > 1) return(false);
    e.pos += delta;
    true
}

fn sync(self: *Guest.Guest, e: *Entity) void = {
    e := e[];
    a := general_allocator();
    @match(e.info&) {
        fn Player(p) => {
            p.inventory.slots = p.inventory.slots.shallow_copy(a);
        }
        @default => ();
    };
    self.send(SyncEntity = (shallow = e));
}

fn recompile(it: *Player) void = {
    it.errors&.clear();
    a := general_allocator();
    it.errors&.push_all("compiling");
    source := get_buf(it.edit.string.buffer&);
    it.brain.send(Recompile = source.shallow_copy(a));
}

fn get(w: *World, id: EntityId) *Entity = {
    it := w.try_get(id); 
    it || @panic("invalid entity id %", id.id)
}

fn try_get(w: *World, id: EntityId) ?*Entity = {
    if id.hint.ult(w.entities.len) && w.entities[id.hint].id.id == id.id {
        return(Some = w.entities[id.hint]);
    };
    for w.entities { it |
        if it.id.id == id.id {
            return(Some = it);
        };
    };
    .None
}

fn sprite(e: *Entity) i64 = {
    @match(e.info&) {
        fn Player() => 0;
        fn Crop(it) => 1 + mod(it.type.raw(), 3);
        fn Chest() => 6;
    }
}

fn sprite(e: *Item) i64 = {
    @match(e) {
        fn Crop(it) => 1 + mod(it[].raw(), 3);
        fn Disk() => 7;
        fn Keyboard() => 8;
        fn Empty() => 9;
    }
}

#use("@/graphics/vec.fr");
Guest :: import("@/examples/gpu/auto/brain/guest.fr");
Ui :: import("@/graphics/deps/nuklear.fr");
