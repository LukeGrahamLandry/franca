
Lua :: import("@/examples/disassemble.fr").Lua;
Guest :: @rec @struct {
    input: QRing'Tube(Input);
    output: QRing'Tube(Output);
    worker: *Thread;
    lua: *Lua'lua_State;
    id: Sim.EntityId;
    client: *Sim.World;
};

Input :: @tagged(
    Key: @struct(char: i64, down: bool),
    Recompile: Str,
    SyncEntity: @struct(shallow: Sim.Entity),
    Tick,
);
Output :: @tagged(
    Move: Vec2,
    Place: @struct(inventory_index: i64, new_id: Sim.EntityId),
    Error: Str,
    CompileOk,
    Water: @struct(target: Sim.EntityId, answer: f64),
    Harvest: Sim.EntityId,
    Camera: Sim.CameraPos,
    // positive count means other<-self
    MoveItem: @struct(other: Sim.EntityId, other_slot: i64, self_slot: i64, count: i64),
);

fn init(self: *Guest, id: Sim.EntityId, next_id: *i64) void = {
    n := 128;
    a := general_allocator();
    self.input = (ring = a.alloc_zeroed(Input, n));
    self.output = (ring = a.alloc_zeroed(Output, n));
    self.worker = start_thread(Guest, guest_main, self);
    self.client = a.box_zeroed(Sim.World);
    self.client.next_id = next_id;
    self.client.is_client = true;
    self.client.entities = list(a);
    e := a.box_zeroed(Sim.Entity);
    self.id = id;
    e.id = id;
    e.info = (Player = zeroed(Sim.Player));
    e.info.Player.brain = self;
    e.info.Player.inventory.slots = a.alloc_zeroed(Sim.ItemStack, 16);
    self.client.entities&.push(e);
}

fn send(self: *Guest, msg: Input) void = {
    if self.output.claimed.bouba - self.output.committed.kiki == self.output.ring.len.trunc() {
        // dont block the main thread if the other one is stuck 
        return();  
    };
    self.input&.push(msg);
}

fn listen(self: *Guest) ?Output = {
    @if(self.output.claimed.kiki == self.output.committed.bouba) return(.None);
    (Some = self.output&.pop())
}

fn client(self: *Guest, it: Output) void = {
    @match(it&) {
        fn Move(delta) => @if(!move(self.client.get(self.id&), delta[])) return();
        @default => ();
    };
    self.output&.push(it);
}

guest_main :: fn(self: *Guest) void #use(Lua) = {
    L := Lua'luaL_newstate();
    L.open_and_pop("math", Lua'luaopen_math);
    L.open_and_pop("string", Lua'luaopen_string);
    L.open_and_pop("table", Lua'luaopen_table);
    L.open_and_pop("_G", luaopen_base);
    
    no := @const_slice(@as(CStr) "collectgarbage", "dofile", "loadfile", "load");
    lua_getglobal(L, S"_G");
    for no { it |
        lua_pushnil(L);
        lua_setfield(L, -2, S(it));
    };
    pushlstring(L, world_api);
    lua_setfield(L, -2, S"rom");
    lua_pop(L, 1);
    
    src := world_api;
    r := luaL_loadbufferx(L, bit_cast_unchecked(*u8, *i8, src.ptr), src.len.bitcast(), zeroed(*i8), S"t");
    @assert(r == 0, "%", get_str(L, -1));
    r := lua_pcall(L, 0, 0, 0);
    @assert(r == 0, "%", get_str(L, -1));
    
    S :: fn(s: CStr) = bit_cast_unchecked(CStr, *i8, s);
    get_str :: fn(L: *lua_State, i: i32) Str = {
        length: u64 = 0;
        p := lua_tolstring(L, i, length&);
        bit_cast_unchecked(*i8, *u8, p).slice(length.bitcast())
    };
    pushlstring :: fn(L: *lua_State, s: Str) void = {
        lua_pushlstring(L, bit_cast_unchecked(*u8, *i8, s.ptr), s.len.bitcast());
    };
    get_number :: fn(L: *lua_State, i: i32) f64 = {
        ok: i32 = 0;
        v := lua_tonumberx(L, i, ok&);
        @if(ok == 1, v, NaN)
    };
    get_or_new :: fn(L: *lua_State, i: i32) void = {
        lua_pushvalue(L, -1);
        lua_gettable(L, i-1);
        
        if lua_istable(L, -1) {
            lua_pop(L, 1);
            lua_gettable(L, i);
        } else {  // TODO: rotate?
            lua_pop(L, 1);
            lua_pushvalue(L, -1);
            lua_createtable(L, 0, 0);
            lua_settable(L, i-2);
            lua_gettable(L, i);
        }
    };
    // TODO: make id on the lua side be {id,hint} so its faster
    get_entity_id :: fn(L: *lua_State, i: i32) Sim.EntityId = {
        (id = get_number(L, i).int(), hint = 0)
    };
    // [table] -> [table]
    write_item :: fn(L: *lua_State, slot: *Sim.ItemStack) void = {
        lua_pushnumber(L, slot.count.float());
        lua_setfield(L, -2, S"count");
        t := slot.item&.tag();
        pushlstring(L, t.name_str());
        lua_setfield(L, -2, S"item");
        @match(slot.item&) {
            fn Crop(it) => {
                pushlstring(L, it[].name_str());
                lua_setfield(L, -2, S"kind");
            }
            @default => ();
        };
    }
    
    get_inventory_fn :: fn(L: *lua_State) i32 = {
        self := Guest.ptr_from_raw(lua_topointer(L, lua_upvalueindex(1)));
        entity_id := get_entity_id(L, 1);
        slot_index := get_number(L, 2).int() - 1;
        if self.client.try_get(entity_id) { e |
            break :: local_return;
            inventory := e.inventory() || break();
            if slot_index.ult(inventory.slots.len) {
                lua_createtable(L, 0, 0);
                write_item(L, inventory.slots[slot_index]&);
                return 1;
            };
            key := get_str(L, 2);
            if key == "n" {
                lua_pushnumber(L, inventory.slots.len.float());
                return 1;
            };
        };
        
        lua_pushnil(L);
        1
    };
    entity_index_fn :: fn(L: *lua_State) i32 = {
        self := Guest.ptr_from_raw(lua_topointer(L, lua_upvalueindex(1)));
        entity_id := get_entity_id(L, 1);
        key := get_str(L, 2);
        if self.client.try_get(entity_id) { e |
            @switch(key) {
                @case("pos") => {
                    lua_createtable(L, 0, 0);
                    lua_pushnumber(L, e.pos.x.cast());
                    lua_setfield(L, -2, S"x");
                    lua_pushnumber(L, e.pos.y.cast());
                    lua_setfield(L, -2, S"y");
                };
                @case("age") => @match(e.info&) {
                    fn Crop(it) => lua_pushnumber(L, it.age.float());
                    @default => lua_pushnil(L);
                };
                @case("level") => @match(e.info&) {
                    fn Crop(it) => lua_pushnumber(L, it.level.float());
                    @default => lua_pushnil(L);
                };
                @case("kind") => @match(e.info&) {
                    fn Crop(it) => pushlstring(L, it.type.name_str());
                    @default => lua_pushnil(L);
                };
                @case("type") => {
                    it := e.info&.tag();
                    pushlstring(L, it.name_str());
                };
                @default => lua_pushnil(L);
            };
            return 1;
        };
        lua_pushnil(L);
        1
    };
    
    send_fn :: fn(L: *lua_State) i32 = {
        self := Guest.ptr_from_raw(lua_topointer(L, lua_upvalueindex(1)));
        action := get_str(L, 1);
        @switch(action) {
            @case("move") => {
                x := get_number(L, 2);
                y := get_number(L, 3);
                self.client(Move = vec2(x.cast(), y.cast()));
            };
            @case("place") => {
                i := get_number(L, 2).int() - 1;
                e := self.client.get(self.id);
                new_id := i64.atomic_inc(self.client.next_id);
                ok := place(self.client, e, e.info.Player&, i, new_id);
                @if(ok) self.client(Place = (inventory_index = i, new_id = (id = new_id, hint = 0)));
                lua_pushboolean(L, ok.int().intcast());
                return 1;
            };
            @case("print") => {
                msg := get_str(L, 2).shallow_copy(general_allocator());
                self.client(Error = msg);
            };
            @case("water") => {
                answer := get_number(L, 3);
                entity_id := get_entity_id(L, 2);
                p := self.client.get(self.id);
                ok := false;
                if self.client.try_get(entity_id) { e |
                    ok = water(self.client, e, p.info.Player&, answer);
                    if ok {
                        self.client(Water = (target = e.id, answer = answer));
                    };
                };
                lua_pushboolean(L, ok.int().intcast());
                return 1;
            };
            @case("look") => {
                p := self.client.get(self.id);
                for self.client.entities { e |
                    if e.pos == p.pos && e.id.id != p.id.id && !e.dead {
                        lua_getglobal(L, S"entities");
                        lua_pushnumber(L, e.id.id.float());
                        get_or_new(L, -2);
                        lua_pushnumber(L, e.id.id.float());
                        lua_setfield(L, -2, S"id");
                        lua_getglobal(L, S"entity_metatable");
                        lua_setmetatable(L, -2);
                        return 1;
                    };
                };
            };
            @case("harvest") => {
                entity_id := get_entity_id(L, 2);
                p := self.client.get(self.id);
                ok := false;
                if self.client.try_get(entity_id) { e |
                    ok = harvest(self.client, e, p.info.Player&);
                    if ok {
                        self.client(Harvest = e.id);
                    };
                };
                lua_pushboolean(L, ok.int().intcast());
                return 1;
            };
            @case("camera") => {
                x := get_number(L, 2);
                y := get_number(L, 3);
                size := get_number(L, 4);
                self.client(Camera = (offset = vec2(x.cast(), y.cast()), size = size.cast()));
            };
            @case("move_item") => {
                entity_id := get_entity_id(L, 2);
                self.client(MoveItem = (
                    other = entity_id,
                    other_slot = get_number(L, 3).int() - 1,
                    self_slot = get_number(L, 4).int() - 1,
                    count = get_number(L, 5).int(),
                ));
            };
            @case("read_disk") => {
                i := get_number(L, 2).int() - 1;
                e := self.client.get(self.id);
                if e.inventory() { e |
                    if i.ult(e.slots.len) {
                        @if_let(e[i].item&) fn Disk(it) => {
                            pushlstring(L, it.data.items());
                            return 1;
                        }
                    }
                };
            };
            @case("write_disk") => {
                i := get_number(L, 2).int() - 1;
                data := get_str(L, 3);
                e := self.client.get(self.id);
                if e.inventory() { e |
                    if i.ult(e.slots.len) {
                        @if_let(e[i].item&) fn Disk(it) => {
                            if data.len <= it.limit {
                                it.data&.clear();
                                it.data&.push_all(data, general_allocator());
                                lua_pushboolean(L, 1);
                                // TODO: sync
                                // TODO: let it ask to recompile
                                return 1;
                            };
                        }
                    }
                };
            };
            @default => @eprintln("invalid send '%'", action);
        };
        0
    };
    
    a := general_allocator();
    loop {
        continue :: local_return;
        check_error :: fn(r) => if r != 0 {
            msg := get_str(L, -1).shallow_copy(a);
            self.client(Error = msg);
            lua_pop(L, 1);
            continue();
        };
        input := self.input&.pop();
        @match(input) {
            fn Tick() => {
                w := self.client;
                range(0, w.entities.len) { i |
                    e := w.entities[i];
                    tick_entity(w, e);
                };
            }
            fn Recompile(src) => {
                it := self.client.get(self.id)[].info.Player&;
                disk := it.inventory&[it.source_disk_slot]&;
                @if_let(disk.item&) fn Disk(d) => {
                    d.data&.clear();
                    d.data&.push_all(src, a);
                };
            
                lua_pushnil(L);
                lua_setglobal(L, S"handle_event");
                
                lua_getglobal(L, S"entities");
                lua_pushnumber(L, self.id.id.float());
                lua_getglobal(L, S"self");
                lua_pushnumber(L, self.id.id.float());
                lua_setfield(L, -2, S"id");
                lua_settable(L, -3);
                lua_pop(L, 1);
                
                extern :: fn(name: CStr, f: @FnPtr(L: *lua_State) i32) void => {
                    lua_pushlightuserdata(L, Guest.raw_from_ptr(self));
                    lua_pushcclosure(L, f, /*#upvalues*/ 1);
                    lua_setglobal(L, S(name));
                };
                extern("send", send_fn);
                extern("get_inventory_slot", get_inventory_fn);
                extern("get_entity_field", entity_index_fn);
                
                r := luaL_loadbufferx(L, bit_cast_unchecked(*u8, *i8, src.ptr), src.len.bitcast(), S"Program", S"t");
                general_allocator().dealloc(u8, src);
                check_error(r);
                r := lua_pcall(L, 0, 0, 0);
                check_error(r);
                self.client(.CompileOk);
            }
            fn Key(it) => {
                Lua'lua_getglobal(L, S"on_key_event");
                Lua'lua_pushnumber(L, it.char.float());
                Lua'lua_pushnumber(L, it.down.int().float());
                r := Lua'lua_pcall(L, 2, 0, 0);
                check_error(r);
                
                // TODO: wait to do this until the ring is empty so send can re-poll so you get syncs faster
                lua_getglobal(L, S"pop_events");
                r := Lua'lua_pcall(L, 0, 0, 0);
                check_error(r);
            }
            fn SyncEntity(it) => {
                src := it.shallow&;
                dest := self.client.try_get(src.id) || {
                    @if(src.dead) continue();   // :leak if it has inventory
                    e := self.client.add_entity(src.id.id);
                    e.info&.tag_ptr()[] = src.info&.tag();
                    e
                };
                dest.pos = src.pos;
                dest.dead = src.dead;
                if dest.dead {
                    // in case the lua is holding a reference to it already
                    lua_getglobal(L, S"entities");
                    lua_pushnumber(L, dest.id.id.float());
                    lua_gettable(L, -2);
                    if lua_istable(L, -1) {
                        lua_pushboolean(L, 1);
                        lua_setfield(L, -2, S"dead");
                    };
                    lua_pop(L, 1);
                };
                
                if dest.inventory() { it |
                    sync_inventory(it, src.inventory().unwrap());
                };
                
                @match(dest.info&) {
                    fn Crop(_) => {
                        dest.info = src.info;
                    }
                    fn Player(it) => {
                        it.source_disk_slot = src.info.Player.source_disk_slot;
                    }
                    @default => ();
                };
            }
        }
    };
    Lua'lua_close(L);
}

sync_inventory :: fn(dest: *Sim.Inventory, src: *Sim.Inventory) void = {
    a := general_allocator();
    each dest.slots& { it |
        @if_let(it.item&) fn Disk(it) => it.data&.drop(a);
    };
    if src.slots.len != dest.slots.len {
        a.dealloc(Sim.ItemStack, dest.slots);
        dest.slots = a.alloc_uninit(Sim.ItemStack, src.slots.len);
    };
    dest.slots.copy_from(src.slots);
    a.dealloc(Sim.ItemStack, src.slots);
    src.slots = empty();
};

world_api :: """
entities = {}
self = {}
events = { base = 1, count = 0 }

function on_key_event(char, is_down) 
    local e = events;
    e[e.base + e.count] = { char, is_down };
    e.count = e.count + 1;
end

function pop_events()
    local e = events;
    while e.count > 0 do 
        local event = e[e.base];
        e[e.base] = nil;
        e.base = e.base + 1;
        e.count = e.count - 1;
        handle_key(table.unpack(event));
    end
end

function print(s) 
    local function str(seen, s) 
        local t = type(s);
        local prim = t == "string" or t == "number";
        if prim then return s end
        if t == "table" then
            if seen[s] then return "<rec>" end
            seen[s] = true;
            local out = "{";
            for k, v in pairs(s) do 
                out = out .. str(seen, k) .. "=" .. str(seen, v) .. ",";
            end
            return out .. "}"
        end
        if t == "boolean" then return s and "true" or "false" end
        return t
    end
    send("print", str({}, s));
end

self.place = function(self, i) return send("place", i) end
self.move = function(self, dx, dy) send("move", dx, dy) end
self.look = function(self) return send("look") end
self.give_item = function(self, self_index, other, other_index, count) 
    return send("move_item", other.id, other_index, self_index, count)
end
self.take_item = function(s, si, o, oi, n) return s:give_item(o,oi,si,-n) end
self.read_disk = function(self, slot) return send("read_disk", slot) end
self.write_disk = function(self, slot, data) return send("write_disk", slot, data) end

local function inventory_metatable(id) return { 
    __index = function(_, i) 
        return get_inventory_slot(id, i) 
    end,
    __pairs = function(inventory) 
        local function f(inventory, i)
            local it = inventory[i+1];
            if it == nil then return nil end
            if it.item == "Empty" then return f(inventory, i+1) end
            return i+1, inventory[i+1]  
        end
        return f, inventory, 0;
    end,
} end;

local function water_entity(it, answer) return send("water", it.id, answer) end
local function harvest_entity(it) return send("harvest", it.id) end

local entity_keys = {"type","pos","inventory","age","level","kind"};
entity_metatable = {
    __index = function(self, key)
        if key == "inventory" then 
            return setmetatable({}, inventory_metatable(self.id)) 
        end
        if key == "water" then return water_entity end
        if key == "harvest" then return harvest_entity end
        return get_entity_field(self.id, key);
    end,
    __pairs = function(self) 
        local i = 1
        local function f(self)
            local key = entity_keys[i]
            i = i + 1
            if key == nil then return nil end
            local value = self[key]
            if value ~= nil then return key, value end
            return f(self);
        end
        return f, self, entity_keys[0];
    end,
};

setmetatable(self, entity_metatable);

""";

initial_program :: """
local keys = {
    [string.byte("W")] = { 0, -1},
    [string.byte("S")] = { 0,  1},
    [string.byte("A")] = {-1,  0},
    [string.byte("D")] = { 1,  0},
}

local crop_solutions = {
    nat = function(i) return i end,
    fib = function(i) 
        a, b = 1, 1
        for j=1,i do a, b = b, a+b end
        return a
    end,
};

local function solve_crop(it)
    assert(it ~= nil and it.type == "Crop");
    local f = crop_solutions[it.kind]
    assert(f ~= nil, "solve_crop " .. it.kind);
    local ok = it:water(f(it.level));
    if not ok then print({ "solve_crop failed", it }) end
end

function handle_key(char, is_down)
    if is_down == 0 then return nil end
    if keys[char] ~= nil then 
       self:move(table.unpack(keys[char]));
    end
    if char >= string.byte("1") and char <= string.byte("9") then 
        local i = char - string.byte("1") + 1;
        if not self:place(i) then 
            print("failed to place " .. self.inventory[i].item);
        end
    end
    if char == string.byte("Q") then 
        local it = self:look();
        if it ~= nil then solve_crop(it); end
    end
    if char == string.byte("E") then 
        local it = self:look();
        if it ~= nil then it:harvest(); end
    end
    if char == string.byte("C") then 
        send("camera", self.pos.x - 12, self.pos.y - 12, 20);
    end
    if char == string.byte("T") then 
        self:place(6);
        self:give_item(2, self:look(), 1, 1);
    end
end

""";

QRing :: import("@/lib/sys/sync/qring.fr");
#use("@/lib/sys/threads.fr");
Sim :: import("@/examples/gpu/auto/world.fr");
#use("@/graphics/vec.fr");
