//       all really need to do the same thing but i end up doing it a billion times slightly differently :(

mappings :: @static {
    ctx: Mappings = (
        action = init(),
    ); ctx := ctx&;
    
    #use("@/examples/gpu/maze_game/world.fr");
    @add_fields(ctx, Get(.Life).App, @const_slice(.memo, .uni, .paused, .show_info, .target_eval_speed, .eval_fraction));
    
    Patterns :: import("@/examples/life/pattern.fr");
    ctx.set_repr(import("@/examples/life/eval.fr")'Memo, @struct(mc: Str), fn(repr, memo) = {
        out := @ref u8.list(temp());
        Patterns'write_mc(out, memo, memo.root, memo.size);
        repr[] = (mc = out.items());
    }, fn(memo, repr) = {
        it := @try(Patterns'read(memo, repr.mc)) return;
        memo.root = it.node;
        memo.size = it.size; 
        .Ok
    });
        
    @add_fields(ctx, Get(.Chess).App, @const_slice(.board));
    // TODO: lastMove is shown in the ui sometimes
    @add_fields(ctx, import("@/examples/chess/gui.fr")'BoardView, @const_slice(.size, .board, .show_square_labels, .show_bit_board, .click_index, .promote, .ugly_pieces));
    
    ctx.set_repr(import("@/examples/chess/moves.fr")'Board, @struct(fen: Str), fn(repr, in) = {
        out := @ref u8.list(temp());
        in.writeFen(out);
        repr[] = (fen = out.items());
    }, fn(out, repr) = {
        board := fromFen(repr.fen) 
            || return(Err = "invalid fen");
        out[] = board;
        .Ok
    });
    
    @add_fields(ctx, Get(.Mandelbrot).App, @const_slice(.params, .saved_z, .saved_scale));
    
    // TODO: probably also want fov (and let you change it with scroll wheel in the game to zoom)
    @add_fields(ctx, import("@/examples/gpu/maze_game/camera.fr")'Camera, @const_slice(.pos, .rot));
    
    @add_fields(ctx, Get(.FarmGame).App, @const_slice(.world));
    
    // TODO: .start_time needs to get remapped on load. save current t offset from that. 
    @add_fields(ctx, Get(.Stackie).App, @const_slice(.src,.show_generate_code,.rand_index,.i));
    
    @add_fields(ctx, Get(.Editor).App, @const_slice(/*.objects, :SaveSliceAllocator*/ .pos, .scale, .prev_click, .tool));
    
    // TODO: write circuit.data files
    ctx.set_repr(Get(.Circuit).App, void, fn(repr, in) = (), fn(out, repr) = .Ok);
    // for now there's no way to edit it so doesn't matter
    ctx.set_repr(Get(.Rtc).App, void, fn(repr, in) = (), fn(out, repr) = .Ok);
    
    Terminal :: import("@/examples/gpu/terminal.fr");
    // TODO: buffer stack, scale/colour, history. 
    //       in progress search? can't have the @@B pointer links. 
    //       repl is nontrivial. 
    ctx.set_repr(Get(.Terminal).App, @struct(text: Str, view: FieldType(Terminal.TextBuffer, .view)), fn(repr, in) = {
        Terminal'push_state(in) {
            out := @ref u8.list(temp());
            buf := selected_buffer().unwrap();
            get_string(buf, out);
            repr.text = out.items();
            repr.view = buf.view;
        };
    }, fn(out, repr) = {
        Terminal'push_state(out) {
            buf := selected_buffer().unwrap();
            append_string(buf, repr.text);
            buf.view = repr.view;
        };
        .Ok
    });
    
    // currently the only types are dynamically computed (like trophy room) or fixed from map data. either way saving isn't useful
    // @add_fields(ctx, Get(.Hint).App, @const_slice(.colour, .msg, .scale));
    ctx.set_repr(Get(.Hint).App, void, fn(repr, in) = (), fn(out, repr) = .Ok);
    
    // TODO: active_room needs to be recomputed. puzzle_focus needs to be saved as link
    @add_fields(ctx, Get(.Player).App, @const_slice(.camera, .inventory, .enable_cheats, /*.active_room, .puzzle_focus,*/ .child_fullscreen, ));
    
    #use("@/graphics/vec.fr");
    ctx.set_repr(Vec2, Array(f32, 2), fn(repr, in) = { repr[] = in.v; }, fn(out, repr) = { out.v = repr[]; .Ok });
    ctx.set_repr(Vec3, Array(f32, 3), fn(repr, in) = { repr[] = in.v; }, fn(out, repr) = { out.v = repr[]; .Ok });
    ctx.set_repr(Vec4, Array(f32, 4), fn(repr, in) = { repr[] = in.v; }, fn(out, repr) = { out.v = repr[]; .Ok });
    ctx.set_repr(Vec(f64, 2), Array(f64, 2), fn(repr, in) = { repr[] = in.v; }, fn(out, repr) = { out.v = repr[]; .Ok });
    ctx.set_repr(import("@/examples/gpu/mandelbrot.fr")'F64, f64, fn(repr, in) = { repr[] = in[].double(); }, fn(out, repr) = { out[] = repr[].double(); .Ok });
    
    // todo: allow different vtables?
    ctx.set_repr(Random.Rng, Array(u64, 4), fn(repr, in) = { repr[] = in.s; }, fn(out, repr) = { out[] = (s = repr[], next = Random.Rng.xoshiro256SS); .Ok });
    
    ctx[]
};

mappings_get :: fn($T: Type) MappingVTable = @run {
    ::?MappingVTable;
    ctx :: mappings;
    a :: ctx.action&;
    @if(@run a.get(T).is_none()) {
        @if(@is(get_type_info_ref(T), .Int, .F32, .F64, .void, .Bool)) {
            ctx.set_raw_bytes(T);
        };
        @if(@run IsCollection(List)(T)) {
            ctx.set_repr(T, []T.Element, fn(repr, in) = {
                repr[] = in.items();
            }, fn(out, repr) = {
                out.clear();
                out.push_all(repr[]);
                .Ok
            });
        };
        @if(@run IsCollection(Slice)(T)) {
            ctx.set_direct(T, fn(ctx, it) = {
                store(ctx, i64, it.len&);
                each it { it |
                    store(ctx, @type it[], it);
                };
            }, fn(ctx, it) = {
                n := 0;
                @try(load(ctx, i64, n&)) return;
                it[] = temp().alloc_zeroed(T.Element, n);  // TODO: but which allocator? this is only ok when used immediately for filling in a list
                // :SLOW if they're all primitives and no padding
                each it { it |
                    @try(load(ctx, @type it[], it)) return;
                };
                .Ok
            });
        };
    };
    a.get(T) || (.Auto)
};

allow_infer :: fn(fid: FuncId) void = {
    func := get_function_ast(fid, false, false, false, false);
    func.annotations&.push((name = @symbol("where"), args = @literal ()), ast_alloc());
    func.set_flag(.Generic);
    func.set_flag(.UnboundGenerics);
}

fn set_repr(
    ctx: *Mappings, $T: Type, $Repr: Type, 
    $to_repr: @Fn(repr: *Repr, in: *T) void, 
    $from_repr: @Fn(out: *T, repr: *Repr) Result(void, Str),
) void #generic = {
    allow_infer(to_repr);
    allow_infer(from_repr);
    ctx.action&.insert(T, (WithRepr = (Repr = Repr, to_repr = to_repr, from_repr = from_repr)), ast_alloc());
}

fn set_direct(
    ctx: *Mappings, $T: Type,
    $store: @Fn(ctx: *StoreCtx, in: *T) void,
    $load: @Fn(ctx: *LoadCtx, out: *T) Result(void, Str), 
) void #generic = {
    allow_infer(store);
    allow_infer(load);
    ctx.action&.insert(T, (Direct = (load = load, store = store)), ast_alloc());
}

fn set_raw_bytes(ctx: *Mappings, $T: Type) void #generic = {
    ctx.set_direct(T, fn(ctx, it) = {
        ctx.out.reserve_type(T)[] = it[];
    }, fn(ctx, it) = {
        @if(ctx.in.len < size_of(T)) return(Err = "truncated");
        it[] = ctx.in&.pop_type(T)[];
        .Ok
    })
}

// bleh, just exists because @const_slice can't forward result type
fn add_fields(e: FatExpr) FatExpr #macro = {
    e := e&.items();
    args := e[2].expr.PrefixMacro.arg.items();
    args[0] = @{ @as(Fields(@[e[1]])) @[args[0]] };
    @{ add_fields(@[e[0]], @[e[1]], @[e[2]]) }
}

fn add_fields(ctx: *Mappings, $Parent: Type, $field_names: []Fields(Parent)) void #generic = {
    ctx.action&.insert(Parent, (FilterFields = (
        fields_type = Fields(Parent),
        fields = bit_cast_unchecked([]Fields(Parent), []i64, field_names),
    )), ast_alloc());
}

// TODO: hashtable, slice, list

Mappings :: @struct {
    action: RawHashMap(Type, MappingVTable);
};

MappingVTable :: @tagged(
    WithRepr: @struct {
        Repr: Type;
        to_repr: FuncId;
        from_repr: FuncId;
    },
    Direct: @struct {
        load: FuncId;
        store: FuncId;
    },
    FilterFields: @struct {
        fields_type: Type;
        fields: []i64;
    },
    Auto: void,
);

StoreCtx :: @struct {
    out: *List(u8);
};

LoadCtx :: @struct {
    in: []u8;
};

fn store(ctx: *StoreCtx, $T: Type, it: *T) void #generic = {
    @inline_match(@static mappings_get(T)) {
        fn WithRepr($v) => {
            repr := zeroed(v.Repr);
            (@run v'to_repr)(repr&, it);
            store(ctx, v.Repr, repr&)
        }
        fn Direct($v) => return((@run v'store)(ctx, it));
        fn Auto() => auto_store(ctx, T, it);
        fn FilterFields($f) => {
            fields :: bit_cast_unchecked([]i64, []f.fields_type, f.fields);
            inline_for fields { $f | 
                inner := T.get_field(it, f[]);
                store(ctx, @type inner[], inner);
            };
        }
    }
}

fn auto_store(ctx: *StoreCtx, $T: Type, it: *T) void #generic = {
    @inline_match(@run T.get_type_info_ref()) {
        fn Enum($f) => store(ctx, f.raw, bit_cast_unchecked(*T, *@run f.raw, it));
        fn Struct($f) => {
            @run @ct_assert(!f.is_union, @source_location, "store union: %", @run T.typename().str());
            inline_for T.get_fields() { $f | 
                inner := T.get_field_ptr(it, f);
                store(ctx, @type inner[], inner);
            };
        }
        fn Tagged($t) => {
            store(ctx, Tag(T), @ref it.tag());
            i := 0;
            tag_value := it.tag().raw();
            inline_for T.get_variants() { $f | 
                if i == tag_value {
                    inner := T.get_variant_ptr_for(it, f);
                    store(ctx, @type inner[], inner);
                };
                i += 1;
            };
        }
        fn Array() => each it { inner |
            store(ctx, @type inner[], inner);
        };
        @default => @panic("Unsupported type for store %", @run T.typename().str());
    };
}

fn load(ctx: *LoadCtx, $T: Type, it: *T) Result(void, Str) #generic = {
    action :: @static mappings_get(T);
    @inline_match(action) {
        fn WithRepr($v) => {
            repr := zeroed(v.Repr);
            @try(load(ctx, v.Repr, repr&)) return;
            @try((@run v'from_repr)(it, repr&)) return;
        }
        fn Direct($v) => return((@run v'load)(ctx, it));
        fn Auto() => return(auto_load(ctx, T, it));
        fn FilterFields($f) => {
            fields :: bit_cast_unchecked([]i64, []f.fields_type, f.fields);
            inline_for fields { $f | 
                inner := T.get_field(it, f[]);
                @try(load(ctx, @type inner[], inner)) return;
            };
        }
    };
    .Ok
}

fn auto_load(ctx: *LoadCtx, $T: Type, it: *T) Result(void, Str) #generic = {
    @inline_match(@run T.get_type_info_ref()) {
        fn Enum($f) => return(load(ctx, f.raw, bit_cast_unchecked(*T, *@run f.raw, it)));
        fn Struct($f) => {
            @run @ct_assert(!f.is_union, @source_location, "load union: %", @run T.typename().str());
            inline_for T.get_fields() { $f | 
                inner := T.get_field_ptr(it, f);
                @try(load(ctx, @type inner[], inner)) return;
            };
        }
        fn Tagged() => {
            t := zeroed(Tag(T));
            @try(load(ctx, Tag(T), t&)) return;
            it.tag_ptr()[] = t;
            i := 0;
            tag_value := t.raw();
            inline_for T.get_variants() { $f | 
                if i == tag_value {
                    inner := T.get_variant_ptr_for(it, f);
                    @try(load(ctx, @type inner[], inner)) return;
                };
                i += 1;
            };
        }
        fn Array() => each it { inner |
            @try(load(ctx, @type inner[], inner)) return;
        };
        @default => @panic("Unsupported type for load %", @run T.typename().str());
    };
    .Ok
}

fn store_text(ctx: *StoreCtx, $T: Type, it: *T) void #generic = {
    out := ctx.out;
    @if(@run (IsCollection(Slice)(T) && T != Str)) {
        @fmt(out, "(");
        each it { it |
            store_text(ctx, T.Element, it);
            @fmt(out, ",");
        };
        out.len -= int(out.items().ends_with(","));
        @fmt(out, ")");
        return();
    };
    
    @if(@run(T != u32 && @is(get_type_info_ref(T), .Int, .F32, .F64, .void, .Bool))) {
        @fmt(out, "%", it[]);
        return();
    };
    @if(T == Vec2) @fmt(out, "vec2");
    @if(T == Vec3) @fmt(out, "vec3");

    #use("@/graphics/lib.fr");
    @inline_switch(T) {
        @case(void) => @fmt(out, "()");
        // TODO: just use \x00 non-printable characters
        @case(Str) => {
            if it[].contains("\n".ascii()) {
                @fmt(out, "\"\"\"%\"\"\"", it[]);
            } else {
                @fmt(out, "\"%\"", it[]);
            };
        };
        @case(u32) => @fmt(out, "%", fmt_hex(it[]));
        @default => ({
            @inline_match(@static mappings_get(T)) {
                fn WithRepr($v) => {
                    repr := zeroed(v.Repr);
                    (@run v'to_repr)(repr&, it);
                    store_text(ctx, v.Repr, repr&)
                }
                fn Direct($v) => {
                    @panic("TODO: %", T.typename().str());
                }
                fn Auto() => auto_store_text(ctx, T, it);
                fn FilterFields($f) => @panic("TODO: %", T.typename().str());
            };
        });
    };
}

fn auto_store_text(ctx: *StoreCtx, $T: Type, it: *T) void #generic = {
    out := ctx.out;
    @inline_match(@run T.get_type_info_ref()) {
        fn Enum($f) => {
            @fmt(out, ".%", it[].name_str());
        }
        fn Struct($f) => {
            @run @ct_assert(!f.is_union, @source_location, "store union: %", @run T.typename().str());
            out.push_all("(");
            inline_for T.get_fields() { $f | 
                inner := T.get_field_ptr(it, f);
                @fmt(out, "%=", @run f[].name.str());
                store_text(ctx, @type inner[], inner);
                @fmt(out, ", ");
            };
            out.len -= int(out.items().ends_with(" "));
            out.push_all(")");
        }
        fn Tagged($t) => {
            @fmt(out, "(% = ", it.tag());
            
            i := 0; // TODO : inline_enumerate
            tag_value := it.tag().raw();
            // TODO: @inline_switch.
            inline_for T.get_variants() { $f | 
                if i == tag_value {
                    inner := T.get_variant_ptr_for(it, f);
                    store_text(ctx, @type inner[], inner);
                };
                i += 1;
            };
            out.push_all(")");
        }
        fn Array($f) => {
            store_text(ctx, []f.inner, @ref it.items());
        }
        @default => @panic("Unsupported type for store %", @run T.typename().str());
    };
}

Error :: @struct(msg: Str, byte: i64, line: i64, col: i64);
fn load_text_top(in: []u8, it: ~T) Result(void, Error) #where = {
    ctx: LoadCtx = (in = in);
    res := load_text(ctx&, @type it[], it);
    if res&.is(.Ok) {
        ctx&.eat_whitespace();
        if ctx.in.len != 0 {
            res = (Err = "extra bytes at the end of load_text");
        };
    };
   
    @if_let(res) fn Err(msg) => {
        i := in.len - ctx.in.len;
        line, col := (1, 1);
        for in.slice(0, i) { c |
            col += 1;
            if c == "\n".ascii() {
                line += 1;
                col = 1;
            };
        }; 
        return(Err = (msg = msg, byte = i, line = line, col = col));
    };
    
    .Ok
}

fn load_text(ctx: *LoadCtx, $T: Type, it: *T) Result(void, Str) #generic = {
    @if(@run (IsCollection(Slice)(T) && T != Str)) {
        result := @ref T.Element.list(general_allocator());  // :SaveSliceAllocator
        @try(ctx.eat_punct("(")) return;
        while => !ctx.in.starts_with(")") {
            it := result.push_uninit();
            @try(load_text(ctx, T.Element, it)) return;
            @if(!ctx.in.starts_with(")")) @try(ctx.eat_punct(",")) return;
        };
        @try(ctx.eat_punct(")")) return;
        it[] = result.shrink_to_fit();
        return(.Ok);
    };
    
    @if(@run(@is(get_type_info_ref(T), .F32, .F64))) {
        n, rest := parse_float(ctx.in);
        @if(rest.len == ctx.in.len) return(Err = "expected number");
        ctx.in = rest;
        it[] = @if(@run(T == f32), n.cast(), n);
        return(.Ok);
    };
    
    @if(@run(T != u32 && @is(get_type_info_ref(T), .Int))) {
        negative := ctx.in.starts_with("-");
        ctx.in = ctx.in.rest(int(negative));
        n, rest := convert_number(ctx.in, 10, dec_digit);
        @if(rest.len == ctx.in.len) return(Err = "expected number");
        ctx.in = rest;
        if negative {
            n = -n;
        };
        // TODO: ugh
        it[] = bit_cast_unchecked(i64, T, n);
        return(.Ok);
    };
    
    @if(T == Vec2) @try(ctx.eat_punct("vec2")) return;
    @if(T == Vec3) @try(ctx.eat_punct("vec3")) return;
    
    #use("@/graphics/lib.fr");
    @inline_switch(T) {
        @case(Str) => {
            if ctx.in.starts_with("\"\"\"") {
                i := 3;
                while => !ctx.in.rest(i).starts_with("\"\"\"") {
                    i += 1;
                    @if(i >= ctx.in.len) return(Err = "unterminated string")
                };
                it[] = ctx.in.slice(3, i);
                ctx.in = ctx.in.rest(i + 3);
            } else {
                i := 1;
                @if(i >= ctx.in.len) return(Err = "unterminated string");
                while => ctx.in[i] != "\"".ascii() {
                    i += 1;
                    @if(i >= ctx.in.len) return(Err = "unterminated string");
                };
                it[] = ctx.in.slice(1, i);
                ctx.in = ctx.in.rest(i+1);
            };
            it[] = it[].shallow_copy(general_allocator());  // :SaveSliceAllocator
        };
        @case(u32) => {
            @try(ctx.eat_punct("0x")) return;
            n, rest := convert_number(ctx.in, 16, hex_digit);
            @if(rest.len == ctx.in.len) return(Err = "expected number");
            ctx.in = rest;
            it[] = n.trunc();
        };
        @case(void) => @try(ctx.eat_punct("()")) return;
        @case(bool) => {
            name := @try(ctx.eat_ident()) return;
            it[] = @switch(name) {
                @case("true") => true;
                @case("false") => false;
                @default => return(Err = "invalid bool");
            };
        };
        @default => ({
            @inline_match(@static mappings_get(T)) {
                fn WithRepr($v) => {
                    repr := zeroed(v.Repr);
                    @try(load_text(ctx, v.Repr, repr&)) return;
                    @try((@run v'from_repr)(it, repr&)) return;
                }
                fn Direct($v) => @panic("TODO: %", T.typename().str());
                fn Auto() => return(auto_load_text(ctx, T, it));
                fn FilterFields($f) => @panic("TODO: %", T.typename().str());
            };
        });
    };
    .Ok
}

fn auto_load_text(ctx: *LoadCtx, $T: Type, it: *T) Result(void, Str) #generic = {
    @inline_match(@run T.get_type_info_ref()) {
        fn Enum($f) => {
            @try(ctx.eat_punct(".")) return;
            name := @try(ctx.eat_ident()) return;
            ::?T;
            it[] = T.from_name(name) || return(Err = @tfmt("invalid enum name '%'", name));
        }
        fn Struct($f) => {
            @try(ctx.eat_punct("(")) return;
            inline_for T.get_fields() { $f | 
                name := @try(ctx.eat_ident()) return;
                @if(name != @run f[].name.str()) return(Err = @tfmt("field name expected '%' but found '%'", @run f[].name.str(), name));
                @try(ctx.eat_punct("=")) return;
                inner := T.get_field_ptr(it, f);
                @try(load_text(ctx, @type inner[], inner)) return;
                @if(!ctx.in.starts_with(")")) @try(ctx.eat_punct(",")) return;
            };
            @try(ctx.eat_punct(")")) return;
        }
        fn Tagged($t) => {
            @try(ctx.eat_punct("(")) return;
            name := @try(ctx.eat_ident()) return;
            t := Tag(T).from_name(name) || return(Err = @tfmt("invalid case name '%'", name));
            @try(ctx.eat_punct("=")) return;
            it.tag_ptr()[] = t;
            
            i := 0; // TODO : inline_enumerate
            tag_value := t.raw();
            // TODO: @inline_switch.
            inline_for T.get_variants() { $f | 
                if i == tag_value {
                    inner := T.get_variant_ptr_for(it, f);
                    @try(load_text(ctx, @type inner[], inner)) return;
                };
                i += 1;
            };
            @try(ctx.eat_punct(")")) return;
        }
        fn Array($f) => {
            @try(ctx.eat_punct("(")) return;
            enumerate it { i, it |
                @try(load_text(ctx, f.inner, it)) return;
                @if(i != f.len.zext() - 1) @try(ctx.eat_punct(",")) return;
            };
            @try(ctx.eat_punct(")")) return;
        }
        @default => @panic("Unsupported type for store %", @run T.typename().str());
    };
    .Ok
}

fn eat_whitespace(self: *LoadCtx) void = {
    while => self.in.len > 0 && self.in[0].is_ascii_whitespace() {
        self.in = self.in.rest(1);
    };
    
    @if(!self.in.starts_with("/*")) return();
    self.in = self.in.rest(2);
    while => !self.in.starts_with("*/") {
        @if(self.in.len == 0) return();
        self.in = self.in.rest(1);
    };
    self.in = self.in.rest(2);
    self.eat_whitespace();
}

fn eat_punct(self: *LoadCtx, s: Str) Result(void, Str) = {
    self.eat_whitespace();
    @if(!self.in.starts_with(s)) return(Err = @tfmt("expected '%'", s));
    self.in = self.in.rest(s.len);
    self.eat_whitespace();
    .Ok
}

fn eat_ident(self: *LoadCtx) Result(Str, Str) = {
    self.eat_whitespace();
    i := 0;
    if true {
        break :: local_return;
        loop {
            @if(i >= self.in.len) break();
            c := self.in[i];
            valid := c.is_ascii_alpha() || c.is_ascii_digit() || c == "_".ascii();
            if !valid {
                break();
            };
            i += 1;
        };
    };
    name := self.in.slice(0, i);
    self.in = self.in.rest(i);
    self.eat_whitespace();
    (Ok = name)
}
