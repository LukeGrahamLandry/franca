
Instance :: @struct {
    colour: u32;
    msg: Str;
};

App :: State;
fn render(sgl: *Sgl.Self, it: *Instance, self: *App) void = ();
fn collision(p: Vec3, it: *Instance, self: *App) bool = false;

State :: @struct {
    colour: u32;
    msg: List(u8);
    text: Sdtx.Self;
    dirty: bool;
};

fn on_render(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    @if(Easy'should_skip_frame(sapp, state.dirty&)) return();
    sdtx := state.text.default_context&;
    
    sdtx.pos = vec2(0);
    sdtx.glyph_size = scale_to_fit(state.msg.items());
    sdtx.color = state.colour;
    sdtx.put(state.msg.items());
    
    pass_action := zeroed(Sg.PassAction);
    pass_action.colors&[0] = (
        load_action = .CLEAR,
        clear_value = (r = 0.156, g = 0.156, b = 0.156, a = 1),
    );
    Easy'glue_begin_pass(sapp, sg, pass_action);
    sdtx.draw_layer(0);
    sg.end_pass();
    sg.commit();
};

fn on_init(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    state.colour = pack_rgba(255,255,255,255);
    state.msg = list(general_allocator());
    state.dirty = true;
    state.text&.setup(
        allocator = general_allocator(),
        fonts = @slice(Sdtx.font.kc854),
        sg = sg,
        context = (max_commands = 1, char_buf_size = 512),
    );
}

scale_to_fit :: fn(msg: Str) Vec2 = {
    line, col, max_col := (1, 0, 0);
    for msg { c |
        if c == "\n".ascii() {
            line += 1;
            max_col = max(col, max_col);
            col = 0;
        } else {
            col += 1;
        };
    };
    max_col = max(col, max_col);
    
    x := cast(1.0 / max_col.float());
    y := cast(1.0 / line.float());
    vec2(x, min(y, x * 2))
};

fn on_event(state: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = ();
driver :: fn(vtable: *ImportVTable) void = Easy'build_for_graphics(vtable, @source_file_name());
main :: fn() void = Easy'start(State);
#use("@/graphics/lib.fr");

fn on_cleanup(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    state.text&.shutdown();
    state.msg&.drop();
}
