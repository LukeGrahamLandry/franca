
App :: import("@/examples/gpu/farm_game.fr").State;

Instance :: @struct {
    pos: Vec3;
    dir: Vec2;
    init: InitialWorld;
};

InitialWorld :: @struct {
    shelves: []Object;
    money: i64;
};

fn render(sgl: *Sgl.Self, it: *Instance, self: *App) void = {
    sgl.texturing_enabled = true;
    sgl.texture(self.img, (id=0));
    sgl.begin(.QUADS);
    
    p := vec2(it.pos.x, it.pos.z);
    Y0 := it.pos.y + 0.02;
    fraction: f32 = 0.1;
    each self.world.shelves { shelf |
        c1 := p + vec2(fraction);
        c2 := c1 + vec2(1 - fraction*2);
        
        draw(SOILD, pack_rgba(150, 70, 20, 255));
        tex, colour := get_texture(shelf.item);
        draw(tex, colour);
        draw :: fn(tex, c) => {
            sgl.color = c;
            u1, v1, u2, v2 := uv_for_texture(tex);
            sgl.v3f_t2f(c1.x, Y0, c1.y, u1, v1);
            sgl.v3f_t2f(c2.x, Y0, c1.y, u2, v1);
            sgl.v3f_t2f(c2.x, Y0, c2.y, u2, v2);
            sgl.v3f_t2f(c1.x, Y0, c2.y, u1, v2);
        };
        
        p += it.dir;
    };
    sgl.end();
    sgl.texturing_enabled = false;
}

fn collision(player_pos: Vec3, it: *Instance, self: *App) bool = {
    // TODO: also put the farm crops in the world?
    false
}

#use("@/graphics/lib.fr");
#use("@/examples/gpu/farm_game.fr");
