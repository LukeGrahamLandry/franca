
State :: @struct {
    HIGH_DPI :: true;
    pipe: Sgl.Pipeline;
    app: *Sapp.Self;
    draw: Sgl.Self;
    sg: *Sg.Self;
    prev_frame_time: f64;
    camera: Camera;
    rooms: []Room;
    // they can be suspended (state pointers will be null) so only look at the ones in `active_puzzles`
    puzzles: []Puzzle;
    active_room: i64;
    puzzle_focus: ?i64;
    child_fullscreen: bool;
    dirty: bool;
    screen_size: Vec2;
    inspect_terminal_puzzle_index: i64;
    trophy_hint_puzzle_index: i64;
    active_puzzles: List(i64);
    enable_cheats: bool;
    inventory: GameItem;
    debug_map_objects: List(Editor.Object);
    last_save_timestamp: f64;
};

fn on_render(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    // before the drop frame check so the first move after idle isn't a jump
    now := timestamp_s();
    dt := (now - state.prev_frame_time).cast();
    state.prev_frame_time = now;

    // TODO: without this, the app's on_render calls sg.commit() but for this program 
    //       i just want it to add passes and the commit happens once in the 3d on_render.
    //       if commit is called early, the 3d world walls etc. don't get drawn 
    //       (which is any frames where user.state.dirty=true without this hack). 
    //       solution might be headless app never calls commit and 
    //       the embeder needs to do it since logically it owns the Sg.Self anyway. 
    sg.hack_disable_commit_for_headless_app = true;
    // important that they get to run their event handlers and decide if dirty before skipping the real rendering. 
    for state.active_puzzles { i |
        it := state.puzzles[i]&;
        prev := sg.disabled_commit_calls;
        it.app.frame();
        dirty := sg.disabled_commit_calls != prev;
        state.dirty = state.dirty || dirty;
    };
    sg.hack_disable_commit_for_headless_app = false;
    state.dirty = state.dirty || state.camera.delta_pos.norm() != 0;
    
    if Easy'should_skip_frame(sapp, state.dirty&) {
        return();
    };
    
    pass_action := zeroed(Sg.PassAction);
    pass_action.colors&[0] = (
        load_action = .CLEAR,
        clear_value = (r = 0.3, g = 0.3, b = 0.3, a = 1.0),
    );
    
    sgl := state.draw&;
    sgl.defaults();
    sgl.viewport(0.intcast(), 0.intcast(), state.app.width().intcast(), state.app.height().intcast(), true);
    sgl.load_pipeline(state.pipe);
    sgl.load_identity();
    
    if state.child_fullscreen {
        sgl.texturing_enabled = true;
        it := state.puzzles[state.puzzle_focus.unwrap()]&;
        sgl.texture(it.img, (id = 0));
        aspect := state.camera.perspective.aspect;
        c1, c2 := @if(aspect > 1, 
            (vec2(-1/aspect, -1), vec2(1/aspect, 1)),
            (vec2(-1, -aspect), vec2(1, aspect)));
        sgl.color = pack_rgba(255,255,255,255);
        sgl.begin(.QUADS);
        sgl.v2f_t2f(c1.x, c1.y, 0, 1);
        sgl.v2f_t2f(c2.x, c1.y, 1, 1);
        sgl.v2f_t2f(c2.x, c2.y, 1, 0);
        sgl.v2f_t2f(c1.x, c2.y, 0, 0);
        sgl.end();
        sgl.texturing_enabled = false;
        
        Easy'glue_begin_pass(sapp, sg, pass_action);
        sgl.draw_layer(sg, 0);
        sg.end_pass();
        sg.commit();
        return();
    };

    if !state.enable_cheats {
        state.camera.delta_pos.y = 0;
    };
    only_flying := state.camera.delta_pos.x == 0 && state.camera.delta_pos.z == 0;
    moved := state.camera.delta_pos.norm_sq() != 0;
    prev_pos := state.camera.pos;
    update_camera(state.camera&, dt);
    
    if moved && !only_flying {
        break :: local_return;
        on_ground := false;
        p := state.camera.pos;
        // TODO: don't let you get too close to the vertical walls because you can see through them
        // TODO: would be nice to slide along the edges instead of just stopping
        // TODO: if you get the angle right you can get through a diagonal that should be solid
        // TODO: more sane behaviour when the world changes so where you already were becomes solid (rn you're just stuck)
        // :SLOW
        each state.rooms { room |
            each room.walls& { wall |
                v := wall.vectors();
                lo, hi := (v.lo, v.hi);
                if hi.y == lo.y {
                    if p.x > lo.x && p.x < hi.x && p.z > lo.z && p.z < hi.z {
                        on_ground = true;
                    }
                };
            };
        };
        
        if on_ground {
            for state.active_puzzles { i |
                it := state.puzzles[i]&;
                
                as_const(it) { $Name |
                    @if(it.extra&.is(Name)) 
                    if collision(p, Extra.get_variant_ptr(it.extra&, Name), it.cast(Name)) {
                        on_ground = false;
                    };
                };
            };
        };
        
        // it's convenient to be able to fly through walls for now
        if state.camera.pos.y > 2 && state.enable_cheats {
            on_ground = true;
        };
        
        if !on_ground {
            state.camera.pos = prev_pos;
            break();
        };
    
        start := timestamp();
        state.redetect_active_room();
        t := timestamp() - start;
        if t > 30 {
            @println("changed rooms in %ms", t);
        };
    };
    
    write_camera(state.camera&, sgl);
    
    sgl.begin(.QUADS);
    
    // TODO: merge all the walls into one mesh and send it to gpu once?
    each state.rooms { room |
    each room.walls { wall |
        sgl.color = wall.c;
        for wall.v& { p |
            sgl.v3f(p);
        };
    };
    };
    sgl.color = pack_rgba(255,255,255,255);
    
    draw_puzzle_wall :: fn(it: *Puzzle, c: u32, no_z_fighting: f32, border_size: f32, $body: @Fn(p: Vec3) void) => {
        sgl.color = c;
        w := it.wall.v&;
        center := (w[0]+w[1]+w[2]+w[3])/4;
        v := it.wall&.vectors();
        for w { p |
            body(p + (p - center)*border_size + v.normal*no_z_fighting);
        };
    };
    
    // TODO: i want mandlebrot to be double sided but still have the border when focused
    focus := state.puzzle_focus || -1;
    for state.active_puzzles { i |
        it := state.puzzles[i]&;
        c := @if(i == focus, pack_rgba(255,255,255,255), pack_rgba(0,0,0,255));
        draw_puzzle_wall(it, c, -0.003, 0.04) { p |
            sgl.v3f(p);
        };
    };
    sgl.color = pack_rgba(255,255,255,255);
    
    sgl.end();
    
    for state.active_puzzles { i |
        it := state.puzzles[i]&;
        #use("@/examples/gpu/maze_game/puzzles/chess.fr");
        
        as_const(it) { $Name |
            @if(it.extra&.is(Name)) render(sgl, Extra.get_variant_ptr(it.extra&, Name), it.cast(Name));
        };
    };
    
    for state.active_puzzles { i |
        it := state.puzzles[i]&;
        sgl.texturing_enabled = true;
        sgl.texture(it.img, (id = 0));
        sgl.begin(.QUADS);
        
        uv := @const_slice(vec2(1,0), vec2(0,0), vec2(0,1), vec2(1,1));
        i := 0;
        draw_puzzle_wall(it, pack_rgba(255,255,255,255), 0.001, 0) { p |
            sgl.u = uv[i].x; sgl.v = uv[i].y;
            sgl.v3f(p);
            i += 1;
        };
        sgl.end();
    };
    sgl.texturing_enabled = false;
    
    have_inventory := inventory_draw_ui(state, sgl);
    
    Easy'glue_begin_pass(sapp, sg, pass_action);
    sgl.draw_layer(sg, 0);
    @if(have_inventory) sgl.draw_layer(sg, 1);
    sg.end_pass();
    sg.commit();
};

// TODO: there's like junk pixels around the edges somehow?
fn inventory_draw_ui(state: *State, sgl: *Sgl.Self) bool = {
    if state.inventory&.is(.FarmGame) && state.inventory.FarmGame&.is(.None) {
        return false;
    };
    have_inventory := !state.inventory&.is(.FarmGame) || !state.inventory.FarmGame&.is(.None);
    farm_game_texture: ?Sg.Image = .None;
    for state.active_puzzles { i |
        it := state.puzzles[i]&;
        if it.name == .FarmGame {
            farm_game_texture = (Some = it.cast(.FarmGame)[].img);
        };
    };
    if state.inventory&.is(.FarmGame) && farm_game_texture.is_none() {
        return false;
    };
    
    sgl.layer_id = 1;
    sgl.defaults();
    sgl.viewport(0.intcast(), 0.intcast(), state.app.width().intcast(), state.app.height().intcast(), true);
    sgl.load_pipeline(state.pipe);
    sgl.load_identity();
    
    aspect := state.camera.perspective.aspect;
    size := vec2(100) / state.screen_size;
    start := vec2(1) - size*1.25;
    c1, c2 := (start, start + size);
    sgl.begin(.QUADS);
    sgl.color = pack_rgba(10,10,10,255);
    sgl.v2f(c1.x, c1.y);
    sgl.v2f(c2.x, c1.y);
    sgl.v2f(c2.x, c2.y);
    sgl.v2f(c1.x, c2.y);
    sgl.end();
    
    @match(state.inventory) {
        fn FarmGame(object) => if farm_game_texture { img |
            sgl.texturing_enabled = true;
            sgl.texture(img, (id = 0));
            sgl.begin(.QUADS);
            #use("@/examples/gpu/farm_game.fr");
        
            tex, colour := get_texture(object);
            sgl.color = colour;
            u1, v1, u2, v2 := uv_for_texture(tex);
            sgl.v2f_t2f(c1.x, c1.y, u1, v1);
            sgl.v2f_t2f(c2.x, c1.y, u2, v1);
            sgl.v2f_t2f(c2.x, c2.y, u2, v2);
            sgl.v2f_t2f(c1.x, c2.y, u1, v2);
            
            sgl.end();
            sgl.texturing_enabled = false;
        }
        @default => ();
    };
    sgl.layer_id = 0;
    sgl.texturing_enabled = false;
    true
}

fn redetect_active_room(state: *State) void = {
    p := state.camera.pos;
    best_distance: f32 = 2000;
    best := state.active_room;
    enumerate state.rooms { i, it |
        distance := norm_sq(p - it.bounds.center);
        r_sq := it.bounds.radius * it.bounds.radius;
        if distance < best_distance && distance < r_sq {
            best = i;
            best_distance = distance;
        };
    };
    
    // note: at first load (active_room,active_puzzles) are zero init so need to treat that as a room change. 
    @if(best == state.active_room && state.active_puzzles.len != 0) return();
    old_active := state.active_puzzles.items().shallow_copy(temp());
    
    state.active_room = best;
    room := state.rooms[state.active_room]&;
    state.active_puzzles&.clear();
    for room.adjacent_rooms { r |
        state.active_puzzles&.push_all(state.rooms[r].puzzles);
    };
    if state.enable_cheats {
        if !state.active_puzzles.items().contains(state.inspect_terminal_puzzle_index) {
            state.active_puzzles&.push(state.inspect_terminal_puzzle_index);
        };
    };
    
    suspend_for_room_change(state, old_active);
}    

fn choose_focus(state: *State, mouse: Vec2, error_margin: f32) ?i64 = {
    i: ?i64 = .None;
    s := PUZZLE_LOGICAL_WIDTH.float().cast();
    center := vec2(s) / 2;
    best_distance: f32 = s * error_margin;
    look_dir, _0, _1 := state.camera&.directions();
    for state.active_puzzles { check |
        it := state.puzzles[check]&;
        m := remap_mouse_to_puzzle(it, state.camera&, mouse, state.screen_size);
        check_distance := norm(m - center);
        // TODO: should be that you can't do it through walls at all but this thing with the normal is better than nothing (at least until i want to allow some that are double sided)
        w := it.wall&.vectors();
        if check_distance < best_distance && dot(look_dir, w.normal) < 0 {
            i = (Some = check);
            best_distance = check_distance;
        };
    };
    i
}

fn on_event(state: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = {
    @if(event.type == .QUIT_REQUESTED) save_world_file(state);

    // TODO: the version of this that easy.fr adds should send QUIT_REQUESTED    
    if event.type == .KEY_DOWN && event.key_code == .W && event.modifiers.get(.super) != 0 {
        save_world_file(state);
    };
    
    @if(check_cheats(state, event)) return();
    if event.key_code == .LEFT_CONTROL {
        state.camera.speed.pos *= @if(event.type == .KEY_UP, 0.2, 5);
    };
    
    if event.type == .KEY_DOWN && event.key_code == .S && event.modifiers.get(.super) == 1 && !event.key_repeat && state.puzzle_focus.is_none() {
        save_world_file(state);
        return();
    };

    if event.type == .KEY_DOWN && event.key_code == .ESCAPE {
        if state.puzzle_focus.is_some() {
            state.set_focus(.None);
        } else {
            state.child_fullscreen = event.modifiers.get(.alt) == 1;
            state.set_focus(choose_focus(state, state.screen_size/2, 2));
        };
        return();
    };
    
    if event.type == .MOUSE_DOWN && event.mouse_button == .MIDDLE && state.puzzle_focus.is_none() {
        if choose_focus(state, state.screen_size/2, 2) { i |
            state.child_fullscreen = event.modifiers.get(.alt) == 1;
            return state.set_focus(Some = i);
        };
    };
    
    if event.type == .KEY_DOWN && event.key_code == .SPACE && state.puzzle_focus.is_none() {
        if inventory_pickup(state) {
            return();
        };
    };
    
    @if(event.type != .RESIZED)
    if state.puzzle_focus { i |
        @if(!state.child_fullscreen)
        if event.type == .MOUSE_DOWN && event.mouse_button == .MIDDLE {
            mouse := vec2(event.mouse_x, event.mouse_y);
            if choose_focus(state, mouse, 0.75) { j |
                if i != j {
                    state.child_fullscreen = event.modifiers.get(.alt) == 1;
                    return state.set_focus(Some = j);
                }
            } else {
                return state.set_focus(.None); // clicked off any puzzle
            };
        };
    
        it := state.puzzles[i]&;
        remap_and_push_event(state, it, event[]);
        return();
    };

    state.dirty = true;
    fly_controller(state.camera&, event);
    if event.type == .RESIZED {
        update_aspect(state.camera&, sapp);
        state.screen_size = vec2(sapp.framebuffer_width.float().cast(), sapp.framebuffer_height.float().cast());
    };
};

// TODO: make this more generic once i have more programs with items
// TODO: maybe the controls should be raycast to the square like it is for opening screen. 
//       idk if i prefer consistancy with the 3d or consistancy with the farm game's controls. 
fn inventory_pickup(state: *State) bool = {
    for state.active_puzzles { i |
        it := state.puzzles[i]&;
        p := state.camera.pos;
        self := it;
        as_const(it) { $Name |
            @if(Name == .FarmGame) @if_let(it.extra&) fn FarmGame(it) => {
                self := self.cast(Name);
                start := vec2(it.pos.x, it.pos.z);
                Y0 := it.pos.y + 0.02;
                fraction: f32 = 0.1;
                each self.world.shelves { shelf |
                    c1 := start + vec2(fraction);
                    c2 := c1 + vec2(1 - fraction*2);
                    
                    if p.x > c1.x && p.z > c1.y && p.x < c2.x && p.z < c2.y {
                        // hit!
                        @if_let(state.inventory&) fn FarmGame(src) => {
                            dest := shelf.item&;
                            t := src[]; src[] = dest[]; dest[] = t;
                            self.dirty = true;
                            return true;
                        };
                    };
                    
                    start += it.dir;
                };
            };
        };
    };
    false
}

fn set_focus(state: *State, it: ?i64) void = {
    I := it || (state.puzzle_focus || -1);
    state.puzzle_focus = it;
    state.app.lock_mouse(!it.is_some());
    // TODO: you still keep moving if you were holding the button while pressing escape
    // TODO: deal with puzzle.state.pan_keys_pressed
    state.camera.delta_pos = vec3(0);
    state.dirty = true;
    
    if it { i |
        record_click(state, i);
    } else {
        state.child_fullscreen = false;
        if I != state.inspect_terminal_puzzle_index {
            state.check_auto_save();
        };
    };
}

// not too often because suspend+resume everything is slow. 
// generally this doesn't matter because quitting the game saves first but crashing is a risk.
fn check_auto_save(state: *State) void = {
    now := timestamp_s();
    if now - state.last_save_timestamp > 120 {
        state.last_save_timestamp = now;
        save_world_file(state);
    };
};

fn remap_and_push_event(state: *State, it: *Puzzle, event: Sapp.Event) void = {
    mouse := vec2(event.mouse_x, event.mouse_y);
    m := @if(state.child_fullscreen, {
        real_frac := mouse / state.screen_size;
        aspect := state.camera.perspective.aspect;
        c1, c2 := @if(aspect > 1, 
            (vec2(-1/aspect, -1), vec2(1/aspect, 1)),
            (vec2(-1, -aspect), vec2(1, aspect)));
        c1 = c1 / 2 + vec2(0.5);
        c2 = c2 / 2 + vec2(0.5);
        fake_size := c2 - c1;
        fake_frac := (real_frac - c1) / fake_size;
        fake_frac * PUZZLE_LOGICAL_WIDTH.float().cast()
    }, {
        remap_mouse_to_puzzle(it, state.camera&, mouse, state.screen_size)
    });
    
    event.mouse_x = m.x;
    event.mouse_y = m.y;
    
    if event.type == .MOUSE_MOVE {
        d := m - it.prev_mouse;
        event.mouse_dx = d.x;
        event.mouse_dy = d.y;
    };
    
    it.app.events&.push(event);
    it.prev_mouse = m;
}

// TODO: cache this, only need to recalucate on MOUSE_MOVE
// remap the mouse positions to be relative to the puzzle quad in 3d space

fn remap_mouse_to_puzzle(it: *Puzzle, c: *Camera, mouse: Vec2, screen: Vec2) Vec2 = {
    _, m := remap_mouse_to_wall(it.wall&, c, mouse, screen);
    m *= vec2(PUZZLE_LOGICAL_WIDTH.float().cast());
    m
}

fn remap_mouse_to_wall(wall: *Wall, c: *Camera, mouse: Vec2, screen: Vec2) Ty(Vec3, Vec2) = {
    mouse := vec2(mouse.x, screen.y - mouse.y);
    // a plane parallel to the projected screen, center directly forward from the camera, 
    // whose width/height matches the screen and at a distance where 1 world unit = 1 screen pixel. 
    
    look_dir, _, right := c.directions();
    plane_dir := cross(right, look_dir).normalize();
    plane_distance := {
        angle := c.perspective.fovy / 2;
        opposite := screen.y / 2;
        s,c := angle.sin_cos();
        adjacent := opposite / (s/c);
        adjacent
    };
    p := c.pos + look_dir*plane_distance;
    
    half := screen/2;
    
    fraction := mouse / screen * 2 - vec2(1);
    A, B := (right*half.x, plane_dir*half.y);
    pos := p + A*fraction.x + B*fraction.y;
    
    dir := normalize(pos - c.pos);
    
    // so then where that line intersects the app screen is where the mouse is
    w := wall.vectors();
    p0 := wall.v&[0];
    l0 := c.pos;
    l := dir;
    n := w.normal;
    
    d := (p0 - l0).dot(n) / l.dot(n);
    
    hit := l0 + l*d;
    
    // now i need to know where that point in space is in the app's local coordinates
    
    lo, hi := (w.lo, w.hi);
    wall_size := abs(hi - lo);
    frac := (hi - hit) / wall_size;
    m := @if_else {
        @if(wall_size.x == 0) => vec2(@if(n.x < 0, 1 - frac.z, frac.z), frac.y);
        @if(wall_size.z == 0) => vec2(@if(n.z < 0, frac.x, 1 - frac.x), frac.y);
        @if(wall_size.y == 0) => vec2(@if(n.y < 0, frac.x, 1 - frac.x), 1 - frac.z);
        @else => {
            // :NotNormalized
            // this would work for all the cases above but is slower. 
            // TODO: cache the inverse matrix for this puzzle
            local := change_basis((w.right, w.up, w.normal), hit - wall.v&[0]);
            vec2(1 + local.x, -local.y)
        };
    };
    (hit, m)
}

fn on_init(state: *State, app: *Sapp.Self, sg: *Sg.Self) void = {
    init_start := timestamp_s();
    state.last_save_timestamp = init_start;
    state.sg = sg; state.app = app;
    app.desc.enable_clipboard = true;
    state.dirty = true;
    state.puzzle_focus = .None;
    state.active_puzzles = list(general_allocator());
    state.inventory = (FarmGame = .None);
    
    state.draw&.setup(
        allocator = general_allocator(),
        sg = sg,
        max_vertices = 1_000_000,
    );
    
    init_pipeline(state.draw&, state.pipe&, sg, (
        // alpha_to_coverage makes transparent pixels not write to depth buffer?
        // TODO: but dawn thinks `Multisample count (1) must be > 1 when alphaToCoverage is enabled.`
        //       but also my webgpu depth stuff is unfinished so maybe it will become clear when i work on that. 
        //       for now just don't crash even tho it looks stupid.  
        alpha_to_coverage_enabled = SOKOL_BACKEND != .WGPU,
        depth = (
            pixel_format = .DEFAULT,
            write_enabled = true,
            compare = .LESS_EQUAL,
        ),
        colors = (
            (blend = (
                enabled = true,
                src_factor_rgb = .SRC_ALPHA,
                dst_factor_rgb = .ONE_MINUS_SRC_ALPHA,
            )),
            ..,
        ),
    ));
    
    app.lock_mouse(true);
    state.prev_frame_time = timestamp_s();
    
    state.camera.perspective = (aspect = 1, fovy = deg_to_rad(70), znear = 0.01, zfar = 1000.0);
    update_aspect(state.camera&, app);
    state.screen_size = vec2(app.framebuffer_width.float().cast(), app.framebuffer_height.float().cast());
    state.camera.speed = (pos = 0.09 * 30.0, rot = 0.005 * 30.0);
    
    // TODO: `forever: Arena.Allocator;`
    a := general_allocator();
    map := map_objects;
    #use("@/examples/gpu/maze_game/editor.fr");
    puzzles, rooms := objects_to_world(map, a);
    state.rooms = rooms;
    state.puzzles = puzzles;
    state.camera.pos = vec3(2, 1, -1);
    
    state.find_special_puzzles();
    each state.puzzles { it |
        it.suspended = (Some = empty()); // :EmptySaveDataMeansDefault
    };
    load_world_file(state);
    state.redetect_active_room();
    
    // TODO: maybe don't waste memory until enable cheats
    state.debug_map_objects = list(general_allocator());
    state.debug_map_objects&.push_all(Editor.map_objects);
    
    @println("on_init took %ms", timestamp() - int(init_start * 1000));
}

fn find_special_puzzles(state: *State) void = {
    LINK_TERMINAL_INSPECT :: 2;
    LINK_HINT_TROHY :: 87;
    state.inspect_terminal_puzzle_index = state.puzzles.index_of(fn(it) => it.link == LINK_TERMINAL_INSPECT).expect("LINK_TERMINAL_INSPECT");
    @assert_eq(state.puzzles[state.inspect_terminal_puzzle_index].name, .Terminal);
    state.trophy_hint_puzzle_index = state.puzzles.index_of(fn(it) => it.link == LINK_HINT_TROHY).expect("LINK_HINT_TROHY");
    @assert_eq(state.puzzles[state.trophy_hint_puzzle_index].name, .Hint);
}

fn record_click(state: *State, i: i64) void = {
    it := state.puzzles[i]&;
    @if(it.clicked && i != state.trophy_hint_puzzle_index) return();
    it.clicked = true;

    it := state.puzzles[state.trophy_hint_puzzle_index]&;
    @if(it.suspended.is_some()) return();
    
    count := zeroed(EnumMap(PuzzleType, @struct(total: i64, clicked: i64)));
    enumerate state.puzzles& { i, it |
        if i != state.inspect_terminal_puzzle_index {
        count&[it.name].total += 1; 
        count&[it.name].clicked += int(it.clicked); 
        };
    };
    s := it.cast(.Hint);
    msg := s.msg&;
    msg.clear();
    @fmt(msg, "click to update\n\n");
    total, clicked := (0, 0);
    each count& { name, it |
        if it.total != 0 {
            @fmt(msg, "% %/%\n", name, it.clicked, it.total);
            clicked += it.clicked;
            total += it.total;
        };
    };
    @fmt(msg, "\n%\%\n", int(clicked.float() / total.float() * 100));
    s.dirty = true;
}

fn suspend_for_room_change(state: *State, old_active: []i64) void = {
    new_active := state.active_puzzles.items().shallow_copy(temp());
    new_active&.unordered_retain(fn(it) => !old_active.contains(it[]));
    old_active&.unordered_retain(fn(it) => !state.active_puzzles.items().contains(it[]));
    
    for old_active { i |
        suspend(state, state.puzzles[i]&, false);
    };
    
    // this is the least wasteful time to save because it has to suspend everything, so saves an extra reset of `new_active`
    state.check_auto_save();
    
    for new_active { i |
        restore(state, state.puzzles[i]&);
    };
}

fn suspend(state: *State, it: *Puzzle, for_save_system: bool) void = {
    @assert(it.suspended.is_none(), "already has suspend data");
    
    a := general_allocator();
    ctx: Save.StoreCtx = (out = @ref u8.list(a));
    as_const(it) { $Name |
        store(ctx&, Get(Name).App, it.cast(Name));
        it.app.call_cleanup();
        a.dealloc_one(Get(Name).App, it.cast(Name));
    };
    
    it.suspended = (Some = ctx.out.shrink_to_fit());
    a.dealloc_one(Sapp.Self, it.app);
    it.app = zeroed(@type it.app);
    it.state = zeroed(@type it.state);
    
    if !for_save_system {
        // TODO: could me more efficient and pool them here before going to gfx because all textures are the same.
        destroy_puzzle_texture(state.sg, it);
    };  // else: intend to immediately restore() so don't bother
}

fn restore(state: *State, it: *Puzzle) void = {
    @assert(it.suspended.is_some(), "restore() but already running");
    save_data := it.suspended&.take().unwrap();
    if !it.have_textures {
        init_puzzle_texture(state.sg, it);
    };
    
    as_const(it) { $Name |
        init_puzzle_state(Name, it, state.sg, general_allocator());
        
        it.app.hack_no_reset_temp_for_headless = true;
        // TODO: for consistancy, should always reset temp after init
        it.app.first_frame = false;
        it.app.call_init();
        set_defaults_post_init(it, state.sg);
        
        // textures are unloaded when suspended so need to rerender even tho state should be the same as it was before. 
        it.cast(Name)[].dirty = true;
        
        if save_data.len == 0 {
            // :EmptySaveDataMeansDefault
            // this is a bit of a hack for the beginning of a new save to delay 
            // init-ing puzzles you haven't seen yet until they're loaded for the first time. 
            return();
        };
        
        ctx: Save.LoadCtx = (in = save_data);
        result := load(ctx&, Get(Name).App, it.cast(Name));
        @assert(result&.is(.Ok), "failed load: %", result.Err);
        @assert_eq(ctx.in.len, 0, "didn't consume all bytes; %", Name);
        general_allocator().dealloc(u8, save_data);
    };
}

save_file_path :: "target/francamazegamesavefile.out";
SaveFile :: @struct {
    MAGIC :: "FR\0game2".peek_type(i64)[];
    magic: i64;
    camera: Camera;
    inventory: GameItem;
    enable_cheats: bool;
    puzzles: List(@struct {
        type: PuzzleType;  // let it use defaults instead of crashing if you change the type of a puzzle in the inspect terminal while playing. 
        link: i64;
        data: []u8;
        clicked: bool;
    });
};

fn save_world(state: *State, out: *List(u8)) void = {
    save: SaveFile = (
        magic = SaveFile.MAGIC, 
        camera = state.camera,
        inventory = state.inventory,
        enable_cheats = state.enable_cheats,
        puzzles = list(temp()),
    );
    each state.puzzles { it |
        active := it.suspended.is_none();
        @if(active) suspend(state, it, true);
        data := it.suspended.unwrap();
        save.puzzles&.push(
            type = it.name,
            link = it.link, 
            data = data.shallow_copy(temp()), // bleh, might restore immediately which would free before it gets written out. wasteful. 
            clicked = it.clicked,
        );
        @if(active) restore(state, it);
    };
    
    ctx: Save.StoreCtx = (out = out);
    store(ctx&, SaveFile, save&);
}

// TODO: make sure first frame is dirty
fn load_world(state: *State, save_data: []u8) void = {
    magic := save_data.peek_type(i64)[];
    if magic != SaveFile.MAGIC {
        println("invalid save file magic");
        return();
    };
    save: SaveFile = (
        magic = 0, 
        camera = state.camera,
        inventory = state.inventory,
        puzzles = list(temp()),
        enable_cheats = false,
    );
    ctx: Save.LoadCtx = (in = save_data);
    _ := load(ctx&, SaveFile, save&);
    @assert_eq(ctx.in.len, 0, "extra save data");
    @debug_assert_eq(save.magic, SaveFile.MAGIC);
    
    a := general_allocator();
    state.camera = save.camera;
    state.inventory = save.inventory;
    state.enable_cheats = save.enable_cheats;
    // TODO: if loading from file, save it if corrupted so doesn't get overwritten by something else when autosaving just in case it's useful. 
    each save.puzzles { save |
        if state.puzzles.find(fn(it) => it.link == save.link) { it |
            if it.name == save.type {
            it.clicked = save.clicked;
            active := it.suspended.is_none();
            @if(active) suspend(state, it, true);
            a.dealloc(u8, it.suspended.unwrap());
            it.suspended = (Some = save.data.shallow_copy(a));
            @if(active) restore(state, it);
            } else {
                @println("corrupted save: link=% expected type=% but save.type=%", save.link, it.name, save.type);
            };
        } else {
            @println("corrupted save: link=% doesn't exist in world", save.link);
        };
    };
}

fn save_world_file(state: *State) void = {
    out := @ref u8.list(temp());
    save_world(state, out);
    #use("@/lib/sys/fs.fr");
    if write_entire_file(save_file_path, out.items()) {
        @println("saved to %", save_file_path);
    } else {
        @println("failed to write save file");
    };
}

fn load_world_file(state: *State) void = {
    if read_entire_file(temp(), save_file_path) { data |
        @println("loading save: %", save_file_path);
        load_world(state, data);
    } else {
        @println("no save file found");
    };
}

fn on_cleanup(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    sg.destroy_pipeline(state.pipe&);
    state.draw&.destroy(sg, general_allocator());
    destroy_all_puzzles(state);
    state.active_puzzles&.drop();
}

fn destroy_all_puzzles(state: *State) void = {
    each state.puzzles { it |
        @if(it.suspended.is_none()) suspend(state, it, false);
        general_allocator().dealloc(u8, it.suspended.unwrap());
    };
    state.puzzles = empty();
}

main :: fn() void = Easy'start(State);
driver :: fn(vtable: *ImportVTable) void = Easy'build_for_graphics2(vtable, @source_file_name(), true);
#use("@/graphics/lib.fr");
#use("@/examples/gpu/maze_game/camera.fr");
#use("@/examples/gpu/maze_game/world.fr");
Save :: import("@/examples/gpu/maze_game/save.fr");
#use("@/examples/gpu/maze_game/inspect.fr");

fn change_basis(col: Array(Vec3, 3), v: Vec3) Vec3 = {
    m := zeroed(Sgl.Matrix);
    range(0, 3) { c |
        range(0, 3) { r |
            m&[r, c] = col&[c]&[r];
        };
    };
    m := inverse(m&, 3);
    v := vec4(v.x, v.y, v.z, 0);
    v := m * v;
    vec3(v.x, v.y, v.z)
}

fn inverse(m: *Sgl.Matrix, s: i64) Sgl.Matrix = {
    result := zeroed(Sgl.Matrix);
    det := determinant(m, s);
    @if(det == 0) return(result);

    range(0, s) { r |
        range(0, s) { c |
            result&[c, r] = cofactor(m, r, c, s) / det;
        };
    };
    result
}

fn cofactor(m: *Sgl.Matrix, row: i64, col: i64, s: i64) f32 = {
    sign: f32 = @if((row + col).umod(2) == 0, 1, -1);
    m2 := submatrix(m, row, col, s);
    determinant(m2&, s - 1) * sign
}

fn determinant(m: *Sgl.Matrix, s: i64) f32 = {
    if s == 2 {
        return((m[0, 0] * m[1, 1]) - (m[1, 0] * m[0, 1]));
    };
    
    det: f32 = 0;
    range(0, s) { r |
        det += m[r, 0] * cofactor(m, r, 0, s);
    };
    det
}

fn submatrix(m: *Sgl.Matrix, row: i64, col: i64, s: i64) Sgl.Matrix = {
    result := zeroed(Sgl.Matrix);
    rr := 0;
    range(0, s) { r |
        if r != row {
            cc := 0;
            range(0, s) { c |
                if c != col {
                    result&[rr, cc] = m[r, c];
                    cc += 1;
                };
            };
            rr += 1;
        };
    };
    result
}
