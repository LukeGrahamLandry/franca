
fn check_cheats(state: *State, event: *Sapp.Event) bool = {
    if event.key_code == .F3 && event.type == .KEY_UP && state.puzzle_focus.is_none() {
        state.enable_cheats = !state.enable_cheats;
        return true;
    };
    @if(!state.enable_cheats) return(false);
    
    if state.puzzle_focus { i |
        it := state.puzzles[i]&;
        while => it.name == .Player && it.cast(.Player)[].puzzle_focus.is_some() {
            // affect inner most child not outer one. 
            i = it.cast(.Player)[].puzzle_focus.Some;
            it = state.puzzles[i]&;
        };
        
        if event.type == .MOUSE_DOWN && event.mouse_button == .MIDDLE {
                if event.modifiers.get(.shift) != 0 {
                    // for debugging the save system. this shouldn't change anything important. 
                        @println("debug save %", it.name);
                        suspend(state, it, true);
                        @println("- % bytes", it.suspended.unwrap().len());
                        restore(state, it);
                        return true;
                };
                
                // TODO: maybe this should be part of the real game in case you make a mistake
                if event.modifiers.get(.super) != 0 {
                    @println("clear save data link=% %", it.link, it.name);
                    suspend(state, it, true);
                    general_allocator().dealloc(u8, it.suspended.unwrap());
                    it.suspended = (Some = "");
                    restore(state, it);
                    return true;
                };
        };
    
        if event.type == .KEY_DOWN {
            if event.key_code == .S && event.modifiers.get(.super) == 1 && i == state.inspect_terminal_puzzle_index {
                save_to_file := event.modifiers.get(.shift) == 1;
                reload_map_debug_screen(state, save_to_file);
                return true;
            };
        };
    } else {
        if event.type == .KEY_UP {
            if event.key_code == .X {
                open_map_debug_screen(state, false, .None);
                return true;
            };
            
            if event.key_code == .SLASH && event.modifiers.get(.super) != 0 {
                if choose_focus(state, state.screen_size/2) { i |
                    it := state.puzzles[i]&;
                    @match(it.name) {
                        fn Mandelbrot() => {
                            s := it.cast(.Mandelbrot);
                            p := s.params&;
                            @println("zoom=%, c=(%, %), z=(%, %)", 1.0/p.scale.double(), 
                                p.c_offset.x.double(), p.c_offset.y.double(), 
                                p.z_offset.x.double(), p.z_offset.y.double());
                            if current_colour(s) { c |
                                @println("current_colour=%", fmt_hex(c));
                            };
                        }
                        fn Player() => {
                            c := it.cast(.Player)[].camera&;
                            @println("pos=vec3(%, %, %), rot=vec2(%, %)", c.pos.x, c.pos.y, c.pos.z, c.rot.x, c.rot.y);
                        }
                        @default => ();
                    };
                } else {
                    c := state.camera&;
                    @println("pos=vec3(%, %, %), rot=vec2(%, %)", c.pos.x, c.pos.y, c.pos.z, c.rot.x, c.rot.y);
                }
            };
        };
        
        if event.type == .KEY_DOWN && event.key_code == .S && event.modifiers.get(.super) == 1 && !event.key_repeat {
            save_world_file(state);
            return true;
        };
    };
    false
}

Terminal :: import("@/examples/gpu/terminal.fr");
fn create_terminal(state: *State) *Terminal.TextBuffer = {
    puzzle := state.inspect_terminal_puzzle_index;
    state.set_focus(Some = puzzle);
    if !state.active_puzzles.items().contains(puzzle) {
        state.active_puzzles&.push(puzzle);
    };
    it := state.puzzles[puzzle]&;
    @if(it.suspended.is_some()) restore(state, it);

    s := it.cast(.Terminal);
    Terminal'state[] = s;
    b := Terminal'selected_buffer();
    b.unwrap()
}

// TODO: if none, use current room instead
// :SLOW but really doesn't matter
fn raycast_object(state: *State) ?i64 = {
    look_dir, _0, _1 := state.camera&.directions();
    best_dist_sq: f32 = 99999999.0;
    hit: ?i64 = .None;
    puzzle_i := -1;
    enumerate state.debug_map_objects { i, it |
        continue :: local_return;
        
        if it.is(.Screen) {
            puzzle_i += 1;
            if puzzle_i == state.inspect_terminal_puzzle_index {
                // don't count the one summoned right in front of you
                continue();
            };
        };
        
        wall := @match(it) {
            fn Wall(it) => new_vertical(it.a, it.b, it.h, it.y);
            fn Tile(it) => new_horizontal(it.a, it.b, it.y);
            fn Locked(it) => new_horizontal(it.a, it.b, 0);
            fn Screen(it) => Editor'wall_from_normal(it.pos, it.normal, it.size);
            @default => continue();
        };
        hit_point, m := remap_mouse_to_wall(wall&, state.camera&, state.screen_size/2, state.screen_size);
        if m.x > 0 && m.y > 0 && m.x < 1 && m.y < 1 {
            dir_to_wall := hit_point - state.camera.pos;
            is_forward := dot(dir_to_wall, look_dir) > 0;
            dist := norm_sq(dir_to_wall);
            if is_forward && dist < best_dist_sq {
                best_dist_sq = dist;
                hit = (Some = i);
            }
        };
    };
    hit
}

// TODO: same thing with editor.fr
// TODO: have a keybind for reloading from file on disk so can use a nice text editor instead of mine. 
// TODO: maybe place it at hit pos plus wall normal like before so you can always see it. rn its hard to use in small hallways.
// TODO: version of this that does it for your save data instead. 
//       but now the nested []u8 instead of a structured thing is annoying. 
// TODO: persist the text changes if you move it without saving to world? or at least some visual indicator of not synced. 
fn open_map_debug_screen(state: *State, save_to_file: bool, keep_wall: ?Wall) void = {
    it := state.puzzles[state.inspect_terminal_puzzle_index]&;
    if keep_wall { keep_wall |
        it.wall = keep_wall;
    } else {
        _0, forward, right := state.camera&.directions();
        p := state.camera.pos;
        pos := p + forward/2 - vec3(0, 0.25, 0);
        it.wall = Editor'wall_from_normal(pos, -forward, 0.5);
    };
    buffer := create_terminal(state);
    
    out := @ref u8.list(temp());
    lines := @ref i64.list(state.debug_map_objects.len, temp());
    save_as_code(out, state.debug_map_objects&, (Some = lines));
    if save_to_file {
        // TODO: store this path on the state so it can be a cli arg
        path := "examples/gpu/maze_game/map.fr";
        if !write_entire_file(path, out.items()) {
            println(out.items());
            println("FAILED TO WRITE");
        } else {
            @println("wrote %", path);
        };
    };
    buffer.clear_text();
    buffer.append_string(out.items());
    
    if raycast_object(state) { i |
        buffer.move_to(lines[i], 1);
    };
}
Editor :: import("@/examples/gpu/maze_game/editor.fr");

// :LEAK slices in the old Objects, old puzzles/rooms slices themselves
fn reload_map_debug_screen(state: *State, save_to_file: bool) void = {
    it := state.puzzles[state.inspect_terminal_puzzle_index]&;
    keep_wall := it.wall;
    a := general_allocator();
    new := Editor.Object.list(a);
    buffer := create_terminal(state);
    if !load_text_from_buffer(buffer, new&) {
        return();
    };
    
    state.debug_map_objects&.drop();
    state.debug_map_objects = new;
    sg := state.sg;
    
    in := @ref u8.list(temp());
    save_world(state, in);
    destroy_all_puzzles(state);
    state.active_puzzles&.clear();
    
    puzzles, rooms := objects_to_world(state.debug_map_objects.items(), a);
    state.puzzles = puzzles;
    state.rooms = rooms;
    // TODO: check first and error instead of crash if they deleted a special one
    state.find_special_puzzles();  
    each state.puzzles { it |
        it.suspended = (Some = empty());
    };
    load_world(state, in.items());
    state.redetect_active_room(true);
    
    open_map_debug_screen(state, save_to_file, (Some = keep_wall));
}

fn load_text_from_buffer(buffer: *Terminal.TextBuffer, it: ~T) bool #where = {
    in := @ref u8.list(temp());
    get_string(buffer, in);
    res := load_text_top(in.items(), it);
    @if_let(res) fn Err(msg) => {
        // the place inserting a comment would break something is in a multiline string but the only error there is "unterminated" so it would be at the end anyway. 
        s := @tfmt("\n/*% (byte=%,line=%,col=%)*/", msg.msg, msg.byte, msg.line, msg.col);
        buffer.insert_string(s, 0, msg.line - 1);
        buffer.move_to(msg.line - 1, msg.col);
        return false;
    };
    true
}

