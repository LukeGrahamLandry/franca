    "@/examples/gpu/terminal.fr",
    "@/examples/chess/gui.fr",
    "@/examples/life/gui.fr",
    "@/examples/circuit/gui.fr",
    "@/examples/gpu/stackie.fr",
    "@/examples/gpu/mandelbrot.fr",
    "@/examples/gpu/maze_game/main.fr",
    "@/examples/gpu/maze2d/gui.fr",
    "@/examples/gpu/farm_game.fr",
    "@/examples/gpu/epicycles.fr",
    "@/examples/gpu/viewer.fr",
    "@/examples/gpu/zones.fr",
    "@/examples/gpu/hctarcs/gui.fr",
    "@/tests/external/wasm4.fr",
    "@/tests/external/decker.fr",
    "@/tests/external/nuklear.fr",
    "@/examples/gpu/app_events.fr",
    "@/examples/gpu/chip8.fr",
    "@/examples/gpu/rtc.fr",
    "@/examples/gpu/hello_triangle.fr",
    "@/examples/gpu/maze_game/editor.fr",
    "@/examples/gpu/geo/main.fr",
);
