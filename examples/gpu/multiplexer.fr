// this program bundles all my graphical examples together 
// and uses nuklear as a compositor to present them in their own little windows.  
// 
// (as you might guess i named this program before i remembered the word compositor)
//
// TODO: my long term goal is to make this work with just a framebuffer and use it in examples/os
// TODO: dynamically load new ones
//       (rn all the apps are in one compilation unit)
// TODO: make it work in web (stb_truetype irriducible control flow)
// TODO: HIGH_DPI in webgpu doesn't work for nuklear. 
//       also it dies if you grow the window need to replace_depth_texture in update_dimensions?
// TODO: circuits/on_cleanup after jit is running crashes
// TODO: file drop event put it on the window you're hovering even if its not focused (can change focus to it)
// TODO: unpaired mouse events? my wasm4 mandelbrot gets stuck thinking the mouse is down. 
// TODO: tests/external/nuklear.fr looks different in this (darker borders?)
// TODO: terminal FEAT_BUNDLE_OPENERS will be wrong because !IS_JITTED but can't self-exec
// TODO: decker wont work nicely with multiple windows because globals. 
//       when i do dynamic loading new ones, can have a tag for ones that aren't reenterant 
//       so each instance needs its own statics. 
//       the current way also doesn't work if you exit from the menu because should_exit stays set
// TODO: dpi is fucked
// TODO: be more structured about programs that output an image (prospero,ascii_table,gpu.fr,images.fr)
//       so this and web playground could list them in the examples nicely and know how to display the image. 
// TODO: be able to add shortcuts to the apps list for running something with cli args?
//       (and add arg to terminal for initial command to run so could put ex. kalidoscope in the list here like it is on web demo)
// TODO: file explorer that sends a drop event to a window
//       (or run a new thing with that as cli arg. ex. for the dump programs). 
//       also for output files. like wasm4 screenshot could have file dialogue to choose where to save it. 
//       like yield_file does for web playground.  
// TODO: dump programs be more structured about declaring which inputs you accept 
//       so could use that to filter the file explorer. 
// TODO: its sad that all of them have to run on the same thread because they share the Sg.Self instance :SLOW
//       could have a thing where you opt in to a resource intensive program getting 
//       its own instance on another thread and just sync to copy the texture once a frame. 
//       (even better would be exec so crashes are contained)
// TODO: have a way to force un-(fullscreen,mouse lock,mouse hide) if the child is misbehaving
// TODO: "see inside" button
// TODO: don't be able to lose windows off the screen (especially when resizing the native window)
// TODO: can i make the top bar smaller?
// TODO: check NO_EXIT_ON_CMD_W on the child before closing the subwindow on that event
// TODO: really i should have Easy'start seperate out the part that makes the 
//       Sapp.Desc so can have a thing to hold on to without being generic over it. 
// TODO: it would be cool if i could make running a graphcis program in the terminal open it as a child window not a host one
// TODO: web: the buttons all turn black if you click "Focus" in the "Monitor"   ????

Ui :: import("@/graphics/deps/nuklear.fr");
Headless :: import("@/tests/gpu.fr")'local_scope;
State :: @struct {
    HIGH_DPI :: true;
    NO_EXIT_ON_CMD_W :: true;
    // children[i].(impl_storage,keycodes,webgpu) are junk. the platform part is only done by the host app. 
    children: List(Window);
    sg: *Sg.Self;
    app: *Sapp.Self;
    ui: Ui.State;
    focus: ?i64;
    dirty: bool;
    next_window_id: i64;
    
    hack_decker: ?*Sapp.Self;
    show_monitor: bool;
};

Window :: @struct {
    app: *Sapp.Self;
    
    img: Sg.Image;
    att: Sg.Attachments;
    d_img: Sg.Image;
    
    bounds: Ui.Nuklear.nk_rect_t;
    target_bounds: Ui.Nuklear.nk_rect_t;
    resizing_frames: i64;
    minimized: bool;
    id: i64;
    title: RawList(u8);
    request_fake_paste: bool;
    hover: bool;  // for MOUSE_LEAVE/MOUSE_ENTER
    paused: bool;

    ready: i64;
    
    name: Str;  // for hack_decker
};

fn on_init(self: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    a := general_allocator();
    self.focus = .None;
    self.hack_decker = .None;
    self.sg = sg;
    self.app = sapp;
    self.children = list(a);
    sapp.desc.enable_dragndrop = true;
    sapp.desc.enable_clipboard = true;
    self.dirty = true;
    on_init(self.ui&, sg);
};

// TODO: be consistant about who has storage for Sg and Sapp. 
//       Easy'start was trying to be helpful and pass them into the callbacks 
//       but turns out it's annoying to not have them on your userdata struct anyway 
//       cause then you have to pass around 3 parameters instead of 1. 
// TODO: now i need seperation between any config you do in the Desc passed to run() 
//       and run() taking control of the event loop. 
//       the desc with callbacks can be a function you export 
//       so then on examples/os applications can be dlopen and call get_app_desc or whatever. 
fn add_app(self: *State, $path: Str) void = {
    UserData :: import(path).State;
    sg := self.sg;
    a := general_allocator();
    it := self.children&.push_uninit();
    it[] = zeroed(Window);
    it.id = self.next_window_id; self.next_window_id += 1; 
    W :: 512; H :: 512;
    it.bounds.w = W;
    it.bounds.h = H;
    init_textures(sg, it, 1);
    it.name = path;
    
    app, user := Headless'init_headless_app2(UserData, sg, it.att, W, H, a);
    if it.name.ends_with("decker.fr") {
        if self.hack_decker&.take() { x |
            app = x;
            app.force_render_target = it.att.id;
        };
    };
    
    it.app = app;
    app.events = list(a);  // annoying to reset after temp()
    app.hack_no_reset_temp_and_no_handle_requests_for_headless = true;
    it.resizing_frames = -1;
}

// TODO: reset temp per child
fn on_render(self: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    ctx := self.ui.ctx&;
    
    prev_commit_count := sg.disabled_commit_calls;
    prev_commit_disabled := sg.hack_disable_commit_for_headless_app;
    sg.hack_disable_commit_for_headless_app = true;
    
    enumerate self.children& { i, it |
        continue :: local_return;
        @if(it.paused) continue();
        child := it.app;
        
        // TODO: other way if this is the first frame focusing it. 
        //       ex. rn changing cursor persists everywhere instead of just being when that child is focused. 
        child.mouse.shown = sapp.mouse.shown;
        child.mouse.locked = sapp.mouse.locked;
        child.mouse.cursor = sapp.mouse.cursor;
        
        // don't spam resize the texture while dragging to resize
        if it.resizing_frames >= 0 {
            it.resizing_frames += 1;
            if it.resizing_frames > 2 {
                it.bounds = it.target_bounds;
                do_resize(sg, it, sapp.dpi_scale);
                it.resizing_frames = -1;
            };
        };
        
        child.frame();
        
        if child.requests.quit {
            child.quit_ordered = true;
        };
        
        if child.requests.window_title { title |
            it.title&.clear();
            it.title&.push_all(title, general_allocator());
            it.title&.push(0, general_allocator());
        };
        
        if child.requests.fake_paste_event {
            sapp.requests.fake_paste_event = true;
            it.request_fake_paste = true;
        };
        
        if child.requests.set_clipboard { clip |
            sapp.set_clipboard_string(clip);
        };
        
        if i == (self.focus || -1) {
            sapp.requests.mouse_shown = child.requests.mouse_shown; 
            sapp.requests.cursor = child.requests.cursor;
            sapp.requests.mouse_locked = child.requests.mouse_locked;
            
            if child.requests.fullscreen != child.fullscreen {
                // TODO: nk_window_set_bounds, save the old one for when un-fullscreen
                // TODO: double click the top bar to toggle fullscreen? or just put a button
            };
        };
    };
    
    if sg.disabled_commit_calls != prev_commit_count {
        self.dirty = true;
    };
    sg.hack_disable_commit_for_headless_app = prev_commit_disabled;
    
    if Easy'should_skip_frame(sapp, self.dirty&) {
        self.ui.idle_last_frame = true;
        return();
    };
    
    Ui'input_end_with_idle(self.ui&) {
        new_focus := draw_ui(self);
        update_focus(self, new_focus);
    };
    
    Easy'glue_begin_pass(sapp, sg, (colors = ((
        load_action = .CLEAR,
        clear_value = (r = 0, g = 0, b = 0, a = 1),
    ), ..)));
    draw(self.ui&, sg, sapp);
    sg.end_pass();
    sg.commit();
}

update_focus :: fn(self: *State, new_focus: ?i64) void = {
    old_i, new_i := (self.focus || -1, new_focus || -1);
    if old_i != new_i {
        if old_i != -1 {
            app := self.children[old_i].app;
            app.events&.push(app.init_event(.UNFOCUSED)[]);
        };
        if new_i != -1 {
            app := self.children[new_i].app;
            app.events&.push(app.init_event(.FOCUSED)[]);
        };
        self.focus = new_focus;
    };
};

fn draw_ui(self: *State) ?i64 = {
    ctx := self.ui.ctx&;
    #use(Ui.Nuklear);
    S :: fn(s: CStr) => bit_cast_unchecked(*u8, *i8, s.ptr);
    flags := (@as(u32) nk_panel_flags.NK_WINDOW_MOVABLE).bit_or(@as(u32) nk_panel_flags.NK_WINDOW_SCALABLE).bit_or(@as(u32) nk_panel_flags.NK_WINDOW_MINIMIZABLE);
    h := self.app.height().float().cast()/self.app.dpi_scale;
    if nk_begin(ctx, S"Applications", nk_rect(0, 0, 300, h), flags) {
        nk_layout_row_dynamic(ctx, 20, 2);
        
        if nk_checkbox_label(ctx, S"Monitor", self.show_monitor&) || self.app.frame_count < 2 {
            self.dirty = true;
            nk_window_show(ctx, S"Monitor", @if(self.show_monitor, .NK_SHOWN, .NK_HIDDEN));
            if self.show_monitor {
                nk_window_set_focus(ctx, S"Monitor");
            }
        };
        
        nk_layout_row_dynamic(ctx, 20, 1);
        inline_for app_files { $name |
            disable := name[].ends_with("decker.fr") && self.children.find(fn(it) => it.name == name[]).is_some();
            @if(disable) nk_widget_disable_begin(ctx);
            if nk_button_label(ctx, S(@run name[].sym().c_str())) {
                self.add_app(name[]);
            };
            @if(disable) nk_widget_disable_end(ctx);
            
        };
    };
    nk_end(ctx);
    
    flags := flags.bit_or(@as(u32) nk_panel_flags.NK_WINDOW_CLOSABLE);
    if nk_begin(ctx, S"Monitor", nk_rect(300, 0, 600, h), flags) {
        each self.children { it |
            title := @if(it.title.len != 0, S(ptr = it.title.ptr), S(@fmt_cstr("%", it.name)));
            if nk_tree_push_hashed(ctx, .NK_TREE_NODE, title, .NK_MINIMIZED, S"child", 5, it.id.intcast()) {
                name := S(@fmt_cstr("%", it.id));

                nk_layout_row_dynamic(ctx, 16, 1);
                nk_label(ctx, S(@fmt_cstr("%", it.name)), 0);
                nk_layout_row_dynamic(ctx, 16, 4);
                inline_for_enum Fields(@type it.bounds) { $f |
                    value := get_field(@type it.bounds, it.bounds&, f[])[];
                    nk_label(ctx, S(@fmt_cstr("%: %", f[], value)), 0);
                };
                    
                nk_layout_row_dynamic(ctx, 0, 4);
                
                minimized := nk_window_is_collapsed(ctx, name);
                if nk_checkbox_label(ctx, S"Minimized", minimized&) {
                    nk_window_collapse(ctx, name, @if(minimized, .NK_MINIMIZED, .NK_MAXIMIZED));
                };
                nk_checkbox_label(ctx, S"Paused", it.paused&);
                
                nk_layout_row_dynamic(ctx, 0, 4);
                focused := nk_window_is_active(ctx, name);
                @if(focused) nk_widget_disable_begin(ctx);
                if nk_button_label(ctx, S"Focus") {
                    nk_window_set_focus(ctx, name);
                };
                @if(focused) nk_widget_disable_end(ctx);
                if nk_button_label(ctx, S"Find") {
                    nk_window_set_bounds(ctx, name, nk_window_get_bounds(ctx));
                    nk_window_set_focus(ctx, name);
                };
                if nk_button_label(ctx, S"Quit") {
                    it.paused = false;
                    it.app.requests.quit = true;
                    it.app.app_event(.QUIT_REQUESTED);
                };
                if nk_button_label(ctx, S"Kill") {
                    it.paused = false;
                    it.app.quit_ordered = true;
                };
                
                nk_tree_pop(ctx);
            };
        };
    } else {
        self.show_monitor = !nk_window_is_hidden(ctx, S"Monitor");
    };
    nk_end(ctx);
    
    flags := flags.bit_or(@as(u32) nk_panel_flags.NK_WINDOW_NO_SCROLLBAR); 
    
    old_padding := ctx.style.window.padding;
    old_background := ctx.style.window.fixed_background;
    black := Ui'Nuklear'nk_style_item_color(r=0,g=0,b=0,a=255);
    ctx.style.window.padding = (x=0,y=0);  // get rid of side padding
    ctx.style.window.fixed_background = black; // make the bottom padding blend in to the background
    
    new_focus: ?i64 = .None;
    enumerate self.children& { i, it |
        name := S(@fmt_cstr("%", it.id));
        title := @if(it.title.len != 0, S(ptr = it.title.ptr), S(""));
        
        if it.app.quit_ordered {
            nk_window_close(ctx, name);
            it.id = -1;
        };
        
        if it.resizing_frames >= 0 && it.ready > 2 {
            // make it easier to see where the window will be when resizing. 
            ctx.style.window.fixed_background = Ui'Nuklear'nk_style_item_color(r=20,g=20,b=20,a=255);
        } else {
            ctx.style.window.fixed_background = black;
        };
        
        minimized := true;
        if nk_begin_titled(ctx, name, title, nk_rect(10, 10, 300, 300), flags) {
            minimized = false;
            canvas := nk_window_get_canvas(ctx);
            new_bounds := canvas.clip;  // like nk_window_get_bounds(ctx) but without including the menu bar, etc.
            
            if nk_window_has_focus(ctx) {
                new_focus = (Some = i);
            };
            
            if it.resizing_frames < 0 && nk_window_is_hovered(ctx) != it.hover {
                it.hover = !it.hover;
                it.app.events&.push(it.app.init_event(@if(it.hover, .MOUSE_ENTER, .MOUSE_LEAVE))[]);
            };
            
            it.bounds.x = new_bounds.x;
            it.bounds.y = new_bounds.y;
            x := it.target_bounds;
            if it.target_bounds.w != new_bounds.w || it.target_bounds.h != new_bounds.h {
                it.target_bounds = new_bounds;
                it.resizing_frames = 0;
            };
            
            if it.ready > 3 {
                img := nk_image_handle(pack_nk_handle(it.img, self.ui.smp));
                nk_draw_image(canvas, it.bounds, img&, (r=255,g=255,b=255,a=255));
            } else {
                // don't show flash of purple uninit texture on the first frame
                it.ready += 1;
            };
        };
        nk_end(ctx);
        
        if minimized && !it.app.quit_ordered && nk_window_is_hidden(ctx, name) {
            // pressed the x button in the menu bar
            minimized = false;
            it.app.requests.quit = true;
            it.app.app_event(.QUIT_REQUESTED);  
            nk_window_show(ctx, name, .NK_SHOWN);
            // will close next frame if not canceled
        };
        minimized := minimized && nk_window_is_collapsed(ctx, name);
        if minimized != it.minimized {
            app := it.app;
            app.events&.push(app.init_event(@if(minimized, .ICONIFIED, .RESTORED))[]);
            it.minimized = minimized;
        };
    };
    
    ctx.style.window.padding = old_padding;
    ctx.style.window.fixed_background = old_background;
    
    i := 0;
    self.children&.ordered_retain(fn(it) => {
        keep := it.id != -1;
        if !keep {
            if i == (self.focus||-1) {
                r := self.app.requests&;
                r.mouse_shown = true; r.cursor = .DEFAULT; r.mouse_locked = false;
            };
            // TODO: but i think this will send a junk UNFOCUSED event if an unfocued window closes itself 
            new_focus = .None;  // waste a frame to not deal with remapping indices
            drop(self, it, false);
            if i <= (self.focus||-1) {
                self.focus = .None;
            };
        };
        i += 1;
        keep
    });
    
    new_focus
}

// TODO: don't keep calling on_render when minimised when running as a standalone program either. 
//       here it happens naturally that events/renders are only sent to the active program. 
//       which makes sense, no point rendering. tho sokol does keep sending you frames consistantly
//       (fallbackTimerFired, etc.), i guess it's bad to randomly pause time but it feels bad that 
//       the general case is doing extra effort just to burn extra cpu for no reason. 
//       maybe add Desc.tick_while_iconified as a config option. 
fn on_event(self: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = {
    is_mouse := @is(event.type, .MOUSE_DOWN, .MOUSE_UP, .MOUSE_MOVE, .MOUSE_SCROLL);
    sent_ui_event := false;
    if self.focus.is_none() || is_mouse {
        on_event(self.ui&, sapp, event);
        sent_ui_event = true;
    };
    if event.type == .RESIZED {
        self.dirty = true;
        return();
    };
    
    @if(@is(event.type, .MOUSE_ENTER, .MOUSE_LEAVE)) return();  // don't care about the host window
    
    if event.type == .KEY_DOWN && event.key_code == .W && event.modifiers.get(.super) != 0 {
        if self.children.len == 0 {
            sapp.requests.quit = true;
        };
        
        if self.focus { i |
            self.dirty = true;
            child := self.children[i].app;
            child.requests.quit = true;
            child.app_event(.QUIT_REQUESTED);
        };
    }
    
    if event.type == .CLIPBOARD_PASTED && event.fake {
        each self.children { it |
            if it.request_fake_paste && !it.paused {
                it.request_fake_paste = false;
                it.app.events&.push(event[]);
            }
        };
        return();
    };
    
    if self.focus { i |
        break :: local_return;
        child := self.children[i]&;
        @if(child.paused) break();
        dpi_scale := sapp.dpi_scale;
        event.mouse_x -= child.bounds.x * dpi_scale;
        event.mouse_y -= child.bounds.y * dpi_scale;
        
        // TODO: the macos behaviour is you keep getting mouse move events when the 
        //       mouse isn't hovering your window as long as you're still focused. should match that. 
        //       (that's not what happens in web playground tho)
        // TODO: this check should be relative to target_bounds instead so it works while resizing
        @if(is_mouse)
        if event.mouse_x < 0 || event.mouse_y < 0 || event.mouse_x > child.bounds.w*dpi_scale || event.mouse_y > child.bounds.h*dpi_scale { 
            break();
        };
        
        @if(event.type == .FILES_DROPPED && !child.app.desc.enable_dragndrop) return();
        @if(event.type == .CLIPBOARD_PASTED && !child.app.desc.enable_clipboard) return();
        
        child.app.events&.push(event[]);
        return();
    };
    if sent_ui_event {
        self.dirty = true;
    };
};

#use("@/graphics/lib.fr");
driver :: fn(vtable: *ImportVTable) void = Easy'build_for_graphics(vtable, @source_file_name());
main :: fn() void = Easy'start(State);

// TODO: init_headless_app2 leaks the memory of Sapp,Instance,UserData   (maze_game only leaks instance)
fn drop(self: *State, it: *Window, final: bool) void = {
    sg := self.sg;
    
    if !final && it.name.ends_with("decker.fr") {
        @debug_assert(self.hack_decker.is_none(), "hack: decker isn't reenterant");
        self.hack_decker = (Some = it.app);
    } else {
        it.app.call_cleanup();
        it.app.events&.drop();
    };
    it.title&.drop(general_allocator());
}

fn on_cleanup(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    each state.children { it |
        drop(state, it, true);
    };
    state.children&.drop();
    on_cleanup(state.ui&, sg);
}

fn do_resize(sg: *Sg.Self, it: *Window, dpi_scale: f32) void = {
    it.app.dpi_scale = 1;
    W := (it.bounds.w*dpi_scale).cast().int();
    H := (it.bounds.h*dpi_scale).cast().int();
    init_textures(sg, it, dpi_scale);
    app := it.app;
    app.events&.push(app.init_event(.RESIZED)[]);
    app.window_width = W;
    app.window_height = H;
    app.framebuffer_width = W;
    app.framebuffer_height = H;
    app.force_render_target = it.att.id;
}

fn init_textures(sg: *Sg.Self, it: *Window, dpi_scale: f32) void = {
    Headless'drop_offscreen_att(sg, it);
    w := (it.bounds.w * dpi_scale).cast().int().intcast();
    h := (it.bounds.h * dpi_scale).cast().int().intcast();
    Headless'init_offscreen_att(sg, it, w, h);
}

