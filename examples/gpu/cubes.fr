@if(i==40, -1, 1 + i.mod(16))
*/

cube_vertices :: @const_slice(
    vec3(0, 1, 0), vec3(1, 1, 0), vec3(1, 0, 0), vec3(0, 0, 0),
    vec3(0, 0, 1), vec3(1, 0, 1), vec3(1, 1, 1), vec3(0, 1, 1),
    vec3(0, 0, 1), vec3(0, 1, 1), vec3(0, 1, 0), vec3(0, 0, 0),
    vec3(1, 0, 1), vec3(1, 0, 0), vec3(1, 1, 0), vec3(1, 1, 1),
    vec3(1, 0, 0), vec3(1, 0, 1), vec3(0, 0, 1), vec3(0, 0, 0),
    vec3(0, 1, 0), vec3(0, 1, 1), vec3(1, 1, 1), vec3(1, 1, 0),
);

block_colours :: {
    hsv2rgb :: import("@/examples/gpu/hctarcs/runtime.fr").hsv2rgb;
    ast_alloc().alloc_init(ColourPair, 16, fn(i) => {
        r, g, b := hsv2rgb(i.float() / 16, 1, 1);
        (rgb = vec3(r.cast(), g.cast(), b.cast()), c = pack_rgba(r, g, b, 1))
    })
};

fn on_cleanup(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    a := general_allocator();
    Headless'drop_offscreen_att(sg, state.view&);
    sg.destroy_pipeline(state.pipe&);
    state.draw&.destroy(sg, a);
    Ui'Nuklear'nk_textedit_free(state.edit&);
    on_cleanup(state.ui&, sg);
    state.errors&.drop();
    state.source&.drop(a);
    a.dealloc(u8, state.grid.cells);
    a.dealloc(@type state.palette[0], state.palette);
}

palettes :: @const_slice(
    ("ColourWheel", block_colours),
    ("Decker", repack(@const_slice(0x00FFFFFF,0xFFFF00,0xFF6500,0xDC0000,0xFF0097,0x360097,0x0000CA,0x0097FF,0x00A800,0x006500,0x653600,0x976536,0xB9B9B9,0x868686,0x454545,0x000000))),
    ("Replicube", repack(@const_slice(0x00dfe9f5,0x697594,0x101517,0xf7aaa8,0xd4689a,0x782c96,0xe83562,0xf2825c,0xffc76e,0x88c44d,0x3f9e59,0x373461,0x4854a8,0x7199d9,0x9e5252,0x4d2536))),  // https://lospec.com/palette-list/anb16 with grey swapped around
);

decker_names :: @const_slice(@as(CStr) "white", "yellow", "orange", "red", "magenta", "purple", "blue", "cyan", "green","darkgreen","brown","tan","lightgray","mediumgray","darkgray","black");
replicube_names :: @const_slice(@as(CStr)"EMPTY","WHITE","GREY","BLACK","PEACH","PINK","PURPLE","RED","ORANGE","YELLOW","LIGHTGREEN","GREEN","DARKBLUE","BLUE","LIGHTBLUE","BROWN","DARKBROWN");

repack :: fn(x: []u32) []ColourPair = {
    ast_alloc().alloc_init(ColourPair, 16, fn(i) => {
        x := x[i];
        r, g, b := (x.shift_right_logical(16).bit_and(255).int(), x.shift_right_logical(8).bit_and(255).int(), x.bit_and(255).int());
        (rgb = vec3(r.float().div(255).cast(), g.float().div(255).cast(), b.float().div(255).cast()), c = pack_rgba(r, g, b, 255))
    })
}

// TODO: could extract this and use it for other programs that let you run things
// TODO: for web have button to pick something to upload from the real file system

FileBrowser :: @struct {
    root: RawList(u8);
    files: RawList(Entry);
    a: Alloc;
    Entry :: @struct(name: Str, is_dir: bool);
    selected_file: ?i64;
};

fn init(self: *FileBrowser, a: Alloc, root: Str) void = {
    self[] = zeroed(@type self[]);
    self.a = general_allocator();
    self.root&.push_all(root, self.a);
    self.root&.reserve(1024, self.a);
    self.open_root();
    self.selected_file = .None;
}

fn file_browser(ctx: *Ui'Nuklear'nk_context, self: *FileBrowser) void = {
    #use(Ui.Nuklear);
    
    nk_layout_row_dynamic(ctx, 0, 1);
    // TODO: keep a seperate stashed_root so the open buttons use the old one even if you've edited the field
    length := self.root.len.intcast();
    flags := (@as(u32) nk_edit_flags.NK_EDIT_ALWAYS_INSERT_MODE).bit_or(@as(u32) nk_edit_flags.NK_EDIT_SIG_ENTER).bit_or(@as(u32) nk_edit_flags.NK_EDIT_SELECTABLE).bit_or(@as(u32) nk_edit_flags.NK_EDIT_CLIPBOARD);
    r := nk_edit_string(ctx, flags, Ui'nk_string(self.root.items()), length&, self.root.cap.intcast(), nk_filter_default);
    self.root.len = length.intcast();
    @debug_assert_ule(self.root.len, self.root.cap);
    if r.bit_and(@as(u32) nk_edit_events.NK_EDIT_COMMITTED) != 0 {
        self.open_root();
    };
    
    nk_layout_row_dynamic(ctx, 0, 2);
    widget_disable(ctx, self.root.len <= 1) {
        if button(ctx, "Parent") {
            self.root.len -= (self.root.len - self.root.items().pop_path_segment().len());
            self.root.len -= int(self.root.len > 1 && self.root.items().ends_with("/"));
            self.open_root();
        };
    };
    if button(ctx, "CWD") {
        self.root&.clear();
        self.root&.push_all(get_working_directory(temp()).items(), self.a);
        self.open_root();
    };
    
    nk_layout_row_dynamic(ctx, ctx.style.font.height + 6, 1);
    prev_align := ctx.style.button.text_alignment;
    ctx.style.button.text_alignment = @as(u32) nk_text_alignment.NK_TEXT_LEFT;
    select: ?i64 = .None;
    enumerate self.files { i, it |
        if button(ctx, it.name) {
            select = (Some = i);
        }
    };
    ctx.style.button.text_alignment = prev_align;
    if select { i |
        it := self.files[i];
        if it.is_dir {
            @if(!self.root.items().ends_with("/")) self.root&.push_all("/", self.a);
            self.root&.push_all(it.name, self.a);
            self.open_root();
        } else {
            self.selected_file = select;
        }
    };
}

fn open_root(self: *FileBrowser) void = {
    @if_let(collect_directory_ordered(self.root.items(), temp(), self.a)) fn Ok(files) => {
        each self.files { it |
            self.a.dealloc(u8, it.name);
        };
        self.files&.clear();
        for files { it |
            self.files&.push((name = it.name, is_dir = it.type == .Directory), self.a);
        };
    };
}
