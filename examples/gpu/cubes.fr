
// like shadertoy but 3d and slow. replicube is what im most egregiously copying. 
//
// there's a vague attempt to limit the amount of io the programs can do. 
// if i was being more serious i'd probably put them in a bubblewrapped subprocess. 

// you can disable some to compile faster and have fewer dependencies
DEP :: true;  // i didn't write the compiler
MEM :: true;  // unsandboxed memory access
JMP :: !GRAPHICS_TARGET_WEB;  // uses longjmp for errors so won't work in web playground
JIT :: true;  // not an interpreter
enable_languages :: @const_slice(JMP&&MEM&&JIT, JMP, DEP&&JMP, DEP, JMP&&MEM&&JIT, JIT);
Language :: @enum(i32) (
    C,    // (../import_c)
    Lox,  // https://craftinginterpreters.com (../lox)
    Lua,  // https://lua.org
    Lil,  // https://beyondloom.com/decker/lil.html
    Franca,        // (../../compiler) fragile, my thing isn't very embeddable for non-generated programs :(
    Kaleidoscope,  // https://llvm.org/docs/tutorial (../kalidoscope.fr)
);

// TODO: depth LESS_EQUAL doesn't work in browser ?? 
// TODO: use the type of textbox with undo
// TODO: wasm for c/franca so memory is in jail too? 
//       franca is a pain in the ass because really i should run the compiler in wasm too. 
//       need to list the math imports for that but i should do that for native c anyway. 
// TODO: once you can do code its easy to reuse for other types of programs. 
//       draw pictures, solve mazes, idk. 2d with much higher resolution. franca could do gpu. 
// TODO: a thing where you can share levels. (program for expected output, initial code with hints, dimensions, palette, offset for the input numbers if you'd rather it be centered on zero). 
//       and then show how close you get / how long it takes. 
// TODO: would be cool to make a game where this is how you unlock stuff. 
//       like to get a machine you have to program its shape out of voxels. 
// TODO: eval in a thread so could do longer running things. 
// TODO: some way to see the inside of the cube
// TODO: stay centered on the mouse when zooming (and allow when not in camera mode)
//       doing it with the cameras fov stays centered but then zooming out a lot distorts the edges. 
// TODO: build a more efficient mesh so i can make bigger shapes
// TODO: when part of the output window is off the screen, it squishes because the reported y+h or whatever is off the screen so the aspect is wrong
// TODO: pasting tabs shows as '?' (tab key inserts spaces)

State :: @struct {
    HIGH_DPI :: true;
    ui: Ui.State;
    dirty: bool;
    grid_dirty: bool;
    draw: Sgl.Self;
    pipe: Sgl.Pipeline;
    grid: Grid;
    
    camera: import("@/examples/gpu/maze_game/camera.fr").Camera;
    dt: f32;
    
    scale: f32;
    output_size: Vec2;
    output_resized: bool;
    prev_frame_time: f64;
    enable_movement: bool;
    source: List(u8);
    errors: List(u8);
    
    palette: []ColourPair;
    palette_index: i32;
    lang: Language;
    run: bool;
    auto_run: bool;
    
    view: View;
    prev_view: ?View;
};
View :: @struct {
    img: Sg.Image;
    att: Sg.Attachments;
    d_img: Sg.Image;
};
ColourPair :: @struct(rgb: Vec3, c: u32);
Lox :: import("@/examples/lox/lox_main.fr").Lox;

fn on_init(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    sapp.desc.enable_clipboard = true;
    on_init(state.ui&, sg);
    state.dirty = true;
    state.grid_dirty = true;
    state.source = list(4096, general_allocator());
    state.errors = list(general_allocator());
    state.palette = block_colours.shallow_copy(general_allocator());  // :leak
    state.prev_view = .None; 
    
    state.draw&.setup(
        allocator = general_allocator(),
        sg = sg,
        max_vertices = 1,
        lazy_record = true,
    );
    
    init_pipeline(state.draw&, state.pipe&, sg, (
        cull_mode = .BACK,
        face_winding = .CCW,
        depth = (
            write_enabled = true,
            compare = @if(GRAPHICS_TARGET_WEB, .ALWAYS, .LESS_EQUAL),
        ),
    ));
    
    state.grid.dimensions = vec3(16);
    resize_grid(state, sg);
    
    state.scale = 0.065;
    state.camera.perspective = (aspect = 1, fovy = deg_to_rad(70), znear = 0.01, zfar = 100.0);
    state.camera.speed = (pos = 0.045 * 30.0, rot = 0.005 * 30.0);
    state.camera.pos = vec3(0.7, 1, 2);
    state.camera.rot = vec2(-0.3, -1.7);
    
    state.lang = @if(GRAPHICS_TARGET_WEB, .Lil, .Lox);
    state.source&.push_all(initial_program[intcast(@as(i32) state.lang)]);
    evaluate(state.grid&, state.source.items(), state.errors&, state.lang);
}

Headless :: import("@/tests/gpu.fr")'local_scope;
fn on_render(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    now := timestamp_s();
    state.dt = (now - state.prev_frame_time).cast();
    state.prev_frame_time = now;
    
    if Easy'should_skip_frame(sapp, state.dirty&) {
        state.ui.idle_last_frame = true;
        return();
    };
    sapp.lock_mouse(state.enable_movement);
    
    if state.prev_view&.take() { it |
        Headless'drop_offscreen_att(sg, it&);
    };

    w, h := (sapp.width().float().cast() / sapp.dpi_scale, sapp.height().float().cast() / sapp.dpi_scale);
    input_end_with_idle(state.ui&, => draw_ui(state, w, h));
    
    sgl := state.draw&;
    if state.grid_dirty {
        state.dirty = !(state.camera.delta_pos == vec3(0)) || state.output_resized;
        state.grid_dirty = state.dirty;
        if state.output_resized&.take() {
            @debug_assert(state.prev_view.is_none(), "stomp prev_view");
            state.prev_view = (Some = state.view);  // delay drop because it was used in the ui already this frame
            s := state.output_size * sapp.dpi_scale;
            w, h := (s.x.cast().int().intcast().max(1), s.y.cast().int().intcast().max(1));
            Headless'init_offscreen_att(sg, state.view&, w, h);
        };
        
        it := zeroed(Sg.Pass);
        it.attachments = state.view.att;
        it.action = ClearAction(r = 0.04, g = 0.04, b = 0.04);
        begin_pass(sg, it&);
        render_cubes(state, sg, sgl, sapp.dpi_scale);
        sgl.draw_layer(sg, 0);
        sg.end_pass();
    };
    
    Easy'glue_begin_pass(sapp, sg, ClearAction(r = 0, g = 0, b = 0));
    draw(state.ui&, sg, sapp);
    sg.end_pass();
    sg.commit();
}

fn render_cubes(state: *State, sg: *Sg.Self, sgl: *Sgl.Self, dpi_scale: f32) void = {
    resize_grid(state, sg);
    
    sgl.rewind();
    sgl.defaults();
    r := state.output_size * dpi_scale;
    aspect := r.x / r.y;
    sgl.viewport(@as(i32)0, 0, r.x.cast().int().intcast(), r.y.cast().int().intcast(), true);
    sgl.load_pipeline(state.pipe);
    sgl.load_identity();
    
    state.camera.perspective.aspect = aspect;
    update_camera(state.camera&, state.dt);
    write_camera(state.camera&, sgl);
    sgl.scale(state.scale, state.scale, state.scale);
    sgl.begin(.QUADS);
    grid := state.grid&;
    colours := state.palette;
    prev := grid.center_on_zero&.take();
    iter_grid(grid) { x, y, z, i |
        c: i64 = grid.cells[i].zext() - 1;
        if c.ult(colours.len) {
            sgl.color = colours[c].c;
            pos := vec3(x.float().cast(), y.float().cast(), z.float().cast());
            for cube_vertices { v |
                sgl.v3f(pos + v*0.975);
            };
        };
    };
    grid.center_on_zero = prev;
    sgl.end();
    @if(sgl.error.vertices_full && state.errors.len == 0) @fmt(state.errors&, "too many vertices");
    
    @if(sgl.vertices.len > 0)
    sgl.update_vertex_buffer(sg);
}

fn on_event(state: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = {
    on_event(state.ui&, sapp, event);
    state.dirty = true;
    
    @match(event.type) {
        fn MOUSE_SCROLL() => if state.enable_movement {
            state.scale = clamp(state.scale + event.scroll_y / 300, 0.01, 10);
        };
        fn KEY_DOWN() => {
            xx := event.modifiers.get(.control) == 1 || event.modifiers.get(.super) == 1;
            yy := @is(event.key_code, .R, .S);
            if xx && yy {
                state.run = true;
            };
        }
        @default => ();
    };
    
    if state.enable_movement {
        state.grid_dirty = true;
        fly_controller(state.camera&, event);
        if event.type == .KEY_DOWN && @is(event.key_code, .Q, .ESCAPE) {
            state.enable_movement = false;
        }
    };
}

fn draw_ui(state: *State, w: f32, h: f32) void #use(Ui.Nuklear) = {
    ctx := state.ui.ctx&;
    flags := (@as(u32) nk_panel_flags.NK_WINDOW_MOVABLE).bit_or(@as(u32) nk_panel_flags.NK_WINDOW_SCALABLE).bit_or(@as(u32) nk_panel_flags.NK_WINDOW_MINIMIZABLE);

    prev := state.output_size;
    output_pos := zeroed(nk_rect_t);
    if begin(ctx, "Output", nk_rect(0, 0, w/2, h), flags) {
        output_pos = nk_window_get_content_region(ctx);
        state.output_size = vec2(output_pos.w, output_pos.h);
        draw := nk_window_get_canvas(ctx);
        // for the first frame the ui is drawn before allocating the image :(
        if state.view.img.id != 0 {
            img := nk_image_handle(pack_nk_handle(state.view.img, state.ui.smp));
            nk_draw_image(draw, output_pos, img&, (r=255,g=255,b=255,a=255));
        }
    };
    nk_end(ctx);
    if !(prev == state.output_size) {
        state.grid_dirty = true;
        state.output_resized = true;
    };
    
    if begin(ctx, "Program", nk_rect(w/2, 0, w/2, h), flags) {
        size := nk_window_get_content_region(ctx);
        nk_layout_row_dynamic(ctx, 0, 2);
        run_pressed := button(ctx, "Run") || state.run;
        state.run = false;
        widget_disable(ctx, state.enable_movement) {
            if button(ctx, @if(!state.enable_movement, "Adjust Camera", "Press Q to stop")) {
                state.enable_movement = true;
            };
        };
        
        hack: f32 = 0;
        if tree_push(ctx, .NK_TREE_NODE, "Settings", .NK_MINIMIZED) {
            nk_layout_row_dynamic(ctx, 0, 2);
            hack = 8;  // TODO: why is at_y wrong when tree is open?
        
        languages := temp().alloc_init(*i8, Language.enum_count(), fn(i) => {
            it := @as(Language) @as(i32) i.intcast();
            it := it.name_str();
            it.Ui'nk_cstring()
        });
        new := @as(Language) @as(i32) nk_combo(ctx, languages.ptr, languages.len.intcast(), @as(i32) state.lang, 20, (x=200, y=200));
        if new != state.lang {
            @run @assert_eq(initial_program.len(), Language.enum_count(), "initial_program.len");
            if state.source.items() == initial_program[intcast(@as(i32) state.lang)] {
                state.source&.clear();
                state.source&.push_all(initial_program[intcast(@as(i32) new)]);
            }
            state.lang = new;
        }
        if checkbox(ctx, "Auto Run", state.auto_run&) {
            run_pressed = state.auto_run;
        };

        colours := temp().alloc_init(*i8, palettes.len(), fn(i) => palettes[i]._0.Ui'nk_cstring());
        new := nk_combo(ctx, colours.ptr, colours.len.intcast(), state.palette_index, 20, (x=200, y=200));
        if new != state.palette_index {
            state.palette_index = new;
            state.grid_dirty = true;
            state.palette.copy_from(palettes[new.intcast()]._1);
        };
        
        if checkbox(ctx, "Center On Zero", state.grid.center_on_zero&) {
            run_pressed = state.auto_run;
        };
        
        nk_layout_row_dynamic(ctx, 16, 16);
        saved := ctx.style.combo;
        ctx.style.combo.label_normal = (r=0,g=0,b=0,a=255);
        ctx.style.combo.sym_hover = .NK_SYMBOL_NONE;
        ctx.style.combo.sym_normal = .NK_SYMBOL_NONE;
        range(0, 16) { i |
            c := state.palette[i];
            ctx.style.combo.normal = nk_style_item_color(nk_rgba_cf(r=c.rgb.x,g=c.rgb.y,b=c.rgb.z,a=1));
            s := @tfmt("%", i+1);
            if nk_combo_begin_text(ctx, Ui'nk_string(s), s.len.intcast(), (x = 200, y = 400)) {
                nk_layout_row_dynamic(ctx, 120, 1);
                c := nk_color_picker(ctx, (r=c.rgb.x,g=c.rgb.y,b=c.rgb.z,a=1), .NK_RGBA);
                prev := state.palette[i].c;
                state.palette[i] = (rgb = vec3(c.r,c.g,c.b), c = pack_rgba(c.r, c.g, c.b, 1));
                nk_combo_end(ctx);
                if prev != state.palette[i].c {
                    state.grid_dirty = true;
                };
            };
            // TODO: let you edit the numbers directly
        };
        ctx.style.combo = saved;
        
        nk_layout_row_dynamic(ctx, 0, 3);
        // ugh, somehow this has become super verbose
        range(0, 3) { i |
            it := state.grid.dimensions&[i]&;
            v := it[].cast().int().intcast();
            prev := v;
            if nk_property_int(ctx, Ui'nk_cstring("X\0Y\0Z\0".rest(i*2)), 1, v&, 64, 1, 0.5) {
                if v != prev {
                    it[] = v.intcast().float().cast();
                    state.grid_dirty = true;
                };
            };
        };
        
        nk_tree_pop(ctx);
        };
    
        length: i32 = state.source.len.intcast();
        // TODO: need to make enum as flags like this less painful
        flags := (@as(u32) nk_edit_flags.NK_EDIT_ALWAYS_INSERT_MODE).bit_or(@as(u32) nk_edit_flags.NK_EDIT_SELECTABLE).bit_or(@as(u32) nk_edit_flags.NK_EDIT_CLIPBOARD).bit_or(@as(u32) nk_edit_flags.NK_EDIT_MULTILINE).bit_or(@as(u32) nk_edit_flags.NK_EDIT_ALLOW_TAB);
     
        text_width := {
            prev := 0;
            width: f32 = 0;
            max_line: f32 = 0;
            font := ctx.style.font;
            range(0, state.source.len) { i |
                width += font'width(font.userdata, font.height, Ui'nk_string(state.source.items().rest(i)), 1);
                if state.source[i] == "\n".ascii() {
                    max_line = max(max_line, width);
                    prev = i;
                    width = 0;
                };
            };
            max(max_line, width) + 20
        };
        
        used := ctx.current.layout.at_y + hack;
        box_height := max(size.h - used, 60);
        nk_layout_row_static(ctx, box_height, size.w.cast().int().intcast(), 1);
        hash := ctx.current.edit.seq;
        // TODO: i so wish i could do this seperatly for top and bottom. 
        //       the problem is mouse on scroll bar only works if it's not in the text zone. 
        //       but it can't be off the whole text box widget because then state isn't active so gets cleared. 
        ctx.style.edit.padding.y += ctx.style.edit.scrollbar_size.y;
        prev_source := @if(state.auto_run, state.source.items().shallow_copy(temp()), "");  // :SLOW
        r := nk_edit_string(ctx, flags, bit_cast_unchecked(*u8, *i8, state.source&.as_ptr()), length&, state.source.maybe_uninit.len.intcast(), nk_filter_default);
        state.source.len = length.intcast();
        
        if state.auto_run && ctx.text_edit.active != 0 && prev_source != state.source.items() {
            run_pressed = true;
        };
        
        /**/{
            edit := ctx.text_edit&;
            scroll: nk_rect_t = (
                x = size.x + ctx.style.edit.padding.x,
                // TODO: this doesn't scroll with the window contents
                y = (size.y + size.h - ctx.style.edit.border - ctx.style.edit.padding.y),// - ctx.style.edit.scrollbar_size.y,
                w = size.w - 2*ctx.style.edit.border - 2*ctx.style.edit.padding.x,
                h = ctx.style.edit.scrollbar_size.y,
            );
            
            is_hovered: i32 = int(r.bit_and(@as(u32) nk_widget_states.NK_WIDGET_STATE_HOVERED) != 0).intcast();
            ws: u32 = 0;
            edit.scrollbar.x = nk_do_scrollbarh(ws&, nk_window_get_canvas(ctx), scroll, is_hovered,
                    edit.scrollbar.x, text_width, scroll.w * 0.10, scroll.w * 0.01,
                    ctx.style.edit.scrollbar&, ctx.input&, ctx.style.font);
            if edit.active != 0 {
                trunc :: fn(v: i64) u32 #ir(.copy, .Kw);  // TODO: going to lose my fucking mind. fix math.h shadowing
                ctx.current.edit.scrollbar.x = edit.scrollbar.x.cast().int().trunc();
            };
            // TODO: horizontal scroll by mouse wheel while holding shift doesn't work. unfocuses and loses state when you release the key. 
            if is_hovered != 0 && ctx.input.mouse.scroll_delta.x != 0 {
                ctx.input.mouse.scroll_delta.x = 0;
            };
        };
        ctx.style.edit.padding.y -= ctx.style.edit.scrollbar_size.y;
        
        @debug_assert_ult(state.source.len, state.source.maybe_uninit.len);
        if run_pressed {
            evaluate(state.grid&, state.source.items(), state.errors&, state.lang);
            state.grid_dirty = true;
        };
    };
    nk_end(ctx);
    
    if state.errors.len > 0 {
        if begin(ctx, "Error", output_pos, flags) {
            wrapping_text_row(ctx, state.errors.items());
        };
        nk_end(ctx);
    };
}

Grid :: @struct(cells: []u8, dimensions: Vec3, center_on_zero: bool);

fn evaluate(grid: *Grid, src: Str, errors: *List(u8), lang: Language) void = {
    @run @assert_eq(enable_languages.len(), Language.enum_count(), "enable_languages.len");
    errors.clear();
    if !enable_languages[intcast(@as(i32) lang)] {
        return @fmt(errors, "% was disabled at compile time. choose a different language in the settings menu or edit enable_languages and recompile examples/gpu/cubes.fr", lang);
    };
    vtable :: {  // note that this not being := makes shims so doesn't compile the filtered out ones
        v := @const_slice(@as(AsFnPtr(evaluate_c)) evaluate_c,evaluate_lox,evaluate_lua,evaluate_lil,evaluate_franca,evaluate_kaleidoscope);
        @assert_eq(v.len, enable_languages.len(), "vtable.len");
        range(0, v.len) { i |
            v[i] = @if(!enable_languages[i], zeroed(@type v[0]), v[i]);
        };
        v
    };
    f := vtable[intcast(@as(i32) lang)];
    f(grid, src, errors);
}

fn evaluate_lox(grid: *Grid, src: Str, errors: *List(u8)) void = {
    vm := @ref @zeroed Lox'Vm;
    vm.init();
    vm.print_callback = fn(vm, _, value) = @fmt(Lox.Vm.ptr_from_raw(vm)[].errors&, "%\n", value);
    vm.globals&.insert(vm.copy_string("exit"), Lox.nil_value, vm.gc);
    vm.globals&.insert(vm.copy_string("getc"), Lox.nil_value, vm.gc);

    vm.define_native("mod", fn(vm, a) = {
        @if(a.len != 2, Lox.nil_value, a[0].to_number().int().mod(a[1].to_number().int()).float().to_value())
    });

    src := @tfmt("fun fragment(x, y, z) {%}", src);
    r := vm.interpret(src, true);
    ::ptr_utils(Lox.ObjString);
    callee := vm.globals&.get(vm.copy_string("fragment"));
    @if(r == .Ok && callee.is_none()) @fmt(vm.errors&, "expected a function named 'fragment'");
    if r != .Ok || callee.is_none() {
        errors.push_all(vm.errors.items());
        vm.drop();
        return();
    };
    callee := callee.unwrap();
    
    _ := try(vm) {
        /*ugh*/ {
            it := vm.Lox'allocate_obj(Lox.ObjFunction);
            it.name = "toplevel";
            it := vm.new_closure(it);
            vm.push_frame(it, 0)
        };
        
        iter_grid(grid) { x, y, z, i |
                    vm.push(callee);
                    vm.push(x.float().to_value());
                    vm.push(y.float().to_value());
                    vm.push(z.float().to_value());
                    vm.call_value(vm.peek(3), 3);
                    vm.run();
                    colour := vm.pop();
                    
                    grid.cells[i] = @if(colour.is_number(), colour.to_number().int().trunc(), 255);
        };
    };
    
    errors.push_all(vm.errors.items());
    vm.drop();
}

fn evaluate_lil(grid: *Grid, src: Str, errors: *List(u8)) void = {
    C :: {
        root := Foreign'decker();
        src := import("@/tests/external/decker.fr")'lilt_src(root);
        import("@/examples/import_c/ffi.fr")'include(src)
    };
    
    env := @static_mut zeroed(*C.lv);
    init_once ClearOnAotBake {
       	C'init_interns();
        env[] = C'lmenv(zeroed(*C.lv));
        
        C'dset(env[], lmistr("bits"), C'lmi(C'interface_bits, lmistr("bits"), zeroed(*C.lv)));
    	C'dset(env[], lmistr("pi"), C'lmn(PI));
    	C'dset(env[], lmistr("e" ), C'lmn(2.718281828459045));
        names :: @const_slice(@as(CStr) "white", "yellow", "orange", "red", "magenta", "purple", "blue", "cyan", "green","darkgreen","brown","tan","lightgray","mediumgray","darkgray","black");
        colors := C'lmd();
        enumerate names { i, n |
           	C'dset(colors, lmistr(n[]), C'lmn(i.float() + 1));
        };
    	C'dset(env[], lmistr("colors"), colors);
    };

    program := C'parse(C'lmutf8(bit_cast_unchecked(CStr, *i8, src.as_cstr()))[].sv);
    ::Array(i8, 1024);
    if bit_cast_unchecked(i8, u8, C.par[].error&[0]) != 0 {
        msg := C'drom_to_utf8(C'lmcstr(C.par[].error&.as_ptr()))[].sv;
        msg := bit_cast_unchecked(*i8, CStr, msg);
        @fmt(errors, "%", msg);
        return();
    };
    lmistr :: fn(s: CStr) *C.lv = C'lmistr(bit_cast_unchecked(CStr, *i8, s));
    X, Y, Z := (lmistr("x"), lmistr("y"), lmistr("z"));
    iter_grid(grid) { x, y, z, i |
        C'dset(env[], X, C'lmn(x.float()));
        C'dset(env[], Y, C'lmn(y.float()));
        C'dset(env[], Z, C'lmn(z.float()));
        value := C'run(program, env[]);
        grid.cells[i] = @if(C'linil(value) != 0, 255, C'ln(value).int().trunc());
    };
}

// TODO: `return;` in non void is backend debug error
evaluate_c :: fn(grid: *Grid, src: Str, errors: *List(u8)) void = {
    @if(!src.contains("return")) return(@fmt(errors, "missing return statement"));
    @if(src.contains("#discard_static_scope")) return(@fmt(errors, "dont do that"));  // because it removes from guards list so won't filter the include
    
    // hack since c doesn't allow nested functions. if you want to define your own functions you have to write the entry point yourself too. 
    if !src.contains("fragment(") {
        src = @tfmt("long fragment(long x, long y, long z) {\n%\n;return -1;}", src);
    };
    
    C :: import("@/examples/import_c/lib.fr");
    import_c :: import_module("@/examples/import_c/ffi.fr");
    m := @uninitialized C'Qbe.Module;
    
    C'Qbe'backend'init_module(m&, (arch=query_current_arch(),os=query_current_os(),type=.JitOnly));
    ctx := init_codegen_worker(m&, false);
    
    c := C'Compile.Ctx.zeroed();
    import_c'init_c(c&, m&, ctx);
    c.do_warnings = false;
    
    r := c&.import_c'compile_c("Input", src);
    ctx.C'Qbe'backend'worker_join();
    c.arena_storage&.deinit();
    
    @if_let(r) fn Err(msg) => {
        @fmt(errors, "%", msg);
        drop(m&);
        return();
    };
    
    // TODO: do this properly (whitelist of import symbol names)
    //       (rn is useless because you can just forward declare them yourself)
    math :: "math.h is the only legal include";
    each c.pragma_once& { name, _ | 
        @if(name != "__builtin://math.h") return(@fmt(errors, math));
    };
    @if(c.include_guards.raw.len_including_tombstones != 0) return(@fmt(errors, math));
    // TODO: also disallow asm
    
    @if(is_linking_libc()) C'Qbe'fill_from_libc(m&);
    m&.make_exec();
    callee, _ := m&.get_addr(m&.intern("fragment")) || {
        @fmt(errors, "missing function: long fragment(long x, long y, long z) { ... }");
        drop(m&);
        return();
    };
    callee := bit_cast_unchecked(rawptr, @FnPtr(x: i64, y: i64, z: i64) i64, callee);
    iter_grid(grid) { x, y, z, i |
        grid.cells[i] = callee(x, y, z).trunc();
    };
    
    drop(m&);
}

fn evaluate_lua(grid: *Grid, src: Str, errors: *List(u8)) void = {
    Lua :: import("@/examples/disassemble.fr").Lua;
    L := Lua'luaL_newstate();
    L.open_and_pop("math", Lua'luaopen_math);
    
    src := @tfmt("return (function(x,y,z) % end)", src);
    r := Lua'luaL_loadbufferx(L, bit_cast_unchecked(*u8, *i8, src.ptr), src.len.bitcast(), zeroed(*i8), zeroed(*i8));
    check_error(r);
    check_error :: fn(r) => if r != 0 {
        msg := Lua'lua_tolstring(L, -1, zeroed(*u64));
        @fmt(errors, "% ", bit_cast_unchecked(*i8, CStr, msg));
        return();
    };
    r := Lua'lua_pcall(L, 0, 1, 0);
    check_error(r);
    
    iter_grid(grid) { x, y, z, i |
        Lua'lua_pushvalue(L, -1);
        Lua'lua_pushnumber(L, x.float());
        Lua'lua_pushnumber(L, y.float());
        Lua'lua_pushnumber(L, z.float());
        r := Lua'lua_pcall(L, 3, 1, 0);
        check_error(r);
        value := Lua'lua_tonumberx(L, -1, @ref @as(i32) 0);
        grid.cells[i] = @if(Lua'lua_isnumber(L, -1) == 0, 255, value.int().trunc());
        Lua'lua_pop(L, 1);
    };
    
    Lua'lua_close(L);
}

fn evaluate_franca(grid: *Grid, src: Str, errors: *List(u8)) void = {
    #use("@/lib/sys/jump.fr");
    // bad because not reenterant for multiplexer.fr, but rn its syncronous in one frame so doesn't matter
    jumpbuf :: @static_mut zeroed(JumpBuf);
    message :: @static_mut "";
    throw_panic_hook :: fn(s: Str) Never = {
        message[] = s;
        throw(jumpbuf);
    };

    src = @tfmt("{ fragment :: @as(rawptr) fn(x: i64, y: i64, z: i64) i64 = {\n%\n}; };", src);
    #use("@/examples/jit_loader.fr");
    slot: CachedCompilerEnv = (it = .None);
    reset_jit(slot&);
    
    push_tls_value(.panic_hook, throw_panic_hook) {
        @match(try(jumpbuf)) {
            fn Try() => {
                callee := jit_value(slot&, src, "fragment");
                callee := bit_cast_unchecked(rawptr, @FnPtr() (@FnPtr(i64,i64,i64) i64), callee);
                callee := callee();
                iter_grid(grid) { x, y, z, i |
                    grid.cells[i] = callee(x, y, z).trunc();
                };
            }
            fn Catch() => errors.push_all(message[]);
        };
    };
    destroy_jit(slot&);
}

fn evaluate_kaleidoscope(grid: *Grid, src: Str, errors: *List(u8)) void = {
    #use("@/examples/kaleidoscope.fr");
    Qbe :: import("@/backend/lib.fr").Qbe;
    if !src.contains("def") {
        src = @tfmt("def fragment(x y z)\n%;", src);
    };
      
    m := zeroed Qbe.Module;
    init_default_module(m&, (arch = query_current_arch(), os = query_current_os(), type = .JitOnly, no_data_segment=true));
    c: *Ctx = init(general_allocator(), src, m&);
    c.export_all_symbols = true;
    
    end :: fn(msg: Str) => {
        errors.push_all(msg);
        drop(m&); drop(c);
        return();
    };
    
    @if_let(c.compile_loop()) fn Err(msg) => end(msg);
    c.m.emit_suspended_inlinables();
    c.m.make_exec();
    
    callee, _ := m&.get_addr(m&.intern("fragment")) 
        || end("missing function: def fragment(x y z)");
    callee := bit_cast_unchecked(rawptr, @FnPtr(x: f64, y: f64, z: f64) f64, callee);
    iter_grid(grid) { x, y, z, i |
        grid.cells[i] = callee(x.float(), y.float(), z.float()).int().trunc();
    };
    
    @if(c.top_level.len > 0) @fmt(errors, "% top level expressions will not be run", c.top_level.len);
    end("");
}

fn iter_grid(grid: *Grid, $body: @Fn(x: i64, y: i64, z: i64, i: i64) void) void = {
    X, Y, Z := grid.dimensions();
    x0, y0, z0 := @if(grid.center_on_zero, grid.dimensions.neg().div(2).ints(), (0, 0, 0));
    range(0, X) { x |
        range(0, Y) { y |
            range(0, Z) { z |
                body(x + x0, y + y0, z + z0, x*Y*Z + y*Z + z);
            }; 
        }; 
    };
}

fn dimensions(grid: *Grid) Ty(i64, i64, i64) = grid.dimensions.ints();
fn ints(v: Vec3) Ty(i64, i64, i64) = (v.x.cast().int(), v.y.cast().int(),v.z.cast().int());

fn resize_grid(state: *State, sg: *Sg.Self) void = {
    grid := state.grid&;
    X, Y, Z := grid.dimensions();
    n := X*Y*Z;
    if n > grid.cells.len {
        resize_vertex_buffer(state.draw&, sg, general_allocator(), n*6*6);
        a := general_allocator();
        @if(grid.cells.len != 0) a.dealloc(u8, grid.cells);
        grid.cells = a.alloc_uninit(u8, n);
        grid.cells.set_bytes(0xff);
        // TODO: should do this if the dimensions changed at all since last evaluate
        state.grid_dirty = true;
        evaluate(state.grid&, state.source.items(), state.errors&, state.lang);
    };
}

driver :: fn(vtable: *ImportVTable) void = Easy'build_for_graphics2(vtable, @source_file_name(), true);
main :: fn() void = Easy'start(State);
#use("@/graphics/lib.fr");
Ui :: import("@/graphics/deps/nuklear.fr");

initial_program :: @const_slice(
    "long i = x*16*16 + y*16 + z;\nreturn 1 + i % 3;",
    "var i = x*16*16 + y*16 + z;\nreturn 1 + mod(i, 3);",
    "local i = x*16*16 + y*16 + z;\nreturn 1 + i % 3;",
    "i: (x*16*16) + (y*16) + z\n1 + 3 % i",
    "i := x*16*16 + y*16 + z;\n1 + i.mod(3)",
    "x+y",
);

/*
// put size way up
@if(abs(z) > 3) return(-1);
m :: import("@/examples/mandelbrot.fr")'mandelbrot;
i := m((x=x.float()/20-2,y=y.float()/20-1.5), (x=0,y=0), 40);
@if(i==40, -1, 1 + i.mod(16))
*/

cube_vertices :: @const_slice(
    vec3(0, 1, 0), vec3(1, 1, 0), vec3(1, 0, 0), vec3(0, 0, 0),
    vec3(0, 0, 1), vec3(1, 0, 1), vec3(1, 1, 1), vec3(0, 1, 1),
    vec3(0, 0, 1), vec3(0, 1, 1), vec3(0, 1, 0), vec3(0, 0, 0),
    vec3(1, 0, 1), vec3(1, 0, 0), vec3(1, 1, 0), vec3(1, 1, 1),
    vec3(1, 0, 0), vec3(1, 0, 1), vec3(0, 0, 1), vec3(0, 0, 0),
    vec3(0, 1, 0), vec3(0, 1, 1), vec3(1, 1, 1), vec3(1, 1, 0),
);

block_colours :: {
    // TODO: stop pasting this!
    // 0.0 to 1.0
    hsv2rgb :: fn(H: f64, S: f64, V: f64) Ty(f64, f64, f64) = {
        H *= 360.0;
        f :: fn(n: f64) => {
            k := fmod(n + (H / 60.0), 6.0);
            abs(V - V * S * max(0.0, min(min(k, 4 - k), 1.0)))
        };
        (f(5), f(3), f(1))
    };
    
    ast_alloc().alloc_init(ColourPair, 16, fn(i) => {
        r, g, b := hsv2rgb(i.float() / 16, 1, 1);
        (rgb = vec3(r.cast(), g.cast(), b.cast()), c = pack_rgba(r, g, b, 1))
    })
};

fn on_cleanup(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    sg.destroy_pipeline(state.pipe&);
    state.draw&.destroy(sg, general_allocator());
    on_cleanup(state.ui&, sg);
    state.source&.drop();
    state.errors&.drop();
}

palettes :: @const_slice(
    ("ColourWheel", block_colours),
    ("Decker", repack(@const_slice(0x00FFFFFF,0xFFFF00,0xFF6500,0xDC0000,0xFF0097,0x360097,0x0000CA,0x0097FF,0x00A800,0x006500,0x653600,0x976536,0xB9B9B9,0x868686,0x454545,0x000000))),
    ("Replicube", repack(@const_slice(0x00dfe9f5,0x697594,0x101517,0xf7aaa8,0xd4689a,0x782c96,0xe83562,0xf2825c,0xffc76e,0x88c44d,0x3f9e59,0x373461,0x4854a8,0x7199d9,0x9e5252,0x4d2536))),  // https://lospec.com/palette-list/anb16 with grey swapped around
);

repack :: fn(x: []u32) []ColourPair = {
    ast_alloc().alloc_init(ColourPair, 16, fn(i) => {
        x := x[i];
        r, g, b := (x.shift_right_logical(16).bit_and(255).int(), x.shift_right_logical(8).bit_and(255).int(), x.bit_and(255).int());
        (rgb = vec3(r.float().div(255).cast(), g.float().div(255).cast(), b.float().div(255).cast()), c = pack_rgba(r, g, b, 255))
    })
}
