};

pow :: fn(a: f64, b: f64) f64 #libc;
exp :: fn(a: f64) f64 #libc;
log :: fn(a: f64) f64 #libc;
floor :: fn(a: f64) f64 #libc;
ceil :: fn(a: f64) f64 #libc;
acos :: fn(a: f64) f64 #libc;
asin :: fn(a: f64) f64 #libc;
atan :: fn(a: f64) f64 #libc;
fmod :: fn(a: f64, b: f64) f64 #libc;
round :: fn(round: f64) f64 #libc;

fn update_pos(s: *Script, $body: @Fn(old: Vec2) Vec2) void = {
    old := s.sprite.pos;
    new := body(old);
    stage_size := s.canvas.size;
    new := new.clamp(-stage_size/2 + vec2(0, 1), stage_size/2 - vec2(1, 0));
    s.sprite.pos = new;
    if s.sprite.pen.down {
        Render'pen_line(s.canvas, s.sprite.pen&, old, new);
    };
}

fn coerce_list_index(s: *Script, list: Value, idx: Value) ?Ty(*RawList(Value), i64) #inline = {
    list := list.to_obj()[].list&;
    @if(list.len == 0) return(.None);
    if idx.is_string() {
        idx := idx.to_obj()[].string.s;
        @switch(idx) {
            @case("last") => return(Some = (list, s.canvas.rng&.rand_int(list.len)));
            @case("random") => return(Some = (list, list.len - 1));
            @default => ();
        };
    };
    i := idx.coerce_number().int() - 1;
    @if(i < 0 || i >= list.len) return(.None);
    (Some = (list, i))
}

fn lookup_costume_index(name: Value, s: *Script) i64 = {
    costumes := s.sprite.class.costumes;
    if name.is_number() {
        return name.int().sub(1).mod(costumes.len);
    };
    name := name.coerce_string(s.canvas);
    enumerate costumes { i, it |
        @if(it.name.to_obj()[].string.s == name) return(i);
    };
    0
}

key_indices :: @static {
    out: HashMap(Str, i64) = init(ast_alloc());
    long_keys := @const_slice("space", "up arrow", "down arrow", "right arrow", "left arrow", "any");
    short_keys := "abcdefghijklmnopqrstuvwxyz0123456789";
    enumerate long_keys { i, it |
        out&.insert(it[], i);
    };
    range(0, short_keys.len) { i |
        out&.insert(short_keys.subslice(i, 1), i + long_keys.len);
    };
    out&.insert("_false_", long_keys.len + short_keys.len);
    out.raw
};

fn lookup_key_index(name: Value, s: *Script) i64 = {
    name := name.coerce_string(s.canvas);
    key_indices.get(name) || 42
}

fn lookup_broadcast_index(name: Value, s: *Script) i64 = {
    name := name.coerce_string(s.canvas);
    s.canvas.broadcasts&.get(name) || { 
        @println("warning: invalid broadcast name: (%)", name); 
        -1
    }
}

fn push_async(s: *Script, callee: @FnPtr(s: *Script) void) void = {
    callee := bit_cast_unchecked(@type callee, Value, callee);
    @debug_assert(callee.is_number(), "can't try to gc trace a function pointer");
    s.push_val_async(callee);
}

fn push_val_async(s: *Script, val: Value) void = {
    // compiler calls reserve once per function
    s.futures&.push_assume_capacity(val);
}

fn pop_async(s: *Script, n: i64) void = {
    @debug_assert_ule(n, s.futures.len);
    s.futures.len -= n;
}

// TODO: SpriteClicked needs to send to a specific one
fn send_event(c: *Canvas, event: Trigger) void = {
    // :SLOW should sort by class so don't have to recompare for each clone
    for c.clones { s |
        c.send_event(s, event);
    };
}

fn send_event(c: *Canvas, s: *SpriteInstance, event: Trigger) void = {
    ::AutoEq(Trigger);
        enumerate s.class.events { i, it |
            if it.trigger& == event& {
                continue :: local_return;
                slot := s.scripts[i]&;
                if event&.is(.KeyPress) && slot.futures.len != 0 {
                    continue();  // keys are special for some reason
                };
                
                slot.futures&.clear();
                s: Script = (canvas = c, sprite = s, data = slot);
                s.futures&.reserve(1, c.gpa);
                s&.push_async(it.callee);
            };
        };
}


fn poll_scripts(c: *Canvas) i64 = {
    // TODO: maybe still want to keep a list of active scripts on the canvas
    
    ran := 0;
    range(0, c.clones.len) { i | // can be reallocated in callee (for clone)
        sprite := c.clones[i];
        each sprite.scripts { slot |
            if slot.futures&.pop() { callee |
                s: Script = (canvas = c, sprite = sprite, data = slot);
                // TODO: could keep min,max of all the addresses of the cont function pointers and assert these bits are in that range (in case of compiler bugs). 
                @debug_assert(callee.is_number(), "corrupt callee");
                callee := bit_cast_unchecked(Value, @FnPtr(s: *Script) void, callee);
                callee(s&);
                ran += 1;
            };
        };
        i += 1;
    };
    
    c.maybe_collect_garbage();
    ran
}

Render :: import("@/examples/gpu/hctarcs/soft.fr");
Node :: Builder.Node;
Builder :: import("@/examples/gpu/hctarcs/load.fr");
#use("@/graphics/vec.fr");

fn init_canvas(c: *Canvas, a: Alloc, initialize: @FnPtr(c: *Canvas) void) void = {
    c[] = (
        pen_pixels = a.alloc_init(u32, 480*360, fn(_) => MAX_u32),
        frame_pixels = a.alloc_zeroed(u32, 480*360),
        rng = Random.xoshiro256SS.new_seeded(),
        gpa = a,
        stage = zeroed(*SpriteInstance),
        classes = empty(),
        sensing = (timer_start = timestamp_s()),
    );
    initialize(c);
    c.stage = c.clones[0];
    @debug_assert_eq(c.stage.class.name, "Stage");
    empty_string := c.new_string("");
    for c.clones { it |
        it.looks.say = empty_string;
    };
}

temporary_main :: fn(initialize: @FnPtr(c: *Canvas) void, show: bool) []u8 = {
    ::import("@/examples/gpu/hctarcs/compile.fr").simple_ops;  // infer the impl param types 
    S :: Type.scope_of(impl);
    #use("@/graphics/vec.fr");
    #use("@/lib/sys/fs.fr");
    #use("@/lib/sys/process.fr");
    start := timestamp();
    c := @ref zeroed(Canvas);
    init_canvas(c, temp(), initialize);
    
    c.send_event(.Flag);
    ran := 1;
    while => ran > 0 && timestamp() - start < 1000 {
        ran = c.poll_scripts();
    };
    c.send_event(.SpriteClicked);  // TODO: remove; just to make quicksort benchmark work
    ran := 1;
    while => ran > 0 && timestamp() - start < 2000 {
        ran = c.poll_scripts();
    };
    Render'finish_frame(c);
    
    @println("eval took %ms", timestamp() - start);
    
    out := @ref u8.list(temp());
    @fmt(out, "P6 % % 255\n", 480, 360);
    for c.frame_pixels { c |
        out.push(c.shift_right_logical(16).trunc());
        out.push(c.shift_right_logical(8).trunc());
        out.push(c.trunc());
    };
    drop(c);
    
    dest := "target/a.ppm";
    write_entire_file_or_crash(dest, out.items());
    if show {
        #use("@/lib/sys/subprocess.fr");
        #use("@/lib/sys/process.fr");
        franca := get_executable_path(temp());
        a := make_args_for_exec(franca, @slice("examples/gpu/viewer.fr", "-jit", dest), temp());
        become(a[0], a);
        unreachable();
    };
    out.items()
}

embed_bytes :: fn(in: Str) []u8 = {
    out := u8.list(ast_alloc());
    import("@/lib/encoding/base64.fr")'base64_decode(out&, in);
    out.items()
}

fn init_strings(c: *Canvas, strings: []Str) void = {
    c.constants = c.gpa.alloc_init(Value, strings.len, fn(i) => {
        c.new_obj(string = (s = strings[i].shallow_copy(c.gpa)))
    });
}

fn assign_strings(c: *Canvas, v: []Value, indices: []Ty(u32, u32)) void = {
    for indices { d, s |
        v[d.zext()] = c.constants[s.zext()];
    };
}

// (r,g,b,a)
pack_scratch_rgba :: fn(c: Array(f64, 4)) u32 = {
    f :: fn(x, n) => c&[x].mul(255).int().bit_and(255).shift_left(n);
    trunc(@or(f(0, 16), f(1, 8), f(2, 0), f(3, 24)))
};
unpack_scratch_rgba :: fn(x: u32) Array(f64, 4) = {
    f :: fn(n) => x.shift_right_logical(n).bit_and(255).int().float().div(255);
    (f(16), f(8), f(0), f(24))
};
// TODO: stop pasting this!
// 0.0 to 1.0
hsv2rgb :: fn(H: f64, S: f64, V: f64) Ty(f64, f64, f64) = {
    H *= 360.0;
    f :: fn(n) => {
        k := fmod(n.float() + (H / 60.0), 6.0);
        abs(V - V * S * max(0.0, min(min(k, 4 - k), 1.0)))
    };
    (f(5), f(3), f(1))
};
// https://en.wikipedia.org/wiki/HSL_and_HSV#From_RGB
rgb2hsv :: fn(R: f64, G: f64, B: f64) Ty(f64, f64, f64) = {
    Xmax := R.max(G).max(B);
    Xmin := R.min(G).min(B);
    C := Xmax - Xmin;
    V := Xmax;
    
    H := (60.0 / 360.0) * @if_else {
        @if(C == 0) => 0;
        @if(V == R) => fmod((G - B) / C, 6);
        @if(V == G) => (B - R) / C + 2;
        @if(V == B) => (R - G) / C + 4;
        @else => NaN;
    };
    
    S := @if(V == 0, 0.0, C / V);
    (H, S, V)
};
