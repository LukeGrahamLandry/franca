// these functions are called by the code generated by compile.fr. 

Value :: f64;

Canvas :: @rec @struct {
    size: Vec2 = vec2(480, 360);
    pen_pixels: []u32;
    frame_pixels: []u32;
    rng: Random.Rng;
    // vars that are "For all sprites" are represented as locals in stage. 
    stage: *SpriteInstance;  
    classes: []SpriteClass;
    clones: RawList(*SpriteInstance) = empty();
    gpa: Alloc;
    gc_head: Value = NaN;
    obj_count := 0;
    next_collect_obj_count := 1000;
    constants: []Value = empty();
    sensing: @struct {
        mouse: (@struct(pos := vec2(0), down := false)) = ();
        timer_start: Value;
        pressed := zeroed(StaticBitSet(43));
    };
    broadcasts: RawHashMap(Str, i64) = init();
};

// this is the handle to a running script passed around in the compiled code. only need one at a time. 
Script :: @rec @struct {
    // TODO: if continue accessing fields of sprite more, should have a current_script field that changes and pass the sprite around to save an indirection
    sprite: *SpriteInstance;
    canvas: *Canvas;
    data: *ScriptSlot #use;   // TODO: maybe should just move it from the slots to here to save an indirection. but then have to be careful about not copying it back if cleared to re-call itself. 
};

ScriptSlot :: @struct {
    // async needs to reify (function arguments, loop counters, continuation function pointer). 
    // to make progress the runtime pops the last thing from the stack and calls it as a function pointer. 
    futures: RawList(Value) = empty();
};

// TODO: maybe it would be better to generate MySprite :: @struct(base: SpriteInstance, vars: Array(Value, N)); 
//       (which would be same layout) because then could name var fields so it would be readable. 
SpriteInstance :: @rec @struct {  // !Sized
    class: *SpriteClass;
    // TODO: since you can query your position, might need to store this as f64 in case you do hacky thing like using it as a variable. 
    pos: Vec2 = vec2(0);
    pen: (@struct(down := false, colour: u32 = 0, size: f64 = 1)) = ();
    looks: (@struct(costume := 0, size: f64 = 1, hide := false, say: Value = 0)) = ();
    // each trigger can only have one running at a time so this is parallel to class.events 
    scripts: []ScriptSlot;
    // TODO: direction, say/think/ask, look effects, layer, volume, drag mode
    // vars: Array(Value, self.var_count) #inline; // [vars,lists]; 
};

SpriteClass :: @rec @struct {
    name: Str;
    events: []Handler;
    Handler :: @struct(trigger: Trigger, callee: @FnPtr(s: *Script) void);
    costumes: []Costume;
    Costume :: @struct(data: []u8, name: Value, width: i64, height: i64);
    var_count: i64;  // [vars,lists]
    monitors: []Monitor;
};

Monitor :: @struct {
    var: i64;  // index in vars(SpriteInstance)
    name: Str;
    x: i64; y: i64;  // different coordinate system than sprite.pos
    hide: bool;
    mode: Builder.Monitor.FieldType(.mode);
};

Trigger :: @tagged(
    Broadcast: i64,
    KeyPress: i64,
    SpriteClicked,
    CloneStart,
    Flag, 
    
    // TODO: key pressed, sprite clicked, backdrop switches, loudness>, recieve message
);

// TODO: less bloated layout
Obj :: @struct {
    gc_next: Value;
    gc_mark: bool;  // _: [u8; 7];
    data: (@union(
        // TODO: strings probably have to be utf16
        string: @struct(s: []u8, tag: i64 = -1 /* overlaps the list's len field */),
        list: RawList(Value),
    )) #use;
};

fn new_obj(c: *Canvas, data: FieldType(Obj, .data)) Value = {
    it := c.gpa.boxed(Obj, (gc_next = c.gc_head, gc_mark = false, data = data)).from_obj();
    c.gc_head = it;
    c.obj_count += 1;
    it
}

fn new_string(c: *Canvas, s: []u8) Value = {
    s := s.shallow_copy(c.gpa);  // TODO: don't copy const strings a bunch
    c.new_obj(string = (s = s))
}

fn new_list(c: *Canvas, initial: RawList(Value)) Value = {
    c.new_obj(list = initial)
}

fn slice_list(it: Value) []Value = {
    @debug_assert(it.is_list());
    it.to_obj()[].list.items()
}

fn new_sprite(c: *Canvas, class: *SpriteClass) *SpriteInstance = {
    N := size_of(SpriteInstance) / size_of(Value);
    data := c.gpa.alloc_uninit(Value, N + class.var_count);
    instance := bit_cast_unchecked(*f64, *SpriteInstance, data.ptr);
    instance[] = (class = class, scripts = c.gpa.alloc_zeroed(ScriptSlot, class.events.len));
    instance
}

fn drop(c: *Canvas, it: *SpriteInstance) void = {
    each it.scripts { it |
        it.futures&.drop(c.gpa);
    };
    c.gpa.dealloc(ScriptSlot, it.scripts);
    N := size_of(SpriteInstance) / size_of(Value);
    data := bit_cast_unchecked(*SpriteInstance, *Value, it).slice(N + it.class.var_count);
    c.gpa.dealloc(Value, data);
}

// only indexed by var_index(Compiler, _) so always in bounds
fn index(it: *SpriteInstance, i: i64) *Value = {
    N := size_of(SpriteInstance) / size_of(Value);
    bit_cast_unchecked(*SpriteInstance, *Value, it).offset(i + N)
}

fn vars(it: *SpriteInstance) []Value = it.index(0).slice(it.class.var_count);

// nan tagging (nice explanation: https://craftinginterpreters.com/optimization.html#nan-boxing)
qnan :: @as(i64) 0x7ffc000000000000;
obj_mask :: qnan.bit_or(0x8000000000000000);  
false_bits :: qnan.bit_or(2);
true_bits :: qnan.bit_or(3);

fn is_bool(it: Value) bool = bit_cast_unchecked(Value, i64, it).bit_and(false_bits) == false_bits; // obj pointers are 8 byte aligned so won't have bit 0b10 set
fn is_string(it: *Obj) bool = it.data.string.tag < 0;
fn is_string(it: Value) bool = it.is_object() && it.to_obj().is_string();
fn is_list(it: *Obj) bool = it.data.string.tag >= 0;
fn is_list(it: Value) bool = it.is_object() && it.to_obj().is_list();
fn is_object(it: Value) bool = bit_cast_unchecked(Value, i64, it).bit_and(obj_mask) == obj_mask;
fn is_number(it: Value) bool = bit_cast_unchecked(Value, i64, it).bit_and(qnan) != qnan;

fn to_obj(it: Value) *Obj = {
    @debug_assert(it.is_object(), "not an object");
    it := bit_cast_unchecked(Value, i64, it);
    it := it.bit_and(bit_not(obj_mask));
    bit_cast_unchecked(i64, *Obj, it)
};
fn from_obj(it: *Obj) Value = {
    it := bit_cast_unchecked(*Obj, i64, it);
    it := it.bit_or(obj_mask);
    bit_cast_unchecked(i64, Value, it)
};

// TODO: comparison isn't this simple because "a">50 = true
fn coerce_number(it: Value) f64 = {
    @if(it.is_number()) return(it);
    @if(it.is_bool()) return(it.to_bool().int().float());
    if it.is_string() { 
        it := it.to_obj();
        n, s := parse_float(it.string.s);
        // TODO: i think its supposed to ignore whitespace
        @if(s.len == 0) return(n);
    };
    0
}

fn coerce_string(it: Value, c: *Canvas, out: *List(u8)) void = {
    @if(it.is_string()) return(@fmt(out, "%", it.to_obj()[].string.s));
    @if(it.is_number()) return(@fmt(out, "%", it));
    @if(it.is_bool()) return(@fmt(out, "%", it.to_bool()));
    @assert(it.is_list(), "TODO: coerce_string new object type");
    // TODO: lists are only reachable for monitors so maybe don't have this in the normal coerce_string

    it := it.to_obj()[].list;
    for it { it |
        coerce_string(it, c, out);
        @fmt(out, " ");
    };
    out.len -= int(it.len > 0);
}

fn coerce_string(it: Value, c: *Canvas) Str = {
    @if(it.is_string()) return(it.to_obj()[].string.s);
    @if(it.is_bool()) return(@if(it.to_bool(), "true", "false"));
    
    out := u8.list(temp());
    coerce_string(it, c, out&);
    out&.items()
}

fn to_bool(a: Value) bool = {
    @if(a.is_bool()) return(bit_cast_unchecked(f64, i64, a) - false_bits == 1);
    // TODO: actually you can't put round blocks in bool inputs so maybe this isn't needed (the inverse is tho)
    @if(a.is_number()) return(a == 1);
    @if(a.is_string()) return(a.to_obj()[].string.s == "true");
    false
};
fn from_bool(a: bool) Value = bit_cast_unchecked(i64, f64, false_bits + a.int());

fn maybe_collect_garbage(c: *Canvas) void = {
    if c.obj_count > c.next_collect_obj_count {
        c.collect_garbage();
        c.next_collect_obj_count = c.obj_count * 2;
    }
}

// sync functions/expressions will use locals so this can't be called while inside one. 
// im sure there are faster ways to do gc but this one is nice and simple for now. 
fn collect_garbage(c: *Canvas) void = {
    visit :: fn(it: Value) void = if it.is_object() {
        it := it.to_obj();
        if !it.gc_mark {
            it.gc_mark = true;
            @if(it.is_list()) for(it.list, visit);
        };
    };
    for c.clones { it |
        visit(it.looks.say);
        for(it.vars(), visit);
        for it.scripts { it |
            for(it.futures, visit);
        };
    };
    
    for(c.constants, visit);  // TODO: this is wasteful, could just not put them in the gc_head list
    
    next := c.gc_head&;
    while => next[].is_object() {
        it := next[].to_obj();
        if it.gc_mark {
            it.gc_mark = false;
            next = it.gc_next&;
        } else {
            next[] = it.gc_next;
            @if(it.is_list()) it.list&.drop(c.gpa);
            @if(it.is_string()) c.gpa.dealloc(u8, it.string.s);
            c.gpa.dealloc_one(Obj, it);
            c.obj_count -= 1;
        };
    };
}

fn drop(c: *Canvas) void = {
    for c.clones { it |
        drop(c, it);
    };
    drop(c.clones&, c.gpa);
    c.gpa.dealloc(Value, c.constants);
    c.constants = empty();
    c.collect_garbage();
    @assert(c.gc_head.is_number(), "leaked gc objects");
    c.gpa.dealloc(u32, c.pen_pixels);
    c.gpa.dealloc(u32, c.frame_pixels);
    each c.classes { it |
        c.gpa.dealloc(SpriteClass.Costume, it.costumes);
        c.gpa.dealloc(SpriteClass.Handler, it.events);
    };
    c.gpa.dealloc(SpriteClass, c.classes);
    c.broadcasts&.drop(c.gpa);
}

impl :: @struct {

operator_add :: fn(a, b) = a + b;
operator_subtract :: fn(a, b) = a - b;
operator_multiply :: fn(a, b) = a * b;
operator_divide :: fn(a, b) = a / b;
operator_lt :: fn(a, b) #inline = {
    from_bool(a < b)
    //@if(a.is_number()) return(from_bool(a == b /* .coerce_number() */));
    //@if(a.is_string() && a.to_obj()[].string.s == "") return(true.from_bool());
    //false.from_bool()  // TODO
}
operator_gt :: fn(a, b) = from_bool(a > b);
operator_equals :: fn(s, a, b) = {
    @if(a.is_number() && b.is_number()) return(from_bool(a == b));
    from_bool(a.coerce_string(s.canvas) == b.coerce_string(s.canvas))
}
operator_not :: fn(a) = from_bool(!a.to_bool());
operator_random :: fn(s, lo, hi) = (hi - lo)*s.canvas.rng&.rand_float() + lo;
operator_mathop_sqrt :: fn(a) = sqrt(a);
operator_mathop_e_pow :: fn(a) = exp(a);
operator_mathop_10_pow :: fn(a) = pow(10, a);
operator_mathop_ln :: fn(a) = log(a);
operator_mathop_floor :: fn(a) = floor(a);
operator_mathop_tan :: fn(a) = { s, c := sin_cos(a.deg_to_rad()); s/c };
operator_mathop_ceiling :: fn(a) = ceil(a);
operator_mathop_abs :: fn(a) = abs(a);
operator_mathop_acos :: fn(a) = acos(a).rad_to_deg();
operator_mathop_asin :: fn(a) = asin(a).rad_to_deg();
operator_mathop_atan :: fn(a) = atan(a).rad_to_deg();
operator_mathop_sin :: fn(a) = sin(a.deg_to_rad());
operator_mathop_cos :: fn(a) = cos(a.deg_to_rad());
operator_mathop_log :: fn(a) = log(a) / @run(log(10));
operator_mod :: fn(a, b) = fmod(a, b);

motion_xposition :: fn(s) = s.sprite.pos.x.cast();
motion_yposition :: fn(s) = s.sprite.pos.y.cast();
motion_gotoxy :: fn(s, x, y) void = s.update_pos(fn(_) => vec2(x.cast(), y.cast()));
motion_changexby :: fn(s, dx) void = s.update_pos(fn(old) => { old.x += dx.cast(); old });
motion_changeyby :: fn(s, dy) void = s.update_pos(fn(old) => { old.y += dy.cast(); old });
motion_setx :: fn(s, x) void = s.update_pos(fn(old) => { old.x = x.cast(); old });
motion_sety :: fn(s, y) void = s.update_pos(fn(old) => { old.y = y.cast(); old });

// AARRGGBB
pen_setPenColorToColor :: fn(s, a) void = { 
    if a.is_string() {
        string := a.to_obj()[].string.s;
        if string.starts_with("#") {  // TODO: const fold
            n, r := convert_number(string.rest(1), 16, hex_digit);
            if r.len == 0 {
                a = n.float();
            };
        };
    };
    s.sprite.pen.colour = a.coerce_number().int().trunc(); 
};

pen_setPenColorParamTo :: fn(s, param, value) void = {
    value := value.coerce_number().clamp(0, 100) / 100;
    rgb := unpack_scratch_rgba(s.sprite.pen.colour);
    H, S, V := rgb2hsv(rgb&[0], rgb&[1], rgb&[2]);
    hsv: Array(f64, 4) = (H, S, V, rgb&[3]);
    dest := @switch(param.coerce_string(s.canvas)) {
        @case("color") => hsv&[0]&;
        @case("saturation") => hsv&[1]&;
        @case("brightness") => hsv&[2]&;
        @case("transparency") => hsv&[3]&;  // TODO: wasteful to do all the conversion in this case
        @default => return();
    };
    dest[] = value;
    r, g, b := hsv2rgb(hsv&[0], hsv&[1], hsv&[2]); 
    s.sprite.pen.colour = pack_scratch_rgba(r, g, b, hsv&[3]);
}

pen_changePenColorParamBy :: fn(s, name, value) void = {
    @println("TODO: pen_changePenColorParamBy % %", name, value);
}

pen_setPenSizeTo :: fn(s, a) void = { s.sprite.pen.size = a; };
pen_penUp :: fn(s) void = { s.sprite.pen.down = false; };
pen_penDown :: fn(s) void = { 
    s.sprite.pen.down = true; 
    Render'pen_line(s.canvas, s.sprite.pen&, s.sprite.pos, s.sprite.pos);
};
pen_clear :: fn(s) void = Render'pen_clear(s.canvas);
// pos is clamped to the canvas but it's the center of the image so it can still go half way off the screen.
pen_stamp :: fn(s) void = {
    c := s.sprite.class.costumes[s.sprite.looks.costume]&;
    Render'pen_stamp(s.canvas, c, s.sprite.pos);
}
// TODO: use this
looks_setsizeto :: fn(s, percent) void = { s.sprite.looks.size = percent / 100; }
// in scratch input is a name. here compiler inserts lookup_costume_index calls so they can (eventually) be folded. 
looks_switchcostumeto :: fn(s, idx: i64) void = {
    s.sprite.looks.costume = idx;
}
looks_nextcostume :: fn(s) void = {
    s.sprite.looks.costume = mod(s.sprite.looks.costume + 1, s.sprite.class.costumes.len);
}
looks_hide :: fn(s) void = { s.sprite.looks.hide = true; };
looks_show :: fn(s) void = { s.sprite.looks.hide = false; };
looks_say :: fn(s, msg) void = { s.sprite.looks.say = msg; };

looks_cleargraphiceffects :: fn(s) void = println("looks_cleargraphiceffects");
looks_switchbackdropto :: fn(s, idx) void = @println("TODO: looks_switchbackdropto %", idx);
sensing_touchingobject :: fn(_) = { println("sensing_touchingobject"); false.from_bool() };
sensing_keypressed :: fn(s, idx: i64) = s.canvas.sensing.pressed&.get(idx).from_bool();
control_wait :: fn(s, t) void = @println("TODO: wait %", t);
motion_ifonedgebounce :: fn(s) void = println("TODO: motion_ifonedgebounce");
looks_gotofrontback :: fn(s, _) void = println("TODO: looks_gotofrontback");
looks_changeeffectby :: fn(s, d, e) void = println("TODO: looks_changeeffectby");
motion_pointindirection :: fn(s, d) void = @println("TODO: motion_pointindirection %", d);
motion_movesteps :: fn(s, steps) void = @println("TODO: motion_movesteps %", steps);
control_delete_this_clone :: fn(s) void = println("TODO: control_delete_this_clone");  // TODO: also have to also return all the way up somehow?
control_create_clone_of :: fn(s, _) void = println("TODO: control_create_clone_of");
motion_glidesecstoxy :: fn(s, t, x, y) void = println("TODO: motion_glidesecstoxy");
data_deletealloflist :: fn(s, list) void = list.to_obj()[].list&.clear();
data_lengthoflist :: fn(s, list) = list.to_obj()[].list.len.float();
data_addtolist :: fn(s, item, list) void = {
    list.to_obj()[].list&.push(item, s.canvas.gpa);
}
data_itemoflist :: fn(s, idx, lst) = {
    list, i := s.coerce_list_index(lst, idx) 
        || return(-1.0/0.0);  // TODO: return(s.canvas.new_string(""));
    list[i]
}
data_replaceitemoflist :: fn(s, idx, item, lst) void = { 
    list, i := s.coerce_list_index(lst, idx) || return();
    list[i] = item;
}
data_deleteoflist :: fn(s, idx, lst) void = {
    list, i := s.coerce_list_index(lst, idx) || return();
    _ := list.ordered_remove(i);
}
data_itemnumoflist :: fn(s, item, list) = {
    list := list.to_obj()[].list&;
    float(list.index_of(fn(check) => s.operator_equals(check[], item).to_bool()) || -1) + 1
}
// TODO: can you insert one past the end?
data_insertatlist :: fn(s, item, idx, lst) void = {
    list, i := s.coerce_list_index(lst, idx) || return();
    list.insert(i, item, s.canvas.gpa);
}
data_listcontainsitem :: fn(s, item, list) = data_itemnumoflist(s, item, list).ne(0).from_bool();
operator_contains :: fn(s, a, b) = { println("TODO: operator_contains"); false.from_bool() }
operator_length :: fn(s, string) = string.coerce_string(s.canvas).len().float();
operator_letter_of :: fn(s, i, string) = { 
    string := string.coerce_string(s.canvas);
    i := i.coerce_number().int() - 1;
    r := @if(i.ult(string.len), string.subslice(i, 1), "");
    // TODO: could cache a string for each ascii character
    s.canvas.new_string(r)
}
operator_join :: fn(s, a, b) = {
    out := u8.list(s.canvas.gpa);
    if a.is_string() && b.is_string() {
        out&.reserve(a.to_obj()[].string.s.len + b.to_obj()[].string.s.len)
    };
    coerce_string(a, s.canvas, out&);
    coerce_string(b, s.canvas, out&);
    s.canvas.new_obj(string = (s = out&.shrink_to_fit()))
}
