// [api for building ast, ast -> sb3, sb3 -> ast]

Project :: @struct {
    sprites: RawList(*Sprite);
};
Sprite :: @struct {
    name: Str;
    blocks: RawList(*Node);
    variables: RawList(*Node);
    costumes: RawList(Costume);
    var_plus_param_count := 0;
};
Node :: @rec @struct {
    op: Raw.Opcode;
    // order here is based on order in block_defs's inputs/fields. 
    // franca_block <-> linked list in "next" field. 
    // procedures_prototype <-> mutation.argumentids
    args: []*Node;
    literal: f64 = 0;  // float for franca_literal. index for franca_var. 
    string: Str = "";  // franca_string. TODO: nan tag this too? sad to make all the nodes bigger. but then need to write a new bake_relocatable_value
};
Costume :: @struct {
    name: Str;
    fmt: Str;
    data: []u8;
    md5 := "";
};

// //
// tests.fr has examples. 
// these builder functions all use ast_alloc (so can only run at comptime). 
// the idea is just using franca as a text language for writing scratch projects. 
// not for writing programs that work with the asts. 

fn new_project() Ty(*Project, *Sprite) = {
    p := ast_alloc().boxed(Project, (
        sprites = empty(),
    ));
    s := p.sprite(name = "Stage");
    (p, s)
}

fn sprite(p: *Project, args: @struct(name: Str)) *Sprite = {
    s := ast_alloc().boxed(Sprite, (
        blocks = empty(),
        variables = empty(),
        costumes = empty(),
        name = args.name,
    ));
    p.sprites&.push(s, ast_alloc());
    s
}

fn costume(s: *Sprite, args: Costume) *Node = {
    s.costumes&.push(args, ast_alloc());
    N(args.name)
}

fn define(s: *Sprite, warp: bool, $body: FuncId) *Node = {
    func :: get_function_ast(body, false, false, false, false);
    b := @if(@run func.arg.bindings[0].name&.is(.None), {
        make("procedures_definition", @slice(block(body), make("procedures_prototype", empty())))
    }, {
        @run {
            if func.body.Normal.ty != void {
                func.body.Normal = @{ (@slice(@[func.body.Normal])).shallow_copy(ast_alloc()) };
            };
            each func.arg.bindings { it |
                it.ty = (Finished = *Node);
            };
        };
        
        t := s.variables(@run func.arg.bindings.len);
        vars := bit_cast_unchecked(@type t, Array(*Node, size_of(@type t) / size_of(*Node)), t);
        vars := vars&.items().shallow_copy(ast_alloc());
        s.variables.len -= vars.len;
        each vars { it |
            it.op = .argument_reporter_string_number;
        };
        body := body(t);
        body := make("franca_block", body);
        make("procedures_definition", @slice(body, make("procedures_prototype", vars)))
    });
    b.literal = next_var_id[].float();
    next_var_id[] += 1;
    s.blocks&.push(b, ast_alloc());
    b
}

fn whenflagclicked(s: *Sprite, $body: FuncId) *Node = {
    b := make("event_whenflagclicked", @slice(block(body)));
    s.blocks&.push(b, ast_alloc());
    b
}

fn call(func: *Node, $args: FuncId) *Node #where = {
    make("procedures_call", @slice(func, block(args)))
}

fn set(var: *Node, value: *Node) *Node = make("data_setvariableto", @slice(value, var));

fn repeatuntil(cond: *Node, $body: FuncId) *Node = make("control_repeat_until", @slice(cond, block(body)));
fn repeat(count: *Node, $body: FuncId) *Node = make("control_repeat", @slice(count, block(body)));
fn if(cond: *Node, $then: FuncId, $else: FuncId) *Node = make("control_if_else", @slice(cond, block(then), block(else)));

fn peneraseall() *Node = make("pen_clear", empty());
fn penup() *Node = make("pen_penUp", empty());
fn pendown() *Node = make("pen_penDown", empty());
fn setpencolor(a: *Node) = make("pen_setPenColorToColor", @slice(a));
fn pen_stamp() *Node = make("pen_stamp", empty());
fn set_costume(a: *Node) *Node = {
    // TODO: do i ever need this? a := make("looks_costume", @slice(a));
    make("looks_switchcostumeto", @slice(a))
}
fn set_size(percent: *Node) *Node = make("looks_setsizeto", @slice(percent));

fn gotoxy(x: *Node, y: *Node) *Node = make("motion_gotoxy", @slice(x, y));
fn xposition() *Node = make("motion_xposition", empty());
fn yposition() *Node = make("motion_yposition", empty());
fn change_x(d: *Node) *Node = make("motion_changexby", @slice(d));
fn change_y(d: *Node) *Node = make("motion_changeyby", @slice(d));

fn N(a: i64) *Node = N(a.float());
fn N(a: f64) *Node = { s := make("franca_literal", empty()); s.literal = a; s }
fn N(a: Str) *Node = { s := make("franca_string", empty()); s.string = a; s }
fn add(a: *Node, b: *Node) *Node = make("operator_add", @slice(a, b));
fn sub(a: *Node, b: *Node) *Node = make("operator_subtract", @slice(a, b));
fn mul(a: *Node, b: *Node) *Node = make("operator_multiply", @slice(a, b));
fn div(a: *Node, b: *Node) *Node = make("operator_divide", @slice(a, b));
fn lt(a: *Node, b: *Node) *Node = make("operator_lt", @slice(a, b));
fn gt(a: *Node, b: *Node) *Node = make("operator_gt", @slice(a, b));
fn eq(a: *Node, b: *Node) *Node = make("operator_equals", @slice(a, b));
fn or(a: *Node, b: *Node) *Node = make("operator_or", @slice(a, b));
fn and(a: *Node, b: *Node) *Node = make("operator_and", @slice(a, b));
fn not(a: *Node) *Node = make("operator_not", @slice(a));

fn make(op: Str, args: []*Node) *Node = {
    op := Raw.Opcode.from_name(op) || @panic("invalid op %", op);
    ast_alloc().boxed(Node, (op = op, args = args.shallow_copy(ast_alloc())))
}

fn block($fid: FuncId) *Node = {
    @run {
        func := get_function_ast(fid, true, false, false, false);
        if func.body.Normal.ty != void {
            func.body.Normal = @{ (@slice(@[func.body.Normal])).shallow_copy(ast_alloc()) };
        };
    };
    args := fid(); 
    @if(@run(void == @type args), make("franca_block", empty()), make("franca_block", args))
}

next_var_id :: @static_mut 1;  // not the same as the one used when loading sb3 (there it resets per sprite)
fn variables(s: *Sprite, $Count: i64) TupleArray(*Node, Count) #generic = {
    s.var_plus_param_count += Count;
    out := zeroed(Array(*Node, Count));
    each out& { it |
        it[] = ast_alloc().boxed(Node, (op = .franca_var, args = empty(), literal = next_var_id[].float()));
        next_var_id[] += 1;
        s.variables&.push(it[], ast_alloc());
    };
    bit_cast_unchecked(@type out, TupleArray(*Node, Count), out)
}

fn TupleArray($T: Type, $N: i64) Type = Ty(ast_alloc().alloc_init(Type, N, fn(_) => T));

// //
// above is the user api for building a project from franca code. 
// below serializes it to a .sb3 file that the scratch editor can import. 
//

// TODO: set block positions so they're not all overlapping in the ui
// TODO: readable var names
fn build(p: *Project, out_json: *List(u8), out_zip: *List(u8)) void = {
    @debug_assert_eq(p.sprites[0].name, "Stage", "first sprite");
    ::X;
    a := temp();
    p2: Raw.Project = (
        targets = list(a),
        monitors = list(a),
        extensions = list(a),
        meta = (semver = "3.0.0", vm = "15.0.1", agent = ""),
    );
    // TODO: "extensions": ["pen"],
    
    files := @ref Zip.File.list(temp());
    each p.sprites { s |
        p2.targets&.push(
            isStage = s.name == "Stage",  // this name is required by the real scratch
            name = s.name,
            variables = init(),
            //lists: RawHashMap(Str, Ty(Str, List(Value)));
            broadcasts = init(),
            blocks = init(),
            currentCostume = 0,
            costumes = list(a),
            sounds = list(a),
        );
        target := p2.targets[p2.targets.len - 1]&;
        for s.variables { it |
            name := @tfmt("var_%", it.literal);
            target.variables&.insert(name, (name, (Float = 0)), temp());
        };
        for s.blocks { it |
            key := emit_block(it, target.blocks&);
            target.blocks&.get_ptr(key).unwrap()[].Block.topLevel = true;
        };
        each target.blocks& { key, it |
            @if_let(it) fn Block(it) => @debug_assert(!it.opcode.name_str().starts_with("franca_"), "unlowered % %", it.opcode, key);
        };
        each s.costumes { it |
            if it.md5 == "" {
                it.md5 = import("@/lib/mix/md5.fr")'hex(it.data);
            };
            md5 := it.md5;
            path := @tfmt("%.%", md5, it.fmt);
            if !files.contains(fn(it) => it.name == path) {
                files.push(name = path, data = it.data);
            };
            target.costumes&.push(
                name = it.name,
                dataFormat = it.fmt,
                assetId = md5,
                md5ext = path,
                //bitmapResolution
            );
        };
    };

    dump_json(p2&, out_json);
    files.push(name = "project.json", data = out_json.items());
    Zip'write(out_zip, files.items());
}
Zip :: import("@/lib/encoding/pkzip.fr");

fn emit_block(it: *Node, parent: Str, blocks: *RawHashMap(Str, Raw.Block2)) Str = {
    child := emit_block(it, blocks);
    blocks.get_ptr(parent).unwrap()[].Block.next = (Some = child);
    blocks.get_ptr(child).unwrap()[].Block.parent = (Some = parent);
    child
}

fn emit_block(it: *Node, blocks: *RawHashMap(Str, Raw.Block2)) Str = {
    if it.op == .franca_block {
        // TODO: what about empty blocks? (if has two versions _else)
        first := emit_block(it.args[0], blocks);
        parent := first;
        for it.args.rest(1) { it |
            child := emit_block(it, parent, blocks);
            parent = child;
        };
        return first;
    };
    
    key := @tfmt("s%", blocks.len_including_tombstones);
    if @is(it.op, .franca_var) {
        key = @tfmt("var_%", it.args[0].literal);
    };
    blocks.insert(key, zeroed(Raw.Block2), temp());
    
    b: Raw.Block = (opcode = it.op);
    arg_i := 0;
    shape := block_defs.shapes.get(it.op).unwrap();
    for shape.inputs { field |
        value: Raw.ValueRef = @if_else {
            @if(field.starts_with("SUBSTACK")) => (BlockStack = emit_block(it.args[arg_i], key, blocks));
            @else => emit_value(it.args[arg_i], key, blocks);
        };
        b.inputs&.insert(field, value, temp());
        arg_i += 1;
    };
    for shape.fields { field |
        name := @tfmt("var_%", it.args[arg_i].literal);
        b.fields&.insert(field, (name, (Some = name)), temp());
        arg_i += 1;
    };
    if it.op == .argument_reporter_string_number {
        name := @tfmt("var_%", it.literal);
        b.fields&.insert("VALUE", (name, .None), temp());
    };
    
    @match(it.op) {
        fn procedures_call() => {
            def, args := (it.args[0], it.args[1]);
            b.mutation = (Some = make_mutation(def));
            @debug_assert_eq(def.args[1].args.len, args.args.len, "arity mismatch");
            enumerate args.args { i, arg |
                name := @tfmt("var_%", def.args[1].args[i].literal);
                b.inputs&.insert(name, emit_value(arg[], key, blocks), temp());
            };
        }
        fn procedures_definition() => {
            child := @tfmt("s%", blocks.len_including_tombstones);
            blocks.insert(child, zeroed(Raw.Block2), temp());
            c: Raw.Block = (
                opcode = .procedures_prototype, 
                parent = (Some = key),
                mutation = (Some = make_mutation(it)),
            );
            blocks.insert(child, (Block = c), temp());
            
            b.inputs&.insert("custom_block", (BlockStack = child), temp());
            b.next = (Some = emit_block(it.args[0], key, blocks));
        }
        fn event_whenflagclicked() => {
            b.next = (Some = emit_block(it.args[0], key, blocks));
        }
        @default => ();
    };
    blocks.insert(key, (Block = b), temp());
    key
}

make_mutation :: fn(it: *Node) Raw.Mutation = {
    @debug_assert_eq(it.op, .procedures_definition);
    @debug_assert_eq(it.args[1].op, .procedures_prototype);
    ids, names, proccode := (Str.list(temp()), Str.list(temp()), u8.list(temp()));
    @fmt(proccode&, "var_%", it.literal);
    for it.args[1].args { it |
        ids&.push(@tfmt("var_%", it.literal));
        names&.push(@tfmt("var_%", it.literal));
        @fmt(proccode&, " \%s");  // TODO: bool
    };
    
    (
        proccode = proccode.items(),
        argumentids = ids,
        argumentnames = (Some = names),  // these matter! leaving it empty makes the reporters always be zero (and show "undefined")
        argumentdefaults = (Some = list(temp())),
        warp = true,
    )
}

emit_value :: fn(it: *Node, parent: Str, blocks: *RawHashMap(Str, Raw.Block2)) Raw.ValueRef = {
    @debug_assert(!@is(it.op, .procedures_definition), "invalid emit_value %", it.op);    
    @match(it.op) {
        fn franca_var() => (Var = @tfmt("var_%", it.literal));
        // TODO: lossy because im bad at printing floats
        fn franca_literal() => (String = @tfmt("%", it.literal));
        fn franca_string() => (String = it.string);
        @default => {
            key := emit_block(it, blocks);
            blocks.get_ptr(key).unwrap()[].Block.parent = (Some = parent);
            (BlockValue = key)
        };
    }
}

// //
// below is deserializing sb3 back into Node ast. 

// result is in temp(), its fine for it to point into the original sb3 bytes. 
fn unbuild(sb3: []u8) Result(*Project, Str) = {
    ecd := Zip'find(sb3) || return(Err = "expected zip file");
    files: HashMap(Str, []u8) = init(temp());
    Zip'iter(sb3, ecd) { it |
        files&.insert(it.name, it&.data(temp()));
    };
    project := files&.get("project.json") || return(Err = "missing project.json");
    ::X;
    p := @try(parse_json(Raw.Project, project, temp())) return;
    project := zeroed(Project);
    
    stage := p.targets&.find(fn(it) => it.isStage)
        || return(Err = "missing Stage");
    
    each p.targets { s |
        // TODO: im assuming block,var,param will all be unique which isn't true
        blocks: HashMap(Str, *Node) = init(temp());
        sprite := zeroed(Sprite);
        sprite.name = s.name;
        
        next_var_id := 1.0;
        @if(!s.isStage)
        each stage.variables& { key, it |
            it := temp().boxed(Node, (op = .franca_var_stage, args = empty(), literal = next_var_id, string = it._0));
            next_var_id += 1;
            prev := blocks&.insert(key, it);
            @if(prev.is_some()) return(Err = @tfmt("duplicate block id (%)", key));
        };
        @if(s.isStage && !identical(s, stage)) return(Err = "multiple stages");
        // TODO: make sure sprite names are unique too
        
        next_var_id := 1.0;   // reset
        each s.variables& { key, it |
            it := temp().boxed(Node, (op = .franca_var, args = empty(), literal = next_var_id, string = it._0));
            next_var_id += 1;
            prev := blocks&.insert(key, it);
            @if(prev.is_some()) return(Err = @tfmt("duplicate block id (%)", key));
            sprite.variables&.push(it, temp());
        };
        
        retain(s.blocks&, fn(_, b) => b.is(.Block));
        each s.blocks& { key, it |
            b := it.Block&;
            
            it := temp().boxed(Node, (op = b.opcode, args = empty()));
            prev := blocks&.insert(key, it);
            @if(prev.is_some()) return(Err = @tfmt("duplicate block id (%)", key));
            if b.topLevel {
                sprite.blocks&.push(it, temp());
            };
            
            // error early so later code doesn't have to bother with nice message
            if b.parent { id | _ := s.get_block(id) || return(Err = @tfmt("(%): parent missing (%)", key, id)); };
            if b.next { id | _ := s.get_block(id) || return(Err = @tfmt("(%): next missing (%)", key, id)); };
            if @is(b.opcode, .procedures_call, .procedures_prototype) {
                _ := b.mutation 
                    || return(Err = @tfmt("(%): % missing mutation", key, b.opcode));
            };
            
            if b.opcode == .procedures_definition {
                prototype := b.inputs&.get("custom_block") 
                    || return(Err = @tfmt("(%): %.custom_block is missing", key, b.opcode));
                id := prototype&.block_id() 
                    || return(Err = @tfmt("(%): %.custom_block is not a block", key, b.opcode));
                    b := s.get_block(id)
                            || return(Err = @tfmt("(%): missing (%)", key, id));
                        mutation := b.mutation 
                            || return(Err = @tfmt("(%): % missing mutation", key, b.opcode));
                        prev := blocks&.insert(mutation.proccode, it);
                        @if(prev.is_some()) return(Err = @tfmt("duplicate block id (%)", mutation.proccode));
                        a := list(*Node, temp());
                        for mutation.argumentids { name |
                            it := temp().boxed(Node, (op = .argument_reporter_string_number, args = empty(), literal = next_var_id));
                            next_var_id += 1;
                            prev := blocks&.insert(name, it);
                            @if(prev.is_some()) return(Err = @tfmt("duplicate block id (%)", name));
                            a&.push(it);
                        };
                        it.args = a.items();
                        it.string = mutation.proccode;
            };
        };
        sprite.var_plus_param_count = int(next_var_id - 1);
        
        each s.blocks& { key, it |
            b := it.Block&;
                shape := block_defs.shapes.get(b.opcode).unwrap();
                it := blocks&.get(key).unwrap();
                
                args := list(*Node, temp());
                for shape.inputs { field |
                    value := b.inputs&.get_ptr(field) 
                        || return(Err = @tfmt("(%): %.% is missing", key, b.opcode, field));
                    
                    a := @try(decode_value(value, s, blocks&, (key, it.op, field))) return;
                    args&.push(a);
                };
                for shape.fields { field |
                    var := b.fields&.get(field) 
                        || return(Err = @tfmt("% (%) missing %", b.opcode, key, field));
                    name := var._1 || var._0;
                    if field == "OPERATOR" || field == "STOP_OPTION" {
                        a := temp().boxed(Node, (op = .franca_string, args = empty(), string = name));
                        args&.push(a);
                    } else {
                        a := blocks&.get(name)
                            || return(Err = @tfmt("(%): %.% missing (%)", key, it.op, field, name));
                        if field == "VARIABLE" {
                            @if(!@is(a.op, .franca_var, .franca_var_stage)) return(Err = @tfmt("(%): %.VARIABLE (%) found %", key, it.op, name, a.op));
                        };
                        args&.push(a);
                    };
                };
                if b.opcode == .argument_reporter_string_number {
                    var := b.fields&.get("VALUE") 
                            || return(Err = @tfmt("(%): %.VALUE is missing", key, b.opcode));
                    // these are referenced by name but i want the id. 
                    name := var._0;
                    mutation := @try(find_parent_prototype(s, blocks&, key)) return;
                    argumentnames := mutation.argumentnames || return(Err = "missing argumentnames");
                    i := argumentnames.items().index_of(name)
                        || return(Err = @tfmt("(%): invalid argument name (%)", key, name));
                    @if(argumentnames.len != mutation.argumentids.len) return(Err = "mutation names/ids arity mismatch");
                    id := mutation.argumentids[i];
                    a := blocks&.get(id)
                        || return(Err = @tfmt("(%): %.% missing (%)", key, it.op, "VALUE", id));
                    it.literal = a.literal;
                    it.string = name;
                    a.string = name;  // TODO: this should go in the other place
                };
                if @is(b.opcode, .event_whenflagclicked, .procedures_definition) {
                    if s.get_block(key) { b |
                        n := @try(collect_block(s, blocks&, b.next)) return;
                        args&.push(n);
                    };
                };
                
                if @is(b.opcode, .procedures_definition) {
                    if args[0].op == .franca_block && args[0].args[0].op == .procedures_prototype {
                        args[0] = args[0].args[0];  // TODO: get rid of BlockStack cause this is stupid
                    };
                    @if(args[0].op != .procedures_prototype) return(Err = @tfmt("(%): missing prototype !!", key));
                    args[0] = temp().boxed(Node, (op = .procedures_prototype, args = it.args));
                    args&.items().swap(0, 1);
                };
                
                if b.opcode == .procedures_call {
                    mutation := b.mutation&.unwrap();
                    it.string = mutation.proccode;
                    def := blocks&.get(mutation.proccode) 
                        || return(Err = @tfmt("(%): % undefined proccode (%)", key, b.opcode, mutation.proccode));
                    a := list(*Node, temp());
                    for mutation.argumentids { field |
                        value := b.inputs&.get_ptr(field) 
                            || return(Err = @tfmt("(%): %.% is missing", key, b.opcode, field));
                        value := @try(decode_value(value, s, blocks&, (key, b.opcode, field))) return;
                        a&.push(value); 
                    };
                    @debug_assert_eq(args.len, 0);
                    args&.push(def);
                    args&.push(temp().boxed(Node, (op = .franca_block, args = a.items())));
                };
                
                it.args = args.items();
        };
            
            each s.costumes { it |
                sprite.costumes&.push((
                    name = it.name,
                    fmt = it.dataFormat,
                    data = files&.get(it.md5ext)
                        || return(Err = @tfmt("missing costume (%)", it.md5ext)),
                    md5 = it.assetId,
                ), temp());
            };
            
            project.sprites&.push(temp().boxed(Sprite, sprite), temp());
        if false {
            out := u8.list(temp());
            for sprite.blocks { it |
                emit :: fn(out: *List(u8), it: *Node, depth: i64) void = {
                    out.push_repeated(depth, " ".ascii());
                    @fmt(out, "- % % %\n", it.op, it.literal, it.string);
                    a := it.args;
                    if it.op == .procedures_call {  // don't spam print the body again
                        a = a.rest(1);
                    };
                    for a { it |
                        emit(out, it, depth + 1);
                    };
                };
                emit(out&, it, 0);
            };
            print(out.items());
        };
    };
    if project.sprites[0].name != "Stage" {
        i := project.sprites.index_of(fn(it) => it.name == "Stage").unwrap();
        project.sprites.items().swap(0, i);
    };

    (Ok = temp().boxed(Project, project))
}

fn decode_value(value: *Raw.ValueRef, s: *Raw.Sprite, blocks: *HashMap(Str, *Node), error: Ty(Str, Raw.Opcode, Str)) Result(*Node, Str) = {
    key, op, field := error;
    a := @match(value[]) {
        fn String(s) => {
            // TODO: this is wrong but i don't need strings yet
            n := @switch(s) {
                @case("") => 0.0;
                @case("true") => 1.0;
                @case("false") => 0.0;
                @case("-Infinity") => -1.0/0.0;
                @case("Infinity") => 1.0/0.0;
                @default => {
                    n, s2 := parse_float(s);
                    @if(s2.len != 0) return(Ok = temp().boxed(Node, (op = .franca_string, args = empty(), string = s)));
                    n
                };
            };
            temp().boxed(Node, (op = .franca_literal, args = empty(), literal = n))
        }
        fn BlockStack(id) => {
            _ := blocks.get(id)
                || return(Err = @tfmt("(%): %.% missing (%)", key, op, field, id));
            // TODO: this should go in the top instead and not care about BlockStack vs BlockValue
            @try(collect_block(s, blocks, (Some = id))) return
        }
        fn Var(id) => blocks.get(id)
            || return(Err = @tfmt("(%): %.% missing (%)", key, op, field, id));
        fn BlockValue(id) => blocks.get(id)
            || return(Err = @tfmt("(%): %.% missing (%)", key, op, field, id));
    };
    (Ok = a)
}

fn block_id(it: *Raw.ValueRef) ?Str = {
    (Some = @match(it) {
        fn BlockStack(id) => id[];
        fn BlockValue(id) => id[];
        @default => return(.None);
    })
}

// follows the .next chain
fn collect_block(s: *Raw.Sprite, blocks: *HashMap(Str, *Node), parent: ?Str) Result(*Node, Str) = {
    head: ?Str = parent;
    parent := parent || "";
    args := list(*Node, temp());
    while => head { id |
        n := blocks.get(id)
            || return(Err = @tfmt("[%]: %.next missing (%)", args.len, parent, id));
        args&.push(n);
        head = .None;
        if s.get_block(id) { b | 
            head = b.next;
        };
        parent = id;
    };
    (Ok = temp().boxed(Node, (op = .franca_block, args = args.items())))
}

// the ones i generate have the parent chain go up to the definition,
// scratch has expressions go up to the prototype even tho it doesn't have a next field which seems confusing. 
// but the website accepts both it seems but TODO: i should match them tho
fn find_parent_prototype(s: *Raw.Sprite, blocks: *HashMap(Str, *Node), first: Str) Result(*Raw.Mutation, Str) = {
    id := first;
    loop {
        // can unwrap because initial loop would have errored.
        b := s.get_block(id).unwrap();
        @match(b.opcode) {
            fn procedures_prototype() => return(Ok = b.mutation&.unwrap());
            fn procedures_definition() => {  
                it := b.inputs&.get_ptr("custom_block").unwrap();
                it := it.block_id().unwrap();
                it := s.get_block(it).unwrap();
                return(Ok = it.mutation&.unwrap());                       
            };
            @default => ();
        };
        
        id = b.parent 
            || return(Err = @tfmt("(%): didn't find prototype", first));
    };
    
}

fn get_block(s: *Raw.Sprite, id: Str) ?*Raw.Block = {    
    b := s.blocks&.get_ptr(id) || return(.None);
    @debug_assert(b.is(.Block));
    (Some = b.Block&)
}


// //
// "Scratch > File > Save to your computer" gets you a zip (.sb3) file that contains a project.json
Raw :: @struct {
Project :: @struct {
    targets: List(Sprite);
    monitors: List(Monitor);
    extensions: List(Str);
    meta: Meta;
};

Sprite :: @struct {
    isStage: bool;
    name: Str;
    variables: RawHashMap(Str, Ty(Str, FloatOrString));
    //lists: RawHashMap(Str, Ty(Str, List(Value)));
    broadcasts: RawHashMap(Str, Str);
    blocks: RawHashMap(Str, Block2);
    currentCostume: i64;
    costumes: List(Costume);
    sounds: List(Sound);
};

Block2 :: @tagged(
    // i think Var is only when a variable reporter is at top level (not in a slot) so i never need to care about it?
    Var: @struct(name: Str, id: Str, is_list: bool),
    Block: Block,
);

Opcode :: block_defs.Opcode;
Block :: @struct {
    opcode: Opcode;
    next: ?Str = .None;
    parent: ?Str = .None;
    inputs: RawHashMap(Str, ValueRef) = init();
    fields: RawHashMap(Str, Ty(Str, ?Str)) = init();
    shadow := false;
    topLevel := false;
    x: ?i64 = .None;
    y: ?i64 = .None;
    mutation: ?Mutation = .None;
};

Mutation :: @struct {
    proccode: Str;  // this is like a printf looking thing of the signeture
    warp: bool; 
    argumentids: List(Str);
    argumentnames: ?List(Str);  
    argumentdefaults: ?List(Str);
};

MutationRepr :: @struct {
    tagName := "mutation";
    children: []Str = empty();
    proccode: Str;
    warp: bool; 
    argumentids: Str;
    argumentnames: ?Str;  
    argumentdefaults: ?Str;
};

Costume :: @struct {
    name: Str;
    //bitmapResolution: i64;
    dataFormat: Str;
    assetId: Str;
    md5ext: Str;
    //rotationCenterX: f64 = 0.5;
    //rotationCenterY: f64 = 0.5;
};

Sound :: @struct {
    name: Str;
    assetId: Str;
    dataFormat: Str;
    format: Str;
    rate: i64;
    sampleCount: i64;
    md5ext: Str;
};

Meta :: @struct {
    semver: Str;
    vm: Str;
    agent: Str;
};

Monitor :: @struct {
    id: Str;
    mode: Str;
    opcode: Str;
    params: RawHashMap(Str, Str);
    spriteName: ?Str;
    //value: [],
    width: i64;
    height: i64;
    x: i64;
    y: i64;
    visible: bool;
};

Value :: Str;

FloatOrString :: @tagged(Float: f64, String: Str);
fn parse_json(json: *JsonParser, self: *FloatOrString) bool = {
    token := json.next().or(fn(_: Str) => return(false));
    self[] = @match(token) {
        fn Float(n) => (Float = n);
        fn StringValue(s) => (String = s);
        @default => return(false);
    };
    true
}
fn dump_json(self: *FloatOrString, out: *List(u8)) void = {
    @match(self) {
        fn Float(it) => dump_json(it, out);
        fn String(it) => dump_json(it, out);
    };
}

fn parse_json(json: *JsonParser, self: *Block2) bool = {
    mark := json.mark();
    token := json.next().or(fn(_: Str) => return(false));
    json.reset(mark);
    
    if token&.is(.StartList) {
        it := zeroed Ty(i64, Str, Str, i64, i64);
        parse_json(json, it&) || return(false);
        self[] = (Var = (name = it._1, id = it._2, is_list = it._0 == 13));
    } else {
        it := zeroed Block;
        parse_json(json, it&) || return(false);
        self[] = (Block = it);
    };
    true
}

fn dump_json(self: *Block2, out: *List(u8)) void = {
    @match(self) {
        fn Block(self) => dump_json(self, out);
        fn Var(it) => {
            s := (@if(it.is_list, 13, 12), it.name, it.id, 0, 0);
            dump_json(s&, out);
        }
    };
}

// TODO: idk how it chooses between BlockStack(2) and BlockValue(3) but if.CONDITION can be BlockStack so its not just stmt vs expr like i assumed. 
ValueRef :: @tagged(
    String: Str,
    BlockStack: Str,
    Var: Str,
    BlockValue: Str,
);

fn parse_json(json: *JsonParser, self: *ValueRef) bool = {
    mark := json.mark();
    token := json.next().or(fn(_: Str) => return(false));
    @if(!token&.is(.StartList)) return(false);
    tag := 0;
    parse_json(json, tag&) || return(false);
    second_is_array := false;
    if tag == 3 || tag == 1 {
        token := json.next().or(fn(_: Str) => return(false));
        second_is_array = token&.is(.StartList);
    };
    json.reset(mark);
    
    @switch(tag) {
        @case(1) => {
            if second_is_array {
                it := zeroed Ty(i64, Ty(i64, Str));
                parse_json(json, it&) || return(false);
                self[] = (String = it._1._1);
            } else {
                it := zeroed Ty(i64, Str);
                parse_json(json, it&) || return(false);
                self[] = (BlockValue = it._1);
            };
        };
        @case(2) => {  // block stack
            it := zeroed Ty(i64, Str);
            parse_json(json, it&) || return(false);
            self[] = (BlockStack = it._1);
        };
        @case(3) => {
            if second_is_array {  // variable
                it := zeroed Ty(i64, Ty(i64, Str, Str), Ty(i64, Str));
                parse_json(json, it&) || return(false);
                self[] = (Var = it._1._2);
            } else {  // block
                it := zeroed Ty(i64, Str, Ty(i64, Str));
                parse_json(json, it&) || return(false);
                self[] = (BlockValue = it._1);
            
            };
        };
        @default => {
            json.error = @tfmt("invalid scratch valueref tag: %", tag);
            return false;
        };
    };
    true
}

fn dump_json(self: *ValueRef, out: *List(u8)) void = {
    @match(self) {
        fn String(it) => @fmt(out, "[1, [10, \"%\"]]", it);
        fn BlockStack(it) => @fmt(out, "[2, \"%\"]", it);
        fn BlockValue(it) => @fmt(out, "[3, \"%\", [10, \"\"]]", it);
        fn Var(it) => @fmt(out, "[3, [12, \"%\", \"%\"], [10, \"\"]]", it, it);
    };
}

fn parse_json(json: *JsonParser, self: *Mutation) bool = {
    s := zeroed(MutationRepr);
    parse_json(json, s&) || return(false);
    self.proccode = s.proccode;
    self.warp = s.warp;
    X :: fn(it) => {
        r := List(Str).parse_json(it, json.out);
        r.or(fn(msg) => {
            json.error = msg;
            return(false);
        })
    };
    self.argumentids = X(s.argumentids);
    if s.argumentnames { it |
        self.argumentnames = (Some = X(it));
    };
    if s.argumentdefaults { it |
        self.argumentdefaults = (Some = X(it));
    };
    true
}

fn dump_json(self: *Mutation, out: *List(u8)) void = {
    X :: fn(it) => { x := @ref u8.list(temp()); dump_json(it, x); x.items() };
    s: MutationRepr = (
        proccode = self.proccode,
        warp = self.warp,
        argumentids = X(self.argumentids&),
        argumentnames = .None,
        argumentdefaults = .None,
    );
    if self.argumentnames& { it |
        s.argumentnames = (Some = X(it));
    };
    if self.argumentdefaults& { it |
        s.argumentdefaults = (Some = X(it));
    };
    dump_json(s&, out);
}
};


// TODO
// :compilerbug this being at toplevel gets "overload resolve must be call" (which used to be a debug assert but clearly is reachable)
// something weird and order dependent cause it worked before i rearranged main.fr :FUCKED 
X :: {
::DeriveJson(Raw.Sprite);
::DeriveJson(Raw.Costume);
::DeriveJson(Raw.Block);
::DeriveJson(Raw.Sound);
::DeriveJson(Raw.Project);
::DeriveJson(Raw.Meta);
::DeriveJson(Raw.Monitor);
::DeriveJson(Raw.Opcode);
::DeriveJson(Raw.MutationRepr);
};

#use("@/lib/encoding/json.fr");
#use("@/lib/encoding/json_reflect.fr");
#use("@/lib/collections/map.fr");

block_defs :: @parse_block_defs(
((operator_multiply, operator_add, operator_subtract, operator_divide), (NUM1, NUM2)),
(( operator_lt, operator_or, operator_and, operator_gt, operator_equals), (OPERAND1, OPERAND2)),
(control_if, (CONDITION, SUBSTACK)),
(control_if_else, (CONDITION, SUBSTACK, SUBSTACK2)),
(control_repeat_until, (CONDITION, SUBSTACK)),
((data_setvariableto, data_changevariableby), (VALUE), (VARIABLE)),
(pen_setPenColorToColor, (COLOR)),
(motion_gotoxy, (X, Y)),
(operator_not, (OPERAND)),
(operator_random, (FROM, TO)),
(control_stop, (), (STOP_OPTION)),
(operator_mathop, (NUM), (OPERATOR)),
((pen_setPenSizeTo, looks_setsizeto), (SIZE)),
(control_repeat, (TIMES, SUBSTACK)),
(motion_changeyby, (DY)),
(motion_changexby, (DX)),
(motion_setx, (X)),
(motion_sety, (Y)),
(procedures_definition, (custom_block)),
(procedures_call, ()),
(looks_switchcostumeto, (COSTUME)),
// TODO: it's not clear to me when scratch requires this.
(looks_costume, (), (COSTUME)),
(argument_reporter_string_number, (), /*(VALUE)*/),
// ...
((event_whenflagclicked, procedures_prototype, motion_xposition, motion_yposition, pen_penUp, pen_penDown, pen_clear, pen_stamp), ()),
// these aren't real
((franca_block, franca_literal, franca_var, franca_var_stage, franca_string), ()),
// can't be placed in the gui but projects that use it still load (and my old mandelbrot is one of them). 
(control_for_each, (VALUE, SUBSTACK), (VARIABLE)),
);

// (opcode, inputs, fields)
OpcodeShape :: @struct(inputs: []Str, fields: []Str);
parse_block_defs :: fn(e: FatExpr) FatExpr #macro = {    
    opcodes := Symbol.list(temp());
    each e&.items() { e |
        each e.items().index(0).items() { e |
            opcodes&.push(e.ident() || panic("opcode expected ident"));
        };
    };
    
    Opcode := create_sequential_enum(u32, opcodes.len, fn(i) => opcodes[i]);
    @{ @expand parse_block_defs2(@[@literal Opcode], @[@literal e]) }
    
}

parse_block_defs2 :: fn($Opcode: Type, e: FatExpr) FatExpr = {
    ::enum_derive(Opcode);
    ::AutoHash(Opcode, TrivialHasher);
    ::DerefEq(Opcode);
    out: HashMap(Opcode, OpcodeShape) = init(ast_alloc());
    each e&.items() { e |
        e := e.items();
        
        inputs, fields := (Str.list(ast_alloc()), Str.list(ast_alloc()));
        @if(e[1].ty != void) each e[1]&.items() { e |
            inputs&.push(e.ident().unwrap().str())
        };
        @if(e.len >= 3) each e[2]&.items() { e |
            fields&.push(e.ident().unwrap().str());
        };
        
        each e[0]&.items() { e |
            opcode := Opcode.from_name(str(e.ident().unwrap())).unwrap();
            out&.insert(opcode, (inputs = inputs.items(), fields = fields.items()));
        };
    };
    @{ @static @anon_literal(_ = Opcode, shapes = @static @[@literal out.raw]) }
}
