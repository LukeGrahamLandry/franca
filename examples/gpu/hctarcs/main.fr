
main :: fn() void = {
    p := @run import("@/examples/gpu/hctarcs/tests/mandelbrot.fr")'build();
    out := u8.list(temp());
    out_zip := u8.list(temp());
    p.build(out&, out_zip&);
    write :: import("@/lib/sys/fs.fr").write_entire_file_or_crash;
    path := "target/a.json";
    write(path, out.items());
    write("target/_project.sb3", out_zip.items());
    
    #use("@/lib/encoding/json.fr");
    T :: import("@/examples/gpu/hctarcs/builder.fr");
    r := T'unbuild(out_zip.items());
    r := r.or(panic);
    
evaluate :: fn(p: *T.Project) []u8 = {
    #use("@/examples/gpu/hctarcs/runtime.fr");
    it := p.sprites[1];
    @assert_ne(it.name, "Stage");
    it := it.blocks.find(fn(it) => it.op == .event_whenflagclicked).unwrap();
    s: Script = (
        sprite = @ref @as(SpriteBase) (
            pos = vec2(0),
            pen = (down = false, colour = 0, size = 1),
            vars = temp().alloc_zeroed(f64, 200),
        ),
        canvas = @ref @as(Canvas) (
            pen_pixels = temp().alloc_zeroed(u32, 480*360),
            rng = Random.xoshiro256SS.new_seeded(),
            stage_vars = temp().alloc_zeroed(f64, 200),
        ),
    );
    eval(s&, it.args[0]);
    
    out := @ref u8.list(temp());
    @fmt(out, "P6 % % 255\n", 480, 360);
    for s.canvas.pen_pixels { c |
        out.push(c.shift_right_logical(16).trunc());
        out.push(c.shift_right_logical(8).trunc());
        out.push(c.trunc());
    };
    out.items()
};
    
    before := evaluate(p);
    after := evaluate(r);
    @assert_eq(before, after);
    
    dest := "target/a.ppm";
    write_entire_file_or_crash(dest, before);
    if true {
        // https://scratch.mit.edu/projects/726052645
        path := "/Users/luke/Downloads/Linrays/project.json";
        r := read_entire_file_or_crash(temp(), path);
        r := parse_json(T.Raw.Project, r, temp());
        r.or(fn(msg) => @panic("%%", path, msg));
        
        r := read_entire_file_or_crash(temp(), "/Users/luke/Downloads/Linrays.sb3");
        r := T'unbuild(r);
        r := r.or(panic);
        
        out := evaluate(r);
        write_entire_file_or_crash(dest, out);
    };
    
    if cli_args().contains(fn(it) => it[] == "-show") {
        #use("@/lib/sys/subprocess.fr");
        #use("@/lib/sys/process.fr");
        franca := get_executable_path(temp());
        a := make_args_for_exec(franca, @slice("examples/gpu/viewer.fr", "-jit", dest), temp());
        become(a[0], a);
    };
}

#use("@/graphics/vec.fr");
