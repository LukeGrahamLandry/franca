// TODO: somehow putting an @run changes linrays time 820->760
main :: fn() void = {
    i :: @static_mut 0;
    args := Str.list(2 + src.len(), temp());
    args&.push_all(@slice("examples/gpu/viewer.fr", "-jit"));
    mark := temp().mark();
    inline_for src { $src |
        //X :: 123; // TODO: "Cannot shadow constant in the same scope: X"
        #use("@/examples/gpu/hctarcs/runtime.fr");
        // TODO: annoying that doing it through a file instead of import("{};") 
        //       gets you a nicer error message (so you can click to see context)
        //       the compiler should just write it out for you. :compiler
        frame := temporary_main((@run {
            path := @tfmt("target/a%.fr", @run i[]);
            write_entire_file_or_crash(path, src[]);
            import(@afmt(ast_alloc(), "@/%", path))
        }).initialize, false);
        path := @run @afmt(ast_alloc(), "target/a%.ppm", @run i[]);
        write_entire_file_or_crash(path, frame);
        args&.push(path);
        temp().reset(mark);
        @run { i[] += 1; };
    };
    
    #use("@/lib/sys/process.fr");
    #use("@/lib/sys/subprocess.fr");
    franca := get_executable_path(temp());  // only works if running jitted
    a := make_args_for_exec(franca, args.items(), temp());
    
    @if(IS_WASM_PLAYGROUND) push_as_tls(.cli_arguments, a) {| import("@/examples/gpu/viewer.fr")'main(); };
    
    if cli_args().contains(fn(it) => it[] == "-show") {
        become(a[0], a);
    };
};

src :: {
    start := timestamp();
    
    sources := Str.list(ast_alloc());
    
    for local { p |
        out := u8.list(temp());
        out_zip := u8.list(temp());
        p.build(out&, out_zip&);
        // "_" so it shows first in finder's alphabetical list when opening in website
        write_entire_file_or_crash("target/_project.sb3", out_zip.items());
        write_entire_file_or_crash("target/_project.json", out.items());
        r := out_zip.items();
        
        build_sb3(r);
    };
    
    // build_sb3(read_entire_file_or_crash(temp(), "/Users/luke/Downloads/Cat Ball Normalized.sb3"));
    
    ci := Foreign.ENV.GITHUB_REPOSITORY.get_environment_variable().is_some()
        || "BUILD_SUBMITTER".get_environment_variable().is_some();
    for projects { id |
        @match(fetch_sb3(id, ci)) {
            fn Ok(it) => build_sb3(it);
            fn Err(msg) => @eprintln("ERROR[project_id=%] %", id, msg);
        };
    };
    build_sb3 :: fn(r: []u8) => {
        ::S.X;  // TODO: why isn't this being in unbuild() enough
        mark := temp().mark();
        r := unbuild(r);
        r := r.or(panic);
        
        out := list(u8, ast_alloc());
        compile_to_franca(r, out&);
        sources&.push(out.items());
        temp().reset(mark);
    };
    // TODO: report fetch time seperately
    @println("built in %ms", timestamp() - start);
    sources.items()
};

#use("@/graphics/vec.fr");

// TODO: fetch index of what i have mirrored so don't have to do twice as many gets if its not

fetch_sb3 :: fn(project_id: i64, mirror_only: bool) Result([]u8, Str) = {
    // TODO: maybe don't cache the zip file cause its a waste of disk space because can reconstruct from the parts every time but its faster to not do a billion reads presumably. 
    it := with_cache(scratch_deps_dir, @tfmt("%.sb3", project_id)) {
        Zip :: import("@/lib/encoding/pkzip.fr");
        files := @ref Zip.File.list(temp());
        project := @try(fetch_project_json(project_id, mirror_only)) return;
        files.push(name = "project.json", data = project);
        
        // TODO: good error message if it's a .sb2
        // don't need to parse the whole Sb3.Raw.Project to know which assets are used. 
        PartialProject :: @struct(targets: []PartialSprite); ::DeriveJson(PartialProject);
        PartialSprite :: @struct(costumes: []Sb3.Raw.Costume); ::DeriveJson(PartialSprite);
        ::DeriveJson(Sb3.Raw.Costume);
        it := @try(parse_json(PartialProject, project, temp())) return;
        
        each it.targets { it |
            each it.costumes { it |
                escapes :: import("@/examples/fetch.fr").has_path_escapes;
                @if(escapes(it.md5ext)) return(Err = @tfmt("(%): sketchy md5ext: %", project_id, it.md5ext));
                // cache each asset seperately so they can be shared between projects
                data := with_cache(scratch_fetch_dir, it.md5ext) {
                    // TODO: sad to do this in a syncronous loop but that's the type of language i am so here we are
                    data := @try(fetch_asset(it.md5ext, mirror_only)) return;
                    md5 := import("@/lib/mix/md5.fr")'hex(data);
                    @if(it.assetId != md5) return(Err = @tfmt("(%): wrong asset hash (% vs %)", it.name, it.assetId, md5));
                    data
                };
                @if(!it.md5ext.ends_with(it.dataFormat) || !it.md5ext.starts_with(it.assetId)) return(Err = "wrong md5ext");
                if !files.contains(fn(jt) => jt.name == it.md5ext) {
                    files.push(name = it.md5ext, data = data);
                };
            };
        };
        out := u8.list(temp());
        Zip'write(out&, files.items());
        out.items()
    };
    (Ok = it)
}

// TODO: flaw in the mirroring is do i trust all the assets to actually be cc-by-sa?
fetch_asset :: fn(md5ext: Str, mirror_only: bool) Result([]u8, Str) = {
    url := @tfmt("https://franca.lukegrahamlandry.ca/mirror/scratch/%", md5ext);
    @if_let(http_get(url)) fn Ok(it) => return(Ok = it);
    @if(mirror_only) return(Err = @tfmt("not mirrored: %", md5ext));
    url := @tfmt("https://assets.scratch.mit.edu/internalapi/asset/%/get/", md5ext);
    http_get(url)
};

// for now just cache forever TODO: the first url has history.modified time so could check that everytime to see if it changed
fetch_project_json :: fn(project_id: i64, mirror_only: bool) Result([]u8, Str) = {
        // TODO: project.json-s compress super well so should probably do that when caching it
        //       (aka the format is stupid, ex. the quicksort one stores the same 200k floats twice because of monitors, i could just get rid of those)
        it := with_cache(scratch_fetch_dir, @tfmt("%.json", project_id)) {
            yield :: local_return;
            save_meta :: fn(it) => {
                // i want the cache to have the (description,credit,etc.) for archeology
                path := @tfmt("%/%.meta.json", scratch_fetch_dir, project_id);
                _ := write_entire_file(path, it);
            };
            
            url := @tfmt("https://franca.lukegrahamlandry.ca/mirror/scratch/%.json", project_id);
            @if_let(http_get(url)) fn Ok(it) => {
                url := @tfmt("https://franca.lukegrahamlandry.ca/mirror/scratch/%.meta.json", project_id);
                @if_let(http_get(url)) fn Ok(it) => save_meta(it);
                yield(it);
            };
            
            @if(mirror_only) return(Err = "not mirrored project.json");
            
            url := @tfmt("https://trampoline.turbowarp.org/api/projects/%", project_id);
            it := @try(http_get(url)) return;
            save_meta(it);
            S :: @struct(project_token: Str); ::DeriveJson(S);
            it := @try(parse_json(S, it, temp())) return;
            url := @tfmt("https://projects.scratch.mit.edu/%?token=%", project_id, it.project_token);
            @try(http_get(url)) return
        };
        (Ok = it)
}

// TODO: unify with the fetch_or_crash that uses curl
http_get :: jit_barrier(fn(url: Str) Result(Str, Str) = {
    @if(IS_WASM_PLAYGROUND) {
        prefix := "https://franca.lukegrahamlandry.ca/mirror/";
        @if(!url.starts_with(prefix)) return(Err = "failed fetch (cors)");
        return(Ok = import("@/examples/os/bin/curl.fr")'fetch(url.rest(prefix.len))
            || return(Err = "failed js fetch"));
    };
    
    @if(true) {  // experimenting... TODO: if change back, revisit reach_all_deps to not compile mbedtls every time
        curl := Foreign.EXE.curl;
        ok, out, err := exec_and_catch(curl, @slice(url, "-s", "-L", "-f"), temp());
        if !ok {
            return(Err = @tfmt("failed curl %\n%", url, err.items()));
        };
        return(Ok = out.items());
    };

    #use("@/examples/web/get.fr");
    url := @try(parse_url(url)) return;
    // this doesn't check the tls certificate but like... whatever... 
    r := @try(get_https_unsafe(url, 10)) return;
    @if(r.status != 200) return(Err = @tfmt("status=%", r.status));
    (Ok = r.data)
});


with_cache :: fn(dir: Str, file_name: Str, $miss: @Fn() []u8) []u8 = {
    #use("@/lib/sys/fs.fr");
    cache_file := @tfmt("%/%", dir, file_name);
    if read_entire_file(temp(), cache_file) { it |
        return(it);
    };
    _ := make_dirs(dir);
    it := miss();
    _ := write_entire_file(cache_file, it);
    it
};

scratch_fetch_dir :: @afmt(ast_alloc(), "%/scratch", import("@/examples/fetch.fr").FRANCA_PATH_FETCH);
scratch_deps_dir :: @afmt(ast_alloc(), "%/scratch", import("@/examples/fetch.fr").FRANCA_PATH_DEPS);

#use("@/lib/encoding/json_reflect.fr");
Sb3 :: import("@/examples/gpu/hctarcs/builder.fr");
#use("@/examples/gpu/hctarcs/compile.fr");
#use("@/lib/sys/fs.fr");
#use("@/lib/sys/process.fr");

IS_WASM_PLAYGROUND :: true   // HACK #use("@/graphics/lib.fr");
    && query_current_arch() == .wasm32 
    && (@(fn(target: FatExpr) FatExpr #macro = @literal @is(target.expr&, .GetVar))(GRAPHICS_TARGET_WEB)) 
    && bool.const_eval(@{ GRAPHICS_TARGET_WEB });
