
main :: fn() void = @run {
    p := import("@/examples/gpu/hctarcs/tests/mandelbrot.fr")'build();
    out := u8.list(temp());
    p.build(out&);
    write :: import("@/lib/sys/fs.fr").write_entire_file_or_crash;
    path := "target/a.json";
    write(path, out.items());
    
    #use("@/lib/encoding/json.fr");
    T :: import("@/examples/gpu/hctarcs/builder.fr");
    json: JsonParser = new_json(out.items(), temp());
    it := zeroed T.Raw.Project;
    ok := parse_json(json&, it&);
    if !ok {
        line, col := find_line_col_for_error_message(json&);
        @panic("failed to parse %:%:%: %", path, line, col, json.error);
    };
}
