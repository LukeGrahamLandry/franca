
main :: fn() void = @run {
    p := import("@/examples/gpu/hctarcs/tests/mandelbrot.fr")'build();
    out := u8.list(temp());
    out_zip := u8.list(temp());
    p.build(out&, out_zip&);
    write :: import("@/lib/sys/fs.fr").write_entire_file_or_crash;
    path := "target/a.json";
    write(path, out.items());
    write("target/_project.sb3", out_zip.items());
    
    #use("@/lib/encoding/json.fr");
    T :: import("@/examples/gpu/hctarcs/builder.fr");
    
    it := parse_json(T.Raw.Project, out.items(), temp())
        .or(fn(msg) => @panic("%%", path, msg));
}
