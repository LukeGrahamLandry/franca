// ast -> franca source. 
// note: this mutates the ast
//
// - lists are a constant drop down so don't need to be typechecked. 
// - hoist dynamic typechecking out of rt.impl so it can be elided
// 

compile_to_franca :: fn(p: *S.Project, out: *List(u8)) void = {
    self: Compile = (
        out = out, 
        string_lookup = init(temp()), string_constants = list(temp()),
        project = p,
        warning = p.warning.assume_owned(temp()),
    );
    self := self&;
    
    each(p.sprites, fn(it) => each(it.blocks&, fn(it) => self.lower(it)));
    
    // TODO: not good enough
    each p.sprites { s |
        for s.blocks& { it |
            self.current_def = it;
            @if(is_hat(it.op))
            if it.op == .procedures_definition {
                _ := self.is_async(it);
            } else {
                it.flags.async = @if(self.is_async(it.args[0]), .yes, .no);
            };
            each s.blocks& { it |
                it.flags.mark_rec = false;
            };
        };
    };
    
    @fmt(out, "// @generated by franca/examples/gpu/hctarcs/compile.fr\n");
    @fmt(out, "Rt :: import(\"@/examples/gpu/hctarcs/runtime.fr\");\n");
    @fmt(out, "main :: fn() void = { Rt'temporary_main(initialize, cli_args().contains(fn(it) => it[] == \"-show\")); };\n");
    
    event_index := 0.0;
    each p.sprites { it |
        each it.blocks { it |
            event_index += 1;
            it.literal = event_index;
        };
    };
    emitted_images: HashMap(Str, Ty([]u8, i32, i32, bool)) = init(temp());
    for p.sprites { it |
        self.emit_debug_sprite(it);
        
        for it.blocks { it |
            continue :: local_return;
            @if(!is_hat(it.op)) continue();
            
            extra_param := "";
            self.current_def = it;
            if it.op == .procedures_definition {
                self.emit_debug_block(it);
                @fmt(out, "@\"proc_% %\"", it.literal, => self.safe_string_body(it.string));
                if !self.is_async(it) {
                    extra_param = @tfmt(", params: *Array(Rt.Value, %)", it.args[1].args.len);
                };
            } else {
                if it.op == .event_whenbroadcastreceived {
                    @fmt(out, "@\"broadcast_%_%\"", it.literal, => self.safe_string_body(it.args[1].string));
                } else {
                    @fmt(out, "%_%", it.op, it.literal);
                };
            };
            @fmt(out, " :: fn(s: *Rt.Script%) void #use(Rt.impl) = {\n", extra_param);
            
            self.futures_depth = 0;
            self.max_futures = 0;
            if self.is_async(it) {
                // on entry to async function the stack is [..arguments, cont] (where cont is the caller, the callee was already popped off). 
                // cont pops off the args when we're done. 
                if it.op == .procedures_definition {
                    self.futures_depth += it.args[1].args.len + 1;
                    self.max_futures = self.futures_depth;
                };
                @fmt(out, "s.futures&.reserve(DEPTH, s.canvas.gpa);\n");  // named so value can be patched after emitting the body
            };
            
            start := self.futures_depth;
            if self.is_async(it) && it.op == .procedures_definition {
                if it.flags.run_without_screen_refresh {
                    @fmt(out, "s.without_refresh_depth += 1;\n");
                };
                // avoid extra yield for the return
                // this relies on franca_call_cont popping from the stack not calling statically (which the if_else callsite wants to change)
                cont: Node = (op = .franca_call_cont, args = empty(), literal = 0, flags = (async = .yes));
                self.compile_async(@slice(it.args[0], cont&));
            } else {
                self.compile_async(@slice(it.args[0]));
            };
            
            @debug_assert_eq(self.futures_depth, start, "leaked futures_depth");
            
            @if(self.is_async(it)) @fmt(out, ";DEPTH::%", self.max_futures);
            @fmt(out, ";}\n\n");
        };
        self.current_sprite += 1;
        self.current_def = zeroed(*Node);
        
        each it.costumes { it |
            continue :: local_return;
            @if(emitted_images&.contains(it.md5)) continue();
            if it.fmt != "png" || !Viewer.FEAT_PNG {
                @fmt(self.warning&, "i don't support svgs yet so (%) won't render\n", it.name);
                emitted_images&.insert(it.md5, ("", 0, 0, false));
                continue();
            };
            data, width, height := Viewer'stbi_load(it.data)
                .or(fn(msg) => @panic("failed decode %: %", it.name, msg));
            
            solid := 0;
            each u32.reinterpret_bytes(data) { c |
                solid += int(c[].shift_right_logical(24) != 0);
                // fix colour format to match pen_setPenColorToColor (AABBGGRR -> AARRGGBB)
                c[] = c[].byte_swap().rotate_right(8);
            };
            if solid == 0 {  // if all pixels are transparent, don't need to render anything. 
                width = 0; height = 0;
            };
            
            emitted_images&.insert(it.md5, (data, width, height, true));
        };
    };
    
    floats_blob := f64.list(temp());
    
    @fmt(out, "initialize :: fn(c: *Rt.Canvas) void = {\n");
    @fmt(out, "c.metadata = (credits = metadata, warning = warning);\n");
    @fmt(out, "a := c.gpa;\nfloats_blob := f64.reinterpret_bytes(floats_blob);\n");
    @fmt(out, "c.classes = a.alloc_uninit(Rt.SpriteClass, %);\n", p.sprites.len);
    @fmt(out, "c.init_strings(strings);\n");  // Obj for the const string so can use them in sprite vars below. 
    enumerate p.sprites { sprite_i, it |
        self.current_sprite = sprite_i;
        @fmt(out, "t := a.alloc_uninit(Rt.SpriteClass.Costume, %);\n", it.costumes.len);
        enumerate it.costumes { i, it |
            // TODO: declaring '_' twice probably shouldn't be allowed :compiler
            _, width, height, _ := emitted_images&.get(it.md5).unwrap();
            @fmt(out, "t[%] = (name = c.constants[%], data = img_%, width = %, height = %);\n", i, self.const_string(it.name), it.md5, width, height);
        };
        @fmt(out, "e := @ref Rt.SpriteClass.Handler.list(a);\n");
        each it.blocks { it |
            @match(it.op) {
                fn event_whenflagclicked() => @fmt(out, "e.push(trigger = .Flag, callee = %_%);\n", it.op, it.literal);
                fn event_whenbroadcastreceived() => {
                    name, i := (it.args[1].string, it.args[1].literal.int());
                    @assert_eq(self.project.broadcasts[i].string, name, "invalid broadcast (%)", name);
                    @fmt(out, "e.push(trigger = (Broadcast = %), callee = @\"broadcast_%_%\");\n", i, it.literal, => self.safe_string_body(name));
                }
                fn event_whenbackdropswitchesto() => {
                    name := it.args[1].string;
                    i := self.project.sprites[0].costumes.index_of(fn(it) => it.name == name)
                        || @panic("invalid backdrop name: %", name);
                    @fmt(out, "e.push(trigger = (BackdropSwitch = %), callee = %_%);\n", i, it.op, it.literal);
                }
                fn event_whenthisspriteclicked() => @fmt(out, "e.push(trigger = .SpriteClicked, callee = %_%);\n", it.op, it.literal);
                fn control_start_as_clone() => @fmt(out, "e.push(trigger = .CloneStart, callee = %_%);\n", it.op, it.literal);
                fn event_whenstageclicked() => @fmt(out, "e.push(trigger = .SpriteClicked, callee = %_%);\n", it.op, it.literal);
                fn event_whenkeypressed() => {
                    name := it.args[1].string;
                    if it.args[1].op == .franca_literal {  // number key
                        name = @tfmt("%", it.args[0].literal);  
                    };
                    i := Rt'key_indices.get(name) || @panic("invalid event_whenkeypressed: (%)", name);
                    @fmt(out, "e.push(trigger = (KeyPress = %), callee = %_%);\n", i, it.op, it.literal);
                }
                fn procedures_definition() => ();
                @default => @debug_assert(!is_hat(it.op), "TODO: hat %", it.op);  // there can be top level non-hat blocks, they just never run
            };
        };
        
        if it.monitors.len > 0 {
        @fmt(out, "m := @const_slice(@as(Rt.Monitor)\n");
        each it.monitors { m |
            @assert(m.var.op == .franca_var || sprite_i == 0, "sprite has stage monitior");
            @fmt(out, "(var=%,name=strings[%],x=%,y=%,hide=%,mode=", self.var_index(m.var), self.const_string(m.var.string), m.x, m.y, m.hide);
            @match(m.mode) {
                fn Value() => @fmt(out, ".Value");
                // TODO: do the better float printing
                fn Slider(it) => @fmt(out, "(Slider=(lo=%,hi=%,discrete=%))", it.lo, it.hi, it.discrete);
            };
            @fmt(out, "),\n");
        };
        @fmt(out, ");\n");
        } else {
            @fmt(out, "m: []Rt.Monitor = empty();\n");
        };
        @fmt(out, "c.classes[%] = (name = strings[%], costumes = t, events = e.shrink_to_fit(), var_count = %, monitors = m);\n", sprite_i, self.const_string(it.name), it.variables.len);
        @fmt(out, "sprite := c.new_sprite(c.classes[%]&);\n", sprite_i);
        
        I := it.initial&;
        @fmt(out, "sprite.pos.x = clamp(%, -c.size.x/2, c.size.x/2); sprite.pos.y = clamp(%, -c.size.y/2, c.size.y/2); sprite.looks.costume = %; sprite.looks.size = float(%) / 100.0; sprite.looks.hide = %; sprite.direction = %;\n", 
            I.x, I.y, I.costume.mod(it.costumes.len), I.size, I.hide, I.direction);
        
        @fmt(out, "v := sprite.vars();\n");
        init_list_values(self, it.variables.items(), floats_blob&, true);
    };
    enumerate p.broadcasts { i, it |
        @fmt(out, "c.broadcasts&.insert(strings[%], %, a);\n", self.const_string(it.string), i);
    };
    
    @fmt(out, "};\n");
    
    // TODO: probably a smaller binary if include png+decode code and decompress at runtime instead
    each emitted_images& { key, it |
        embed_bytes(out, @tfmt("img_%", key), it._0);
        @if(Viewer.FEAT_PNG) @if(it._3)
        Viewer'Stb'stbi_image_free(u8.raw_from_ptr(it._0.ptr));
        it._0 = "";
    };
    
    // TODO: pack these and change `strings[%]` to `strings.subslice(off, len)` so don't need to do as many relocations
    @fmt(out, "strings :: @const_slice(\n");
    for self.string_constants { it |
        @fmt(out, "    \"%\",\n", => self.safe_string_body(it));
    };
    @fmt(out, ");\n");
    
    embed_bytes(out, "floats_blob", floats_blob&.items().interpret_as_bytes());
    
    if p.meta& { it |
        @fmt(out, "metadata :: @const_slice(\n");
        s := @slice(@tfmt("%", it.id), it.title, it.description, it.instructions, @tfmt("%", it.author.id), it.author.username, it.history.created, it.history.modified, it.history.shared);
        for s { it |
            @fmt(out, "\"%\",\n", => self.safe_string_body(it));
        };
        @fmt(out, ");\n");
    } else {
        @fmt(out, "metadata :[]Str: empty();\n");
    };
    @fmt(out, "warning :: \"%\";\n", => self.safe_string_body(self.warning.items()));
}

fn safe_string_body(self: *Compile, it: Str) void = {
    out := self.out;
    for it { c |
        @switch(c) {
            @case("\"".ascii()) => @fmt(out, "\\\"");
            @case("\\".ascii()) => @fmt(out, "\\\\");
            @case("\n".ascii()) => @fmt(out, "\\n");
            @default => (if c < 32 || c >= 127 {
                @fmt(out, "\\x");
                push_hex_byte(out, c, true);
            } else {
                out.push(c);
            });
        };
    };
}

Compile :: @struct {
    out: *List(u8);
    depth := 0;
    string_lookup: HashMap(Str, i64);
    string_constants: List(Str);
    current_sprite := 0;
    project: *S.Project;
    current_def := zeroed(*Node);
    next_cont_id := 0;
    futures_depth := 0;  // how far back on futures stack is first parameter of current_def
    max_futures := 0;    // to reserve at the start
    warning: List(u8);
};

// TODO: in builder check that not using a !simple_ops.has_result where a value is needed and give error. 
// TODO: generic way to insert string->index lookups for costumes,broadcast,clone_of,etc.
//       similarly many of the ones with constant fields should be compiled to call different functions like mathop. 

fn compile_cast(self: *Compile, it: *Node, dest: ValueType) void = {
    if it.op == .franca_string && dest == .Float {
        if Rt'string_to_number(it.string) { n |
            it.op = .franca_literal;
            it.literal = n;
        };
    };
    
    compile(self, it);
    push_cast(self, dest, it.flags.type);
}

compile :: fn(self: *Compile, it: *Node) void = {
    out := self.out;
    @if(out.items().ends_with("\n")) out.push_repeated(self.depth*4, " ".ascii());
    
    if simple_ops.ops&.get(it.op) { data |
        if @is(it.op, .pen_changePenShadeBy, .pen_setPenShadeToNumber, .motion_ifonedgebounce, .looks_gotofrontback, .looks_changeeffectby, .sensing_touchingcolor, .sensing_askandwait, .sensing_answer, .looks_seteffectto, .sensing_distanceto, .sensing_setdragmode, .sensing_of) {
            @fmtln(self.warning&, "TODO: %", it.op);
        };
    
        @if(data.need_self) @fmt(out, "s.");
        @fmt(out, "%(", it.op);
        op := it.op;
        enumerate it.args { i, it |
            if data.arg[i] == .Index {
                compile_lookup(self, op, it[]);
            } else {
                compile_cast(self, it[], data.arg[i]);
            };
            @fmt(out, ", ");
        };
        @fmt(out, ")");
        @match(data.ret) {
            fn Bool() => @fmt(out, ".from_bool()");
            fn Void() => @fmt(out, ";\n");
            @default => ();
        };
        it.flags.type = data.ret;
        return();
    };
    
    if @is(it.op, 
        .sound_setvolumeto, .sound_playuntildone, .sound_play, .sound_stopallsounds, .sound_changevolumeby,
        .music_setTempo, .music_changeTempo, .music_restForBeats, .music_playNoteForBeats, .music_playDrumForBeats, .music_setInstrument, .music_menu_INSTRUMENT, .music_menu_DRUM,
    ) {
        // i don't do sound yet
        return @fmt(out, "/* % */", it.op);
    };
    
    @match(it.op) {
        fn franca_literal() => {
            it.flags.type = .Float;
        if abs(it.literal) != 1.0/0.0 && it.literal.floor() == it.literal {
            if it.literal >= 0 {
                @fmt(out, "%.0", it.literal);
            } else {
                @fmt(out, "(%.0)", it.literal);
            };
        } else {
            @fmt(out, "(@as(f64) bitcast(%))", fmt_hex(it.literal));
        };
        }
        fn franca_string() => @fmt(out, "s.canvas.constants[%]", self.const_string(it.string));
        fn franca_block() => {
            if it.args.len == 1 {
                compile(self, it.args[0]);
            } else {
                out.push_repeated(4, " ".ascii());
                self.depth += 1;
                for it.args { it |
                    compile(self, it);
                    @if(!out.items().ends_with(";\n")) @fmt(out, ";\n");
                };
                self.depth -= 1;
            };
        }
        fn franca_var() => @fmt(out, "s.sprite[%]", self.var_index(it));
        fn franca_var_stage() => @fmt(out, "s.canvas.stage[%]", self.var_index(it));
        fn argument_reporter_string_number() => {
            def := self.current_def;
            @assert_eq(def.op, .procedures_definition, "argument outside custom block");
            params := def.args[1].args;
            i := params.index_of(fn(check) => check.literal == it.literal) || {
                // TODO: redundant because the loader does this too 
                // sadly not an error. ex. this is why turbowarp's "is compiled?" block works in normal scratch. 
                @fmt(self.warning&, "used argument % outside it's function\n", it.string); 
                return @fmt(out, "%", @if(it.flags.type == .Bool, "false.from_bool()", "0.0"));
            };
            if self.is_async(def) {
                return @fmt(out, "s.futures[s.futures.len + (-% + %)]", self.futures_depth, i);
            };
            @fmt(out, "params[%]", i);
        }
        fn data_setvariableto() => {
            compile(self, it.args[1]);
            @fmt(out, " = ");
            compile(self, it.args[0]);
            @fmt(out, ";\n");
        }
        fn operator_or() => {
            @fmt(out, "(");
            compile_cast(self, it.args[0], .Bool);
            @fmt(out, " || ");
            compile_cast(self, it.args[1], .Bool);
            @fmt(out, ").from_bool()");
            it.flags.type = .Bool;
        }
        fn operator_and() => {
            @fmt(out, "(");
            compile_cast(self, it.args[0], .Bool);
            @fmt(out, " && ");
            compile_cast(self, it.args[1], .Bool);
            @fmt(out, ").from_bool()");
            it.flags.type = .Bool;
        }
        fn operator_mathop() => {
            suffix := it.args[1].string;
            suffix := @if(suffix == "e ^", "e_pow", suffix);
            suffix := @if(suffix == "10 ^", "10_pow", suffix);
            @assert(simple_ops.op_names&.get_ptr(it.op).unwrap().contains(suffix), "TODO: %.%", it.op, suffix);
            @fmt(out, "%_%(", it.op, suffix);
            compile_cast(self, it.args[0], .Float);
            @fmt(out, ")");
            it.flags.type = .Float;
        }
        fn procedures_call() => {
            def := it.args[0];
            params := def.args[1].args;
            args := it.args[1].args;
            @debug_assert_eq(args.len, params.len);
            
            @fmt(out, "args: Array(Rt.Value, %) = (", args.len);
            @switch(params.len) {  // TODO: this needing a special case is stupid
                @case(0) => @fmt(out, "zeroed(Array(Rt.Value, 0))");
                @case(1) => {
                    @fmt(out, "bit_cast_unchecked(Rt.Value, Array(Rt.Value, 1), ");
                    self.compile(args[0]);
                    @fmt(out, ")");
                };
                @default => {
                    for args { it |
                        self.compile(it);
                        @fmt(out, ",");
                    };
                };
            };
            
            @fmt(out, ");\n");
            out.push_repeated(self.depth*4, " ".ascii());
            @fmt(out, "@\"proc_% %\"(s, args&);\n ", def.literal, => self.safe_string_body(def.string));
        }
        fn event_broadcast() => {
            @fmt(out, "idx := ");
            compile_lookup(self, it.op, it.args[0]);
            @fmt(out, ";\n");
            @fmt(out, "s.canvas.send_event(Broadcast = idx);\n");
            // TODO: this isn't good enough because might be inside a custom block and then need to return all the way up. 
            //       so any custom blocks that might be called from an event_whenbroadcastreceived 
            //       need to treat sending (computed or the parent) broadcast as being async so they can bail.
            //       and then runtime needs to track the sprite's parent broadcast in case it has custom blocks that need to check it. 
            //       should do the lookup_index folding first tho so its can be less pessimistic. 
            if self.current_def.op == .event_whenbroadcastreceived {
                @fmt(out, "@if(idx == %) return();\n", self.current_def.args[1].literal);
            };
        };
        fn control_stop() => {
            @switch(it.args[0].string) {
                @case("this script") => ();  // if in a custom block, only needs to return up one level so it's more like "this hat block"
                // TODO: these need to make everything be async i guess
                @case("all") => @fmt(out, "println(\"TODO: control stop all\");\n");
                @case("other scripts in sprite") => @fmt(out, "println(\"TODO: control stop other\");\n");
                @case("other scripts in stage") => @fmt(out, "println(\"TODO: control stop other\");\n");
                @default => @panic("invalid control_stop: %", it.args[0].string);
            };
            if self.futures_depth != 0 {
                depth := self.futures_depth;
                if self.current_def.op == .procedures_definition {
                    // leave the params on the stack because the caller expects to pop them off. 
                    params := self.current_def.args[1].args;
                    depth -= params.len + 1;
                };
                if depth != 0 {
                    @fmt(out, "s.pop_async(%);\n", depth);
                };
            };
            @fmt(out, "return();\n");
        }
        fn control_repeat_until() => {
            @fmt(out, "while => !");
            compile_cast(self, it.args[0], .Bool);
            @fmt(out, " {\n");
            compile(self, it.args[1]);
            @fmt(out, ";};\n");
        }
        fn control_repeat() => {
            @fmt(out, "i := ");
            compile_cast(self, it.args[0], .Float);
            @fmt(out, ";\nwhile => i > 0 {\ni -= 1;\n");
            compile(self, it.args[1]);
            @fmt(out, ";};\n");
        }
        fn control_if_else() => {
            @fmt(out, "if ");
            compile_cast(self, it.args[0], .Bool);
            @fmt(out, " {\n");
            compile(self, it.args[1]);
            @fmt(out, ";} else {\n");
            compile(self, it.args[2]);
            @fmt(out, ";};\n");
        }
        fn control_for_each() => {
            limit, body, var := (it.args[0], it.args[1], it.args[2]);
            @fmt(out, "limit := ");
            compile_cast(self, limit, .Float);
            @fmt(out, ";i := 1.0;\nwhile => i <= limit {\n");
            compile(self, var);
            @fmt(out, " = i;\ni += 1;\n");
            compile(self, body);
            @fmt(out, ";};\n");
        }
        fn sensing_of() => {
            object, property := (it.args[0], it.args[1]);
            @assert_eq(property.op, .franca_string, "sensing_of property must be constant");
            property := property.string;
            // TODO: reciever can be computed and then need to switch on it because var index won't be the same in each class
            @assert_eq(object.op, .franca_string, "TODO: sensing_of non-constant reciever");
            object := object.string;
            if object == "_stage_" {
                object = "Stage";
            };
            class_i := self.project.sprites.index_of(fn(it) => it.name == object) 
                || @panic("invalid sensing_of object (%)", object);
            var_i := self.project.sprites[class_i].variables.index_of(fn(it) => it.string == property)
                || @panic("invalid sensing_of(%) property (%)", object, property);
            
            // TODO: there are special properties for pos/dir/costume/size/volume
            // always the main sprite not a clone
            return @fmt(out, "s.canvas.clones[%].vars()[%]", class_i, var_i);
        }
        @default => {
            if @is(it.op, .data_hidevariable, .data_showvariable, .data_hidelist, .data_showlist) {
                var := it.args[0];
                i, s := @match(var.op) {
                    fn franca_var() => (self.current_sprite, "s.sprite");
                    fn franca_var_stage() => (0, "s.canvas.stage");
                    @default => @panic("% invalid argument %", it.op, var.op);
                };
                sprite := self.project.sprites[i]&;
                ::ptr_utils(Node);
                m := sprite.monitors.items().index_of(fn(jt) => identical(jt.var, var)) || {
                    // the project.json didn't contain a monitor entry for this. 
                    // TODO: need to remember that it doesn't have a position so do auto-layout based on order the show blocks run. 
                    push(sprite.monitors&, (x = 10, y = 10, hide = true, mode = .Value, var = var), temp());
                    sprite.monitors.len - 1
                }; 
                h := @is(it.op, .data_hidevariable, .data_hidelist);
                return @fmt(out, "%.class.monitors[%].hide = %;\n", s, m, h);
            };
            
            if @is(it.op, .looks_costumenumbername, .sensing_current) {
                suffix := it.args[0].string;
                it.flags.type = @if(it.op == .sensing_current || suffix == "number", .Float, .String);
                @assert(simple_ops.op_names&.get_ptr(it.op).unwrap().contains(suffix), "TODO: %.%", it.op, suffix);
                return @fmt(out, "s.%_%()", it.op, suffix);
            };
            
            @panic("TODO: compile %", it.op);
        };
    };
}

fn compile_async(self: *Compile, continuation: []*Node) void = {
    out := self.out;
    @if(continuation.len == 0) return();
    it := continuation[0];
    continuation := continuation.rest(1);
    
    if !self.is_async(it) {
        compile(self, it);
        if continuation.len > 0 {
            compile_async(self, continuation);
        };
        return();
    };
    
    cont_id := self.next_cont_id; self.next_cont_id += 1;
    
    call_async :: fn() => @fmt(out, "return s.cont_%();\n", cont_id);  // like push_async(true) but without yielding
    push_async :: fn(ret: bool) => @fmt(out, "%s.push_async(cont_%);\n", @if(ret, "return ", ""), cont_id);
    declare_cont :: fn(debug: Str) => @fmt(out, "cont_% :: fn(s: *Rt.Script) void = {  // %.%\n", cont_id, it.op, debug);
    loop_body :: fn(body) => {
        push_async(false);
        def := self.current_def;
        if def.op != .procedures_definition {
            self.compile_async(@slice(body));
        } else {
            // TODO: if a slow block is only called from fast blocks, can make it fast and not have this check. and inverse if never called from fast. 
            tag := @if(!def.flags.run_without_screen_refresh, "check_refresh", "");
            cont: Node = (op = .franca_call_cont, args = empty(), string = tag, literal = cont_id.float(), flags = (async = .yes));
            self.compile_async(@slice(body, cont&));
        };
        @fmt(out, ";return()};\n");
    };
    
    if @is(it.op, .sensing_askandwait) {
        @fmt(out, "println(\"TODO: %\");\n", it.op);
        compile_async(self, continuation);
        return();
    };
    
    @match(it.op) {
        // the reciever pushes a cont that will decrement the waiter pointer 
        // when the script ends so the sender can wait without needing to 
        // allocate a tree of all the scripts being waited on. 
        fn event_broadcastandwait() => {
            @fmt(out, "idx := ");
            compile_lookup(self, it.op, it.args[0]);
            @fmt(out, ";\n");
            @fmt(out, "s.push_val_async(0);\n");
            @fmt(out, "waiter := s.data.futures[s.futures.len - 1]&;\n");
            @fmt(out, "waiter[] += s.canvas.send_event((Broadcast = idx), (Some = waiter)).float();\n");
            self.max_futures = max(self.max_futures, self.futures_depth + 2);
            push_async(true);

            declare_cont("spin");
            @fmt(out, "if s.futures[s.futures.len - 1] > 0 {\n");
            push_async(true); // continue waiting
            @fmt(out, "};\n");
            @fmt(out, "s.pop_async(1);  // %.end [count]\n", it.op); 
        }
        fn control_wait_until() => {
            self.max_futures = max(self.max_futures, self.futures_depth + 1);
            // the condition will never be async but it has to yield so that the state can change
            call_async();
            declare_cont("body");
            cond := it.args[0];
            @fmt(out, "if !");
            compile_cast(self, cond, .Bool);
            @fmt(out, " {\n");
            push_async(true);   // continue waiting
            @fmt(out, "};\n// %.end\n", it.op);
        }
        fn procedures_call() => {
            def := it.args[0];
            args := it.args[1].args;
            @debug_assert_eq(args.len, def.args[1].args.len);
            
            for args { it | 
                @fmt(out, "s.push_val_async(");
                compile(self, it);
                @fmt(out, ");\n");
                self.futures_depth += 1;  // later args can still reference our own args so don't mess up the stack
            };
            self.max_futures = max(self.max_futures, self.futures_depth + 1);
            self.futures_depth -= args.len;
            push_async(false);
            @fmt(out, "return s.@\"proc_% %\"();\n", def.literal, => self.safe_string_body(def.string));
            
            declare_cont("ret");
            if self.is_async(def) && def.flags.run_without_screen_refresh {
                @fmt(out, "s.without_refresh_depth -= 1;\n");
            };
            @fmt(out, "s.pop_async(%);  // %.end [..params]\n", args.len, it.op);
        }
        fn control_wait() => {
            t := it.args[0];
            @fmt(out, "duration := ");
            compile_cast(self, t, .Float);
            @fmt(out, " / (60*60*24);\n");
            @fmt(out, "s.push_val_async(sensing_dayssince2000(s) + duration);\n");
            push_async(true);
            self.max_futures = max(self.max_futures, self.futures_depth + 2);
            
            declare_cont("spin");
            @fmt(out, "if sensing_dayssince2000(s) < s.futures[s.futures.len - 1] {\n");
            push_async(true); // continue waiting
            @fmt(out, "};\n");
            
            @fmt(out, "s.pop_async(1);  // %.end [t]\n", it.op); 
        }
        fn franca_block() => {
            stmts := list(*Node, it.args.len + continuation.len, temp());
            stmts&.push_all(it.args);
            stmts&.push_all(continuation);
            return compile_async(self, stmts.items());
        }
        fn control_for_each() => {
            limit, body, var := (it.args[0], it.args[1], it.args[2]);
            @fmt(out, "s.push_val_async(");
            self.compile_cast(limit, .Float);
            @fmt(out, ");\n");
            @fmt(out, "s.push_val_async(0);\n");
            call_async();
            inc_futures(self, 3) {
                declare_cont("body");
                
                @fmt(out, "i := s.futures[s.futures.len - 1]&; i[] += 1;\n");
                @fmt(out, "if i[] <= s.futures[s.futures.len - 2] {\n");
                compile(self, var);
                @fmt(out, " = i[];\n");
                loop_body(body);
                
                @fmt(out, "s.pop_async(2);  // %.end [limit, i]\n", it.op); 
            };
        }
        fn control_repeat() => {
            limit, body := (it.args[0], it.args[1]);
            @fmt(out, "s.push_val_async(");
            self.compile_cast(limit, .Float);
            @fmt(out, ");\n");
            call_async();
            
            inc_futures(self, 2) {
                declare_cont("body");
                
                @fmt(out, "i := s.futures[s.futures.len - 1]&; i[] -= 1;\n");
                @fmt(out, "if i[] >= 0 {\n");
                loop_body(body);
                @fmt(out, "s.pop_async(1);  // %.end [i]\n", it.op);
            };
        }
        fn control_repeat_until() => {
            cond, body := (it.args[0], it.args[1]);
            call_async();
            
            declare_cont("body");
            @fmt(out, "if !");
            compile_cast(self, cond, .Bool);
            @fmt(out, " {\n");
            inc_futures(self, 1) {
                loop_body(body);
            };
        }
        // the ifs need to remember to call `continuation` at the end but don't want to
        // emit it's code twice. so emit into a function that both branches call at the end. 
        fn control_if_else() => {
            push_async(false);
            inc_futures(self, 1) {
                cont: Node = (op = .franca_call_cont, args = empty(), literal = cont_id.float(), flags = (async = .yes));
                @fmt(out, "if ");
                compile_cast(self, it.args[0], .Bool);
                @fmt(out, " {\n");
                compile_async(self, @slice(it.args[1], cont&));
                @fmt(out, "} else {\n");
                compile_async(self, @slice(it.args[2], cont&));
                @fmt(out, ";};\n");
            };
            declare_cont("end");
        }
        fn franca_call_cont() => {
            check_refresh := it.string == "check_refresh";
            @assert_eq(continuation.len, 0, "franca_call_cont");
            // TODO: direct call instead of pushing it to the stack but need to deal with scoping better 
            // @fmt(out, "return cont_%(s);\n", it.literal);
            if check_refresh {
                @fmt(out, "@if(s.without_refresh_depth == 0) return();\n");
            };
            //@fmt(out, "cont_% := bit_cast_unchecked(Rt.Value, @FnPtr(s: *Rt.Script) void, s.futures&.pop().unwrap());\n", it.literal);
            //@fmt(out, "return cont_%(s);\n", it.literal);
            @fmt(out, ";"); // TODO: why does scratchinscratch need this. bug with a value in statement position?
            @fmt(out, "s.no_yield = true; return();\n");
            return();
        }
        fn control_delete_this_clone() => {
            return @fmt(out, "control_delete_this_clone(s); return();\n");
        }
        @default => @panic("TODO: compile_async %", it.op);
    };
    
    compile_async(self, continuation);
    @fmt(out, "};  // end cont_%\n", cont_id);
}

fn inc_futures(self: *Compile, n: i64, $body: @Fn() void) void = {
    self.futures_depth += n;
    self.max_futures = max(self.max_futures, self.futures_depth);
    body();
    self.futures_depth -= n;
}

fn is_async(self: *Compile, it: *Node) bool = {
    if it.flags.async == .unknown {
        it.flags.async = @if(self.is_async_rec(it), .yes, .no);
    };
    it.flags.async == .yes
}

fn is_async_rec(self: *Compile, it: *Node) bool = {    
    @match(it.op) {
        fn procedures_definition() => {
            it.flags.mark_rec = true;
            prev := self.current_def;
            self.current_def = it;
            async := self.is_async(it.args[0]);
            self.current_def = prev;
            return async;
        };
        fn procedures_call() => {
            // TODO: should recursion be treated like a loop and have extra yields if !run_without_screen_refresh?
            def := it.args[0];
            if def.flags.mark_rec {
                // TODO: overly conservative because might not have gotten to the proc yet. need to iterate to fixed point. 
                //return def.flags.async != .no;
                // TODO: wrong ^
                return def.flags.async == .yes;
            };
            return self.is_async(def);
        }
        fn franca_block() => {
            for it.args { it |
                @if(self.is_async(it)) return(true);
            };
            false
        }
        fn control_if_else() => self.is_async(it.args[1]) || self.is_async(it.args[2]);
        @default => {
            is_loop := @is(it.op, .control_for_each, .control_repeat, .control_repeat_until);
            if is_loop {
                def := self.current_def;
                if def.op == .procedures_definition {
                    if def.flags.run_without_screen_refresh {
                        for it.args { it |
                            @if(self.is_async(it)) return(true);
                        };
                        return false;
                    };
                };
                // outside a run_without_screen_refresh proc, loops yield after each iteration. 
                return true;
            };
            // TODO: is thisevent_broadcast supposed to yield right away or just get queued until next yield?
            @is(it.op, .event_broadcastandwait, .sensing_askandwait, .control_wait, .control_wait_until, .control_delete_this_clone)
        };
    }
}

fn lower(self: *Compile, it: **Node) void = {
    a := temp();
    @match(it.op) {
        // TODO: this might be wrong. what happens if another script says something new while this one is waiting?
        fn looks_sayforsecs() => {
            msg, t := (it.args[0], it.args[1]);
            n := a.alloc_zeroed(Node, 5);
            n[0] = (op = .franca_block, args = @slice(n[1]&, n[2]&, n[3]&) a);
            n[1] = (op = .looks_say, args = @slice(msg) a);
            n[2] = (op = .control_wait, args = @slice(t) a);
            n[3] = (op = .looks_say, args = @slice(n[4]&) a);
            n[4] = (op = .franca_string, args = empty(), string = "");
            it[] = n[0]&;
        }
        // TODO: loop to lerp there
        fn motion_glidesecstoxy() => {
            t, x, y := (it.args[0], it.args[1], it.args[2]);
            n := a.alloc_zeroed(Node, 3);
            n[0] = (op = .franca_block, args = @slice(n[1]&, n[2]&) a);
            n[1] = (op = .control_wait, args = @slice(t) a);
            n[2] = (op = .motion_gotoxy, args = @slice(x, y) a);
            it[] = n[0]&;
        }
        fn control_while() => {
            cond, body := (it.args[0], it.args[1]);
            n := a.alloc_zeroed(Node, 2);
            n[0] = (op = .control_repeat_until, args = @slice(n[1]&, body) a);
            n[1] = (op = .operator_not, args = @slice(cond) a);
            it[] = n[0]&;
        }
        fn control_forever() => {
            body := it.args[0];
            n := a.alloc_zeroed(Node, 2);
            n[0] = (op = .control_repeat_until, args = @slice(n[1]&, body) a);
            n[1] = (op = .franca_literal, args = empty(), literal = 0);
            it[] = n[0]&;
        }
        fn control_if() => {
            cond, then := (it.args[0], it.args[1]);
            n := a.alloc_zeroed(Node, 2);
            n[0] = (op = .control_if_else, args = @slice(cond, then, n[1]&) a);
            n[1] = (op = .franca_block, args = empty());
            it[] = n[0]&;
        }
        fn argument_reporter_boolean() => {
            it.op = .argument_reporter_string_number;
            it.flags.type = .Bool;
        }
        fn motion_goto() => {
            it.op = .motion_gotoxy;
        }
        fn pen_changePenHueBy() => {
            value := it.args[0];
            n := a.alloc_zeroed(Node, 4);
            n[0] = (op = .pen_changePenColorParamBy, args = @slice(n[1]&, n[2]&) a);
            n[1] = (op = .franca_string, args = empty(), string = "hue");
            n[2] = (op = .operator_divide, args = @slice(value, n[3]&) a);
            n[3] = (op = .franca_literal, args = empty(), literal = 2);
            it[] = n[0]&;
        }
        fn pen_setPenHueToNumber() => {
            value := it.args[0];
            n := a.alloc_zeroed(Node, 4);
            n[0] = (op = .pen_setPenColorParamTo, args = @slice(n[1]&, n[2]&) a);
            n[1] = (op = .franca_string, args = empty(), string = "hue");
            n[2] = (op = .operator_divide, args = @slice(value, n[3]&) a);
            n[3] = (op = .franca_literal, args = empty(), literal = 2);
            it[] = n[0]&;
        }
        fn motion_turnright() => {
            value := it.args[0];
            n := a.alloc_zeroed(Node, 3);
            n[0] = (op = .motion_pointindirection, args = @slice(n[1]&) a);
            n[1] = (op = .operator_add, args = @slice(n[2]&, value) a);
            n[2] = (op = .motion_direction, args = empty());
            it[] = n[0]&;
        }
        fn motion_turnleft() => {
            value := it.args[0];
            n := a.alloc_zeroed(Node, 3);
            n[0] = (op = .motion_pointindirection, args = @slice(n[1]&) a);
            n[1] = (op = .operator_subtract, args = @slice(n[2]&, value) a);
            n[2] = (op = .motion_direction, args = empty());
            it[] = n[0]&;
        }
        fn operator_gt() => {
            it.op = .operator_lt;
            it.args.swap(0, 1);
        }
        // += would be more readable but then need to explicitly deal with when var is a string. 
        fn data_changevariableby() => {
            var, value := (it.args[1], it.args[0]);
            n := a.alloc_zeroed(Node, 2);
            n[0] = (op = .data_setvariableto, args = @slice(n[1]&, var) a);
            n[1] = (op = .operator_add, args = @slice(var, value) a);
            it[] = n[0]&;
        }
        @default => {
            if @is(it.op, .sound_sounds_menu, .looks_costume, .sensing_touchingobjectmenu, .looks_backdrops, .sensing_keyoptions, .control_create_clone_of_menu, .pen_menu_colorParam, .sensing_distancetomenu, .sensing_of_object_menu, .motion_pointtowards_menu) {
                it[] = it.args[0];
                @assert(@is(it.op, .franca_string, .franca_literal), "menu op expected a constant");
                return self.lower(it);
            };
        };
    };
    each it.args.rest(int(it.op == .procedures_call)) { it |
        self.lower(it);
    };
}

// oval inputs with drop downs can technically be computed strings but the common case is a constant string. 
fn compile_lookup(self: *Compile, op: S.Raw.Opcode, it: *Node) void = {
    out := self.out;
    // TODO: don't get bamboozled if you name your broadcast a number
    if it.op == .franca_string {
        string := it.string;
        if op == .sensing_keypressed {
            if Rt.key_indices.get(string) { i |
                return @fmt(out, "%", i);
            } else {
                @fmtln(self.warning&, "invalid key name (%)", string);
            };
        };
        if @is(op, .looks_switchcostumeto, .looks_switchbackdropto) {
            sprite_i := @if(op == .looks_switchcostumeto, self.current_sprite, 0);
            sprite := self.project.sprites[sprite_i]&;
            if sprite.costumes.index_of(fn(it) => it.name == string) { i |
                return @fmt(out, "%", i);
            } else {
                @fmtln(self.warning&, "invalid costume name for (%): (%)", sprite.name, string);
            };
        }
        if @is(op, .pen_setPenColorParamTo, .pen_changePenColorParamBy) {
            return @fmt(out, "%", Rt'lookup_pen_field_index(string));
        };
        if @is(op, .event_broadcastandwait, .event_broadcast) {
            if self.project.broadcasts.index_of(fn(it) => it.string == string) { i |
                return @fmt(out, "%", i);
            } else {
                @fmtln(self.warning&, "invalid broadcast name (%)", string);
            };
        };
        if op == .pen_setPenColorToColor {
            if Rt'string_to_colour(string) { i |
                return @fmt(out, "%", i);
            };
        };
    };
    
    if it.as_literal() { literal |
    if @is(op, .looks_switchcostumeto, .looks_switchbackdropto) {
        sprite_i := @if(op == .looks_switchcostumeto, self.current_sprite, 0);
        sprite := self.project.sprites[sprite_i]&;
        if literal > 0 && literal <= sprite.costumes.len.float() && literal == floor(literal) {
            return @fmt(out, "%", literal - 1);
        } else {
            @fmtln(self.warning&, "invalid costume index for (%): (%)", sprite.name, literal);
        };
    };
    if op == .pen_setPenColorToColor {
        return @fmt(out, "%", literal.floor());
    };
    };
    
    compile(self, it);
    
    @fmt(out, "%", @match(op) {
        fn looks_switchcostumeto() => ".lookup_costume_index(s.sprite)";
        fn looks_switchbackdropto() => ".lookup_costume_index(s.canvas.stage)";
        fn sensing_keypressed() => ".lookup_key_index(s)";
        fn pen_setPenColorParamTo() => ".coerce_string().Rt'lookup_pen_field_index()";
        fn pen_changePenColorParamBy() => ".coerce_string().Rt'lookup_pen_field_index()";
        fn event_broadcastandwait() => ".lookup_broadcast_index(s)";
        fn event_broadcast() => ".lookup_broadcast_index(s)";
        fn pen_setPenColorToColor() => ".Rt'coerce_colour()";
        @default => @panic("TODO: lookup for %", op);
    });
}

fn as_literal(it: *Node) ?f64 = {
    @match(it.op) {
        fn franca_literal() => (Some = it.literal);
        fn franca_string() => Rt'string_to_number(it.string);
        @default => .None;
    }
}

ValueType :: @enum(Float, String, Bool, Any, List, Index, Void);
fn push_cast(self: *Compile, dest_type: ValueType, src_type: ValueType) void = {
    suffix := ".from_bool()";
    if dest_type == .Bool && self.out.items().ends_with(suffix) {
        self.out.len -= suffix.len;
        return();
    };

    @if(dest_type == src_type) @match(dest_type) {
        fn Float() => return();
        fn String() => return(@fmt(self.out, ".to_obj()[].string.s"));
        fn Bool() => return(@fmt(self.out, ".to_bool_assume()"));
        @default => ();
    };
    
    @fmt(self.out, "%", @match(dest_type) {
        fn Bool() => ".to_bool()";
        fn String() => ".coerce_string()";
        fn List() => ".to_obj()[].list&";
        fn Float() => ".coerce_number()";   
        fn Void() => @panic("void isn't allowed as an input");
        fn Any() => "";
        fn Index() => "";   // lookup is inserted seperately
    });
}

fn const_string(self: *Compile, it: Str) i64 = 
    (self.string_lookup&.get_or_insert(it) {
        self.string_constants&.push(it);
        self.string_constants.len - 1
    })[];

fn var_index(self: *Compile, it: *Node) i64 = {
    @assert(@is(it.op, .franca_var, .franca_var_stage, .argument_reporter_string_number), "var_index %", it.op);
    i := it.literal.int() - 1;
    @assert_ult(i, self.project.sprites[@if(it.op == .franca_var_stage, 0, self.current_sprite)].variables.len, "var_index oob");
    i
}

fn embed_bytes(out: *List(u8), name: Str, data: Str) void = {
    @fmt(out, "% :: Rt'embed_bytes(\"", name);
    import("@/lib/encoding/base64.fr")'encode(out, data);
    @fmt(out, "\");\n");
}

simple_ops :: @static {
    Data :: @struct(need_self: bool, arg: []ValueType, ret: ValueType);
    out: OptionalEnumMap(S.Raw.Opcode, Data) = empty();
    op_names: HashMap(S.Raw.Opcode, RawList(Str)) = init(ast_alloc());
    I :: Type.scope_of(Rt.impl);
    for get_constants(I) { n | 
        name := n.str();
        fid := FuncId.get_constant(I, n).unwrap();
        func := get_function_ast(fid, false, false, false, false);
        s := func.arg.bindings[0].name.Ident == sym("s");
        if s {
            func.arg.bindings[0].ty = (Finished = *Rt.Script);
        };
        
        fix_type :: fn(it: *LazyType) ValueType = {
            ty := ValueType.Float;
            if it.is(.Infer) {
                it[] = (Finished = Rt.Value);
            };
            @if_let(it) fn PendingEval(e) => if e.ident() { s |
                (fr_ty: Type, sc_ty: ValueType) := @switch(s) {
                    @case(sym("Any")) => (Rt.Value, .Any);
                    @case(sym("List")) => (*RawList(Rt.Value), .List);
                    @case(sym("Str")) => (Str, .String);
                    @case(sym("i64")) => (i64, .Index);
                    @case(sym("bool")) => (bool, .Bool);
                    @case(sym("void")) => (void, .Void);
                    @default => compile_error("invalid scratch type", e.loc);
                };
                it[] = (Finished = fr_ty);
                ty = sc_ty;
            };
            ty
        };
        
        in := ValueType.list(func.arg.bindings.len, ast_alloc());
        each func.arg.bindings.items().rest(int(s)) { it |
            in&.push(fix_type(it.ty&));
        };
        ret := fix_type(func.ret&);
        @assert_ne(ret, .List, "lists aren't first class");
        if ret == .String {  
            // can't trivially convert from the slice back to the gc-ed Value, just want to remember the type info
            func.ret = (Finished = Rt.Value);
        };
        
        func := get_function_ast(fid, true, false, true, false);
        
        if S.Raw.Opcode.from_name(name) { op |
            out&.insert(op, (
                need_self = s, 
                arg = in.items(),
                ret = ret,
            ));
        } else {
            ok := false;
            if name.index_of("_".ascii()) { i |
                if name.rest(i + 1).index_of("_".ascii()) { j |
                    subname := name.rest(i + j + 2);
                    name := name.slice(0, i + j + 1);
                    if S.Raw.Opcode.from_name(name) { op |
                        ops := op_names&.get_or_insert(op, => empty());
                        ops.push(subname, ast_alloc());
                        ok = true;
                    };
                };
            };
            @if(!ok) @println("warning: unknown opcode in Rt.impl: %", name);
        };
    };
    @anon_literal(ops = out, op_names = op_names.raw)
};

// `v` needs to be in scope as a slice to write into. 
// im doing this in a convoluted way because:
// - strings/lists need to be allocated in the gc at runtime, so can't do the whole thing as a copy from a @const_slice.
// - im afraid of giant lists where the code generated for inlining a bunch of `v[_] = c.constants[_];` would be bigger than an array of indices to patch.
// - doing floats_blob by decoding a string (like the asset files) avoids dealing with my shitty float printing. 
fn init_list_values(self: *Compile, values: []*Node, floats_blob: *List(f64), is_var: bool) void = {
    @if(values.len == 0) return();
    out := self.out;
    Get :: fn(var: *Node) *Node => @if(is_var, var.args[0], var);
    
    // don't be wasteful if it's all strings, etc.
    first_float, last_float := (0, values.len - 1);
    while => first_float < values.len && values[first_float].Get()[].op != .franca_literal {
        first_float += 1;
    };
    while => last_float > first_float && values[last_float].Get()[].op != .franca_literal {
        last_float -= 1;
    };
    last_float += 1;
    @fmt(out, "v.slice(%, %).copy_from(floats_blob.subslice(%, %));\n", first_float, last_float, floats_blob.len, last_float - first_float);
    
    range(first_float, last_float) { i |
        value := values[i].Get();
        @match(value.op) {
            fn franca_literal() => floats_blob.push(value.literal);
            @default => floats_blob.push(0);  // franca_string|franca_block will be patched below
        };
    };
    
    if last_float - first_float != values.len {
        mark, any_strings := (out.len, false);
        @fmt(out, "indices := @const_slice(@as(u32) ");
        enumerate values { i, var |
            value := var[].Get();
            if value.op == .franca_string {
                @fmt(out, "%, %,", i, self.const_string(value.string));
                any_strings = true;
            };
        };
        @fmt(out, ");\nc.assign_strings(v, indices);\n");
        if !any_strings {
            out.len = mark;
        };
        
        // TODO: all lists are at the end so could do this in the above loop
        enumerate values { i, var |
            value := var[].Get();
            if value.op == .franca_block {
                @fmt(out, "l := a.alloc_uninit(Rt.Value, %);\n", value.args.len);
                @fmt(out, "v[%] = c.new_obj(list = l.as_raw_list());\n", i);
                if value.args.len != 0 {
                    @fmt(out, "{ v := l;\n");
                    init_list_values(self, value.args, floats_blob, false);
                    @fmt(out, "};\n");
                };
            };
        };
    };
}

S :: import("@/examples/gpu/hctarcs/builder.fr");
Node :: S.Node;
Rt :: import("@/examples/gpu/hctarcs/runtime.fr");
#use("@/lib/collections/enum_map.fr");
Viewer :: import("@/examples/gpu/viewer.fr");

// these are pointless but i like the idea of not deleting information so if you end up with only the generated file somehow you could tecnically reconstruct the scratch project. 
// TODO: include scratch comment blocks and block hat positions and credits. 
fn emit_debug_sprite(self: *Compile, it: *S.Sprite) void = {
    out := self.out;
    @fmt(out, "// (sprite=(name=\"%\", vars=(", => self.safe_string_body(it.name));
    for it.variables { it |
        @fmt(out, "\"%\", ", => self.safe_string_body(it.string));
    };
    @fmt(out, ")));\n");
};
fn emit_debug_block(self: *Compile, it: *Node) void = {
    out := self.out;
    @fmt(out, "// (block=(proccode=\"%\", params=(", => self.safe_string_body(it.string));
    for it.args[1].args { it |
        @fmt(out, "\"%\", ", => self.safe_string_body(it.string));
    };
    @fmt(out, ")));\n");
};
