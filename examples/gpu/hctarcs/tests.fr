// https://github.com/LukeGrahamLandry/hctarcs/blob/b116b2418f949cda03e962c93a997e5ccba6dac1/tests/mandelbrot.scratch
// https://scratch.mit.edu/projects/945435432
#use("@/examples/gpu/hctarcs/builder.fr");
mandelbrot :: fn() *Project = {
p, stage := new_project();
stage.costume(name = "blank", fmt = "png", data = empty_png);

s := p.sprite(name = "main");
s.costume(name = "blank", fmt = "png", data = empty_png);

half_width, half_height, x, y, zSqX, zSqY, zX, zY, steps := s.variables(9);

calc_steps := s.define(true, fn(cX, cY) => (
    set(steps, N(0)),
    set(zX, N(0)),
    set(zY, N(0)),
    set(zSqX, N(0)),
    set(zSqY, N(0)),
    repeatuntil(or(!(steps < N(40)), !(zSqX + zSqY < N(4))), => (
        set(zY, zY * N(2) * zX),
        set(zX, zSqX - zSqY),
        set(zX, zX + cX),
        set(zY, zY + cY),
        set(zSqX, zX * zX),
        set(zSqY, zY * zY),
        set(steps, steps + N(1)),
    )),
));

do_work := s.define(true, => ( 
    gotoxy(N(10000), N(10000)),   // clamped so this calulates the stage size (half of 480x360, center is 0,0)
    set(half_width, xposition()),
    set(half_height, yposition()),
    set(x, N(0)),
    repeatuntil(!(x < N(2) * half_width), => (
        penup(),
        gotoxy(x - half_width, N(0) - half_height),
        pendown(),
        set(y, N(0)),
        repeatuntil(!(y < N(2) * half_height), => (
            call(calc_steps, => (
                (x - half_width) / N(150),
                (y - half_height) / N(150),
            )),
            if(steps == N(40), => (
                setpencolor(N(65280)),
            ), => (
                setpencolor(N(255)),
            )),
            gotoxy(x - half_width, y - half_height),
            set(y, y + N(1))
        )),
        set(x, x + N(1))
    )), 
));
reset := s.define(true, => (
    peneraseall(),
    penup(),
    gotoxy(N(0), N(0)),
));

s.whenflagclicked(=> (
    call(reset, => ()),
    call(do_work, => ()),
));

p
};

// https://github.com/LukeGrahamLandry/hctarcs/blob/b116b2418f949cda03e962c93a997e5ccba6dac1/tests/stamp_pos.scratch
stamp_pos :: fn() *Project = {
    p, stage := new_project();
    stage.costume(name = "blank", fmt = "png", data = empty_png);
    
    s := p.sprite(name = "main");
    red, green, blue := s.rgb_triangles();
    
    once := s.define(true, fn(x, y, name) => (
        set_costume(name),
        gotoxy(x, y),
        pen_stamp(),
    ));
    
    line := s.define(true, fn(x, y, count) => (
        repeat(count, => (
            change_x(x),
            change_y(y),
            pen_stamp(),
        )),
    ));
    
    render := s.define(true, => (
        set_size(N 200),
        gotoxy(N 0, N 0),
        peneraseall(),
        set_costume(red),
        call(line, => (N 10, N 10, N 10)),
        call(once, => (N 240, N 180, blue)),
        call(once, => (N(-240), N(-180), green)),
        call(once, => (N(-240), N 180, red)),
        call(once, => (N 240, N(-180), red)),
        call(line, => (N 10, N 10, N 10)),
        gotoxy(N 100, N 100),
        set_costume(blue),
        call(line, => (N 10, N 0, N 10)),
        set_costume(green),
        call(line, => (N 0, N(-10), N 10)),
        set_costume(red),
        call(line, => (N 10, N 0, N 3)),
        set_costume(green),
        gotoxy(N 0, N(-10)),
    ));
    
    s.whenflagclicked(=> call(render, => ()));
    p
};

stamp_pos_async :: fn() *Project = {
    p, stage := new_project();
    stage.costume(name = "blank", fmt = "png", data = empty_png);
    
    s := p.sprite(name = "main");
    red, green, blue := s.rgb_triangles();
    
    s.whenflagclicked(=> (
        forever(=> (
            say(N("mouse: ").join(mouse_x()).join(N" ").join(mouse_y()).join(N" ").join(mouse_down())),
        )),
    ));
    
    s.whenspriteclicked(=> (
        next_costume(),
    ));
    
    s.whenflagclicked(=> (
        peneraseall(),
        set_costume(green),
        gotoxy(N 0, N 0),
        repeat(N 10, => (
            repeat(N 5, => (
                pen_stamp(),
                wait(N(0.1)),
                change_x(N 10),
                repeat(N 5, => (
                    pen_stamp(),
                    wait(N(0.1)),
                    change_y(N 10),
                )),
            )),
            set_costume(red),
            
            repeat(N 5, => (
                pen_stamp(),
                wait(N(0.1)),
                change_x(N(-10)),
                repeat(N 5, => (
                    pen_stamp(),
                    wait(N(0.1)),
                    change_y(N(-10)),
                )),
            )),
            
            set_costume(green),
            change_x(N 20),
        )),
    ));
    
    s := p.sprite(name = "other");
    n := s.variables(1);
    s.costume(name = "blank", fmt = "png", data = empty_png);
    s.whenflagclicked(=> (  // draw a rainbow octagon with increasing side widths
        set_direction(N(0)),
        penup(),
        gotoxy(N(-100), N(100)),
        pendown(),
        repeat(N(8), => (
            wait(N(0.1)),
            set_colour_param(N("color"), n * N(100/8)),
            set(n, n + N(1)),
            pen_size(n),
            move_steps(N(20)),
            set_direction(get_direction() + N(45)),
        )),
        hide(),
    ));
    
    p
};

// https://github.com/LukeGrahamLandry/hctarcs/blob/b116b2418f949cda03e962c93a997e5ccba6dac1/tests/sanity.scratch
// Run this in real Scratch when adding new tests to make sure they're correct. 
sanity :: fn() *Project = {
    p, s := new_project();
    s.costume(name = "blank", fmt = "png", data = empty_png);
    
    a, test_count := s.variables(2);
    lst, callstack, fail_msgs := s.lists(3);
    
    failed := s.define(true, fn(msg) => (
        append(fail_msgs, msg),
    ));
    
    EQ := s.define(true, fn(a, b, msg) => (
        set(test_count, test_count + N(1)),
        if(or(not(a == b), not(b == a)), => (
            call(failed, => N("Failed ").join(msg).join(N": Expected (").join(a).join(N") == (").join(b).join(N")"))
        )),
    ));
    
    NE := s.define(true, fn(a, b, msg) => (
        set(test_count, test_count + N(1)),
        if(or(a == b, b == a), => (
            call(failed, => N("Failed ").join(msg).join(N": Expected (").join(a).join(N") != (").join(b).join(N")"))
        )),
    ));
    
    fib := s.forward_declare();
    s.define(fib, true, fn(n) => (
        if(n < N(2), => (
            append(callstack, n),
        ), => (
            call(fib, => (n - N(1))),
            call(fib, => (n - N(2))),
            append(callstack, get(callstack, length(callstack)) + get(callstack, length(callstack) - N(1))),
            delete(callstack, length(callstack) - N(1)),
            delete(callstack, length(callstack) - N(1)),
        )),
    ));
    
    test_fib := s.define(true, fn(n, expected) => (
        call(EQ, => (length(callstack), N 0, N"empty start")),
        call(fib, => (n)),
        call(EQ, => (get(callstack, length(callstack)), expected, N"fib")),
        delete(callstack, length(callstack)),
        call(EQ, => (length(callstack), N 0, N"empty end")),
    ));
    
    cases := s.define(true, => (
        call(EQ, => (N 1, N 1, N"int comp")),
        call(NE, => (N 1, N 2, N"not comp")),
        // call(NE, => (N"", N 0, N"null comp indirect")),
        call(EQ, => (N"a", N"a", N"str comp")),
        call(NE, => (N"a", N"b", N"str comp")),
        
        set(a, N"1"),
        call(EQ, => (a, N"1", N"var eq")),
        call(EQ, => (a, N 1, N"var eq coerce")),
        
        set(a, N"a"),
        call(EQ, => (a, N"a", N"var eq")),
        
        call(EQ, => (length(lst), N 0, N"start empty")),
        append(lst, N"c"),
        append(lst, N 5),
        append(lst, N"true"),
        call(EQ, => (length(lst), N 3, N"pushed poly")),
        replace(lst, N 4, N"nope"),
        call(EQ, => (length(lst), N 3, N"no replace grow")),
        call(EQ, => (get(lst, N 1), N"c", N"1st")),
        call(EQ, => (get(lst, N 2), N 5, N"2nd")),
        call(EQ, => (get(lst, N 3), N"true", N"3rd")),
        delete_all(lst),
        call(EQ, => (length(lst), N 0, N"cleared")),
        
        append(lst, N"a"),
        append(lst, N"b"),
        append(lst, N"c"),
        call(EQ, => (length(lst), N 3, N"push")),
        call(EQ, => (get(lst, length(lst)), N"c", N"top")),
        delete(lst, length(lst)),
        call(EQ, => (length(lst), N 2, N"rm")),
        call(EQ, => (get(lst, length(lst)), N"b", N"top")),
        delete(lst, length(lst)),
        call(EQ, => (length(lst), N 1, N"rm")),
        call(EQ, => (get(lst, length(lst)), N"a", N"top")),
        delete(lst, length(lst)),
        call(EQ, => (length(lst), N 0, N"rm")),
        
        call(EQ, => (mathop("sin", N 90), N 1, N"sin degrees")),
        call(EQ, => (mathop("asin", N 1), N 90, N"asin degrees")),
        call(EQ, => (mod(N 5, N 3), N 2, N"basic mod")),
        
        //call(EQ, => (N(1) + (N(1) == N(1)), N(2), N"num bool")),
        //call(EQ, => (N(1) + (N(1) == N(2)), N(1), N"num bool")),
        
        call(EQ, => (join(N"a", N"b"), N"ab", N"str concat")),
        call(EQ, => (letter(N"ab", N 1), N"a", N"str letter")),
        call(EQ, => (letter(join(N"a", N"b"), N 2), N"b", N"str letter")),
        call(EQ, => (join(letter(N"ab", N 1), letter(N"ab", N 2)), N"ab", N"str letter concat")),
        call(NE, => (letter(N"ab", N 1), letter(N"ab", N 2), N"not str letter")),
        
        call(test_fib, => (N 3, N 2)),
        call(test_fib, => (N 5, N 5)),
        call(test_fib, => (N 7, N 13)),
    ));
    
    s.whenflagclicked(=> (
        set(test_count, N 0),
        delete_all(lst),
        delete_all(fail_msgs),
        call(cases, => ()),
        if(not(length(fail_msgs) == N(0)), => (
            say(N("failed ").join(length(fail_msgs)).join(N" of ").join(test_count)),
            show_list(fail_msgs),
        ), => (
            say(N("all is fine! passed ").join(test_count)),
        )),
    ));
    
    p
}

rgb_triangles :: fn(s: *Sprite) Ty(*Node, *Node, *Node) = {
    red := s.costume(name = "red", fmt = "png", data = make_triangle(0xFF0000FF));
    green := s.costume(name = "green", fmt = "png", data = make_triangle(0xFF00FF00));
    blue := s.costume(name = "blue", fmt = "png", data = make_triangle(0xFFFF0000));
    (red, green, blue)
};

empty_png :: write_png(@slice(@as(u32) 0), 1);

make_triangle :: fn(colour: u32) []u8 = {
    w := 20;
    out := temp().alloc_zeroed(u32, w*w);
    range(0, w) { y |
        range(w/2-y/2, w/2+y/2) { x |
            out[y*w + x] = colour;
        };
    };
    write_png(out, w)
}

// AABBGGRR
write_png :: fn(pixels: []u32, w: i64) []u8 = {
    out := @ref u8.list(ast_alloc());
    #use(Stb);
    callback: stbi_write_func : fn(context, data, size) = {
        data := u8.ptr_from_raw(data).slice(size.zext());
        List(u8).ptr_from_raw(context).push_all(data);
    };
    w := intcast(w);
    res := stbi_write_png_to_func(callback, List(u8).raw_from_ptr(out), w, intcast(pixels.len)/w, 4, u32.raw_from_ptr(pixels.ptr), w*4);
    @assert(res != 0, "failed to write image");
    out.items()
}

Stb :: {
    root := Foreign'stb();
    Ffi  :: import("@/examples/import_c/ffi.fr");
    c_source := @tfmt("""
        #define STB_IMAGE_WRITE_IMPLEMENTATION
        #define STBI_WRITE_NO_STDIO
        #include "%/stb_image_write.h"
    """, root);
    allow :: @const_slice("realloc", "puts", "exit", "malloc", "memmove", "free", "memcpy", "abs");
    Ffi'include(current_compiler_context(), c_source, (whitelist = (Some = allow)))
};
