
FEAT_UI :: true;
FEAT_LOADER :: true;  // embed the franca compiler so new projects can be jitted at runtime
FEAT_BUILTIN :: true;  // embed (aot) the example projects listed in ./main.fr

State :: @rec @struct {
    draw: Sgl.Self;
    img: Sg.Image;
    canvas: Rt.Canvas;
    images: List(Img);
    image_i: i64;
    builtin_image_count: i64;
    dirty: bool;
    ui: Ui.State;
    canvas_active: bool;
    
    turbo_mode: bool;
    paused: bool;
    allow_full_fps: bool;
    fps_limit_parity: bool;
    
    loader: LoaderT;
    buf: List(u8);
    source: Str;
};

// all builtins and at most one jitted will have initialize=true. 
// for jitted, title will be the path/projectid and selecting it again will recompile.
Img :: @struct(initialize: ?@FnPtr(c: *Rt.Canvas) void, title: Str);

fn on_render(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    state.fps_limit_parity = !state.fps_limit_parity;
    if !state.allow_full_fps && state.fps_limit_parity {
        sapp.webgpu.noframe = true;
        return();
    };
    // while loading want to update the time display. when done need to run ui to enable the canvas. 
    if !state.fps_limit_parity && (state.loader.start_time != 0 || state.builtin_image_count == 0) {
        state.dirty = true;
    };
    
    c := state.canvas&;
    if Easy'should_skip_frame(sapp, state.dirty&) {
        state.ui.idle_last_frame = true;
        return();
    };
    
    @if(FEAT_LOADER) state.loader&.check();
    
    if !state.paused && state.canvas_active {
    // TODO: don't spam if all are in a wait block
    ran := 1;
        if state.turbo_mode {
            start := timestamp();
            while => ran != 0 && timestamp() - start < 10 {
                range(0, 5) { _ |
                    if ran != 0 {
                        ran = c.poll_scripts();
                    };
                };
            };
        } else {
            ran = c.poll_scripts();
        };
    state.dirty = ran != 0;
    
    Rt'Render'finish_frame(c);
    
    data := c.frame_pixels;
    each data { it |
        it[] = it[].rotate_left(8).byte_swap();  // TODO: slow
    };
    };
    
    Easy'glue_begin_pass(sapp, sg, zeroed(Sg.PassAction));
    if state.canvas_active {
    Easy'draw_screen_fit_image(sg, sapp, state.draw&, state.img, c.frame_pixels, c.size.x / c.size.y);
    state.draw&.draw_layer(sg, 0);
    };
    @if(FEAT_UI) {
        input_end_with_idle(state.ui&, => draw_ui(state));
        draw(state.ui&, sg, sapp);
    };
    sg.end_pass();
    sg.commit();
};

fn on_init(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    state.buf = list(general_allocator());
    @if(FEAT_UI) on_init(state.ui&, sg);
    init(state.loader&, state);
    sapp.desc.enable_dragndrop = true;;
    sapp.desc.enable_clipboard = true;
    state.draw&.setup(allocator = general_allocator(), sg = sg, max_commands = 2, max_vertices = 6);
    state.img = sg.make(width = 480, height = 360, pixel_format = .RGBA8, data = zeroed(Sg.ImageData), usage = .DYNAMIC);
    state.images = list(general_allocator());
    
    @run @ct_assert(FEAT_BUILTIN || FEAT_LOADER, @source_location, "no projects makes this program useless");
    state.dirty = true;
    @if(FEAT_BUILTIN)
    inline_for builtin_sources { $src |
        S :: import(@afmt(ast_alloc(), "{ % };", src[]));
        state.images&.push(
            initialize = (Some = @run S.initialize),
            title = @if(S.metadata.len() > 2, S.metadata[1], /*:leak*/@afmt(general_allocator(), "%", state.images.len)),
        );
    };
    state.builtin_image_count = state.images.len;
    next_example(state, 0);
    
    for cli_args() { it |
        it := it.str();
        if it.ends_with(".sb3") || !it.contains(fn(c) => dec_digit(c[]).is_none()) {
            load_project_async(state, it, true);
        };
    };
}

key_to_index :: fn(key: Sapp.Keycode) i64 = {
    name := @match(key) {
        fn SPACE() => "space";
        fn LEFT() => "left arrow";
        fn RIGHT() => "right arrow";
        fn UP() => "up arrow";
        fn DOWN() => "down arrow";
        @default => {
            name := key.name_str();
            @if_else {
                @if(name.len == 1 && name[0].is_ascii_alpha()) => @slice(name[0].ascii_to_lower());
                @if(name.len == 2 && name[0] == "_".ascii() && name[1].is_ascii_digit()) => name.subslice(1, 1);
                // TODO: unnamed keys (but not shift/command/etc.) should count for "any"
                @else => return(-1);
            }
        };
    };
    Rt.key_indices.get(name).unwrap()
}

fn key_event(c: *Rt.Canvas, key: Sapp.Keycode, down: bool) void = {
    idx := key_to_index(key);
    @if(idx == -1) return();
    any_index := 5;
    pressed := c.sensing.pressed&;
    pressed.set(idx, down);
    pressed.set(any_index);
    pressed.set(any_index, pressed.count_ones() > 1);
}

fn on_event(state: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = {
    @if(FEAT_UI) on_event(state.ui&, sapp, event);
    
    if state.canvas_active && send_event(state.canvas&, sapp, event) {
        state.dirty = true;
    };
    
    @match(event.type) {
        fn RESIZED() => { state.dirty = true; };
        fn KEY_DOWN() => @match(event.key_code) {
            fn LEFT_BRACKET() => state.next_example(-1);
            fn RIGHT_BRACKET() => state.next_example(1);
            @default => ();
        };
        fn FILES_DROPPED() => for event.drop { it |
            load_project_async(state, it, true);
        };
        @default => ();
    };
}

fn send_event(c: *Rt.Canvas, sapp: *Sapp.Self, event: *Sapp.Event) bool = {
    @match(event.type) {
        fn KEY_DOWN() => {
            key_event(c, event.key_code, true);
                
                // on_event will get repeats which send_event will ignore until the old script is done
                c.send_event(KeyPress = key_to_index(event.key_code));
        };
        fn KEY_UP() => key_event(c, event.key_code, false);
        fn MOUSE_MOVE() => {
            c.sensing.mouse.pos = mouse_to_canvas(c, event, sapp);
        }
        // the "mouse down?" block starts returning true when any button mouse is pressed 
        // and starts returning false when any is released (even if some others are still pressed). 
        // ex. [left down, middle down, middle up] results in false. 
        fn MOUSE_UP() => { c.sensing.mouse.down = false; }
        fn MOUSE_DOWN() => { 
            c.sensing.mouse.down = true; 
            
            pos := mouse_to_canvas(c, event, sapp);
            for c.clones { sprite |
                continue :: local_return;
                @if(sprite.looks.hide) continue();
                // TODO: precompute per class
                @if(!sprite.class.events.contains(fn(it) => it.trigger&.is(.SpriteClicked))) continue();

                // TODO: how is this supposed to interact with transparency?
                // TODO: does it count if you're behind another sprite?
                // TODO: factor out to share with "is touching (mouse-pointer)?"
                
                // HACK: since i don't render svgs, hold shift to have clicks be sent to everyone. makes a few more projects kinda usable for now. 
                if event.modifiers.get(.shift) == 0 {
                img := sprite.class.costumes[sprite.looks.costume];
                size := vec2(img.width.float().cast(), img.height.float().cast());
                corner := sprite.pos - size/2;
                local := pos - corner;
                if !(local.x >= 0 && local.y >= 0 && local.x < size.x && local.y < size.y) {
                    continue();
                };
                };
                
                c.send_event(sprite, .SpriteClicked, .None);
            };
        }
        fn MOUSE_SCROLL() => {
            // TODO
        }
        @default => return(false);
    };
    true
}

fn mouse_to_canvas(c: *Rt.Canvas, event: *Sapp.Event, sapp: *Sapp.Self) Vec2 = {
    size := {  // commit_screen_fit_image starts in top level and fits to the smaller dimension
        screen := vec2(sapp.width().float().cast(), sapp.height().float().cast());
        aspect := (screen.x / screen.y) / (c.size.x / c.size.y);
        size := vec2(@if(aspect > 1, 1/aspect, 1), @if(aspect < 1, aspect, 1));
        screen * size
    };
    pos := vec2(event.mouse_x, event.mouse_y);
    pos := clamp(pos, vec2(0), size);
    pos := floor(pos / size * c.size);
    pos -= c.size / 2;
    pos.y *= -1;
    pos
}

fn next_example(state: *State, delta: i64) void = {
    @if(state.images.len == 0) return();
    state.dirty = true;
    state.image_i = mod(state.image_i + delta + state.images.len, state.images.len);
    
    c := state.canvas&;
    img := state.images[state.image_i];
    initialize := img.initialize || {
        return load_project_async(state, img.title, false);
    };
    @if(state.canvas_active) drop(c);
    init_canvas(c, general_allocator(), initialize);
    state.canvas_active = true;
    c.send_event(.Flag);
    state.paused = false;
}

driver :: fn(vtable: *ImportVTable) void = Easy'build_for_graphics2(vtable, @source_file_name(), true);
main :: fn() void = Easy'start(State);
#use("@/graphics/lib.fr");

fn on_cleanup(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    drop(state.loader&);
    drop(state.buf&);
    @if(state.canvas_active) drop(state.canvas&);
    for state.images.items().rest(state.builtin_image_count) { it |
        general_allocator().dealloc(u8, it.title);
    };
    drop(state.images&);
    sg.destroy(state.img);
    state.draw&.destroy(sg, general_allocator());
    @if(FEAT_UI) on_cleanup(state.ui&, sg);
}

Rt :: import("@/examples/gpu/hctarcs/runtime.fr");
builtin_sources :: import("@/examples/gpu/hctarcs/main.fr").src;
Ui :: import("@/graphics/deps/nuklear.fr");

fn draw_ui(state: *State) void #use(Ui.Nuklear) = {
    S :: fn(s: CStr) => bit_cast_unchecked(*u8, *i8, s.ptr);
    SS :: fn(s: Str) => bit_cast_unchecked(*u8, *i8, s.ptr);
    ctx, c := (state.ui.ctx&, state.canvas&);
    flags := (@as(u32) nk_panel_flags.NK_WINDOW_MOVABLE).bit_or(@as(u32) nk_panel_flags.NK_WINDOW_SCALABLE).bit_or(@as(u32) nk_panel_flags.NK_WINDOW_MINIMIZABLE);
    if nk_begin(ctx, S"", nk_rect(10, 10, 300, 300), flags) {
        if nk_tree_push_hashed(ctx, .NK_TREE_NODE, S"Controls", .NK_MAXIMIZED, S"", 0, 0) {
            nk_layout_row_static(ctx, 0, 60, 4);
            // TODO: need to be able to resend flag without resetting the sprites
            if nk_button_label(ctx, S"Reset") {
                next_example(state, 0);
            };
            // TODO: to make pausing more sane i should change how the wait timers work. 
            //       currently they use absolute time so can't be paused. 
            nk_checkbox_label(ctx, S"Pause", state.paused&);
            nk_checkbox_label(ctx, S"Turbo", state.turbo_mode&);
            nk_checkbox_label(ctx, S"60fps", state.allow_full_fps&);
            nk_tree_pop(ctx);
        };
        
        if nk_tree_push_hashed(ctx, .NK_TREE_NODE, S"Projects", .NK_MINIMIZED, S"", 0, 1) {
            nk_layout_row_dynamic(ctx, 0, 2);
            
            @if(FEAT_LOADER) {
                // TODO: this really needs paste
                buf := @static_mut zeroed(Array(u8, 256));  // TODO: be thread safe if multiple *State embeded (like maze_game would)
                length := @static_mut @as(i32) 0;
                // TODO: need to make enum as flags like this less painful
                flags := (@as(u32) nk_edit_flags.NK_EDIT_ALWAYS_INSERT_MODE).bit_or(@as(u32) nk_edit_flags.NK_EDIT_SIG_ENTER).bit_or(@as(u32) nk_edit_flags.NK_EDIT_SELECTABLE).bit_or(@as(u32) nk_edit_flags.NK_EDIT_CLIPBOARD);
                r := nk_edit_string(ctx, flags, bit_cast_unchecked(*u8, *i8, buf.as_ptr()), length, buf.items().len().intcast(), nk_filter_default);
                flags := @as(u32) nk_edit_events.NK_EDIT_COMMITTED;
                if nk_button_label(ctx, S"Load") || r.bit_and(flags) != 0 {
                    path := buf.items().slice(0, length[].intcast());
                    load_project_async(state, path, true);
                };
            };
            
            @if(nk_button_label(ctx, S"Prev")) next_example(state, -1);
            @if(nk_button_label(ctx, S"Next")) next_example(state, 1);
            
            nk_layout_row_dynamic(ctx, 0, 1);
            enumerate state.images { i, it |
                s := S(@fmt_cstr("%", it.title));
                if nk_button_label(ctx, s) {
                    state.image_i = i;
                    next_example(state, 0);
                };
            };
            nk_tree_pop(ctx);
        };
        
        if nk_tree_push_hashed(ctx, .NK_TREE_NODE, S"Sprites", .NK_MINIMIZED, S"", 0, 2) {
            nk_layout_row_dynamic(ctx, 0, 2);
            @if(state.canvas_active)
            enumerate c.clones { i, sprite |
                nk_label(ctx, S(@fmt_cstr("%", sprite.class.name)), 0);
                if nk_button_label(ctx, S"Click") {
                    c.send_event(sprite[], .SpriteClicked, .None);
                };
            };
            nk_tree_pop(ctx);
        };
        
        if nk_tree_push_hashed(ctx, .NK_TREE_NODE, S"Monitors", .NK_MINIMIZED, S"", 0, 3) {
            nk_layout_row_dynamic(ctx, 20, 2);
            
            buf := @ref u8.list(temp());
            m_i: i32 = 0;
            @if(state.canvas_active)
            each c.classes { class |
                continue :: local_return;
                sprite := c.clones.find(fn(it) => identical(it.class, class)) || continue();
                vars := sprite[].vars();
                m_i += 1;
                each class.monitors { m |
                    if !m.hide {
                        buf.clear();
                        name := S(@fmt_cstr("%", m.name));
                        
                        value := vars[m.var];
                        if value.is_list() {
                            l := value.to_obj()[].list;
                            nk_layout_row_dynamic(ctx, 100, 1);
                            flags := (@as(u32) nk_panel_flags.NK_WINDOW_TITLE);
                            if nk_group_begin(ctx, name, flags) {
                                nk_layout_row_dynamic(ctx, 20, 1);
                                enumerate l { i, value |
                                    buf.clear();
                                    coerce_string(value[], buf);
                                    nk_label(ctx, S(@fmt_cstr("%. %", i, buf.items())), 0);
                                };
                                nk_group_end(ctx);
                            };
                            nk_layout_row_dynamic(ctx, 20, 2);
                        } else {
                            nk_label(ctx, name, 0);
                            coerce_string(value, buf);
                            @match(m.mode) {
                                fn Slider(it) => {
                                    step := @if(it.discrete, 1.0, 0.1);
                                    nk_property_double(ctx, S("#"), it.lo, vars[m.var]&, it.hi, step, step.cast());
                                }
                                @default => {
                                    nk_label(ctx, S(@fmt_cstr("%", buf.items())), 0);
                                };
                            };
                        };
                    };
                };
            };
            nk_tree_pop(ctx);
        };
        
        if state.canvas_active {
        @if(c.metadata.credits.len != 0) text_box(ctx, S"Credits", 4, c.metadata.credits);
        @if(c.metadata.warning.len != 0) text_box(ctx, S"Warnings", 5, @slice(c.metadata.warning));
        };
        
        @if(FEAT_LOADER) {
            self := state.loader&;
            if self.start_time != 0 || state.image_i >= state.builtin_image_count {
                s := @if(@is(self.progress, .Idle, .Ready), 
                    state.buf.items(),
                    @tfmt("loading for %ms", timestamp() - self.start_time));
                text_box(ctx, S"Loader Log", 6, @slice(s));
                text_box(ctx, S"Generated Code", 7, @slice(state.source));
            };
        };
        
        // TODO: probably need to make it a edit box so you can copy from it. 
        text_box :: fn(ctx: *nk_context, name: *i8, id: i32, text: []Str) void =
        if nk_tree_push_hashed(ctx, .NK_TREE_NODE, name, .NK_MINIMIZED, S"", 0, id) {
            nk_layout_row_dynamic(ctx, 200, 1);
            if nk_group_begin(ctx, name, 0) {
                for text { it |
                    nk_layout_row_static(ctx, 13, 5000, 1);
                    i := 0;
                    start := 0;
                    while => i < it.len {
                        if it[i] == "\n".ascii() {
                            if i > start {
                                it := it.slice(start, i);
                                nk_text(ctx, SS(it), it.len.intcast(), 0);
                            };
                            start = i + 1;
                        };
                        i += 1;
                    };
                    if i > start {
                        it := it.slice(start, i);
                        nk_text(ctx, SS(it), it.len.intcast(), 0);
                    };
                    if text.len > 1 {
                    nk_layout_row_dynamic(ctx, 2, 1);
                    nk_rule_horizontal(ctx, (r=255,g=255,b=255,a=255), true);
                    };
                };
                nk_group_end(ctx);
            };
            nk_tree_pop(ctx);
        };
    };
    nk_end(ctx);
}

main_use_output :: fn(state: *State, in: LoaderT.I, out: Result(LoaderT.O, void)) void = {
    @if_let(out) fn Ok(it) => {
        initialize := it.initialize;
        state.images[in.image_i].initialize = (Some = initialize);
        state.image_i = in.image_i;
        next_example(state, 0);
        
        if !FEAT_UI {
            eprint(state.canvas.metadata.warning);
        };
    };
};

fn load_project_async(state: *State, path: Str, new: bool) void = {
    // TODO: show these errors in the ui instead
    @if(!FEAT_LOADER) return(eprintln("FEAT_LOADER is disabled"));
    // TODO: queue them so multiple command line arguments work?
    @if(state.loader.progress != .Idle) return(eprintln("can't load two at once"));
    
    // can't have old jitted thing active because compiler is going to be reset
    @if(state.canvas_active) drop(state.canvas&);
    state.canvas_active = false;
    each state.images.items().rest(state.builtin_image_count) { it |
        it.initialize = .None;
    };
    
    self := state;
    
    if new {
        // TODO: only if not error
        state.images&.push(initialize = .None, title = path.shallow_copy(general_allocator()));
    };
    image_i := state.images.index_of(fn(it) => it.title == path).unwrap();
    
    self.buf&.clear();
    self.buf&.push_all(path);
    state.loader&.start_async(image_i = image_i);
}

worker_get_source :: fn(self: *State, in: *LoaderT.I, a: Alloc) Result(Str, void) = {
    path := self.buf.items().shallow_copy(temp());
    @fmt(self.buf&, "\n");
    
    self.source = "";
    
    in := path;
    if read_entire_file(temp(), in) { data |
        in = data;
    } else {
        id, remaining := convert_number(path, 10, dec_digit);
        if remaining.len > 0 {
            return(Err = @fmt(self.buf&, "failed to read file and doesn't look like a project id number.\n"));
        };
        @fmt(self.buf&, "fetch_sb3(%)\n", id);
        start := timestamp();
        in = import("@/examples/gpu/hctarcs/main.fr")'fetch_sb3(id, false).or(fn(msg) => {
            return(Err = @fmt(self.buf&, "%", msg));
        });
        t := timestamp() - start;
        if t <= 5 {
            @fmt(self.buf&, "cached\n");
        } else {
            @fmt(self.buf&, "fetched in %ms\n", t);
        };
    };
    
    start := timestamp();
    r := unbuild(in).or(fn(msg) => {
        return(Err = @fmt(self.buf&, "%", msg));
    });
    
    out := list(u8, a);
    @fmt(out&, "{");
    // TODO: this has panics which should be converted to errors
    import("@/examples/gpu/hctarcs/compile.fr")'compile_to_franca(r, out&);
    @fmt(out&, ";initialize_fn::{ ::import(\"@/examples/gpu/hctarcs/compile.fr\").simple_ops;; @as(@FnPtr(c: *Rt.Canvas) void) initialize };");
    @fmt(out&, "};");
    @fmt(self.buf&, "parsed in %ms\n", timestamp() - start);
    
    (Ok = out.items())
}

Initialize :: @FnPtr(c: *Rt.Canvas) void;

// TODO: the functions passed here shouldn't need extra type annotations
LoaderT :: import("@/examples/jit_loader.fr")'Loader(
    *State, @struct(image_i: i64), @struct(initialize: Initialize), void,
    worker_get_source,
    fn(state: *State, in: *LoaderT.I, callee: rawptr) Result(LoaderT.O, void) = {
        callee := bit_cast_unchecked(rawptr, @FnPtr() Initialize, callee);
        @fmt(state.buf&, "compiled in %ms\n", timestamp() - state.loader.compile_start_time);
        (Ok = (initialize = callee()))
    },
    main_use_output,
    "initialize_fn",
);
