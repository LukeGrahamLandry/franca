// predecessor of this code: https://github.com/LukeGrahamLandry/2.5d-maze-renderer

Gen :: import("@/examples/gpu/maze2d/gen.fr");
State :: @struct {
    WIDTH :: 500; HEIGHT :: 500;
    draw: Sgl.Self;
    img: Sg.Image;
    framebuffer: List(u32);
    dirty: bool;
    resized: bool;
    grid: Gen.Grid;
};

fn on_init(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    state.grid = Gen'new_grid(general_allocator(), 10, 10);
    Gen'binary_tree(state.grid&, @ref Random.xoshiro256SS.new_seeded());

    state.draw&.setup(allocator = general_allocator(), sg = sg, max_commands = 2, max_vertices = 6);
    state.framebuffer = list(general_allocator());
    state.dirty = true;
    resize(state, sapp, sg);
    // sapp.lock_mouse(true);
}

fn draw2d(grid: *Gen.Grid, buf: []u32, w: i64) void = {
    scale := cast(w.float() / (grid.w+1).float());  // +1 extra cell for the solid edge
    h := buf.len/w;
    line :: fn(x: i64, y: i64, d: Vec2) void => {
        start := floor(vec2(x.float().cast(), y.float().cast()) * scale);
        end := floor(start + d*scale);
        range(start.y.cast().int(), end.y.cast().int()) { y |
            range(start.x.cast().int(), end.x.cast().int()) { x |
                i := (y)*w+x;
                if i < buf.len {
                    buf[i] = 0xFFFFFFFF;
                }
            };
        };
    };
    range(0, grid.h) { row |
        range(0, grid.w) { col |
            @if(!grid.get(col, row, .west)) line(col, row, vec2(0.1, 1));
            @if(!grid.get(col, row, .north)) line(col, row, vec2(1, 0.1));
        };
    };
    line(grid.w, 0, vec2(0.1, grid.w.float().cast()));
    line(0, grid.h, vec2(grid.h.float().cast(), 0.1));
    
    @println("%", grid);
}

fn on_render(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    @if(Easy'should_skip_frame(sapp, state.dirty&)) return();
    @if(state.resized) resize(state, sapp, sg);
    draw2d(state.grid&, state.framebuffer.items(), sapp.width());
    aspect := cast(sapp.width().float() / sapp.height().float());
    Easy'commit_screen_fit_image(sg, sapp, state.draw&, state.img, state.framebuffer.items(), aspect);
};

fn resize(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    w, h := (sapp.width(), sapp.height());
    sg.destroy(state.img);
    state.img = sg.make(width = w.intcast(), height = h.intcast(), pixel_format = .RGBA8, data = zeroed(Sg.ImageData), usage = .DYNAMIC);
    it := state.framebuffer&;
    it.len = 0;
    it.reserve(w*h);
    it.len = w*h;
    it.items().set_zeroed();
    state.resized = false;
} 

fn on_event(state: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = {
    @match(event.type) {
        fn RESIZED() => { state.resized = true; }
        @default => {
            if @is(event.type, .KEY_DOWN, .KEY_UP) {
                dir := @match(event.key_code) {
                    fn W() => vec2(0, 1);
                    fn A() => vec2(-1, 0);
                    fn S() => vec2(0, -1);
                    fn D() => vec2(1, 0);
                    @default => return();
                };
                state.dirty = true;
            };
            return();
        };
    };
    state.dirty = true;
}

fn on_cleanup(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    state.draw&.destroy(sg, general_allocator());
    sg.destroy(state.img);
    state.framebuffer&.drop();
    state.grid&.drop(general_allocator());
}

driver :: fn(vtable: *ImportVTable) void = Easy'build_for_graphics(vtable, @source_file_name());
main :: fn() void = Easy'start(State);
#use("@/graphics/lib.fr");
