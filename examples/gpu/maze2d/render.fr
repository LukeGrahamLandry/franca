
draw2d :: fn(grid: *Gen.Grid, player: Vec2, buf: []u32, stride: i64, w: i64) void = {
    scale := cast(w.float() / (grid.w+1).float());  // +1 extra cell for the solid edge
    line2 :: fn(start: Vec2, d: Vec2, c: u32) void => {
        start := floor(start * scale);
        end := floor(start + d*scale);
        range(start.y.cast().int(), end.y.cast().int()) { y |
            range(start.x.cast().int(), end.x.cast().int()) { x |
                i := (y)*stride+x;
                buf[i] = c;
            };
        };
    };
    line :: fn(x: i64, y: i64, d: Vec2) void => {
        line2(vec2(x.float().cast(), y.float().cast()), d, 0xFFFFFFFF);
    };
    range(0, grid.h) { row |
        range(0, grid.w) { col |
            @if(!grid.get(col, row, .west)) line(col, row, vec2(0.1, 1));
            @if(!grid.get(col, row, .north)) line(col, row, vec2(1, 0.1));
        };
    };
    line(grid.w, 0, vec2(0.1, grid.w.float().cast()));
    line(0, grid.h, vec2(grid.h.float().cast(), 0.1));
    
    if player.x >= 0 && player.y >= 0 && player.x < grid.w.float().cast() && player.y < grid.h.float().cast() {
        line2(player, vec2(0.15), 0xFF0000FF);
    };
}

draw3d :: fn(world: *World, buf: []u32, w: i64) void = {
    screen_width := w.float().cast();
    screen_height := buf.len.float().cast() / screen_width;
    region := world.regions[world.player.region]&;
    segments := @ref Segment.list(temp());
    range(0, w) { x |
        look_ray := {
            t := x.float().cast() / screen_width;
            rad := (t - 0.5) * world.cfg.fov;
            world.player.look.rotate(rad)
        };
    
        segments.clear();
        ray_trace(world, region, world.player.pos, look_ray, segments);
        
        // draw the floor
        cumulative_dist: f32 = 0.0;
        highest_pixel := screen_height;
        each segments { segment |
            ray_line := segment.line;
            length := ray_line.direction().norm();
            ray_direction := ray_line.direction() / length;
        
            sample_length: f32 = 1.0;
            ceilf :: fn(a: f32) f32 #libc;
            sample_count := ((length / sample_length).ceilf() + 1).cast().int();
        
            // The top of the last floor segment is the bottom of this one.
            // The top of the floor segment is the bottom of where we'd draw if it was a wall.
            pixels_drawn, _ := project_to_screen(cumulative_dist, screen_height);
            last_top := screen_height - pixels_drawn;
            range(0, sample_count) { i |
                i := i.float().cast();
                // the -1 fixes the square of black at the base of a wall. It uses the colour right before the wall instead of right after the wall (which would be in shadow)
                pos := ray_line.a + ray_direction * ((i - 2) * -sample_length);
                colour := region.horizontal_surface_colour_memoized(pos);
        
                dist := cumulative_dist + i*sample_length;
                _, top := project_to_screen(dist, screen_height);
                draw_vertical(buf, w, colour, x, top, last_top);
                last_top = top;
            };
            highest_pixel = last_top;
            
            cumulative_dist += length;
        };
    
        // draw the wall
        hit := segments.last().unwrap();
        if hit.hit_wall { wall |
            colour := hit.region.vertical_surface_colour(hit.line.b, wall, -hit.line.direction());
            top, bottom := project_to_screen(cumulative_dist, screen_height);
    
            colour := pack_colour(colour);
            draw_vertical(buf, w, colour, x, top, bottom);
            highest_pixel = top;
        };
        black :: pack_colour(vec3(0));
        draw_vertical(buf, w, black, x, 0, highest_pixel);
    };
}

pack_colour :: fn(colour: Vec3) u32 = {
    f :: fn(c: f32) u32 = (c.min(1.0).max(0.0) * 255.0).cast().int().trunc();
    r, g, b := (f(colour.x), f(colour.y), f(colour.z));
    r.bit_or(g.shift_left(8)).bit_or(b.shift_left(16)).bit_or(255.shift_left(24))
};

draw_vertical :: fn(buf: []u32, w: i64, colour: u32, x: i64, y0: f32, y1: f32) void = {
    range(y0.cast().int(), y1.cast().int()) { y |
        buf[y*w+x] = colour;
    };
}


fn project_to_screen(z_distance: f32, screen_height: f32) Ty(f32, f32) = {
    zoom_amount: f32 = 12000.0;
    screen_wall_height := zoom_amount / z_distance;
    screen_middle := screen_height / 2.0;
    half_screen_wall_height := screen_wall_height / 2.0;
    y_top := (screen_middle - half_screen_wall_height).max(0.0);
    y_bottom := (screen_middle + half_screen_wall_height).min(screen_height - 1.0);
    (y_top, y_bottom)
}

fn rotate(v: Vec2, rad: f32) Vec2 = {
    s, c := rad.sin_cos();
    x := c * v.x - s * v.y;
    y := s * v.x + c * v.y;
    vec2(x, y)
}

Segment :: @struct(region: *Region, line: Line, hit_wall: ?*Wall);
ray_trace :: fn(world: *World, region: *Region, origin: Vec2, direction: Vec2, segments: *List(Segment)) void = {
    segment := region.single_ray_trace(origin, direction, world.cfg.view_distance);
    segments.push(segment);
    while => segment.hit_wall { hit_wall |
        @if(segments.len > world.cfg.portal_limit) return();
        @if(hit_wall.portal.region == -1) return();
        
        t := hit_wall.line.t_of(segment.line.b);
        hit_back := hit_wall.normal.dot(direction) > 0.0;
        border_width: f32 = 0.05 / 2;
        hit_edge := t < border_width || t > 1 - border_width;
        @if(hit_back || hit_edge) return();

        new_wall := world.index_wall(hit_wall.portal);
        @if((new_wall.line.a - new_wall.line.b).norm_sq() == 0) return();
        origin = portal_translate(hit_wall, new_wall, segment.line.b);
        direction = portal_rotate(hit_wall, new_wall, direction);
        
        origin += direction;  // dont start inside the portal
        region = world.regions[hit_wall.portal.region]&;
        segment = region.single_ray_trace(origin, direction, world.cfg.view_distance);
        segments.push(segment);
    };
}


/// Sends a ray through a single region until it hits a wall. Without following portals.
fn single_ray_trace(region: *Region, origin: Vec2, direction: Vec2, view_distance: f32) Segment = {
    direction *= view_distance;
    ray: Line = (a = origin, b = origin + direction);

    shortest_hit_distance_squared: f32 = 1.0/0.0;
    closest_hit_point := origin + direction;
    hit_wall: ?*Wall = .None;

    each region.walls { wall |
        // TODO: save one of the .contains() checks by making shortest_hit_distance_squared start as view_distance^2
        hit := wall.line.intersection(ray);
        if !hit.x.is_nan() {
            to_hit := origin - hit;
            dist := to_hit.norm_sq();
            if dist < shortest_hit_distance_squared {
                hit_wall = (Some = wall);
                shortest_hit_distance_squared = dist;
                closest_hit_point = hit;
            }
        }
    };

    (region = region, hit_wall = hit_wall, line = (a = origin, b = closest_hit_point))
}

// transform to same position but relative to the new wall, accounting for walls of different sizes.
fn portal_translate(from: *Wall, to: *Wall, pos: Vec2) Vec2 = {
    last_offset := pos - from.line.a;
    fraction := last_offset.norm() / from.line.direction().norm();
    new_offset := -to.line.direction() * fraction;
    to.line.a + new_offset
}

fn portal_rotate(from: *Wall, to: *Wall, dir: Vec2) Vec2 = {
    rot_offset := from.normal.angle_between(-to.normal);
    dir := dir.rotate(rot_offset);
    @if(dir.dot(to.normal) > 0.0, dir, -dir)
}

fn white_ambient(self: *Material) Vec3 = self.colour * self.ambient * 2;
fn is_pointing_opposite(a: Vec2, b: Vec2) bool = a.dot(b) >= EPSILON;

/// Calculates the colour of a column of wall based on all lights in the region.
fn vertical_surface_colour(self: *Region, hit_point: Vec2, wall: *Wall, ray_direction: Vec2) Vec3 = {
    to_eye := ray_direction.neg().normalize();
    colour := wall.material.white_ambient();
    each self.lights { light |
        colour += self.wall_lighting(wall.material, light, hit_point, wall.normal, to_eye);
    };
    colour
}

fn wall_lighting(self: *Region, material: *Material, light: *Light, hit_point: Vec2, wall_normal: Vec2, to_eye: Vec2) Vec3 = {
    dir_to_light := (light.pos - hit_point).normalize();
    light_on_front := dir_to_light.is_pointing_opposite(wall_normal);
    eye_on_front := to_eye.is_pointing_opposite(wall_normal);
    in_shadow := light_on_front != eye_on_front || light.blocked_by_shadow(self, hit_point);

    material.calculate_wall_lighting(light, hit_point, wall_normal, to_eye, in_shadow)
}

/// https://en.wikipedia.org/wiki/Phong_reflection_model
fn calculate_wall_lighting(self: *Material, light: *Light, hit_point: Vec2, wall_normal: Vec2, to_eye: Vec2, in_shadow: bool) Vec3 = {
    @if(in_shadow) return(vec3(0));

    base_colour := self.colour * light.colour;
    dir_to_light := (light.pos - hit_point).normalize();
    light_on_front := dir_to_light.is_pointing_opposite(wall_normal);
    if !light_on_front {
        wall_normal = -wall_normal;
    }

    cos_light_to_normal := dir_to_light.dot(wall_normal);
    diffuse_colour := vec3(0);
    specular_colour := vec3(0);
    if cos_light_to_normal >= EPSILON {
        diffuse_colour = base_colour * (self.diffuse * cos_light_to_normal);

        reflection_direction := dir_to_light.neg().reflect(wall_normal);
        cos_reflect_to_eye := reflection_direction.dot(to_eye);

        if cos_reflect_to_eye >= EPSILON {
            factor := cos_reflect_to_eye.pow(self.shininess);
            specular_colour = light.colour * (self.specular * factor);
        }
    }

     diffuse_colour + specular_colour
}

reflect :: fn(self: Vec2, normal: Vec2) Vec2 =
    self - normal * (self.dot(normal)*2);

fn horizontal_surface_colour_memoized(region: *Region, pos: Vec2) u32 = {
    light := region.lighting;
    local := floor(pos - light.top_left);
    x, y := (local.x.cast().int(), local.y.cast().int());
    
    if x >= light.width || y >= light.height || x < 0 || y < 0 {
        // This shouldn't happen so make it look obviously wrong.
        return pack_colour(vec3(1, 0, 1));
    };
    
    i := y*light.width + x;
    c := light.cells[i];
    if c.shift_right_logical(24) == 0 {
        // would be more sane if this were (local + light.top_left) so it didn't matter 
        // which fractioon of square you saw first but this way you're on the right side
        // and don't get a line of blank at the base of each wall. 
        c = pack_colour(region.horizontal_surface_colour(pos));
        light.cells[i] = c;
    };
    c
}

/// Calculates the colour of a point on the floor based on all lights in the region.
fn horizontal_surface_colour(region: *Region, hit_pos: Vec2) Vec3 = {
    colour := region.floor.white_ambient();
    each region.lights { light |
        colour += region.floor_lighting(region.floor, light, hit_pos);
    }
    colour
}

fn floor_lighting(region: *Region, material: *Material, light: *Light, hit_point: Vec2) Vec3 = 
    material.calculate_floor_lighting(light, hit_point, light.blocked_by_shadow(region, hit_point));

// diffuse_factor = sum of cos_light_to_normal all the way up the light column.
// The normal is just up since its the floor. We need the vector from the hit_point to the point on pillar.
// cos = opposite / adjacent
// opposite = height of the point up the pillar
// adjacent = distance from the pillar to the hit_point
// want to do that for infinitely many points up the pillar
// f(x) = integral (x / distance) dx
// f(x) = (1 / (2 * distance)) * x^2
// f(0) = 0
// we care about the interval x=(0, height) so answer is just (1 / (2 * distance)) * height^2
light_pillar_height_sq :: @as(f32) 25;
max_floor_light_distance :: light_pillar_height_sq * 75;
max_floor_light_distance_sq :: max_floor_light_distance * max_floor_light_distance;
fn calculate_floor_lighting(self: *Material, light: *Light, hit_point: Vec2, in_shadow: bool) Vec3 = {
    @if(in_shadow) return(vec3(0));
    base_colour := self.colour * light.colour;

    dist_to_light_sq := (light.pos - hit_point).norm_sq();
    if dist_to_light_sq < max_floor_light_distance_sq {
        diffuse_factor := (@as(f32) 1.0 / dist_to_light_sq.sqrt()) * light_pillar_height_sq;
        return base_colour * (self.diffuse * diffuse_factor);
    };
    vec3(0)
}

fn blocked_by_shadow(self: *Light, region: *Region, hit_pos: Vec2) bool = {
    target, origin := (hit_pos, self.pos);
    direction := target - origin;
    length := direction.norm();
    hit := region.single_ray_trace(origin, direction / length, length);
    dist := abs(hit.line.b - hit_pos) - vec2(EPSILON);
    dist.x > 0 || dist.y > 0
}

fn intersection(self: Line, other: Line) Vec2 = {
    hit := self.algebraic_intersection(other);
    ok := self.contains(hit) && other.contains(hit);
    @if(ok, hit, vec2(0.0/0.0))
}

EPSILON :: @as(f32) 0.001;
fn contains(self: Line, point: Vec2) bool = {
    (self.a.y.min(self.b.y) - point.y) < EPSILON
        && (point.y - self.a.y.max(self.b.y)) < EPSILON
        && (self.a.x.min(self.b.x) - point.x) < EPSILON
        && (point.x - self.a.x.max(self.b.x)) < EPSILON
}

// treats the line segments as infinite
algebraic_intersection :: fn(self: Line, other: Line) Vec2 = {
    a: Array(f32, 3) = (-self.slope(), 1.0, self.y_intercept());
    b: Array(f32, 3) = (-other.slope(), 1.0, other.y_intercept());

    if self.is_vertical() {
        a = (1.0, 0.0, self.a.x);
    };

    if other.is_vertical() {
        b = (1.0, 0.0, other.a.x);
    };

    reduce(a&, b&);
    vec2(a&[2], b&[2])
}

fn slope(self: Line) f32 #inline = {
    dir := self.direction();
    dir.y / dir.x
}

fn is_horizontal(self: Line) bool = self.a.y == self.b.y;
fn is_vertical(self: Line) bool = self.a.x == self.b.x;
fn y_intercept(self: Line) f32 #inline = @if(self.is_vertical(), 0.0/0.0,  self.a.y - (self.a.x * self.slope()));
fn direction(self: Line) Vec2 = self.a - self.b;

// What fraction along the line is the point
fn t_of(self: Line, point: Vec2) f32 = {
    dir := self.direction();
    offset := point - self.a;
    offset.norm() / dir.norm()
}

// TODO: this can't be the best way to do this
reduce :: fn(r1: *Array(f32, 3), r2: *Array(f32, 3)) void = {
    if r2[0] != 0.0 && r1[0] == 0.0 {
        range(0, 3) { i |
            temp := r1[i];
            r1[i] = r2[i];
            r2[i] = temp;
        }
    }

    xxxx := (r1[0] == 0.0 && r2[0] == 0.0) || (r1[1] == 0.0 && r2[1] == 0.0);
    if xxxx {
        r1[2] = 0.0/0.0;
        r2[2] = 0.0/0.0;
        return();
    }

    if r2[0] != 0.0 {
        scale := r2[0] / r1[0];

        r2[0] = r2[0] - (scale * r1[0]);
        r2[1] = r2[1] - (scale * r1[1]);
        r2[2] = r2[2] - (scale * r1[2]);
    }

    if r1[1] != 0.0 {
        scale := r1[1] / r2[1];

        r1[0] = r1[0] - (scale * r2[0]);
        r1[1] = r1[1] - (scale * r2[1]);
        r1[2] = r1[2] - (scale * r2[2]);
    }

    if r2[1] != 1.0 {
        r2[0] /= r2[1];
        r2[2] /= r2[1];
        r2[1] /= r2[1];
    }

    if r1[0] != 1.0 {
        r1[1] /= r1[0];
        r1[2] /= r1[0];
        r1[0] /= r1[0];
    }
}

#use("@/examples/gpu/maze2d/world.fr");
#use("@/graphics/vec.fr");
