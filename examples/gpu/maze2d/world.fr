
Line :: @struct(a: Vec2, b: Vec2);
World :: @struct {
    regions: RawList(Region);
    player: Player;
    materials: RawList(*Material);
    gpa: Alloc;
    cfg: (@struct {
        portal_limit := 15;
        view_distance: f32 = 1000;
        move_speed: f32 = 100.0;
        turn_speed: f32 = 0.2 / 60;
        fov: f32 = 45.deg_to_rad();
        scale: f32 = 50;
        portal_width: f32 = 20;
    }) = ();
};

Region :: @struct {
    walls: RawList(Wall);
    lights: []Light;
    floor: *Material;
    lighting: FloorLightCache;
};

Wall :: @struct {
    material: *Material;
    line: Line;
    normal: Vec2;
    portal: WallRef = (region = -1, wall = -1);
};
Portal :: @struct(from: WallRef, to: WallRef);
WallRef :: @struct(region: i64, wall: i64);

Light :: @struct(colour: Vec3, pos: Vec2);
Material :: @struct {
    colour := vec3(1);
    ambient: f32 = 0.1;
    diffuse: f32 = 0.9;
    specular: f32 = 0.2;
    shininess: f32 = 10;
};
FloorLightCache :: @struct {
    cells: []u32;  // high byte 0 means None, 255 means Some. 
    width: i64;
    height: i64;
    top_left: Vec2;
};

Player :: @struct {
    pos: Vec2;
    look: Vec2;
    move: Vec2;
    turn: f32;
    first_person: bool;
    region: i64;
    portals: Array(WallRef, 2);
    material: *Material;
};

fn create_empty_world(world: *World, a: Alloc) void = {
    world[] = (player = zeroed(Player), regions = empty(), materials = init(a, 4), gpa = a);
    M :: fn(m: Material) => world.materials&.push(a.boxed(Material, m), a);
    M(colour = vec3(100/255.0, 100/255.0, 150/255.0), ambient = 0.05);
    M(colour = vec3(0.2, 0.8, 0.2));
    M(colour = vec3(1.0, 0.1, 0.1));
    M(colour = vec3(0.8, 0.3, 0.3));
    
    p := world.player&;
    world.player.material = world.materials[2];
    world.player.look = vec2(1, 0);
    world.player.pos = vec2(world.cfg.scale / 2);
    world.player.first_person = true;
    p.portals = ((region = 0, wall = 0), (region = 0, wall = 1));
}

fn create_maze_region(world: *World, grid: *Gen.Grid, scale: f32) void = {
    walls := gen_maze_lines(grid, scale, world.materials[1], world.gpa);
    
    each walls.items().slice(0, 2) { it |  // hack
        it.material = world.materials[3];
    };
    
    world.regions&.push((
        walls = walls,
        floor = world.materials[0],
        lights = {
            s, w, h := (scale, grid.w.float().cast(), grid.h.float().cast());
            lights := @slice(
                vec2(s/2, h*s - s/2),
                vec2(w*s - s/2, s/2),
                vec2(w*s - s/2, h*s - s/2),
                vec2(s/2, s/2),
            );
            world.gpa.alloc_init(Light, lights.len, fn(i) => (pos = lights[i], colour = vec3(1)))
        },
        lighting = {
            w := (grid.w.float().cast() * scale).cast().int();
            h := (grid.h.float().cast() * scale).cast().int();
            (cells = world.gpa.alloc_zeroed(u32, w*h), top_left = vec2(0), width = w, height = h)
        },
    ), world.gpa);
}

fn gen_maze_lines(grid: *Gen.Grid, scale: f32, material: *Material, a: Alloc) RawList(Wall) = {
    walls := @ref Wall.list(a);

    // :HackReservePortalSlots not placed yet is represented as zero length. 
    walls.push_repeated(2, zeroed(Wall));
    walls[0].portal.wall = 1;
    walls[1].portal.wall = 0;
    
    line :: fn(x: i64, y: i64, d: Vec2) void => {
        start := (vec2(x.float().cast(), y.float().cast()) * scale);
        end := (start + d*scale);
        line: Line = (a = start, b = end);
        walls.push(line = line, normal = line.normal(), material = material);
    };
    
    // horizontal sections
    line(0, grid.h, vec2(grid.h.float().cast(), 0));
    range(0, grid.h) { row |
        d := vec2(0);
        range(0, grid.w) { col |
            if grid.get(col, row, .north) {
                if d.x != 0 {
                    line(col, row, d);
                    d.x = 0;
                };
            } else {
                d.x -= 1;
            }
        };
        if d.x != 0 {
            line(grid.w, row, d);
        };
    };
    
    // vertical sections
    line(grid.w, 0, vec2(0, grid.w.float().cast()));
    range(0, grid.w) { col |
        d := vec2(0);
        range(0, grid.h) { row |
            if grid.get(col, row, .west) {
                if d.y != 0 {
                    line(col, row, d);
                    d.y = 0;
                };
            } else {
                d.y -= 1;
            }
        };
        if d.y != 0 {
            line(col, grid.h, d);
        };
    };
    
    walls.as_raw()
}

fn update(world: *World, dt: f32) bool = {
    p := world.player&;
    
    p.look = p.look.rotate(p.turn /* dt */ * world.cfg.turn_speed);
    p.turn = 0;
    
    if p.move.x != 0 || p.move.y != 0 {
        relative_move := p.move.normalize();
        real_move := p.look.rotate(relative_move.angle() - (3.1415/2));
        if !p.first_person {
            real_move = -relative_move;
        };
        real_move *= dt * world.cfg.move_speed;
        real_move = handle_collisions(world, real_move);
        p.pos += real_move;
    };
    
    true
}


fn handle_collisions(world: *World, move_direction: Vec2) Vec2 = {
    p := world.player&;
    region := world.regions[p.region]&;

    hit := region.single_ray_trace(p.pos, move_direction, 1);
    wall := hit.hit_wall || return(move_direction);
    
    if wall.portal.region == -1 || wall.normal.dot(move_direction) > 0.0{
        wall_dir_unit := wall.line.direction().normalize();
        slide_direction := wall_dir_unit * move_direction.dot(wall_dir_unit);
        move_direction = slide_direction;
    } else {
        p.region = wall.portal.region;
        walking_backwards := wall.normal.dot(p.look) > 0.000001;
    
        new_wall := world.index_wall(wall.portal);
        p.pos = portal_translate(wall, new_wall, p.pos);
        p.look = portal_rotate(wall, new_wall, p.look);
        move_direction = portal_rotate(wall, new_wall, move_direction);
    
        if walking_backwards {
            p.look = -p.look;
        };
    
        p.pos += move_direction;  // don't get stuck teleporting back and forth right inside the portal
        return move_direction;
    };

    if move_direction.norm_sq() > 0.1*0.1 {
        return handle_collisions(world, move_direction * 0.9);
    };
    vec2(0)
}

fn place_portal_input(world: *World, action: @enum(Left, Right, Remove)) void = {
    if action == .Remove {
        for world.player.portals& { it |
            it := world.index_wall(it);
            it.line = zeroed(Line);
        };
        return();
    };

    hit := {
        #use("@/examples/gpu/maze2d/render.fr");
        segments := @ref Segment.list(temp());
        ray_trace(world, world.regions[world.player.region]&, world.player.pos, world.player.look, segments);
        segments.last().unwrap()
    };
    hit_wall := hit.hit_wall || return();
    
    half_portal_direction := hit_wall.line.direction().normalize() * world.cfg.portal_width/2;
    normal := @if(world.player.look.dot(hit_wall.normal) < 0.0, hit_wall.normal, -hit_wall.normal);
    bump_dist: f32 = 0.1;
    // TODO: stop it when it hits a wall
    line: Line = (
        a = hit.line.b + half_portal_direction + normal*bump_dist,
        b = hit.line.b - half_portal_direction + normal*bump_dist,
    );
    
    replacing_index, connecting_index := (int(action == .Left), int(action == .Right));
    portal_wall := world.index_wall(world.player.portals&[replacing_index]);
    portal_wall.normal = normal;
    portal_wall.line = line;

    // only matters once there are multiple regions
    // TODO: make the old one zero size then set to new region
    // portal_wall.portal = world.player.portals[connecting_index];
    // world.index_wall(portal_wall.portal)[].portal = world.player.portals[replacing_index];
    
    // world.update_lighting();
}

fn index_wall(world: *World, i: WallRef) *Wall = 
    world.regions[i.region].walls.index(i.wall);

fn normal(self: Line) Vec2 = {
    @if(self.is_horizontal()) return(vec2(0, 1));
    @if(self.is_vertical()) return(vec2(1, 0));
    
    goal_slope := @as(f32) 1.0 / self.slope();
    self.b = self.a + vec2(1, goal_slope);
    self.direction().normalize()
}

fn angle(self: Vec2) f32 = self.angle_between(vec2(1, 0));
fn angle_between(self: Vec2, other: Vec2) f32 = {
    acos :: fn(a: f64) f64 #libc;
    a := self.normalize().dot(other).cast().acos().cast();
    @if(self.y >= 0, a, -a)
}

Gen :: import("@/examples/gpu/maze2d/gen.fr");
#use("@/graphics/vec.fr");
