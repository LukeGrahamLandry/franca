#use("@/graphics/lib.fr");

State :: @struct(
    pipe: Sgl.Pipeline,
    pass_action: Sg.PassAction,
    world: World,
    text: Sdtx.Self,
    draw: Sgl.Self,
    sg: Sg.Self,
    w: i64,
    h: i64,
    pressed: Array(bool, 4),
    img: Sg.Image,
    dirty: bool,
    prev_frame_time: f64,
    reset: @struct(v: @FnPtr(u: rawptr, w: *World) void, u: rawptr),  // for maze_game embedding
);

World :: @struct(
    farm: List(Planted),
    shelves: List(Shelf),
    shops: List(Shop),
    sprinklers: List(Pos),
    requests: List(CropType),
    player: Player,
    money: i64,
    timer: f64,
    farm_area: Rect,
    text: List(u8),
    msg: List(@struct(len: i64, timer: f64)),
    truck_area: Rect,
    round_timer: f64,
    next_round_timer: f64,
    round_number: i64,
    rng: Random.Rng,
    paused: bool,
);

Player :: @struct(pos: Pos, inventory := Object.None, dx: f64 = 0.0, dy: f64 = 0.0);
Growth :: @enum(Seed, Ready);
CropType :: @enum(Tomato, Potato, Pizza, Acorn);
Crop :: @struct(type: CropType, age: Growth);
Planted :: @struct(pos: Pos, timer: f64, drought: ?f64 = .None, crop: Crop);
Object :: @tagged(
    Crop: Crop,   // seed: place on farm. ready: place on truck
    Fertalizer,   // instantly grow a crop
    WateringCan,  // removes drought from a crop (reusable)
    CrowBaton,    // kill a crow in 1 hit instead of 3 (reusable)
    Sprinkler,    // place on farm to prevent drought in a zone
    Scarecrow,    // add to a shelf to prevent crows
    Shelf,        // place a new shelf in the world
    HourGlass,    // place on truck to get bonus time
    None,
);
Shelf :: @struct(
    pos: Pos, 
    item := Object.None,
    crow_timer: f64 = 0,
    crow_hp := 0,
    scarecrow := false,
);
Shop :: @struct(
    pos: Pos,
    price := 0,
    item := Object.None,
);

CropConfig :: @struct(time: f64, seed: i64, sale: i64, colour: u32);
ItemConfig :: @struct(type: Object, price: i64, colour: u32, tex: i64);
HazardConfig :: @struct(chance: f64, scaling: f64, time: f64);
config :: @struct {
    min_round_timer :: 20;
    crow: HazardConfig : (chance = 0.05, scaling = 0.001, time = 5);
    drought: HazardConfig : (chance = 0.03, scaling = 0.003, time = 5);
    max_crow_hp :: 3;
    player_speed :: 600;
    start_money :: 15;
    sprinkler_range :: base_size * 2;
    first_round_timer :: 60;
    crops :: @const_slice(@as(CropConfig)
        (time = 5, seed = 1, sale = 2, colour = red),
        (time = 15, seed = 3, sale = 6, colour = white),
        (time = 25, seed = 15, sale = 30, colour = yellow),
        (time = 60, seed = 30, sale = 60, colour = green),
    );
    items :: @const_slice(@as(ItemConfig)
        (type = .Fertalizer, price = 10, colour = pack_rgba(0.7, 0, 0.7, 1), tex = 4),
        (type = .WateringCan, price = 50, colour = pack_rgba(0.2, 0, 1, 1), tex = 0),
        (type = .CrowBaton, price = 15, colour = pack_rgba(0.4, 0.4, 0.4, 1), tex = 6),
        (type = .Sprinkler, price = 100, colour = pack_rgba(0.6, 0.6, 1, 1), tex = 2),
        (type = .Scarecrow, price = 75, colour = pack_rgba(0.6, 0.6, 0.6, 1), tex = 3),
        (type = .Shelf, price = 50, colour = pack_rgba(130, 60, 20, 255), tex = 5),
        (type = .HourGlass, price = 30, colour = pack_rgba(150, 150, 0, 255), tex = 1),
    );
};

fn load_default_world(_: rawptr, self: *World) void = {
    allocator := general_allocator();
    self[] = (
        player = (pos = (x = 150.0, y = 150.0)),
        shelves = list(allocator),
        shops = list(allocator),
        sprinklers = list(allocator),
        money = config.start_money,
        farm_area = (pos = (x = 350.0, y = 300.0), w = 500.0, h = 500.0),
        truck_area = (pos = (x = 350.0 + 500.0 + 40, y = 300.0), w = 200.0, h = 200.0),
        farm = list(allocator),
        msg = list(allocator),
        text = list(allocator),
        requests = list(allocator),
        next_round_timer = config.first_round_timer,
        rng = Random.xoshiro256SS.new_seeded(),
        timer = 0, round_timer = 0, round_number = 0,
        paused = false,
    );
    range(0, 5) {i|
        self.shelves&.push((pos = (x = i.float().mul(80).add(350.0), y = 200.0)));
    };
    self.shelves[0].item = .WateringCan;
    self.shelves[1].item = .CrowBaton;
    
    store_rows := max(enum_count(CropType), config.items.len());
    range_rev(0, 2) {x|
        range(0, store_rows) {y|
            self.shops&.push((pos = (x = x.float().mul(100.0).add(150.0), y = y.float().mul(75.0).add(300.0))));
        };
    };
    for_enum CropType { r |
        i := r.raw();
        self.shops[i].price = config.crops[i].seed;
        self.shops[i].item = (Crop = (type = r, age = .Seed));
    };
    enumerate config.items { i, it |
        jt := self.shops[i + store_rows]&;
        jt.price = it.price;
        jt.item = it.type;
    };
}

fn on_init(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    allocator := general_allocator();
    sapp.set_window_title("Arstotzkan Farmer 4");
    state.img = sg.make(bake_texture());
    state.dirty = true;
    state.draw&.setup(
        allocator = allocator,
        sg = sg,
    );
    
    state.text&.setup(
        allocator = allocator,
        fonts = @slice(Sdtx.font.kc854),
        sg = sg,
    );
    
    init_pipeline(state.draw&, state.pipe&, sg, (colors = (
        (blend = (  // This makes transparency work
            enabled = true,
            src_factor_rgb = .SRC_ALPHA,
            dst_factor_rgb = .ONE_MINUS_SRC_ALPHA,
        )),
        ..,
    )));
    
    state.pass_action.colors&[0] = (
        load_action = .CLEAR,
        clear_value = (r = 0.3, g = 0.3, b = 0.3, a = 1.0),
    );
    
    state.reset = (v = load_default_world, u = zeroed(rawptr));
    state'reset'v(state.reset.u, state.world&);
    state.world&.next_round(state.reset);
};

fn next_round(world: *World, reset: FieldType(State, .reset)) void = {
    extra_time := world.round_timer;
    world.round_timer = world.next_round_timer;
    world.next_round_timer -= 5;
    world.next_round_timer = max(world.next_round_timer, config.min_round_timer);
    world.round_number += 1;
    
    if world.requests.len == 0 {
        bonus := int(extra_time / 5);
        world.money += bonus;
        if bonus != 0 {
            @fmt_msg(world, "Order fulfilled early! you earned % bonus rubles", bonus);
        };
        
        lo, hi := (4, 7);
        n := world.rng&.rand_int(lo, hi);
        range(0, n) { _ |
            hi := @if(world.round_number >= 5, 3, 2);
            i := world.rng&.rand_int(hi);
            world.requests&.push(@as(CropType) i);
        };
        if world.round_number >= 10 && world.rng&.next().mod(2) == 0 {
            world.requests&.push(.Acorn);
        };
    } else {
        prev_round := world.round_number;
        world.drop();
        
        reset'v(reset.u, world);
        world.next_round(reset);
    };
}

C :: fn(c: @struct(r: i64, g: i64, b: i64, a := 255)) u32 = pack_rgba(c.r,c.g,c.b,c.a);
Pos :: @struct(x: f64, y: f64);
red :: C(r = 255, g = 0, b = 0);
green :: C(r = 0, g = 255, b = 0);
blue :: C(r = 0, g = 0, b = 255);
yellow :: C(r = 250, g = 250, b = 0);
brown :: C(r = 150, g = 70, b = 20);
light_brown :: C(r = 180, g = 110, b = 70);
black_transparent :: C(r = 0, g = 0, b = 0, a = 100);
black :: C(r = 0, g = 0, b = 0);
white :: C(r = 255, g = 255, b = 255);

Rect :: @struct(pos: Pos, w: f64, h: f64);
base_size :: 50.0;

do_update :: fn(state: *State) void = {
    now := timestamp_s();
    dt := (now - state.prev_frame_time);
    state.prev_frame_time = now;
    w := state.world&;
    
    // Player Movement
    state.world.player.dy = float(int(state.pressed&[2]) - int(state.pressed&[0]));
    state.world.player.dx = float(int(state.pressed&[3]) - int(state.pressed&[1]));
    // no normalize. i want you to go faster when you're going diagonal. it's more fun than sprint. 
    // TODO: maybe that should be an upgrade you buy. that would be fun. 
    w.player.pos.x += config.player_speed * w.player.dx * dt;
    w.player.pos.y += config.player_speed * w.player.dy * dt;
    if w.player.dx != 0 || w.player.dy != 0 {
        state.dirty = true;
    };
    
    // The Farm
    drought := state.world&.check_hazard(config.drought, dt);
    drought_had_effect := false;
    unordered_retain state.world.farm& { planted | 
        if tick_timer(state, planted.timer&, dt) {
            planted.crop.age = .Ready;
        };
        
        ok := true;
        @match(planted.drought&) {
            fn Some(t) => {
                if tick_timer(state, t, dt) {
                    ok = false;
                    @fmt_msg(state.world&, "a drought killed your %", planted.crop.type);  
                }
            }
            fn None() => if drought && !state.world&.in_sprinkler(planted.pos) {
                planted.drought = (Some = { xx := config.drought; xx.time });
                state.dirty = true;
                drought_had_effect = true;
            }
        };
        
        rot_time := -2.0 * config.crops[planted.crop.type.raw()].time;
        if planted.timer <= rot_time { 
            ok = false;
            @fmt_msg(state.world&, "your % rotted", planted.crop.type);
        };
        ok
    };
    if drought_had_effect {
        @fmt_msg(state.world&, "drought!");
    };
    
    // The Crows
    each state.world.shelves& { it | 
        @if(!it.item&.is(.None))
        @if(!it.scarecrow)
        @if(it.crow_hp <= 0)
        if state.world&.check_hazard(config.crow, dt) {
            it.crow_hp = config.max_crow_hp;
            it.crow_timer = { xx := config.crow; xx.time };
        };
        if it.crow_hp != 0 {
            if tick_timer(state, it.crow_timer&, dt) {
                @fmt_msg(state.world&, "a crow took your %", it.item&.tag()); 
                it.item = .None;
                it.crow_hp = 0;
            };
        };
    };

    // Rounds
    if tick_timer(state, w.round_timer&, dt) {
        state.world&.next_round(state.reset);
    };
    world := state.world&;
    
    each world.msg { it |
        it.timer -= dt;
    };
    if world.msg.len > 0 && world.msg[0].timer < 0 {  // :SLOW
        it := world.msg&.pop_front_slow().unwrap();
        s := world.text&.items();
        s.slice(0, s.len - it.len).copy_from(s.rest(it.len));
        world.text.len -= it.len;
        state.dirty = true;
    };
    
    // this is here instead of in next_round() because i want the paused end screen to show the state of the world with the progress you made before resetting. 
    if world.round_timer < 1 && world.requests.len > 0 {
        @fmt_msg(world, "Time's up. You lost on round %!", world.round_number);
        world.paused = true;
        world.round_timer = 0;
    };
};

fn tick_timer(state: *State, t: *f64, dt: f64) bool = {
    prev := t[];
    t[] -= dt;
    if prev.floor() != t[].floor() {
        // this is used for timers that are shown on the screen (rounded as ints). 
        // don't need to redraw if player didn't move and no timers changed. 
        // TODO: could be even more obsessive and try to start new timers close on whole seconds so they all change on the same frame. rn this helps less the more is on your farm. 
        state.dirty = true;
    };
    t[] <= 0
}

fn check_hazard(world: *World, hazard: HazardConfig, dt: f64) bool = {
    chance := hazard.chance + (hazard.scaling * world.round_number.float());
    chance *= dt;
    world.rng&.rand_float() <= chance
}

fn in_sprinkler(world: *World, plant: Pos) bool = {
    for world.sprinklers& { it |
        if center_overlaps(plant, base_size, it, config.sprinkler_range) {
            return true;
        }
    }
    false
}

SOILD :: 7;  // tex

fn on_render(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    state.w = sapp.width();
    state.h = sapp.height();
    w := state.world&;
    if !w.paused {
        do_update(state);
    };
    @if(Easy'should_skip_frame(sapp, state.dirty&)) return();
    sgl := state.draw&;
    sdtx := state.text.default_context&;
    
    sgl.defaults();
    sgl.viewport(0.intcast(), 0.intcast(), sapp.width().intcast(), sapp.height().intcast(), true);
    sgl.load_pipeline(state.pipe);
    
    sdtx.canvas(sapp.width().float().div(2.0).cast(), sapp.height().float().div(2.0).cast());
    sdtx.color = pack_rgba(0.5, 0.5, 0.2, 1.0);
    sdtx.pos.x = 0.0;
    sdtx.pos.y = 0.0;
    sdtx.put(@tfmt("You have % rubles.    Round %\n", state.world.money, state.world.round_number));
    sdtx.put(@tfmt("Shipment due in %\n", int(state.world.round_timer)));
    a: f32 = 1.0;
    start, stop := (state.world.text.len, state.world.text.len);
    each_rev state.world.msg& { it |
        if it.timer > 0 {
            start -= it.len;
            sdtx.color = pack_rgba(1.0, 0.5, 0.2, a);
            sdtx.pos.y += 1;
            sdtx.pos.x = 0;
            sdtx.put(state.world.text.items().slice(start, stop));
            a *= 0.8;
            stop = start;
        };
    };
    if state.world.paused {
        sdtx.color = pack_rgba(1.0, 0.5, 0.2, 1.0);
        sdtx.pos.x = 0.0;
        sdtx.pos.y += 1;
        sdtx.put("paused. press P to continue.");
    };
    
    sdtx.canvas(sapp.width().float().div(1.0).cast(), sapp.height().float().div(1.0).cast());
    each state.world.farm { planted |
        if planted.timer < 0 {
            rot_time := 2.0 * config.crops[planted.crop.type.raw()].time;
            world_write(state, planted.pos, pack_rgba(0.0, 0.6, 0.2, 1.0), @tfmt("%", int(rot_time + planted.timer)));
        } else {
            world_write(state, planted.pos, pack_rgba(0.0, 1.0, 0.0, 1.0), @tfmt("%", int(planted.timer)));
        };
        if planted.drought { timer |
            p := planted.pos;
            p.y += base_size / 3;
            world_write(state, p, pack_rgba(0.0, 0.0, 1.0, 1.0), @tfmt("%", int(timer)));
        };
    };
    
    sgl.texturing_enabled = true;
    sgl.texture(state.img, (id=0));
    sgl.begin(.QUADS);
   
    fn draw(s: *State, area: Rect, colour: u32, tex: i64) void = {
        sgl := s.draw&;
        sgl.color = colour;
        w, h := (s.w.float(), s.h.float());
        
        x1 := area.pos.x.sub(0.0).div(w).sub(1.0).cast();
        x2 := area.pos.x.add(area.w).div(w).sub(1.0).cast();
        y1 := area.pos.y.sub(0.0).div(h.neg()).add(1.0).cast();
        y2 := area.pos.y.add(area.h).div(h.neg()).add(1.0).cast();
        
        u1, v1, u2, v2 := uv_for_texture(tex);
        
        sgl.v2f_t2f(x1, y1, u1, v1);
        sgl.v2f_t2f(x2, y1, u2, v1);
        sgl.v2f_t2f(x2, y2, u2, v2);
        sgl.v2f_t2f(x1, y2, u1, v2);
    }
    
    fn draw_square(s: *State, pos: Pos, colour: u32, tex: i64) void = 
        draw_square(s, pos, base_size, colour, tex);
    fn draw_square(s: *State, pos: Pos, size: f64, colour: u32, tex: i64) void = 
        s.draw(@as(Rect) (pos = pos, w = size, h = size), colour, tex);
    fn draw_square_frac(s: *State, pos: Pos, fraction: f64, colour: u32, tex: i64) void = {
        c := find_center(pos, fraction);
        s.draw_square(c, base_size / fraction, colour, tex);
    }
    
    fn draw_object(s: *State, ty: Object, pos: Pos) void = {
        tex, colour := get_texture(ty);
        s.draw_square_frac(pos, 1.5, colour, tex);
    }
    
    s := state;
    sgl.load_identity();
    
    s.draw(w.farm_area, light_brown, SOILD);
    
    s.draw(w.truck_area, brown, SOILD);
    world_write(state, (x = w.truck_area.pos.x, y = w.truck_area.pos.y - 20), black, "REQUESTS");
    enumerate w.requests { i, crop |
        dy, dx := i.udiv_mod(4);
        pos: Pos = (
            x = w.truck_area.pos.x + float(dx)*base_size,
            y = w.truck_area.pos.y + float(dy)*base_size,
        );
        ty: Object = (Crop = (type = crop[], age = .Ready));
        tex, colour := get_texture(ty);
        s.draw_square_frac(pos, 3, colour, tex);
    };
    
    each state.world.farm { planted | 
        s.draw_object((Crop = planted.crop), planted.pos);
    };
    for state.world.sprinklers& { it |
        s.draw_object(.Sprinkler, it);
        s.draw_square(it, config.sprinkler_range, pack_rgba(0.0, 0.0, 1.0, 0.1), SOILD);
    };
    if w.player.inventory&.is(.Sprinkler) {
        s.draw_square(w.player.pos, config.sprinkler_range, pack_rgba(0.0, 0.0, 1.0, 0.1), SOILD);
    };
    
    each state.world.shelves {obj|
        s.draw_square(obj.pos, brown, SOILD);
        if obj.scarecrow {
            s.draw_square(obj.pos, pack_rgba(0.6, 0.6, 0.6, 0.3),3);
        };
        s.draw_object(obj.item, obj.pos);
        if obj.crow_hp > 0 {
            world_write(state, obj.pos, pack_rgba(0.0, 0.0, 0.0, 1), @tfmt("%", int(obj.crow_timer)));
            world_write(state, (x=obj.pos.x, y=obj.pos.y+base_size/4), pack_rgba(0.0, 0.0, 0.0, 1), @tfmt("%hp", obj.crow_hp));
        };
    };

    world_write :: fn(state: *State, pos: Pos, colour: u32, s: Str) void = {
        sdtx := state.text.default_context&;
        sdtx.pos.x = pos.x.cast() / 16;
        sdtx.pos.y = pos.y.cast() / 16;
        sdtx.color = colour;
        sdtx.put(s);
    }
    each state.world.shops {obj|
        continue :: local_return;
        @if(obj.price == 0) continue();
        s.draw_square(obj.pos, light_brown, SOILD);
        s.draw_object(obj.item, obj.pos);
        world_write(state, obj.pos, white, @tfmt("%", obj.price));
    };
    
    fn draw(player: *Player) void => {
        s.draw_square(player.pos, black_transparent, SOILD);
        s.draw_object(player.inventory, player.pos);
        s.draw_square_frac(player.pos, 5, black, SOILD);
    }
    
    fn find_center(pos: Pos, frac: f64) Pos = {
        (x = pos.x + base_size / 2 - base_size / frac / 2, y = pos.y + base_size / 2 - base_size / frac / 2)
    }
    
    state.world.player&.draw();
    
    sgl.end();
    
    Easy'glue_begin_pass(sapp, sg, state.pass_action);
    
    sgl.draw_layer(sg, 0);
    sdtx.draw_layer(0);
    
    sg.end_pass();
    sg.commit();
};

fn get_texture(ty: Object) Ty(i64, u32) = {
    @match(ty) {
        fn None() => (7, 0);
        fn Crop(crop) => {
            tex := @if(crop.age == .Seed, 16, 8 + crop.type.raw());
            data := config.crops.index(crop.type.raw());
            (tex, data.colour)
        }
        @default => {
            it := config.items.find(fn(it) => it.type&.tag() == ty&.tag()).unwrap();  // :SLOW
            (it.tex, it.colour)
        };
    }
}

uv_for_texture :: fn(tex: i64) Ty(f32,f32,f32,f32) = {
    ty, tx := tex.udiv_mod(8);
    u1, v1 := (tx.float().cast() / 8, ty.float().cast() / 3);
    u2 := u1 + 1.0/8.0;
    v2 := v1 + 1.0/3.0;
    (u1, v1, u2, v2)
}

fn on_event(state: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = {
    if event.type == .KEY_DOWN && !event.key_repeat {
        if event.key_code == .P {
            state.world.paused = !state.world.paused;
            state.dirty = true;
            state.prev_frame_time = timestamp_s();
        };
        
        if event.key_code == .W {
            state.pressed&[0] = true;
        };
        if event.key_code == .A {
            state.pressed&[1] = true;
        };
        if event.key_code == .S {
            state.pressed&[2] = true;
        };
        if event.key_code == .D {
            state.pressed&[3] = true;
        };
        if event.key_code == .SPACE && !state.world.paused {
            state.do_interact();
        };
    };
    
    if event.type == .KEY_UP && !event.key_repeat {
        if event.key_code == .W {
            state.pressed&[0] = false;
        };
        if event.key_code == .A {
            state.pressed&[1] = false;
        };
        if event.key_code == .S {
            state.pressed&[2] = false;
        };
        if event.key_code == .D {
            state.pressed&[3] = false;
        };
    };
};

fn do_interact(state: *State) void = {
    state.dirty = true;
    player := state.world.player&;
    
    DONE :: return;
    
    say :: fn(a: FatExpr) FatExpr #macro = @{
        @[fmt_msg(prepend_tuple(@{ state.world& }, a))];
        DONE();
    };

    each state.world.shelves { shelf | 
        if center_overlaps(player.pos, base_size, shelf.pos, base_size) {
            if player.inventory&.is(.Scarecrow) && !shelf.scarecrow {
                shelf.scarecrow = true;
                shelf.crow_hp = 0;
                player.inventory = .None;
                @say("placed scarecrow");
            };
            if shelf.crow_hp > 0 {
                if player.inventory&.is(.CrowBaton) {
                    shelf.crow_hp = 0;
                } else {
                    shelf.crow_hp -= 1;
                };
                @say("hit crow");
            };
        
            temp := player.inventory;
            player.inventory = shelf.item;
            shelf.item = temp;
            return();
        }; 
    };
        each state.world.shops { shop | 
            if center_overlaps(player.pos, base_size, shop.pos, base_size) {
                if !player.inventory&.is(.None) {
                    // scanning shops first means this also prevents placing a shelf on a shop
                    @say("can't buy while holding an item");
                };
                if shop.price <= state.world.money {
                    state.world.money -= shop.price; 
                    player.inventory = shop.item;
                    return();
                } else {
                    @say("You need % more rubles to afford this item", shop.price - state.world.money);
                };
            };    
        };
    
    on_farm := center_overlaps(state.world.player.pos, base_size, state.world.farm_area.pos, state.world.farm_area.w);
    on_truck := center_overlaps(state.world.player.pos, base_size, state.world.truck_area.pos, state.world.truck_area.w);
    
    if on_farm {
        @match(player.inventory) {
            fn Crop(crop) => {
                // Try to plant a seed
                crop.age == Growth.Seed 
                    || @say("The % is fully grown. It can't be planted again.", crop.type);
                player.inventory = .None;
                state.world.farm&.push(
                    pos = player.pos, 
                    crop = crop, 
                    timer = config.crops[crop.type.raw()].time,
                );
                return();
            }
            fn None() => {
                // Try to pick up a grown plant
                enumerate state.world.farm { i, planted | 
                    if planted.crop.age == .Ready {
                        if center_overlaps(player.pos, base_size, planted.pos, base_size) {
                            player.inventory = (Crop = planted.crop);
                            state.world.farm&.unordered_remove(i); // do this last or life gets confusing!
                            return();
                        };
                    };
                };
            }
            fn WateringCan() => {
                enumerate state.world.farm { i, planted | 
                    if planted.drought { _ |
                        planted.drought = .None;
                        @say("watered %", planted.crop.type);
                    };
                };
            }
            fn Sprinkler() => {
                each state.world.farm& { it |
                    if it.drought.is_some() && state.world&.in_sprinkler(it.pos) /*SLOW: could just check new ones*/ {
                        it.drought = .None;
                    };
                };
                
                player.inventory = .None;
                state.world.sprinklers&.push(player.pos);
                @say("placed sprinkler");
            }
            fn Fertalizer() => {
                enumerate state.world.farm { i, planted | 
                    if planted.crop.age == .Seed {
                        planted.crop.age = .Ready;
                        player.inventory = .None;
                        @say("grew %", planted.crop.type);
                    }
                };
            }
            @default => @say("You can only plant seeds but you are holding %.", player.inventory&.tag());
        }
    };
    
    item := player.inventory;
    @if(on_truck) @match(item) { 
        fn Crop(crop) => {
            crop.age == .Ready || @say("Trying to sell % seed. try planting it first!", crop.type);
            r := state.world.requests&;
            i := r.index_of(fn(it) => it[] == crop.type) 
                || @say("Trying to sell % but that is not a requested item", crop.type);
            r.ordered_remove(i);
            player.inventory = .None;
            price := config.crops[crop.type.raw()].sale;
            state.world.money += price;
            if r.len == 0 {
                state.world&.next_round(state.reset);
            };
            @say("sold % for % rubles", crop.type, price);
        };
        fn HourGlass() => {
            t := float(10 + mod(state.world.round_number, 10));
            state.world.timer += t;
            state.world.next_round_timer += t;
            player.inventory = .None;
            @say("sold HourGlass for % ticks of bonus time", t)
        };
        fn None() => ();
        @default => @say("cannot sell %", item&.tag());
    }
    
    if player.inventory&.is(.Shelf) {
        state.world.shelves&.push(pos = player.pos);
        player.inventory = .None;
        @say("placed shelf")
    };
    
    @say("There is nothing to interact with here");
}

fn center_overlaps(me: Pos, me_size: f64, obj: Pos, obj_size: f64) bool = {
    center: Pos = (x = me.x + me_size / 2, y = me.y + me_size / 2);
    buffer := 10.0;
    center.x + buffer> obj.x && center.x - buffer < obj.x + obj_size && center.y + buffer > obj.y && center.y - buffer < obj.y + obj_size
}

fn on_cleanup(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    state.text&.shutdown();
    sg.destroy_pipeline(state.pipe&);
    state.draw&.destroy(sg, general_allocator());
    sg.destroy(state.img);
    state.world&.drop();
}

fn drop(w: *World) void = {
    w.shops&.drop();
    w.farm&.drop();
    w.shelves&.drop();
    w.sprinklers&.drop();
    w.requests&.drop();
    w.text&.drop();
    w.msg&.drop();
}

fn fmt_msg(arg: FatExpr) FatExpr #macro = {
    args := arg&.items();
    @{ 
        w := @[args[0]];
        n := w.text.len;
        @[format_into(@{ w.text& }, args.rest(1), arg.loc)];
        w.msg&.push(len = w.text.len - n, timer = 3);
    }
}

bake_texture :: fn() Sg.Image.Desc = {
    pixels := temp().alloc_zeroed(u32, 8*8 * 8*3);
    x, y := (0, -1);
    for texture_pixels { c |
        @switch(c) {
            @case("@".ascii()) => { pixels[y*(8*8) + x] = 0xFFFFFFFF; x += 1; };
            @case(".".ascii()) => { x += 1; };
            @case("\n".ascii()) => { y += 1; x = 0; };
            @default => unreachable();
        };
    };
    i := SubImage(pixels.interpret_as_bytes());
    (width = 8*8, height = 8*3, pixel_format = .RGBA8, data = i)
};

texture_pixels :: """
.........@@@@@@............@@......................@...@@@@@@@@@
.@@......@....@...........@..@......................@.@.@@@@@@@@
.@.@......@..@............@..@......@...............@@..@@@@@@@@
..@.@@@....@@....@....@....@@......@.@.............@@@@.@@@@@@@@
...@.@@....@@.....@..@..@@@@@@@@..@...@...........@@@..@@@@@@@@@
...@.@....@..@...@@@@@@....@@....@...@...@@@@@@..@@@....@@@@@@@@
...@@@...@....@..@....@....@@.....@.@....@@@@@@..@@.....@@@@@@@@
.........@@@@@@..@....@....@@......@......@..@..........@@@@@@@@
....@.......................@...................................
..@@@@.....@@@....@@@@......@...................................
.@@@@@@...@@@@@..@@@@@@...@@@@..................................
.@@@@@@..@@@@@@..@@@@@@...@@@@..................................
.@@@@@@..@@@@@...@@@@@@...@@@@..................................
.@@@@@@...@@@....@@@@@@...@@@@..................................
..@@@@............@@@@.....@@...................................
................................................................
................................................................
................................................................
..@@@@..........................................................
..@@@@..........................................................
..@@@@..........................................................
..@@@@..........................................................
................................................................
................................................................
""";

main :: fn() void = Easy'start(State);
driver :: fn(vtable: *ImportVTable) void = Easy'build_for_graphics(vtable, @source_file_name()); 

