// TODO: be able to compile this with the emit disabled to just use it as a disassembler
// TODO: name_str doesn't work on enums backed by the fake ints

// franca examples/default_driver.fr build examples/toy/hello.fr -arch rv64 -syscalls -os linux -keep-names
// orb ./target/release/franca-linux-arm64 examples/emu/run.fr a.out

Compile :: @struct {
    f: *Qbe.Fn;
    b: *Qbe.Blk;
    register_read := zeroed(OptionalEnumMap(RvReg, Qbe.Ref));
    // f32 and f64 are different views on the same registers. 
    // this tracks the cls of the tmp in register_read.  
    // TODO: do the same thing for Kw so don't have to insert as many sign extensions?
    register_small := zeroed(EnumSet(RvReg));
    register_write := zeroed(EnumSet(RvReg));
    register_read_real := zeroed(EnumSet(RvReg));  // TODO: remove
    cpu_addr: Qbe.Ref;
    pc: Qbe.Ref;
    entry: *u32;
    emu: *Emulator;
    out: List(u8);  // disassemble
    terminator_is_syscall := false;
};

// only one basic block is compiled at a time. 
// any brach instruction ends the trace, returning the new pc to the dispatch loop. 
// register values are read at first use and changed ones sare written at the end of the trace. 
// TODO: rn traces are compiled lazily so make_exec wastes a whole page per basic block :SLOW :SLOW :SLOW :SLOW
fn compile_trace(emu: *Emulator, entry: rawptr) i64 = {
    // this makes it match the addresses in objdump
    address := int_from_rawptr(entry) - emu.debug_base_address;
    @if(emu.log.dis) @eprintln("[%] === compiling trace[%] from % ===", tls(.thread_index)[], emu.traces&.len(), fmt_hex(address));
    emu.jit_lock&.lock();
    m := emu.m&;
    f := @ref Qbe.Fn.zeroed();
    f.default_init(m);
    b := newblk(); f.nblk += 1;
    f.start = b;
    
    self: Compile = (
        f=f,b=b,emu=emu,
        cpu_addr = f.newtmp("cpu", .Kl),
        pc = f.newtmp("pc", .Kl),
        entry = u32.ptr_from_raw(entry),
        out = list(temp()),
    ); self := self&;
    push(b, .par, .Kl, self.cpu_addr, Qbe.Null, Qbe.Null);
    // TODO: since jitting initial pc is actually constant
    push(b, .par, .Kl, self.pc, Qbe.Null, Qbe.Null);
    self.register_read&.insert(.Zero, Qbe.ConZero);
    
    continuation := Qbe.Null;
    pc := self.entry;
    // TODO: bounds / make sure the pc is mapped as executable
    while => continuation == Qbe.Null {
        @if(pc[] == 0xd503233f || pc[] == 0xd503245f) @eprintln("i predict we've stumbled into arm code");  // TODO: just don't do elf imports at all. this is just for debug while im being lazy about it
        
        continuation = decode_instruction(self, pc, .Kl);
        pc = pc.offset(1);
    };
    @debug_assert(!self.register_write&.get(.Zero), "always reads zero");
    for self.register_write& { r |
        addr := self.compute_reg_addr(r);
        value := self.register_read&.get(r).unwrap();
        o: Qbe.O = @if((@as(u8) r) >= 32, @if(self.register_small&.get(r), .stores, .stored), .storel);
        push(self.b, o, .Kw, Qbe.Null, value, addr);
    };
    self.b.jmp = (type = .retl, arg = continuation);
    self.f.ret_cls = .Kl;
    
    f.lnk.id = m.intern(@tfmt("trace%", fmt_hex(address)));
    f.lnk.no_inline = true;
    Qbe'run_qbe_passes(f);
    jit_addr, _ := m.get_addr(f.lnk.id).expect("compiled trace");
    
    trace_index := emu.traces&.len();
    emu.traces&.push(
        callee = bit_cast_unchecked(rawptr, FieldType(Trace, .callee), jit_addr),
        terminator = @if(self.terminator_is_syscall, .Syscall, .Indirect),
        jump_cache = (0, 0),
        read = self.register_read_real, // self.register_read.valid,
        write = self.register_write,
    );
    emu.trace_lookup&.insert(entry.int_from_rawptr(), trace_index);
    emu.jit_lock&.unlock();
    trace_index
}

fn decode_instruction(self: *Compile, pc: *u32, opcode_class: Qbe.Cls) Qbe.Ref = {
    b := self.b;
    op := pc[];
    opcode := @as(Opcode) @as(i64) op.bit_and(0b1111111).zext();
    rs1 := @as(RvReg) @as(u8) op.shift_right_logical(7+5+3).bit_and(0b11111).trunc();
    rs2 := @as(RvReg) @as(u8) op.shift_right_logical(7+5+3+5).bit_and(0b11111).trunc();
    rd := @as(RvReg) @as(u8) op.shift_right_logical(7).bit_and(0b11111).trunc();
    imm12 := op.shift_right_logical(32-12).zext().sign_extend(11);
    imm20 := op.bit_and(bit_not(1.shift_left(7+5) - 1)).zext().sign_extend(31);
    pc_offset := ptr_diff(self.entry, pc) * 4;
    // @bits(i.imm(11, 5), rs2, rs1, funct3, i.imm(4, 0), opcode);
    imm_S := op.shift_right_logical(32-7).shift_left(5)
        .bit_or(op.shift_right_logical(7).bit_and(0b11111))
        .zext().sign_extend(11);
    
    @match(opcode) {
        fn storef() => {  // S
            imm := imm_S; rs2 = rs2.as_float();
            k := @if(op.shift_right_logical(7+5).bit_and(0b11) == 2, Qbe.Cls.Ks, .Kd);
            @dis(self, "[%%%]= str.% %", rs1, @if(imm < 0, "", "+"), imm, k, rs2);
        
            o := @if(k == .Ks, Qbe.O.stores, .stored);
            value, addr := (self.read(rs2, k), self.read(rs1));
            addr := self.inc(addr, imm);
            push(b, o, .Kw, Qbe.Null, value, addr);
        }
        fn loadf() => {  // I
            imm := imm12; rd = rd.as_float();
            k := @if(op.shift_right_logical(7+5).bit_and(0b11) == 2, Qbe.Cls.Ks, .Kd);
            @dis(self, "%= ldr.% [%%%]", rd, k, rs1, @if(imm < 0, "", "+"), imm);
            addr, dest := (self.read(rs1), self.write(rd, k));
            addr := self.inc(addr, imm);
            push(b, .load, k, dest, addr, Qbe.Null);
        }
        fn op_fp() => {
            rm := op.shift_right_logical(5+7).bit_and(0b111);
            
            if op.bit_and(0b01001101110000000000000001111111) == 0b01000000000000000000000001010011 {
                // encode_fcnvt and also cast
                // TODO: this is insane, factor out a table to share with encoding
                B :: fn(x) => op.shift_right_logical(31-x).bit_and(1) == 1;
                have_ints, is_cast, from_int, double, long, unsigned := (B(0), B(2), B(3), B(6), B(10), B(11));
                (o: Qbe.O, k: Qbe.Cls) := @if_else {
                    @if(is_cast && from_int && !long && !long && !unsigned) => (.cast, @if(double, .Kd, .Ks));
                    @if(is_cast && !from_int && !long && !long && !unsigned) => (.cast, @if(double, .Kl, .Kw));
                    @if(have_ints && from_int && double && !long && !unsigned) => (.swtof, .Kd);
                    @if(have_ints && !from_int && !double && !unsigned) => (.stosi, @if(long, .Kl, .Kw));
                    @if(have_ints && !from_int && double && !unsigned) => (.dtosi, @if(long, .Kl, .Kw));
                    @if(have_ints && from_int && long && !unsigned) => (.sltof, @if(double, .Kd, .Ks));
                    @if(have_ints && from_int && double && !long && unsigned) => (.uwtof, .Kd);
                    @if(!have_ints && !from_int && !double && !long && unsigned) => (.truncd, .Ks);
                    @else => @panic("TODO: op_fp % % % % % %", have_ints, from_int, double, long, unsigned, fmt_hex(op));
                };
                rd = @if(k.is_float(), rd.as_float(), rd);
                rs1 = @if(!from_int, rs1.as_float(), rs1);
                @dis(self, "%= %.% %", rd, o, k, rs1);
                k_in: Qbe.Cls = @if(from_int, .Kl, @if(double||o==.truncd, .Kd, .Ks));
                a, r := (self.read(rs1, k_in), self.write(rd, k));
                t := @if(k == .Kw, self.f.newtmp("w", .Kw), r);
                push(b, o, k, t, a, Qbe.Null);
                @if(k == .Kw) push(b, .extsw, .Kl, r, t, Qbe.Null);
            } else {
                opf := @as(OpF) @as(i64) op.shift_right_logical(32-5).zext();
                size := op.shift_right_logical(32-5-2).bit_and(0b11);
                k: Qbe.Cls = @switch(size) {
                    @case(0) => .Ks;
                    @case(1) => .Kd;
                    @default => @panic("TODO: other float size");
                };
                o: Qbe.O = @match(opf) {
                    fn add() => .add;
                    fn sub() => .sub;
                    fn mul() => .mul;
                    fn div() => .div;
                    fn sqrt() => @panic("tODO: sqrt");
                    fn min_max() => @panic("tODO: min_max");
                    fn cmp() => {
                        c := @as(OpF_cmp) @as(i64) rm.zext();
                        @match(c) {
                            fn eq() => @if(k == .Ks, .ceqs, .ceqd);
                            fn lt() => @if(k == .Ks, .clts, .cltd);
                            fn le() => @if(k == .Ks, .cles, .cled);
                        }
                    }
                    fn sgnj() => {
                        @if(rs1 != rs2) @panic("TODO: non-unary sgnj");
                        @switch(rm) {
                            @case(0b000) => .copy;
                            @case(0b001) => .neg;
                            @default => @panic("TODO: sgnj %", rm);
                        }
                    }
                };
                if opf != .cmp {
                    rd = rd.as_float(); 
                };
                rs1 = rs1.as_float(); rs2 = rs2.as_float();
                a0, a1 := (self.read(rs1, k), self.read(rs2, k));
                if @is(o, .copy, .neg) {
                    a1 = Qbe.Null;
                };
                @dis(self, "%= %.% % %", rd, o, k, rs1, rs2);
                if opf == .cmp {
                    k = .Kl;
                };
                dest := self.write(rd, k);
                push(b, o, k, dest, a0, a1);
            };
        }
        fn store() => {  // S
            imm := imm_S;
            size := op.shift_right_logical(7+5).bit_and(0b11).zext();
            size_bytes := 1.shift_left(size)*8;
            @dis(self, "[%%%]= str.% %", rs1, @if(imm < 0, "", "+"), imm, size_bytes, rs2);
        
            sizes := @const_slice(Qbe.O.storeb, .storeh, .storew, .storel);
            o := sizes[size];
            value, addr := (self.read(rs2), self.read(rs1));
            addr := self.inc(addr, imm);
            push(b, o, .Kw, Qbe.Null, value, addr);
        }
        fn load() => {  // I
            imm := imm12;
            zero_extend := op.shift_right_logical(7+5+2).bit_and(1) == 1;
            size := op.shift_right_logical(7+5).bit_and(0b11).zext();
            size_bytes := 1.shift_left(size)*8;
            @dis(self, "%= ldr.%% [%%%]", rd, @if(zero_extend, "u", "i"), size_bytes, rs1, @if(imm < 0, "", "+"), imm);
            addr, dest := (self.read(rs1), self.write(rd));
            
            sizes := @const_slice(Qbe.O.loadsb, .loadsh, .loadsw, .load, .loadub, .loaduh, .loaduw, .load);
            o := sizes[size + 4*int(zero_extend)];
            addr := self.inc(addr, imm);
            push(b, o, .Kl, dest, addr, Qbe.Null);
        }
        fn op_imm() => {  // I
            imm := imm12;
            funct3 := @as(OpI) @as(i64) op.shift_right_logical(7+5).bit_and(0b111).zext();
            a0, dest := (self.read(rs1), self.write(rd));
            // TODO: rot are in high bits of imm
            if funct3 == .sll && imm >= 64 {  // 0b001
                @if(opcode_class != .Kl) @panic("TODO: count kw 0b001 % %", imm, fmt_hex(op));
                o: Qbe.O = @switch(imm) {
                    @case(0b011000000001) => .ctz;
                    @case(0b011000000010) => .ones;
                    @case(0b011000000100) => .extsb;
                    @default => @panic("TODO: unary op_imm 0b001 % %", imm, fmt_hex(op));
                };
                @dis(self, "%= % %", rd, o, rs1);
                push(b, o, .Kl, dest, a0, Qbe.Null);
                return Qbe.Null;
            };
            o := funct3_to_op(funct3);
            if funct3 == .srl && imm >= 64 {  // 0b101
                imm_hi := imm.shift_right_logical(6);
                if imm_hi == 0b10000 {
                    imm = imm.bit_and(1.shift_left(6 - int(opcode_class == .Kw))-1);
                    o = .sar;
                } else {
                    @panic("TODO: unary op_imm 0b101 % %", imm, fmt_hex(op));
                };
            };
            
            @dis(self, "%= %% %, %", rd, o, @if(opcode_class == .Kl, "", ".w"), rs1, imm);
            a1 := self.f.getcon(imm);
            if opcode_class == .Kl {
                push(b, o, .Kl, dest, a0, a1);
            } else {
                t := self.f.newtmp("w", .Kw);
                push(b, o, .Kw, t, a0, a1);
                push(b, .extsw, .Kl, dest, t, Qbe.Null);
            };
        }
        fn op() => {  // R
            funct3 := @as(OpI) @as(i64) op.shift_right_logical(7+5).bit_and(0b111).zext();
            funct7 := op.shift_right_logical(32-7);
            a0, a1, dest := (self.read(rs1), self.read(rs2), self.write(rd));
            already_dis := false;
            o: Qbe.O = @switch(funct7) {
                @case(0) => funct3_to_op(funct3);
                @case(1) => {
                    @switch(@as(i64) funct3) {
                        @case(0b000) => .mul;
                        @case(0b100) => .div;
                        @case(0b101) => .udiv;
                        @case(0b110) => .rem;
                        @case(0b111) => .urem;
                        @default => @panic("TODO: op % % %", @as(i64) funct3, funct7, fmt_hex(op));
                    }
                }
                @case(0b0100000) => {
                    @match(funct3) {
                        fn add() => .sub;
                        fn or() => {  // orn
                            @if(opcode_class != .Kl) @panic("TODO: opw % % %", @as(i64) funct3, funct7, fmt_hex(op));
                            t := self.f.newtmp("r", .Kl);
                            push(b, .xor, .Kl, t, a1, self.f.getcon(-1));
                            a1 = t;
                            already_dis = true;
                            @dis(self, "%= orn %, %", rd, rs1, rs2);
                            .or
                        }
                        fn srl() => .sar;
                        @default => @panic("TODO: op % % %", @as(i64) funct3, funct7, fmt_hex(op));
                    }
                };
                @case(0b0000111) => {
                    @if(opcode_class != .Kl) @panic("TODO: opw % % %", @as(i64) funct3, funct7, fmt_hex(op));
                    o: Qbe.O = @switch(@as(i64) funct3) {
                        @case(0b101) => .ceql;
                        @case(0b111) => .cnel;
                        @default => @panic("TODO: op % % %", @as(i64) funct3, funct7, fmt_hex(op));
                    };
                    
                    @dis(self, "%= % % 0?0: %", rd, o, rs2, rs1);
                    inspect, value, dest := (self.read(rs2), self.read(rs1), self.write(rd));
                    cond := self.f.newtmp("r", .Kw);
                    push(b, o, .Kw, cond, inspect, Qbe.ConZero);
                    push(b, .sel0, .Kw, Qbe.Null, cond, Qbe.Null);
                    push(b, .sel1, .Kl, dest, Qbe.ConZero, value);
                    return Qbe.Null;
                }
                @case(0b0000100) => {
                    @if(opcode_class != .Kw) @panic("TODO: op % % %", @as(i64) funct3, funct7, fmt_hex(op));
                    o: Qbe.O = @switch(@as(i64) funct3) {
                        @case(0b000) => .extuw;
                        @case(0b100) => .extuh;
                        @default => @panic("TODO: op % % %", @as(i64) funct3, funct7, fmt_hex(op));
                    };
                    t := self.f.newtmp("w", .Kl);
                    push(b, o, .Kl, t, a0, Qbe.Null);
                    push(b, .add, .Kl, dest, a1, t);
                    @dis(self, "%= % %, %", rd, o, rs1, rs2);
                    return Qbe.Null;
                };
                @case(48) => @match(funct3) {
                    fn sll() => .rotl;
                    @default => @panic("TODO: op % % %", @as(i64) funct3, funct7, fmt_hex(op));
                };
                @default => @panic("TODO: op % % %", @as(i64) funct3, funct7, fmt_hex(op));
            };
            @if(!already_dis) @dis(self, "%= %% %, %", rd, o, @if(opcode_class == .Kl, "", ".w"), rs1, rs2);
            if opcode_class == .Kl {
                push(b, o, .Kl, dest, a0, a1);
            } else {
                t := self.f.newtmp("w", .Kw);
                push(b, o, .Kw, t, a0, a1);
                push(b, .extsw, .Kl, dest, t, Qbe.Null);
            };
        }
        fn op32() => { decode_instruction(self, @ref op.bit_xor(0b1000), .Kw); }   // op
        fn opw() => { decode_instruction(self, @ref op.bit_xor(0b1000), .Kw); }    // op_imm
        fn auipc() => {  // U
            imm, dest := (imm20, self.write(rd));
            push(b, .add, .Kl, dest, self.pc, self.f.getcon(pc_offset + imm));
            @dis(self, "%= auipc %", rd, imm);
        }
        fn lui() => {  // U
            imm, dest := (imm20, self.write(rd));
            @dis(self, "%= lui %", rd, imm);
            push(b, .copy, .Kl, dest, self.f.getcon(imm), Qbe.Null);
        }
        fn jalr() => {  // I
            imm := imm12;
            new_pc, link := (self.read(rs1), self.write(rd));
            @dis(self, "%= jalr % %%", rd, rs1, @if(imm < 0, "", "+"), imm);
            // TODO: clear low bit?
            new_pc := self.inc(new_pc, imm);
            
            // not inc() because of new_pc=link,off=0
            new_pc_out := self.f.newtmp("new_pc", .Kl);
            push(b, .add, .Kl, new_pc_out, new_pc, self.f.getcon(imm));
            
            push(b, .add, .Kl, link, self.pc, self.f.getcon(pc_offset + 4));
            return new_pc_out;
        }
        // bcmp,jal: imm always even, no low bit
        fn bcmp() => {
            funct3 := @as(Bcmp) @as(i64) op.shift_right_logical(7+5).bit_and(0b111).zext();
            // TODO: not confident i typed this right
            //@bits(i.imm(12), i.imm(10, 5), rs2, rs1, funct3, i.imm(4, 1), i.imm(11), opcode);
            imm := op.shift_right_logical(7).bit_and(1).shift_left(11)
                .bit_or(op.shift_right_logical(31).shift_left(12))
                .bit_or(op.shift_right_logical(32-1-6).bit_and(0b111111).shift_left(5))
                .bit_or(op.shift_right_logical(7+1).bit_and(0b1111).shift_left(1))
                .zext().sign_extend(12);
            a0, a1 := (self.read(rs1), self.read(rs2));
            o: Qbe.O = @match(funct3) {
                fn beq() => .ceql;
                fn bne() => .cnel;
                @default => @panic("TODO: bcmp %", fmt_hex(op));
            };
            @dis(self, "b.% %, %, pc%%", o, rs1, rs2, @if(imm < 0, "", "+"), imm);
            cond, new_pc := (self.f.newtmp("cond", .Kw), self.f.newtmp("new_pc", .Kl));
            fallthrough_pc := self.inc(self.pc, pc_offset + 4);
            jump_pc := self.inc(self.pc, pc_offset + imm);
            push(b, o, .Kw, cond, a0, a1);
            push(b, .sel0, .Kw, Qbe.Null, cond, Qbe.Null);
            push(b, .sel1, .Kl, new_pc, jump_pc, fallthrough_pc);
            return new_pc;
        }
        fn jal() => {
            // TODO: not confident
            //@bits(i.imm(20), i.imm(10, 1), i.imm(11), i.imm(19, 12), rd, opcode);
            imm := op.shift_right_logical(31).shift_left(20)
                .bit_or(op.shift_right_logical(32-11).bit_and(1.shift_left(10)-1).shift_left(1))
                .bit_or(op.shift_right_logical(7+5+8).bit_and(1).shift_left(11))
                .bit_or(op.shift_right_logical(7+5).bit_and(1.shift_left(8)-1).shift_left(12))
                .zext().sign_extend(20);
            
            push(b, .add, .Kl, self.write(rd), self.pc, self.f.getcon(pc_offset + 4));
            @dis(self, "%= jal pc%%", rd, @if(imm < 0, "", "+"), imm);
            return self.inc(self.pc, pc_offset + imm);
        }
        fn system() => {
            @if(op != ecall) @panic("TODO: system %", fmt_hex(op));
            @dis(self, "ecall");
            self.terminator_is_syscall = true;
            return self.inc(self.pc, pc_offset + 4);
        }
        fn amo() => {
            funct7 := op.shift_right_logical(32-7);
            funct3 := op.shift_right_logical(7+5).bit_and(0b111);
            @if(funct7 != 0b0010111 || funct3.bit_and(0b110) != 0b010) @panic("TODO: amo %", fmt_hex(op));
            k := @if(funct3.bit_and(1) == 1, Qbe.Cls.Kl, .Kw);
            
            @dis(self, "%= amocas.%.aqrl % %", rd, k, rs1, rs2);
            p, new, old, dest := (self.read(rs1), self.read(rs2), self.read(rd), self.write(rd));
            t := @if(k == .Kl, dest, self.f.newtmp("w", .Kw));
            push(b, .cas0, .Kw, Qbe.Null, p, Qbe.Null);
            push(b, .cas1, k, t, old, new);
            if k == .Kw {
                push(b, .extsw, .Kl, dest, t, Qbe.Null);
            };
        }
        fn misc_mem() => {
            fence := @bits(0b0000, 0b11111111, 0b00000, 0b000, 0b00000, 0b0001111);
            @if(op != fence) @panic("TODO: misc_mem %", fmt_hex(op));
            callee := self.f.getcon(int_from_rawptr(import("@/lib/sys/sync/atomics.fr").fence_impl));
            push(b, .call, .Kw, Qbe.Null, callee, Qbe.Null);
        }
    };
    Qbe.Null
}

funct3_to_op :: fn(funct3: OpI) Qbe.O = @match(funct3) {
    fn add() => .add;
    fn sltu() => .cultl;
    fn xor() => .xor;
    fn sll() => .shl;
    fn or() => .or;
    fn slt() => .csltl;
    fn srl() => .shr;
    fn and() => .and;
};

fn inc(self: *Compile, r: Qbe.Ref, off: i64) Qbe.Ref = {
    @if(off == 0) return(r);
    out := self.f.newtmp("inc", .Kl);
    push(self.b, .add, .Kl, out, r, self.f.getcon(off));
    out
}

as_float :: fn(r: RvReg) RvReg = @as(RvReg) @as(u8) (32 + @as(u8) r);

// calling self.read before self.write matters because if first reference to a reg in a function is write is never needs to load the old value
fn read(self: *Compile, r: RvReg) Qbe.Ref = self.read(r, false, .Kl);
fn read(self: *Compile, r: RvReg, k: Qbe.Cls) Qbe.Ref = self.read(r, false, k);
fn read(self: *Compile, r: RvReg, fake: bool, k: Qbe.Cls) Qbe.Ref = {   
    ::?Qbe.Ref;
    if k == .Kw {
        k = .Kl;
    };
    if k.is_float() && 32 > zext(@as(u8) r) {
        r = r.as_float();
    };
    if k.is_float() && self.register_read&.get(r).is_some() && (k == .Ks) != self.register_small&.get(r) {
        @debug_assert(!fake);
        // last read/write of the reg in this block was a different size than this instruction needs. 
        @panic("TODO: reinterpret float size % new=%", r, k);
    };
    @if(k == .Kd) self.register_small&.unset(r);
    @if(k == .Ks) self.register_small&.set(r);
    
    self.register_read&.get(r) || {
        dest := self.f.newtmp(r.name_str(), k);
        self.register_read&.insert(r, dest);
        if !fake { 
            self.register_read_real&.set(r);
            addr := self.compute_reg_addr(r);
            push(self.b, .load, k, dest, addr, Qbe.Null);
        };
        dest
    }
}

fn write(self: *Compile, r: RvReg) Qbe.Ref = self.write(r, .Kl);
fn write(self: *Compile, r: RvReg, k: Qbe.Cls) Qbe.Ref = {
    if k == .Kw {
        k = .Kl;
    };
    if k.is_float() && 32 > zext(@as(u8) r) {
        r = r.as_float();
    };
    
    if k.is_float() && self.register_read&.get(r).is_some() && (k == .Ks) != self.register_small&.get(r) {
        // ex. last used for f32 and now stomping it with an f64, that's fine just need to make a new tmp for it. 
        self.register_read&.remove(r);
    };
    
    @if(k == .Ks) self.register_small&.set(r);
    @if(k == .Kd) self.register_small&.unset(r);

    // writing to zero is common. ex. don't need seperate instruction for jump without link
    @if(r == .Zero) return(self.f.newtmp("discard", .Kl));
    
    self.register_write&.set(r);
    self.read(r, true, k)
}

fn compute_reg_addr(self: *Compile, r: RvReg) Qbe.Ref = {
    off := offset_of(Cpu, .reg) + 8*(@as(u8) r).zext();
    addr := self.f.newtmp("r_addr", .Kl);
    push(self.b, .add, .Kl, addr, self.cpu_addr, self.f.getcon(off));
    addr
}

#use("@/backend/rv64/bits.fr");
fn dis(e: FatExpr) FatExpr #macro = {
    e := e&.items();
    @{
        self := @[e[0]];
        if self.emu.disassemble {
            self.out&.clear();
            @[format_into(@{ self.out& }, e.rest(1), e[0].loc)];
            self.out&.push_all("\n");
            eprint(self.out.items());
        }
    }
}
