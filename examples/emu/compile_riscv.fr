// TODO: be able to compile this with the emit disabled to just use it as a disassembler
// TODO: name_str doesn't work on enums backed by the fake ints

// TODO: i stick in the address for handle_syscall and fence 
//       which means its not pic so can't save it. 
//       might want to change that when i do exec so can reuse 
//       the compiled code if you exec the same binary many times.  

Compile :: @struct {
    f: *Qbe.Fn;
    b: *Qbe.Blk;
    register_read := zeroed(OptionalEnumMap(RvReg, Qbe.Ref));
    // f32 and f64 are different views on the same registers. 
    // this tracks the cls of the tmp in register_read.  
    // TODO: do the same thing for Kw so don't have to insert as many sign extensions?
    register_small := zeroed(EnumSet(RvReg));
    register_write := zeroed(EnumSet(RvReg));
    cpu_addr: Qbe.Ref;
    pc: Qbe.Ref;
    entry: *u32;
    emu: *Emulator;
    out: *List(u8);  // disassemble
    terminator := Terminator.Indirect;
    direct_jump_targets: Array(?i64, 2) = (.None, .None);
    bcmp_condition: ?Qbe.Ref = .None;  
    mapping: *JitMapping;
    error := "";
};
Terminator :: @enum(u8) (Direct, Indirect, Syscall, Halt, Error);

// when the jump target is constant, follow it and compile a new trace eagerly. 
// which allows direct jumps to be fixed tail calls without going through lookup again 
// (also packs more traces into fewer make_exec calls which matters if !expecting_wx or wasm). 
// this means that decode_instruction can't panic on invalid/unknown/unmapped instructions. 
// technically it's legal to have a constant jump into something that isn't code and just never execute it.
// so instead decode errors make valid traces ending with a invalid_instruction_handler call.  
fn compile_trace(emu: *Emulator, entry: rawptr, mapping: *JitMapping) *Trace = {
    work := rawptr.list(temp());
    work&.push(entry);
    first: ?*Trace = .None;
    @debug_assert(emu.jit_lock&.locked_by_me(), "compile_trace needs lock");
    while => work&.pop() { entry |
        if first.is_none() || emu.trace_lookup&.get(entry.int_from_rawptr()).is_none() {
            // this makes it match the addresses in objdump
            address := int_from_rawptr(entry) - emu.debug_base_address;
            @if(emu.log.dis) @eprintln("[%]% === compiling trace[%] from % ===", 
                tls(.thread_index)[], @if(first.is_none(), "!", "?"), emu.traces&.len(), fmt_hex(address));
            t, direct_jump_targets := compile_one_trace(emu, entry, mapping);
            if first.is_none() {
                first = (Some = t);
            };
            for direct_jump_targets& { it |
                if it { it |
                    work&.push(entry.offset(it));
                };
            };
        };
    };
    Qbe'enter_task(mapping.worker) { e |
        e.task = .MakeExec;
    };
    first.unwrap()
}

// only one basic block is compiled at a time. 
// any brach instruction ends the trace, returning the new pc to the dispatch loop. 
// register values are read at first use and changed ones sare written at the end of the trace. 
fn compile_one_trace(emu: *Emulator, entry: rawptr, mapping: *JitMapping) Ty(*Trace, Array(?i64, 2)) = {
    result := zeroed(Ty(*Trace, Array(?i64, 2)));
    @debug_assert(entry.int_from_rawptr() > 0, "mmap is never going to return something with the high bit set so i reserve them for trace.pc that shouldn't match anything");
Qbe'enter_task(mapping.worker) { codegen_entry | 
    m := mapping.m&;
    f := temp().box_uninit(Qbe.Fn);
    f.default_init(m);
    b := newblk(); f.nblk += 1;
    f.start = b;
    
    self: Compile = (
        f=f,b=b,emu=emu,
        cpu_addr = f.newtmp("cpu", .Kl),
        pc = f.newtmp("pc", .Kl),
        entry = u32.ptr_from_raw(entry),
        out = @ref u8.list(temp()),
        mapping = mapping,
    ); self := self&;
    push(b, .par, .Kl, self.cpu_addr, Qbe.Null, Qbe.Null);
    // TODO: since jitting initial pc is actually constant
    push(b, .par, .Kl, self.pc, Qbe.Null, Qbe.Null);
    self.register_read&.insert(.Zero, Qbe.ConZero);
    
    continuation := Qbe.Null;
    pc := self.entry;
    while => continuation == Qbe.Null {
        continuation = decode_instruction(self, pc, .Kl);
        pc = pc.offset(1);
        
        oob := !mapping.mem.address_contains_pc(pc);
        if oob && continuation == Qbe.Null {
            // fall back to the run() loop calling lookup_trace again so don't have to deal with multiple modules here
            continuation = self.inc(self.pc, ptr_diff(self.entry, pc) * 4);
        };
    };
    self.remove_cross_mapping_direct_jumps();
    
    @debug_assert(!self.register_write&.get(.Zero), "always reads zero");
    for self.register_write& { r |
        addr := self.compute_reg_addr(r);
        value := self.register_read&.get(r).unwrap();
        o: Qbe.O = @if((@as(u8) r) >= 32, @if(self.register_small&.get(r), .stores, .stored), .storel);
        push(self.b, o, .Kw, Qbe.Null, value, addr);
    };
    self.f.ret_cls = .Kl;
    @match(self.terminator) {
        fn Halt() => {
            self.b.jmp = (type = .hlt, arg = Qbe.Null);
        }
        fn Syscall() => {
            // after storing registers
            syscall_handler := self.f.getcon(bit_cast_unchecked(@type self.emu.syscall_handler, i64, self.emu.syscall_handler));
            push(b, .arg, .Kl, Qbe.Null, self.cpu_addr, Qbe.Null);                
            push(b, .arg, .Kl, Qbe.Null, continuation, Qbe.Null); // for clone()
            push(b, .call, .Kw, Qbe.Null, syscall_handler, Qbe.Null);
            
            // now .Direct to where the syscall returns to. 
            // can't continue emitting into the same trace because clone returns twice. 
            if self.direct_jump_targets&[0] { new_pc_off |
            new_pc := self.pc_symbol(new_pc_off);
            next_pc := self.f.newtmp("next_pc", .Kl);
            push(b, .arg, .Kl, Qbe.Null, self.cpu_addr, Qbe.Null);                
            push(b, .arg, .Kl, Qbe.Null, continuation, Qbe.Null);
            push(b, .call, .Kl, next_pc, new_pc, Qbe.Null);
            self.b.unsafe_tail_call = true;
            continuation = next_pc;
            };  // else: remove_cross_mapping_direct_jumps killed it for being at the end of the mapping 
        }
        // TODO: this also means you need to keep track of dependencies so flush_icache can go backwards and recompile everything
        //       add a test for that to rv_icache.fr
        fn Direct() => {
            new_pc := self.pc_symbol(self.direct_jump_targets&[0].unwrap());
            if self.bcmp_condition { cond |
                choice := self.f.newtmp("cmp_pc", .Kl);
                new_pc2 := self.pc_symbol(self.direct_jump_targets&[1].unwrap());
                other_pc_off := self.direct_jump_targets&[0].unwrap();
                push(b, .sel0, .Kw, Qbe.Null, cond, Qbe.Null);
                push(b, .sel1, .Kl, choice, new_pc, new_pc2);
                new_pc = choice;
            };
            next_pc := self.f.newtmp("next_pc", .Kl);
            push(b, .arg, .Kl, Qbe.Null, self.cpu_addr, Qbe.Null);                
            push(b, .arg, .Kl, Qbe.Null, continuation, Qbe.Null);
            push(b, .call, .Kl, next_pc, new_pc, Qbe.Null);
            self.b.unsafe_tail_call = true;
            continuation = next_pc;
        }
        fn Indirect() => ();
        fn Error() => {
            @dis(self, "unknown %; %", fmt_hex(pc[]), self.error);
            
            error_handler := self.f.getcon(bit_cast_unchecked(@type self.emu.invalid_instruction_handler, i64, self.emu.invalid_instruction_handler));
            continuation = self.inc(self.pc, ptr_diff(self.entry, pc) * 4);
            push(b, .arg, .Kl, Qbe.Null, self.cpu_addr, Qbe.Null);                
            push(b, .arg, .Kl, Qbe.Null, continuation, Qbe.Null);
            push(b, .call, .Kw, Qbe.Null, error_handler, Qbe.Null);
        }
    };
    if self.terminator != .Halt {
        self.b.jmp = (type = .retl, arg = continuation);
    };
    
    f.lnk.id = self.mangle(int_from_rawptr(entry));
    f.lnk.no_inline = true;
    codegen_entry.task = (Func = f);
    junk_trace :: @static { t := zeroed(Trace); t.pc = -2; t };
    trace := emu.traces&.push(
        callee = zeroed(FieldType(Trace, .callee)),  // patched in lookup_trace
        symbol = f.lnk.id,
        jump_cache = (junk_trace, junk_trace),
        mapping = self.mapping,
        pc = u32.int_from_ptr(self.entry),
    );
    result = (trace, self.direct_jump_targets);    
    emu.trace_lookup&.insert(entry.int_from_rawptr(), trace);
    code := u8.ptr_from_raw(entry).slice(ptr_diff(self.entry, pc) * 4);
    emu.trace_map&.insert(code, trace);
    
    if self.emu.disassemble {
        eprint(self.out.items());
    }
};
    result
}

// TODO: could allow this and have pc_symbol,mangle get the address from the other mapping's module 
//       but then have to deal with the trace won't be created yet and the mapping might not 
//       even be created yet and might flush_cache before it executes, etc. etc. etc. 
//       for now this doesn't actually happen in my programs so being a tiny bit slower is fine. 
remove_cross_mapping_direct_jumps :: fn(self: *Compile) void #once = {
    each self.direct_jump_targets& { it |
        if it { dest |
            oob := !self.mapping.mem.address_contains_pc(self.entry.offset(dest[].udiv(4)));
            if oob {
                it[] = .None;
                if self.terminator == .Direct {
                    self.terminator = .Indirect;
                };
            };
        };
    };
};

fn pc_symbol(self: *Compile, new_pc_off: i64) Qbe.Ref = {
    new_pc := u32.int_from_ptr(self.entry) + new_pc_off;
    // re-intern with the new icache_generation would be wrong if new_pc was already compiled before flush but wasn't in the flushed range. 
    if self.emu.trace_lookup&.get(new_pc) { t |
        @debug_assert(identical(t.mapping, self.mapping), "can't jump between mappings");
        return self.f.symcon(t.symbol);
    };
    self.f.symcon(self.mangle(new_pc))
}

fn mangle(self: *Compile, pc: i64) Qbe.Sym = {
    @debug_assert(identical(self.emu.find_mapping(pc), self.mapping), "can't jump between mappings");
    pc -= self.emu.debug_base_address;
    self.mapping.m&.intern(@tfmt("%trace%", self.emu.icache_generation, fmt_hex(pc)))  // :AddressInMangledName
}

fn decode_instruction(self: *Compile, pc: *u32, opcode_class: Qbe.Cls) Qbe.Ref = {
    b := self.b;
    op := pc[];
    I :: fn(left: i64, right: i64, off: i64) u32 => 
        op.shift_right_logical(right).bit_and(@as(u32) 1.shift_left(left - right + 1) - 1).shift_left(off);
    opcode := @as(Opcode) @as(i64) I(6, 0, 0).zext();
    rs1 := @as(RvReg) @as(u8) I(19, 15, 0).trunc();
    rs2 := @as(RvReg) @as(u8) I(24, 20, 0).trunc();
    rd := @as(RvReg) @as(u8) I(11, 7, 0).trunc();
    
    imm12 := I(31, 20, 0).zext().sign_extend(11);
    imm20 := I(31, 12, 0).shift_left(12).zext().sign_extend(31);
    pc_offset := ptr_diff(self.entry, pc) * 4;
    imm_S := I(31, 25, 5).bit_or(I(11, 7, 0)).zext().sign_extend(11);

    slow_check_enum(Opcode, opcode) || return(self.error("bad opcode"));

    @match(opcode) {
        fn storef() => {  // S
            imm := imm_S; rs2 = rs2.as_float();
            k := @if(I(13, 12, 0) == 2, Qbe.Cls.Ks, .Kd);
            @dis(self, "[%%%]= str.% %", rs1, @if(imm < 0, "", "+"), imm, k, rs2);
        
            o := @if(k == .Ks, Qbe.O.stores, .stored);
            value, addr := (self.read(rs2, k), self.read(rs1));
            addr := self.inc(addr, imm);
            push(b, o, .Kw, Qbe.Null, value, addr);
        }
        fn loadf() => {  // I
            imm := imm12; rd = rd.as_float();
            k := @if(I(13, 12, 0) == 2, Qbe.Cls.Ks, .Kd);
            @dis(self, "%= ldr.% [%%%]", rd, k, rs1, @if(imm < 0, "", "+"), imm);
            addr, dest := (self.read(rs1), self.write(rd, k));
            addr := self.inc(addr, imm);
            push(b, .load, k, dest, addr, Qbe.Null);
        }
        fn op_fp() => {
            rm := I(14, 12, 0);
            
            if op.bit_and(0b01001101110000000000000001111111) == 0b01000000000000000000000001010011 {
                // encode_fcnvt and also cast
                // TODO: this is insane, factor out a table to share with encoding
                B :: fn(x) => op.shift_right_logical(31-x).bit_and(1) == 1;
                have_ints, is_cast, from_int, double, long, unsigned := (B(0), B(2), B(3), B(6), B(10), B(11));
                (kf: Qbe.Cls, ki: Qbe.Cls) := (@if(double, .Kd, .Ks), @if(long, .Kl, .Kw));
                (o: Qbe.O, k: Qbe.Cls) := @if_else {
                    @if(is_cast && from_int && !long && !unsigned) => (.cast, kf);
                    @if(is_cast && !from_int && !long && !unsigned) => (.cast, @if(double, .Kl, .Kw));
                    @if(have_ints && from_int && !long && !unsigned) => (.swtof, kf);
                    @if(have_ints && from_int && long && unsigned) => (.ultof, kf);
                    @if(have_ints && !from_int && !double && !unsigned) => (.stosi, ki);
                    @if(have_ints && !from_int && !double && unsigned) => (.stoui, ki);
                    @if(have_ints && !from_int && double && !unsigned) => (.dtosi, ki);
                    @if(have_ints && !from_int && double && unsigned) => (.dtoui, ki);
                    @if(have_ints && from_int && long && !unsigned) => (.sltof, kf);
                    @if(have_ints && from_int && !long && unsigned) => (.uwtof, kf);
                    @if(!have_ints && !from_int && !double && !long && unsigned) => (.truncd, .Ks);
                    @if(!have_ints && !from_int && double && !long && !unsigned) => (.exts, .Kd);
                    @else => return(self.error(@tfmt("op_fp % % % % %", have_ints, from_int, double, long, unsigned)));
                };
                rd = @if(k.is_float(), rd.as_float(), rd);
                rs1 = @if(!from_int, rs1.as_float(), rs1);
                @dis(self, "%= %.% %", rd, o, k, rs1);
                k_in: Qbe.Cls = @if(from_int, .Kl, @if((double||o==.truncd)&&o!=.exts, .Kd, .Ks));
                a, r := (self.read(rs1, k_in), self.write(rd, k));
                t := @if(k == .Kw, self.f.newtmp("w", .Kw), r);
                push(b, o, k, t, a, Qbe.Null);
                @if(k == .Kw) push(b, .extsw, .Kl, r, t, Qbe.Null);
            } else {
                opf := @as(OpF) @as(i64) I(31, 27, 0).zext();
                size := I(26, 25, 0);
                k: Qbe.Cls = @switch(size) {
                    @case(0) => .Ks;
                    @case(1) => .Kd;
                    @default => return(self.error("other float size"));
                };
                slow_check_enum(OpF, opf) || return(self.error("opf"));
                o: Qbe.O = @match(opf) {
                    fn add() => .add;
                    fn sub() => .sub;
                    fn mul() => .mul;
                    fn div() => .div;
                    fn sqrt() => .sqrt;
                    fn min_max() => {
                        c := @as(OpF_min_max) @as(i64) rm.zext();
                        slow_check_enum(OpF_min_max, c) || return(self.error("OpF_min_max"));
                        @match(c) {
                            fn min() => .min;
                            fn max() => .max;
                        }
                    }
                    fn cmp() => {
                        c := @as(OpF_cmp) @as(i64) rm.zext();
                        slow_check_enum(OpF_cmp, c) || return(self.error("OpF_cmp"));
                        @match(c) {
                            fn eq() => @if(k == .Ks, .ceqs, .ceqd);
                            fn lt() => @if(k == .Ks, .clts, .cltd);
                            fn le() => @if(k == .Ks, .cles, .cled);
                        }
                    }
                    fn sgnj() => {
                        @if(rs1 != rs2) return(self.error("non-unary sgnj"));
                        @switch(rm) {
                            @case(0b000) => .copy;
                            @case(0b001) => .neg;
                            @default => return(self.error(@tfmt("sgnj %", rm)));
                        }
                    }
                };
                if opf != .cmp {
                    rd = rd.as_float(); 
                };
                rs1 = rs1.as_float(); rs2 = rs2.as_float();
                a0, a1 := (self.read(rs1, k), self.read(rs2, k));
                if @is(o, .copy, .neg, .sqrt) {
                    a1 = Qbe.Null;
                };
                @dis(self, "%= %.% % %", rd, o, k, rs1, rs2);
                if opf == .cmp {
                    k = .Kl;
                };
                dest := self.write(rd, k);
                push(b, o, k, dest, a0, a1);
            };
        }
        fn store() => {  // S
            imm := imm_S;
            size := I(13, 12, 0).zext();
            size_bytes := 1.shift_left(size)*8;
            @dis(self, "[%%%]= str.% %", rs1, @if(imm < 0, "", "+"), imm, size_bytes, rs2);
        
            sizes := @const_slice(Qbe.O.storeb, .storeh, .storew, .storel);
            o := sizes[size];
            value, addr := (self.read(rs2), self.read(rs1));
            addr := self.inc(addr, imm);
            push(b, o, .Kw, Qbe.Null, value, addr);
        }
        fn load() => {  // I
            imm := imm12;
            zero_extend := I(14, 14, 0) == 1;
            size := I(13, 12, 0).zext();
            size_bytes := 1.shift_left(size)*8;
            @dis(self, "%= ldr.%% [%%%]", rd, @if(zero_extend, "u", "i"), size_bytes, rs1, @if(imm < 0, "", "+"), imm);
            addr, dest := (self.read(rs1), self.write(rd));
            
            sizes := @const_slice(Qbe.O.loadsb, .loadsh, .loadsw, .load, .loadub, .loaduh, .loaduw, .load);
            o := sizes[size + 4*int(zero_extend)];
            addr := self.inc(addr, imm);
            push(b, o, .Kl, dest, addr, Qbe.Null);
        }
        fn op_imm() => {  // I
            imm := imm12;
            funct3 := @as(OpI) @as(i64) I(14, 12, 0).zext();
            a0, dest := (self.read(rs1), self.write(rd));
            // TODO: rot are in high bits of imm
            if funct3 == .sll && imm >= 64 {  // 0b001
                o: Qbe.O = @switch(imm) {
                    @case(0b011000000001) => .ctz;
                    @case(0b011000000000) => .clz;
                    @case(0b011000000010) => .ones;
                    @case(0b011000000100) => .extsb;
                    @case(0b011000000101) => .extsh;
                    @default => return(self.error(@tfmt("unary op_imm 0b001 %", imm)));
                };
                @dis(self, "%= % %", rd, o, rs1);
                if opcode_class == .Kw && !@is(o, .extsb, .extsh) {
                    // ugh, i use the cls for both input and output size
                    t := self.f.newtmp("w", .Kw);
                    push(b, o, .Kw, t, a0, Qbe.Null);
                    push(b, .extsw, .Kl, dest, t, Qbe.Null);
                } else {
                    push(b, o, .Kl, dest, a0, Qbe.Null);
                };
                return Qbe.Null;
            };
            o := funct3_to_op(funct3);
            if funct3 == .srl && imm >= 64 {  // 0b101
                imm_hi := imm.shift_right_logical(6);
                if imm_hi == 0b10000 {
                    imm = imm.bit_and(1.shift_left(6 - int(opcode_class == .Kw))-1);
                    o = .sar;
                } else {
                    if imm == 0b011010111000 {
                        o := Qbe.O.byteswap;
                        @dis(self, "%= % %", rd, o, rs1);
                        push(b, o, .Kl, dest, a0, Qbe.Null);
                        return Qbe.Null;
                    };
                    return(self.error(@tfmt("unary op_imm 0b101 %", imm)));
                };
            };
            
            @dis(self, "%= %% %, %", rd, o, @if(opcode_class == .Kl, "", ".w"), rs1, imm);
            a1 := self.f.getcon(imm);
            if opcode_class == .Kl {
                push(b, o, .Kl, dest, a0, a1);
            } else {
                t := self.f.newtmp("w", .Kw);
                push(b, o, .Kw, t, a0, a1);
                push(b, .extsw, .Kl, dest, t, Qbe.Null);
            };
        }
        fn op() => {  // R
            funct3 := @as(OpI) @as(i64) I(14, 12, 0).zext();
            funct7 := I(31, 25, 0);
            a0, a1, dest := (self.read(rs1), self.read(rs2), self.write(rd));
            already_dis := false;
            o: Qbe.O = @switch(funct7) {
                @case(0) => funct3_to_op(funct3);
                @case(1) => {
                    @switch(@as(i64) funct3) {
                        @case(0b000) => .mul;
                        @case(0b100) => .div;
                        @case(0b101) => .udiv;
                        @case(0b110) => .rem;
                        @case(0b111) => .urem;
                        @default => return(self.error(@tfmt("op % %", @as(i64) funct3, funct7)));
                    }
                }
                @case(0b0100000) => {
                    @match(funct3) {
                        fn add() => .sub;
                        fn or() => {  // orn
                            @if(opcode_class != .Kl) return(self.error(@tfmt("opw % %", @as(i64) funct3, funct7)));
                            t := self.f.newtmp("r", .Kl);
                            push(b, .xor, .Kl, t, a1, self.f.getcon(-1));
                            a1 = t;
                            already_dis = true;
                            @dis(self, "%= orn %, %", rd, rs1, rs2);
                            .or
                        }
                        fn srl() => .sar;
                        @default => return(self.error(@tfmt("op % %", @as(i64) funct3, funct7)));
                    }
                };
                @case(0b0000111) => {
                    @if(opcode_class != .Kl) return(self.error(@tfmt("opw % %", @as(i64) funct3, funct7)));
                    o: Qbe.O = @switch(@as(i64) funct3) {
                        @case(0b101) => .ceql;
                        @case(0b111) => .cnel;
                        @default => return(self.error(@tfmt("op % %", @as(i64) funct3, funct7)));
                    };
                    
                    @dis(self, "%= % % 0?0: %", rd, o, rs2, rs1);
                    inspect, value := (a1, a0);
                    cond := self.f.newtmp("r", .Kw);
                    push(b, o, .Kw, cond, inspect, Qbe.ConZero);
                    push(b, .sel0, .Kw, Qbe.Null, cond, Qbe.Null);
                    push(b, .sel1, .Kl, dest, Qbe.ConZero, value);
                    return Qbe.Null;
                }
                @case(0b0000100) => {
                    @if(opcode_class != .Kw) return(self.error(@tfmt("op % %", @as(i64) funct3, funct7)));
                    o: Qbe.O = @switch(@as(i64) funct3) {
                        @case(0b000) => .extuw;
                        @case(0b100) => .extuh;
                        @default => @panic("TODO: op % %", @as(i64) funct3, funct7);
                    };
                    t := self.f.newtmp("w", .Kl);
                    push(b, o, .Kl, t, a0, Qbe.Null);
                    push(b, .add, .Kl, dest, a1, t);
                    @dis(self, "%= % %, %", rd, o, rs1, rs2);
                    return Qbe.Null;
                };
                @case(48) => @match(funct3) {
                    fn sll() => .rotl;
                    fn srl() => .rotr;
                    @default => return(self.error(@tfmt("op % %", @as(i64) funct3, funct7)));
                };
                @default => return(self.error(@tfmt("op % %", @as(i64) funct3, funct7)));
            };
            @if(!already_dis) @dis(self, "%= %% %, %", rd, o, @if(opcode_class == .Kl, "", ".w"), rs1, rs2);
            if opcode_class == .Kl {
                push(b, o, .Kl, dest, a0, a1);
            } else {
                t := self.f.newtmp("w", .Kw);
                push(b, o, .Kw, t, a0, a1);
                push(b, .extsw, .Kl, dest, t, Qbe.Null);
            };
        }
        fn op32() => { decode_instruction(self, @ref op.bit_xor(0b1000), .Kw); }   // op
        fn opw() => { decode_instruction(self, @ref op.bit_xor(0b1000), .Kw); }    // op_imm
        fn auipc() => {  // U
            imm, dest := (imm20, self.write(rd));
            push(b, .add, .Kl, dest, self.pc, self.f.getcon(pc_offset + imm));
            @dis(self, "%= auipc %", rd, imm);
        }
        fn lui() => {  // U
            imm, dest := (imm20, self.write(rd));
            @dis(self, "%= lui %", rd, imm);
            push(b, .copy, .Kl, dest, self.f.getcon(imm), Qbe.Null);
        }
        fn jalr() => {  // I
            imm := imm12;
            new_pc, link := (self.read(rs1), self.write(rd));
            @dis(self, "%= jalr % %%", rd, rs1, @if(imm < 0, "", "+"), imm);
            // TODO: clear low bit?
            new_pc := self.inc(new_pc, imm);
            
            // not inc() because of new_pc=link,off=0
            new_pc_out := self.f.newtmp("new_pc", .Kl);
            push(b, .add, .Kl, new_pc_out, new_pc, self.f.getcon(imm));
            
            push(b, .add, .Kl, link, self.pc, self.f.getcon(pc_offset + 4));
            if rd != .Zero {
                self.direct_jump_targets&[0] = (Some = pc_offset + 4);
            };
            return new_pc_out;
        }
        // bcmp,jal: imm always even, no low bit
        fn bcmp() => {
            funct3 := @as(Bcmp) @as(i64) I(14, 12, 0).zext();
            imm := I(31, 31, 12)
                .bit_or(I(30, 25, 5))
                .bit_or(I(11, 8, 1))
                .bit_or(I(7, 7, 11))
                .zext().sign_extend(12);
            a0, a1 := (self.read(rs1), self.read(rs2));
            slow_check_enum(Bcmp, funct3) || return(self.error("bcmp"));
            o: Qbe.O = @match(funct3) {
                fn beq() => .ceql;
                fn bne() => .cnel;
                @default => return(self.error("bcmp"));
            };
            @dis(self, "b.% %, %, pc%%", o, rs1, rs2, @if(imm < 0, "", "+"), imm);
            cond, new_pc := (self.f.newtmp("cond", .Kw), self.f.newtmp("new_pc", .Kl));
            fallthrough_pc := self.inc(self.pc, pc_offset + 4);
            jump_pc := self.inc(self.pc, pc_offset + imm);
            push(b, o, .Kw, cond, a0, a1);
            push(b, .sel0, .Kw, Qbe.Null, cond, Qbe.Null);
            push(b, .sel1, .Kl, new_pc, jump_pc, fallthrough_pc);
            
            self.direct_jump_targets = ((Some = pc_offset + imm), (Some = pc_offset + 4));
            self.bcmp_condition = (Some = cond);
            if self.f.globals.goal.arch != .wasm32 { // supports unsafe_tail_call
                self.terminator = .Direct;
            };
            return new_pc;
        }
        fn jal() => {
            imm := I(31, 31, 20)
                .bit_or(I(30, 21, 1))
                .bit_or(I(20, 20, 11))
                .bit_or(I(19, 12, 12))
                .zext().sign_extend(20);
            
            push(b, .add, .Kl, self.write(rd), self.pc, self.f.getcon(pc_offset + 4));
            @dis(self, "%= jal pc%%", rd, @if(imm < 0, "", "+"), imm);
            
            self.direct_jump_targets&[0] = (Some = pc_offset + imm);
            if rd != .Zero {
                self.direct_jump_targets&[1] = (Some = pc_offset + 4);
            };
            if rd == .Zero || self.f.globals.goal.arch != .wasm32 { // supports unsafe_tail_call
                self.terminator = .Direct;
            };
            return self.inc(self.pc, pc_offset + imm);
        }
        fn system() => @switch(op) {
            @case(ecall) => {
                @dis(self, "ecall");
                self.terminator = .Syscall;
                new_pc := self.inc(self.pc, pc_offset + 4);
                self.direct_jump_targets&[0] = (Some = pc_offset + 4);  // TODO: wrong for exit()/exit_group()
                return new_pc;
            };
            @case(ebreak) => {
                @dis(self, "ebreak");
                self.terminator = .Halt;
                return Qbe.ConZero;
            };
            @default => return(self.error("system"));
        };
        fn amo() => {
            funct7 := I(31, 25, 0);
            funct3 := I(14, 12, 0);
            @if(funct7 != 0b0010111 || funct3.bit_and(0b110) != 0b010) return(self.error("amo"));
            k := @if(funct3.bit_and(1) == 1, Qbe.Cls.Kl, .Kw);
            
            @dis(self, "%= amocas.%.aqrl % %", rd, k, rs1, rs2);
            p, new, old, dest := (self.read(rs1), self.read(rs2), self.read(rd), self.write(rd));
            t := @if(k == .Kl, dest, self.f.newtmp("w", .Kw));
            push(b, .cas0, .Kw, Qbe.Null, p, Qbe.Null);
            push(b, .cas1, k, t, old, new);
            if k == .Kw {
                push(b, .extsw, .Kl, dest, t, Qbe.Null);
            };
        }
        fn misc_mem() => {
            fence := @bits(0b0000, 0b11111111, 0b00000, 0b000, 0b00000, 0b0001111);
            @if(op != fence) return(self.error("misc_mem"));
            @dis(self, "fence");
            callee := self.f.getcon(int_from_rawptr(import("@/lib/sys/sync/atomics.fr").fence_impl));
            push(b, .call, .Kw, Qbe.Null, callee, Qbe.Null);
        }
    };
    Qbe.Null
}

funct3_to_op :: fn(funct3: OpI) Qbe.O = @match(funct3) {
    fn add() => .add;
    fn sltu() => .cultl;
    fn xor() => .xor;
    fn sll() => .shl;
    fn or() => .or;
    fn slt() => .csltl;
    fn srl() => .shr;
    fn and() => .and;
};

fn inc(self: *Compile, r: Qbe.Ref, off: i64) Qbe.Ref = {
    @if(off == 0) return(r);
    out := self.f.newtmp("inc", .Kl);
    push(self.b, .add, .Kl, out, r, self.f.getcon(off));
    out
}

as_float :: fn(r: RvReg) RvReg = @as(RvReg) @as(u8) (32 + @as(u8) r);

// calling self.read before self.write matters because if first reference to a reg in a function is write is never needs to load the old value
fn read(self: *Compile, r: RvReg) Qbe.Ref = self.read(r, false, .Kl);
fn read(self: *Compile, r: RvReg, k: Qbe.Cls) Qbe.Ref = self.read(r, false, k);
fn read(self: *Compile, r: RvReg, fake: bool, k: Qbe.Cls) Qbe.Ref = {   
    ::?Qbe.Ref;
    if k == .Kw {
        k = .Kl;
    };
    if k.is_float() && 32 > zext(@as(u8) r) {
        r = r.as_float();
    };
    if k.is_float() && self.register_read&.get(r).is_some() && (k == .Ks) != self.register_small&.get(r) {
        @debug_assert(!fake);
        // last read/write of the reg in this block was a different size than this instruction needs. 
        address := u32.int_from_ptr(self.entry) - self.emu.debug_base_address;
        @panic("TODO: reinterpret float size % new=% entry=%", r, k, fmt_hex(address));
    };
    @if(k == .Kd) self.register_small&.unset(r);
    @if(k == .Ks) self.register_small&.set(r);
    
    self.register_read&.get(r) || {
        dest := self.f.newtmp(r.name_str(), k);
        self.register_read&.insert(r, dest);
        if !fake { 
            addr := self.compute_reg_addr(r);
            push(self.b, .load, k, dest, addr, Qbe.Null);
        };
        dest
    }
}

fn write(self: *Compile, r: RvReg) Qbe.Ref = self.write(r, .Kl);
fn write(self: *Compile, r: RvReg, k: Qbe.Cls) Qbe.Ref = {
    if k == .Kw {
        k = .Kl;
    };
    if k.is_float() && 32 > zext(@as(u8) r) {
        r = r.as_float();
    };
    
    self.register_read&.remove(r);  // ssa
    
    @if(k == .Ks) self.register_small&.set(r);
    @if(k == .Kd) self.register_small&.unset(r);

    // writing to zero is common. ex. don't need seperate instruction for jump without link
    @if(r == .Zero) return(self.f.newtmp("discard", .Kl));
    
    self.register_write&.set(r);
    self.read(r, true, k)
}

fn compute_reg_addr(self: *Compile, r: RvReg) Qbe.Ref = {
    off := offset_of(Cpu, .reg) + 8*(@as(u8) r).zext();
    addr := self.f.newtmp("r_addr", .Kl);
    push(self.b, .add, .Kl, addr, self.cpu_addr, self.f.getcon(off));
    addr
}

fn error(self: *Compile, msg: Str) Qbe.Ref = {
    self.error = msg;
    self.terminator = .Error;
    Qbe.ConZero
}

#use("@/backend/rv64/bits.fr");
dis :: fn(e: FatExpr) FatExpr #macro = {
    e := e&.items();
    @{
        self := @[e[0]];
        if self.emu.disassemble {
            @[format_into(@{ self.out }, e.rest(1), e[0].loc)];
            self.out.push_all("\n");
        }
    }
}

// TODO: have a less annoying way to do incomplete enums (@match will panic on invalid values)
slow_check_enum :: fn($E: Type, it: E) bool #generic = {  
    for_enum E { check |
        @if(it == check) return(true);
    };
    false
};

#use("@/examples/emu/runtime.fr");
