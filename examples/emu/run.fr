// input is a riscv64 linux static-pie executable. 
// THIS IS NOT A SANDBOX
// syscalls are translated to host syscalls and memory accesses are not bounds checked. 
// (WIP) limitations: 
// - syscalls only work on arm where translation is trivial because they use the same numbers as riscv
// - only a subset of instructions are implemented
// - no jit or threads or exec

main :: fn() void = {
    #use("@/lib/args.fr");
    args := parse_args(LogArgs);

    input := read_file_from_last_arg();
    h := input.peek_type(Elf.Header);
    @assert_eq(h.magic, Elf.MAGIC, "invalid magic. expected an elf program");
    @assert_eq(h.machine, .rv64);
    
    // TODO: for macos deal with "not divisible by page size"
    // TODO: don't actually map the code as executable
    // TODO: wasteful to actually map the code at all but technically you might read it as data
    // TODO: don't allow imports
    entry, stack, base_address := load_elf_segments2(input, true, false);
    sp := write_argc_argv_envp(stack, (
        args = @slice(@as(CStr) "a.out"),  // TODO: pass the rest of args
        env = empty(),  // TODO: inherit
    ));
    
    ::import("@/backend/lib.fr").Qbe.QbeModule;  // :compilerbug/ordering
    emu := zeroed(Emulator);
    init(emu&, general_allocator(), args);
    emu.debug_base_address = base_address;
    cpu := emu.threads&.push(zeroed(Cpu));
    cpu.reg&.insert(.SP, bit_cast_unchecked(*CStr, rawptr, sp));
    run(emu&, cpu, u8.int_from_ptr(entry));
};

#use("@/lib/sys/fs.fr");
#use("@/lib/sys/process.fr");
#use("@/examples/elf_loader.fr");
#use("@/examples/emu/runtime.fr");
