// input is a riscv64 linux static-pie executable. 
// THIS IS NOT A SANDBOX
// syscalls are translated to host syscalls and memory accesses are not bounds checked. 
// some syscalls need special treatment: riscv_flush_icache, clone, execve, uname
// (WIP) limitations: 
// - syscalls only work on arm where translation is trivial because they use the same numbers as riscv
// - only a subset of instructions are implemented
// - /proc will be misleading, i hack around readlinkat(/proc/self/exe) because my code does that.

main :: fn() void = {
    #use("@/lib/args.fr");
    args := parse_args(LogArgs);
    // TODO: as usual, so annoying that you don't inherit the symbol names from the compiler. 
    //       even if jit and would inherit for the franca code, it has a different RESOLVERS so push won't work. 
    if args.trace_fault {
        Crash'hook_backtrace();
    };
    
    path := (args.extra.find(fn(it) => !it[].ends_with(".fr"))  // hack for when running jitted
        || @panic("cli arg is path to elf file"))[];
    input := read_entire_file_or_crash(temp(), path);
    h := input.peek_type(Elf.Header);
    @assert_eq(h.magic, Elf.MAGIC, "invalid magic. expected an elf program");
    @assert_eq(h.machine, .rv64);
    
    // TODO: for macos deal with "not divisible by page size"
    //       since marking executable doesn't matter its not a big deal
    // TODO: don't actually map the code as executable
    // TODO: wasteful to actually map the code at all but technically you might read it as data
    // TODO: don't allow imports
    entry, stack, base_address := load_elf_segments2(input, true, false);
    a := {
        a := CStr.list(temp());
        @if(!args.no_arv0) a&.push(path.as_cstr());
        a&.push_all(args.child_args.rest(args.env_count));
        a.items()
    };
    sp := write_argc_argv_envp(stack, (
        args = a,
        // TODO: flag to inherit instead
        env = args.child_args.slice(0, args.env_count),
    ));
    
    ::import("@/backend/lib.fr").Qbe.QbeModule;  // :compilerbug/ordering
    emu := zeroed(Emulator);
    init(emu&, general_allocator(), args);
    emu.self_exe_path = path;
    emu.initial_elf = input;
    emu.debug_base_address = base_address;
    cpu := push(emu.threads&, (emu=emu&));
    cpu.reg&.insert(.SP, bit_cast_unchecked(*CStr, rawptr, sp));
    cpu.reg&.insert(.RA, rawptr_from_int(-1));  // :TestMarkerBreakLoop
    hook := Crash'push_resolver(Emulator, emu&, find_emulated_symbol);
    run(emu&, cpu, u8.int_from_ptr(entry));
    pop_resolver(hook);
    // for the ssa tests that don't call exit
    @assert_eq(cpu.reg&.get(.A0).int_from_rawptr(), 0, "returned non-zero");
};

#use("@/lib/sys/fs.fr");
#use("@/lib/sys/process.fr");
#use("@/examples/elf_loader.fr");
#use("@/examples/emu/runtime.fr");
