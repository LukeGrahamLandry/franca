write_save :: fn(circuits: []Tc.Circuit, files: []Tc.LoadedFile, i: ?i64, out: *List(u8), spec: bool) void = {
    out.reserve(1.shift_left(21));
    #use("@/lib/collections/bit_set.fr");
    kinds_used: DynamicBitSet = empty(temp());
    
    needed: DynamicBitSet = empty(temp());
    need_files: DynamicBitSet = empty(temp());
    if i { i |
        work := Tc.CustomId.list(temp());
        work&.push(circuits[i].id);
        while => work&.pop() { id |
            i := circuits.index_of(fn(it) => it.id.id == id.id).unwrap();
            if !needed&.get_set(i) {
                for circuits[i].dependencies { id |
                    work&.push(id);
                };
            };
        };
    };
    
    max_size_chars := 10;
    enumerate circuits { circ_i, c |
        continue :: local_return;
        if i.is_some() && !needed&.get(circ_i) {
            continue();
        };
        with_patched_size("CIRCUIT") {
        @fmt(out, " H ");
        if c.compiled { it |
            @fmt(out, "% ", it.id);
        } else {
            @fmt(out, "-1 ");
        };
        @fmt(out, "% % % % % ", c.id.id, c.gates.len, c.wires.len, c.dependencies.len, c.programs.len);
        @fmt(out, "%,% %,% % % ", c.min.x, c.min.y, c.max.x, c.max.y, c.default_tick_rate, c.is_arch.int());
        write_bytes(out, c.name);
        @fmt(out, "\n");
        if c.dependencies.len > 0 {
            @fmt(out, " D ");
            for c.dependencies { it |
                @fmt(out, "% ", it.id);
            };
            @fmt(out, "\n");
        }
        
        each(c.gates, write_gate);
        write_gate :: fn(it: *Tc.Circuit.Gate) void => {
            // TODO: shouldn't be true anymore
            //       but need to think about how im going to serialize UndoEntry if i dont keep the indices consistant
            // cant filter because programs are stored by index
            //continue :: local_return;
            //@if(it.kind.is_placeholder()) continue();
            kinds_used&.set(it.kind.id.zext());
            
            @fmt(out, " G % %,%,% ", it.kind.id, it.pos.x, it.pos.y, it.rotation);
            shape := get_builtin_shape(it.kind);
            
            if group(it.kind) == .Tc1 && !shape.has_param {
                @fmt(out, "0 ");
            } else {
                @fmt(out, "%", it.settings.len);
                for it.settings { value |
                    @fmt(out, ",%", value);
                };
                @fmt(out, " ");
            };
            
            if group(it.kind) == .Loaded || shape.body == .Custom {
                p := it.mystery_spice_minus_fifteen_for_custom_pins;
                @fmt(out, "%,%,% ", it.custom_id.id, p.x, p.y);
            };
            
            if shape.has_param {
                s := it.settings&;
                if s[0].ult(files.len) && group(it.kind) == .Tc1 && @is(Tc'gate_name(it.kind, .Tc1), .FileLoader, .SpriteDisplay) {
                    need_files&.set(s[0]);
                };
            };
            if is_linkable(it.kind) {
                @fmt(out, "id% ", it.link_id);
                if it.watched.len > 0 {
                    @fmt(out, "link% ", it.watched.len);
                    each it.watched { it |
                        @fmt(out, "%,%,%,%,", it.id, it.inner_id, it.offset, it.word_size);
                        write_bytes(out, it.name);
                    };
                };
            };
            
            @if(it.data.len > 0) { @fmt(out, "D"); write_bytes(out, it.data.items()); };
            @if(it.label.len > 0) { @fmt(out, "L"); write_bytes(out, it.label.items()); };
            
            @fmt(out, "\n");
        };
        
        each(c.wires, write_wire);
        write_wire :: fn(it: *Tc.Circuit.Wire) void => {
            continue :: local_return;
            @if(it.path.len < 2) continue();
            
            @fmt(out, " W % ", it.path.len);
            each it.path { it |
                @fmt(out, "%,% ", it.pos.x, it.pos.y);
            };
            @if(it.teleport) @fmt(out, "t");
            @if(it.colour != 0) @fmt(out, "c%", it.colour);
            @fmt(out, "\n");
        };
        if c.mnemonics != "" {
            @fmt(out, " M ");
            write_bytes(out, c.mnemonics);
            @fmt(out, "\n");
        };
        each c.programs { it |
            // TODO: once editor breaks these, need to do this sooner (before compile).
            //       tho i might want to always autosave before compiling anyway because thats a common source of assertion failures
            if it.gate_index >= c.gates.len || c.gates[it.gate_index].link_id != it.gate_link_id {
                if c.gates.index_of(fn(g) => g.link_id == it.gate_link_id) { i |
                    it.gate_index = i;
                };
            };
        
            @fmt(out, " P % ", it.gate_index);
            key := @if(it.level_name == "", @tfmt("%", it.level_id), it.level_name);
            write_bytes(out, key);
            write_bytes(out, it.name);
            write_bytes(out, it.assembly || "");
            @fmt(out, "\n");
        };
        
        if c.undo.len > 0 {
            @fmt(out, " undo % ", undo_format_version);
            size_patch_offset := out.len;
            out.push_repeated(max_size_chars, " ".ascii());
            @fmt(out, " % %;\n", c.undo.len, c.redo.len);
            start_counting_size := out.len;
            it := @slice(c.undo, c.redo);
            for it { it |
                each it { it |
                    @fmt(out, " U % ", it.tag().raw());
                    @match(it) {
                        fn SetGateField(it) => { @fmt(out, "% % ", it.i, it.field); write_bytes(out, it.value); }
                        fn SetGatePosition(it) => @fmt(out, "% % % %", it.i, it.pos.x, it.pos.y, it.rotation);
                        fn UndeleteGate(it) => { @fmt(out, "%", it.i); write_gate(it.gate&); }
                        fn UndeleteWire(it) => { @fmt(out, "%", it.i); write_wire(it.wire&); }
                        fn DeleteGate(it) => @fmt(out, "%", it.i);
                        fn DeleteWire(it) => @fmt(out, "%", it.i);
                    };
                    @fmt(out, "\n");
                };
            };
            dest := out.items().subslice(size_patch_offset, max_size_chars);
            write_int_to_buffer(dest, out.len - start_counting_size - 1);
        };
        };
    };
    
    // TODO: deduplicate when loading, can't do it now becuase they're referenced by index in FileLoader/SpriteDisplay settings
    // TODO: by index also means can't load if concatenate multiple of these together because need to remap
    @if(need_files&.count_ones() != 0)
    with_patched_size("FILES") {
        enumerate files { i, it |
            if need_files&.get(i) {
                @fmt(out, " F ");
                write_bytes(out, it.name);
                write_bytes(out, it.data);
                @fmt(out, "\n");
            } else {
                @fmt(out, " F #0\"\" #0\"\" \n");
            }
        };
    };
    
    // not needed but i like the idea of the file containing enough info to recreate the graph even if you dont have my code anymore
    @if(spec)
    with_patched_size("BUILTIN") {
    it := @slice(Tc.Builtin.templates, Tc.Builtin.templates2);
    each it { it |
        each it { it |
            if kinds_used&.get(it.kind.id.zext()) {
                @fmt(out, " B % % % ", it.kind.id, it.name, it.out_arity);
                each it.pins { it |
                    @fmt(out, "%,% ", it._0, it._1);
                };
                @fmt(out, " \n");
            };
        };
    };
    // TODO: include names for UndoEntry and EditField?
    out.push_all(HELP);
    };
    
    with_patched_size :: fn(tag: Str, $body: @Fn() void) void => {
        @fmt(out, "% v1 ", tag);
        size_patch_offset := out.len;
        out.push_repeated(max_size_chars, " ".ascii());
        @fmt(out, "{\n");
        body();
        @fmt(out, "}\n");
        dest := out.items().subslice(size_patch_offset, max_size_chars);
        write_int_to_buffer(dest, out.len - size_patch_offset -1-max_size_chars);
    };
    
    write_bytes :: fn(out: *List(u8), data: []u8) void = {
        @fmt(out, "#%\"", data.len);
        out.push_all(data);
        @fmt(out, "\" ");
    };

HELP :: """
 C https://franca.lukegrahamlandry.ca
 C H kind id ngates nwires ndeps nprograms min max tickrate isarch name
 C D []depid
 C G kind pos,rotation (id pinoffset) [](settings) id(linkid) link(n [](id,in,off,size,name)) D(data) L(label)
 C W count []pos t() c(colour)
 C M mnemonics
 C P gateindex levelid name assembly
 C F name data
 C B kind name nout []pin
""".rest(1);
}

// returns strings still pointing at `in`
read_save :: fn(in: Str, a: Alloc) Result(Ty([]Tc.Circuit, []Tc.LoadedFile), Str) = {
    while => in.len > 0 && in[0].is_ascii_whitespace() {
        in = in.rest(1);
    };
    circuits := @ref Tc.Circuit.list(a);
    files := @ref Tc.LoadedFile.list(a);
    
    while => in.len > 0 {
        tag, contents := with_patched_size();
        left_over := in;
        in = contents;
        @switch(tag) {
            @case("CIRCUIT") => load_circuit();
            @case("FILES") => {
                while => pop_prefix(in&, "F ") {
                    push(files, (name = get_str(), data = get_str()));
                };
            };
            @case("BUILTIN") => { in = ""; };
            @default => return(Err = "unknown chunk type");
        };
        @if(in != "") return(Err = "junk on the end");
        in = left_over;
    };
    return(Ok = (circuits.items(), files.items()));
    
    load_circuit :: fn() => {
        pop_prefix(in&, "H ") || return(Err = "missing header");
        compiled_id, circuit_id, gates_len, wires_len, dep_count, program_count := (get_int(), get_int(), get_int(), get_int(), get_int(), get_int());
        min_x, min_y, max_x, max_y, tick_rate, is_arch := (get_int(), get_int(), get_int(), get_int(), get_int(), get_int() == 1);
        name := get_str();
        
        gates := list(Tc.Circuit.Gate, gates_len, a);
        wires := list(Tc.Circuit.Wire, wires_len, a);
        dependencies := list(Tc.CustomId, dep_count, a);
        programs := list(Tc.Circuit.Program, program_count, a);
        undo := @ref list(Tc.Circuit.UndoEntry, a);
        redo := @ref list(Tc.Circuit.UndoEntry, a);
        
        if pop_prefix(in&, "D ") {
            range(0, dep_count) { i |
                dependencies&.push(id = get_int());
            };
        };
        
        while => pop_prefix(in&, "G ") {
            gates&.push(read_gate());
        };
        read_gate :: fn() => {
            kind_id, pos_x, pos_y, rot := (get_int(), get_int(), get_int(), get_int());
            
            gate: Tc.Circuit.Gate = (
                rotation = rot.trunc(),
                custom_id = zeroed(Tc.CustomId),
                kind = (id = kind_id.trunc()),
                pos = vec2(pos_x.float().cast(), pos_y.float().cast()),
                mystery_spice_minus_fifteen_for_custom_pins = vec2(0), 
                link_id = -1,
            );
            
            // TODO: don't crash if its a low number
            shape := get_builtin_shape(id = kind_id.trunc());
            
            n := get_int();
            @if(!n.ult(100)) return(Err = "bad settings len");
            gate.settings = a.alloc_zeroed(i64, n);
            range(0, n) { i |
                gate.settings[i] = get_int();
            };
            
            if group(shape.kind) == .Loaded || shape.body == .Custom {
                gate.custom_id = (id = get_int());
                tc_junk_x, tc_junk_y := (get_int(), get_int());
                gate.mystery_spice_minus_fifteen_for_custom_pins = vec2(tc_junk_x.float().cast(), tc_junk_y.float().cast());
            };
            
            if in&.pop_prefix("id") {
                gate.link_id = get_int();
                if in&.pop_prefix("link") {
                    n := get_int();
                    gate.watched = a.alloc_zeroed(Tc.Circuit.Watched, n);
                    range(0, n) { i |
                        gate.watched[i] = (id=get_int(), inner_id=get_int(), offset=get_int(), word_size=get_int(), name=get_str());
                    };
                };
            };
            if in&.pop_prefix("D") {
                gate.data = get_str().as_raw_list();
            };
            if in&.pop_prefix("L") {
                gate.label = get_str().as_raw_list();
            };
            gate
        };
        
        
        while => pop_prefix(in&, "W ") {
            wires&.push(read_wire());
        };
        read_wire :: fn(it) Tc.Circuit.Wire => {
            n := get_int();
            path := @ref Tc.Circuit.WireNode.list(n, a);
            range(0, n) { _ |
                x, y := (get_int(), get_int());
                path.push(pos = vec2(x.float().cast(), y.float().cast()));
            };
            t := pop_prefix(in&, "t");
            c: u8 = 0;
            if pop_prefix(in&, "c") {
                c = get_int().trunc();
            };
            while => in.len > 0 && in[0].is_ascii_whitespace() {
                in = in.rest(1);
            };
            (path = path.as_raw(), teleport=t, colour=c)
        };
        
        mnemonics := @if(pop_prefix(in&, "M "), get_str(), "");
        while => pop_prefix(in&, "P ") {
            gate, key, name, assembly := (get_int(), get_str(), get_str(), get_str());
            level := {
                v, r := convert_number(key, 10, dec_digit);
                @if(r.len == 0, v, -1)
            };
            programs&.push(level_id = level, level_name = key, name = name, gate_index = gate, assembly = @if(assembly.len == 0, .None, (Some = assembly)));
            @if(gate.uge(gates.len)) return(Err = "program gate index oob");
            programs[programs.len - 1].gate_link_id = gates[gate].link_id;
        };
        
        while => in.len > 0 && in[0].is_ascii_whitespace() {
            in = in.rest(1);
        };
        if in&.pop_prefix("undo ") {
            break :: local_return;
            // versioned seperately cause i expect the format for this will be more volatile and i dont care about it as much
            version, bytes := (get_int(), get_int()); 
            if version != undo_format_version {
                // TODO: if couldn't load properly, back up the file before stomping on it if re-save
                while => !in&.pop_prefix(";\n") {
                    in = in.rest(1);
                };
                in = in.rest(bytes);
                while => in.len > 0 && in[0].is_ascii_whitespace() {
                    in = in.rest(1);
                };
                break();
            };
            u_count, r_count := (get_int(), get_int());
            in&.pop_prefix(";\n") || return(Err = "missing ; before undo data");
            while => in.len > 0 && in[0].is_ascii_whitespace() {
                in = in.rest(1);
            };
            undo.reserve(u_count);
            redo.reserve(r_count);
            dest := undo;
            n := 0;
            while => pop_prefix(in&, "U ") {
                tag_ordinal := get_int();
                @if(tag_ordinal.uge(enum_count(Tag(Tc.Circuit.UndoEntry)))) return(Err = "bad undo tag");
                u := zeroed(Tc.Circuit.UndoEntry);
                u&.tag_ptr()[] = @as(Tag(Tc.Circuit.UndoEntry)) tag_ordinal;
                i := get_int();
                @match(u&) {
                    fn SetGateField(it) => { it[] = (i = i, field = get_int(), value = get_str()); }
                    fn SetGatePosition(it) => { it[] = (i = i, pos = vec2(get_int().float().cast(), get_int().float().cast()), rotation = get_int().trunc()); }
                    fn UndeleteGate(it) => { pop_prefix(in&, "G "); it[] = (i = i, gate = read_gate()); }
                    fn UndeleteWire(it) => { pop_prefix(in&, "W "); it[] = (i = i, wire = read_wire()); }
                    fn DeleteGate(it) => { it[] = (i = i); }
                    fn DeleteWire(it) => { it[] = (i = i); }
                };
                dest.push(u);
                n += 1;
                if n == u_count {
                    dest = redo;
                };
            };
        };
        
        circuits.push(
            wires = wires.as_raw(), 
            gates = gates.as_raw(), 
            id = (id = circuit_id),
            min = vec2(min_x.float().cast(), min_y.float().cast()), 
            max = vec2(max_x.float().cast(), max_y.float().cast()),
            dependencies = dependencies.as_raw(),
            name = name,
            programs = programs.items(),
            default_tick_rate = tick_rate,
            v2 = false,
            is_arch = is_arch,
            mnemonics = mnemonics,
            undo = undo.as_raw(),
            redo = redo.as_raw(),
        );
    };
    
    with_patched_size :: fn() Ty(Str, Str) => {
        i := 0;
        while => i < in.len && in[i].is_ascii_alpha() {
            i += 1;
        };
        tag := in.slice(0, i);
        in = in.rest(i);
        pop_prefix(in&, " v1 ") || return(Err = "bad version");
        length := get_int();
        @if(length <= 1 || in.len < length || in[length-1] != "}".ascii()) return(Err = "bad length header");
        new := in.slice(0, length-1);
        new&.pop_prefix("{\n ");
        in = in.rest(length);
        while => in.len > 0 && in[0].is_ascii_whitespace() {
            in = in.rest(1);
        };
        (tag, new)
    };
    get_int :: fn() => {
        negative := in.starts_with("-");
        in = in.rest(int(negative));
        value, remaining := convert_number(in, 10, dec_digit);
        @if(remaining.len == in.len) return(Err = "expected integer");
        value *= @if(negative, -1, 1);
        in = remaining;
        while => in.len > 0 && (in[0].is_ascii_whitespace() || in[0] == ",".ascii()) {
            in = in.rest(1);
        };
        
        value
    };
    get_str :: fn() => {
        @if(!in&.pop_prefix("#")) return(Err = "expected string");
        length := get_int();
        @if(in.len < length + 2) return(Err = "bad string length");
        @if(in[0] != "\"".ascii() || in[1+length] != "\"".ascii()) return(Err = "missing string quotes");
        s := in.subslice(1, length);
        in = in.rest(length + 2);
        while => in.len > 0 && in[0].is_ascii_whitespace() {
            in = in.rest(1);
        };
        s
    };
}

undo_format_version :: 1;
#use("@/examples/circuit/eval.fr");
