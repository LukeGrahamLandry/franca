
fn init(world: **World, a: Alloc, save_wire_values: bool, components: []Component) void = {
    ::ptr_utils(World);
    wire_sum, wire_depth, storage_count := {
        ws, wd, s := (0, 0, 0);
        for components { it |
            ws = max(ws, it.wire_sum);
            wd = max(wd, it.wire_depth);
            s = max(s, it.storage_count);
        };
        (ws, wd, s)
    };
    wires := @if(save_wire_values, wire_sum, wire_depth);
    
    buf: RawList(i64) = @if(world[].is_null(), empty(), world.buf);  // note: `world` has to be valid or zeroed. can't be uninit
    N := size_of(World)/8;
    buf&.reserve_total(N+storage_count+wires, a);
    world[] = buf.maybe_uninit().interpret_as_bytes().peek_type(World); 
    world[][] = (
        components = components,
        scratch = buf.maybe_uninit().subslice(N+storage_count, wires).from_capacity(),
        instance = 0,
        storage = buf.maybe_uninit().subslice(N, storage_count),
        doing_pre_read = false,
        save_wire_values = save_wire_values,
        tc_file_loader_device = empty(),
        buf = buf,
    );
}

fn drop(world: **World, a: Alloc) void = {
    @debug_assert(identical(World.raw_from_ptr(world[]), i64.raw_from_ptr(world.buf.ptr)));
    buf := world.buf;
    buf&.drop(a);
    world[] = zeroed(*World);
}

fn storage(world: *World, instance: i64, $T: Type) *T #generic #inline = 
    world.storage_bytes(instance, size_of(T)).peek_type(T);
fn storage_bytes(world: *World, instance: i64, count: i64) []u8 #inline = 
    bit_cast_unchecked(*i64, *u8, bit_cast_unchecked(*World, *i64, world).offset(size_of(World)/8+instance)).slice(count);

WireValue :: i64;

World :: @struct {
    components: []Component;
    scratch: RawList(WireValue);  // 'buf
    // each instance of a delay component needs a unique bit of storage. including when 
    // nested inside other components. so reset this index for each top level eval call 
    // and evaluation it never short circuits, an instance will always get the same slot. 
    instance: i64;
    storage: []WireValue;  // 'buf
    // i evaluate the gates in order but output of a memory can be used before def. 
    // so do a prepass where just read from storage into wire. 
    doing_pre_read: bool;
    // for visualization, don't unscratch so can show values of wires in nested gates. 
    save_wire_values: bool;
    tc_file_loader_device: []Tc.LoadedFile;
    tc_halt_device := -1;  // Tc.Builtin.Settings.Halt (circ/gate into graphical circuit to get data field for message)
    timestamp_ns: ?i64 = .None;
    buf: RawList(i64);
};

fn eval(world: *World, parent: []WireValue, it: *Component.Op) void = {
    c := world[it.kind]&;
    
    if c.compile_order&[0].len == 0 {
        if c.is_switch {
            return eval_switch(world, parent, it);
        };
        eval_compiled(world, parent, it);
        return();
    };
    
    if world.doing_pre_read && c.signeture < 4 {
        eval_compiled(world, parent, it);
        return();
    };
    wires := world.scratch(c.wire_count);
    if c.has_switches {
        wires.set_zeroed();  // switches with none enabled default to zero TODO: could just do it for those specific wires, compile the list like compile_order etc. 
    };
    
    doing_pre_read, instance := (world.doing_pre_read, world.instance);
    ops := c.compile_order&[int(!doing_pre_read)];
    outputs := ops[ops.len-1].wires.slice(ops[ops.len-1].param);
    inputs := ops[0].wires.slice(ops[0].param);
    
    range(0, inputs.len) { i |
        wires[inputs[i].id.zext()] = parent[it.wires.offset(outputs.len + i)[].id.zext()];
    };
    if c.storage_count != 0 {
        each ops.slice(1, ops.len - 1) { op |
            world.instance = instance + op.instance;
            world.doing_pre_read = op.pre_read;
            world.eval(wires, op);
        };
        world.instance = instance + ops[ops.len - 1].instance;
        world.doing_pre_read = doing_pre_read;
    } else {
        enumerate ops.slice(1, ops.len - 1) { i, it |
            world.eval(wires, it);
        };
    };
    
    range(0, outputs.len) { i |
        parent[it.wires.offset(i)[].id.zext()] = wires[outputs[i].id.zext()];
    };
    
    if !world.save_wire_values || doing_pre_read {
        world.unscratch(wires);
    };
}

eval_switch :: fn(world: *World, parent: []WireValue, it: *Component.Op) = {
    in, out := (it.wires.offset(1).slice(2), it.wires.slice(1));
    a, b := (parent[in[0].id.zext()], parent[in[1].id.zext()] != 0);  // value, cond
    if b {
        parent[out[0].id.zext()] = a;
    };
};

fn scratch(world: *World, n: i64) []WireValue #inline = {
    @debug_assert_ule(world.scratch.len + n, world.scratch.cap, "must preallocate wire_depth");
    world.scratch.len += n;
    world.scratch.slice(world.scratch.len - n, world.scratch.len)
}

fn unscratch(world: *World, wires: []WireValue) void #inline = {
    @debug_assert(identical(world.scratch.items().end_pointer(), wires.end_pointer()), "scratch bad nesting");
    world.scratch.len -= wires.len;
}

fn index(world: *World, i: ComponentId) *Component = world.components.index(i.id.zext()); 

fn evaluate(world: *World, values: []WireValue, kind: ComponentId, param: i64, save_wire_values: bool) void = {
    world.instance = 0; 
    world.scratch.len = 0;
    prev := world.save_wire_values;
    @debug_assert(prev || !save_wire_values, "if init(save_wire_values=false), won't have preallocated enough");
    world.save_wire_values = save_wire_values;
    if !save_wire_values && world[kind].signeture < 4 {
        eval_compiled(world, values, kind, param);
    } else {
        eval_top(world, values, kind, param);
    };
    world.save_wire_values = prev;
    world.timestamp_ns = .None;
}

// expose the compiled version with the intepreter's calling convention. 
fn eval_compiled(world: *World, parent: []WireValue, it: *Component.Op) void = {
    a := Arena'stack_alloc(size_of(WireValue) * max_in_out_wires);
    o_n, i_n := world[it.kind].primitive_arity;
    values := a.alloc_zeroed(WireValue, o_n+i_n);
    range(0, i_n) { i |
        values[i + o_n] = parent[it.wires.offset(o_n+i)[].id.zext()];
    };
    eval_compiled(world, values, it.kind, it.param);
    range(0, o_n) { i |
        parent[it.wires.offset(i)[].id.zext()] = values[i];
    };
}

// values is (uninit outputs, inputs)
fn eval_compiled(world: *World, values: []WireValue, kind: ComponentId, param: i64) void = {
    child := world[kind]&;
    o_n, i_n := child.primitive_arity;
    @debug_assert_eq(o_n + i_n, values.len, "arity error calling compiled gate %", child.name);  
    
    // SAFETY: *Array(T, N) has same repr as *T. compile_gates chooses N based on Gate arity. 
                          // TODO: this is stupid. only matters on wasm. should probably just always add a junk param:i64 in the compiler instead. 
                          //       the junk would also fix needing to know for storage without param to shift the arg. 
    compiled := child.fast_eval;
    p := values.ptr.offset(o_n);
    @switch(child.signeture) {
        @case(0) => {
            compiled := bit_cast_unchecked(rawptr, @FnPtr(*World, *WireValue, *WireValue, i64, i64, bool) void, compiled);
            compiled(world, values.ptr, p, param, world.instance, world.doing_pre_read);
        };
        @case(1) => {
            compiled := bit_cast_unchecked(rawptr, @FnPtr(*World, *WireValue, *WireValue, i64) void, compiled);
            compiled(world, values.ptr, p, param);
        };
        @case(2) => {
            compiled := bit_cast_unchecked(rawptr, @FnPtr(*World, *WireValue, *WireValue, i64, bool) void, compiled);
            compiled(world, values.ptr, p, world.instance, world.doing_pre_read);
        };
        @case(3) => {
            compiled := bit_cast_unchecked(rawptr, @FnPtr(*World, *WireValue, *WireValue) void, compiled);
            compiled(world, values.ptr, p);
        };
        @default => unreachable();
    };
}

fn eval_top(world: *World, values: []WireValue, kind: ComponentId, param: i64) []i64 = {
    a := Arena'stack_alloc(size_of(WireId) * max_in_out_wires);
    o_n, i_n := world[kind]&.arity();
    @assert_eq(values.len, o_n + i_n, "arity error calling gate");  
    w := a.alloc_init(WireId, o_n + i_n, fn(i) => (id = i.trunc()));
    it: Component.Op = (
        wires = w.ptr,
        pre_read = false,
        instance = 0,
        kind = kind,
        param = param,
    );
    eval(world, values, it&);
    values.slice(0, o_n)
}

fn get_compiled(world: *World, kind: ComponentId) ?rawptr #inline = {
    f := world[kind].fast_eval;
    if !f.is_null() {
        return(Some = f);
    };
    .None
}

#use("@/lib/collections/map.fr");

get_component_by_name :: fn(name: Str, components: []Component) ComponentId #fold = {
    kind := components.index_of(fn(it) => it.name == name).unwrap();
    (id = kind.trunc())
};

fn find_component(world: *World, name: Str) ?ComponentId = {
    kind := world.components.index_of(fn(it) => it.name == name)
        || return(.None);
    (Some = (id = kind.trunc()))
}

realtime_ns :: fn() i64 = {
    it := zeroed(TimeSpec);
    Posix'clock_gettime(Posix.CLOCK.REALTIME, it&);
    it.seconds*NS_PER_S + it.nanoseconds
}

