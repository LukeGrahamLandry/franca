
fn run_tests(harness: *Harness) void = {
    harness.load("BMP file loader enhanced")
        .run(15_999).then_halt("Done");
    harness.load("QOI Image viewer")
        .run(3_841).then_halt("");
    harness.load("BRAINFUCK PC EXTENDED")
        .run(478).then_halt("")
        .console("Hello, World!");
    harness.load("LEG ARCHITECTURE 5 - console display")
        .run(40_000).console("2\n3\n5\n7\n11");
    harness.load("RISC-V")
        .run(300_000).console("White to play:");
    harness.load("RISC-V CPU")
        .run(10_000).console("Hello World! compiled application!!");
    harness.load("Smol Cave Adventure")
        .run(500).console("Welcome to Smol Cave Adventure!");
    harness.load("HLL-Interpreter")
        .run(10_000).console("Hello, World!");
    harness.load("Tetris")
        .run(10_000_000, true)  // TODO: time depends on clock randomness for what pieces get chosen
        .halted("End of program execution.");
    harness.load("NANDverture").maze(3775);
    harness.load("OVERTURE").maze(3775);
    harness.load("LEG").maze(4140);
    
    /*
    harness.load("TCMIPS")
        .run(_)
        .keyboard_input("hash hello\n")
        .run(_)
        .console_contains(@tfmt("sha256: %", Sha256'hex("hello")));
    */
    
    // these idk a convient test to do but can still run a few ticks to make sure it compiles ok
    visual :: @const_slice(
        "7 Segment Display",
        "Clock", 
        "32b to Dot Matrix", 
        "Snake Game", 
        "ASCII Bad Apple 10fps", 
        "rom image loader v1", 
        "Conways Game Of Life 16x16 Soup", 
        "Matrix Display Playground",
        "line drawer",
        "Mandelbrot",
        "TCMIPS",
        "Timestamp",
        // TODO: image.fr do screen too
        "Conway's Game of Life Symphony",
        "Brainfk编译器",
        "SYM32_BADAPPLE_OPTIMIZAED",
        "8-digit_Calculator",
    );
    for visual { it |
        harness.load(it).run(100);
    };
    
    harness.load("Bad Apple").run(100000);
}

init_harness :: fn(image_callback: ?ImageFn) Harness = {
    test_defs();
    root := Foreign'tc_archive();

    name := "Tetris";
    path := @tfmt("%/v1/schematics/architecture/%/circuit.data", root, name);
    circuits, _, tc_file_loader_device := Tc'load_all_circuits(path, temp(), @ref u8.list(temp()));
    harness := @ref @as(Harness) (
        temp = temp().mark(),
        circuits = circuits,
        world = zeroed(World),
        tc_file_loader_device = tc_file_loader_device,
        msg = list(general_allocator()),
        image_callback = image_callback || (f = fn(_0, _1) = (), userdata = zeroed(rawptr)),
    );
    reset_jit(harness.fr&);
    harness[]
}

fn assert_ok(harness: *Harness) void = {
    harness.reset_case();
    destroy_jit(harness.fr&);
    println(harness.msg.items());
    @assert_eq(harness.error, 0, "failed some tc tests");
    harness.msg&.drop();
}

main :: fn() void = {
    harness := @ref init_harness(.None);
    harness.run_tests();
    assert_ok(harness);
}

Harness :: @rec @struct {
    world: World;
    circuits: []Tc.Circuit;
    temp: Alloc.Mark;
    msg: List(u8);
    error := 0;
    prev_msg_len := 0;
    fr: CachedCompilerEnv = ();
    tc_file_loader_device: []Tc.LoadedFile;
    root: ?ComponentId = .None;
    image_callback: ImageFn;
    time := 0;
};
ImageFn :: @rec @struct(f: @FnPtr(self: *Harness, userdata: rawptr) void, userdata: rawptr);

fn reset_case(self: *Harness) void = {
    @if(self.root.is_some()) self'image_callback'f(self, self.image_callback.userdata);  // for tests/images.fr
    temp().reset(self.temp);
    time := timestamp();
    if self.prev_msg_len == self.msg.len {
        @if(self.root.is_some())
        @fmt(self.msg&, " [ok] %ms", time - self.time);
    } else {
        self.error += 1;
    };
    self.time = time;
}

fn load(self: *Harness, name: Str) *Harness = {
    self.reset_case();
    @fmt(self.msg&, "\n(%):", name);
    self.prev_msg_len = self.msg.len;
    
    // TODO: shouldn't need to reset every time but every call to emit_qbe_included gets a new MainThreadPump
    //       which assumes nothing is compiled yet so even tho the generated code is in a new scope, things it calls aren't and you get things like
    //       "panic! Assertion Failed: 'eq__2238' already has an entry in the inline cache. these should both look like pointers: 6308266032 5637149392" :CantReuseCompilerLikeThis
    reset_jit(self.fr&);
    
    each self.circuits { it |
        it.compiled = .None;
    };
    root_index := self.circuits.index_of(fn(it) => it.name == name)
        || @panic("missing load(%)", name);
    
    a := temp();
    components := @ref Component.list(a);
    components.push_all(builtin_components);
    discard := u8.list(temp());
    Tc'compile_circuit(self.circuits, root_index, components, a, discard&);
    jit_circuit(self.fr&, components.items(), a);
    init(self.world&, a, true, components.items());
    self.world.tc_file_loader_device = self.tc_file_loader_device;
    
    self.root = self.circuits[root_index].compiled;
    kind := self.root || {
        @fmt(self.msg&, "\n- failed to compile");
        return self;
    };
    Tc'set_initial_data(self.world&, self.circuits, kind, 0);
    self
}

fn run(self: *Harness, ticks: i64) *Harness = self.run(ticks, false);
fn run(self: *Harness, ticks: i64, allow_halt: bool) *Harness = {
    kind := self.root || return(self);
    o_n, i_n := self.world&[kind]&.arity();
    values := temp().alloc_zeroed(WireValue, o_n + i_n);
    range(0, ticks) { i |
        evaluate(self.world&, values, kind, 0, false);
        
        if get_halt_message(self.world&, self.circuits) { msg |
            if !allow_halt {
                @fmt(self.msg&, "\n- halted on tick % (%)", i, msg);
            };
            return self;
        };
    };
    self
}

fn then_halt(self: *Harness, expect: Str) *Harness = self.run(1, true).halted(expect);
fn halted(self: *Harness, expect: Str) *Harness = {
    msg := get_halt_message(self.world&, self.circuits) || {
        @fmt(self.msg&, "\n- expected halt");
        return self;
    };
    if msg != expect {
        @fmt(self.msg&, "\n- halted with wrong message expected (%) but found (%)", expect, msg);
    };
    self
}

fn get_halt_message(world: *World, circuits: []Tc.Circuit) ?Str = {
    if world.tc_halt_device == -1 {
        return(.None);
    };
    param: Tc.Builtin.Settings.Halt = (repr = world.tc_halt_device.bitcast());
    msg := circuits[param.get(.circ_i)].gates[param.get(.gate_i)].data;
    (Some = msg)
}

fn console(self: *Harness, msg: Str) *Harness = {
    for_consoles self { data |
        @if(data.starts_with(msg)) return(self);
    };
    @fmt(self.msg&, "\n- missing console message (%)", msg);
    self
}

fn console_contains(self: *Harness, msg: Str) *Harness = {
    for_consoles self { data |
        @if(data.contains(msg)) return(self);
    };
    @fmt(self.msg&, "\n- missing console message (%)", msg);
    self
}

fn for_consoles(self: *Harness, $body: @Fn(data: Str) void) void = {
    root, world := (self.root || return(), self.world&);
    circuit := self.circuits.find(fn(it) => it.compiled.is_some() && it.compiled.Some.id == root.id).unwrap();
    c := world[root];
    
    each circuit.gates { gate |
        continue :: local_return;
        i := gate.logical_gate_index;
        @if(i == -1) continue();
        it := c.gates[i]&;
        @if(group(it.kind) != .Tc1) continue();
        
        if it.kind.name(.Tc1) == .Console {
            T :: Tc.Builtin.Settings.Console;
            param: T = (repr = it.param.bitcast());
            @if(param.get(.linked) == 0) continue();
            offset := world.storage[c.instance_offset_by_gate[i]];
            bytes_per_char := @if(param.get(.colour) == 0, 1, 8);
            data := world.storage.interpret_as_bytes();
            data := data.subslice(param.get(.linked_ram_instance)*8 + offset*bytes_per_char, 80*24*bytes_per_char);
            body(data);
        };
    };
} 

fn keyboard_input(self: *Harness, text: Str) *Harness = {
    // TODO
    self
}

Maze :: import("@/examples/circuit/levels/maze.fr").Maze;
fn maze(self: *Harness, limit: i64) *Harness = {
    kind := self.root || return(self);
    name := self.world&[kind].name;
    Defs :: import("@/examples/circuit/defs.fr");
    program := @if(name == "LEG", Defs.the_maze_leg, Defs.the_maze);
    if name == "NANDverture" {
        self.world.storage.subslice(56, 256/8).interpret_as_bytes().copy_from(program);
    };
    if name == "OVERTURE" || name == "LEG" {
        self.world.storage.subslice(1, 256/8).interpret_as_bytes().copy_from(program);
    };
    hack := int(name == "LEG");
    maze := @ref Maze'new(Maze.tc0);
    range(0, limit) { _ |
        in := maze.input();
        values := @slice(0, 0, 0, @as(i64) in.zext());
        evaluate(self.world&, values, kind, 0, false);
        if values[1+hack] != 0 {
            maze.output(values[0+hack].trunc());
        };
    };
    if !maze.win {
        @fmt(self.msg&, "\n- didn't solve the maze within % ticks", limit);
    };
    self
}

#use("@/examples/circuit/eval.fr");
#use("@/examples/circuit/parse.fr");
#use("@/examples/jit_loader.fr");

jit_circuit :: fn(slot: *CachedCompilerEnv, components: []Component, a: Alloc) void = {
    // finished_defs don't need to be re-compiled every time because they'll already have it.fast_eval set from comptime. 
    first_index_that_needs_fast_eval := builtin_components.len();
    
    // either way need to set Component.compile_order for interp
    src := compile_gates_source(components, a, first_index_that_needs_fast_eval, @ref u8.list(temp()));
    @if(!FEAT_COMPILE) return();
    
    callee := jit_value(slot, src, "dispatch");
    fill_fast_eval(components, callee);
}

// TODO: #use(Main.eval); doesn't work at top level (works if #use the string): "Compile Error: Poison expression Unknown." :compiler
Main :: import().examples.circuit;
test_defs :: fn() void = {
    world := @ref zeroed(World);
    a := general_allocator();
    finished_components :: @run {
        components := @ref Component.list(ast_alloc());
        components.push_all(builtin_components);
        compile_defs(components);
        compile_gates(current_compiler_context(), components.items());
        components.items()
    };
    init(world, a, false, finished_components);
    
    Defs :: Main.defs;
    cpus := @slice(
        ("overture", Defs.the_maze),
        ("leg", Defs.the_maze_leg),
    );
    for cpus { name, program |
        world.storage.set_zeroed();
        maze := @ref Maze'new(Maze.tc0);
        root_component := get_component_by_name(name, finished_components);
        start := timestamp();
        range(0, 256) { i |
            tick_defs_arch(world, root_component, program[i], true);
        };
        
        n := 0;
        dowhile {
            in := maze.input();
            if tick_defs_arch(world, root_component, in, false) { byte |
                maze.output(byte);
            };
            n += 1;
            @assert_lt(n, 20000, "this is taking too long. broken?");
            !maze.win
        };
        end := timestamp();
        @println("[%] solved maze in % ticks (%ms)", name, n, end - start);
    };
    
    C :: fn($a: Str, b: []i64) => world.check(a, b);
    range(0, 256) { a0 |
        C("eq0", @slice(a0, int(a0 == 0)));
        C("neg8", @slice(a0, bit_and(-a0, 255)));
        range(0, 256) { a1 |
            C("add8", @slice(0, a0, a1, bit_and(a0+a1, 255), int(a0 + a1 > 255)));
            C("sub8", @slice(a0, a1, bit_and(a0-a1, 255)));
            C("and8", @slice(a0, a1, bit_and(a0, a1)));
            C("or8", @slice(a0, a1, bit_or(a0, a1)));
            C("xor8", @slice(a0, a1, bit_xor(a0, a1)));
            C("equal8", @slice(a0, a1, int(a0 == a1)));
            C("ult8", @slice(a0, a1, int(a0 < a1)));
            
            range(0, 6) { c |
                F :: @FnPtr(i64, i64) bool;
                x := @const_slice(@as(F) eq, ne, lt, le, gt, ge);
                cond := x[c];
                C("leg_cond", @slice(c, a0, a1, 1, int(cond(a0, a1))));
            };
        };
    };
    
    check :: fn(world: *World, $name: Str, args: []i64) void = {
        kind := get_component_by_name(name, finished_components);
        o_n, i_n := world[kind]&.arity();
        a := Arena'stack_alloc(size_of(WireValue) * max_in_out_wires);
        wires := a.alloc_zeroed(WireValue, args.len);
        wires.rest(o_n).copy_from(args.slice(0, i_n));
        evaluate(world, wires, kind, 0, false);
        range(0, o_n) { i |
            @assert_eq(wires[i], args[i_n + i], "check(%, %) o[%]", name, args, i);
        };
    };
    
    tick_defs_arch :: fn(world: *World, root_component: ComponentId, input: u8, write_program: bool) ?u8 = {
        values := @slice(0, 0, 0, input.zext(), int(write_program));
        evaluate(world, values, root_component, 0, false);
        @if(values[1] != 0, (Some = values[0].trunc()), .None)
    };
    
    drop(world, a);
    
    if query_current_arch() != .wasm32 {
        umulh :: import("@/examples/circuit/tc/builtin.fr").multiply_high_u64;
        @assert_eq(umulh(-1, -2), -3);
        @assert_eq(umulh(12345678987654321, 987654321), 660998);
    };
};
