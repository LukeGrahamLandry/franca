// TODO: get rid of all the places i do string comparisons on the name. 
//       put flags on the Template so don't have to be defensive about someone naming their CC "Output12456z" or whatever 
// TODO: another source of bad things if i want to cope with malicious inputs: 
//       every time i try to check if a path looks evil and if so print it out instead of using, 
//       what if those bytes have magic terminal escape codes that do crazy shit.
//       goes away if i just report errors gracefully in the gui instead. 

SPAM_LOG :: false;

// TODO: be consistant about how files are treated: rom/hdd has file loaded into .data for set_initial_data, sprites/file_loader has file in tc_file_loader_device indexed by .param. 
// TODO: generally want to make the format i use here and in ../save.fr 
//       make more sense to me and convert when loading a tc file. 
//       ex. dont like the console link_id being a string in .data, and use my param instead of settings pair, dont like how i store programs. 

// diagram layout loaded from one circuit.data file. 
Circuit :: @struct {
    id: CustomId;
    wires: RawList(Wire);
    gates: RawList(Gate);
    programs: []Program;
    mnemonics := "";
    min: Vec2;
    max: Vec2;
    dependencies: RawList(CustomId);
    name: Str;
    arity: Ty(i64, i64) = (-1, -1);
    has_bidirectional_pins := false;
    has_arch_pins := false;
    v2: bool;
    is_arch := false;
    has_probes := false;
    default_tick_rate: i64;
    
    compiled: ?ComponentId = .None;
    // used when referenced as a Custom Gate in another Circuit. 
    // these are based on layout of the implementation. 
    pins: []Ty(i64, i64) = empty();
    bit_width: []u8 = empty();  // io only
    pin_names: []Str = empty();
    switches: []SwitchablePin = empty();
    
    inlined: RawList(InlineRecord) = empty();
    
    // this is annoying becuase mystery_spice_minus_fifteen_for_custom_pins is stored on the gate not the circuit so can be different each time but it never is? hopefully i'll understand when i need to edit custom components myself. probably about centering on the field?
    cached_pin_radius: @struct(r: f32 = -1, p := vec2(0)) = ();
    
    undo: RawList(UndoEntry) = empty();
    redo: RawList(UndoEntry) = empty();
    
    Wire :: @struct {
        // only the first and last can connect to things. the others are just visual.
        path: RawList(WireNode);
        logical: WireId = (id = 0xFFFFFFFF);
        teleport := false;
        comment := "";
        colour: u8 = 0;
    };
    WireNode :: @struct(pos: Vec2, direction: Vec2 = vec2(0), length: i64 = 0);
    Gate :: @struct {
        pos: Vec2;
        kind: ComponentId;
        rotation: u8;
        custom_id: CustomId = (id=0);  // when kind is Custom
        // TODO: v2 sanely got rid of the -15 so move that just to the v1 loader
        mystery_spice_minus_fifteen_for_custom_pins: Vec2 = vec2(0);
        settings: []i64 = empty();
        data: RawList(u8) = empty();
        logical_gate_index := -1;
        link_id: i64 = 0;  // ram.link_id is referenced by console.data. `{rom.link_id}.rom` file has init data. 
        label: RawList(u8) = empty();
        // (screen, console) -> ram
        // ram -> ports
        // port points to the one above it, which it depends on, they're executed top to bottom (reverse order of the linked list)
        port_linked_list := -1;  // index in Circuit.gates
        watched: []Watched = empty();
        inline_record: u32 = 0xFFFFFFFF;  // only on the CC that was inlined. index in Circuit.inlined. 
    };
    Watched :: @struct(id: i64, inner_id: i64, name: Str, offset: i64, word_size: i64);
    Program :: @struct {
        SANDBOX_LEVEL_ID :: 86;
        level_id: i64 = -1;  // v1
        level_name: Str = "";  // v2
        name: Str;
        gate_index: i64;
        gate_link_id := -1;
        assembly: ?Str = .None;
        assembled: ?[]u8 = .None;
    };
    
    SwitchablePin :: @struct {
        value_output_index: i64;     // components[compiled].gates[-1].inputs[_]
        condition_output_index: i64; // ^
    };
    
    InlineRecord :: @struct {
        gate_i: i64;      // index in Circuit.gates
        wires: []WireId;  // [child] -> parent
        gates: []i64;     // [child] -> parent (index in Component.gates)
    };
    
    // annoying that this can't go in editor.fr
    // order matters for save.fr
    UndoEntry :: @tagged(
        SetGateField: @struct(i: i64, field: i64, value: Str),
        SetGatePosition: @struct(i: i64, rotation: u8, pos: Vec2),
        UndeleteGate: @struct(i: i64, gate: Gate),
        DeleteGate: @struct(i: i64),
        UndeleteWire: @struct(i: i64, wire: Wire),
        DeleteWire: @struct(i: i64),
    );
};

CustomId :: @struct(id: i64);

#use("@/examples/circuit/compile.fr");
#use("@/lib/sys/fs.fr");
Builtin :: import("@/examples/circuit/tc/builtin.fr");
Asm :: import("@/examples/circuit/tc/asm.fr");

load_builtins :: fn(components: *List(Component), a: Alloc) void = {
    add_templates(components, a, Builtin.templates);
    add_templates(components, a, Builtin.templates2);
    add_templates :: fn(components: *List(Component), a: Alloc, templates: []*Builtin.Template) void = each templates { it |
        c := zeroed(Component);
        c.primitive_arity = (it.out_arity, it.in_arity);
        if it.fid { _ |
            c.fast_eval = it.callee;
        };
        c.name = it.name;
        c.usage = a.box_zeroed(Component.Usage);
        c.inputs_for_pure_eval = it.inputs_for_pure_eval;
        c.has_param = it.has_param;
        c.gate_sum = 1;
        c.bit_width = it.bit_width;
        c.is_switch = it.name.starts_with("Switch");
        components.push(c);
    };
}

LoadedFile :: @struct(data: []u8, name: Str);
// TODO: don't require loading a specific circuit at this point (allow just loading all)
load_all_circuits :: fn(original_root: Str, a: Alloc, warn: *List(u8)) Ty([]Circuit, i64, []LoadedFile) = {
    root := original_root;
    root_name := name_from_path(root);
    while => !root.ends_with("schematics/") && root.len > 0 {
        root = root.pop_path_segment();
    };
    
    // TODO: could just look at the headers and only load full data if in dependencies
    files := collect_schematics(root, temp());
    if !files&.contains(original_root) {
        files&.push(original_root);
    };
    if root.ends_with("/v1/schematics/") {  // HACK
        it := @tfmt("%v2/schematics/", root.pop_path_segment().pop_path_segment());
        it := collect_schematics(it, temp()).items();
        files&.push_all(it);
    };
    // this order is shown in the ui so its annoying if it changes between platforms 
    Sort'default(Str, files.items(), fn(a, b) => Sort'order_strings(b, a));
    
    tc_file_loader_device := list(LoadedFile, a);
    circuits := Circuit.list(a);
    for files { path |
        continue :: local_return;
        in := read_entire_file(temp(), path) || {
            @fmtln(warn, "failed to read [%]", path);
            continue();
        };
        name := name_from_path(path).shallow_copy(a);
        res := load_circuit(in, a, name);
        info := res.or(fn(msg) => {
            @fmtln(warn, "failed to load [%]: %", path, msg);
            continue();
        });
        if circuits.contains(fn(it) => it.id.id == info.id.id) {
            @fmtln(warn, "duplicate id [%]: %", info.id.id, info.name);
        };
        info.is_arch = path.contains("architecture");
        dir := path.pop_path_segment();
        @debug_assert(dir.ends_with("/"));
        has_path_escapes :: import("@/examples/fetch.fr")'has_path_escapes;
        
        if read_entire_file(a, @tfmt("%assembly.data", dir)) { it |
            info.mnemonics = it;
        };
        
        each info.programs { it |
            continue :: local_return;
            if has_path_escapes(it.name) {
                @fmtln(warn, "Assembly path [%] is sketchy", it.name);
                continue();
            };
            if !info.v2 {
                // TODO: if i want to load for other levels, i need the mapping to names from https://turingcomplete.game/api_level_meta
                path := @tfmt("%sandbox/%.assembly", dir, it.name);
                it.assembly = read_entire_file(a, path);
            } else {
                path := @tfmt("%%", dir, it.name);
                it.assembly = read_entire_file(a, path);
                
                // i dont embed their assembler generator thing so rely on you running it as a seperate program
                if path.ends_with(".asm") {
                    path.rest(path.len - 4).copy_from(".bin");
                    it.assembled = read_entire_file(a, path);
                };
            };
        };
        each info.gates { it |
            continue :: local_return;
            
            check_file("Rom", "rom");
            check_file("Hdd", "hdd");
            check_file("Ram_v2", "bin");
            check_file :: fn($name: Str, ext) => {
                kind := get_component_by_name(name, builtin_components);
            if it.kind.id == kind.id {
                it.data = empty();
                if read_entire_file(a, @tfmt("%%.%", dir, it.link_id, ext)) { data |
                    it.data = data.as_raw_list();
                };
                if read_entire_file(a, @tfmt("%sandbox/%.%", dir, it.link_id, ext)) { data |
                    it.data = data.as_raw_list();
                };
                continue();
            };
            };
            
            if group(it.kind) != .Tc1 || !@is(gate_name(it.kind, .Tc1), .FileLoader, .SpriteDisplay) {
                continue();
            };
            file_index := it.settings&[0]&;
            file_index[] = -1;
            if has_path_escapes(it.data.items()) {
                @fmtln(warn, "FileLoader path [%] is sketchy", it.data.items());
                continue();
            };
            @if(it.data.len == 0) continue();  // none selected
            
            path := @tfmt("%%", dir, it.data.items());
            data := read_entire_file(a, path) || {
                @fmtln(warn, "- failed to read [%] for file loader in [%]", path, name);
                continue();
            };
            file_index[] = tc_file_loader_device.len;
            tc_file_loader_device&.push(name = it.data.items(), data = data);
        };
        
        circuits&.push(info);
    };
    
    root_index := circuits.index_of(fn(it) => it.name == root_name) || {
        @fmtln(warn, "couldn't find (%). shouldn't happen if path is in tc save directory", root_name);        
        0
    };
    
    if circuits.len == 0 {
        return(empty(), -1, empty());
    };
    
    (circuits.items(), root_index, tc_file_loader_device.items())
}

HACK_NONE_PIN_POSITION :: 999999;

// TODO
// move more of the validation stuff out of the parse from FatExpr into a post pass so can share with this. 
// - detect use-before-def (bad input or just confused) gracefully and error instead of crashing on franca compile error later. 

// diagram -> gate graph
compile_circuit :: fn(circuits: []Circuit, root_index: i64, components: *List(Component), arena: Alloc, warn: *List(u8)) void = {
    c := circuits[root_index]&;
    if c.compiled.is_some() {
        @fmtln(warn, "why am i compiling % twice?", c.name);
        return();
    };
    
    unimplemented := false;
    
    for c.dependencies { custom_id |
        continue :: local_return;
        // TODO: detect cycles (malformed data file)
        ::AutoEq(CustomId); ::RefEq(CustomId);
        child_index := circuits.index_of(fn(it) => it.id == custom_id) || {
            @fmtln(warn, "missing dependency custom component % in (%)", custom_id.id, c.name);
            unimplemented = true;
            continue();
        };
        if circuits[child_index].compiled.is_none() {
            compile_circuit(circuits, child_index, components, arena, warn);
        };
    };
    @if(c.compiled.is_some()) return();
    c.inlined = empty();  // might be recompiling after editing
    
    @if(SPAM_LOG) @fmtln(warn, "loading (%):", c.name);
    a := arena;
    gates, wire_count := find_pins(c, a, circuits, warn, unimplemented&);
    custom_pins := Ty(i64, i64).list(a);
    pin_names := Str.list(a);
    switches := Circuit.SwitchablePin.list(a);
    cc_output := @ref WireId.list(temp());
    
    CONST_INDEX := { xx := CONST_INDEX; /*:compiler*/ xx.id };
    @debug_assert_eq(components[CONST_INDEX.zext()].name, "Constant");
    logical_to_circuit := i64.list(gates.len, temp());
    extra_gates := 0;
    kill: DynamicBitSet = empty(temp());
    in, out := (WireId.list(a), WireId.list(a));
    bit_width := u8.list(a);
    output_pin_count := 0;
    // note: gates starts out 1 to 1 with c.gates. some are appended in this loop when inlining. 
    //       then some are killed at the beginning. more are appended for casts. then they're reordered for schedual. 
    range(0, gates.len) { i |  // gate.push in this loop
        continue :: local_return;
        it := gates.index(i); 
        if i >= c.gates.len {
            // new_false_wire
            @assert(it.inputs.len == 0 && it.kind.id == CONST_INDEX, "CONST_INDEX HACK"); 
            logical_to_circuit&.push(-1);
            continue();
        };
        
        original_gate := c.gates[i]&;
        original_gate.port_linked_list = -1;  // dont warn about multiple being connected when recompiling
        shape := get_builtin_shape(it.kind);
        
        if shape.name.starts_with("Bidirectional") {
            c.has_bidirectional_pins = true;
        };
        
        @if(shape.body == .Unimplemented) if shape.name.starts_with("Probe") || shape.name == "Delay_line_word_asm" {
            // TODO
            kill&.set(i);
            continue();
        }
        if shape.name.starts_with("Probe") { 
            c.has_probes = true;
        };
        
        if shape.name.starts_with("Buffer") {
            // HLL-Interpreter's DEC 4 has one of these. it seems to be invisible in the game? and i can't find it in the menus. does nothing? TODO: is this fine?
            kill&.set(i);
            continue();
        }
        
        if shape.name == "_0" {  // editor: deleted gate
            kill&.set(i);
            continue();
        };
        
        out_arity, in_arity := get_arity(shape, original_gate, circuits, warn);
        
        if in_arity != it.inputs.len || out_arity != it.outputs.len {
            unimplemented = true;
            @fmtln(warn, "TODO: arity error (%) I: % vs %; O: % vs %; gate %/%", shape.name, shape.in_arity, it.inputs.len, shape.out_arity, it.outputs.len, i, gates.len);
        }
        
        apply_switchable_pin :: fn(value, condition, bit_width) => {  // :OutputNz
            S := @const_slice(
                (@as(u8)1, get_component_by_name("Switch1", builtin_components)),
                (8, get_component_by_name("Switch8", builtin_components)),
                (16, get_component_by_name("Switch16", builtin_components)),
                (32, get_component_by_name("Switch32", builtin_components)),
                (64, get_component_by_name("Switch64", builtin_components)),
            );
            S := S.find(fn(it) => it._0 == bit_width) || S[4]&;
            S := S._1;
        
            w := a.alloc_uninit(WireId, 3);
            switchable_wire: WireId = (id = wire_count.trunc());
            wire_count += 1;
            
            w[0] = value[];
            w[1] = switchable_wire;
            w[2] = condition[];
            value[] = switchable_wire;
            
            gates&.push(kind = S, inputs = w.slice(1, 3), outputs = w.slice(0, 1));
            extra_gates += 1;
            it = gates.index(i);  // ^ can reallocate
        };
        
        if shape.switches.len != 0 {
            widths := get_bit_width(shape, it.param);
            for shape.switches { pin |
                width := @if(widths.len > pin.value_output_index, widths[pin.value_output_index], original_gate.settings[0].trunc());
                apply_switchable_pin(it.outputs[pin.value_output_index]&, it.inputs[pin.condition_input_index]&, width);
            };
        }
        
        @if(shape.name == "Program") assemble_v1(c, it.get_param(.Ram), i, a, warn);
        @if(shape.name == "Static_value") { c.has_bidirectional_pins = true; };
                
        @match(shape.body) { 
            fn Unimplemented() => {
                kill&.set(i);
                @fmtln(warn, "TODO: not implemented (%)", shape.name);
                unimplemented = true;
            }
            fn IO() => {
                kill&.set(i);
                @if(shape.name == "LevelScreen") continue();
                // inputs of the gate become outputs of the circuit and visa versa
                out&.push_all(it.inputs);
                in&.push_all(it.outputs);
                
                // outputs first 
                is_input := it.outputs.len != 0;
                dest := @if(is_input, custom_pins.len, output_pin_count);
                
                is_switchable_output := it.inputs.len == 2 && it.outputs.len == 0;
                if is_switchable_output {
                    if shape.name.ends_with("Arch") {
                        c.has_arch_pins = true;
                    };
                    // :OutputNz ughhhhh this seems convoluted but i don't have a better idea rn. 
                    // it has two input pins on the inside but only exposes one output pin. 
                    // my representation doesn't have an extra bit for being disabled so it compiles to two outputs
                    // and the caller inserts a switch to merge them back into one wire. 
                    switches&.push(
                        value_output_index = out.len - 2,
                        condition_output_index = out.len - 1,
                    );
                };
                
                x, y := fix_pin_position(original_gate.pos);
                insert(custom_pins&, dest, (x, y));
                // TODO: bad if you then edit the label (editor shows pin names on hover)
                name := original_gate.label.items();
                if name == "" {
                    if shape.name == "Level_input_switched" || shape.name == "LevelInputArch" {
                        name = "in";
                    };
                    if shape.name == "Level_output_switched" || shape.name == "LevelOutputArch" {
                        name = "out";
                    };
                };
                
                pin_names&.insert(dest, name);
                width: u8 = @if(shape.name == "Cc_input" || shape.name == "Level_input_switched",
                    original_gate.settings[0].trunc(),
                    @if(shape.name == "Cc_output", 64,   // :InferCc_output
                        @if(shape.bit_width.len == 0, 0, shape.bit_width[0])));
                insert(bit_width&, dest, width);
                
                if shape.name == "Cc_input" && original_gate.settings[0] == MIN_i64 {
                    // auto sized input can be different at each callsite. 
                    c.has_bidirectional_pins = true;
                };
                
                if shape.name == "Cc_output" {
                    cc_output.push(it.inputs[0]);
                };
                
                if is_switchable_output {
                    insert(custom_pins&, dest + 1, (HACK_NONE_PIN_POSITION, HACK_NONE_PIN_POSITION));
                    insert(bit_width&, dest + 1, 1);
                    pin_names&.insert(dest + 1, @afmt(a, "%#on", name));
                    output_pin_count += 1;
                };
                
                // TODO: be consistant about treating these the same as cc ones. rn dest is wrong 
                //       but also this wouldnt work at all if you tried to put them in a cc anyway. 
                //       cause would need to chain them from the top which is convoluted. 
                if shape.name == "LevelInputArch" || shape.name == "Level_input_switched" {
                    d := output_pin_count;
                    insert(custom_pins&, d, (HACK_NONE_PIN_POSITION, HACK_NONE_PIN_POSITION));
                    insert(bit_width&, d, 1);
                    pin_names&.insert(d, @afmt(a, "%#on", name));
                    output_pin_count += 1;
                    c.has_arch_pins = true;
                };
                
                output_pin_count += int(!is_input); 
            }
            fn Native() => ();
            fn Custom() => {
                child := find_custom_impl(original_gate, circuits) || {
                    // should be unreachable because of the `dependencies` in the data file. 
                    @fmtln(warn, "missing custom component %", original_gate.custom_id.id);
                    unimplemented = true;
                    kill&.set(i);
                    continue();
                };
                it.kind = child.compiled.unwrap();
                original_gate.kind = it.kind;
                
                for child.switches { switchable_pin |
                    apply_switchable_pin(it.outputs[switchable_pin.value_output_index]&, it.outputs[switchable_pin.condition_output_index]&, child.bit_width[switchable_pin.value_output_index]);
                };
                
                if child.has_arch_pins {
                    @fmtln(warn, "TODO: allow LevelInputArch/LevelOutputArch inside custom component?");
                    unimplemented = true;
                };
                
                it := ();
                @if(!unimplemented)
                if child.has_bidirectional_pins {
                    @if(SPAM_LOG) @fmtln(warn, "(%) calls (%) with bidirectional pins", c.name, child.name);
                    kill&.set(i);
                    child_logical := child.compiled || {
                        @fmtln(warn, "TODO: missing (%).compiled", child.name);
                        unimplemented = true;
                        continue();
                    };
                    child_logical := components.index(child_logical.id.zext());
                    if child_logical.error {
                        unimplemented = true;
                    };
                    inline_for_bidirectional_gates(c, child_logical, gates&, wire_count&, extra_gates&, i, a, @slice(in.items(), out.items(), cc_output.items()), original_gate);
                };
            } 
        };
        
        if !kill&.get(i) {
            logical_to_circuit&.push(i);
        };
    };    
    range_rev(0, c.gates.len) { i |
        if kill&.get(i) {
            // :SLOW
            each gates { it |
                if it.port_linked_list - 1/*:confusing*/ > i {
                    it.port_linked_list -= 1;
                };
            };
            
            gates&.ordered_remove(i);
        }
    };  
    logical_to_circuit&.push_repeated(extra_gates, -1);
    
    // (v2) outputs are always bidirectional but i'd rather they not be 
    //      so try to find situations where it doesn't matter. 
    // TODO: i think i need to give up on this. 
    //       there can be a dependency cycle where there are disjoint sections in the CC  
    //       and some of the inputs depend on some of the outputs but you only find that out at 
    //       the usage site. (inputs_for_pure_eval can only help if pre_read can get ALL the inputs with some of the outputs). 
    //       ex. "ITPC" in "Symphony-Pro"
    if cc_output.len != 0 {
        break :: local_return;
        // @if(c.name == "ITPC") { c.has_bidirectional_pins = true; break(); }; // HACK example
        for cc_output { id |
            has_def := false;
            each gates { it |
                if it.outputs.contains(fn(it) => it.id == id.id) {
                    if components[it.kind.id.zext()].is_switch {
                        c.has_bidirectional_pins = true;
                        break();
                    };
                    has_def = true;
                };
            };
            if !has_def && !in.contains(fn(it) => it.id == id.id) {
                c.has_bidirectional_pins = true;
                break();
            };
        };
    };
    
    // TODO: a bunch of the rendering stuff relies on the top most thing being 
    //      has_bidirectional_pins=false. but if you place a disconnected cc_output 
    //      or an auto width cc_input in your arch it infers has_bidirectional_pins=true. 
    //      i guess report error if theres something that requires being inlined?

    // the visualisation relies on the top level thing not being inline only
    if c.is_arch {
        c.has_bidirectional_pins = false;
    };
    
    // after `kill` so no more reordering the graphical ones
    linkables := assign_port_links(c.gates.items(), warn);    
    
    c.arity = (out.len, in.len);
    
    bit_width := bit_width.items();
    
    c.pins = custom_pins.items();
    c.pin_names = pin_names.items();
    c.switches = switches.items();
    push_inputs_outputs(gates&, out.items(), in.items());
    logical_to_circuit&.insert(0, -1);  // in
    logical_to_circuit&.push(-1);       // out
    insert_consts_for_dead_wires(components.items(), gates&, @if(c.has_bidirectional_pins, cc_output.items(), empty()));
    logical_to_circuit&.push_repeated(gates.len - logical_to_circuit.len, -1);
    @debug_assert_eq(bit_width.len, custom_pins.len);
    
    wire_bit_width := insert_bit_width_casts(components.items(), gates&, wire_count&, bit_width, warn, c, logical_to_circuit.items(), circuits);
    logical_to_circuit&.push_repeated(gates.len - logical_to_circuit.len, -1);
    new_gates, order, error := schedule_gates(c, gates, wire_count, a, out.items(), in.items(), components.items(), warn, logical_to_circuit.items(), c.has_bidirectional_pins);
    gates := new_gates;
    
    @debug_assert_eq(gates.len, order.len);
    enumerate order { i, o |
        continue :: local_return;
        
        if gates[i].inline_record != 0xFFFFFFFF {
            c.inlined[gates[i].inline_record.zext()].gates[gates[i].inline_index.zext()] = i;
        };
        if gates[i].port_linked_list != -1 {
            // :SLOW but will only happen for ports that were inlined
            gates[i].port_linked_list = order.index_of(fn(it) => it[] == gates[i].port_linked_list).unwrap();
        };
        
        @if(o[] >= logical_to_circuit.len) continue();  // it's a pre_read split
    
        gate_i := logical_to_circuit[o[]];
        if gate_i != -1 {
            c.gates[gate_i].logical_gate_index = i;
        };
    };
    logical_to_circuit := ();
    assign_port_param(c.gates.items(), gates.items(), linkables);
    
    each gates { it |
        @if(it.kind.is_port() && it.get_param(.Port)[].get(.connected) == 0) @fmtln(warn, "port without ram");
    };
    
    name := safe_name(c.name, a);
    c.compiled = (Some = (id = components.len.trunc()));
    components.push(
        gates = gates.items(),
        name = name,
        wire_count = wire_count,
        has_bidirectional_pins = c.has_bidirectional_pins,
        error = unimplemented || error,
        has_probes = c.has_probes,
    );
    c.bit_width = bit_width;
    if calculate_usage(components.items(), a, warn) {
        components[components.len - 1].error = true;
    };
    usage := components[components.len - 1].usage;
    usage.bit_width = bit_width;
    usage.wire_bit_width = wire_bit_width;
    
    find_links_for_lastest_component(c, components.items(), linkables, warn);
    
    @if(c.has_bidirectional_pins) each gates { it |
        if it.temporary_auto_width && gate_name(it.kind, .Tc2) != .Static_value {| it.param = 0; };
    };
}

find_links_for_lastest_component :: fn(c: *Circuit, components: []Component, linkables: []i64, warn: *List(u8)) void = {
    component := components[components.len - 1]&;
    for linkables { i |
        continue :: local_return;
        it := c.gates[i]&;
        if group(it.kind) == .Tc2 && name(it.kind, .Tc2) == .Screen {
            screen := it;
            screen.port_linked_list = -1;
            each screen.watched { watched |
                if linkables.find(fn(it) => c.gates[it[]].link_id == watched.id) { i |
                    i := i[];
                    ram := c.gates[i]&;
                    if group(ram.kind) == .Tc2 && name(ram.kind, .Tc2) == .Ram_v2 {
                        @if(screen.port_linked_list != -1) @fmtln(warn, "screen had multiple linked rams");
                        screen.port_linked_list = i;
                    };
                };
            };
            @if(screen.port_linked_list == -1) @fmtln(warn, "didn't find screens's linked ram");
            continue();
        };

        if group(it.kind) != .Tc1 || name(it.kind, .Tc1) != .Console {
            continue();
        };
        
            if it.logical_gate_index == -1 {
                @fmtln(warn, "TODO: console without logical_gate_index can't update param for linked component");
                continue();
            };
            // TODO: can id be negative?
            custom_string := it.data.items();
            linked0, s := convert_number(custom_string, 10, dec_digit);
            if s.len == custom_string.len {
                if custom_string != "" {
                    @fmtln(warn, "console string didn't start with a number so can't find linked component");
                    @fmtln(warn, "%", custom_string);
                };
                continue();
            };
            
            ram_index := linkables.find(fn(it) => c.gates[it[]].link_id == linked0) || {
                @fmtln(warn, "didn't find console's linked id %", linked0);
                continue();
            };
            ram := c.gates[ram_index[]]&;
            if ram.logical_gate_index == -1 {
                @fmtln(warn, "TODO: console's linked ram doesn't have logical_gate_index");
                continue();
            };
            // it needs to be one that uses Settings.Ram because that's what tc'init expects
            // TODO: be more safe about that now that is_linkable has other stuff in it 
            ram_kind := component.gates[ram.logical_gate_index].kind;
            if ram_kind.group() != .Tc1 || ram_kind.id == it.kind.id {
                @fmtln(warn, "console must link to v1 ram");
                continue()
            };
            it.port_linked_list = ram_index[];
            logical_gate := component.gates[it.logical_gate_index]&;
            param := logical_gate.get_param(.Console);
            param.set(.linked, 1);
    };
};

fn is_linkable(kind: ComponentId) bool = @match(group(kind)) {
    fn Tc1() => @is(name(kind, .Tc1), .Console, .Ram, .RamLatency, .RamFast, .RamDualLoad, .Program, .Rom, .Hdd);
    fn Tc2() => kind.is_port() || @is(name(kind, .Tc2), .Ram_v2, .Screen, .Static_value);
    @default => false;
};

assign_port_links :: fn(gates: []Circuit.Gate, warn: *List(u8)) []i64 = {
    // collect these once so don't have to iterate as many things
    linkables := @ref i64.list(temp());
    enumerate gates { gate_i, gate |
        @if(is_linkable(gate.kind)) linkables.push(gate_i);
    };
    
    for linkables { gate_i |
        continue :: local_return;
        gate := gates[gate_i]&;
        @if(group(gate.kind) != .Tc2 || name(gate.kind, .Tc2) != .Ram_v2) continue();
        
        prev := gate;
        port_pos := gate.pos + vec2(0, height_of_port(name(gate.kind, .Tc2)));
        dowhile {
            found := false;
            for linkables { i |
                it := gates[i]&;
                if is_port(it.kind) {
                    height := height_of_port(name(it.kind, .Tc2));
                    if it.pos == port_pos - vec2(0, height) {
                        if prev.port_linked_list != -1 {
                            @fmtln(warn, "multiple ports in the same position");
                        };
                        prev.port_linked_list = i;
                        port_pos = it.pos;
                        prev = it;
                        found = true;
                    };
                };
            };
            found
        };
    };
    
    linkables.items()
};

assign_port_param :: fn(gates: []Circuit.Gate, logical: []Component.Gate, linkables: []i64) void = {
    for linkables { i |
        continue :: local_return;
        gate := gates[i]&;
        @if(gate.logical_gate_index == -1) continue();
        @if(gate.port_linked_list == -1) continue();
        logical[gate.logical_gate_index].port_linked_list = gates[gate.port_linked_list].logical_gate_index;
        @if(group(gate.kind) != .Tc2 || name(gate.kind, .Tc2) != .Ram_v2) continue();
        p := logical[gate.logical_gate_index]&.get_param(.Ram_v2)[];
        ram_size_bytes, little_endian := (p.get(.ram_size_bytes), p.get(.little_endian) == 1);
        
        i := gate.port_linked_list;
        while => i != -1 {
            it := gates[i]&;
            @debug_assert_ne(it.logical_gate_index, -1, "[%] port_linked_list entry has no logical gate", i);
            g := logical[it.logical_gate_index]&;
            @debug_assert(it.kind.is_port() && g.kind.id == it.kind.id, "expected port");
            p := g.get_param(.Port);
            // dont need to byteswap if it's only one byte
            p.set(.little_endian, int(little_endian || p[].get(.width) == 8));
            p.set(.ram_size_bytes, ram_size_bytes);
            p.set(.connected, 1);
            i = it.port_linked_list;
        };
    };
};

inline_for_bidirectional_gates :: fn(parent: *Circuit, child_logical: *Component, gates: *List(Component.Gate), wire_count: *i64, extra_gates: *i64, target_gate_i: i64, a: Alloc, parent_io: [][]WireId, original_gate: *Circuit.Gate) void = {
    original_gate.inline_record = parent.inlined.len.trunc();
    parent.inlined&.push((
        gate_i = target_gate_i,
        wires = a.alloc_init(WireId, child_logical.wire_count, fn(_) => (id = 0xFFFFFFFF)),
        gates = a.alloc_init(i64, child_logical.gates.len, fn(_) => -1),
    ), a);
    record := parent.inlined[parent.inlined.len - 1]&;

    it := gates[target_gate_i];
    original_wire_count := wire_count[];
    child_gates := child_logical.gates.slice(1, child_logical.gates.len - 1);
    parent_out, parent_in := (it.outputs, it.inputs);
    child_out, child_in := (child_logical.gates[child_logical.gates.len - 1].inputs, child_logical.gates[0].outputs);
    map: HashMap(WireId, WireId) = init(temp());  // child -> parent
    duplicates: HashMap(WireId, WireId) = init(temp());

    // TODO: (v1) normal outputs are still supposed to coerce Z even if some other pins are bidirectional. 
    pairs := @slice((child_out, parent_out), (child_in, parent_in));
    for pairs { child_wires, parent_wires |
        @assert_eq(child_wires.len, parent_wires.len, "inline bad arity?");
        range(0, parent_wires.len) { i |
            prev := map&.insert(child_wires[i], parent_wires[i]);
            if prev { prev |
                collide := duplicates&.insert(prev, parent_wires[i]);
                @assert(collide.is_none(), "TODO: multiple duplicates?");
                each duplicates& { k, v |
                    if v.id == prev.id { 
                        v[] = parent_wires[i];
                    }
                };
            };
        };
    };
    
    start_gate_count := gates.len;
    enumerate child_gates { rel_gate_i, gate |
        @debug_assert(gate.pre_read == -1, "shouldnt do real schedule if bidirectional");
        
        out, in := (gate.outputs.shallow_copy(a), gate.inputs.shallow_copy(a));
        wires := @slice(out, in);
        for wires { wires |
            each wires { it |
                it[] = map&.get_or_insert(it[], => {
                    new: WireId = (id = wire_count[].trunc());
                    wire_count[] += 1;
                    new
                })[]
            };
        };
        
        // not putting it in record.gates because it will be patched after schedual_gates (and it would be junk down anyway because `kill` removes gates)
        gates.push(
            kind = gate.kind, 
            outputs = out, 
            inputs = in, 
            param = gate.param, 
            temporary_auto_width = gate.temporary_auto_width, 
            temporary_disconnected_pins_bitset = gate.temporary_disconnected_pins_bitset,
            temporary_bit_width_for_constant = gate.temporary_bit_width_for_constant,  // TODO: unit test that needs this
            inline_record = parent.inlined.len.trunc() - 1,
            inline_index = rel_gate_i.trunc() + 1,
            // :confusing, rel_gate_i off by one skip input but also push_inputs_outputs later
            port_linked_list = @if(gate.port_linked_list == -1, -1, gate.port_linked_list + start_gate_count),
        );
        extra_gates[] += 1;
        
        new := gates[gates.len - 1]&;
        if group(new.kind) == .Tc2 && name(new.kind, .Tc2) == .Static_value && new.temporary_auto_width {
            @debug_assert_eq(gate.inline_record, 0xFFFFFFFF);
            link_id := new.param;
            found := false;
            
            static_values := @if(original_gate.settings.len > 2, original_gate.settings.rest(2), empty());
            range(0, static_values.len/2) { i |
                id, value := (static_values[i*2], static_values[i*2+1]);
                if !found && id == link_id {
                    found = true;
                    new.get_param(.StaticValue)[] = construct(value = value, valid = 1);  // :NonZeroParam
                };
            };
            // now it's fixed even if this parent is inlined somewhere else
            new.temporary_auto_width = false;
            @if(!found) @println("warn: couldn't find inner Static_value");
        };
    };
    // TODO: just use this as the map
    each map& { child, parent |
        record.wires[child.id.zext()] = parent[];
    };
    
    @if(duplicates.raw.len_including_tombstones == 0) return();
    // :SLOW
    // when one wire in the child is connected to multiple io pins, 
    // and parent can have different wires connected to those pins;
    // the inlining reveals they're actually the same wire and everywhere else in the parent 
    // that references one of those wires needs to be remapped.
    X :: fn(its) => each its { it |
        if duplicates&.get(it[]) { new |
            it[] = new;
        };
    };
    each gates { it |
        X(it.inputs);
        X(it.outputs);
    };
    for parent_io { it |
        X(it);
    };
    each parent.wires { it |
        X(it.logical&.slice(1));
    };
    each parent.inlined { it |
        X(it.wires);
    };
}

#use("@/lib/collections/bit_set.fr");
#use("@/examples/circuit/eval.fr");
fn push_inputs_outputs(gates: *List(Component.Gate), out: []WireId, in: []WireId) void = {
    I, O := (
         @run get_component_by_name("input", builtin_components), 
         @run get_component_by_name("output", builtin_components),
    );
    gates.insert(0, (kind = I, inputs = empty(), outputs = in));
    gates.push(kind = O, inputs = out, outputs = empty());
}

// TODO: pull things without side effects closer to thier first use. 
//       the most offensive one is constants, makes it hard to read. 
schedule_gates :: fn(c: *Circuit, gates: List(Component.Gate), wire_count: i64, a: Alloc, out: []WireId, in: []WireId, components: []Component, warn: *List(u8), logical_to_circuit: []i64, has_bidirectional_pins: bool) Ty(List(Component.Gate), []i64, bool) = {
    if has_bidirectional_pins {
        return(gates, temp().alloc_init(i64, gates.len, fn(i) => i), false);
    };

    order := i64.list(temp());  // [new gate index] -> old gate index
    ready: DynamicBitSet = empty(temp()); // [WireId]
    done: DynamicBitSet = empty(temp());  // [index in gates]
    
    // inputs/outputs are fixed at start/end
    output_gate_index := gates.len - 1;
    order&.push(0);
    done&.set(0);
    for gates[0].outputs { id |
        ready&.set(id.id.zext());
    };
    
    // components with memory can know their outputs before all inputs are ready. 
    // split them into two gates that can be scheduled seperately. 
    // pre_read needs fewer inputs and doesn't write memory.  
    range(0, gates.len) { i |
        gate := gates[i];
        c := components[gate.kind.id.zext()]&;
        o_n, i_n := c.arity();
        if has_storage(components, gate.kind) && c.inputs_for_pure_eval.len != i_n && o_n != 0 {
            @debug_assert(!gate.kind.is_port());
            gate.pre_read = i;
            @debug_assert_eq(gate.port_linked_list, -1);
            gates[i].post_read = gates.len; 
            gates&.push(gate);
        };
    };
    
    switch_gates := i64.list(temp());
    stack := @ref i64.list(temp());
    enumerate gates { i, it |
        // (load_port with no pins connected is still a root so port_linked_list always has a logical index)
        if it.outputs.len == 0 || it.post_read != -1 || is_port(it.kind) {
            stack.push(i);
        };
    };
    
    error := false;
    wires_needed := @ref WireId.list(temp());
    gates_needed := @ref i64.list(temp());
    looping := 0;
    while => stack.len > 0 && !error {
        continue :: local_return;
        switch_gates&.clear();
        wires_needed.clear();
        gates_needed.clear();
        i := stack[stack.len - 1];
        if done&.get(i) {
            stack.pop().unwrap();
            continue();
        };
        if looping > gates.len {
            @fmtln(warn, "%: circular dependency", c.name);
            error = true;
            continue();
        };
        
        it := gates[i]&;
        kind := components[it.kind.id.zext()]&;
        
        ok := true;
        if it.pre_read != -1 {
            for kind.inputs_for_pure_eval { i |
                @assert(i < it.inputs.len, "% arity or inputs_for_pure_eval error", kind.name);
                if !ready&.get(it.inputs[i].id.zext()) {
                    ok = false;
                    wires_needed.push(it.inputs[i]);
                };
            };
        } else {
            for it.inputs { id |
                if !ready&.get(id.id.zext()) {
                    ok = false;
                    wires_needed.push(id);
                };
            };
            
            // even if all the inputs are ready so dont technically need to pre_read, 
            // read must be before write so dont see the new value a tick early. 
            if it.post_read != -1 {
                if !done&.get(it.post_read) {
                    ok = false;
                    gates_needed.push(it.post_read);
                };
            };
        };
        
        if ok && kind.is_switch {
            // TODO: decide if this still helps enough to be worth making it less readable by splitting up the switches
            // output isnt ready until all the switches are but can move into output early so dont have to keep as many values live. 
            //if !done&.get_set(i) {
            //    order&.push(i);
            //};
        
            enumerate gates { x, jt |
                if !done&.get(x) && jt.outputs.len == 1 && jt.outputs[0].id == it.outputs[0].id {
                    @if(x != i) switch_gates&.push(x);
                    for jt.inputs { id |
                        if !ready&.get(id.id.zext()) {
                            ok = false;
                            gates_needed.push(x);
                        };
                    };
                };  
            };
        };
        
        // ports on the same ram execute top down. 
        if ok && it.kind.is_port() {
            break :: local_return;
            // TODO: doing these differently if already inlined or not is stupid
            // :paste :paste :paste :paste
            g_i := logical_to_circuit[i];
            if g_i == -1 {
                it := it;
                @debug_assert_ne(it.port_linked_list, i, "port cycle");
                if it.port_linked_list != -1 {
                    while => it.port_linked_list != -1 && @is(name(it.kind, .Tc2), .Load_port, .Pipelined_load_port) {
                        it = gates[it.port_linked_list]&;
                        @if(it.port_linked_list != -1) @debug_assert_ne(it.port_linked_list, gates[it.port_linked_list].port_linked_list, "port cycle");
                    };
                    
                    if it.port_linked_list != -1 {
                        i := it.port_linked_list;
                        if !done&.get(i) {
                            gates_needed.push(i);
                            ok = false;
                        };
                    };
                };
            } else {
            g := c.gates[g_i]&;
            if g.port_linked_list != -1 {
                // adjacent load order doesnt matter, go up until a store
                while => g.port_linked_list != -1 && @is(name(c.gates[g.port_linked_list].kind, .Tc2), .Load_port, .Pipelined_load_port) {
                    g = c.gates[g.port_linked_list]&;
                };
                
                if g.port_linked_list != -1 {
                    i := logical_to_circuit.index_of(fn(it) => it[] == g.port_linked_list).unwrap();  // :SLOW
                    if !done&.get(i) {
                        gates_needed.push(i);
                        ok = false;
                    };
                };
            };
            };
        };
        
        @if(!error) @debug_assert_eq(ok, gates_needed.len == 0 && wires_needed.len == 0);
        if !ok {
            stack.push_all(gates_needed.items());
            if gates_needed.len == 0 {
                for wires_needed { id |
                    enumerate gates { i, it |
                        if it.outputs.contains(fn(it) => it.id == id.id) {
                            stack.push(i);
                        };
                    };
                };
            };
            looping += 1;
            continue();
        };
        looping = 0;
        
        switch_gates&.push(i);
        for switch_gates { i |
            if !done&.get_set(i) && i != output_gate_index /* must be last */ {
                order&.push(i);
            };
        };
        for it.outputs { id |
            @debug_assert(it.post_read == -1 || ready&.get(id.id.zext()), "pre_read makes the outputs");
            ready&.set(id.id.zext());
        };
        
        // :NotForCorrectness
        if it.pre_read != -1 && !done&.get(it.pre_read) {
            all_ready := true;
            for it.inputs { id |
                all_ready = all_ready && ready&.get(id.id.zext());
            };
            if all_ready {
                done&.set(it.pre_read);
                order&.push(it.pre_read);
            };
        };
    };
    
    if error {
        enumerate gates { i, it |
            if !done&.get_set(i) && i != output_gate_index {
                if stack.contains(fn(it) => it[] == i) {
                it := gates[i]&;
                kind := components[it.kind.id.zext()]&;
                @fmtln(warn, "TODO: cycles! gate (%) in (%)", kind.name, c.name);
                for kind.inputs_for_pure_eval { i |
                    id := it.inputs[i];
                    if !ready&.get(id.id.zext()) {
                        @fmtln(warn, "- w% not ready", id.id);
                    }
                };
                
                if it.kind.is_port() {
                    g_i := logical_to_circuit[i];
                    if g_i != -1 {
                    g := c.gates[g_i]&;
                    if g.port_linked_list != -1 {
                        if logical_to_circuit.index_of(fn(it) => it[] == g.port_linked_list) { i | // :SLOW
                            if !done&.get(i) {
                                @fmtln(warn, "- port not ready");
                            };
                        };
                    };
                    };
                };
                };
                order&.push(i);
            }
        };
    };

    order&.push(output_gate_index);
    
    gates2 := Component.Gate.list(gates.len, a);
    for order { i |
        gates2&.push(gates[i]);
        new := gates2[gates2.len - 1]&;
        if new.pre_read != -1 {
            new.pre_read = order.index_of(fn(it) => it[] == new.pre_read).unwrap();  // :SLOW
        };
    };
    enumerate order { new_i, old_i |
        if gates[old_i[]].post_read != -1 {
            gates2[new_i].post_read = order.index_of(fn(it) => it[] == gates[old_i[]].post_read).unwrap();  // :SLOW
        }
    };
    gates&.drop();
    
    // if all inputs are ready in time, don't need to pre_read at all
    range_rev(1, gates2.len - 1) { i |
        continue :: local_return;
        it := gates2[i+1]&;
        @if(it.post_read != i) continue();
        for it.inputs { id |
            @if(it.outputs.contains(fn(it) => it.id == id.id)) continue();
        };
        
        @debug_assert_eq(gates2[i].pre_read, i+1);
        @debug_assert_eq(it.kind.id, gates2[i].kind.id);
        it.post_read = -1;
        gates2&.ordered_remove(i);
        order&.ordered_remove(i);
        each gates2 { it |
            if it.pre_read > i {| it.pre_read -= 1; };
            if it.post_read > i {| it.post_read -= 1; };
        };
    };
    
    gates = gates2;
    
    (gates, order.items(), error)
};

fn is_port(kind: ComponentId) bool = 
    group(kind) == .Tc2 && @is(name(kind, .Tc2), .Load_port, .Store_port, .Pipelined_load_port);

templates :: import("@/examples/circuit/tc/builtin.fr").templates;

// `circuits` is needed for finding the pins when `c` uses a custom component. 
find_pins :: fn(c: *Circuit, a: Alloc, circuits: []Circuit, warn: *List(u8), unimplemented: *bool) Ty(List(Component.Gate), i64) = {
    pos_key :: fn(a: Vec2) i64 = bit_cast_unchecked(Vec2, i64, a);
    
    // all the places wires connect (to a component or to other wires). 
    wire_positions: HashMap(i64, *WireId) = init(temp());
    enumerate c.wires& { wire_i, new |
        continue :: local_return;
        new.logical = (id = wire_i.trunc());
        @if(new.path.len <= 1) continue();  // editor: deleted wire
        // the other nodes on the path are just for the visuals. 
        ends := @slice(new.path[0].pos, new.path[new.path.len - 1].pos);
        for ends { end_pos |
            found := wire_positions&.get_or_insert(pos_key(end_pos), => new.logical&);
            if new.logical.id != found.id {
                // when two graphical wires meet they become one logical wire.
                each c.wires.slice(0, wire_i + 1) { old |  // :SLOW
                    if old.logical.id == new.logical.id {
                        old.logical.id = found.id;
                    };
                };
            };
        };
    };
    
    logic_gates := Component.Gate.list(c.gates.len, a);
    next_wire_id: u32 = c.wires.len.trunc();
    enumerate c.gates& { gate_i, it |
        continue :: local_return;
        shape := get_builtin_shape(it.kind);
        out_arity, in_arity := get_arity(shape, it, circuits, warn);
        
        w := a.alloc_init(WireId, out_arity + in_arity, fn(_) => (id = 0xFFFFFFFF));
        
        no_pins := true;
        for_pins(shape, it, circuits) { i, dx, dy |
            continue :: local_return;
            no_pins = false;
            pos := it.pos + vec2(dx.float().cast(), dy.float().cast());
            if wire_positions&.get(pos_key(pos)) { g_wire |
                l_wire := c.wires[g_wire.id.zext()].logical;
                if i >= w.len {
                    continue();
                };
                w[i] = l_wire;
            };
        };
        
        allow_no_pins := !no_pins                // :notforcorrectness
            || shape.name == "LevelScreen"       // just visual in the campaign
            || shape.name.starts_with("Probe")   // not yet implemented
            || shape.name.starts_with("Buffer")  // does nothing?
            || shape.name == "Custom"            // might just be for a visual block
            || shape.name == "Custom_v2"         // "
            || shape.name == "_0"                // placeholder for editor deleted gate
            || shape.name == "Ram_v2"            // pins are on the ports
            || shape.name == "Delay_line_word_asm"
        ;
        if no_pins && !allow_no_pins {
            @fmtln(warn, "TODO: % has no pins", shape.name);
            unimplemented[] = true;
        };
        
        out, in := (w.slice(0, out_arity), w.rest(out_arity));
        second_output_is_unused := out.len >= 2 && out[1].id == 0xFFFFFFFF;
        
        disconnected := 0;
        enumerate w { i, id |
            if id.id == 0xFFFFFFFF {
                disconnected = disconnected.bit_or(1.shift_left(i));
            };
        };
        
        // see insert_consts_for_dead_wires()
        enumerate w { i, it |
            if it.id == 0xFFFFFFFF {
                it[] = (id = next_wire_id);
                next_wire_id += 1;
            }
        };

        logic_gates&.push(
            outputs = out,
            inputs = in,
            kind = it.kind,
            param = pack_param(circuits, c, it, gate_i, second_output_is_unused, unimplemented, warn),
        );
        
        new := logic_gates[logic_gates.len - 1]&;
        new.temporary_disconnected_pins_bitset = disconnected;
            if group(it.kind) == .Tc2 && it.settings.len > 0 {
                k := name(it.kind, .Tc2);
                new.temporary_bit_width_for_constant = it.settings[0];
                if it.settings[0] == MIN_i64 || @is(k, .Concatenator_2, .Concatenator_4, .Concatenator_8, .Static_eval, .Static_value, .Static_indexer_config, .Delay_line_word_config) {
                    new.temporary_auto_width = true;
                };
            };
    };
    
    (logic_gates, next_wire_id.zext())
};

pack_param :: fn(circuits: []Circuit, c: *Circuit, it: *Circuit.Gate, gate_i: i64, second_output_is_unused: bool, unimplemented: *bool, warn: *List(u8)) i64 = {
    shape := get_builtin_shape(it.kind);
    if !shape.has_param {
        if group(it.kind) == .Tc2 && name(it.kind, .Tc2) != .Custom_v2 && name(it.kind, .Tc2) != .Delay_line_word_config {
            if @is(name(it.kind, .Tc2), .Not_bit, .Or_bit, .And_bit, .Nand_bit, .Xor_bit, .Nor_bit, .Xnor_bit, .Switch_bit, .Delay_line_bit, .Register_bit, .Probe_wire_bit, .Full_adder, .Or_3_bit, .And_3_bit, .On_v2, .Off_v2) {
                return 1;
            };
            s0 := it.settings[0];
            @if(s0 != MIN_i64 && s0.ugt(64)) @fmtln(warn, "bad width % for % (in %)", s0, shape.name, c.name);
            return @if(s0 == MIN_i64, 0, s0);
        };
        return 0;
    };
    param := 0;
    @match(group(it.kind)) {
        fn Tc1() => {
            k := name(it.kind, .Tc1);
            s0, s1 := (it.settings&[0], it.settings&[1]);
            param = s0;
            #use(Builtin.Settings);
            big_pins := @is(k, .Ram, .RamLatency, .RamFast);
            if big_pins || @is(k, .RamDualLoad, .Program, .Rom) {
                if s1 > 3 && !big_pins {
                    @fmtln(warn, "% doesn't allow >64 bit data width index=%", shape.name, s1);
                    it.settings&[1] = 3;
                    s1 = 3;
                };
                s: Ram = construct(storage_size = s0, word_size_index = s1, is_program = int(shape.name.starts_with("Program")));
                if k != .Program {
                    s&.set(.storage_size, s.get(.storage_size).align_to(s.word_size()) / s.word_size());
                };
                if k == .Rom {
                    size := s.get(.storage_size) * s.word_size();
                    @if(size > it.data.len) @fmtln(warn, "TODO: rom file too large for storage");
                    @if(size < it.data.len) @fmtln(warn, "TODO: rom file too small for storage");
                    it.data.len = min(size, it.data.len).max(0);
                };
                
                param = s.repr.bitcast();
            };
            if k == .Console {
                s: Console = construct(colour = s0, font = s1, linked = 0);
                param = s.repr.bitcast();
            }
            if k == .Halt {
                s: Builtin.Settings.Halt = construct(
                    gate_i = gate_i,
                    circ_i = ptr_diff(circuits.ptr, c),
                );
                param = s.repr.bitcast();
            };
            if k == .Mul64 {
                @if(!second_output_is_unused && query_current_arch() == .wasm32) @fmtln(warn, "TODO: mul64 high wasm");
                s: Builtin.Settings.Mul64 = construct(need_high = int(!second_output_is_unused));
                param = s.repr.bitcast();
            }
        };
        fn Tc2() => {
            k := name(it.kind, .Tc2);
            
            // TODO: check length and error
            s := it.settings;
            @match(k) {
                fn Static_indexer() => {
                    @if(s.len < 3) return(0);
                    width, shift := (s[0], s[2]);
                    @if(width == MIN_i64) @fmtln(warn, "auto width static indexer?");
                    s: Builtin.Settings.StaticIndex = construct(width = width, shift = shift.abs(), left = int(shift < 0), valid = 1);
                    param = s.repr.bitcast();
                }
                fn Segment_display() => {
                    param = 0;  // v2 no colour
                }
                fn Constant() => {
                    @if(s.len < 3) return(0);
                    param = s[2];
                    if s[0].ult(64) {
                        // ex. if you type -1 in the box but set the width lower you dont get 64 1s
                        param = param.bit_and(1.shift_left(s[0]) - 1);
                    };
                }
                fn Keyboard_v2() => {
                    param = s[2];
                }
                fn Maker_bit_2() => maker(2, 2);
                fn Maker_bit_4() => maker(4, 4);
                fn Maker_word_2() => maker(s[0], 2);
                fn Maker_word_4() => maker(s[0], 4);
                fn Maker_word_8() => maker(s[0], 8);
                fn Ram_v2() => {
                    @if(s.len < 3) return(0);
                    s: Builtin.Settings.Ram_v2 = construct(
                        init = @if(s.len <= 6, 0, s[6]), // InitDataKind
                        little_endian = s[5],
                        ram_size_bytes = @if(s[1] == 0, 256, s[1].clamp(0, 1.shift_left(40))),
                    );
                    param = s.repr.bitcast();
                }
                fn Static_value() => { param = it.link_id; }
                fn Halt_v2() => {
                    s: Builtin.Settings.Halt = construct(
                        gate_i = gate_i,
                        circ_i = ptr_diff(circuits.ptr, c),
                    );
                    param = s.repr.bitcast();
                };
                @default => {
                    if @is(k, .Splitter_word_8, .Splitter_word_4, .Splitter_word_2, .Less_s, .Asr, .Clz, .Ctz) {
                        param = @if(s[0] == MIN_i64, 0, s[0]);
                    };
                    if @is(k, .Splitter_bit_8, .Splitter_bit_4, .Splitter_bit_2) {
                        param = 1;
                    };
                    if is_port(it.kind) {
                        p: Builtin.Settings.Port = (repr = 0);
                        if s[0] != 8 && s[0] != 16 && s[0] != 32 && s[0] != 64 {
                            @fmtln(warn, "% bad memory width: %", k, s[0]);
                            unimplemented[] = true;
                        };
                        p&.set(.width, s[0]);
                        param = p.repr.bitcast();
                    };
                };
            };
            maker :: fn(output_bit_width, n) => {
                if output_bit_width != MIN_i64 {
                    x := output_bit_width.udiv(n);
                    range(0, n) { i |
                        param = param.bit_or(x.shift_left(8*i));
                    };
                };
            };
        };
        @default => ();
    };
    param
}

fn assemble_v1(circuit: *Circuit, s: *Builtin.Settings.Ram, gate_i: i64, a: Alloc, warn: *List(u8)) void = {
    asm := circuit.programs.find(fn(it) => it.level_id == Circuit.Program.SANDBOX_LEVEL_ID && it.gate_index == gate_i) 
        || return(@fmtln(warn, "TODO: missing program assembly for gate[%]", gate_i));
    word_size := s[].word_size();
    if asm.assembled.is_none() {
        if asm.assembly { in |
            out := @ref u8.list(s[].get(.storage_size) * word_size, a);
            Tc'Asm'assemble(out, in, word_size, circuit.mnemonics, warn).or(fn(msg) => {
                @fmtln(warn, "failed to assemble (%): %", asm.name, msg);
                return();
            });
            asm.assembled = (Some = out.items());
        };
    };
};

CONST_INDEX :: get_component_by_name("Constant", builtin_components);

// TODO: save the index in param now that i call for_pins in the editor
fn find_custom_impl(g_gate: *Circuit.Gate, circuits: []Circuit) ?*Circuit = {
    if circuits.find(fn(it) => it.id == g_gate.custom_id) { child |
        if child.compiled { child_id |
            return(Some = child);  // will also have computed pin locations
        }
    };
    .None
}

fn get_arity(shape: *Builtin.Template, gate: *Circuit.Gate, circuits: []Circuit, warn: *List(u8)) Ty(i64, i64) = {
    @if(shape.body != .Custom) return(shape.out_arity, shape.in_arity);
    child := find_custom_impl(gate, circuits) || {
        @fmtln(warn, "TODO: custom component missing from dependencies?? %", gate.custom_id.id);
        return(0, 0);
    };
    child.arity
}

fix_pin_position :: fn(p: Vec2) Ty(i64, i64) = {
    OFF :: 256*256;  // idk dont fuck with negative numbers
    x, y := (p.x.cast().int() + OFF, p.y.cast().int() + OFF);
    x = (x.align_to(8) - OFF)/8;
    y = (y.align_to(8) - OFF)/8;
    (x, y)
}

fn for_pins(shape: *Builtin.Template, gate: *Circuit.Gate, circuits: []Circuit, $body: @Fn(pin_index: i64, dx: i64, dy: i64) void) void = {
    pins := shape.pins;
    dx, dy := (0, 0);
    if shape.body == .Custom {
        child := find_custom_impl(gate, circuits)
            || return();
            // dont crash because find_pins is called even if unimplemented=true for missing dependency
            //|| @panic("TODO: custom component missing from dependencies?? %", gate.custom_id.id);
        pins = child.pins;
        
        // TODO: i don't understand why this is part of the gate not the component or why 15 is the magic number but it makes the ones i've tested look right so here we are. 
        p := gate.mystery_spice_minus_fifteen_for_custom_pins;
        child.cached_pin_radius.p = p;  // editor uses this when placing custom component. TODO: calculate something sane myself for when i let you make new CCs
        dx = p.x.cast().int() + 15;
        dy = p.y.cast().int() + 15;
    };
    
    rot: i64 = gate.rotation.zext();
    i := 0;
    for pins { x, y |
        skip := x == HACK_NONE_PIN_POSITION;
        x += dx; y += dy;  // TODO: before or after rotation?
        range(0, rot) { _ |
            t := x; x = -y; y = t; // counter clockwise 90 deg around (0, 0)
        };
        if !skip {
            body(i, x, y);
        };
        i += 1;
    };
}

// TODO: what if a bidirectional pin is given too big a value?
fn insert_bit_width_casts(components: []Component, gates: *List(Component.Gate), wire_count: *i64, bit_width: []u8, warn: *List(u8), c: *Circuit, logical_to_circuit: []i64, circuits: []Circuit) []u8 = {
    has_bidirectional_pins := c.has_bidirectional_pins;
    a := gates.gpa;
    cast_id: ComponentId = (id = trunc(component_offset(.Tc2) - 1));
    @debug_assert_eq(components[cast_id.id.zext()].name, "SyntheticCast_FR");
    width := @ref u8.list(a);
    width_known: DynamicBitSet = empty(temp());
    width.push_repeated(wire_count[], 0);
    outputs, inputs := (gates[gates.len - 1].inputs, gates[0].outputs);
    known := outputs.len + inputs.len == bit_width.len;
    error_wires: DynamicBitSet = empty(temp());
    @if(!known) @fmtln(warn, "TODO: missing some io sizes? %+%!=%", outputs.len, inputs.len, bit_width.len);
    original_output_index := gates.len - 1;
    // TODO: need to be tracking width_known seperately earlier because Cc_output is supposed to transmit static values (including 0)
    @if(known)
    enumerate inputs { i, id |
        x := bit_width[i + outputs.len];
        width[id.id.zext()] = x;
        if x != 0 {
            width_known&.set(id.id.zext());
        };
        
    };
    
    // before schedule gates so won't be in order
    range(1, original_output_index) { gate_i |
        continue :: local_return;
        gate := gates.index(gate_i);
        bit_width := get_bit_width(components, gate);
        c := components[gate.kind.id.zext()]&;
        name := c.name;
        o_n, i_n := c.arity();
        if bit_width.len != o_n + i_n {
            @if(!gate.temporary_auto_width) @fmtln(warn, "TODO: missing widths for %", name);
            continue();
        };
        enumerate gate.outputs { i, id |
            // multiple switches of different sizes might ouput to the same wire
            width[id.id.zext()] = max(bit_width[i], width[id.id.zext()]);
            width_known&.set(id.id.zext());
        };
    };
    
    work := infer_auto_width(components, gates.items(), width.items(), c, logical_to_circuit, width_known&, circuits, warn);
    @if(!has_bidirectional_pins) for work { i |
        // TODO: report the dependency chain of wires in a readable way
        @fmtln(warn, "failed to infer width of % (in %)", components[gates[i].kind.id.zext()].name, c.name);
    };
    
    K :: Ty(WireId, u8);
    ::AutoEq(K); ::AutoHash(K, TrivialHasher);
    casts: HashMap(K, WireId) = init(temp());
    
    maybe_cast :: fn(want: u8, id: *WireId, gate) => {
        break :: local_return;
        found := width[id.id.zext()];
        if !has_bidirectional_pins {
            @if(!width_known&.get(id.id.zext()) && !error_wires&.get_set(id.id.zext())) @fmtln(warn, "TODO: unknown wire size w% (for %)", id.id, components[gate.kind.id.zext()].name);
        };
        if want < found && want != 0 {
            old := id[];
            if get(casts&, (old, want)) { new |
                id[] = new;
                break();
            };
            
            new: WireId = (id = wire_count[].trunc());
            wire_count[] += 1;
            width.push(want);
            id[] = new;
            // @fmtln(warn, "cast % => % (want=%, found=%)", old.id, new.id, want, found);
            casts&.insert((old, want), new);
            width_known&.set(new.id.zext());
            gates.push(
                kind = cast_id,
                inputs = a.alloc_init(WireId, 1, fn(_) => old),
                outputs = a.alloc_init(WireId, 1, fn(_) => new),
                param = want.zext(),
            );
        }
    };
    
    range(1, original_output_index) { gate_i |
        continue :: local_return;
        gate := gates.index(gate_i);
        bit_width := get_bit_width(components, gate);
        @if(bit_width.len == 0) continue();
        gate := gate[];
        enumerate gate.inputs { i, id |
            maybe_cast(bit_width[i + gate.outputs.len], id, gate);
        };
        
        // TODO: rotate needs to wrap at the right bit
        if !has_bidirectional_pins && group(gate.kind) == .Tc2 && @is(name(gate.kind, .Tc2), .Not_word, .Xnor_word, .Nor_word, .Nand_word, .Neg, .Add, .Mul, .Div, .Mod, .Inc, .Lsl, .Rol, .Ror, .Asr) {
            want := bit_width[0];
            if want != 0 && want != 64 {
                new: WireId = (id = wire_count[].trunc());
                wire_count[] += 1;
                width.push(want);
                gates.push(
                    kind = cast_id,
                    inputs = a.alloc_init(WireId, 1, fn(_) => new),
                    outputs = a.alloc_init(WireId, 1, fn(_) => gates[gate_i].outputs[0]),
                    param = want.zext(),
                );
                gates[gate_i].outputs[0] = new;
            };
        };
    };
    
    @if(known)
    enumerate outputs { i, id |
        maybe_cast(bit_width[i], id, gates[original_output_index]&);
    };
    
    gates.items().swap(original_output_index, gates.len - 1);
    @debug_assert_eq(components[gates[gates.len - 1].kind.id.zext()].name, "output");
    
    // :InferCc_output
    @if(known) enumerate outputs { i, id |
        bit_width[i] = width[id.id.zext()];
    };
    
    width.items()
}

infer_auto_width :: fn(components: []Component, gates: []Component.Gate, width: []u8, c: *Circuit, logical_to_circuit: []i64, width_known: *DynamicBitSet, circuits: []Circuit, warn: *List(u8)) []i64 = {
    work := @ref i64.list(temp());
    range(1, gates.len - 1) { i |
        it := gates[i]&;
        if group(it.kind) == .Tc2 && it.temporary_auto_width && it.param == 0 {
            work.push(i);
        };
    };

    dowhile {
        changed := false;
        unordered_retain(work) { gate_i |
            continue :: local_return;
            gate := gates.index(gate_i[]);
            k := name(gate.kind, .Tc2);
            // the ones configurable by static pins don't care about the runtime pin widths. 
            // TODO: there are more like this ex. mux/add have a 1 bit pin that doesnt matter
            skip := @if(@is(k, .Delay_line_word_config, .Static_indexer_config), 1, 0);
            for gate.inputs.rest(skip) { id |
                @if(!width_known.get(id.id.zext())) continue(true);
            };
            param := 0; 
            
            if @is(k, .Splitter_word_8, .Splitter_word_4, .Splitter_word_2) {
                param = width[gate.inputs[0].id.zext()].zext().align_to(gate.outputs.len).div(gate.outputs.len);
            };
            
            if @is(k, .Maker_word_2, .Maker_word_4, .Maker_word_8) {
                x: u8 = 0;
                enumerate gate.inputs { i, id |
                    x = max(x, width[id.id.zext()]);
                };
                x = trunc(min(x.zext() * gate.inputs.len, 64) / gate.inputs.len);
                range(0, gate.inputs.len) { i |
                    param = param.bit_or(x.zext().shift_left(8*i));
                };
            };
            
            if @is(k, .Concatenator_2, .Concatenator_4, .Concatenator_8) {
                // disconnected input pins contribute zero bits of width, not one. 
                enumerate gate.inputs { i, id |
                    if gate.temporary_disconnected_pins_bitset.bit_and(1.shift_left(i + 1)) == 0 {
                        param = param.bit_or(width[id.id.zext()].zext().shift_left(8*i));
                    };
                };
                if param == 0 {
                    // no pins at all defaults to 2 for some reason. i dont make the rules man.
                    param = 2;
                    // TODO: one 1 bit pin also does this (but that pin needs to be the 2 bit one)
                };
            };
            
            @match(k) {
                fn Static_eval() => {
                    @debug_assert(gate_i[].ult(logical_to_circuit.len), "aaa");
                    expression := find_static_eval_expression(circuits, c, logical_to_circuit, gate_i[], gate, components) || {
                        @fmtln(warn, "didnt find inlined thing for static_eval");
                        continue(true);
                    };
                    (A: i64, B: i64) := (width[gate.inputs[0].id.zext()].zext(), width[gate.inputs[1].id.zext()].zext());
                    R := Tc'Asm'static_eval_expression(A, B, expression).or(fn(msg) => {
                        @fmtln(warn, "failed to evaluate (%): %", expression, msg);
                        continue(true);
                    });
                    p: Builtin.Settings.StaticValue = construct(value = R, valid = 1);  // :NonZeroParam
                    param = p.repr.bitcast();
                }
                fn Static_value() => panic("after being inlined, temporary_auto_width=false so won't get here");
                fn Static_indexer_config() => {
                    (s: i64, w: i64) := (width[gate.inputs[1].id.zext()].zext(), width[gate.inputs[2].id.zext()].zext());
                    p: Builtin.Settings.StaticIndex = construct(width = w, shift = s, left = 0, valid = 1 /* zero param means not done */);
                    param = p.repr.bitcast();
                }
                fn Delay_line_word_config() => {
                    param = width[gate.inputs[1].id.zext()].zext();
                }
                @default => ();
            };
            
            shape := get_builtin_shape(gate.kind);
            @if(param == 0) if !shape.has_param || @is(k, .Less_s, .Asr, .Clz, .Ctz) {
                x: u8 = 0;
                enumerate gate.inputs { i, id |
                    x = max(x, width[id.id.zext()]);
                };
                param = x.zext();
            };
            
            if param != 0 {
                gate.param = param;
                changed = true;
                bit_width := get_bit_width(components, gate);
                enumerate gate.outputs { i, id |
                    width[id.id.zext()] = max(bit_width[i], width[id.id.zext()]);
                    width_known.set(id.id.zext());
                };
            };
            
            param == 0
        };
        changed
    };
    
    work.items()
};

// TODO: set_initial_data needs to do something similar to this
find_static_eval_expression :: fn(circuits: []Circuit, c: *Circuit, logical_to_circuit: []i64, gate_i: i64, gate: *Component.Gate, components: []Component) ?Str = {
    gi := logical_to_circuit[gate_i];
    if gi != -1 {
        return(Some = c.gates[gi].data.items());
    };
    gate_i := (); logical_to_circuit := ();
    
    loop {
        if gate.inline_record == 0xFFFFFFFF {
            eprintln("find_static_eval_expression: this should be unreachable");
            return(.None);
        };
        
        source_gate_i := c.inlined[gate.inline_record].gate_i;
        source_kind := c.gates[source_gate_i].kind;
        source := circuits.find(fn(it) => it.compiled.is_some() && it.compiled.Some == source_kind) 
            || return(.None);
        // :SLOW
        if source.gates.find(fn(it) => it.logical_gate_index == gate.inline_index.zext()) { g_gate |
            return(Some = g_gate.data.items());
        };
        
        c = source;
        logical := components[source_kind]&;
        gate = logical.gates[gate.inline_index.zext()]&;
    };
};

// this can't be in find_pins because it has to be after bidirectional components are inlined
insert_consts_for_dead_wires :: fn(components: []Component, gates: *List(Component.Gate), cc_outputs: []WireId) void = {
    original_output_index := gates.len - 1;
    a := gates.gpa;
    wire_read: DynamicBitSet = empty(temp());
    wire_write: DynamicBitSet = empty(temp());
    each gates { gate |
        for gate.inputs { id |
            wire_read&.set(id.id.zext());
        };
        for gate.outputs { id |
            wire_write&.set(id.id.zext());
        };
    };
    
    for cc_outputs { id |  // bidirectional
        wire_write&.set(id.id.zext());
    };
    
    // wires connected to an input but going nowhere are treated the same as if the pin was disconnected (auto zero)
    for wire_read& { i |  // TODO: logical operations on these bit sets
        if !wire_write&.get(i) {
            gates.push(
                outputs = a.alloc_init(WireId, 1, fn(_) => (id = i.trunc())),
                inputs = empty(),
                kind = CONST_INDEX,
                param = 0,
                // disconnected wire is 0 width for auto components
                // TODO: this might make temporary_disconnected_pins_bitset redundant
                temporary_bit_width_for_constant = 0,  
            );
        };
    };
    
    gates.items().swap(original_output_index, gates.len - 1);
    @debug_assert_eq(components[gates[gates.len - 1].kind.id.zext()].name, "output");
}

fn get_bit_width(components: []Component, it: *Component.Gate) []u8 = {
    if @is(it.kind.group(), .Tc1, .Tc2) {
        if it.temporary_auto_width && it.param == 0 {
            return empty();
        };
        shape := get_builtin_shape(it.kind);
        r := get_bit_width(shape, it.param);
        
        if group(it.kind) == .Tc2 {
            k := name(it.kind, .Tc2);
            if k == .Constant && it.temporary_bit_width_for_constant.ule(64) {
                r[0] = it.temporary_bit_width_for_constant.trunc();
            };
            if @is(k, .Maker_word_2, .Maker_word_4, .Maker_word_8) {
                // if output didnt divide pin count, input sizes round down but output size remembers the requested one. 
                r[0] = max(r[0], it.temporary_bit_width_for_constant.trunc());
            };
            if k == .Static_value && it.temporary_auto_width {
                // before being inlined, param=link_id (non-zero) but don't know width yet. 
                @debug_assert_eq(it.inline_record, 0xFFFFFFFF);
                return empty();
            };
        };
        return r;
    };
    kind: i64 = it.kind.id.zext();
    @if(components[kind].usage.is_null()) return(empty());
    return components[kind].bit_width;
}

fn get_bit_width(shape: *Tc.Builtin.Template, param: i64) []u8 = {
    if group(shape.kind) == .Tc2 {
        break :: local_return;
        k := name(shape.kind, .Tc2);
        @if(k == .Cc_output) return(empty());
        r := temp().alloc_init(u8, shape.pins.len, fn(_) => param.trunc());
        
        if k == .Constant {
            // TODO: this is wrong if i try to use it for the static eval width math
            r[0] = @if(param == 0, 1, 64 - param.leading_zeros().trunc());
            return r;
        };
        
        if @is(k, .Or_word, .And_word, .Xor_word, .Delay_line_word, .Probe_wire_word, .Clz, .Ctz) {  // all same
            return r;
        };
        
        if @is(k, .Not_word, .Xnor_word, .Nor_word, .Nand_word, .Neg, .Mul, .Div, .Mod, .Inc) {
            return r;
        };
        
        if @is(k, .Lsl, .Lsr, .Rol, .Ror, .Asr) {  // one input is smaller
            up_pow2 :: fn(w: i64) i64 = {
                n := 63 - w.leading_zeros();
                @if(1.shift_left(n) == w, w, 1.shift_left(n + 1))
            };
            wrap := up_pow2(r[0].zext()).trailing_zeros();
            if wrap != 64.trailing_zeros() {
                r[2] = wrap.trunc();
            };  // else: the instruction already does mod 64 so dont need to truncate
            return r;
        };
        
        if @is(k, .Equal, .Less_u, .Less_s) {  // bool out
            r[0] = 1;
            return r;
        };
        
        if is_port(shape.kind) {
            param: Builtin.Settings.Port = (repr = param.bitcast());
            w: u8 = param.get(.width).trunc();
            if @is(k, .Store_port) {
                r.copy_from(@slice(0x01, 64, w));
            } else {
                r.copy_from(@slice(w, 1, 64));
            };
            return r;
        };
        
        if @is(k, .Maker_bit_2, .Maker_bit_4, .Maker_word_2, .Maker_word_4, .Maker_word_8, .Concatenator_2, .Concatenator_4, .Concatenator_8) {
            total := 0;
            range(0, r.len-1) { i |
                w := param.shift_right_logical(i*8).bit_and(0xff);
                r[i+1] = w.trunc();
                total += w;
            };
            r[0] = total.min(64).trunc();
            return r;
        };
        
        @match(k) {
            fn Add() => {
                r[1] = 1;  // carry out
                r[2] = 1;  // carry in
            };
            fn Mux() => { r[1] = 1; };
            fn Counter() => { r[2] = 1; };
            fn Switch_word() => { r[2] = 1; };
            fn Level_input_switched() => { r[1] = 1; };
            fn Register_word() => { r[1] = 1; };
            fn Splitter_word_2() => { r[2] *= 2; }
            fn Splitter_word_4() => { r[4] *= 4; }
            fn Splitter_word_8() => { r[8] *= 8; }
            fn Static_indexer() => {
                p: Builtin.Settings.StaticIndex = (repr = param.bitcast());
                r.copy_from(@slice(@as(u8) p.get(.width).trunc(), 0x40));
            }
            fn Static_eval() => {
                r.copy_from(@slice(0x40, param.trunc(), 0x40, 0x40));
            }
            fn Static_value() => {
                r.copy_from(@slice(0x40, param.trunc()));
            }
            fn Static_indexer_config() => {
                p: Builtin.Settings.StaticIndex = (repr = param.bitcast());
                r.copy_from(@slice(@as(u8) p.get(.width).trunc(), 0x40, 0x40, 0x40));
            }
            fn Delay_line_word_config() => {
                r[2] = 0x40;
            }
            @default => break();
        };
        return r;
    };

    if !shape.has_param || group(shape.kind) != .Tc1 {
        return shape.bit_width;
    };
    k := name(shape.kind, .Tc1);
    special := @const_slice(GateName(.Tc1).RamFast, .Ram, .RamDualLoad, .Program, .Rom);
    @if(k == .SyntheticCast_FR) return(@slice(@as(u8) param.trunc(), 0x40) temp());  // can see this while inserting casts after inlining a custom component. 
    if special.contains(fn(x) => x[] == k) {
        // :SpecialOutputBitWidth
        // inputs don't matter because writes truncate in the impl so oversized 64 bits from get_width_data is fine.
        // outputs would be fine oversized but doing it right here avoids inserting useless casts. 
        param: Builtin.Settings.Ram = (repr = param.bitcast());
        size: u8 = param.word_size().mul(8).min(64).trunc();
        out := shape.bit_width.shallow_copy(temp());
        range(0, shape.out_arity) { i |
            out[i] = size;
        };
        return out;
    };
    shape.bit_width
}

// #alias(tc'init)
// this only does the ones with explicit starting values. caller must world.storage.set_zeroed() first for the rest. 
set_initial_data :: fn(world: *World, circuits: []Tc.Circuit, root: ComponentId, instance: i64) void = {
    c := world[root]&;
    world.tc_halt_device = -1;
    @if(c.storage_count == 0 || c.gates.len == 0) return();
    circuit := circuits.find(fn(it) => it.compiled.is_some() && it.compiled.Some.id == root.id) || return();
    
    // TODO: this needs to work for inlined CCs so children will have logical in parent but no graphical and source will have graphical but no logical
    instance_base := instance;
    enumerate circuit.gates { c_gate_i, c_gate |
        continue :: local_return;
        gate_i := c_gate.logical_gate_index;
        @if(gate_i == -1) continue();
        gate := c.gates[gate_i]&;
        instance := instance + c.instance_offset_by_gate[gate_i];
        
        @if(group(gate.kind) == .Loaded)
        set_initial_data(world, circuits, gate.kind, instance);  // might be a rom inside a custom component
        
        if group(gate.kind) == .Tc2 && name(gate.kind, .Tc2) == .Ram_v2 {
            p := gate.get_param(.Ram_v2)[];
            init_kind := @as(InitDataKind) @as(i64) p.get(.init);
            dest := world.storage.rest(instance).interpret_as_bytes().slice(0, p.get(.ram_size_bytes));
            if init_kind != .Zeroes {
                n := min(dest.len, c_gate.data.len);
                dest.slice(0, n).copy_from(c_gate.data.slice(0, n));
            };
            
            if init_kind == .Assembler {
                if circuit.programs.find(fn(it) => it.level_name == "campaign/sandbox" && it.assembled.is_some() && it.gate_index == c_gate_i) { asm |
                    asm := asm.assembled.unwrap();
                    n := min(dest.len, asm.len);
                    dest.slice(0, n).copy_from(asm.slice(0, n));
                } else {
                    @println("TODO: missing program assembly for gate[%]", gate_i);
                };
            };
            
            i := c_gate.port_linked_list;
            while => i != -1 {
                port := circuit.gates[i]&;
                @debug_assert(port.kind.is_port(), "expected port");
                @debug_assert_eq(get_storage_count(world.components, c.gates[port.logical_gate_index]&), 1);
                port_instance := instance_base + c.instance_offset_by_gate[port.logical_gate_index];
                world.storage[port_instance] = instance;
                i = port.port_linked_list;
            };
            
            continue();
        };
        
        if group(gate.kind) == .Tc2 && name(gate.kind, .Tc2) == .Screen {
            data := world.storage.rest(instance).interpret_as_bytes().peek_type(Builtin.ScreenData);
            ram_graphical_i := c_gate.port_linked_list;
            @if(ram_graphical_i == -1) continue();
            ram_logical_i := circuit.gates[ram_graphical_i].logical_gate_index;
            data.ram_instance = instance_base + c.instance_offset_by_gate[ram_logical_i];
            data.ram_size_bytes = c.gates[ram_logical_i]&.get_param(.Ram_v2)[].get(.ram_size_bytes);
            data.foreground_colour = 0xff;
            data.resolution = 256;
            continue();
        };
        
        @if(group(gate.kind) != .Tc1) continue();
        n := get_storage_count(world.components, gate);
        dest := world.storage.subslice(instance, n);
        src := @match(gate.kind.name(.Tc1)) {
            fn Rom() => c_gate.data.items();
            fn Program() => {
                asm := circuit.programs.find(fn(it) => it.level_id == Tc.Circuit.Program.SANDBOX_LEVEL_ID && it.assembled.is_some() && it.gate_index == c_gate_i) 
                    || continue(@println("TODO: missing program assembly for gate[%]", gate_i));
                asm.assembled.unwrap()
            };
            fn Console() => {
                data := dest.interpret_as_bytes().peek_type(Builtin.ConsoleData);
                ram_graphical_i := c_gate.port_linked_list;
                @if(ram_graphical_i == -1) continue();
                ram_logical_i := circuit.gates[ram_graphical_i].logical_gate_index;
                data.ram_instance = instance_base + c.instance_offset_by_gate[ram_logical_i];
                param := c.gates[ram_logical_i]&.get_param(.Ram)[];
                data.ram_size_bytes = param.get(.storage_size) * param.word_size();
                continue()
            }
            @default => continue();
        };
        dest.interpret_as_bytes().slice(0, src.len).copy_from(src);
    };
}

fn get_pin_radius(gate: *Circuit.Gate, circuits: []Circuit) f32 = {
    shape := get_builtin_shape(gate.kind);
    @if(shape.body != .Custom) return(shape.pin_radius);
    c := find_custom_impl(gate, circuits) || return(1.0/0.0);
    p := gate.mystery_spice_minus_fifteen_for_custom_pins;
    if c.cached_pin_radius.r >= 0 && c.cached_pin_radius.p == p {
        return c.cached_pin_radius.r;
    };
    r: f32 = 0;
    for_pins(shape, gate, circuits) { _, x, y |
        r = max(r, norm_sq(vec2(x.float().cast(), y.float().cast())));
    };
    r := r.sqrt();
    c.cached_pin_radius = (r = r, p = p);
    r
}

// it's used in function name when compiled so important not to let a circuit be named "x :: evil(); y"
safe_name :: fn(name: Str, a: Alloc) Str = {
    // (first char isn't special because mangle() has a prefix) TODO: could do that here as well and store a sepreate display name and code name. 
    valid_in_ident :: fn(c: u8) bool = c.is_ascii_alpha() || c.is_ascii_digit() || c == "_".ascii();
    if !name.contains(fn(it) => !it[].valid_in_ident()) {
        return name;
    };
    mangled_name := u8.list(name.len, a);
    for name { c |
        if valid_in_ident(c) {
            mangled_name&.push(c);
        } else {
            // this is a bit dumb because it could technically collide with another name but that would at least be a compile error not something insane. 
            @fmt(mangled_name&, "%", fmt_hex(c));
        };
    };
    mangled_name.items()
};

name_from_path :: fn(path: Str) Str = {
    name := path;
    name = name.pop_path_segment();  // circuit.data
    prefix := name.pop_path_segment();
    name = @if(name.ends_with("/"), name.slice(0, name.len - 1), name);
    d := "/Default";
    if name.ends_with(d) {
        name = name.slice(0, name.len - d.len);
        prefix = name.pop_path_segment();
    };
    name = name.rest(prefix.len);
    name
};

collect_schematics :: fn(tc_save_root: Str, a: Alloc) List(Str) = {
    files := Str.list(a);
    dirs := Str.list(temp());
    tc_save_root.len -= int(tc_save_root.ends_with("/"));
    dirs&.push(@tfmt("%/architecture", tc_save_root));
    dirs&.push(@tfmt("%/component_factory", tc_save_root));
    dirs&.push(@tfmt("%/foundry", tc_save_root));
    while => dirs&.pop() { s |
        _ := (walk_directory_unordered(as_cstr s) { e |
            continue :: local_return;
            if e.is(.Directory) {
                @if(e.name.starts_with(".")) continue();
                dirs&.push(@tfmt("%/%", s, e.name));
                continue();
            };
            if e.name == "circuit.data" {
                files&.push(@afmt(a, "%/%", s, e.name));
            };
        });
    };
    
    files
}

GateGroup :: @enum(u8) (LogicalIO, Tc1, Tc2, Loaded);
group_sizes :: @const_slice(
    2,
    get_constants(Type.scope_of(Builtin.impl)).len(),
    get_constants(Type.scope_of(Builtin.impl2)).len(),
);
fn group(it: ComponentId) GateGroup = {
    i: i64 = it.id.zext();
    end := 0;
    inline_range(0, group_sizes.len()) { $j |
        end += @run group_sizes[j];
        if i < end {
            return @as(GateGroup) @as(u8) j.trunc();
        };
    };
    .Loaded
}

gate_name :: name;
fn name(it: ComponentId, $g: GateGroup) GateName(g) #generic = {
    @debug_assert_eq(it.group(), g, "name(ComponentId) wrong group");
    i: i64 = it.id.zext();
    start, end := (0, 0);
    inline_range(0, group_sizes.len()) { $j |
        start = end; 
        end += @run group_sizes[j];
        if g == @as(GateGroup) @as(u8) j.trunc() {
            return @as(GateName(g)) @as(u16) trunc(i - start);
        };
    };
    zeroed(GateName(g))
}

fn GateName($g: GateGroup) Type #fold = @run {
    G := @match(g) {
        fn Tc1() => enum_from_scope_names(Builtin.impl);
        fn Tc2() => enum_from_scope_names(Builtin.impl2);
        @default => void;
    };
    if g != .Loaded {
        const_eval(void, @{ ::enum_derive(@[@literal G]); });
    };
    G
}

fn component_offset(g: GateGroup) i64 #fold = {
    start := 0;
    inline_range(0, group_sizes.len()) { $j |
        G :: @as(GateGroup) @as(u8) j.trunc();
        @if(G == g) return(start);
        start += @run group_sizes[j];
    };
    start
}

enum_from_scope_names :: fn(S: Type) Type = {
    names := get_constants(Type.scope_of(S));
    @assert_lt(names.len, 0xffff, "TODO: too many components");
    create_sequential_enum(u16, names.len, fn(i) => names[i])
}

fn get_builtin_shape(it: ComponentId) *Builtin.Template = {
    g := it.group();
    templates;
    Builtin'templates2;
    @match(g) {
        fn Loaded() => return(templates[@as(i64) zext(@as(u16) GateName(.Tc1).Custom)]);;
        fn Tc1() => templates[it.id.zext() - component_offset(.Tc1)];
        fn Tc2() => Builtin'templates2[it.id.zext() - component_offset(.Tc2)];
        @default => @panic("get_builtin_shape(%, %) invalid", g, it.id);
    }
}

SettingName :: enum_from_scope_names(Builtin.Settings);
SettingType :: fn(N: SettingName) Type #fold = {
    ::enum_derive(@type N);
    get_constant(Type, Type.scope_of(Builtin.Settings), N.name_str().sym()).unwrap()
}
fn get_param(gate: *Component.Gate, $N: SettingName) *SettingType(N) #generic = {
    bit_cast_unchecked(*i64, *SettingType(N), gate.param&)
}

fn is_placeholder(kind: ComponentId) bool =  // for deleting in editor
    group(kind) == .Tc1 && Tc'gate_name(kind, .Tc1) == ._0; 

fn height_of_port(k: GateName(.Tc2)) f32 = @match(k) {
    fn Ram_v2() => -7;
    fn Store_port() => 3;
    fn Load_port() => 2;
    fn Pipelined_load_port() => 2;
    @default => 0;
};
    
InitDataKind :: @enum(Zeroes, Assembler, PunchCard, File, HexEditor, Persistent);  // order matters

// https://github.com/Stuffe/save_monger/blob/22fa398d95c3d3a0b5e88a80e9daee613cab1823/versions/v6.nim CC0
// version=6 is non-save_breaker 0.1059 beta, 
// the lastest version of that repo has the old vN files as though they would still be correct but they're super not because they changed all the component numbers on the commit for v2.1.77 
load_circuit :: fn(in: Str, arena: Alloc, name: Str) Result(Circuit, Str) = {
    a := arena;  // want an arena because leak on error
    version := in[0];
    @if(version != 6 && version != 15 && version != 14 && version != 13 && version != 16) return(Err = @tfmt("only tc circuit.data version [6,13,14,15,16] is supported (found %)", version));
    v2 := version != 6;
    in = in.rest(1);
    
    out := @ref u8.list(temp());
    consumed_bytes, ok := decompress(in, out);
    @if(!ok) return(Err = "failed to decompress");
    @if(in.len != consumed_bytes) return(Err = "extra junk on the end of the file");
    in := out.items();
    
    gates := list(Circuit.Gate, a);
    wires := list(Circuit.Wire, a);
    
    i := 0;
    eat :: fn($T: Type) => {
        @if(i + size_of(T) > in.len) fail("malformed");
        t := in.rest(i).peek_type(T)[];
        i += size_of(T); 
        t
    };
    eatN :: fn($I: Type, $T: Type) => {
        n: i64 = eat(I).int() * size_of(T);
        @if(i + n*size_of(T) >= in.len) fail("malformed");
        t := T.reinterpret_bytes(in.subslice(i, n));
        i += n;
        t
    };
    eat_point :: fn() => {
        x, y := (eat(i16), eat(i16));
        vec2(x.intcast().float().cast(), y.intcast().float().cast())
    };
    fail :: fn(s) => return(Err = s);
    
    circuit_id := eat(CustomId); 
    eat(u32); eat(i64); eat(i64); eat(bool);
    
    // v1: the game ui lets you ask for as slow as 0.1hz (10 seconds per tick), so the number in the save file is scaled by 10
    tick_rate := @if(v2, eat(i64) / 1000, eat(u32).zext() / 10);
    dependencies := eatN(u16, CustomId);
    eatN(u16, u8);  // description
    if !v2 {
        eat_point();
    };
    eat(u8);
    if !v2 {
        eat(bool);
    };
    eat(u16);
    eatN(u16, u8);  // player data
    eatN(u16, u8);  // hub description
    
    if v2 {
        range(0, 32) { x |
            range(0, 16) { y |
                eat(u8);  // design
            };
        };
    };
    
    min_pos, max_pos := (vec2(65000), vec2(-65000));
    
    gate_count := eat(i64);
    gates&.reserve(gate_count);
    programs := Circuit.Program.list(a);
    range(0, gate_count) { gate_index |
        kind := eat(u16);
        pos := eat_point();
        rotation := eat(u8);
        id := eat(i64);
        user_label := "";
        if version >= 15 {
            user_label = eatN(u16, u8);
        };
        custom_string := eatN(u16, u8);
        old_custom_string := @const_slice(@as(u16) 87, 94, 101, 46);  //  halt,static_eval,static_indexer,constant
        if v2 && version < 15 && !old_custom_string.contains(kind){
            user_label = custom_string;
            custom_string = "";
        };
        custom_id: CustomId = (id = -1);
        custom_pos := zeroed(Vec2);
        if !v2 {
        s1 := eat(i64);
        s2 := eat(i64);
        _ := eat(i16);
        
        // TODO: get the enum from ./builin.fr
        if kind == 92 {  // Custom
            custom_id = eat(CustomId);
            custom_pos = eat_point();
            @if(custom_id.id == id) return(Err = "recursive custom component");
        };
        if kind == 94 || kind == 68 || kind == 64 {  // Program
            n := eat(u16);
            range(0, n.zext()) { _ |
                key := eat(i64);
                name := eatN(u16, u8).shallow_copy(a);
                programs&.push(level_id = key, name = name, gate_index = gate_index, gate_link_id = id);
            };
            
            if s1 == 0 {  // i guess it gets a default if you don't set it manually in the game?
                s1 = 256;  
            }
        };
        xx := @as(i64) kind.zext();
        if xx >= GateName(.Tc1).enum_count() {
            return(Err = @tfmt("gate[%] has OOB kind=%", gate_index, kind));
        };
        
        if kind > GateName(.Tc1).enum_count().trunc() {
            return(Err = "gate oob");
        }
        
        gates&.push(
            rotation = rotation,
            custom_id = custom_id,
            kind = (id = kind.zext() + component_offset(.Tc1).trunc()),
            pos = pos,
            settings = shallow_copy(@slice(s1, s2), a),
            data = custom_string.shallow_copy(a).as_raw_list(),
            mystery_spice_minus_fifteen_for_custom_pins = custom_pos, 
            link_id = id,
        );
        } else {
                settings := eatN(u16, i64);
                buffer_size := eat(i64);
                eat(i16);  // ui order
                word_size := eat(i64);
                is_immutable := eat(bool);
                if version >= 14 {
                    // gate/delay variant
                    eat(i64); eat(i64);
                };
                is_little_endian := eat(bool);
                init_data_kind := eat(u8);
          
                n_watched := eat(u16);
                watched := @ref Circuit.Watched.list(a);
                range(0, n_watched.zext()) { _ |
                    id := eat(i64);
                    inner_id := eat(i64);
                    name := eatN(u16, u8).shallow_copy(a);
                    offset := eat(i64);
                    word_size := eat(i64);
                    watched.push(id=id,inner_id=inner_id,name=name,offset=offset,word_size=word_size);
                };
                program_count := eat(u16);
                range(0, program_count.zext()) { _ |
                    key := eatN(u16, u8).shallow_copy(a);
                    value := eatN(u16, u8).shallow_copy(a);
                    programs&.push(level_name = key, name = value, gate_index = gate_index, gate_link_id = id);
                };
                
                s := @ref i64.list(settings.len+2+int(kind == 118)*2, a);
                s.push(word_size);
                s.push(buffer_size);
                s.push_all(settings);
                
                if kind == 118 { // com_ram
                    if settings.len != 3 {
                        @eprintln("TODO: un-hardcode endien/init index when setting param and in field editor");
                    };
                    s.push(int(is_little_endian));
                    s.push(int(init_data_kind));
                };
                
                if kind == 78 { // com_custom
                    custom_id = eat(CustomId);
                    // static values
                    n := eat(u16);
                    range(0, n.zext()) { _ |
                        id := eat(CustomId);
                        bits := eat(i64);
                        s.push(id.id);
                        s.push(bits);
                    };
                };
                
                if kind > GateName(.Tc2).enum_count().trunc() {
                    return(Err = "gate oob");
                }
                
                gates&.push(
                    rotation = rotation,
                    custom_id = custom_id,
                    kind = (id = kind.zext() + trunc(component_offset(.Tc2))),
                    pos = pos,
                    settings = s.items(),
                    data = custom_string.shallow_copy(a).as_raw_list(),
                    mystery_spice_minus_fifteen_for_custom_pins = vec2(-15), 
                    link_id = id,
                    label = user_label.shallow_copy(a).as_raw_list(),
                    watched = watched.items(),
                );
                
                if kind == 91 {  // screen
                    max_pos = max(max_pos, pos + vec2(4, 3)*6.5);
                };
        };
        
        min_pos = min(min_pos, pos);
        max_pos = max(max_pos, pos);
    };
    
    directions :: @const_slice(vec2(1,0), vec2(1,1), vec2(0,1), vec2(-1,1), vec2(-1,0), vec2(-1,-1), vec2(0,-1), vec2(1,-1));
    wire_count := eat(i64);
    wires&.reserve(wire_count);
    range(0, wire_count) { _ |
        if !v2 {
            kind := eat(u8);
        };
        colour := eat(u8);
        comment := eatN(u16, u8);
        
        pos := eat_point();
        path := Circuit.WireNode.list(a);
        path&.push(pos = pos, direction = vec2(0), length = 0);
        
        if !v2 {
        segment := eat(u8);
        length := segment.bit_and(0b0001_1111);
        if segment == 0b0010_0000 {
            // this is a "teleport wire". can't place it in the game but other programs that write save files can cheat on the layout.
            pos := eat_point();
            path&.push(pos = pos, direction = vec2(0), length = 0);
            length = 0;
        };
        
        while => length != 0 {
            direction := directions[segment.zext().shift_right_logical(5)];
            len: i64 = length.zext();
            prev := path[path.len-1]&;
            prev.direction = direction;
            prev.length = len;
            path&.push(pos = prev.pos + direction*len.float().cast(), direction = vec2(0), length = 0);
            
            segment = eat(u8);
            length = segment.bit_and(0b0001_1111);
        };
        };
        if v2 {
            break :: local_return;
            loop {
                segment := eat(u16);
                direction := segment.shift_right_logical(13);
                direction := directions[direction.zext()];
                length := segment.bit_and(0b00011111_11111111);
                if length == 0 {
                    break();
                };
                len: i64 = length.zext();
                prev := path[path.len-1]&;
                prev.direction = direction;
                prev.length = len;
                path&.push(pos = prev.pos + direction*len.float().cast(), direction = vec2(0), length = 0);
            };
        };
        // non-version 16 has path reversed but i dont think direction matters?
        
        @if(path.len == 1) return(Err = "bad wire path length?");
        wires&.push(path = path.as_raw(), teleport = path[0].length == 0, comment = comment.shallow_copy(a), colour = colour);
        
        for path { it |
            min_pos = min(min_pos, it.pos);
            max_pos = max(max_pos, it.pos);
        };
    };
    @if(i != in.len) fail("extra junk at the end");
    (Ok = (
        wires = wires.as_raw(), 
        gates = gates.as_raw(), 
        id = circuit_id,
        min = min_pos, max = max_pos,
        dependencies = dependencies.shallow_copy(a).as_raw_list(),
        name = name,
        programs = programs.items(),
        default_tick_rate = tick_rate,
        v2 = v2,
    ))
}

#use("@/graphics/vec.fr");

// https://raw.githubusercontent.com/google/snappy/27ab5f7f518430a021239bc26a5b2fd64affbc7b/format_description.txt
decompress :: fn(in: []u8, out: *List(u8)) Ty(i64, bool) = {
    #use("@/lib/encoding/leb128.fr");
    n, r, ok := read_leb128_unsigned(in);
    @if(!ok) return(0, false);
    i := in.len - r.len;
    decompressed_size: i64 = n.bitcast();
    @if(decompressed_size < 0) return(0, false); // 2^63 bytes ought to be enough for anyone
    out.reserve(decompressed_size);
    start := out.len;
    while => out.len - start < decompressed_size {
        continue :: local_return;
        @if(i + 1 > in.len) return(i, false);
        tag_byte := in[i]; i += 1;
        tag := tag_byte.bit_and(0b11);
        upper: i64 = tag_byte.zext().shift_right_logical(2);
        length, offset := @switch(tag) {
            @case(0b00) => {  // 2.1. 
                len := if upper < 60 {
                    upper + 1
                } else {
                    len_length := upper - 60 + 1;
                    @if(i + len_length > in.len) return(i, false);
                    len := 0;
                    range(0, len_length) { j |
                        len += in[i].zext().shift_left(8*j); i += 1;
                    };
                    len + 1
                };
                
                @if(i + len > in.len) return(i, false);
                @if(out.len - start + len > decompressed_size) return(i, false);
                out.push_all(in.subslice(i, len)); i += len;
                continue();
            };
            @case(0b01) => {  // 2.2.1.
                len := upper.bit_and(0b111) + 4;
                upper := upper.shift_right_logical(3);
                offset := upper.shift_left(8).bit_or(in[i].zext()); i += 1;
                (len, offset)
            };
            @case(0b10) => {  // 2.2.2. 
                @if(i + 2 > in.len) return(i, false);
                offset: i64 = peek_type(in.rest(i), u16)[].zext(); i += 2;
                (upper + 1, offset)
            };
            @case(0b11) => {  // 2.2.3. 
                @if(i + 4 > in.len) return(i, false);
                offset: i64 = peek_type(in.rest(i), u32)[].zext(); i += 4;
                (upper + 1, offset)
            };
            @default => unreachable();
        };
        @if(offset > out.len - start) return(i, false);
        @if(out.len - start + length > decompressed_size) return(i, false);
        @if(offset == 0) return(i, false);
        dest := out.len;
        src := dest - offset;
        out.len += length;
        // note: the copy is allowed to overlap the new bytes it writes.  
        range(0, length) { i |  
            out[dest + i] = out[src + i];
        };
    };
    (i, true)
};
