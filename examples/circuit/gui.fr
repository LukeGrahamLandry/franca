gate_selection_columns :: {
    t :: Tc.Builtin.templates;
    a := ast_alloc();
    poly := @const_slice("And", "Or", "Not", "Nand", "Xor", "Nor", "Xnor", "Switch", "DelayLine", "Input", "Output", "OutputZ", "Bidirectional", "Constant", "Maker", "Splitter", "Mux", "Add", "Neg", "Mul", "DivMod", "Equal", "LessI", "LessU", "Shl", "Shr", "Ashr", "Rol", "Ror", "Register", "Counter");
    columns := a.alloc_init(RawList(i64), 6, fn(_) => empty());
    seen := zeroed(StaticBitSet(t.len()));
    for poly { name |
        if t.index_of(fn(it) => it.name == name || it.name == @tfmt("%1", name)) { j |
            columns[0]&.push(j, a);
            seen&.set(j);
        };
        range(0, 4) { i |
            size := 1.shift_left(i) * 8;
            if Tc.Builtin.templates.index_of(fn(it) => it.name == @tfmt("%%", name, size)) { j |
                columns[i+1]&.push(j, a);
                seen&.set(j);
            };
        };
    };
    
    no := @const_slice("NoteSound", "SyntheticCast_FR", "LevelScreen", "LevelOutput1Sum", "LevelOutput1Car", "LevelInput1", "LevelOutput1");
    enumerate t { j, it |
        if !seen&.get(j) && !no.contains(it.name) && !@is(it.body, .Unimplemented, .Custom) {
            columns[5]&.push(j, a);
        }
    };
    
    columns
};

gate_selection_columns_v2 :: {
    T :: Tc'GateName(.Tc2);
    @const_slice(
    @const_slice(T.Not_bit, .Or_bit, .And_bit, .Nand_bit, .Xor_bit, .Nor_bit, .Xnor_bit, .Switch_bit, .Delay_line_bit, .Register_bit, .Probe_wire_bit, .Full_adder, .Or_3_bit, .And_3_bit, .On_v2, .Off_v2, .Splitter_bit_2, .Splitter_bit_4, .Splitter_bit_8, .Maker_bit_2, .Maker_bit_4, .Maker_bit_8),
    @const_slice(T.Not_word, .Or_word, .And_word, .Nand_word, .Xor_word, .Nor_word, .Xnor_word, .Switch_word, .Delay_line_word, .Register_word, .Probe_wire_word, .Counter, .Constant, .Mux),
    @const_slice(T.Equal, .Less_u, .Less_s, .Add, .Inc, .Neg, .Mul, .Div, .Mod, .Lsl, .Lsr, .Rol, .Ror, .Asr),
    @const_slice(T.Ram_v2, .Load_port, .Store_port, .Time, .Screen, .Halt_v2, .Keyboard_v2, .Segment_display, .Push_button, .Level_gate), 
    @const_slice(T.Static_indexer, .Decoder_1, .Decoder_2, .Decoder_3, .Splitter_word_2, .Splitter_word_4, .Splitter_word_8, .Maker_word_2, .Maker_word_4, .Maker_word_8, .Concatenator_2, .Concatenator_4, .Concatenator_8),
    @const_slice(T.Static_indexer_config, .Static_eval, .Static_value, .Cc_input, .Cc_output, .Level_output_switched, .Level_input_switched),
    )
};

RollingAverage :: @struct(history: RawDeque(i64), sum := 0);
fn push(self: *RollingAverage, new: i64) void = {
    if self.history&.len() == self.history&.capacity() {
        old := self.history&.pop_front().unwrap();
        self.sum -= old;
    };
    self.sum += new;
    self.history&.push_back(new, panicking_allocator);
}
fn clear(self: *RollingAverage) void = {
    self.history&.clear();
    self.sum = 0;
}
fn get(self: *RollingAverage) i64 = 
    self.sum / max(1, self.history&.len());

