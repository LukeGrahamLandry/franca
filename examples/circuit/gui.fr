
FEAT_PNG :: true;

HELP :: """
left drag or wasd: move. scroll: zoom.
right click: enter a gate.
escape: exit to previous gate. 
enter: evaluate one tick. 
space: toggle auto eval.
r: restart program. 
c: reset scale/pos.
[/]: slower/faster eval (shift:50, cmd:1000). 
k+shift+cmd: toggle keyboard device capture.
u: toggle render graphics devices over circuit
n: select builtin architecture (overture, leg).
l: fetch schematic archive.
e: toggle edit mode.
""";

State :: @rec @struct {
    HIGH_DPI :: true;
    text: Sdtx.Self;
    draw: Sgl.Self;
    pipe: Sgl.Pipeline;
    pos: Vec2;
    scale: f32;
    sg: *Sg.Self;
    sapp: *Sapp.Self;
    dirty: bool;
    mouse_pos: Vec2;
    world: World;
    tree: List(CircuitNode);
    clicked: bool;
    want_eval: bool;
    auto_eval: bool;
    ticks_per_eval: i64;
    sim: LevelApi.Simulation;
    level: *LevelApi.Exports;
    levels: List(*LevelApi.Exports);
    tick: i64;
    halt_message: List(u8);
    show_wire_ref_lines: bool;
    pan_keys_pressed: i64;
    key_buffer: RawDeque(@struct(key: Sapp.Keycode, up: bool, shift: bool));
    keyboard_device_focused: bool;
    gfx_error_last_frame: bool;
    halted_without_wire_values: bool;
    keyboard_data: ?*Tc.Builtin.KeyboardData;
    keyboard_character_mode: bool;
    
    circuit: []Tc.Circuit;
    circuit_index: i64;
    circuit_arena: Arena.Allocator;
    current_jitted_source: Str;
    load_time: i64;
    warnings: List(u8);
    loader: LoaderT;
    download_schematic_archive_before_trying_to_load: bool;
    prev_timestamp_us: i64;
    frame_time_history: RawDeque(i64);
    frame_time_history_sum: i64;
    eval_last_frame: bool;
    split_graphics_and_wires: bool;
    atlas: @struct {
        data: @struct(pixels: []u32  /*general_allocator, free after loading on ui thread*/, w: i64, h: i64);
        uvs: RawHashMap(i64, Ty(Vec2, Vec2, Vec2));  // SpriteDisplay.param -> (uv1, uv2, size_pixels)
        img: Sg.Image;
        enable: bool;
    };
    edit: EditState;
};

CircuitNode :: @struct {
    diagram_circuit: ?i64 = .None;  // index in state.circuit
    logical_gate: ?i64 = .None;  // index in previous component
    component: ?ComponentId = .None;
    saved := zeroed(@struct(pos: Vec2, scale: f32));
};

LevelApi :: import("@/examples/circuit/level_api.fr");

main_use_output :: fn(state: *State, in: LoaderT.I, out: Result(void, void)) void = {
    if state.tree.len > 0 && state.tree[0].diagram_circuit.is_some() {
        c := state.circuit[state.tree[0].diagram_circuit.Some]&; 
        state.tree[0].component = c.compiled;
    };
    state.reset();
    state.find_keyboard();
    
    if out&.is(.Err) {
        // recompiled for exiting edit mode but current_jitted_source didn't change so didnt call worker_get_output
        // barely helps because wire ids change if you did anything at all but doesn't hurt
        return();
    };
    
    state.load_atlas_part2(state.sg);
    state.load_time = timestamp() - state.loader.start_time;
}

do_eval :: fn(state: *State) void = {
    world := state.world&;
    state.halt_message&.clear();
    state.want_eval = false;
    prev_timestamp := state.prev_timestamp_us;
    this_timestamp := realtime_us();
    state.prev_timestamp_us = this_timestamp;
    delta_time := this_timestamp - prev_timestamp;
    if state.eval_last_frame {
        if state.frame_time_history&.len() == state.frame_time_history&.capacity() {
            old_delta_time := state.frame_time_history&.pop_front().unwrap();
            state.frame_time_history_sum -= old_delta_time;
        };
        state.frame_time_history_sum += delta_time;
        state.frame_time_history&.push_back(delta_time, panicking_allocator);
        // TODO: could also use this to throttle the tick rate down so don't drop frames if the circuit is too big. 
    } else {
        delta_time = 16 * US_PER_MS;
        prev_timestamp = this_timestamp - delta_time;
    };
    
    count := @if(state.auto_eval, state.ticks_per_eval, 1);
    root_component := state.tree[0].component.unwrap();
    o_n, i_n := world[root_component]&.arity();
    values := temp().alloc_zeroed(i64, o_n + i_n);
    range(0, count) { i |
        // the idea here is to spread the times evenly instead of all the ticks being grouped together each frame with 16ms gaps.
        clock := prev_timestamp + delta_time*i/count;
        world.timestamp_us = (Some = clock);
        
        state.service_keyboard_device();
        state.tick += 1;
        
        if values.len != 0 {
            state'level'before(state.level.userdata, values);
        };
        
        save_wire_values := i == count - 1;
        state.halted_without_wire_values = !save_wire_values;
        evaluate(world, values, root_component, 0, save_wire_values);
        
        if world.tc_halt_device != -1 {
            return do_halt(state);
        };
        
        if values.len != 0 {
            win := state'level'after(state.level.userdata, values);
            if win {
                @fmt(state.halt_message&, "solved in % ticks", state.tick);
                state.auto_eval = false;
                return();
            }
        };
    };
};

do_halt :: fn(state: *State) void = {
    world := state.world&;
    param: Tc.Builtin.Settings.Halt = (repr = world.tc_halt_device.bitcast());
    msg := state.circuit[param.get(.circ_i)].gates[param.get(.gate_i)].data;
    @fmt(state.halt_message&, "halted after % ticks: %", state.tick, msg);
    world.tc_halt_device = -1;
    state.auto_eval = false;
};

fn on_render(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    state.check_movement();
    if state.auto_eval && !state.edit.enable {
        state.dirty = true;
    };
    if Easy'should_skip_frame(sapp, state.dirty&) {
        state.eval_last_frame = false;
        return();
    };
    sdtx := state.text.default_context&;
    sgl := state.draw&;
    need_draw := false;
    
    state.loader&.check();
    if state.loader.progress != .Idle {
        in := state.loader.in.unwrap();
        name := @match(in) {  // TODO: this is a race. can tear
            fn Path(it) => it.path;
            fn Index(it) => state.circuit[it.root_index].name;
        };
        t := timestamp() - state.loader.start_time;
        msg := @tfmt("compiling %\nit's been % ms\nif you can read all this it's too slow!", name, t);
        if t > 50 {  // dont flicker for a frame when exiting exit mode without changes
            show_alert(msg, sdtx, sapp);
        };
        state.dirty = true;
    };
    
    world := state.world&;
    have_logic := state.loader.progress == .Idle && state.tree.len > 0 && state.tree[0].component.is_some() 
        && world[state.tree[0].component.Some].gates.len > 2  // HACK for load unimplemented
        && !state.edit.enable;
    eval_this_frame := have_logic && (state.want_eval || state.auto_eval);
    
    if eval_this_frame {
        do_eval(state);
    };
    state.eval_last_frame = eval_this_frame;
    
    app_w, app_h := (sapp.width().float().cast(), sapp.height().float().cast());
    screen_scale := vec2(500 * sapp.dpi_scale) / vec2(app_w, app_h);
    self: Draw = (
        state = state, 
        screen_scale = screen_scale,
        sdtx = sdtx,
        have_logic = have_logic,
        mouse_world_pos = (state.mouse_pos - state.pos) / state.scale / screen_scale,
        out = @ref u8.list(32, temp()),
    ); self := self&;
    
    if state.gfx_error_last_frame {
        show_alert("TOO MANY VERTICES", sdtx, sapp);
    };
    
    sdtx.desc.char_height = 10 * state.scale;
    sdtx.desc.char_width = sdtx.desc.char_height / 2;
    
    text_scale := 1.0 / sapp.dpi_scale;
    text_w, text_h := (app_w * text_scale, app_h * text_scale);
    sdtx.canvas(text_w, text_h);
    
    self.text_spacing = {
        a := self.text_to_world_pos(vec2(0, 0)); 
        b := self.text_to_world_pos(vec2(1, 1));
        c := abs(b - a);
        vec2(c.x, c.y * 1.5)
    };
    
    self.put_text(self.text_spacing * vec2(0, 3), pack_rgba(255, 255, 255, 255)) { out |
        if state.edit.enable {
            @fmt(out, "edit mode (press e to exit); right click to select/place. space to rotate. backspace to delete.");
        } else {
        frame_time := state.frame_time_history_sum / max(1, state.frame_time_history&.len());
        @fmt(out, "(paused=%, tick_rate=%, tick=%, keyboard=%, frame_time=%ms) ", 
            !state.auto_eval, state.ticks_per_eval, state.tick, state.keyboard_device_focused, frame_time/1000);
        @if(state.load_time != 0) @fmt(out, "load_time=%ms", state.load_time);
        };
    };
    if !state.edit.enable {
    self.put_text(HELP, self.text_spacing * vec2(-90, 12), pack_rgba(0, 0, 0, 255));
    } else {
        self.gate_selection();
    };
    
    if self.arch_selection() { i |
        state.clicked = false;
        state.dirty = true;
        have_logic = false;
        state.warnings&.clear();
        load_circuit_index_async(state, i, state.world.tc_file_loader_device);
    };
    
    if have_logic {
        root_component := state.tree[0].component.unwrap();
        c := world[root_component]&;
        instance, parent_wire_offset, wire_offset := self.walk_component_tree(c&);
        
        if !state.halted_without_wire_values {
            @debug_assert(world.scratch.len >= wire_offset + c.wire_count, "misconfigured scratch");
            self.wires = world.scratch.items().subslice(wire_offset, c.wire_count);
            self.logical = (Some = c);
        };
        if state.show_wire_ref_lines {
            self.all_wire_positions = temp().alloc_zeroed(RawList(Vec2), c.wire_count);
        };
        
        self.draw_component_code(c, instance, parent_wire_offset);
        
        // TODO: more sane way of doing positioning
        state'level'render(state.level.userdata);
        s := vec2(self.text_spacing.x, self.text_spacing.x*2);
        each state.sim.text& { it |
            self.put_text(it.msg, it.pos * s, it.c);
        };
        state.sim.text&.clear();
    };
    
    if state.halt_message.len != 0 {
        self.put_text(state.halt_message.items(), self.text_spacing * vec2(0, 4), pack_rgba(50, 200, 150, 255));
    };
    
    if self.level_selection() { it |
        state.dirty = true;
        state.level = it;
        if it.solutions.len != 0 {
            // TODO: dont just delete your circuits. etc.
            state.load_path_async(it.solutions, true);
        } else {
            state.reset();
        };
    };
    
    sgl.defaults();
    sgl.viewport(0, 0, app_w, app_h, true);
    if state.atlas.enable {
        sgl.load_pipeline(state.pipe);
        sgl.texture(state.atlas.img, (id = 0));
        sgl.texturing_enabled = true;
        sgl.u = 0; sgl.v = 0;  // :WhitePixelForDrawingSolidColours
    };
    sgl.begin(.QUADS);
    sgl.load_identity();
    sgl.translate(state.pos.x, state.pos.y, 0.0);
    sgl.scale(state.scale * screen_scale.x, state.scale * screen_scale.y, 1.0);
    
    @if(state.tree.len > 0)
    if state.tree[state.tree.len - 1].diagram_circuit { circuit_i |
        need_draw = true;
        circuit := state.circuit[circuit_i]&;
        self.draw_circuit_background(circuit);
        self.draw_gate_squares(circuit);
        self.draw_wires(circuit);
        self.draw_pin_lines(circuit);
        self.update_edit(circuit, state.circuit);
    };
    
    if self.hovered_wire_index { wire, position_index |
        need_draw = true;
        positions := self.all_wire_positions[wire.id.zext()];
        a := self.text_to_world_pos(positions[position_index]);
        for positions { b |
            b := self.text_to_world_pos(b);
            sgl.color = pack_rgba(255, 255, 255, 255);
            sgl.line(a, b, 0.005);
        };
    };

    @if(state.tree.len == 1 || state.split_graphics_and_wires)
    if have_logic && state.tree[0].diagram_circuit.is_some() {
        need_draw = true;
        circuit := state.circuit[state.tree[0].diagram_circuit.unwrap()]&;
        // TODO: allow console in custom component too (use last element in the tree and offset by its base instance)
        c := world[state.tree[0].component.unwrap()]&;
        if state.split_graphics_and_wires {
            self.diagram_pos += self.tc_to_world_pos(vec2(0, 0)) - self.tc_to_world_pos(vec2(0, abs(circuit.max.y - circuit.min.y)));
        };

        sdtx.desc.char_height /= 1.5;
        sdtx.desc.char_width /= 1.5;
        sdtx.canvas(text_w, text_h);
        
        each circuit.gates { gate |
            continue :: local_return;
            i := gate.logical_gate_index;
            @if(i == -1) continue();
            it := c.gates[i]&;
            
            // TODO: all these need to know the thing's rotation
            @if(it.kind.group() == .Tc1)
            @match(it.kind.name(.Tc1)) {
                fn Console() => self.console(gate, c, i, it);
                fn SegmentDisplay() => self.segment_display(gate, c, i, it);
                fn DotMatrixDisplay() => self.dot_matrix_display(gate, c, i, it);
                fn SpriteDisplay() => self.sprite_display(gate, c, i, it);
                @default => ();
            };
            @if(it.kind.group() == .Tc2)
            @match(it.kind.name(.Tc2)) {
                fn Segment_display() => self.segment_display(gate, c, i, it);
                fn Screen() => self.screen(gate, c, i, it);
                @default => ();
            };
        };
    };
    
    sgl.end();
    
    gfx_error := sdtx.vertices.len == sdtx.vertices.cap || sgl.error.any;
    state.dirty = state.dirty || gfx_error != state.gfx_error_last_frame;
    state.gfx_error_last_frame = gfx_error;
    
    state.clicked = false;
    Easy'glue_begin_pass(sapp, sg, ClearAction(r = 0.15, g = 0.15, b = 0.15, a = 1));
    @if(need_draw) sgl.draw_layer(sg, 0);
    sdtx.draw_layer(0);
    sg.end_pass();
    sg.commit();
};

Draw :: @struct {
    state: *State #use;
    diagram_pos: Vec2 = vec2(0);
    screen_scale: Vec2;
    sdtx: *Sdtx.Context;
    have_logic: bool;
    all_wire_positions: []RawList(Vec2) = empty();
    hovered_wire_index: ?Ty(WireId, i64) = .None;
    mouse_world_pos: Vec2;
    wires: []WireValue = empty();
    wire_value_colour: Array(u32, 2) = (pack_rgba(150, 150, 255, 255), pack_rgba(255, 0, 150, 255));
    out: *List(u8);
    text_spacing := vec2(0);
    wire_node_width: f32 = 0.025;
    wire_hover_count: f32 = 1;
    logical: ?*Component = .None;
};

fn do_option(self: *Draw, pos: Vec2, name: Str, selected: bool, value: ~T, new: *?T) void #where = {
    sdtx, state := (self.sdtx, self.state);
    sdtx.pos = self.world_to_text_pos(self.text_spacing * pos);
    p := self.world_to_text_pos(self.mouse_world_pos);
    hover := p.x > sdtx.pos.x && p.x < sdtx.pos.x + name.len.float().cast() && p.y > sdtx.pos.y && p.y < sdtx.pos.y + 1;
    sdtx.color = pack_rgba(200, 200*int(!selected), 200*int(!hover), 255);
    sdtx.put(name);
    if hover && state.loader.progress == .Idle && state.clicked&.take() {
        new[] = (Some = value);
    };
}

fn arch_selection(self: *Draw) ?i64 = {
    state := self.state;
    new: ?i64 = .None;
    arch_list_count: f32 = 0;
    selected_circuit := @if(state.tree.len == 0, -1, state.tree[0].diagram_circuit || -1);
    // TODO: list them from the save dir even if don't ask for a specific one on cli
    enumerate state.circuit { i, c |
        continue :: local_return;
        @if(!c.is_arch) continue();
        pos := vec2(0, (7 + arch_list_count));
        self.do_option(pos, c.name, i == selected_circuit, i, new&);
        arch_list_count += 1;
    };
    new
}

fn level_selection(self: *Draw) ?*LevelApi.Exports = {
    state := self.state;
    arch_list_count: f32 = 0;
    new: ?*LevelApi.Exports = .None;
    for state.levels { it |
        ::ptr_utils(@type it[]);
        selected := identical(it, state.level);
        pos := vec2(50, (7 + arch_list_count));
        self.do_option(pos, it.title, selected, it, new&);
        arch_list_count += 1;
    };
    new
}

fn walk_component_tree(self: *Draw, c: **Component) Ty(i64, i64, i64) = {
    state := self.state;
    instance, parent_wire_offset, wire_offset := (0, 0, 0);
    self.put_text(self.text_spacing * vec2(0, 1), pack_rgba(255, 255, 255, 255)) { out |
        for state.tree { it |
            if it.logical_gate { it |
                parent_wire_offset = wire_offset;
                wire_offset += c.wire_count;
                range(0, it) { i |
                    child := state.world&[c.gates[i].kind]&;
                    wire_offset += child.wire_sum;
                };
                @fmt(out, "%[%], ", c.name, it);
                instance += c.instance_offset_by_gate[it];
                c[] = state.world&[c.gates[it].kind]&;
            };
        };
        out.push_all(c.name);
    };
    (instance, parent_wire_offset, wire_offset)
}

fn draw_component_code(self: *Draw, c: *Component, instance: i64, parent_wire_offset: i64) void = {
    sdtx, state := (self.sdtx, self.state);
    pos := vec2(0, 0);
    if c.gates.len == 0 {
        p := self.mouse_world_pos;
        hover := p.y < pos.y && p.y > pos.y - self.text_spacing.y && p.x > 0 && p.x < 100;
        sdtx.origin = self.world_to_text_pos(vec2(0, 0));
        sdtx.pos = vec2(0);
        self.draw_primitive_code(instance, parent_wire_offset, hover);
        if state.clicked && hover {
            state.pop_tree_node();
            state.clicked = false;
        };
        sdtx.origin = vec2(0);
    };
    enumerate c.gates { i, it |
        p := self.mouse_world_pos;
        hover := p.y < pos.y && p.y > pos.y - self.text_spacing.y && p.x > 0 && p.x < 100;
        sdtx.pos = self.world_to_text_pos(pos);
        self.draw_gate_code(it, hover);
        pos.y -= self.text_spacing.y;
        
        if state.clicked && hover {
            state.open_gate((Some = i), .None, i == 0 || i == c.gates.len - 1);
        };
    };
};

fn draw_gate_code(self: *Draw, it: *Component.Gate, hover: bool) void = {
    sdtx, world := (self.sdtx, self.world&);
    base_colour := @if(hover, pack_rgba(0, 255, 0, 255), pack_rgba(255, 255, 0, 255));
    for(it.outputs, fn(it) => self.show_wire_value(it, false));
    sdtx.color = base_colour;
    child := world[it.kind]&;
    name := child.name;
    @if(it.outputs.len > 0) sdtx.put("= ");
    sdtx.put(@tfmt("%( ", name));
    if child.has_param {
        sdtx.color = self.wire_value_colour&[int(it.param != 0)];
        sdtx.put(@tfmt("% ", it.param));
    };
    for(it.inputs, fn(it) => self.show_wire_value(it, false));
    sdtx.color = base_colour;
    sdtx.put(");");
}

fn draw_primitive_code(self: *Draw, instance: i64, parent_wire_offset: i64, hover: bool) void = {
    sdtx, state, world, out := (self.sdtx, self.state, self.world&, self.out);
    
    sdtx.color = @if(hover, pack_rgba(0, 255, 0, 255), pack_rgba(255, 255, 0, 255));
    sdtx.put("output(intrinsic(input()));\n");
    
    @assert(self.have_logic && state.tree.len >= 2);
    parent_kind := state.tree[state.tree.len - 2].component.unwrap();
    gate_i := state.tree[state.tree.len - 1].logical_gate.unwrap();
    
    parent := world[parent_kind]&;
    it := parent.gates[gate_i]&;
    n := get_storage_count(world.components, it);
    if !state.halted_without_wire_values {
        // show callsite in the parent
        self.wires = world.scratch.items().subslice(parent_wire_offset, parent.wire_count);
        self.logical = (Some = parent);
        self.draw_gate_code(it, false);
        
        if is_linkable(it.kind) {
            if state.tree[state.tree.len - 2].diagram_circuit { c |
                c := state.circuit[c]&;
                // TODO: store graphical_gate: ?i64 in CircuitNode :SLOW
                if c.gates.index_of(fn(it) => it.logical_gate_index == gate_i) { i |
                    it := c.gates[i]&;
                    while => it.port_linked_list != -1 {
                        sdtx.put("\n> ");
                        it = c.gates[it.port_linked_list]&;
                        if it.logical_gate_index != -1 {
                            self.draw_gate_code(parent.gates[it.logical_gate_index]&, false);
                        };
                    };
                };
            };
        };
        
        self.wires = empty();
        self.logical = .None;
    };
    
    @if(n == 0 && !world[it.kind].has_param) return();
    
    // TODO: unpack `param` in a readable way
    sdtx.color = pack_rgba(255, 255, 255, 255);
    sdtx.put(@tfmt("\n(storage_count=%, instance=%, param=%)\n", n, instance, fmt_hex(it.param)));
    
    if state.tree[state.tree.len - 2].diagram_circuit { c |
        c := state.circuit[c]&;
        // TODO: store graphical_gate: ?i64 in CircuitNode :SLOW
        if c.gates.index_of(fn(it) => it.logical_gate_index == gate_i) { i |
            it := c.gates[i]&;
            if it.label.len != 0 {
                sdtx.put(it.label);
                sdtx.put("\n");
            };
        };
    };
    
    // show contents of the memory this gate owns
    data := world.storage.subslice(instance, n.min(4096)).interpret_as_bytes();
    enumerate data { i, c |
        @if(i.umod(16) == 0) sdtx.put("\n");
        push_hex_byte(out, c[], true);
        sdtx.put(out.items());
        sdtx.pos.x += 1;
        out.clear();
    };
}

fn show_wire_value(self: *Draw, id: WireId, force_hover: bool) = {
    sdtx, state, wires, out := (self.sdtx, self.state, self.wires, self.out);
    @if(!self.have_logic) return();
    i := id.id.zext();
    if state.show_wire_ref_lines && self.all_wire_positions.len != 0 {
        start := sdtx.pos;
        end := start + vec2(6, 1);
        p := self.world_to_text_pos(self.mouse_world_pos);
        hover := p.x > start.x && p.x < end.x && p.y > start.y && p.y < end.y;
        positions := self.all_wire_positions[i]&;
        // collecting all these is a bit unreasonably :SLOW but here we are. it's only when holding shift so maybe it's fine 
        positions.push(sdtx.pos, temp());
        if self.hovered_wire_index.is_none() && (hover || force_hover) {
            self.hovered_wire_index = (Some = (id, positions.len - 1));
        };
    };

    ok := i.ult(self.wires.len);
    value := @if(!ok, 0, self.wires[i]);
    sdtx.color = self.wire_value_colour&[int(value != 0)];
    sdtx.put(@tfmt("w%", id.id));
    sdtx.color = pack_rgba(150, 150, 150, 255);
    sdtx.put("=");
    if ok {
        c := self.logical.unwrap();
        bit_width: i64 = @if(i.ult(c.wire_bit_width.len), c.wire_bit_width[i].zext(), 64);
        if bit_width == 1 {
            @fmt(out, "%", value);
        } else {
            w := @if(bit_width == 0, 8, bit_width.ualign_to(8).udiv(8).min(8));
            for_rev i64.cast_to_bytes(value&).slice(0, w) { c |
                push_hex_byte(out, c, false);
            };
        };
    };
    sdtx.put(out.items());
    out.clear();
    sdtx.put(" ");
};

// TODO: still draw warnings if loaded 0 graphical circuits (ex. cli arg of circuit.data with bad version)
//       (better might be to do auto layout for the defs.fr and then always have a graphical circuit)
fn draw_circuit_background(self: *Draw, circuit: *Tc.Circuit) void = {
    sdtx, state, sgl := (self.sdtx, self.state, self.draw&);
    hi, lo := (circuit.max + vec2(1), circuit.min - vec2(1));
    size := abs(hi - lo);
    circuit_top_right := self.tc_to_world_pos(lo + vec2(size.x, 0));
    goal_top_right := self.text_spacing * vec2(-30, 2);
    self.diagram_pos = goal_top_right - circuit_top_right;
    
    if state.loader.progress == .Idle {
        self.put_text(state.warnings.items(), self.tc_to_world_pos(vec2(lo.x, hi.y + 5)), pack_rgba(255, 255, 255, 255));
    };
    
    {  // vaguely the grid for custom component pins
        grid_size :: 8;
        sgl.color = pack_rgba(40, 40, 40, 255);
        start := lo.x.cast().int().align_back(grid_size).float().cast();
        p := vec2(start, lo.y);
        while => p.x < hi.x {
            a, b := (self.tc_to_world_pos(p), self.tc_to_world_pos(p + vec2(0, size.y)));
            sgl.line(a, b, 0.01);
            p.x += grid_size.float().cast();
        };
        start := lo.y.cast().int().align_back(grid_size).float().cast();
        p := vec2(lo.x, start);
        while => p.y < hi.y {
            a, b := (self.tc_to_world_pos(p), self.tc_to_world_pos(p + vec2(size.x, 0)));
            sgl.line(a, b, 0.01);
            p.y += grid_size.float().cast();
        };
    };
    
    // border around the whole diagram
    a, b := (self.tc_to_world_pos(lo), self.tc_to_world_pos(hi));
    s := abs(a - b);
    w: f32 = 0.03;
    sgl.color = pack_rgba(20, 20, 20, 255);
    sgl.line(a, a + vec2(s.x, 0), w);
    sgl.line(a, a - vec2(0, s.y), w);
    sgl.line(b, a + vec2(s.x, 0), w);
    sgl.line(b, a - vec2(0, s.y), w);
    
    sdtx.color = pack_rgba(50, 200, 150, 255);
    sdtx.pos = self.world_to_text_pos(goal_top_right) + vec2(-circuit.name.len().float().cast(), -2);
    sdtx.put(circuit.name);
};

fn hovering_node(self: *Draw, b: Vec2) bool = {
    W, p := (self.wire_node_width, self.mouse_world_pos);
    p.y < b.y + W/2 && p.y > b.y - W/2 && p.x > b.x - W/2 && p.x < b.x + W/2
}

fn draw_gate_squares(self: *Draw, circuit: *Tc.Circuit) void = {
    sdtx, state, sgl, W := (self.sdtx, self.state, self.draw&, self.wire_node_width);
    e := state.edit&;
    had_hover := false;
    enumerate circuit.gates { g_gate_index, it |
        b := self.tc_to_world_pos(it.pos);
        hover := self.hovering_node(b) && e.no_selection();
        sgl.color = pack_rgba(100, 100, 100, 255);
        if hover {
            info := Tc'get_builtin_shape(it.kind);
            sgl.color = pack_rgba(200, 200, 200, 255);
            sdtx.color = pack_rgba(255, 255, 255, 255);
            name := info.display_name(it, state.circuit);
            sdtx.pos = self.world_to_text_pos(b) + vec2(0, self.wire_hover_count);
            base := sdtx.pos.x;
            sdtx.put(@tfmt("(%, %) %", it.pos.x, it.pos.y, name));
            if it.logical_gate_index != -1 {
                sdtx.put(@tfmt(" G%", it.logical_gate_index));
            };
            self.wire_hover_count += 1;
            had_hover = true;
            hover_gate(e, (Some = g_gate_index), circuit);
            
            if it.settings.len != 0 {
                sdtx.put(" [");
                each it.settings { s |
                    sdtx.put(@tfmt("%,", s));
                };
                sdtx.put("]");
            };
            
            if state.show_wire_ref_lines {
                sdtx.put(@tfmt(" %", it.link_id));
            };
            
            for (@slice(it.label)) { s |
                if s.len != 0 {
                    sdtx.pos.x = base;
                    sdtx.pos.y += 1;
                    sdtx.put(s);
                };
            };
            
            if state.clicked {
                if e.enable {
                    if e.no_selection() {
                        e.select_gate((Some = g_gate_index), circuit);
                        state.clicked = false;
                    };
                } else {
                    state.clicked = false;
                    state.open_gate(.None, (Some = g_gate_index), false);
                };
            };
        };
        sgl.line(b - vec2(0, W/2), b + vec2(0, W/2), W);
    };
    @if(!had_hover && e.selected_gate.is_none()) hover_gate(e, .None, circuit);
}

// TODO: dont like that sometimes the connecting lines are under or over the nodes. do two loops to be consistant
//       (can see the difference when hover so colour changes)
fn draw_wires(self: *Draw, circuit: *Tc.Circuit) void = {
    sdtx, sgl, W, state := (self.sdtx, self.draw&, self.wire_node_width, self.state);
    enumerate circuit.wires { wire_i, wire |
        teleport := wire.teleport;
        enumerate wire.path { i, it |
            sgl.color = pack_rgba(100, 50, 50 * int(!teleport), 255);
            b := self.tc_to_world_pos(it.pos);
            if i != 0 && !teleport {
                a := self.tc_to_world_pos(wire.path[i - 1].pos);
                sgl.line(a, b, W/2.5);
            };
            hover := self.hovering_node(b);
            @if(state.show_wire_ref_lines && wire.is_end(it.pos))
            if hover && state.edit.enable && state.edit&.no_selection() && state.clicked&.take() {
                state.edit.placing_wire_start = (Some = (wire_i, i));
            };
            this_hover := hover;
            if self.hovered_wire_index.is_some() && self.hovered_wire_index.Some._0.id == wire.logical.id && (i == 0 || i == wire.path.len - 1) {
                // TODO: these will be kinda useless because it doesn't reset wire_hover_count when for the next wire that's at a different x position. 
                hover = true;
            };
            // TODO: be able to hover the pin of a disconnected gate where there's no graphical wire to see value
            if hover {
                sgl.color = pack_rgba(200, 50, 50, 255);
                sdtx.pos = self.world_to_text_pos(b) + vec2(0, self.wire_hover_count);
                base := sdtx.pos.x;
                sdtx.color = pack_rgba(255, 255, 255, 255);
                sdtx.put(@tfmt("% (%, %) ", wire_i, it.pos.x, it.pos.y));
                if !circuit.has_bidirectional_pins {
                    @if(wire.logical.id != 0xFFFFFFFF) self.show_wire_value(wire.logical, true);
                };
                self.wire_hover_count += 1;
                
                if this_hover && wire.comment.len != 0 {
                    sdtx.color = pack_rgba(200, 200, 200, 255);
                    sdtx.pos = self.world_to_text_pos(b) + vec2(0, self.wire_hover_count);
                    self.wire_hover_count += 1;
                    sdtx.put(wire.comment);
                };
            };
            
            real := i == 0 || i == wire.path.len - 1;  // else: only for routing, can't connect to pins
            s: f32 = @if(real, 1, 0.6);
            sgl.line(b - vec2(0, W/2*s), b + vec2(0, W/2*s), W*s);
        };
    };
}

// TODO: seperate out all the hover and do it at the end
fn draw_pin_lines(self: *Draw, circuit: *Tc.Circuit) void = {
    sdtx, state, sgl, W := (self.sdtx, self.state, self.draw&, self.wire_node_width);
    @if(state.loader.progress == .Loading) return();
    
    each circuit.gates { it |
        a := self.tc_to_world_pos(it.pos);
        if it.port_linked_list.ult(circuit.gates.len) {
            b := self.tc_to_world_pos(circuit.gates[it.port_linked_list].pos);
            sgl.color = pack_rgba(143, 186, 255, 50);
            sgl.line(a, b, W/4);
        };
        
        info := Tc'get_builtin_shape(it.kind);
        for_pins(info, it, state.circuit) { i, dx, dy |
            b := self.tc_to_world_pos(it.pos + vec2(dx.float().cast(), dy.float().cast()));
            
            out_arity, in_arity := get_arity(info, it, state.circuit, @static u8.list(panicking_allocator));
            is_input := i >= out_arity;
            sgl.color = pack_rgba(0, 100 * int(in_arity + out_arity > 0), 100 * int(!is_input), 255);
            sgl.line(a, b, W/4);
            
            hover := self.hovering_node(b);
            if hover {
                sdtx.pos = self.world_to_text_pos(b) + vec2(0, self.wire_hover_count);
                sdtx.color = pack_rgba(255, 255, 255, 255);
                name := info.display_name(it, state.circuit);
                sdtx.put(@tfmt("% %[%]", name, @if(is_input, "in", "out"), @if(is_input, i - out_arity, i)));
                if it.logical_gate_index != -1 {
                    sdtx.put(@tfmt(" [%]", it.logical_gate_index));
                };
                self.wire_hover_count += 1;
            };
        };
    };
}

fn console(self: *Draw, gate: *Tc.Circuit.Gate, c: *Component, i: i64, it: *Component.Gate) void = {
    sdtx, world, sgl := (self.sdtx, self.world&, self.draw&);
    
    sdtx.pos = vec2(0);
    a := self.tc_to_world_pos(gate.pos + vec2(-16, -8));
    sdtx.origin = self.world_to_text_pos(a);
    b := self.text_to_world_pos(sdtx.origin + vec2(80, 24));
    s := abs(a - b);
    sgl.color = pack_rgba(0, 0, 0, 255);
    sgl.line(vec2(a.x, b.y + s.y/2), vec2(b.x, b.y + s.y/2), s.y);
    
    T :: Builtin.Settings.Console;
    param: T = (repr = it.param.bitcast());
    @if(param.get(.linked) == 0) return();
    // TODO: font https://int10h.org/oldschool-pc-fonts/fontlist/font?ibm_bios-2y
    // TODO: need to bounds check offset against the size of the ram so maybe delay the instance conversion to here
    offset := world.storage[c.instance_offset_by_gate[i]];
    
    bytes_per_char := @if(param.get(.colour) == 0, 1, 8);
    data := world.storage.interpret_as_bytes();
    data := data.subslice(param.get(.linked_ram_instance)*8 + offset*bytes_per_char, 80*24*bytes_per_char);
    
    if param.get(.colour) == 0 {
        sdtx.color = pack_rgba(255, 255, 255, 255);
        range(0, 24) { y |
            range(0, 80) { x |
                value := data[y*80 + x];
                if value == 0 || value == "\n".ascii() || value == "\t".ascii() || value == "\r".ascii() {
                    sdtx.pos.x += 1;
                } else {
                    sdtx.put(value);
                };
            };
            sdtx.pos.x = 0;
            sdtx.pos.y += 1;
        };
    } else {
        data := i64.reinterpret_bytes(data);
        range(0, 24) { y |
            range(0, 80) { x |
                value := data[y*80 + x];
                sdtx.color = pack_rgba(value.shift_right_logical(48).bit_and(0xFF), value.shift_right_logical(40).bit_and(0xFF), value.shift_right_logical(32).bit_and(0xFF), 255);
                my_solid_char := "\x8F".index(0)[];
                if sdtx.color != 0xff000000 {  // there's already a black background, don't bother
                    sdtx.put(my_solid_char);
                    sdtx.pos.x -= 1;
                }
                char: u8 = value.trunc();
                if char == 220 { // HACK bottom half square that tetris uses
                    char = my_solid_char - 3;
                };
                if char == 0xDB {
                    char = my_solid_char;
                };
                if char != 0 && char != "\n".ascii() && char != "\t".ascii() && char != "\r".ascii() && char != 255 {
                    sdtx.color = pack_rgba(value.shift_right_logical(24).bit_and(0xFF), value.shift_right_logical(16).bit_and(0xFF), value.shift_right_logical(8).bit_and(0xFF), 255);
                    sdtx.put(char);
                } else {
                    sdtx.pos.x += 1;
                }
            };
            sdtx.pos.x = 0;
            sdtx.pos.y += 1;
        };
    };
};

fn segment_display(self: *Draw, gate: *Tc.Circuit.Gate, c: *Component, i: i64, it: *Component.Gate) void = {
    world, sgl := (self.world&, self.draw&);
    base := self.tc_to_world_pos(gate.pos + vec2(-1, -1.5));
    w: f32 = 0.02;
    s: f32 = 0.06;
    colour_index := it.param.clamp(0, 3);
    mask := world.storage[c.instance_offset_by_gate[i]];
    empty := pack_rgba(0, 0, 0, 255);
    // TODO: don't have the lines overlap
    range(0, 8) { i |  // TODO: make calling for_bits more convenient
        on := mask.bit_and(1.shift_left(i)) != 0;
        sgl.color = @if(on, segment_colours[colour_index], empty);
        da, db := segment_lines[i];
        a, b := (base + da*s * vec2(1, -1), base + db*s * vec2(1, -1));
        sgl.line(a, b, w);
    };
}

// TODO: should write a texture instead of doing it with 6 vertices per pixel
fn dot_matrix_display(self: *Draw, gate: *Tc.Circuit.Gate, c: *Component, i: i64, _: *Component.Gate) void = {
    world, sgl := (self.world&, self.draw&);
    buf := world.storage.subslice(c.instance_offset_by_gate[i], 7*8*32/64);
    buf := u32.reinterpret_bytes(buf.interpret_as_bytes());
    
    i := 0;
    w: f32 = 0.017;
    p := self.tc_to_world_pos(gate.pos + vec2(-1.5, -1.5));
    range(0, 8) { y |
        range(0, 6) { x |
            r, g, b := (buf[i].shift_right_logical(24).bit_and(0xFF), buf[i].shift_right_logical(16).bit_and(0xFF), buf[i].shift_right_logical(8).bit_and(0xFF));
            sgl.color = pack_rgba(r.zext(), g.zext(), b.zext(), 255);
            sgl.line(p + vec2(0, w/2), p + vec2(w, w/2), w);
            p.x += w;
            i += 1;
        };
        p += vec2(-6 * w, -w);
    };
}
    
fn sprite_display(self: *Draw, gate: *Tc.Circuit.Gate, c: *Component, i: i64, it: *Component.Gate) void = {
    state, world, sgl := (self.state, self.world&, self.draw&);
    data := world.storage.subslice(c.instance_offset_by_gate[i], size_of(Tc.Builtin.SpriteData) * 256);
    data := Tc.Builtin.SpriteData.reinterpret_bytes(data.interpret_as_bytes());
    p := self.tc_to_world_pos(gate.pos + vec2(-16.5, 12));
    @debug_assert(state.atlas.enable, "SpriteDisplay but no atlas");
    uv0, uv1, texture_size := state.atlas.uvs&.get(it.param) || return();
    uv_size := abs(uv0 - uv1);
    sgl.color = 0xFFFFFFFF;
    w: f32 = 1.08;
    logical_screen_size := vec2(640, 480);
    
    aspect := logical_screen_size.y/logical_screen_size.x;
    p0 := p; p1 := p0 + vec2(w, w*aspect);
    sgl.v2f(p0.x, p0.y);
    sgl.v2f(p1.x, p0.y);
    sgl.v2f(p1.x, p1.y);
    sgl.v2f(p0.x, p1.y);
    
    enumerate data { sprite_i, it |
        continue :: local_return;
        @if(it.w * it.h == 0) continue();
        V :: fn(x: u16, y: u16) Vec2 = vec2(x.int().float().cast(), y.int().float().cast());
        src, dest, size := (
            V(it.src_x, it.src_y).min(texture_size), 
            V(it.dest_x, it.dest_y).min(texture_size), 
            V(it.w, it.h).min(logical_screen_size),
        );
        dest.y = logical_screen_size.y - dest.y - size.y;
        
        uv0 := uv0 + src/texture_size * uv_size;
        uv1 := min(uv1, uv0 + size/texture_size * uv_size);
        p0 := p + dest/logical_screen_size * w;
        p1 := p0 + size/logical_screen_size * w * vec2(1, aspect);
        
        sgl.v2f_t2f(p0.x, p0.y, uv0.x, uv1.y);
        sgl.v2f_t2f(p1.x, p0.y, uv1.x, uv1.y);
        sgl.v2f_t2f(p1.x, p1.y, uv1.x, uv0.y);
        sgl.v2f_t2f(p0.x, p1.y, uv0.x, uv0.y);
    };
};


fn screen(self: *Draw, gate: *Tc.Circuit.Gate, c: *Component, i: i64, it: *Component.Gate) void = {
    sdtx, world, sgl := (self.sdtx, self.world&, self.draw&);
    
    a_tc := gate.pos + vec2(-25, -19);
    a := self.tc_to_world_pos(a_tc);
    b := self.tc_to_world_pos(a_tc + vec2(4, 3)*13);
    s := abs(a - b);
    sgl.color = pack_rgba(0, 0, 0, 255);
    sgl.line(vec2(a.x, b.y + s.y/2), vec2(b.x, b.y + s.y/2), s.y);
   
    data := world.storage.rest(c.instance_offset_by_gate[i]).interpret_as_bytes().peek_type(Tc.Builtin.ScreenData);
    @if(data.ram_size_bytes == 0) return();
    memory := world.storage.rest(data.ram_instance).interpret_as_bytes().slice(0, data.ram_size_bytes);
    // TODO: bounds check or wrap?
    memory := memory.rest(data.offset);
    width, height := @if(@is(data.mode, .Ascii8, .Ascii32),
        (96, 40),
        (data.resolution.zext() * 4, data.resolution.zext() * 3));
    bpp := @if(@is(data.mode, .Ascii8, .Pixel8), 1, 4);
    memory := memory.slice(0, width * height * 4);
    
    //@println("% % %", data.resolution, width, height);
    // TODO: do this correctly
    w: f32 = s.x / width.float().cast();
    range(0, height) { y |
        range(0, width) { x |
            value := memory[y*width+x];
            if value != 0 {
                sgl.color = pack_rgba(value, value, value, 255);
                p := a + vec2(x.float().cast()/width.float().cast(), -y.float().cast()/height.float().cast())*s;
                sgl.line(p + vec2(0, w/2), p + vec2(w, w/2), w);
            };
        };
    };
    
}

display_name :: fn(info: *Builtin.Template, it: *Tc.Circuit.Gate, circuit: []Tc.Circuit) Str = {
    name := info.name;
    @if(it.kind.group() == .Loaded)
    if circuit.find(fn(check) => check.id == it.custom_id) { it |
        name = @tfmt("Custom (%)", it.name);
    };
    if it.kind.group() == .Tc2 && it.kind.Tc'gate_name(.Tc2) == .Level_gate {
        name = @tfmt("% (%)", name, it.label);
    };
    name
}

fn put_text(self: *Draw, world_pos: Vec2, colour: u32, $body: @Fn(out: *List(u8)) void) void = {
    body(self.out);
    self.put_text(self.out.items(), world_pos, colour);
    self.out.clear();
}

fn put_text(self: *Draw, text: Str, world_pos: Vec2, colour: u32) void = {
    sdtx := self.sdtx;
    sdtx.color = colour;
    sdtx.origin = self.world_to_text_pos(world_pos);
    sdtx.pos = vec2(0);
    sdtx.put(text);
    sdtx.origin = vec2(0); sdtx.pos = vec2(0);
}

fn show_alert(msg: Str, sdtx: *Sdtx.Context, sapp: *Sapp.Self) void = {
    sdtx.desc.char_height = 8;
    sdtx.desc.char_width = sdtx.desc.char_height / 2;
    sdtx.canvas(sapp, 1);
    sdtx.color = pack_rgba(255, 255, 255, 255);
    sdtx.put(msg);
}

fn tc_to_world_pos(self: *Draw, pos: Vec2) Vec2 = 
    (pos) / 30 * vec2(1, -1) + vec2(-1, -4) + self.diagram_pos;
fn world_to_tc_pos(self: *Draw, pos: Vec2) Vec2 = {
    pos := ((pos - self.diagram_pos - vec2(-1, -4)) * vec2(1, -1) * 30);
    roundf :: fn(a: f32) f32 #libc;
    vec2(pos.x.roundf(), pos.y.roundf())
}
fn world_to_text_pos(self: *Draw, pos: Vec2) Vec2 = 
    ((pos*self.scale*self.screen_scale + self.pos)*vec2(1, -1) + vec2(1)) / self.sdtx.glyph_size / 2;
fn text_to_world_pos(self: *Draw, pos: Vec2) Vec2 =
    (((pos * 2 * self.sdtx.glyph_size) - vec2(1)) * vec2(1, -1) - self.pos) / self.scale / self.screen_scale;

EditState :: @struct {
    enable: bool = false;
    selected_gate: ?i64 = .None;
    placing_wire_start: ?Ty(i64, i64) = .None;   // (wire index, path index)
    action: @enum(None, NewGate, Rotate, Delete) = .None;
    placing_type := zeroed(ComponentId); 
    
    hovered_gate: ?i64 = .None;
    has_text_field := false;
    text: List(u8);
};

// TODO: bundle the source files the jit needs so binary is self contained
// TODO: autosave & web localstorage
// TODO: be able to paste to add one circuit without stomping everything. choose (replace all, replace one, add new). same for dragndrop and cli. 
// TODO: edit more params
// TODO: allow enter custom component while in edit mode / make new custom components
// TODO: copy paste a gate (or area)
// TODO: route better 
// - keep track of length/direction (dont forget to reconstruct in read_save) and use that to simplify split_for_node
// - route around gates/pins/nodes so you have to click explicitly if you want it to connect
// TODO: be able to delete just one wire by clicking on the segment instead of the node
// TODO: be able to delete a redundant node and have the wires reconnect into a bigger one
// TODO: key to summon the add gate menu to your current place?
// TODO: be able to delete longer wires
fn update_edit(self: *Draw, c: *Tc.Circuit, circuits: []Tc.Circuit) void = {
    state := self.state;
    e := state.edit&;
    @if(!e.enable) return();
    
    @if(e.has_text_field) if e.hovered_gate { gate_i |
        gate := c.gates[gate_i]&;
        p := self.tc_to_world_pos(gate.pos + vec2(0, -2));
        self.put_text(p, pack_rgba(255, 255, 255, 255), fn(out) => out.push_all(e.text.items()));
    };
    
    in_bounds :: fn(p) => p.x >= c.min.x && p.y >= c.min.y && p.x <= c.max.x && p.y <= c.max.y;
    if e.selected_gate { gate_i |
        gate := c.gates[gate_i]&;
        new := self.world_to_tc_pos(self.mouse_world_pos);
        if !(new == gate.pos) {
            gate.pos = new;
            state.dirty = true;
        };
        
        if state.clicked&.take() && in_bounds(new) {
            break :: local_return;
            info := Tc'get_builtin_shape(gate.kind);
            if has_pin_overlap(gate_i, c, circuits) {
                // TODO: some type of visual feedback
                break();
            };
            a := state.circuit_arena&.borrow();
            for_pins(info, gate, circuits) { _, dx, dy |
                pos := gate.pos + vec2(dx.float().cast(), dy.float().cast());
                split_for_node(c.wires&, pos, a);
            };
            
            e.select_gate(.None, c);
            state.dirty = true;
        };
    };
    
    if e.placing_wire_start { wire_i, path_i |
        sgl, W := (self.draw&, self.wire_node_width);
        w := c.wires[wire_i]&;
        start := w.path[path_i].pos;
        a := self.tc_to_world_pos(start);
        rounded := self.world_to_tc_pos(self.mouse_world_pos);
        inside := in_bounds(rounded);
        sgl.color = pack_rgba(100 + 150*int(!inside), 50, 50, 255);
        
        route := plan_route(start, rounded);
        for route { pos |
            b := self.tc_to_world_pos(pos);
            sgl.line(a, b, W/2.5);
            sgl.line(b - vec2(0, W/2), b + vec2(0, W/2), W);
            a = b;
        };
        
        if inside && state.clicked&.take() {
            break :: local_return;
            enumerate c.gates { i, it |
                @if(it.pos == rounded) break();
            };
            
            state.dirty = true;
            a := state.circuit_arena&.borrow();
            if w.path.len == 1 && start == rounded {
                w.path.len = 0;
                e.placing_wire_start = .None;
                break();
            };
            if state.show_wire_ref_lines && w.is_end(start) {
                // holding shift, allow placing routing nodes
                if path_i != 0 {
                    for route { pos |
                        w.path&.push((pos = pos), a);
                        e.placing_wire_start.Some._1 += 1;
                    };
                } else {
                    for route { pos |
                        w.path&.insert(0, (pos = pos), a);
                    };
                };
            } else {
                e.placing_wire_start = .None;
                
                for route { pos |
                    split_for_node(c.wires&, pos, a);
                    w.path&.push((pos = pos), a);
                };
            };
        };
    };
    
    state.dirty = state.dirty || e.action != .None;
    @match(e.action) {
        fn NewGate() => {
            gate_i := c.gates&.index_of(fn(it) => it.kind.is_placeholder()) || {
                a := state.circuit_arena&.borrow();
                c.gates&.push(zeroed(Tc.Circuit.Gate), a);
                c.gates[c.gates.len-1].settings = a.alloc_zeroed(i64, 2);
                c.gates.len - 1
            };
            gate := c.gates[gate_i]&;
            gate.logical_gate_index = -1;
            gate.kind = e.placing_type;
            gate.pos = self.world_to_tc_pos(self.mouse_world_pos);
            
            if gate.kind.group() == .Loaded {
                each circuits { check |
                    if check.compiled { kind |
                        if kind.id == gate.kind.id {
                            gate.custom_id = check.id;
                            gate.mystery_spice_minus_fifteen_for_custom_pins = check.cached_pin_radius.p;
                        };
                    };
                };
            };
            e.select_gate((Some = gate_i), c);
        }
        fn Rotate() => if e.selected_gate { gate_i |
            gate := c.gates[gate_i]&;
            gate.rotation = gate.rotation.add(1).mod(4);
        };
        fn Delete() => {
            if e.selected_gate&.take() { i |
                gate := c.gates[i]&;
                gate.kind.id = trunc(component_offset(.Tc1) + GateName(.Tc1)._0.raw().zext());
                gate.pos = vec2(-10000);
            };
            if e.placing_wire_start&.take() { wire_i, path_i |
                pos := c.wires[wire_i].path[path_i].pos;
                each c.wires { it |
                    if it.is_end(pos) {
                        if it.path.len <= 2 {
                            it.path.len = 0;
                        } else {
                            it.path&.ordered_remove(@if(pos == it.path[0].pos, 0, it.path.len - 1));
                        }
                    };
                };
            };
        }
        fn None() => ();
    };
    e.action = .None;
    
    if e.no_selection() && state.clicked&.take() {
        break :: local_return;
        rounded := self.world_to_tc_pos(self.mouse_world_pos);
        @if(!in_bounds(rounded)) break();
        enumerate c.gates { i, it |
            @if(it.pos == rounded) break();
        };
        a := state.circuit_arena&.borrow(); 
        i := c.wires&.index_of(fn(it) => it.path.len == 0) || {
            c.wires&.push((path = empty()), a);
            c.wires.len - 1
        };
        c.wires[i].path&.push((pos = rounded), a);
        e.placing_wire_start = (Some = (i, 0));
        split_for_node(c.wires&, rounded, a);
        state.dirty = true;
    };
}

fn has_pin_overlap(gate_i: i64, c: *Tc.Circuit, circuits: []Tc.Circuit) bool = {
    gate := c.gates[gate_i]&;
    r := get_pin_radius(gate, circuits);
    info0 := Tc'get_builtin_shape(gate.kind);
    enumerate c.gates { i, it |
        continue :: local_return;
        @if(i == gate_i) continue();
        n := r + get_pin_radius(it, circuits);
        @if(norm_sq(it.pos - gate.pos) > n*n) continue();
        
        @if(gate.pos == it.pos) return(true);
        info1 := Tc'get_builtin_shape(it.kind);
        for_pins(info0, gate, circuits) { _, dx, dy |
            pos0 := gate.pos + vec2(dx.float().cast(), dy.float().cast());
            @if(pos0 == it.pos) return(true);
            for_pins(info1, it, circuits) { _, dx, dy |
                pos1 := it.pos + vec2(dx.float().cast(), dy.float().cast());
                @if(pos0 == pos1 || pos1 == gate.pos) return(true);
            };
        };
    };
    false
}

// TODO: either split if visual part of the new wire hits a node/pin
//       or route around nodes/pins (tc does the latter)
// TODO: track length/direction so split_for_node can work on diagonals
// TODO: dont recalculate this every render if it gets more expensive
// only allow 8 directions to simplify split_for_node
plan_route :: fn(start: Vec2, rounded: Vec2) []Vec2 = {
    dir := start - rounded;
    if dir.x != 0 && dir.y != 0 {
        extra := start;
        n := int(dir.x.abs() < dir.y.abs());
        while => dir.x.abs() != dir.y.abs() {
            extra&[n] -= @if(dir&[n] < 0, -1, 1);
            dir = extra - rounded;
        };
        it := @slice(extra, rounded);
        return it.shallow_copy(temp());
    };
    (@slice(rounded)).shallow_copy(temp())
};

fn split_for_node(wires: *RawList(Tc.Circuit.Wire), pos: Vec2, a: Alloc) void = {
    range(0, wires.len) { wire_i |
        break :: local_return;
        it := wires[wire_i]&;
        if !it.is_end(pos) {
            range(1, it.path.len) { path_i |
                // TODO: this would be easier if i already had direction/length. 
                //       rn hack that only works for cardinal directions where length can be integer
                fst, snd := (it.path[path_i - 1].pos, it.path[path_i].pos);
                dir := snd - fst;
                if norm_sq(pos - fst) < dir.norm_sq() && norm_sq(pos - snd) < dir.norm_sq() {
                    len := dir.norm();
                    dir := dir / len;
                    range(0, len.cast().int()) { _ |
                        if fst == pos {
                            old := it.path.items().rest(path_i);
                            wires.push((path = old.shallow_copy(a).as_raw_list()), a);
                            wires[wires.len - 1].path&.insert(0, (pos = pos), a);
                            it = wires[wire_i]&;
                            it.path.len = path_i;
                            it.path&.push((pos = pos), a);
                            break();
                        };
                        fst += dir;
                    };
                };
            };
        };
    };
};

fn is_end(it: *Tc.Circuit.Wire, pos: Vec2) bool =
    it.path.len > 0 && (it.path[0].pos == pos || it.path[it.path.len - 1].pos == pos);

fn no_selection(e: *EditState) bool = e.placing_wire_start.is_none() && e.selected_gate.is_none();

fn select_gate(e: *EditState, i: ?i64, c: *Tc.Circuit) void = {
    e.selected_gate = i;
}

fn hover_gate(e: *EditState, i: ?i64, c: *Tc.Circuit) void = {
    @if((e.hovered_gate || -1) == (i || -1)) return();
    
    @if(e.has_text_field) if e.hovered_gate { old_i |
        value, extra := convert_number_prefixed(e.text.items());
        if extra.len == 0 {
            c.gates[old_i].settings&[0] = value;
        };
    };
    
    e.hovered_gate = i;
    e.has_text_field = false;
    e.text&.clear();
    i := i || return();
    g := c.gates[i]&;
    e.has_text_field = g.kind.has_edit_number();
    @if(!e.has_text_field) return();
    @fmt(e.text&, "%", g.settings&[0]);
}

fn has_edit_number(k: ComponentId) bool =
    k.group() == .Tc1 && @is(k.name(.Tc1), .Constant8, .Constant16, .Constant32, .Constant64, .Counter8, .Counter16, .Counter32, .Counter64, .IndexerBit, .IndexerByte);

fn gate_selection(self: *Draw) void = {
    t :: Tc.Builtin.templates;
    state, sdtx := (self.state, self.sdtx);
    new: ?ComponentId = .None;
    enumerate gate_selection_columns { column_i, column |
        enumerate column { row_i, i |
            do_button(column_i, row_i, t[i[]].name, t[i[]].kind);
        };
    };
    
    // TODO: allow placing CCs that weren't already used so don't have a kind assigned yet
    n := 0;
    each state.circuit { c |
        @if(!c.is_arch) if c.compiled { kind |
            do_button(gate_selection_columns.len(), n, c.name, kind);
            n += 1;
        };
    };
    n += 1;
    
    do_button :: fn(column_i: i64, row_i: i64, name: Str, kind: ComponentId) => {
        pos := vec2(column_i.float().cast() * 18, -row_i.float().cast());
        self.do_option(pos, name, false, kind, new&);
    };
    
    @if(state.edit&.no_selection())
    if new { it |
        state.edit.placing_type = it;
        state.edit.action = .NewGate;
    };
}

// TODO: doesn't work if you enter by logical text that was exposed by inlining something (so needs to do two+ layers of the diagram)
// TODO: ugh this needs to not be so verbose
fn open_gate(state: *State, logical_gate_index: ?i64, diagram_gate_index: ?i64, is_io: bool) void = {
    new_diagram_circuit: ?i64 = .None;
    new_component: ?ComponentId = .None;
    
    @if(state.tree.len > 0)
    if logical_gate_index { i |
        if state.tree[state.tree.len - 1].component { parent |
            new_component = (Some = state.world&[parent].gates[i].kind);
        };
    };

    @if(state.tree.len > 0) if state.tree[state.tree.len - 1].diagram_circuit { i |
        c := state.circuit[i]&;
        @if(logical_gate_index.is_none()) if diagram_gate_index { i |
            g := c.gates[i];
            if g.logical_gate_index != -1 {
                logical_gate_index = (Some = g.logical_gate_index);
                new_component = (Some = g.kind);
            };
        };
        
        @if(diagram_gate_index.is_none()) if logical_gate_index { i |
            enumerate c.gates { j, g |
                if g.logical_gate_index == i {
                    diagram_gate_index = (Some = j);
                };
            };
        };
        
        if diagram_gate_index { i |
            it := c.gates[i]&;
            new_component = (Some = it.kind);
            if group(it.kind) == .Loaded {
                id := it.custom_id;
                new_diagram_circuit = state.circuit.index_of(fn(it) => it.id == id);
            };
        };
        
        if new_diagram_circuit { i |
            new_component = state.circuit[i].compiled;
        };
    };
    
    if new_component { i |
        // TODO: do this with shape.kind == .io ?
        if @is(group(i), .LogicalIO, .Tc1, .Tc2) {
            name := state.world&[i].name;
            is_io = is_io || name.contains("input") || name.contains("output") || name.contains("Input") || name.contains("Output")|| name.contains("Level_input") || name.contains("Level_output");
        };
    };
    
    if is_io {
        state.pop_tree_node();
        state.clicked = false;
        return();
    };
    
    if logical_gate_index.is_some() || new_diagram_circuit.is_some() {
        state.clicked = false;
        state.dirty = true;
        state.push_tree_node(
            diagram_circuit = new_diagram_circuit,
            logical_gate = logical_gate_index,
            component = new_component,
        );
    }
}

fn pop_tree_node(state: *State) void = {
    @if(state.tree.len <= 1) return();
    state.dirty = true;
    prev := state.tree&.pop().unwrap();
    state.pos = prev.saved.pos;
    state.scale = prev.saved.scale;
}

fn push_tree_node(state: *State, it: CircuitNode) void = {
    it.saved = (pos = state.pos, scale = state.scale);
    state.tree&.push(it);
}

fn on_init(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    init(state.loader&, state);
    state.keyboard_data = .None;
    state.edit = (text = list(general_allocator()));
    sapp.desc.enable_clipboard = true;
    sapp.desc.enable_dragndrop = true;
    state.sg = sg; state.sapp = sapp;
    a := general_allocator();
    state.text&.setup(sg = sg, allocator = a, fonts = @slice(Sdtx.font.cpc), context = (char_buf_size = 100_000));
    state.draw&.setup(allocator = general_allocator(), sg = sg, max_vertices = 1_000_000);
    init_pipeline(state.draw&, state.pipe&, sg, (colors = (
        (blend = (  // This makes transparency work
            enabled = true,
            src_factor_rgb = .SRC_ALPHA,
            dst_factor_rgb = .ONE_MINUS_SRC_ALPHA,
        )),
        ..,
    )));
    
    state.sim.text = list(general_allocator());
    state.levels = list(a);
    state.levels&.push(@static { x: LevelApi.Exports = (title = "Sandbox"); x });
    state.levels&.push(import("@/examples/circuit/levels/maze.fr").level_spec);
    state.level = state.levels[0];
    
    state.halt_message = list(a);
    state.key_buffer = init(a, 64);
    state.frame_time_history = init(a, 128);
    state.tree = list(a);
    state.dirty = true;
    state.ticks_per_eval = 1;
    state.recenter();
    state.reset();
    state.prev_timestamp_us = realtime_us();
    
    state.circuit_arena = init(general_allocator(), 1.shift_left(16));
    for cli_args() { path |
        path := path.str();
        if path.ends_with("circuit.data") || path.ends_with(".txt") {
            state.load_path_async(path, false);
        }
        if path == "-fetch" {
            state.download_schematic_archive_before_trying_to_load = true;
            state.load_path_async("Mandelbrot", false);
        }
    };
    
    state.reset();
}

fn recenter(state: *State) void = {
    state.scale = 1/2;
    state.pos = vec2(0, 0.5);
}

fn reset(state: *State) void = {
    state.frame_time_history_sum = 0;
    state.frame_time_history&.clear();

    state.tick = 0;
    state.halt_message&.clear();
    
    world := state.world&;
    world.storage.set_zeroed();  // importantly resets ip,registers=0
    
    world.scratch.len = world.scratch.cap;
    world.scratch.items().set_zeroed();
    @if(state.tree.len == 0) return();
    root := state.tree[0].component || return();
    
    name := state.world&[root].name;

    i := state.tree[0].diagram_circuit || return();
    c := state.circuit[i]&;
    Tc'set_initial_data(world, state.circuit, root, 0);
    
    v := @static @as(LevelApi.Imports) (
        put_text = LevelApi.impl.put_text,
    );
    // TODO: @debug_assert(!state.edit.enable, "c& wont be stable");
    state.sim = (
        fns = v,
        world = world,
        circuit = c,
        text = state.sim.text,
    );
    state.level.userdata = state'level'start(state.sim&);
    
    world.scratch.len = world.scratch.cap;
    world.scratch.items().set_zeroed();
}

fn service_keyboard_device(state: *State) void = {
    data := state.keyboard_data || return();
    buf := state.key_buffer&;
    if buf.len == 0 && !data.valid {
        data.value = 0;
        data.up = false;
    };
    if buf.len > 0 && !data.valid {
        key := buf[0].key;
        // TODO: i have EventType.CHAR which does some of this (but not all because this still wants shift, etc.)
        key := if state.keyboard_character_mode {
            c := @as(i64) zext(@as(u16) key);
            if c < 127 && c.trunc().is_ascii_alpha() && !buf[0].shift {
                c = c.trunc().ascii_to_lower().zext();
            };
            
            c = @match(key) {
                fn ENTER() => 5;
                fn BACKSPACE() => 4;
                fn LEFT_SHIFT() => 21;
                fn RIGHT_SHIFT() => 21;
                fn LEFT() => 15;
                fn UP() => 16;
                fn RIGHT() => 17;
                fn DOWN() => 18;
                @default => c;
            };
            
            if buf[0].shift {
                shift_transforms := "1!2@3#4$5%6^7&8*9(0)-_=+[{]}\\|;:'\",<.>/?";
                range(0, shift_transforms.len/2) { i |
                    if c == shift_transforms[i*2].zext() {
                        c = shift_transforms[i*2 + 1].zext();
                    };
                };
            };
            
            c
        } else {
            (key_order.index_of(fn(it) => it[] == key) || -13) + 13
        };
        
        data.value = key.trunc();
        data.up = buf[0].up;
        data.valid = true;
        _ := buf.pop_front();
        state.dirty = true;
    };
    data.have_next = buf.len.trunc();
}

// TODO: allow multiple?
fn find_keyboard(state: *State) void = {
    state.keyboard_data = .None;
    @if(state.tree.len == 0) return();
    root := state.tree[0].component || return();
    world := state.world&;
    c := world[root]&;
    gate_i := c.gates.index_of(fn(it) => group(it.kind) == .Tc1 && name(it.kind, .Tc1) == .Keyboard)
        || return();
    instance := c.instance_offset_by_gate[gate_i];
    data := bit_cast_unchecked(*WireValue, *Tc.Builtin.KeyboardData, world.storage.index(instance));
    state.keyboard_data = (Some = data);
    state.keyboard_character_mode = c.gates[gate_i].param != 0;
}

#use("@/lib/collections/deque.fr");

fn on_event(state: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = {
    screen := vec2(sapp.framebuffer_width.float().cast(), sapp.framebuffer_height.float().cast()) 
        / 2;
    mouse := vec2(event.mouse_x, -event.mouse_y) / screen + vec2(-1.0, 1.0);
    delta_mouse := vec2(event.mouse_dx, -event.mouse_dy) / screen;
    
    if !event.key_repeat && @is(event.type, .KEY_DOWN, .KEY_UP) {
        if event.key_code == .K && event.type == .KEY_DOWN && event.modifiers.get(.shift) != 0  && event.modifiers.get(.super) != 0 {
            state.keyboard_device_focused = !state.keyboard_device_focused;
            state.dirty = true;
            return();
        }
    
        if pan_keys.index_of(fn(it) => it[] == event.key_code) { i |
            s := state.pan_keys_pressed&;
            s[] = s[].bit_xor(1.shift_left(i));
        };
        
        buf := state.key_buffer&;
        if state.keyboard_device_focused && buf.len() < buf.capacity() {
            buf.push_back((key = event.key_code, up = event.type == .KEY_UP, shift = event.modifiers.get(.shift) != 0), panicking_allocator);
            state.dirty = state.dirty || buf.len < 2;
            return();
        };
    };
    if event.key_repeat && state.keyboard_device_focused {
        return();
    };
    
    e := state.edit&;
    @match(event.type) {
        fn RESIZED() => ();
        fn MOUSE_MOVE() => {
            state.mouse_pos = mouse;
            if event.modifiers.get(.left_mouse) != 0 {
                state.pos += delta_mouse;
            }
        }
        fn MOUSE_SCROLL() => {
            (lo: f32, hi: f32) := (0.03, 100);
            delta := event.scroll_y * state.scale * 3 / screen.x;
            delta := clamp(state.scale + delta, lo, hi) - state.scale;
            
            pos := (mouse - state.pos) / state.scale;
            pos0 := pos * vec2(state.scale);
            pos1 := pos * vec2(state.scale + delta);
            state.pos -= pos1 - pos0;
            state.scale += delta;
        }
        fn KEY_DOWN() => {
            tick_off := @if(event.modifiers.get(.shift) == 1, 50, 1);
            tick_off := @if(event.modifiers.get(.super) == 1, 1000, tick_off);
            @match(event.key_code) {
                fn ESCAPE() => @if(!state.edit.enable) state.pop_tree_node();
                fn ENTER() => { state.want_eval = true; }
                fn SPACE() => { 
                    if e.enable {
                        e.action = .Rotate;
                    } else {
                        state.auto_eval = !state.auto_eval; 
                    }
                }
                fn U() => { state.split_graphics_and_wires = !state.split_graphics_and_wires; }
                fn R() => state.reset();
                fn C() => state.recenter();
                fn LEFT_BRACKET() => if state.ticks_per_eval - tick_off > 0 {
                    state.ticks_per_eval -= tick_off;
                }
                fn RIGHT_BRACKET() => if state.ticks_per_eval + tick_off < 1_000_000 {
                    state.ticks_per_eval += tick_off;
                }
                fn LEFT_SHIFT() => { state.show_wire_ref_lines = true; }
                fn L() => if !e.enable {
                    if state.loader.progress == .Idle {
                        state.download_schematic_archive_before_trying_to_load = true;
                        state.load_path_async("Mandelbrot", false);
                    };
                }
                fn Q() => if !state.keyboard_device_focused && state.loader.progress == .Idle {
                    if state.tree.len > 0 {
                        if state.tree[0].diagram_circuit { i |
                            out := @ref u8.list(temp());
                            shift := event.modifiers.get(.shift) == 1;
                            i: ?i64 = @if(shift, (Some = i), .None);
                            Save'write_save(state.circuit, state.world.tc_file_loader_device, i, out, true);
                            path := "target/circuit.txt";
                            if shift {
                                // hmm i fear initWithBytes in ns_str isn't going to work if its not valid utf8
                                // sapp.set_clipboard_string(out.items());
                                path = "target/circuit2.txt";
                            };
                            write_entire_file_or_crash(path, out.items());
                            println(path);
                        };
                    };
                };
                fn E() => if state.loader.progress == .Idle {
                    @if(state.tree.len == 0) return();
                    i := state.tree[0].diagram_circuit || return();
                    c := state.circuit[i]&;
                    
                    if e.enable {
                        hover_gate(e, .None, c);
                    };
                    e[] = (text = e.text, enable = !e.enable);
                    
                    // recompile when exiting edit mode. 
                    // TODO: this leaks arena space forever so eventually need to dump save and reload to reset it
                    if !e.enable {
                            // forget that loaded it before
                            each state.circuit { c |
                                if c.compiled.is_some() {
                                    each c.gates { it |
                                        it.logical_gate_index = -1;
                                    };
                                    each c.wires { it |
                                        it.logical.id = 0xFFFFFFFF;
                                    };
                                }
                            };
                            
                            load_circuit_index_async(state, i, state.world.tc_file_loader_device);
                    };
                }
                fn BACKSPACE() => {
                    if e.selected_gate.is_none() || event.modifiers.get(.shift) == 1 {
                        _ := e.text&.pop();
                        return();
                    };
                    
                    e.action = .Delete;
                }
                fn M() => if e.enable {
                    c := state.circuit_arena&.borrow().alloc_uninit(Tc.Circuit, state.circuit.len + 1);
                    c.slice(0, state.circuit.len).copy_from(state.circuit);
                    c[c.len-1] = (
                        id = (id = realtime_us()),
                        name = "New Circuit",
                        gates = empty(),
                        wires = empty(),
                        programs = empty(),
                        min = vec2(0),
                        max = vec2(100),
                        dependencies = empty(),
                        v2 = false,
                        default_tick_rate = 1,
                        is_arch = true,
                    );
                    state.circuit = c;
                    state.tree&.clear();
                    state.tree&.push(diagram_circuit = (Some = c.len-1));
                }
                @default => return();
            };
        }
        fn KEY_UP() => {
            @match(event.key_code) {
                fn LEFT_SHIFT() => { state.show_wire_ref_lines = false; }
                @default => return();
            };
        }
        fn MOUSE_DOWN() => if event.mouse_button == .RIGHT {
            state.mouse_pos = mouse;
            state.clicked = true;
        }
        fn CLIPBOARD_PASTED() => if event.pasted.contains("CIRCUIT v1") {
            state.load_path_async(event.pasted, true);
        };
        fn FILES_DROPPED() => for event.drop { path |
            if state.loader.progress == .Idle {
                state.load_path_async(path, false);
            };
        };
        // for now only numbers so not bothering with utf8
        fn CHAR() => if e.has_text_field && event.char_code < 127 && event.char_code >= 32 {
            e.text&.push(event.char_code.trunc());
        }
        @default => return();
    };
    state.dirty = true;
}

pan_directions :: @const_slice(vec2(0, -1), vec2(1, 0), vec2(0, 1), vec2(-1, 0));
pan_keys :: @const_slice(Sapp.Keycode.W, .A, .S, .D);
fn check_movement(state: *State) void = if state.pan_keys_pressed != 0 && !state.keyboard_device_focused {
    state.dirty = true;
    dir := vec2(0);
    range(0, 4) { i |
        if state.pan_keys_pressed.bit_and(1.shift_left(i)) != 0 {
            dir += pan_directions[i];
        };
    };
    state.pos += dir.normalize() * 0.05;
};

fn load_path_async(state: *State, path: Str, is_bytes: bool) void = {
    #use("@/lib/sys/fs.fr");
    
    state.circuit = empty();
    state.world = zeroed(World);
    state.tree&.clear();
    state.circuit_arena&.reset_retaining_capacity();
    state.current_jitted_source = "";
    state.atlas.enable = false;
    a := state.circuit_arena&.borrow();
    path := path.shallow_copy(a);
    state.warnings = list(a);
    state.loader&.start_async(Path = (path = path, is_bytes = is_bytes));
}

LoadSource :: @tagged(
    Path: @struct(path: Str, is_bytes: bool),
    Index: @struct(root_index: i64, tc_file_loader_device: []Tc.LoadedFile),
);
LoaderT :: import("@/examples/jit_loader.fr")'Loader(
    *State, LoadSource, void, void,
    worker_get_source, worker_get_output, main_use_output,
    "dispatch",
);

worker_get_source :: fn(state: *State, in: *LoaderT.I) Result(Str, void) = {
    @match(in[]) {
        fn Path(it) => {
            path := it.path;
            if state.download_schematic_archive_before_trying_to_load && !it.is_bytes {
                state.download_schematic_archive_before_trying_to_load = false;
                root := Foreign'tc_archive();
                filter := @const_slice("ploter", "3D Engine", "Screenverture", "Dungeon Crawler", "Platformer Game", "ASM computer 64bit", "Game of Life 32x32", "Matrix Animation Studio 3000", "Snake on matrix display with LEG++");
                template :: "%/v1/schematics/architecture/%/circuit.data";
                for filter { path |
                    _ := Syscall'remove(@fmt_cstr(template, root, path));
                };
                path = @tfmt(template, root, path);
            };
            load_path_worker(state, in, path, it.is_bytes)
        }
        fn Index(it) => load_circuit_index_worker(state, it.root_index, it.tc_file_loader_device);
    }
}

load_path_worker :: fn(state: *State, in: *LoaderT.I, path: Str, is_bytes: bool) Result(Str, void) = {
    start := timestamp();
    a := state.circuit_arena&.borrow();
    
    bytes := path;
    if is_bytes {
        path = "";
    };
    
    // if it uses custom components, need to load everything to find them
    circuits, root_index, tc_file_loader_device := Tc'load_all_circuits(path, a, state.warnings&);
   
    @if(circuits.len == 0 && !is_bytes)
    if read_entire_file(a, path) { in |
        if in.starts_with("CIRCUIT v1 ") {
            is_bytes = true;
            bytes = in;
        };
    };
    
    @if(is_bytes)
    @if_let(Save'read_save(bytes, a)) fn Ok(c, files) => {
        state.warnings&.clear();
        circuits = c;
        root_index = c.index_of(fn(it) => it.is_arch) || 0;
        tc_file_loader_device = files;
    };
    
    //@eprintln("found % circuit diagrams in %ms; %mb;", circuits.len, timestamp() - start, state.circuit_arena&.current_used_size()/1024/1024);
    state.circuit = circuits;
    if circuits.len == 0 || root_index == -1 {
        state.circuit = empty();
        @fmtln(state.warnings&, "failed to load [%]", path);
        return(.Err);
    };
    state.push_tree_node(diagram_circuit = (Some = root_index));
    // TODO: dont bother recompiling yet if in edit mode
    in[] = (Index = (root_index = root_index, tc_file_loader_device = tc_file_loader_device));
    worker_get_source(state, in)
}

fn load_circuit_index_async(state: *State, root_index: i64, tc_file_loader_device: []Tc.LoadedFile) void = {
    @debug_assert_eq(state.loader.progress, .Idle);
    state.load_time = 0;
    state.tree&.clear();
    state.push_tree_node(diagram_circuit = (Some = root_index));
    state.loader&.start_async(Index = (root_index = root_index, tc_file_loader_device = tc_file_loader_device));
}

// should fine for the ui to show the diagram on the other thread while this compiles. 
// there needs to not use the logical part while progress==.Loading and here needs to not push to state.tree. 
fn load_circuit_index_worker(state: *State, root_index: i64, tc_file_loader_device: []Tc.LoadedFile) Result(Str, void) = {
    circuits := state.circuit;
    each circuits { c | 
        c.compiled = .None;
    };
    
    // TODO: bring back FEAT_RT_COMPILE which doesn't compile the franca compiler. 
    
    a := state.circuit_arena&.borrow();
    components := @ref Component.list(a);
    components.push_all(builtin_components);
    Tc'compile_circuit(circuits, root_index, components, a, state.warnings&);
    
    first_index_that_needs_fast_eval := builtin_components.len();
    src := compile_gates_source(components.items(), a, first_index_that_needs_fast_eval, state.warnings&);
    if state.current_jitted_source != "" && state.current_jitted_source == src {
        return(.Err);
    };
    state.world.components = components.items();
    state.current_jitted_source = src;
    (Ok = src)
}
    
worker_get_output :: fn(state: *State, in: *LoaderT.I, callee: rawptr) Result(void, void) = {
    components := state.world.components;
    fill_fast_eval(components, callee);
    
    circuits := state.circuit; 
    fr, _ := state.loader.fr.it.unwrap(); 
    a := fr.get_alloc();
    init(state.world&, a, true, components);
    state.world.tc_file_loader_device = in.Index.tc_file_loader_device;
   
    c := circuits[in.Index.root_index]&; 
    state.load_atlas_part1(c);
    state.ticks_per_eval = max(c.default_tick_rate / 60, 1);
    .Ok
}

// TODO: if there were to be a sandbox escape in this program it would probably be by passing untrusted bytes to stb_image.
fn load_atlas_part1(state: *State, c: *Tc.Circuit) void = {
    @if(!FEAT_PNG) return();
    Atlas :: import("@/tests/external/wasm4.fr").Atlas;
    Viewer :: import("@/examples/gpu/viewer.fr");
    world := state.world&;
    files := world.tc_file_loader_device;
    c := c.compiled || return();
    c := world[c]&;
    
    Img :: @struct(param: i64, pixels: []u8, w: i64, h: i64);
    images := Img.list(temp());
    
    atlas_w, atlas_h := (1, 1);
    each c.gates { it |
        continue :: local_return;
        @if(world[it.kind].name != "SpriteDisplay") continue();
        @if(!it.param.ult(files.len)) continue();
        file := files[it.param]&;
        println(file.name);
        
        pixels, w, h := Viewer'stbi_load(file.data).or(fn(err) => {
            @eprintln("failed to load image (%): %", file.name, err);
            continue();
        });
        img: Img = (param = it.param, pixels = pixels, w = w.intcast(), h = h.intcast());
        images&.push(img);
        
        atlas_w += img.w;
        atlas_h = max(atlas_h, img.h);
    };
    
    atlas := Atlas'new_sized(general_allocator(), atlas_w, atlas_h);
    atlas_uvs: HashMap(i64, Ty(Vec2, Vec2, Vec2)) = init(state.circuit_arena&.borrow());
    _ := atlas&.push(@slice(0xFFFFFFFF), 1, 1);  // :WhitePixelForDrawingSolidColours
    for images { it |
        a, b := atlas&.push(u32.reinterpret_bytes(it.pixels), it.w, it.h);
        atlas_uvs&.insert(it.param, (a, b, vec2(it.w.float().cast(), it.h.float().cast())));
        Viewer'Stb'stbi_image_free(u8.raw_from_ptr(it.pixels.ptr));
    };
    
    state.atlas.uvs = atlas_uvs.raw;
    state.atlas.data = (pixels = atlas.buf, w = atlas_w, h = atlas_h);
}

fn load_atlas_part2(state: *State, sg: *Sg.Self) void = {
    a := state.atlas.data&;
    sg.destroy(state.atlas.img);
    state.atlas.img = (id = 0);
    state.atlas.enable = a.pixels.len > 0;
    @if(!state.atlas.enable) return();
    d := zeroed(Sg.ImageData);
    d.subimage&[0]&[0] = interpret_as_bytes(a.pixels);
    state.atlas.img = sg.make(
        width = a.w.intcast(), height = a.h.intcast(),
        pixel_format = .RGBA8,
        data = d,
    );
    general_allocator().dealloc(u32, a.pixels);
    a.pixels = empty();
}

Save :: import("@/examples/circuit/save.fr");
Tc :: import("@/examples/circuit/tc/load.fr");
Builtin :: Tc.Builtin;
//Tc :: Main.tc.load;
//Builtin :: Main.tc.builtin;

fn on_cleanup(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    drop(state.loader&);
    state.text&.shutdown();
    sg.destroy_pipeline(state.pipe&);;
    state.draw&.destroy(sg, general_allocator());
    state.circuit_arena&.deinit();
}

