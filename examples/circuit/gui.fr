gate_selection_columns :: {
    t :: Tc.Builtin.templates;
    a := ast_alloc();
    poly := @const_slice("And", "Or", "Not", "Nand", "Xor", "Nor", "Xnor", "Switch", "DelayLine", "Input", "Output", "OutputZ", "Bidirectional", "Constant", "Maker", "Splitter", "Mux", "Add", "Neg", "Mul", "DivMod", "Equal", "LessI", "LessU", "Shl", "Shr", "Ashr", "Rol", "Ror", "Register", "Counter");
    columns := a.alloc_init(RawList(i64), 6, fn(_) => empty());
    seen := zeroed(StaticBitSet(t.len()));
    for poly { name |
        if t.index_of(fn(it) => it.name == name || it.name == @tfmt("%1", name)) { j |
            columns[0]&.push(j, a);
            seen&.set(j);
        };
        range(0, 4) { i |
            size := 1.shift_left(i) * 8;
            if Tc.Builtin.templates.index_of(fn(it) => it.name == @tfmt("%%", name, size)) { j |
                columns[i+1]&.push(j, a);
                seen&.set(j);
            };
        };
    };
    
    no := @const_slice("NoteSound", "SyntheticCast_FR", "LevelScreen", "LevelOutput1Sum", "LevelOutput1Car", "LevelInput1", "LevelOutput1");
    enumerate t { j, it |
        if !seen&.get(j) && !no.contains(it.name) && !@is(it.body, .Unimplemented, .Custom) {
            columns[5]&.push(j, a);
        }
    };
    
    columns
};

convert_number_prefixed :: fn(s: Str) Ty(i64, Str) = {
    negative := s&.pop_prefix("-");
    value, extra := @if_else {
        @if(s&.pop_prefix("0x")) => convert_number_dyn(s, 16);
        @if(s&.pop_prefix("0o")) => convert_number_dyn(s, 8);
        @if(s&.pop_prefix("0b")) => convert_number_dyn(s, 2);
        @else => convert_number_dyn(s, 10);
    };
    value *= @if(negative, -1, 1);
    (value, extra)
};
