
FEAT_PNG :: true;

HELP :: """
left drag or wasd: move. scroll: zoom.
right click: enter a gate.
escape: exit to previous gate. 
enter: evaluate one tick. 
space: toggle auto eval.
r: restart program. 
c: reset scale/pos.
[/]: slower/faster eval (shift:50, cmd:1000). 
k+shift+cmd: toggle keyboard device capture.
u: toggle render graphics devices over circuit
e: toggle edit mode.
""";

State :: @rec @struct {
    HIGH_DPI :: true;
    text: Sdtx.Self;
    draw: Sgl.Self;
    pipe: Sgl.Pipeline;
    pos: Vec2;
    scale: f32;
    sg: *Sg.Self;
    sapp: *Sapp.Self;
    dirty: bool;
    mouse_pos: Vec2;
    world: World;
    tree: List(CircuitNode);
    clicked: bool;
    either_clicked: bool;
    left_mouse_down: bool;
    want_eval: bool;
    auto_eval: bool;
    ticks_per_eval: i64;
    max_ticks_per_eval: i64;
    old_max_ticks_per_eval: i64;
    first_interpreted_frame: bool;
    first_jitted_frame: bool;
    last_frame_was_recalibrate: bool;
    tree_ready: bool;
    sim: LevelApi.Simulation;
    level: *LevelApi.Exports;
    level_index: i64;
    level_active: bool;
    win: bool;
    level_suggested: StaticBitSet(builtin_components.len());
    levels: List(Save.LevelEntry);
    tick: i64;
    halt_message: List(u8);
    show_wire_ref_lines: bool;
    pan_keys_pressed: i64;
    key_buffer: RawDeque(@struct(key: Sapp.Keycode, up: bool, shift: bool));
    keyboard_device_focused: bool;
    gfx_error_last_frame: bool;
    halted_without_wire_values: bool;
    keyboard_data: ?*Tc.Builtin.KeyboardData;
    keyboard_character_mode: @enum(Char, V1, V2);
    
    circuit: []Tc.Circuit;
    circuit_index: i64;
    circuit_arena: Arena.Allocator;
    current_jitted_source: Str;
    source_unchanged: bool;
    loader_thread_ready_for_interp: bool;
    load_time: i64;
    compile_time: i64;
    warnings: List(u8);
    loader: *LoaderT;
    canceled_compilers: List(*LoaderT);
    download_schematic_archive_before_trying_to_load: bool;
    looking_at_examples: bool;  // HACK: disable saving so they dont stomp your stuff
    prev_timestamp_ns: i64;
    frame_time_history: RollingAverage;  // us
    tick_count_history: RollingAverage;
    eval_last_frame: bool;
    split_graphics_and_wires: bool;
    show_wire_comments: bool;
    show_logic_trace: bool;
    // v1 SpriteDisplay
    atlas: @struct {
        data: @struct(pixels: []u32  /*general_allocator, free after loading on ui thread*/, w: i64, h: i64);
        uvs: RawHashMap(i64, Ty(Vec2, Vec2, Vec2));  // SpriteDisplay.param -> (uv1, uv2, size_pixels)
        img: Sg.Image;
        enable: bool;
    };
    // v2 Screen
    screen: @struct {
        atlas: Atlas;
        img: Sg.Image;
        enable: bool;
        need_resize: bool;
        did_warning: bool;
        to_drop: ?Sg.Image;
    };
    edit: EditState;
    show_suggested_components: bool;
    last_auto_save_time: i64;
    
    // only know part way through rendering so won't highlight all the parts on the first frame. 
    // remember for next frame to get all the nodes. 
    prev_emphasized_wire: ?WireId;
};

CircuitNode :: @struct {
    diagram_circuit: ?i64 = .None;  // index in state.circuit
    logical_gate: ?i64 = .None;  // index in previous component
    graphical_gate: ?i64 = .None;  // index in previous circuit.gates
    component: ?ComponentId = .None;
    saved := zeroed(@struct(pos: Vec2, scale: f32));
    
    inline_parent_diagram: ?i64 = .None;  // index in state.circuit
    inline_index_logical: ?i64 = .None;    // index in ^.compiled.gates
    inline_record: ?u32 = .None;
};

LevelApi :: import("@/examples/circuit/level_api.fr");

main_use_output :: fn(state: *State, in: LoaderT.I, out: Result(rawptr, void)) void = {
    state.dirty = true;
    @if_let(out) fn Ok(callee) => {
        // doing this on the main thread so fast_eval&signeture fields can't tear
        fill_fast_eval(state.world.components, callee);
        state.compile_time = timestamp() - state.loader.start_time - state.load_time;
        state.first_jitted_frame = true;
        state.first_interpreted_frame = false;
    };
    // else: 
    // recompiled for exiting edit mode but current_jitted_source didn't change so didnt call worker_get_output
    // barely helps because wire ids change if you did anything at all but doesn't hurt
    // OR: failed to make new code and won't run because component.error
}

main_prepare_interp :: fn(state: *State) void = {
    state.first_jitted_frame = false;
    state.first_interpreted_frame = true;
    if state.current_diagram() { c |
        @debug_assert_eq(state.tree.len, 1, "// TODO: its possible to enter a gate while it's loading");
        state.tree[0].component = c.compiled;
        if !c.is_level_map {
            default := state.levels[state.level_index].default_circuit&;
            changed := default.is_none() || default.Some.id != c.id.id;
            default[] = (Some = c.id);
            @if(changed) state.save_progress();
        } else {
            state.want_eval = true;  // tick once to update the colours
        };
    };
    state.reset();
    state.find_keyboard();
    
    if state.warnings.len != 0 {
        state.auto_eval = false;
    };
    @if(state.source_unchanged&.take()) return();
    
    state.load_atlas_part2(state.sg);
    state.load_time = timestamp() - state.loader.start_time;
}

do_eval :: fn(state: *State) void = {
    world := state.world&;
    root_component := state.tree[0].component.unwrap();
    child := world[root_component]&;
    @if(child.error) return();
    state.halt_message&.clear();
    state.want_eval = false;
    prev_timestamp := state.prev_timestamp_ns;
    this_timestamp := realtime_ns();
    website_date_resolution_is_ass := @if(query_current_arch() == .wasm32, timestamp_s(), 0);
    state.prev_timestamp_ns = this_timestamp;
    delta_time := this_timestamp - prev_timestamp;
    recalibrate := 1;
    if state.eval_last_frame {
        state.frame_time_history&.push(delta_time / 1000);
        
        if state.frame_time_history.history&.len() > 32 {
            break :: local_return;
            if state.ticks_per_eval == state.max_ticks_per_eval && delta_time < 18_000_000 {
                break();
            };
            
            ave_frame_time := state.frame_time_history&.get();
            if ave_frame_time < 17_000 {
                prev_frame_time := state.frame_time_history.history&[state.frame_time_history.history&.len() - 1];
                if prev_frame_time > 17_000 {
                    prev_tick_count := state.tick_count_history.history&[state.tick_count_history.history&.len() - 1];
                    ns_per_tick := prev_frame_time * 1000 / prev_tick_count;
                    state.ticks_per_eval = max(16_900_000 / ns_per_tick, 1);
                    state.last_frame_was_recalibrate = false;
                } else {
                    if state.last_frame_was_recalibrate&.take() {
                        // didn't manage to slow the frame down
                        state.ticks_per_eval *= 2;
                    };
                    if state.ticks_per_eval < state.max_ticks_per_eval {
                        recalibrate = 2;
                        state.last_frame_was_recalibrate = true;
                    };
                };
            } else {
                ave_tick_count := state.tick_count_history&.get();
                ns_per_tick := ave_frame_time * 1000 / ave_tick_count;
                state.ticks_per_eval = max(16_900_000 / ns_per_tick, 1);
                state.last_frame_was_recalibrate = false;
            };
        };
    } else {
        delta_time = min(delta_time, 16 * NS_PER_MS);
        prev_timestamp = this_timestamp - delta_time;
    };
    state.ticks_per_eval = min(state.ticks_per_eval, state.max_ticks_per_eval);
    
    count := @if(state.auto_eval && !state.first_interpreted_frame, state.ticks_per_eval * recalibrate, 1);
    state.tick_count_history&.push(count);
    
    o_n, i_n := child.arity();
    values := temp().alloc_zeroed(i64, o_n + i_n);
    have_level := state.level_active;
    // lifting the division out of the loop instead of `clock := prev_timestamp + delta_time*i/count;` 
    // is fine if running slower than 1GHz which would mean simulating a tick in ~3 real cycles which is not a risk. 
    clock_step := delta_time / count;  
    clock := prev_timestamp;
    state.halted_without_wire_values = count != 1;
    range(0, count) { i |
        // the idea here is to spread the times evenly instead of all the ticks being grouped together each frame with 16ms gaps.
        clock += clock_step;
        world.timestamp_ns = (Some = clock);
        state.service_keyboard_device();
        
        if have_level {
            state.tick += 1;
            state'level'before(state.level.userdata, values);
        };
        
        save_wire_values := i == count - 1;
        evaluate(world, values, root_component, 0, save_wire_values);
        
        if have_level {
            win := state'level'after(state.level.userdata, values);
            if win {
                state.auto_eval = false;
                state.win = true;
                return();
            }
        };
        
        // last so the level is allowed to expect you to halt
        if world.tc_halt_device != -1 {
            if !have_level {
                state.tick += i;
            };
            state.halted_without_wire_values = i != count - 1;
            return do_halt(state);
        };
    };
    state.halted_without_wire_values = false;
    if !have_level {
        state.tick += count;
    };
    
    // jit is much faster than interp so times between them are meaningless. 
    if state.first_interpreted_frame&.take() || state.first_jitted_frame&.take() || state.max_ticks_per_eval != state.old_max_ticks_per_eval {
        state.old_max_ticks_per_eval = state.max_ticks_per_eval;
        state.frame_time_history&.clear();
        state.tick_count_history&.clear();
        dt := realtime_ns() - this_timestamp;
        if dt == 0 && query_current_arch() == .wasm32 {
            // i use Date.now() for realtime on web which is only millisecond resolution (and div by 0 traps on wasm). 
            // the `delta_time` above is across frames so will be ~16ms and doesn't matter but this one is only for running a tick. 
            dt = max(int((timestamp_s() - website_date_resolution_is_ass) * (NS_PER_S/1000).float()) * 1000, 1);
        };
        state.ticks_per_eval = (16*NS_PER_MS*count/dt).min(state.max_ticks_per_eval).max(1);
    };
};

do_halt :: fn(state: *State) void = {
    world := state.world&;
    msg := get_halt_message(world, state.circuit).unwrap();
    @fmt(state.halt_message&, "halted after % ticks: %", state.tick, msg);
    world.tc_halt_device = -1;
    state.auto_eval = false;
};

fn on_render(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    state.check_movement();
    if state.auto_eval && !state.edit.enable {
        state.dirty = true;
    };
    state.dirty = state.edit.text_box.dirty&.take() || state.dirty;
    if Easy'should_skip_frame(sapp, state.dirty&) {
        state.eval_last_frame = false;
        return();
    };
    sdtx := state.text.default_context&;
    sgl := state.draw&;
    
    if state.loader_thread_ready_for_interp&.take() {
        main_prepare_interp(state);
    };
    progress := state.loader.check();
    if progress == .Loading {
        in := state.loader.in.unwrap();
        name := @match(in) {  // TODO: this is a race. can tear
            fn Path(it) => it.path;
            fn Index(it) => state.circuit[it.root_index].name;
        };
        t := timestamp() - state.loader.start_time;
        state.dirty = true;
        msg := @tfmt("loading %\nit's been % ms\nif you can read all this it's too slow!", name, t);
        // dont flicker for a frame when exiting exit mode without changes
        if t > 50 { 
            show_alert(msg, sdtx, sapp);
        } else {
            sapp.webgpu.noframe = true;
            return();
        };
    };
    if progress != .Idle {
        // do all the frames so can turn off the "interpreted" label as soon as it's ready
        state.dirty = true;
    }
    
    world := state.world&;
    // for debugging circuits i can't load correctly, can still have_logic=true 
    // when Component.error=true. that's disallowed from running seperately. 
    have_logic := progress != .Loading 
        && state.tree.len > 0 && state.tree[0].component.is_some() 
        && state.world.components.len > 0
        // TODO: but want to allow if you just only placed io gates
        //       .. i can't even put this in ComponentTests because tc doesn't let you have a cc with no area. 
        // && world[state.tree[0].component.Some].gates.len > 2  // HACK for load unimplemented
        && !state.edit.enable;
    eval_this_frame := have_logic && (state.want_eval || state.auto_eval);
    
    if eval_this_frame {
        do_eval(state);
        if state.win {
            @fmt(state.halt_message&, "solved in % ticks", state.tick);
            completed := state.levels[state.level_index].completed&;
            changed := !completed[];
            completed[] = true;
            @if(changed) state.save_progress();
        };
    };
    state.eval_last_frame = eval_this_frame;
    
    app_w, app_h := (sapp.width().float().cast(), sapp.height().float().cast());
    screen_scale := vec2(500 * sapp.dpi_scale) / vec2(app_w, app_h);
    self: Draw = (
        state = state, 
        screen_scale = screen_scale,
        sdtx = sdtx,
        have_logic = have_logic,
        mouse_world_pos = (state.mouse_pos - state.pos) / state.scale / screen_scale,
        out = @ref u8.list(32, temp()),
        label_sdtx = state.edit.text_box.text.default_context&,
    ); self := self&;
    
    if state.gfx_error_last_frame {
        show_alert("TOO MANY VERTICES", sdtx, sapp);
    };
    
    sdtx.desc.char_height = 10 * state.scale;
    sdtx.desc.char_width = sdtx.desc.char_height / 2;
    
    text_scale := 1.0 / sapp.dpi_scale;
    text_w, text_h := (app_w * text_scale, app_h * text_scale);
    sdtx.canvas(text_w, text_h);
    
    self.text_spacing = {
        a := self.text_to_world_pos(vec2(0, 0)); 
        b := self.text_to_world_pos(vec2(1, 1));
        c := abs(b - a);
        vec2(c.x, c.y * 1.5)
    };
    
    self.put_text(self.text_spacing * vec2(0, 3), pack_rgba(255, 255, 255, 255)) { out |
        if state.edit.enable {
            @fmt(out, "edit mode (press e to exit); left drag to move/place. space to rotate. right click to delete. middle drag to pan. double click gate to configure.");
        } else {
            frame_time := state.frame_time_history&.get();
            @fmt(out, "(paused=%, tick_rate=%, max_tick_rate: %, tick=%, keyboard=%, frame_time=%ms) ", 
                !state.auto_eval, state.ticks_per_eval, state.max_ticks_per_eval, state.tick, state.keyboard_device_focused, frame_time/1000);
            @if(progress == .Loading) @fmt(out, "loading...%ms ", timestamp() - state.loader.start_time);
            @if(state.load_time != 0) @fmt(out, "load_time=%ms ", state.load_time);
            @if(progress == .Compiling)  @fmt(out, "compiling....%ms ", timestamp() - state.loader.start_time - state.load_time);
            @if(state.compile_time != 0) @fmt(out, "compile_time=%ms ", state.compile_time);
            if state.auto_eval && frame_time != 0 {
                hz0 := state.tick_count_history&.get() * US_PER_S / frame_time;
                format_hz(out, hz0);
            }
        };
    };
    if !state.edit.enable {
    self.put_text(HELP, self.text_spacing * vec2(-90, 12), pack_rgba(0, 0, 0, 255));
        if !have_logic && progress == .Idle {
            // TODO: empty circuit says load error because only 2 gates
            self.put_text("LOAD ERROR", self.text_spacing * vec2(0, 2), pack_rgba(255, 0, 0, 255));
        };
    } else {
        self.gate_selection();
        if state.looking_at_examples {
            self.put_text("CHANGES MADE TO EXAMPLE CIRCUITS WILL NOT BE SAVED", self.text_spacing * vec2(0, 2), pack_rgba(255, 0, 0, 255));
        }
    };
    
    if self.text_box_selection() {
        have_logic = false;
    };
    open_arch := self.arch_selection();
    
    if have_logic {
        root_component := state.tree[0].component.unwrap();
        c := world[root_component]&;
        @if(c.error) self.put_text("COMPILE ERROR", self.text_spacing * vec2(0, 2), pack_rgba(255, 0, 0, 255));
        if progress == .Compiling && state.auto_eval {
            self.put_text("INTERPRETED", self.text_spacing * vec2(0, 2), pack_rgba(255, 0, 0, 255));
        };
        instance, parent_wire_offset, wire_offset, logical_c := self.walk_component_tree(c&);
        self.base_instance = instance;
        // when `c` is inlined, `logical_c` is the first real parent (inline_parent_diagram). 
        
        // TODO: even if halted_without_wire_values can show values of probes (from world.storage) on hover
        if !state.halted_without_wire_values && c.gates.len > 0 {
            @debug_assert(world.scratch.len >= wire_offset + logical_c.wire_count, "misconfigured scratch");
            self.wires = world.scratch.items().subslice(wire_offset, logical_c.wire_count);
        };
        self.logical = (Some = c);
        
        if state.tree.len == 1 || state.tree[state.tree.len - 1].logical_gate.is_some() {
            self.draw_component_code(c, instance, parent_wire_offset);
        } else {
            break :: local_return;
            // TODO: wire def lines dont work to the graphical here
            new_wires := self.wires;
            I := state.tree.len - 1;
            while => world[state.tree[I].component || break()].has_bidirectional_pins {
                I -= 1;
                @if(I < 0) break();
            };
            c := c;
            dowhile {
                i := state.tree[I+1].graphical_gate || break();
                parent_circuit := state.circuit[state.tree[I].diagram_circuit || break()]&;
                it := parent_circuit.gates[i]&;
                @if(it.inline_record == 0xFFFFFFFF) break();
                record := parent_circuit.inlined[it.inline_record.zext()]&;
                if !state.halted_without_wire_values {
                    // TODO: same for wire sizes
                    new_wires = temp().alloc_init(WireValue, record.wires.len, fn(i) => {
                        id := record.wires[i];
                        @if(id.id == 0xFFFFFFFF, 0, new_wires[id.id.zext()])
                    });
                };
                c = world[it.kind]&;
                I += 1;
                I < state.tree.len - 1
            };
            
            // don't restore self.logical because draw_gate_hover_line needs it to be the same one hover_logical_code references
            self.logical = (Some = c);
            prev_wires := self.wires;
            self.wires = new_wires;
            self.draw_component_code(c, 0, 0);
            self.wires = prev_wires;
        };
        
        if state.level_active {
        // TODO: more sane way of doing positioning
        state.sim.text&.clear();
        state'level'render(state.level.userdata);
        s := vec2(self.text_spacing.x, self.text_spacing.x*2);
        each state.sim.text& { it |
            self.put_text(it.msg, it.pos * s, it.c);
        };
        state.sim.text&.clear();
        };
    };
    
    if state.halt_message.len != 0 {
        self.put_text(state.halt_message.items(), self.text_spacing * vec2(0, 4), pack_rgba(50, 200, 150, 255));
    };
    
    if state.screen.to_drop&.take() { img |
        sg.destroy(img);
    };
    
    sgl.defaults();
    sgl.viewport(0, 0, app_w, app_h, true);
    sgl.load_pipeline(state.pipe);
    if state.atlas.enable || state.screen.img.id != 0 {
        img := @if(state.atlas.enable, state.atlas.img, state.screen.img);
        sgl.texture(img, (id = 0));
        sgl.texturing_enabled = true;
        sgl.u = 0; sgl.v = 0;  // :WhitePixelForDrawingSolidColours
    };
    sgl.begin(.QUADS);
    sgl.load_identity();
    sgl.translate(state.pos.x, state.pos.y, 0.0);
    sgl.scale(state.scale * screen_scale.x, state.scale * screen_scale.y, 1.0);
    
    if state.current_diagram() { circuit |
        if state.show_wire_comments {
            sdtx := self.label_sdtx;
            sdtx.set_layer(wire_comment_text_layer);
            old_size := (sdtx.desc.char_width, sdtx.desc.char_height);
            sdtx.desc.char_height = 10 * state.scale;
            sdtx.desc.char_width = sdtx.desc.char_height / 2;
            sdtx.canvas(text_w, text_h);
            sdtx.desc.char_width = old_size._0; sdtx.desc.char_height = old_size._1;
        };
    
        self.draw_circuit_background(circuit);
        self.draw_gate_squares(circuit);
        self.draw_wires(circuit);
        self.draw_pin_lines(circuit);
        self.draw_gate_hover_line(circuit);
        self.update_edit(circuit, state.circuit);
        self.draw_undo_tree();
    };
    
    positions := self.emphasized_wire_positions;
    @if(positions.len > 0)
    if self.hovered_wire_index { position_index |
        a := self.text_to_world_pos(positions[position_index]);
        for positions { b |
            b := self.text_to_world_pos(b);
            sgl.color = pack_rgba(255, 255, 255, 200);
            sgl.line(a, b, 0.005);
        };
    };

    if have_logic {
        break :: local_return;
        circuit := state.tree[state.tree.len - 1].diagram_circuit || break();
        c := state.tree[state.tree.len - 1].component || break();
        
        circuit := state.circuit[circuit]&;
        // TODO: allow console in custom component too (use last element in the tree and offset by its base instance)
        c := world[c]&;
        @if(c.error) break(); 
        if state.split_graphics_and_wires {
            self.diagram_pos += self.tc_to_world_pos(vec2(0, 0)) - self.tc_to_world_pos(vec2(0, abs(circuit.max.y - circuit.min.y)));
        };

        sdtx.desc.char_height /= 1.5;
        sdtx.desc.char_width /= 1.5;
        sdtx.canvas(text_w, text_h);
        
        // TODO: if select a primitive one, show just itself
        each circuit.gates { gate |
            i := gate.logical_gate_index;
            if i != -1 {
            it := c.gates[i]&;
            @debug_assert_eq(it.inline_record, 0xFFFFFFFF);
            // TODO: all these need to know the thing's rotation
            @if(it.kind.group() == .Tc1)
            @match(it.kind.name(.Tc1)) {
                fn Console() => self.console(gate, c, i, it);
                fn SegmentDisplay() => self.segment_display(gate, c, i, it);
                fn DotMatrixDisplay() => self.dot_matrix_display(gate, c, i, it);
                fn SpriteDisplay() => self.sprite_display(gate, c, i, it);
                fn ProbeWireBit() => self.probe_bit(gate.pos, c, i);
                @default => ();
            };
            @if(it.kind.group() == .Tc2)
            @match(it.kind.name(.Tc2)) {
                fn Segment_display() => self.segment_display(gate, c, i, it);
                fn Screen() => self.screen(gate, c, i, it);
                fn Push_button() => {
                    // TODO: in cc need to unpress if you ESC to do up while holding mouse. 
                    on := state.left_mouse_down && self.hovering_node(self.tc_to_world_pos(gate.pos));
                    state.world.storage[self.instance_by_gate(c, i)] = int(on);
                };
                fn Probe_wire_bit() => self.probe_bit(gate.pos, c, i);
                fn Level_gate() => self.level_gate(gate.pos, c, i);
                @default => ();
            };
            };
            
            if gate.kind.group() == .Loaded {  // i==-1 means inlined
                self.child_probes(gate, circuit);
            };
        };
        
        state.finish_screens();
    };
    
    // without this you get a flicker and occasionally a bounds check assertion! for hopefully intuitive reasons. dear rust would like to have a word im sure.
    if self.open_gate&.take() { a, b, c |  // wait until done rendering components to change the tree. 
        state.open_gate(a, b, c);
    };
    
    @if(state.loader.progress != .Loading) if open_arch { i |
        state.dirty = true;
        state.warnings&.clear();
        load_circuit_index_async(state, i, state.world.tc_file_loader_device);
    };
    
    // TODO: option to disable the compiler per circuit. no point compiling the level map that will only ever run one tick at a time.
    @if(state.loader.progress == .Idle) if self.open_level { i |
        it := state.levels[i].level;
        state.dirty = true;
        state.end_level();
        state.level_index = i;
        state.level = it;
            new := false;
            if state.levels[i].default_circuit { c |
                if state.circuit.index_of(fn(it) => it.id == c) { c |
                    new = true;
                    load_circuit_index_async(state, c, state.world.tc_file_loader_device);
                };
            };
            @if(!new) if state.current_diagram() { c |
                if c.is_level_map {
                    new = true;
                    state.new_circuit();
                    // compile so it doesn't say "load error",
                    // and put in not edit mode to start so it has a level inited and the suggested components highlight properly
                    load_circuit_index_async(state, state.circuit.len-1, state.world.tc_file_loader_device);
                };
            };
            if !new {
                state.reset();
            };
    };
    
    sgl.end();
    
    gfx_error := sdtx.vertices.len == sdtx.vertices.cap || sgl.error.any;
    state.dirty = state.dirty || gfx_error != state.gfx_error_last_frame;
    state.gfx_error_last_frame = gfx_error;
    
    state.clicked = false;
    state.either_clicked = false;
    Easy'glue_begin_pass(sapp, sg, ClearAction(r = 0.15, g = 0.15, b = 0.15, a = 1));
    sgl.draw_layer(sg, 0);
    sdtx.draw_layer(0);
    put_text_boxes(state.edit&);
    // i want wire comments behind field backgrounds but needs to be after updated all the buffers
    // TODO: the field label doesn't have a background so they overlap in an ugly way
    state.edit.text_box.text.default_context&.draw_layer(wire_comment_text_layer);   
    draw_text_boxes(state.edit&, sg, vec2(sapp.width().float().cast(), sapp.height().float().cast()));
    sg.end_pass();
    sg.commit();
};
wire_comment_text_layer :: 500;

Draw :: @struct {
    state: *State #use;
    diagram_pos: Vec2 = vec2(0);
    screen_scale: Vec2;
    sdtx: *Sdtx.Context;
    label_sdtx: *Sdtx.Context;
    have_logic: bool;
    emphasized_wire_positions: RawList(Vec2) = empty();
    hovered_wire_index: ?i64 = .None;
    mouse_world_pos: Vec2;
    wires: []WireValue = empty();
    wire_value_colour: Array(u32, 2) = (pack_rgba(150, 150, 255, 255), pack_rgba(255, 0, 150, 255));
    out: *List(u8);
    text_spacing := vec2(0);
    wire_node_width: f32 = 0.025;
    wire_hover_count: f32 = 1;
    logical: ?*Component = .None;
    hover_logical_code: ?i64 = .None;
    base_instance := 0;
    open_gate: ?Ty(?i64, ?i64, bool) = .None;
    open_level: ?i64 = .None;
    set_hover_wire := false;
};

fn do_option(self: *Draw, pos: Vec2, name: Str, selected: bool, value: ~T, new: *?T) void #where = {
    sdtx, state := (self.sdtx, self.state);
    sdtx.pos = self.world_to_text_pos(self.text_spacing * pos);
    p := self.world_to_text_pos(self.mouse_world_pos);
    hover := p.x > sdtx.pos.x && p.x < sdtx.pos.x + name.len.float().cast() && p.y > sdtx.pos.y && p.y < sdtx.pos.y + 1;
    if hover && state.either_clicked&.take() {
        state.clicked = false;
        new[] = (Some = value);
        selected = true;
    };
    sdtx.color = pack_rgba(200, 200*int(!selected), 200*int(!hover), 255);
    sdtx.put(name);
}

fn arch_selection(self: *Draw) ?i64 = {
    state := self.state;
    new: ?i64 = .None;
    arch_list_count: f32 = 0;
    selected_circuit := @if(state.tree.len == 0, -1, state.tree[0].diagram_circuit || -1);
    // TODO: list them from the save dir even if don't ask for a specific one on cli
    enumerate state.circuit { i, c |
        continue :: local_return;
        @if(!c.is_arch) continue();
        pos := vec2(0, (7 + arch_list_count));
        self.do_option(pos, c.name, i == selected_circuit, i, new&);
        arch_list_count += 1;
    };
    new
}

fn walk_component_tree(self: *Draw, c: **Component) Ty(i64, i64, i64, *Component) = {
    logical_c := c[];
    state := self.state;
    instance, parent_wire_offset, wire_offset := (0, 0, 0);
    self.put_text(self.text_spacing * vec2(0, 1), pack_rgba(255, 255, 255, 255)) { out |
        enumerate state.tree.items().rest(1) { tree_i, tree_it |
            logical_gate := tree_it.logical_gate;
            if logical_gate { it |
                if c.has_bidirectional_pins {
                    @fmt(out, "(%)", c.name);
                    logical_gate = .None;
                    if tree_it.inline_index_logical { ii |
                        if tree_it.inline_parent_diagram { ci |
                            ci := state.circuit[ci]&;
                            if ci.compiled { parent_kind |
                                logical_gate = (Some = ii);
                                c[] = state.world&[parent_kind]&;
                            };
                        };
                    };
                } else {
                    @fmt(out, "%[%]", c.name, it);
                };
                @fmt(out, ", ");
            };
            
            if logical_gate { it |
                if c.gates[it].pre_read != -1 {
                    it = c.gates[it].pre_read;
                };
                parent_wire_offset = wire_offset;
                wire_offset += c.wire_count;
                range(0, it) { i |
                    if c.gates[i].pre_read == -1 {
                        child := state.world&[c.gates[i].kind]&;
                        wire_offset += child.wire_sum;
                    }
                };
                instance += c.instance_offset_by_gate[it];
                c[] = state.world&[c.gates[it].kind]&;
                logical_c = c[];
            } else {
                if tree_it.component { kind |
                    @if(tree_it.logical_gate.is_none()) @if(c.has_bidirectional_pins, @fmt(out, "(%), ", c.name), @fmt(out, "%, ", c.name));
                    c[] = state.world&[kind]&;
                };
            };
        };
        @if(c.has_bidirectional_pins, @fmt(out, "(%)", c.name), out.push_all(c.name));
        @if(!state.show_logic_trace) out.clear();
    };
    (instance, parent_wire_offset, wire_offset, logical_c)
}

fn instance_by_gate(self: *Draw, c: *Component, i: i64) i64 = {
    @if(!c.has_bidirectional_pins) return(self.base_instance + c.instance_offset_by_gate[i]);
    
    state, world := (self.state, self.world&);
    @debug_assert(identical(c, world[state.tree[state.tree.len - 1].component.expect("component")]&), "TODO: instance_by_gate not of bottom");
    parent_ci, logical_gate_index := find_index_in_real_parent(state, false, i).unwrap();
    parent := world[state.circuit[parent_ci].compiled.expect("compiled")]&;
    self.base_instance + parent.instance_offset_by_gate[logical_gate_index]
}

fn draw_component_code(self: *Draw, c: *Component, instance: i64, parent_wire_offset: i64) void = {
    sdtx, state := (self.sdtx, self.state);
    @if(!state.show_logic_trace) return();
    pos := vec2(0, 0);
    if c.gates.len == 0 {
        p := self.mouse_world_pos;
        hover := p.y < pos.y && p.y > pos.y - self.text_spacing.y && p.x > 0 && p.x < 100;
        sdtx.origin = self.world_to_text_pos(vec2(0, 0));
        sdtx.pos = vec2(0);
        self.draw_primitive_code(instance, parent_wire_offset, hover);
        if hover && state.clicked&.take() {
            self.open_gate = (Some = (.None, .None, true));
        };
        sdtx.origin = vec2(0);
    };
    enumerate c.gates { i, it |
        p := self.mouse_world_pos;
        hover := p.y < pos.y && p.y > pos.y - self.text_spacing.y && p.x > 0 && p.x < 100;
        sdtx.pos = self.world_to_text_pos(pos);
        self.draw_gate_code(it, hover);
        pos.y -= self.text_spacing.y;
        
        if hover && state.clicked&.take() {
            self.open_gate = (Some = ((Some = i), .None, i == 0 || i == c.gates.len - 1));
        };
    };
};

// TODO: show the right inferred (param, wire widths) for a temporary_auto_width inside a has_bidirectional_pins
fn draw_gate_code(self: *Draw, it: *Component.Gate, hover: bool) void = {
    sdtx, world := (self.sdtx, self.world&);
    base_colour := @if(hover, pack_rgba(0, 255, 0, 255), pack_rgba(255, 255, 0, 255));
    if it.post_read == -1 {
        for(it.outputs, fn(it) => self.show_wire_value(it, false));
    };
    sdtx.color = base_colour;
    child := world[it.kind]&;
    name := child.name;
    @if(it.outputs.len > 0 && it.post_read == -1) sdtx.put("= ");
    sdtx.put(@tfmt("%( ", name));
    if child.has_param {
        buf := i64.cast_to_bytes(it.param&);
        while => buf.len > 1 && buf[buf.len - 1] == 0 {
            buf.len -= 1;
        };
        out := self.out;
        for_rev buf { c |
            push_hex_byte(out, c, false);
        };
        sdtx.put(out.items());
        sdtx.put(" ");
        self.out.clear();
    };
    if it.pre_read == -1 {
        for(it.inputs, fn(it) => self.show_wire_value(it, false));
    } else {
        for child.inputs_for_pure_eval { i |
            self.show_wire_value(it.inputs[i], false);
        };
    };
    sdtx.color = base_colour;
    sdtx.put(");");
    
    sdtx.color = pack_rgba(200, 0, 200, 255);
    @if(it.pre_read != -1) sdtx.put(" PRE");
    @if(it.post_read != -1) sdtx.put(" POST");
    if self.logical { c |
        gate_i := ptr_diff(c.gates.ptr, it);
        if hover {
            self.hover_logical_code = (Some = gate_i);
        };
        
        @if(it.pre_read != -1) sdtx.put(@tfmt(" #%", it.pre_read));
        @if(it.post_read != -1) sdtx.put(@tfmt(" #%", gate_i));
        sdtx.color = pack_rgba(200, 0, 200, 100);
        @if(c.gates_needed_for_pure_eval&.get(gate_i)) sdtx.put(" R");
    };
    if it.temporary_auto_width {
        sdtx.color = pack_rgba(200, 0, 200, 100);
        sdtx.put(" *");
    };
}

fn draw_primitive_code(self: *Draw, instance: i64, parent_wire_offset: i64, hover: bool) void = {
    sdtx, state, world, out := (self.sdtx, self.state, self.world&, self.out);
    
    sdtx.color = @if(hover, pack_rgba(0, 255, 0, 255), pack_rgba(255, 255, 0, 255));
    sdtx.put("output(intrinsic(input()));\n");
    
    @assert(self.have_logic && state.tree.len >= 2);
    parent_kind := state.tree[state.tree.len - 2].component.unwrap();
    gate_i := state.tree[state.tree.len - 1].logical_gate.unwrap();
    
    parent := world[parent_kind]&;
    it := parent.gates[gate_i]&;
    n := get_storage_count(world.components, it);
    // TODO: make this work when has_bidirectional_pins
    if !state.halted_without_wire_values && !parent.has_bidirectional_pins {
        // show callsite in the parent
        self.wires = world.scratch.items().subslice(parent_wire_offset, parent.wire_count);
        self.logical = (Some = parent);
        self.draw_gate_code(it, false);
        
        if is_linkable(it.kind) {
            if state.tree[state.tree.len - 2].diagram_circuit { c |
                c := state.circuit[c]&;
                if state.tree[state.tree.len - 1].graphical_gate { i |
                    it := c.gates[i]&;
                    while => it.port_linked_list != -1 {
                        sdtx.put("\n> ");
                        it = c.gates[it.port_linked_list]&;
                        if it.logical_gate_index != -1 {
                            self.draw_gate_code(parent.gates[it.logical_gate_index]&, false);
                        };
                    };
                };
            };
        };
        
        self.wires = empty();
        self.logical = .None;
    };
    
    @if(n == 0 && !world[it.kind].has_param) return();
    
    // TODO: unpack `param` in a readable way
    sdtx.color = pack_rgba(255, 255, 255, 255);
    sdtx.put(@tfmt("\n(storage_count=%, instance=%, param=%)\n", n, instance, fmt_hex(it.param)));
    
    if state.tree[state.tree.len - 2].diagram_circuit { c |
        c := state.circuit[c]&;
        if state.tree[state.tree.len - 1].graphical_gate { i |
            it := c.gates[i]&;
            if it.label.len != 0 {
                sdtx.put(it.label.items());
                sdtx.put("\n");
            };
        };
    };
    
    // show contents of the memory this gate owns
    data := world.storage.subslice(instance, n.min(4096)).interpret_as_bytes();
    enumerate data { i, c |
        @if(i.umod(16) == 0) sdtx.put("\n");
        push_hex_byte(out, c[], true);
        sdtx.put(out.items());
        sdtx.pos.x += 1;
        out.clear();
    };
}

fn show_wire_value(self: *Draw, id: WireId, is_for_graphical_node: bool) = {
    sdtx, state, wires, out := (self.sdtx, self.state, self.wires, self.out);
    @if(!self.have_logic) return();
    i := id.id.zext();
    if state.show_wire_ref_lines {
        start := sdtx.pos;
        end := start + vec2(6, 1);
        p := self.world_to_text_pos(self.mouse_world_pos);
        hover := p.x > start.x && p.x < end.x && p.y > start.y && p.y < end.y;
        if hover {
            self.set_hover_wire = true;
            state.prev_emphasized_wire = (Some = id);
            self.hovered_wire_index = (Some = self.emphasized_wire_positions.len);
        };
    
        if state.prev_emphasized_wire { prev |
            if !is_for_graphical_node && prev.id == id.id {
                self.emphasized_wire_positions&.push(sdtx.pos, temp());
            };
        };
    };

    ok := i.ult(self.wires.len);
    value := @if(!ok, 0, self.wires[i]);
    sdtx.color = self.wire_value_colour&[int(value != 0)];
    sdtx.put(@tfmt("w%", id.id));
    sdtx.color = pack_rgba(150, 150, 150, 255);
    if ok {
        sdtx.put("=");
        c := self.logical.unwrap();
        bit_width: i64 = @if(i.ult(c.wire_bit_width.len), c.wire_bit_width[i].zext(), 64);
        if bit_width == 1 {
            @fmt(out, "%", value);
        } else {
            w := @if(bit_width == 0, 8, bit_width.ualign_to(8).udiv(8).min(8));
            for_rev i64.cast_to_bytes(value&).slice(0, w) { c |
                push_hex_byte(out, c, false);
            };
            @if(false) @fmt(out, ":%", bit_width);
        };
    };
    sdtx.put(out.items());
    out.clear();
    sdtx.put(" ");
};

// TODO: still draw warnings if loaded 0 graphical circuits (ex. cli arg of circuit.data with bad version)
//       (better might be to do auto layout for the defs.fr and then always have a graphical circuit)
fn draw_circuit_background(self: *Draw, circuit: *Tc.Circuit) void = {
    sdtx, state, sgl := (self.sdtx, self.state, self.draw&);
    hi, lo := (circuit.max + vec2(1), circuit.min - vec2(1));
    size := abs(hi - lo);
    circuit_top_right := self.tc_to_world_pos(lo + vec2(size.x, 0));
    goal_top_right := self.text_spacing * vec2(-30, 2);
    self.diagram_pos = goal_top_right - circuit_top_right;
    
    {  // vaguely the grid for custom component pins
        grid_size :: 8;
        sgl.color = pack_rgba(40, 40, 40, 255);
        start := lo.x.cast().int().align_back(grid_size).float().cast();
        p := vec2(start, lo.y);
        while => p.x < hi.x {
            a, b := (self.tc_to_world_pos(p), self.tc_to_world_pos(p + vec2(0, size.y)));
            sgl.line(a, b, 0.01);
            p.x += grid_size.float().cast();
        };
        start := lo.y.cast().int().align_back(grid_size).float().cast();
        p := vec2(lo.x, start);
        while => p.y < hi.y {
            a, b := (self.tc_to_world_pos(p), self.tc_to_world_pos(p + vec2(size.x, 0)));
            sgl.line(a, b, 0.01);
            p.y += grid_size.float().cast();
        };
    };
    
    // border around the whole diagram
    a, b := (self.tc_to_world_pos(lo), self.tc_to_world_pos(hi));
    s := abs(a - b);
    w: f32 = 0.03;
    sgl.color = pack_rgba(20, 20, 20, 255);
    sgl.line(a, a + vec2(s.x, 0), w);
    sgl.line(a, a - vec2(0, s.y), w);
    sgl.line(b, a + vec2(s.x, 0), w);
    sgl.line(b, a - vec2(0, s.y), w);
    
    sdtx.color = pack_rgba(50, 200, 150, 255);
    sdtx.pos = self.world_to_text_pos(goal_top_right) + vec2(-circuit.name.len().float().cast(), -2);
    sdtx.put(circuit.name);
};

fn hovering_node(self: *Draw, b: Vec2) bool = {
    W, p := (self.wire_node_width, self.mouse_world_pos);
    p.y < b.y + W/2 && p.y > b.y - W/2 && p.x > b.x - W/2 && p.x < b.x + W/2
}

fn draw_gate_squares(self: *Draw, circuit: *Tc.Circuit) void = {
    sdtx, state, sgl, W := (self.sdtx, self.state, self.draw&, self.wire_node_width);
    e := state.edit&;
    had_hover := false;
    enumerate circuit.gates { g_gate_index, it |
        b := self.tc_to_world_pos(it.pos);
        hover := self.hovering_node(b) && e.no_selection();
        hover := hover || (e.hovered_gate || -1) == g_gate_index;
        sgl.color = pack_rgba(100, 100, 100, 255);
        if hover {
            if it.logical_gate_index != -1 {
                self.hover_logical_code = (Some = it.logical_gate_index);
            };
            if state.show_wire_ref_lines && it.inline_record != 0xFFFFFFFF {
                if self.logical { c |
                    sgl.color = pack_rgba(0, 150, 255, 255);
                    self.highlight_inlined(it.inline_record, c);
                };
            };
            
            info := Tc'get_builtin_shape(it.kind);
            sgl.color = pack_rgba(200, 200, 200, 255);
            sdtx.color = pack_rgba(255, 255, 255, 255);
            name := info.display_name(it, state.circuit);
            sdtx.pos = self.world_to_text_pos(b) + vec2(0, self.wire_hover_count);
            base := sdtx.pos.x;
            sdtx.put(@tfmt("(%, %) %", it.pos.x, it.pos.y, name));
            self.wire_hover_count += 1;
            had_hover = true;
            
            if e.is_double_click&.take() {
                hover_gate(e, (Some = g_gate_index), circuit);
            };
            
            if it.settings.len != 0 {
                sdtx.put(" [");
                each it.settings { s |
                    sdtx.put(@tfmt("%,", s));
                };
                sdtx.put("]");
            };
            
            if state.show_wire_ref_lines {
                sdtx.put(@tfmt(" %", it.link_id));
            };
            
            put_line :: fn(s: Str) => if s.len != 0 {
                sdtx.pos.x = base;
                sdtx.pos.y += 1;
                sdtx.put(s);
            };
            
            put_line(it.label.items());
            if group(it.kind) == .Tc2 && @is(Tc'gate_name(it.kind, .Tc2), .Static_eval, .Constant, .Static_indexer, .Halt_v2) {
                put_line(it.data.items());
            };
            
            if state.clicked {
                if e.enable {
                    if e.no_selection() {
                        e.select_gate((Some = g_gate_index), circuit, false);
                        state.clicked = false;
                    };
                } else {
                    state.clicked = false;
                    self.open_gate = (Some = (.None, (Some = g_gate_index), false));
                };
            };
            
            if group(it.kind) == .Tc2 && Tc'gate_name(it.kind, .Tc2) == .Push_button {
                paused := !state.auto_eval;
                r, g := (int(!state.left_mouse_down || paused), int(state.left_mouse_down || paused));
                sgl.color = pack_rgba(255 * r, 255 * g, 0, 255);
            };
        };
        sgl.line(b - vec2(0, W/2), b + vec2(0, W/2), W);
    };
    e.is_double_click = false;
}

// TODO: dont like that sometimes the connecting lines are under or over the nodes. do two loops to be consistant
//       (can see the difference when hover so colour changes)
fn draw_wires(self: *Draw, circuit: *Tc.Circuit) void = {
    sdtx, sgl, W, state := (self.sdtx, self.draw&, self.wire_node_width, self.state);
    prev_hover := state.prev_emphasized_wire&;
    already_wrote_position := false;
    enumerate circuit.wires { wire_i, wire |
        // TODO: draw lines on hover if teleport so you can see where it goes. TODO: ui for placing teleport wires? or does that make it boring?
        teleport := wire.teleport;
        base_colour := pack_rgba(100, 50, 50 * int(!teleport), 255);
        if wire.colour != 0 && wire.colour < wire_colours.len().trunc() {
            base_colour = wire_colours[wire.colour.zext()];
        };
        hover_colour := pack_rgba(150, 50, 50, 255);
        self.draw_wire_comment(wire);
        enumerate wire.path { i, it |
            sgl.color = base_colour;
            b := self.tc_to_world_pos(it.pos);
            hover := self.hovering_node(b);
            if hover && wire.logical.id != 0xFFFFFFFF && !already_wrote_position {
                self.set_hover_wire = true;
                prev_hover[] = (Some = wire.logical);
                self.hovered_wire_index = (Some = self.emphasized_wire_positions.len);
                self.emphasized_wire_positions&.push(self.world_to_text_pos(b), temp());
            };
            if prev_hover[] { prev |
                // in edit mode, logical wires haven't been merged yet so meaningless
                if !state.edit.enable && state.show_wire_ref_lines && prev.id == wire.logical.id {
                    sgl.color = hover_colour;
                };
            };
            if i != 0 && !teleport {
                a := self.tc_to_world_pos(wire.path[i - 1].pos);
                sgl.line(a, b, W/2.5);
            };
            
            // TODO: be able to hover the pin of a disconnected gate where there's no graphical wire to see value
            if hover {
                sdtx.pos = self.world_to_text_pos(b) + vec2(0, self.wire_hover_count);
                base := sdtx.pos.x;
                sdtx.color = pack_rgba(255, 255, 255, 255);
                sdtx.put(@tfmt("% % ", wire_i, wire.colour));
                if !circuit.has_bidirectional_pins && wire.logical.id != 0xFFFFFFFF {
                    if !already_wrote_position || wire.logical.id != prev_hover.Some.id {
                        self.show_wire_value(wire.logical, true);
                    };
                };
                sdtx.color = pack_rgba(255, 255, 255, 255);
                if !already_wrote_position {
                    sdtx.put(@tfmt(" (%, %)", it.pos.x, it.pos.y));
                    already_wrote_position = true;
                };
                self.wire_hover_count += 1;
                
                if wire.comment.len != 0 {
                    sdtx.color = pack_rgba(200, 200, 200, 255);
                    sdtx.pos = self.world_to_text_pos(b) + vec2(0, self.wire_hover_count);
                    self.wire_hover_count += 1;
                    sdtx.put(wire.comment);
                };
                
                sgl.color = hover_colour;
            };
            
            real := i == 0 || i == wire.path.len - 1;  // else: only for routing, can't connect to pins
            s: f32 = @if(real, 1, 0.6);
            sgl.line(b - vec2(0, W/2*s), b + vec2(0, W/2*s), W*s);
        };
    };
    if !self.set_hover_wire && prev_hover.is_some() {
        prev_hover[] = .None;
        state.dirty = true;
    };
}

// TODO: seperate out all the hover and do it at the end
fn draw_pin_lines(self: *Draw, circuit: *Tc.Circuit) void = {
    sdtx, state, sgl, W := (self.sdtx, self.state, self.draw&, self.wire_node_width);
    @if(state.loader.progress == .Loading) return();
    
    each circuit.gates { it |
        a := self.tc_to_world_pos(it.pos);
        if !state.edit.enable && it.port_linked_list.ult(circuit.gates.len) {
            b := self.tc_to_world_pos(circuit.gates[it.port_linked_list].pos);
            sgl.color = pack_rgba(143, 186, 255, 50);
            sgl.line(a, b, W/4);
        };
        
        // guide lines so you can see where to place the port to link them
        if state.edit.enable && group(it.kind) == .Tc2 && is_linkable(it.kind) {
            h := height_of_port(name(it.kind, .Tc2));
            if h != 0 {
                sgl.color = pack_rgba(255, 0, 255, 100);
                b := self.tc_to_world_pos(it.pos + vec2(0, h));
                sgl.line(a, b, W/4);
            };
        };
        
        info := Tc'get_builtin_shape(it.kind);
        for_pins(info, it, state.circuit) { i, dx, dy |
            b := self.tc_to_world_pos(it.pos + vec2(dx.float().cast(), dy.float().cast()));
            
            out_arity, in_arity := get_arity(info, it, state.circuit, @static u8.list(panicking_allocator));
            is_input := i >= out_arity;
            sgl.color = pack_rgba(0, 100 * int(in_arity + out_arity > 0), 100 * int(!is_input), 255);
            sgl.line(a, b, W/4);
            
            hover := self.hovering_node(b);
            if hover {
                sdtx.pos = self.world_to_text_pos(b) + vec2(0, self.wire_hover_count);
                sdtx.color = pack_rgba(255, 255, 255, 255);
                name := info.display_name(it, state.circuit);
                sdtx.put(@tfmt("% %[%]", name, @if(is_input, "in", "out"), @if(is_input, i - out_arity, i)));
                child := find_custom_impl(it, state.circuit);
                pin_names := @if(child.is_some(), child.Some.pin_names, info.pin_names);
                if pin_names.len != 0 && pin_names[i].len != 0 {
                    sdtx.put(@tfmt("=%", pin_names[i]));
                };
                
                if it.logical_gate_index != -1 {
                    sdtx.put(@tfmt(" [%]", it.logical_gate_index));
                };
                self.wire_hover_count += 1;
            };
        };
    };
}

fn draw_gate_hover_line(self: *Draw, circuit: *Tc.Circuit) void = {
    @if(!self.show_wire_ref_lines) return();
    logical_i := self.hover_logical_code || return();
    c := self.logical || return();
    it := c.gates[logical_i]&;
    sgl := self.draw&;
    sgl.color = pack_rgba(0, 255, 255, 255);
    
    code_x: f32 = -1;
    a := vec2(code_x, -logical_i.float().cast() - 0.3) * self.text_spacing;
    other_i := max(it.pre_read, it.post_read);
    if other_i != -1 {
        b := vec2(code_x, -other_i.float().cast() - 0.3) * self.text_spacing;
        sgl.line(a, b, 0.005);
    };
    
    if it.pre_read != -1 {
        logical_i = it.pre_read;
    };
    if circuit.gates.find(fn(it) => it.logical_gate_index == logical_i) { it |
        b := self.tc_to_world_pos(it.pos);
        sgl.line(a, b, 0.005);
    };
    if it.inline_record != 0xFFFFFFFF { // && !circuit.has_bidirectional_pins {
        sgl.color = pack_rgba(0, 150, 255, 255);
        b := self.tc_to_world_pos(circuit.gates[circuit.inlined[it.inline_record.zext()].gate_i].pos);
        sgl.line(a, b, 0.005);
        
        self.highlight_inlined(it.inline_record, c);
    };
}

fn highlight_inlined(self: *Draw, inline_record: u32, c: *Component) void = {
    sgl := self.draw&;
    code_x: f32 = -1;
    enumerate c.gates { y, gate |
        if gate.inline_record == inline_record {
            a := vec2(code_x - 0.3, -y.float().cast() + 0.1) * self.text_spacing;
            b := vec2(code_x - 0.3, -y.float().cast() - 0.9) * self.text_spacing;
            sgl.line(a, b, 0.01);
        };
    };
}

// TODO: pre-clip the whole thing if it can't be in the view port
fn draw_undo_tree(self: *Draw) void = {
    state, e, sgl, sdtx := (self.state, self.edit&, self.draw&, self.sdtx);
    if !(state.tree.len > 0 && e.enable && e.show_undo_tree && state.loader.progress == .Idle) {
        return();
    };
    c := state.current_diagram() || return();
    W := (self.wire_node_width);
    
    GraphicsUndoNode :: @struct(pos: Vec2, current: bool, seen: bool);
    graph := temp().alloc_zeroed(GraphicsUndoNode, e.next_undo_state_id);
    graph[e.current_undo_state_id].current = true;
    graph[e.current_undo_state_id].seen = true;
    
    goto: ?i64 = .None;
    
    StackEntry :: @struct(transition_index: i64, id: i64);
    stack := @ref StackEntry.list(temp());
    stack.push(transition_index = 0, id = e.current_undo_state_id);
    
    base_pos := c.min + vec2(-5, 0);
    graph[e.current_undo_state_id].pos = base_pos;
    x_shift: f32 = base_pos.x;
    while => stack.len > 0 {
        ti := stack[stack.len - 1].transition_index;
        id := stack[stack.len - 1].id;
        node := e.undo[id]&;
        if ti == 0 {
            pos := graph[id].pos;
            b := self.tc_to_world_pos(pos);
            sgl.color = pack_rgba(100, 50 + 150*int(graph[id].current), 50, 255);
            if self.hovering_node(b) {
                sdtx.pos = self.world_to_text_pos(b);
                sdtx.put(@tfmt("id=%", id));
                if node.time != 0 {
                    now := realtime_ns() / NS_PER_S;
                    s0 := now - node.time;
                    sdtx.put(@tfmt(" % ago", format_seconds(s0)));
                };
                range(0, 2) { i |
                    @if(node.do&[i] != -1 && node.do&[i].intcast() >= node.transitions.len) sdtx.put(@tfmt(" invalid_do[%](%)", i, node.do&[i]));
                };
                
                sgl.color = pack_rgba(200, 200, 200, 255);
                if state.either_clicked&.take() {
                    goto = (Some = id);
                }
            };
            sgl.line(b - vec2(0, W/2), b + vec2(0, W/2), W);
        };
        
        if ti < node.transitions.len {
            if ti > 0 {
                x_shift -= 2;
            };
            stack[stack.len - 1].transition_index += 1;
            ci := node.transitions[ti].action.child_state_id;
            child := graph[ci]&;
            if !child.seen {
                child.seen = true;
                child.pos = vec2(x_shift, graph[id].pos.y + 2);
                stack.push(transition_index = 0, id = ci);
            };
        } else {
            enumerate node.transitions { ti, it |
                sgl.color = pack_rgba(100*int(ti == node.do&[0].intcast() || ti == node.do&[1].intcast()), 50 + 50*int(ti == node.do&[0].intcast()), 50 + 50*int(ti == node.do&[1].intcast()), 255);
                b := self.tc_to_world_pos(graph[id].pos);
                a := self.tc_to_world_pos(graph[it.action.child_state_id].pos);
                
                line_pos := self.tc_to_world_pos((graph[id].pos + graph[it.action.child_state_id].pos) / 2);
                if self.hovering_node(line_pos) {
                    sdtx.pos = self.world_to_text_pos(line_pos);
                    s := slowly_display_transition(state, it.action, id) || "";
                    sdtx.put(@tfmt("  % -> %; %; ", id, it.action.child_state_id, it.action.data&.tag()));
                    sdtx.put(s);
                    sgl.color = pack_rgba(200, 200, 200, 255);
                };
                
                sgl.line(a, b, W/2.5);
            };
            stack.pop();
        };
    };
    
    // TODO: dont leave redo dust in the tree
    if goto { goal |
        state.ensure_holding_nothing();  // can add nodes so needs to be before path finding. 
        
        // TODO: detect cycles even tho there shouldn't be any because i don't deduplicate states
        path := @ref list(@struct(node: i64, edge := 0), temp());
        current := e.current_undo_state_id&;
        path.push(node = current[]);
        while => path.len > 0 && path[path.len - 1].node != goal {
            it := path[path.len - 1]&;
            if it.edge < e.undo[it.node].transitions.len {
                t := e.undo[it.node].transitions[it.edge];
                it.edge += 1;
                path.push(node = t.action.child_state_id);
            } else {
                path.pop();
            };
        };
        
        if path.len == 0 {
            @fmtln(state.warnings&, "failed to find path to target undo state. this should be unreachable");
            return();
        };
        graph := e.undo;
        _ := path.pop();
        for path { it |
            @debug_assert_eq(it.node, current[]);
            apply_transition(state, it.edge - 1);
        };
        state.dirty = true;
    };
    
    slowly_display_transition :: fn(state: *State, it: Tc.Circuit.UndoEntry, parent_state_id: i64) ?Str = {  // time to do some sketchy shit do da do da
        state.stash_undo();
        out := state.write_save(state.tree[state.tree.len - 1].diagram_circuit, false, true);
        state.unstash_undo();
        while => out.len > 0 && !out&.pop_prefix("undo") {
            out = out.rest(1);
        };
        out := out.split("\n", temp());
        
        // :TransitionString
        prefix := @tfmt(" U % % % ", it.data&.tag().raw(), parent_state_id, it.child_state_id);
        if out.find(fn(it) => it[].starts_with(prefix)) { it |
            return(Some = it[]);
        };
        .None
    };
};

fn draw_wire_comment(self: *Draw, wire: *Tc.Circuit.Wire) void = {
    state := self.state;
    if !(state.show_wire_comments && wire.comment.len != 0 && wire.path.len >= 2 && state.scale >= 0.5) {
        return();
    };
    a, b := (wire.path[wire.path.len - 2].pos, wire.path[wire.path.len - 1].pos);
    range(0, wire.path.len - 1) { i |
        if wire.path[i].pos.y == wire.path[i + 1].pos.y {
            a = wire.path[i].pos;
            b = wire.path[i + 1].pos;
        };
    };
    if a.x > b.x || (a.x == b.x && a.y > b.y) {
        t := a; a = b; b = t;
    };
    b.x -= 0.1; a.x -= 0.1;
    b.y -= 0.5; a.y -= 0.5;
    step := @if(a.x == b.x, @as(f32) 1, 2);
    dir := normalize(b - a);
    wire_length := (b - a).norm();
    text_length := wire.comment.len.float().cast() / step;
    if wire_length > text_length {
        a += dir * (wire_length - text_length) / 2;
    };
    
    sdtx := self.label_sdtx;
    sdtx.color = 0xFFFFFFFF;
    range(0, wire.comment.len) { i |
        pos := a + dir * i.float().cast() / step;
        sdtx.pos = self.world_to_text_pos(self.tc_to_world_pos(pos));
        sdtx.put(wire.comment[i]);
    };
    sdtx.pos = vec2(0);
};

fn console(self: *Draw, gate: *Tc.Circuit.Gate, c: *Component, i: i64, it: *Component.Gate) void = {
    sdtx, world, sgl := (self.sdtx, self.world&, self.draw&);
    
    sdtx.pos = vec2(0);
    a := self.tc_to_world_pos(gate.pos + vec2(-16, -8));
    sdtx.origin = self.world_to_text_pos(a);
    b := self.text_to_world_pos(sdtx.origin + vec2(80, 24));
    s := abs(a - b);
    sgl.color = pack_rgba(0, 0, 0, 255);
    sgl.line(vec2(a.x, b.y + s.y/2), vec2(b.x, b.y + s.y/2), s.y);
    
    param := it.get_param(.Console)[];
    @if(param.get(.linked) == 0) return();
    // TODO: font https://int10h.org/oldschool-pc-fonts/fontlist/font?ibm_bios-2y
    
    bytes_per_char := @if(param.get(.colour) == 0, 1, 8);
    w, h := (80, 24);
    data := {
        data := world.storage.rest(self.instance_by_gate(c, i)).interpret_as_bytes().peek_type(Tc.Builtin.ConsoleData);
        buf := world.storage.rest(data.ram_instance).interpret_as_bytes().slice(0, data.ram_size_bytes);
        start, count := (data.offset*bytes_per_char, w*h*bytes_per_char);
        @if(start.uge(buf.len)) return();
        // "LEG ARCHITECTURE 5 - console display" has too small a ram
        while => (start + count).ugt(buf.len) {
            @if(h == 0) return();
            count -= w*bytes_per_char;
            h -= 1;
        };
        buf.subslice(start, count)
    };
    
    if param.get(.colour) == 0 {
        sdtx.color = pack_rgba(255, 255, 255, 255);
        range(0, h) { y |
            range(0, w) { x |
                value := data[y*w + x];
                if value == 0 || value == "\n".ascii() || value == "\t".ascii() || value == "\r".ascii() {
                    sdtx.pos.x += 1;
                } else {
                    sdtx.put(value);
                };
            };
            sdtx.pos.x = 0;
            sdtx.pos.y += 1;
        };
    } else {
        data := i64.reinterpret_bytes(data);
        range(0, h) { y |
            range(0, w) { x |
                value := data[y*w + x];
                sdtx.color = pack_rgba(value.shift_right_logical(48).bit_and(0xFF), value.shift_right_logical(40).bit_and(0xFF), value.shift_right_logical(32).bit_and(0xFF), 255);
                my_solid_char := "\x8F".index(0)[];
                if sdtx.color != 0xff000000 {  // there's already a black background, don't bother
                    sdtx.put(my_solid_char);
                    sdtx.pos.x -= 1;
                }
                char: u8 = value.trunc();
                if char == 220 { // HACK bottom half square that tetris uses
                    char = my_solid_char - 3;
                };
                if char == 0xDB {
                    char = my_solid_char;
                };
                if char != 0 && char != "\n".ascii() && char != "\t".ascii() && char != "\r".ascii() && char != 255 {
                    sdtx.color = pack_rgba(value.shift_right_logical(24).bit_and(0xFF), value.shift_right_logical(16).bit_and(0xFF), value.shift_right_logical(8).bit_and(0xFF), 255);
                    sdtx.put(char);
                } else {
                    sdtx.pos.x += 1;
                }
            };
            sdtx.pos.x = 0;
            sdtx.pos.y += 1;
        };
    };
};

fn segment_display(self: *Draw, gate: *Tc.Circuit.Gate, c: *Component, i: i64, it: *Component.Gate) void = {
    world, sgl := (self.world&, self.draw&);
    base := self.tc_to_world_pos(gate.pos + vec2(-1, -1.5 - @if(gate.kind.group() == .Tc2, 1, 0)));
    w: f32 = 0.02;
    s: f32 = 0.06;
    colour_index := it.param.clamp(0, 3);
    mask := world.storage[self.instance_by_gate(c, i)];
    empty := pack_rgba(0, 0, 0, 255);
    // TODO: don't have the lines overlap
    range_rev(0, 8) { i |  // TODO: make calling for_bits more convenient
        on := mask.bit_and(1.shift_left(i)) != 0;
        sgl.color = @if(on, segment_colours[colour_index], empty);
        da, db := segment_lines[i];
        a, b := (base + da*s * vec2(1, -1), base + db*s * vec2(1, -1));
        sgl.line(a, b, w);
    };
}

fn probe_bit(self: *Draw, pos: Vec2, c: *Component, i: i64) void = {
    self.probe_bit(pos, self.instance_by_gate(c, i));
}

fn probe_bit(self: *Draw, pos: Vec2, instance: i64) void = {
    state, sgl, W := (self.state, self.draw&, self.wire_node_width * 0.8);
    value := state.world.storage[instance] != 0;
    b := self.tc_to_world_pos(pos);
    sgl.color = pack_rgba(255 * int(!value), 255 * int(value), 0, 255);
    sgl.line(b - vec2(0, W/2), b + vec2(0, W/2), W);
}

fn level_gate(self: *Draw, pos: Vec2, c: *Component, i: i64) void = {
    instance := self.instance_by_gate(c, i);
    state, sgl, W := (self.state, self.draw&, self.wire_node_width * 0.8);
    data := state.world.storage.rest(instance).interpret_as_bytes().peek_type(Tc.Builtin.LevelGateData);
    b := self.tc_to_world_pos(pos);
    sgl.color = pack_rgba(255 * int(!data.output), 255 * int(data.input), 255 * int(data.level_index == -1), 255);
    sgl.line(b - vec2(0, W/2), b + vec2(0, W/2), W);
    on := state.left_mouse_down && self.hovering_node(self.tc_to_world_pos(pos));
    if on && data.level_index != -1 {
        if data.input || self.show_wire_ref_lines {
            self.open_level = (Some = data.level_index.intcast());
        };
    };
}

// TODO: collect the list of probes like i do for pins :SLOW
// TODO: include this in circuit bounds
// TODO: word probes? static value. 
fn child_probes(self: *Draw, gate: *Tc.Circuit.Gate, parent: *Tc.Circuit) void = {
    state, world := (self.state, self.world&);
    inlined := gate.logical_gate_index == -1;
    c := world[gate.kind]&;
    @if(!c.has_probes) return();
    child := state.circuit.find(fn(it) => it.compiled.is_some() && it.compiled.Some.id == gate.kind.id) || return();
    pos := gate.pos + gate.mystery_spice_minus_fifteen_for_custom_pins + vec2(15);
    
    prev_instance := self.base_instance;
    parent_c := world[parent.compiled.unwrap()]&;
    if !inlined {
        self.base_instance = self.instance_by_gate(parent_c, gate.logical_gate_index);
    };
    each child.gates { it |
        i := it.logical_gate_index;
        is_probe := false
            || (it.kind.group() == .Tc1 && it.kind.name(.Tc1) == .ProbeWireBit)
            || (it.kind.group() == .Tc2 && it.kind.name(.Tc2) == .Probe_wire_bit);
        if i != -1 && is_probe {
            x, y := Tc'fix_pin_position(it.pos);
            pos := pos + vec2(x.float().cast(), y.float().cast());
            
            // TODO: screen->ram lines should be conditional like this too because the tend to be ugly going across a bunch of wires 
            // so you can see who the probe belongs to
            b := self.tc_to_world_pos(pos);
            if self.hovering_node(b) {
                a := self.tc_to_world_pos(gate.pos);
                sgl, W := (self.draw&, self.wire_node_width);
                sgl.color = pack_rgba(200, 50, 200, 150);
                sgl.line(a, b, W/4);
            };
            
            if inlined {
                i := parent.inlined[gate.inline_record].gates[i];
                if i != -1 {
                    off := parent_c.instance_offset_by_gate[i];
                    self.probe_bit(pos, self.base_instance + off);
                };
            } else {
                self.probe_bit(pos, c, i);
            };
        };
    };
    self.base_instance = prev_instance;
}

// TODO: should write a texture instead of doing it with 6 vertices per pixel
fn dot_matrix_display(self: *Draw, gate: *Tc.Circuit.Gate, c: *Component, i: i64, _: *Component.Gate) void = {
    world, sgl := (self.world&, self.draw&);
    data := world.storage.rest(self.instance_by_gate(c, i)).interpret_as_bytes().peek_type(Tc.Builtin.DotData);
    buf := data.active&;
    
    i := 0;
    w: f32 = 0.017;
    p := self.tc_to_world_pos(gate.pos + vec2(-1.5, -1.5));
    range(0, 8) { y |
        range(0, 6) { x |
            r, g, b := (buf[i].shift_right_logical(24).bit_and(0xFF), buf[i].shift_right_logical(16).bit_and(0xFF), buf[i].shift_right_logical(8).bit_and(0xFF));
            sgl.color = pack_rgba(r.zext(), g.zext(), b.zext(), 255);
            sgl.line(p + vec2(0, w/2), p + vec2(w, w/2), w);
            p.x += w;
            i += 1;
        };
        p += vec2(-6 * w, -w);
    };
}

fn sprite_display(self: *Draw, gate: *Tc.Circuit.Gate, c: *Component, i: i64, it: *Component.Gate) void = {
    state, world, sgl := (self.state, self.world&, self.draw&);
    data := world.storage.rest(self.instance_by_gate(c, i)).interpret_as_bytes().peek_slice(Tc.Builtin.SpriteData, 256);
    p := self.tc_to_world_pos(gate.pos + vec2(-16.5, 12));
    @debug_assert(state.atlas.enable, "SpriteDisplay but no atlas");
    uv0, uv1, texture_size := state.atlas.uvs&.get(it.param) || return();
    uv_size := abs(uv0 - uv1);
    sgl.color = 0xFFFFFFFF;
    w: f32 = 1.08;
    logical_screen_size := vec2(640, 480);
    
    aspect := logical_screen_size.y/logical_screen_size.x;
    p0 := p; p1 := p0 + vec2(w, w*aspect);
    sgl.v2f(p0.x, p0.y);
    sgl.v2f(p1.x, p0.y);
    sgl.v2f(p1.x, p1.y);
    sgl.v2f(p0.x, p1.y);
    
    enumerate data { sprite_i, it |
        continue :: local_return;
        @if(it.w * it.h == 0) continue();
        V :: fn(x: u16, y: u16) Vec2 = vec2(x.int().float().cast(), y.int().float().cast());
        src, dest, size := (
            V(it.src_x, it.src_y).min(texture_size), 
            V(it.dest_x, it.dest_y).min(texture_size), 
            V(it.w, it.h).min(logical_screen_size),
        );
        dest.y = logical_screen_size.y - dest.y - size.y;
        
        uv0 := uv0 + src/texture_size * uv_size;
        uv1 := min(uv1, uv0 + size/texture_size * uv_size);
        p0 := p + dest/logical_screen_size * w;
        p1 := p0 + size/logical_screen_size * w * vec2(1, aspect);
        
        sgl.v2f_t2f(p0.x, p0.y, uv0.x, uv1.y);
        sgl.v2f_t2f(p1.x, p0.y, uv1.x, uv1.y);
        sgl.v2f_t2f(p1.x, p1.y, uv1.x, uv0.y);
        sgl.v2f_t2f(p0.x, p1.y, uv0.x, uv0.y);
    };
};

// TODO: not bounds checked so can read into next thing if config doesnt match ram size
#use("@/examples/circuit/tc/devices.fr");
fn screen(self: *Draw, gate: *Tc.Circuit.Gate, c: *Component, i: i64, it: *Component.Gate) void = {
    sdtx, world, sgl := (self.sdtx, self.world&, self.draw&);
    
    a_tc := gate.pos + vec2(-25, -19);
    a := self.tc_to_world_pos(a_tc);
    b := self.tc_to_world_pos(a_tc + vec2(4, 3)*13);
    s := abs(a - b);
    sgl.color = pack_rgba(0, 0, 0, 255);
    data, memory := world.get_screen(self.instance_by_gate(c, i));
    @if(memory.len == 0) return();
    
    if data.mode == .Ascii8 {
        sgl.color = data.background_colour.decode_8bit_colour();
    };
    sgl.line(vec2(a.x, b.y + s.y/2), vec2(b.x, b.y + s.y/2), s.y);

    @if(self.state.tick == 0) return();  // dont show whatever junk is at the start of memory before you run
    @if(data.ram_size_bytes == 0) return();
    
    width, height, _ := data.size();
    
    if @is(data.mode, .Pixel8, .Pixel32) {
        texture := temp().alloc_uninit(u32, width * height);
        extract_screen_pixels(data, texture, memory);
        
        s := self.state.screen&;
        uv0, uv1 := s.atlas&.try_push(texture, width, height) || {
            put_text(self, "RESIZING", a + vec2(0, self.text_spacing.x), pack_rgba(255, 255, 255, 255));
            s.need_resize = true;
            return();
        };
        s.enable = true;
        
        sgl.color = pack_rgba(255, 255, 255, 255);
        sgl.v2f_t2f(a.x, a.y, uv0.x, uv0.y);
        sgl.v2f_t2f(b.x, a.y, uv1.x, uv0.y);
        sgl.v2f_t2f(b.x, b.y, uv1.x, uv1.y);
        sgl.v2f_t2f(a.x, b.y, uv0.x, uv1.y);
    } else {
        i := 0;
        sdtx.pos = vec2(0);
        sdtx.origin = self.world_to_text_pos(a);
        foreground := data.foreground_colour.decode_8bit_colour();
        // TODO: fonts
        range(0, height) { y |
            range(0, width) { x |
                char, fore := @match(data.mode) {
                    fn Ascii8() => (memory[i], foreground);
                    // TODO: idk if this is the right way around
                    fn Ascii32() => {
                        v := u32.reinterpret_bytes(memory)[i];
                        back := decode_8bit_colour(v.shift_right_logical(16).trunc());
                        if back != pack_rgba(0, 0, 0, 255) {
                            sdtx.color = back;
                            sdtx.put("\x8F");
                            sdtx.pos.x -= 1;
                        };
                        (@as(u8) v.trunc(), decode_8bit_colour(v.shift_right_logical(8).trunc()))
                    }
                    @default => unreachable();
                };
                sdtx.color = fore;
                sdtx.put(char.max(32));
                
                i += 1;
            };
            sdtx.pos.x = 0;
            sdtx.pos.y += 1;
        };
    };
}

// TODO: use this for DotMatrixDisplay too 
//       but then need to deal with switching textures between this and the sprite screen one. 
//       if did that then could easily allow mixed v1/v2 components in one circuit which would be nice. 
fn finish_screens(state: *State) void = {
    s, sg := (state.screen&, state.sg);
    if s.enable&.take() {
        sg.update_image(s.img, @ref SubImage(s.atlas.buf.interpret_as_bytes()));
        s.atlas.x = 1; s.atlas.y = 1; s.atlas.current_row_height = 1;  // :WhitePixelForDrawingSolidColours
    };
    if s.need_resize&.take() {
        // do this last so any components that fit before resizing can still draw with the old texture on this frame
        state.resize_screen_atlas();
    };
}

// TODO: dont hard code this. my metal is double this but webgpu makes you ask for it in the limits. 
texture_size_limit :: 8192;
fn resize_screen_atlas(state: *State) void = {
    s, sg, a := (state.screen&, state.sg, general_allocator());
    size := 128;
    if s.img.id != 0 {
        if s.atlas.width == texture_size_limit {
            if !s.did_warning && state.loader.progress != .Loading {
                s.did_warning = true;
                @fmtln(state.warnings&, "TODO: too many screens to fit in one texture");
            };
            return();  // shit outta luck
        };
        size = min(s.atlas.width * 2, texture_size_limit);
        a.dealloc(u32, s.atlas.buf);
        @debug_assert(s.to_drop.is_none());
        s.to_drop = (Some = s.img);
        // TODO: make it work on the frame that it resizes but its only one frame so not a huge deal
    };
    s.atlas = Atlas'new_sized(a, size, size);
    _ := s.atlas&.push(@slice(0xFFFFFFFF), 1, 1);  // :WhitePixelForDrawingSolidColours
    size := size.intcast();
    s.img = sg.make(width = size, height = size, pixel_format = .BGRA8, data = zeroed(Sg.ImageData), usage = .DYNAMIC);
    
    state.dirty = true;  // last frame wasn't fully drawn, retry. 
    // without this it can't even draw the lines of the circuit on the frame it's resizing
    // because it tries to use the texture but doesn't have the white pixel yet
    sg.update_image(s.img, @ref SubImage(s.atlas.buf.interpret_as_bytes()));
}

display_name :: fn(info: *Builtin.Template, it: *Tc.Circuit.Gate, circuit: []Tc.Circuit) Str = {
    name := info.name;
    @if(it.kind.group() == .Loaded)
    if circuit.find(fn(check) => check.id == it.custom_id) { it |
        name = @tfmt("Custom (%)", it.name);
    };
    name
}

fn put_text(self: *Draw, world_pos: Vec2, colour: u32, $body: @Fn(out: *List(u8)) void) void = {
    body(self.out);
    self.put_text(self.out.items(), world_pos, colour);
    self.out.clear();
}

fn put_text(self: *Draw, text: Str, world_pos: Vec2, colour: u32) void = {
    sdtx := self.sdtx;
    sdtx.color = colour;
    sdtx.origin = self.world_to_text_pos(world_pos);
    sdtx.pos = vec2(0);
    sdtx.put(text);
    sdtx.origin = vec2(0); sdtx.pos = vec2(0);
}

fn show_alert(msg: Str, sdtx: *Sdtx.Context, sapp: *Sapp.Self) void = {
    sdtx.desc.char_height = 8;
    sdtx.desc.char_width = sdtx.desc.char_height / 2;
    sdtx.canvas(sapp, 1);
    sdtx.color = pack_rgba(255, 255, 255, 255);
    sdtx.put(msg);
}

fn tc_to_world_pos(self: *Draw, pos: Vec2) Vec2 = 
    (pos) / 30 * vec2(1, -1) + vec2(-1, -4) + self.diagram_pos;
fn world_to_tc_pos(self: *Draw, pos: Vec2) Vec2 = {
    pos := ((pos - self.diagram_pos - vec2(-1, -4)) * vec2(1, -1) * 30);
    roundf :: fn(a: f32) f32 #libc;
    vec2(pos.x.roundf(), pos.y.roundf())
}
fn world_to_text_pos(self: *Draw, pos: Vec2) Vec2 = 
    ((pos*self.scale*self.screen_scale + self.pos)*vec2(1, -1) + vec2(1)) / self.sdtx.glyph_size / 2;
fn text_to_world_pos(self: *Draw, pos: Vec2) Vec2 =
    (((pos * 2 * self.sdtx.glyph_size) - vec2(1)) * vec2(1, -1) - self.pos) / self.scale / self.screen_scale;

EditState :: @struct {
    enable: bool = false;
    selected_gate: ?i64 = .None;
    original_gate_position: ?get_variant_type(Tc.Circuit.UndoPayload, .SetGatePosition) = .None;
    placing_wire_start: ?Ty(i64, i64) = .None;   // (wire index, path index)
    action: @enum(None, NewGate, Rotate, Delete, Copy) = .None;
    placing_type := zeroed(ComponentId); 
    
    hovered_gate: ?i64 = .None;  // the one currently being edited by the text boxes. 
    last_click_time := 0;  // for double click to edit gate
    is_double_click := false;
    has_text_field := false;
    
    dont_reset: @struct {
    circuit_arena: Alloc;
    default_word_width := 8;
    text_box: Terminal.State;
    undo: RawList(Tc.Circuit.UndoNode) = empty();
    show_undo_tree := false;
    next_undo_state_id := 1;
    current_undo_state_id := 0;
    arena_gc_threshold_kb := 512*1024;
    } #use;
    active_buffer_index: ?i64 = .None;
    field_names: []Str = empty();
    show_info_box: ?i64 = .None;
    info_box_is_settings := false;
};

fn update_edit(self: *Draw, c: *Tc.Circuit, circuits: []Tc.Circuit) void = {
    state := self.state;
    e := state.edit&;
    @if(!e.enable) return();
    
    in_bounds :: fn(p) => p.x >= c.min.x && p.y >= c.min.y && p.x <= c.max.x && p.y <= c.max.y;
    if e.selected_gate { gate_i |
        gate := c.gates[gate_i]&;
        new := self.world_to_tc_pos(self.mouse_world_pos);
        if !(new == gate.pos) {
            gate.pos = new;
            state.dirty = true;
        };
        
        if state.clicked&.take() && in_bounds(new) {
            break :: local_return;
            info := Tc'get_builtin_shape(gate.kind);
            if has_pin_overlap(gate_i, c, circuits) {
                // TODO: some type of visual feedback
                break();
            };
            a := state.circuit_arena&.borrow();
            for_pins(info, gate, circuits) { _, dx, dy |
                pos := gate.pos + vec2(dx.float().cast(), dy.float().cast());
                split_for_node(c.wires&, pos, a);
            };
            
            e.select_gate(.None, c, false);
            state.dirty = true;
        };
    };
    
    if e.placing_wire_start { wire_i, path_i |
        sgl, W := (self.draw&, self.wire_node_width);
        w := c.wires[wire_i]&;
        start := w.path[path_i].pos;
        a := self.tc_to_world_pos(start);
        rounded := self.world_to_tc_pos(self.mouse_world_pos);
        inside := in_bounds(rounded);
        sgl.color = pack_rgba(100 + 150*int(!inside), 50, 50, 255);
        
        route := plan_route(start, rounded);
        for route { pos |
            b := self.tc_to_world_pos(pos);
            sgl.line(a, b, W/2.5);
            sgl.line(b - vec2(0, W/2), b + vec2(0, W/2), W);
            a = b;
        };
        
        if inside && state.clicked&.take() {
            break :: local_return;
            enumerate c.gates { i, it |
                @if(it.pos == rounded) break();
            };
            
            state.dirty = true;
            a := state.circuit_arena&.borrow();
            if w.path.len == 1 && start == rounded {
                w.path.len = 0;
                e.placing_wire_start = .None;
                break();
            };
            e.push_undo(DeleteWire = (i = wire_i));
            
                e.placing_wire_start = .None;
                
                for route { pos |
                    split_for_node(c.wires&, pos, a);
                    w.path&.push((pos = pos), a);
                };
        };
    };
    
    state.dirty = state.dirty || e.action != .None;
    @match(e.action) {
        fn NewGate() => {
            a := state.circuit_arena&.borrow();
            gate_i := c.gates&.index_of(fn(it) => it.kind.is_placeholder()) || {
                c.gates&.push(zeroed(Tc.Circuit.Gate), a);
                c.gates.len - 1
            };
            e.push_undo(DeleteGate = (i = gate_i));
            gate := c.gates[gate_i]&;
            ;{  // can't reuse pointed at stuff because its shallow copied in UndoEntry for now
                gate[] = zeroed(Tc.Circuit.Gate);  
                gate.settings = a.alloc_zeroed(i64, 2);
            };
            gate.logical_gate_index = -1;
            gate.port_linked_list = -1;
            gate.kind = e.placing_type;
            gate.pos = self.world_to_tc_pos(self.mouse_world_pos);
            
            shape := get_builtin_shape(gate.kind);
            if shape.fields.contains(fn(it) => it.name == "Width") {
                if gate.settings.len == 0 {
                    gate.settings = a.alloc_zeroed(i64, 2);
                };
                gate.settings[0] = e.default_word_width;
            };
            if gate.kind.group() == .Loaded {
                each circuits { check |
                    if check.compiled { kind |
                        if kind.id == gate.kind.id {
                            gate.custom_id = check.id;
                            gate.mystery_spice_minus_fifteen_for_custom_pins = check.cached_pin_radius.p;
                        };
                    };
                };
            };
            e.select_gate((Some = gate_i), c, true);
        }
        fn Rotate() => if e.selected_gate { gate_i |
            gate := c.gates[gate_i]&;
            gate.rotation = gate.rotation.add(1).mod(4);
        };
        fn Delete() => {
            state.clicked = false;
            a := e.circuit_arena;
            if e.selected_gate&.take() { i |
                perform_new_action(e, c, (DeleteGate = (i = i)));
            } else {
                _ := e.placing_wire_start&.take();
                pos := self.world_to_tc_pos(self.mouse_world_pos);
                enumerate c.wires { i, it |
                    each it.path { p |
                        if p.pos == pos {
                            perform_new_action(e, c, (DeleteWire = (i = i)));
                        };
                    };
                };
            };
        }
        fn Copy() => {
            a := e.circuit_arena;
            if e.selected_gate { gate_i |
                e.select_gate(.None, c, false);
                dest_i := c.gates&.index_of(fn(it) => it.kind.is_placeholder()) || {
                    c.gates&.push(zeroed(Tc.Circuit.Gate), a);
                    c.gates.len - 1
                };
                perform_new_action(e, c, (CopyGate = (i = gate_i, dest = dest_i)));
                // TODO: you want this to be `true` so undoing once doesn't setposition back to overlap the original gate but then the copy also needs to include the first destination you put it at
                e.select_gate((Some = dest_i), c, false);
            };
        }
        fn None() => ();
    };
    e.action = .None;
    
    if e.no_selection() && state.clicked&.take() {
        break :: local_return;
        rounded := self.world_to_tc_pos(self.mouse_world_pos);
        @if(!in_bounds(rounded)) break();
        enumerate c.gates { i, it |
            @if(it.pos == rounded) break();
        };
        a := state.circuit_arena&.borrow(); 
        i := c.wires&.index_of(fn(it) => it.path.len == 0) || {
            c.wires&.push((path = empty()), a);
            c.wires.len - 1
        };
        c.wires[i].path = empty(); // cant reuse because undo has shallow copy
        c.wires[i].path&.push((pos = rounded), a);
        e.placing_wire_start = (Some = (i, 0));
        // TODO: be able to undo this
        split_for_node(c.wires&, rounded, a);
        state.dirty = true;
    };
}

fn has_pin_overlap(gate_i: i64, c: *Tc.Circuit, circuits: []Tc.Circuit) bool = {
    gate := c.gates[gate_i]&;
    r := get_pin_radius(gate, circuits);
    info0 := Tc'get_builtin_shape(gate.kind);
    enumerate c.gates { i, it |
        continue :: local_return;
        @if(i == gate_i) continue();
        n := r + get_pin_radius(it, circuits);
        @if(norm_sq(it.pos - gate.pos) > n*n) continue();
        
        @if(gate.pos == it.pos) return(true);
        info1 := Tc'get_builtin_shape(it.kind);
        for_pins(info0, gate, circuits) { _, dx, dy |
            pos0 := gate.pos + vec2(dx.float().cast(), dy.float().cast());
            @if(pos0 == it.pos) return(true);
            for_pins(info1, it, circuits) { _, dx, dy |
                pos1 := it.pos + vec2(dx.float().cast(), dy.float().cast());
                @if(pos0 == pos1 || pos1 == gate.pos) return(true);
            };
        };
    };
    false
}

// TODO: either split if visual part of the new wire hits a node/pin
//       or route around nodes/pins (tc does the latter)
// TODO: track length/direction so split_for_node can work on diagonals
// TODO: dont recalculate this every render if it gets more expensive
// only allow 8 directions to simplify split_for_node
plan_route :: fn(start: Vec2, rounded: Vec2) []Vec2 = {
    dir := start - rounded;
    if dir.x != 0 && dir.y != 0 {
        extra := start;
        n := int(dir.x.abs() < dir.y.abs());
        while => dir.x.abs() != dir.y.abs() {
            extra&[n] -= @if(dir&[n] < 0, -1, 1);
            dir = extra - rounded;
        };
        it := @slice(extra, rounded);
        return it.shallow_copy(temp());
    };
    (@slice(rounded)).shallow_copy(temp())
};

fn split_for_node(wires: *RawList(Tc.Circuit.Wire), pos: Vec2, a: Alloc) void = {
    range(0, wires.len) { wire_i |
        break :: local_return;
        it := wires[wire_i]&;
        if !it.is_end(pos) {
            range(1, it.path.len) { path_i |
                // TODO: this would be easier if i already had direction/length. 
                //       rn hack that only works for cardinal directions where length can be integer
                fst, snd := (it.path[path_i - 1].pos, it.path[path_i].pos);
                dir := snd - fst;
                if norm_sq(pos - fst) < dir.norm_sq() && norm_sq(pos - snd) < dir.norm_sq() {
                    len := dir.norm();
                    dir := dir / len;
                    range(0, len.cast().int()) { _ |
                        if fst == pos {
                            old := it.path.items().rest(path_i);
                            wires.push((path = old.shallow_copy(a).as_raw_list()), a);
                            wires[wires.len - 1].path&.insert(0, (pos = pos), a);
                            it = wires[wire_i]&;
                            it.path.len = path_i;
                            it.path&.push((pos = pos), a);
                            break();
                        };
                        fst += dir;
                    };
                };
            };
        };
    };
};

fn is_end(it: *Tc.Circuit.Wire, pos: Vec2) bool =
    it.path.len > 0 && (it.path[0].pos == pos || it.path[it.path.len - 1].pos == pos);

fn no_selection(e: *EditState) bool = e.placing_wire_start.is_none() && e.selected_gate.is_none();

fn select_gate(e: *EditState, i: ?i64, c: *Tc.Circuit, spawn: bool) void = {
    if e.selected_gate { old_i |
        if ((i || -1) != old_i) {
            g := c.gates[old_i]&;
            if e.original_gate_position&.take() { it |
                @if(it.i == old_i) if !(it.pos == g.pos) || it.rotation != g.rotation {
                    e.push_undo(SetGatePosition = it);
                };
            };
        };
    };
    @if(!spawn) if i { i |
        g := c.gates[i]&;
        e.original_gate_position = (Some = (i = i, pos = g.pos, rotation = g.rotation));
    };
    
    e.selected_gate = i;
}

fn gate_selection(self: *Draw) void = {
    t :: Tc.Builtin.templates;
    state, sdtx := (self.state, self.sdtx);
    new: ?ComponentId = .None;
    enumerate gate_selection_columns { column_i, column |
        enumerate column { row_i, i |
            do_button(column_i, row_i + 24, t[i[]].name, t[i[]].kind);
        };
    };
    
    // TODO: allow placing CCs that weren't already used so don't have a kind assigned yet
    n := 0;
    each state.circuit { c |
        @if(!c.is_arch) if c.compiled { kind |
            do_button(gate_selection_columns.len(), n, c.name, kind);
            n += 1;
        };
    };
    n += 1;
    
    enumerate gate_selection_columns_v2 { column_i, column |
        enumerate column { row_i, i |
            name := i[].name_str();
            do_button(column_i, row_i, name, (id = component_offset(.Tc2) + i[].raw().zext()));
        };
    };
    
    do_button :: fn(column_i: i64, row_i: i64, name: Str, kind: ComponentId) => {
        pos := vec2(column_i.float().cast() * 24, -row_i.float().cast());
        i := kind.id.zext();
        // TODO: reusing the `selected` purple might be too aggressive
        suggested := state.show_suggested_components && i < builtin_components.len() && state.level_suggested&.get(i);
        self.do_option(pos, name, suggested, kind, new&);
    };
    
    @if(state.edit&.no_selection())
    if new { it |
        state.edit.placing_type = it;
        state.edit.action = .NewGate;
    };
}

// TODO: this needs to not look at circuit.inlined while .Loading. 
fn open_gate(state: *State, logical_gate_index: ?i64, diagram_gate_index: ?i64, is_io: bool) void = {
    new_diagram_circuit: ?i64 = .None;
    new_component: ?ComponentId = .None;
    
    @if(state.tree.len > 0)
    if logical_gate_index { i |
        if state.tree[state.tree.len - 1].component { parent |
            gate := state.world&[parent].gates[i]&;
            if gate.pre_read != -1 {
                // Circuit.Gate.logical_gate_index only points to the write one. swap so graphical can be found. 
                logical_gate_index = (Some = gate.pre_read);
            };
            new_component = (Some = gate.kind);
            
            // entering something inlined, make the tree as though you had entered each graphical CC in order. 
            if gate.inline_record != 0xFFFFFFFF {
                if state.tree[state.tree.len - 1].diagram_circuit { parent_diagram |
                    c := state.circuit[parent_diagram]&;
                    if c.gates.index_of(fn(it) => it.inline_record == gate.inline_record) { source |
                        open_gate(state, .None, (Some = source), false);
                        open_gate(state, (Some = gate.inline_index.zext()), .None, false);
                        return();
                    };
                };
            };
        };
    };

    @if(state.tree.len > 0) if state.tree[state.tree.len - 1].diagram_circuit { i |
        c := state.circuit[i]&;
        @if(logical_gate_index.is_none()) if diagram_gate_index { i |
            g := c.gates[i];
            if g.logical_gate_index != -1 {
                logical_gate_index = (Some = g.logical_gate_index);
            };
        };
        
        @if(diagram_gate_index.is_none()) if logical_gate_index { i |
            enumerate c.gates { j, g |
                if g.logical_gate_index == i {
                    diagram_gate_index = (Some = j);
                };
            };
        };
        
        if diagram_gate_index { i |
            it := c.gates[i]&;
            new_component = (Some = it.kind);
            if group(it.kind) == .Loaded {
                id := it.custom_id;
                new_diagram_circuit = state.circuit.index_of(fn(it) => it.id == id);
            };
        };
        
        if new_diagram_circuit { i |
            new_component = state.circuit[i].compiled;
        };
    };
    
    if new_component { i |
        // TODO: do this with shape.kind == .io ?
        if @is(group(i), .LogicalIO, .Tc1, .Tc2) {
            name := state.world&[i].name;
            is_io = is_io || name.contains("input") || name.contains("output") || name.contains("Input") || name.contains("Output")|| name.contains("Level_input") || name.contains("Level_output");
        };
    };
    
    if is_io {
        state.pop_tree_node();
        state.clicked = false;
        return();
    };
    
    if logical_gate_index.is_some() || new_diagram_circuit.is_some() {
        state.clicked = false;
        state.dirty = true;
        // TODO: dont bother stash/unstash when recursing for inline_record
        state.push_tree_node(
            diagram_circuit = new_diagram_circuit,
            logical_gate = logical_gate_index,
            component = new_component,
            graphical_gate = diagram_gate_index,
        );
        
        @debug_assert(state.tree.len >= 2, "just pushed");
        new := state.tree[state.tree.len - 1]&;
        if diagram_gate_index { i |
            parent_ci := state.tree[state.tree.len - 2].diagram_circuit.unwrap();
            parent := state.circuit[parent_ci]&;
            r := parent.gates[i].inline_record;
            if r != 0xFFFFFFFF {
                new.inline_record = (Some = r);
                if !parent.has_bidirectional_pins {
                    new.inline_parent_diagram = (Some = parent_ci);
                };
            };
        };
        
        if logical_gate_index { logical_gate_index |
            if find_index_in_real_parent(state, true, logical_gate_index) { parent_ci, logical_gate_index |
                new.inline_index_logical = (Some = logical_gate_index);
                new.inline_parent_diagram = (Some = parent_ci);
            };
        };
        state.recenter();
    }
}

find_index_in_real_parent :: fn(state: *State, in_tree: bool, logical_gate_index: i64) ?Ty(i64, i64) = {
    start := state.tree.len - 1 - int(in_tree);
    I := start;
    loop {
        @if(I < 0) return(.None);
        parent_ci := state.tree[I].diagram_circuit || return(.None);
        parent_c := state.circuit[parent_ci]&;
        if parent_c.has_bidirectional_pins {
            inline_record := state.tree[I].inline_record || return(.None);
            @debug_assert(I > 0, "first circuit can't be inlined");
            grand_parent_ci := state.tree[I-1].diagram_circuit || return(.None);
            grand_parent_c := state.circuit[grand_parent_ci]&;
            record := grand_parent_c.inlined[inline_record]&;
            @debug_assert_eq(grand_parent_c.gates[record.gate_i].kind.id, parent_c.compiled.Some.id, "wrong inline record");
            logical_gate_index = record.gates[logical_gate_index];
            @if(logical_gate_index == -1) return(.None);
            I -= 1;
        } else {
            @if(I == start) return(.None);
            return(Some = (parent_ci, logical_gate_index));
        };
    };
}

fn pop_tree_node(state: *State) void = {
    @if(state.tree.len <= 1) return();
    state.dirty = true;
    state.stash_undo();
    prev := state.tree&.pop().unwrap();
    state.unstash_undo();
    state.pos = prev.saved.pos;
    state.scale = prev.saved.scale;
}

fn push_tree_node(state: *State, it: CircuitNode) void = {
    it.saved = (pos = state.pos, scale = state.scale);
    state.stash_undo();
    state.tree&.push(it);
    state.unstash_undo();
}

// TODO: call this more
fn current_diagram(state: *State) ?*Tc.Circuit = {
    // TODO: tree_ready is a tad sketchy. load_path_worker pushes to the list and then sets the flag 
    //       as though that means the changes will be observed in that order. 
    //       the goal is that i can show the diagram as soon as the graphical part is loaded, don't need to wait to compile the logic. 
    @if(!state.tree_ready) return(.None);

    @if(state.tree.len == 0) return(.None);
    c := state.tree[state.tree.len - 1].diagram_circuit || return(.None);
    (Some = state.circuit[c]&)
}

fn on_init(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    state.show_suggested_components = true;
    state.show_logic_trace = true;
    state.show_wire_comments = true;
    t := state.edit.text_box&;
    // TODO: don't init_from_cli_args
    on_init(t, sapp, sg);
    Terminal'push_state(t) {
        t.full_screen_buffer = false;
        t.features = empty();
        t.features&.set(.Edit);
        t.buffers&.pop();  // :leak
        range(0, max_gate_text_fields) { i |
            buf: *Terminal'TextBuffer = empty(general_allocator());
            buf.at = (pos = (x = 20, y = 20 + 50*i.sub(1).float()), w = 300, h = 40);
            buf.single_line = i >= reserved_buffers;
            push(t.buffers&, buf);
        };
    };
    
    sapp.set_window_title("Circuitly Knot");
    state.screen.to_drop = .None;
    state.keyboard_data = .None;
    state.prev_emphasized_wire = .None;
    state.circuit_arena = init(general_allocator(), 1.shift_left(16));
    state.edit = (circuit_arena = state.circuit_arena&.borrow(), text_box = state.edit.text_box);
    sapp.desc.enable_clipboard = true;
    sapp.desc.enable_dragndrop = true;
    state.sg = sg; state.sapp = sapp;
    a := general_allocator();
    state.loader = a.box_zeroed(LoaderT);
    init(state.loader, state);
    state.canceled_compilers = list(a);
    state.text&.setup(sg = sg, allocator = a, fonts = @slice(Sdtx.font.cpc), context = (char_buf_size = 100_000));
    state.draw&.setup(allocator = general_allocator(), sg = sg, max_vertices = 1_000_000);
    init_pipeline(state.draw&, state.pipe&, sg, (colors = (
        (blend = (  // This makes transparency work
            enabled = true,
            src_factor_rgb = .SRC_ALPHA,
            dst_factor_rgb = .ONE_MINUS_SRC_ALPHA,
        )),
        ..,
    )));
    
    state.sim.text = list(general_allocator());
    l := LevelApi.builtin_levels.levels;
    state.levels = list(l.len(), a);
    for l { it |
        state.levels&.push(level = it);
    };
    state.level = state.levels[state.level_index].level;
    sync_local_storage_if_web(progress_save_path, true, 1024);
    if read_entire_file(temp(), progress_save_path) { in |
        @if_let(Save'read_progress(in, state.levels&)) fn Ok(settings) => {
            do_settings_raw(state, @ref assume_owned(settings, panicking_allocator), false); 
        };
    };
    
    state.halt_message = list(a);
    state.key_buffer = init(a, 64);
    state.frame_time_history.history = init(a, 64);
    state.tick_count_history.history = init(a, 64);
    state.tree = list(1, a);
    state.dirty = true;
    state.ticks_per_eval = 1;
    state.recenter();
    state.prev_timestamp_ns = realtime_ns();
    
    state.looking_at_examples = true;
    for cli_args() { path |
        path := path.str();
        if path.ends_with("circuit.data") || path.ends_with(".txt") {
            state.load_path_async(path, false);
        }
        if path == "-fetch" {
            state.download_schematic_archive_before_trying_to_load = true;
            state.load_path_async("Mandelbrot", false);
        }
    };
    
    // TODO: this breaks examples/gpu/cubes.fr because it wants idle to load its own thing
    if state.loader.progress == .Idle {
        state.looking_at_examples = false;
        // TODO: no warning if the file doesn't exist yet or doesnt have any circuits in it
        sync_local_storage_if_web(circuit_save_path, true, 4096);
        state.load_path_async(circuit_save_path, false);
    };
}

fn recenter(state: *State) void = {
    state.scale = 1/2;
    state.pos = vec2(0, 0.5);
}

fn end_level(state: *State) void = {
    state.win = false;
    @if(!state.level_active&.take()) return();
    state'level'end(state.level.userdata);
}

fn reset(state: *State) void = {
    state.frame_time_history&.clear();
    state.tick_count_history&.clear();

    state.tick = 0;
    state.halt_message&.clear();
    state.halted_without_wire_values = true;  // dont show zeroes before first tick
    
    world := state.world&;
    world.storage.set_zeroed();
    
    world.scratch.len = world.scratch.cap;
    world.scratch.items().set_zeroed();
    @if(state.tree.len == 0) return();
    root := state.tree[0].component || return();
    
    name := state.world&[root].name;

    i := state.tree[0].diagram_circuit || return();
    c := state.circuit[i]&;
    Tc'set_initial_data_verbose(world, state.circuit, root, 0, state.warnings&);
    
    each c.gates { g |
        if group(g.kind) == .Tc2 && Tc'gate_name(g.kind, .Tc2) == .Level_gate && g.logical_gate_index != -1 {
            instance := state.world&[root].instance_offset_by_gate[g.logical_gate_index];
            data := state.world.storage.rest(instance).interpret_as_bytes().peek_type(Tc.Builtin.LevelGateData);
            if state.levels.index_of(fn(it) => it.level.title == g.label.items()) { level_index |
                data.output = state.levels[level_index].completed;
                data.level_index = level_index.intcast();
            } else {
                data.level_index = -1;
            };
        };
    };
    
    v := @static @as(LevelApi.Imports) (
        put_text = LevelApi.impl.put_text,
    );
    @debug_assert(!state.level_active, "end level before reset so its called with the old .sim just for sanity");
    state.sim = (
        fns = v,
        world = world,
        circuit = c,
        circuits = state.circuit,
        static_userdata = state.level.static_userdata,
        text = state.sim.text,
    );
    if !state.world&[root].error {
    state.level.userdata = state'level'start(state.sim&);
    state.level_active = state.level.title != "Sandbox";
    state.update_suggested_components();
    };
    
    world.scratch.len = world.scratch.cap;
    world.scratch.items().set_zeroed();
}

fn update_suggested_components(state: *State) void = {
    state.level_suggested&.clear();
    @if(!state.level_active) return();
    // :SLOW
    suggested := state'level'suggested_components(state.level.userdata);
    for suggested { name |
        if builtin_components.index_of(fn(it) => it.name == name) { i |
            state.level_suggested&.set(i);
        };
    };
}

fn service_keyboard_device(state: *State) void #inline = {
    service_keyboard_device(state, state.keyboard_data || return());
}

fn service_keyboard_device(state: *State, data: *Tc.Builtin.KeyboardData) void = {
    buf := state.key_buffer&;
    if buf.len == 0 && !data.valid {
        data.value = 0;
        data.up = false;
    };
    if buf.len > 0 && !data.valid {
        key := buf[0].key;
        // TODO: i have EventType.CHAR which does some of this (but not all because this still wants shift, etc.)
        key := @match(state.keyboard_character_mode) {
        fn Char() => {
            c := @as(i64) zext(@as(u16) key);
            if c < 127 && c.trunc().is_ascii_alpha() && !buf[0].shift {
                c = c.trunc().ascii_to_lower().zext();
            };
            
            // TODO: v2 has different numbers (enter is 10)
            c = @match(key) {
                fn ENTER() => 5;
                fn BACKSPACE() => 4;
                fn LEFT_SHIFT() => 21;
                fn RIGHT_SHIFT() => 21;
                fn LEFT() => 15;
                fn UP() => 16;
                fn RIGHT() => 17;
                fn DOWN() => 18;
                @default => c;
            };
            
            if buf[0].shift {
                shift_transforms := "1!2@3#4$5%6^7&8*9(0)-_=+[{]}\\|;:'\",<.>/?";
                range(0, shift_transforms.len/2) { i |
                    if c == shift_transforms[i*2].zext() {
                        c = shift_transforms[i*2 + 1].zext();
                    };
                };
            };
            
            c
        };
            fn V1() => (key_order.index_of(fn(it) => it[] == key) || -13) + 13;
            fn V2() => {
                break :: local_return;
                for key_order_v2 { high, keys |
                    enumerate keys { low, it |
                        if key == it[] {
                            break(low.bit_or(high.zext()));
                        }
                    };
                };
                0
            }
        };
        
        data.value = key.trunc();
        data.up = buf[0].up;
        data.valid = true;
        _ := buf.pop_front();
        state.dirty = true;
    };
    data.have_next = buf.len.trunc();
}

// TODO: allow multiple?
fn find_keyboard(state: *State) void = {
    state.keyboard_data = .None;
    @if(state.tree.len == 0) return();
    root := state.tree[0].component || return();
    world := state.world&;
    c := world[root]&;
    gate_i := c.gates.index_of(fn(it) => @match(group(it.kind)) {
        fn Tc1() => name(it.kind, .Tc1) == .Keyboard;
        fn Tc2() => name(it.kind, .Tc2) == .Keyboard_v2;
        @default => false;
    }) || return();
    instance := c.instance_offset_by_gate[gate_i];
    data := bit_cast_unchecked(*WireValue, *Tc.Builtin.KeyboardData, world.storage.index(instance));
    state.keyboard_data = (Some = data);
    v2 := group(c.gates[gate_i].kind) == .Tc2;
    state.keyboard_character_mode = @if(c.gates[gate_i].param != int(v2), .Char, @if(v2, .V2, .V1));
}

#use("@/lib/collections/deque.fr");

fn on_event(state: *State, sapp: *Sapp.Self, event: *Sapp.Event) void = {
    @if(@is(event.type, .QUIT_REQUESTED, .UNFOCUSED, .ICONIFIED, .MOUSE_LEAVE)) state.autosave();
    
    e := state.edit&;
    screen := vec2(sapp.framebuffer_width.float().cast(), sapp.framebuffer_height.float().cast()) 
        / 2;
    mouse := vec2(event.mouse_x, -event.mouse_y) / screen + vec2(-1.0, 1.0);
    delta_mouse := vec2(event.mouse_dx, -event.mouse_dy) / screen;
    
    if text_box_consumes_event(e, event) {
        if event.type == .MOUSE_MOVE {
            // need this or the click to exit will still be on the button and enter again
            state.mouse_pos = mouse;
        };
        return();
    };
    
    
    if !event.key_repeat && @is(event.type, .KEY_DOWN, .KEY_UP) {
        if event.key_code == .K && event.type == .KEY_DOWN && event.modifiers.get(.shift) != 0  && event.modifiers.get(.super) != 0 {
            state.keyboard_device_focused = !state.keyboard_device_focused;
            state.dirty = true;
            state.show_wire_ref_lines = state.show_wire_ref_lines && !state.keyboard_device_focused;
            return();
        }
    
        if pan_keys.index_of(fn(it) => it[] == event.key_code) { i |
            s := state.pan_keys_pressed&;
            s[] = s[].bit_xor(1.shift_left(i));
        };
        
        buf := state.key_buffer&;
        if state.keyboard_device_focused && buf.len() < buf.capacity() {
            buf.push_back((key = event.key_code, up = event.type == .KEY_UP, shift = event.modifiers.get(.shift) != 0), panicking_allocator);
            state.dirty = state.dirty || buf.len < 2;
            return();
        };
        if state.keyboard_device_focused {
            return();
        };
    };
    if event.key_repeat && state.keyboard_device_focused {
        return();
    };
    
    @match(event.type) {
        fn RESIZED() => ();
        fn MOUSE_MOVE() => {
            state.mouse_pos = mouse;
            move := (event.modifiers.get(.middle_mouse) != 0)
                || (!e.enable && event.modifiers.get(.left_mouse) != 0)
                || (e.enable && event.modifiers.get(.left_mouse) != 0 && event.modifiers.get(.control) != 0)
                || (e.enable && event.modifiers.get(.right_mouse) != 0 && event.modifiers.get(.control) != 0);
            if move {
                state.pos += delta_mouse;
            }
        }
        fn MOUSE_SCROLL() => {
            (lo: f32, hi: f32) := (0.03, 100);
            delta := event.scroll_y + event.scroll_x;  // still zoom like normal when becomes x for holding shift
            delta := delta * state.scale * 3 / screen.x;
            delta := clamp(state.scale + delta, lo, hi) - state.scale;
            
            pos := (mouse - state.pos) / state.scale;
            pos0 := pos * vec2(state.scale);
            pos1 := pos * vec2(state.scale + delta);
            state.pos -= pos1 - pos0;
            state.scale += delta;
        }
        fn KEY_DOWN() => {
            tick_off := @if(event.modifiers.get(.shift) == 1, 50, 1);
            tick_off := @if(event.modifiers.get(.super) == 1, 1000, tick_off);
            @match(event.key_code) {
                fn ESCAPE() => {
                    @if(e.show_info_box.is_some() && e.info_box_is_settings) do_settings(state, e.text_box.buffers[0], false);
                    
                    e.show_info_box = .None;
                    e.active_buffer_index = .None;
                    if e.enable {
                        @if(state.tree.len == 0) return();
                        i := state.tree[state.tree.len - 1].diagram_circuit || return();
                        c := state.circuit[i]&;
                        hover_gate(e, .None, c);
                    } else {
                        state.pop_tree_node();
                    };
                };
                fn ENTER() => { state.want_eval = true; }
                fn SPACE() => { 
                    if e.enable {
                        e.action = .Rotate;
                    } else {
                        state.auto_eval = !state.auto_eval; 
                    }
                }
                fn U() => { state.split_graphics_and_wires = !state.split_graphics_and_wires; }
                fn Z() => if e.enable && event.modifiers.get(.super) == 1 {
                    state.apply_undo(event.modifiers.get(.shift) == 0);
                };
                fn R() => {
                    state.end_level();
                    state.reset();
                }
                fn C() => if event.modifiers.get(.super) == 0 {
                    state.recenter();
                } else {
                    if e.enable {
                        e.action = .Copy;
                    };
                };
                fn LEFT_BRACKET() => {
                    state.max_ticks_per_eval = clamp(state.max_ticks_per_eval - tick_off, 1, 100_000_000);
                }
                fn RIGHT_BRACKET() => {
                    state.max_ticks_per_eval = clamp(state.max_ticks_per_eval + tick_off, 1, 100_000_000);
                }
                fn LEFT_SHIFT() => { state.show_wire_ref_lines = true; }
                fn E() => {
                    state.set_edit_mode(!e.enable);
                }
                fn BACKSPACE() => {
                    e.action = .Delete;
                }
                @default => return();
            };
        }
        fn KEY_UP() => {
            @match(event.key_code) {
                fn LEFT_SHIFT() => { state.show_wire_ref_lines = false; }
                @default => return();
            };
        }
        fn MOUSE_DOWN() => {
            e.is_double_click = false;
            if event.mouse_button == .LEFT {
                state.left_mouse_down = true;
            };
            state.either_clicked = event.modifiers.get(.control) == 0 && @is(event.mouse_button, .LEFT, .RIGHT);
            
            if e.enable && event.mouse_button == .RIGHT && e.no_selection() && event.modifiers.get(.control) == 0 {
                e.action = .Delete;
                // fall through to select the thing you're clicking on
            };
            
            if event.mouse_button == .RIGHT && event.modifiers.get(.control) == 0 {
                state.mouse_pos = mouse;
                state.clicked = true;
            };
            
            if e.enable && event.mouse_button == .LEFT && event.modifiers.get(.control) == 0 {
                state.mouse_pos = mouse;
                state.clicked = true;
            };
            
            if event.mouse_button == .LEFT {
                e.is_double_click = (timestamp() - e.last_click_time) < 300;
                e.last_click_time = timestamp();
            };
            
            if !e.is_double_click && state.tree.len > 0 && e.enable {
                if state.tree[state.tree.len - 1].diagram_circuit { circuit_i |
                    hover_gate(e, .None, state.circuit[circuit_i]&);
                    state.dirty = true;
                };
            };
        }
        fn MOUSE_UP() => {
            if event.mouse_button == .LEFT {
                if e.enable && !e.no_selection() && event.modifiers.get(.control) == 0 {
                    state.clicked = true;
                };
                
                state.left_mouse_down = false;
            }
        }
        fn CLIPBOARD_PASTED() => if state.loader.progress != .Loading && event.pasted.contains("CIRCUIT v1") {
            state.autosave();
            state.looking_at_examples = true;
            state.load_path_async(event.pasted, true);
        };
        fn FILES_DROPPED() => for event.drop { path |
            if state.loader.progress != .Loading {
                state.autosave();
                state.looking_at_examples = true;
                state.load_path_async(path, false);
            };
        };
        @default => return();
    };
    state.dirty = true;
}

pan_directions :: @const_slice(vec2(0, -1), vec2(1, 0), vec2(0, 1), vec2(-1, 0));
pan_keys :: @const_slice(Sapp.Keycode.W, .A, .S, .D);
fn check_movement(state: *State) void = if state.pan_keys_pressed != 0 && !state.keyboard_device_focused {
    state.dirty = true;
    dir := vec2(0);
    range(0, 4) { i |
        if state.pan_keys_pressed.bit_and(1.shift_left(i)) != 0 {
            dir += pan_directions[i];
        };
    };
    if dir.x != 0 || dir.y != 0 {  // dont be NaN if opposite keys cancel
        state.pos += dir.normalize() * 0.05;
    };
};

// TODO: maybe requested_root_index should just be in circuit.txt
fn load_path_async(state: *State, path: Str, is_bytes: bool) void = 
    load_path_async(state, path, is_bytes, .None);
fn load_path_async(state: *State, path: Str, is_bytes: bool, requested_root_index: ?i64) void = {
    #use("@/lib/sys/fs.fr");
    
    state.end_level();
    state.stash_undo();
    
    state.circuit = empty();
    state.tree_ready = false;
    state.tree&.clear();
    state.circuit_arena&.reset_retaining_capacity();
    state.edit.enable = false;
    state.current_jitted_source = "";
    state.atlas.enable = false;
    a := state.circuit_arena&.borrow();
    state.edit.undo = empty();
    state.edit.field_names = empty();
    path := path.shallow_copy(a);
    state.warnings = list(a);
    state.prepare_async();
    state.loader.start_async(Path = (path = path, is_bytes = is_bytes, requested_root_index = requested_root_index));
}

LoadSource :: @tagged(
    Path: @struct(path: Str, is_bytes: bool, requested_root_index: ?i64),
    Index: @struct(root_index: i64, tc_file_loader_device: []Tc.LoadedFile, just_reset_arena: bool),
);
LoaderT :: import("@/examples/jit_loader.fr")'Loader(
    *State, LoadSource, rawptr, void,
    worker_get_source, worker_get_output, main_use_output,
    "dispatch",
);

worker_get_source :: fn(state: *State, in: *LoaderT.I) Result(Str, void) = {
    @match(in[]) {
        fn Path(it) => {
            path := it.path;
            if state.download_schematic_archive_before_trying_to_load && !it.is_bytes {
                state.download_schematic_archive_before_trying_to_load = false;
                root := Foreign'tc_archive();
                filter := @const_slice("ploter", "3D Engine", "Screenverture", "Dungeon Crawler", "Platformer Game", "ASM computer 64bit", "Matrix Animation Studio 3000", "Snake on matrix display with LEG++");
                template :: "%/v1/schematics/architecture/%/circuit.data";
                for filter { path |
                    _ := Syscall'remove(@fmt_cstr(template, root, path));
                };
                path = @tfmt(template, root, path);
            };
            load_path_worker(state, in, path, it.is_bytes, it.requested_root_index)
        }
        fn Index(it) => load_circuit_index_worker(state, it.root_index, it.tc_file_loader_device, it.just_reset_arena);
    }
}

load_path_worker :: fn(state: *State, in: *LoaderT.I, path: Str, is_bytes: bool, requested_root_index: ?i64) Result(Str, void) = {
    start := timestamp();
    a := state.circuit_arena&.borrow();
    
    bytes := path;
    if is_bytes {
        path = "";
    };
    
    // if it uses custom components, need to load everything to find them
    circuits, root_index, tc_file_loader_device := Tc'load_all_circuits(path, a, state.warnings&);
   
    @if(circuits.len == 0 && !is_bytes)
    if read_entire_file(a, path) { in |
        in := in;
        while => in.len > 0 && in[0].is_ascii_whitespace() {
            in = in.rest(1);
        };
        if in.starts_with("CIRCUIT v1 ") {
            is_bytes = true;
            bytes = in;
        };
    };
    
    @if(is_bytes)
    @match(Save'read_save(bytes, a)) {
    fn Ok(c, files) => {
        state.warnings&.clear();
        circuits = c;
        root_index = c.index_of(fn(it) => it.is_level_map) || (c.index_of(fn(it) => it.is_arch) || 0);
        tc_file_loader_device = files;
    };
        fn Err(msg) => @fmtln(state.warnings&, "%", msg);
    };
    
    if requested_root_index { i |
        if i.ult(circuits.len) {
            root_index = i;
        };
    };
    
    if !state.looking_at_examples {
        c := a.alloc_zeroed(Tc.Circuit, circuits.len + 1);
        c.slice(0, circuits.len).copy_from(circuits);
        l := LevelApi.builtin_levels;
        build_level_map(l.levels, l.indices, c[c.len-1]&, a);
        circuits = c;
        if requested_root_index.is_none() {
            root_index = c.len - 1;
        };
    };
    
    //@eprintln("found % circuit diagrams in %ms; %mb;", circuits.len, timestamp() - start, state.circuit_arena&.current_used_size()/1024/1024);
    state.circuit = circuits;
    if circuits.len == 0 || root_index == -1 {
        state.circuit = empty();
        @fmtln(state.warnings&, "failed to load [%]", path);
        return(.Err);
    };
    state.push_tree_node(diagram_circuit = (Some = root_index));
    state.tree_ready = true;
    // TODO: dont bother recompiling yet if in edit mode
    in[] = (Index = (root_index = root_index, tc_file_loader_device = tc_file_loader_device, just_reset_arena = true));
    worker_get_source(state, in)
}

fn load_circuit_index_async(state: *State, root_index: i64, tc_file_loader_device: []Tc.LoadedFile) void = {
    state.ensure_holding_nothing();
    state.end_level();
    state.stash_undo();
    state.load_time = 0;
    state.compile_time = 0;
    state.tree&.clear();
    forget_already_compiled(state.circuit);
    state.push_tree_node(diagram_circuit = (Some = root_index));
    state.prepare_async();
    state.loader.start_async(Index = (root_index = root_index, tc_file_loader_device = tc_file_loader_device, just_reset_arena = false));
}

// TODO: if progress changes part way through the frame, will leak main_prepare_interp->load_atlas_part2->dealloc(a.pixels)
fn prepare_async(state: *State) void = {
    progress := state.loader.progress;
    @debug_assert_ne(progress, .Loading);
    a := general_allocator();
    state.canceled_compilers&.unordered_retain(fn(it) => {
        done := it.progress == .Ready;
        if done {
            it[].drop();
            a.dealloc_one(LoaderT, it[]);
        };
        !done
    });
    if @is(progress, .Compiling, .Ready) {
        state.current_jitted_source = "";
        state.canceled_compilers&.push(state.loader);
        state.loader = a.box_zeroed(LoaderT);
        init(state.loader, state);
    };
}

// should fine for the ui to show the diagram on the other thread while this compiles. 
// there needs to not use the logical part while progress==.Loading and here needs to not push to state.tree. 
fn load_circuit_index_worker(state: *State, root_index: i64, tc_file_loader_device: []Tc.LoadedFile, just_reset_arena: bool) Result(Str, void) = {
    circuits := state.circuit;
    state.tick = 0;
    
    // TODO: bring back FEAT_RT_COMPILE which doesn't compile the franca compiler. 
    
    a := state.circuit_arena&.borrow();
    components := @ref Component.list(a);
    components.push_all(builtin_components);
    Tc'compile_circuit(circuits, root_index, components, a, state.warnings&);
    
    first_index_that_needs_fast_eval := builtin_components.len();
    src := compile_gates_source(components.items(), a, first_index_that_needs_fast_eval, state.warnings&);
    if state.current_jitted_source != "" && state.current_jitted_source == src {
        state.source_unchanged = true;
        state.loader_thread_ready_for_interp = true;
        return(.Err);
    };
    state.current_jitted_source = src;
    if just_reset_arena {
        e := state.edit&;
        // fix it if you made the setting too small
        e.arena_gc_threshold_kb = max(e.arena_gc_threshold_kb, 2*state.circuit_arena&.current_used_size()/1024);
    };
    
    // Component.compile_order is now ready to be interpreted on the other thread 
    // until the jit is ready. forget the old fast_eval so don't get confused. 
    worker_prepare_interp(state, components.items(), root_index, tc_file_loader_device);
    
    if components[components.len - 1].error {
        // might have generated something that will fail to compile. 
        // still want to update world to show the new component code view for debugging. 
        src = "{ dispatch :: zeroed([]rawptr); };";
        state.current_jitted_source = "";
        return(.Err);
    };
    
    state.loader_thread_ready_for_interp = true;
    @if(!FEAT_COMPILE) return(.Err);
    
    (Ok = src)
}

worker_get_output :: fn(state: *State, in: *LoaderT.I, callee: rawptr) Result(rawptr, void) = (Ok = callee);

worker_prepare_interp :: fn(state: *State, components: []Component, root_index: i64, tc_file_loader_device: []Tc.LoadedFile) void = {
    circuits := state.circuit;
    world := state.world&; 
    init(world, general_allocator(), true, components);
    world.tc_file_loader_device = tc_file_loader_device;
    
    c := circuits[root_index]&; 
    state.load_atlas_part1(c);
    state.max_ticks_per_eval = max(c.default_tick_rate / 60, 1);
}

// TODO: if there were to be a sandbox escape in this program it would probably be by passing untrusted bytes to stb_image.
Atlas :: import("@/tests/external/wasm4.fr").Atlas;
fn load_atlas_part1(state: *State, c: *Tc.Circuit) void = {
    @if(!FEAT_PNG) return();
    Viewer :: import("@/examples/gpu/viewer.fr");
    world := state.world&;
    files := world.tc_file_loader_device;
    c := c.compiled || return();
    c := world[c]&;
    
    Img :: @struct(param: i64, pixels: []u8, w: i64, h: i64);
    images := Img.list(temp());
    
    atlas_w, atlas_h := (1, 1);
    each c.gates { it |
        continue :: local_return;
        @if(group(it.kind) != .Tc1 || name(it.kind, .Tc1) != .SpriteDisplay) continue();
        @if(!it.param.ult(files.len)) continue();
        file := files[it.param]&;
        
        pixels, w, h := Viewer'stbi_load(file.data).or(fn(err) => {
            @eprintln("failed to load image (%): %", file.name, err);
            continue();
        });
        img: Img = (param = it.param, pixels = pixels, w = w.intcast(), h = h.intcast());
        images&.push(img);
        
        atlas_w += img.w;
        atlas_h = max(atlas_h, img.h);
    };
    
    if images.len == 0 {
        state.atlas.data = zeroed(@type state.atlas.data);
        return();
    };
    
    atlas := Atlas'new_sized(general_allocator(), atlas_w, atlas_h);
    atlas_uvs: HashMap(i64, Ty(Vec2, Vec2, Vec2)) = init(state.circuit_arena&.borrow());
    _ := atlas&.push(@slice(0xFFFFFFFF), 1, 1);  // :WhitePixelForDrawingSolidColours
    for images { it |
        a, b := atlas&.push(u32.reinterpret_bytes(it.pixels), it.w, it.h);
        atlas_uvs&.insert(it.param, (a, b, vec2(it.w.float().cast(), it.h.float().cast())));
        Viewer'Stb'stbi_image_free(u8.raw_from_ptr(it.pixels.ptr));
    };
    
    state.atlas.uvs = atlas_uvs.raw;
    state.atlas.data = (pixels = atlas.buf, w = atlas_w, h = atlas_h);
}

fn load_atlas_part2(state: *State, sg: *Sg.Self) void = {
    a := state.atlas.data&;
    sg.destroy(state.atlas.img);
    state.atlas.img = (id = 0);
    state.atlas.enable = a.pixels.len > 0;
    @if(!state.atlas.enable) return();
    d := zeroed(Sg.ImageData);
    d.subimage&[0]&[0] = interpret_as_bytes(a.pixels);
    state.atlas.img = sg.make(
        width = a.w.intcast(), height = a.h.intcast(),
        pixel_format = .RGBA8,
        data = d,
    );
    general_allocator().dealloc(u32, a.pixels);
    a.pixels = empty();
}

Save :: import("@/examples/circuit/save.fr");
Builtin :: Tc.Builtin;
//Tc :: Main.tc.load;
//Builtin :: Main.tc.builtin;

fn on_cleanup(state: *State, sapp: *Sapp.Self, sg: *Sg.Self) void = {
    on_cleanup(state.edit.text_box&, sapp, sg);
    a := general_allocator();
    state.canceled_compilers&.push(state.loader);
    for state.canceled_compilers { it |
        drop(it);
        a.dealloc_one(LoaderT, it);
    };
    state.canceled_compilers&.drop();
    state.text&.shutdown();
    sg.destroy_pipeline(state.pipe&);
    sg.destroy(state.screen.img);
    sg.destroy(state.atlas.img);
    state.draw&.destroy(sg, a);
    state.circuit_arena&.deinit();
    a.dealloc(u32, state.screen.atlas.buf);
    drop(state.world&, a);
}

