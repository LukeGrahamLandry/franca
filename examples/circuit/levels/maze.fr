
Maze :: @struct {
    pos: i64;
    direction: i64;
    map: []i64;
    win := false;
    
    new :: fn(map: []i64) Maze = {
        self: Maze = (pos = 0, direction = 0, map = map);
        self.pos = self&.width() * (self.map.len() - 1) - 2;
        self
    }
    
    fn facing(self: *Maze) Ty(i64, i64, i64, bool) = {
        width := self.width();
        deltas :: @const_slice((0, -1), (1, 0), (0, 1), (-1, 0));  // (up, right, down, left)
        y, x := self.pos.div_mod(width);
        dx, dy := deltas[self.direction];
        x += dx; y += dy;
        look_pos := y*width + x;
        looking_at_wall := self.map[y].bit_and(1.shift_left(width - x - 1)) != 0;
        (look_pos, x, y, looking_at_wall)
    }
    
    fn input(self: *Maze) u8 = {
        look_pos, x, y, looking_at_wall := self.facing();
        width := self.width();
        @debug_assert(look_pos >= 0 && look_pos < width*self.map.len(), "looking out of maze");
        input: u8 = @if_else {
            @if(look_pos == 1) => 3;
            @if(looking_at_wall) => 1;
            @else => 0;
        };
        input
    }
    
    fn output(self: *Maze, byte: u8) void = {
        width := self.width();
        look_pos, x, y, looking_at_wall := self.facing();
        // there should be a wall around but just to make sure:
        not_looking_at_edge := x != 0 && x != width - 1 && y != 0 && y != self.map.len() - 1;
        
        @switch(byte) {
            @case(0) => {  // left
                self.direction = self.direction.add(4).sub(1).umod(4);
            };
            @case(1) => if !looking_at_wall && not_looking_at_edge {  // move
                self.pos = look_pos;
            };
            @case(2) => { // right
                self.direction = self.direction.add(1).umod(4);
            };
            @case(3) => (); // wait
            @case(4) => if look_pos == 1 {  // action
                self.win = true;
            };
            @default => ();
        };
    }
    
    fn render(self: *Maze, maze_text: *List(u8)) void = {
        width := self.width();
        maze_text.reserve((width + 1)*self.map.len());
        range(0, width*self.map.len()) { i |
            y, x := i.div_mod(width);
            @if(x == 0) maze_text.push_all("\n");
            x = width - x - 1;  // little endian bit literal
            wall := self.map[y].bit_and(1.shift_left(x)) != 0;
            maze_text.push(@if_else {
                @if(i == 1) => "+".ascii();
                // cpc font has arrows
                @if(i == self.pos) => "\xF0\xF3\xF1\xF2".index(self.direction)[];
                // could use \x8F which is solid
                @else => @if(wall, "@".ascii(), " ".ascii());
            });
        };
    }
    
    fn width(self: *Maze) i64 = count_ones(self.map[0]).zext();
    
    // a map stolen from TuringComplete.Game's The Maze level
    tc0 :: @const_slice(@as(i64)
        0b1111111111111111111111111,
        0b1000100000001010001000001,
        0b1110111110111010111011101,
        0b1000100010000010000010101,
        0b1011101111101110111010101,
        0b1010101010000000101010001,
        0b1010101011111011101110111,
        0b1000000000000010000010101,
        0b1011101111111010111011101,
        0b1010000000001000001000101,
        0b1111101111111110111011101,
        0b1000001000000010100000001,
        0b1011111010111011111011111,
        0b1000000010100000001000001,
        0b1111111111111111111111111,
    );
};

#use("@/examples/circuit/level_api.fr");
Self :: @struct {
    sim: *Simulation;
    shape := zeroed(IoShape);
    maze: Maze;
};

level_spec :: @static @as(Exports) (
// TODO: dont leak
start = fn(sim) = {
    self := general_allocator().boxed(Self, (
        sim = sim,
        maze = Maze'new(Maze.tc0),
    ));
    self.init_program();
    Self.raw_from_ptr(self)
},
before = fn(self, values) = {
    self := Self.ptr_from_raw(self);
    values[self.shape.in] = self.maze&.input().zext();
},
after = fn(self, values) = {
    self := Self.ptr_from_raw(self);
    out, out_on := (values[self.shape.out], values[self.shape.out_used] != 0);
    @if(out_on) self.maze&.output(out.trunc());
    self.maze.win
},
// TODO: perhaps visuals should instead be expressed as a Screen component
render = fn(self) = {
    self := Self.ptr_from_raw(self);
    out := @ref u8.list(temp());
    self.maze&.render(out);
    c := pack_rgba(@if(self.maze.win, 255, 50), 200, 150, 255);
    self.sim.put_text(vec2(-38, 40), c, out.items());
},
title = "Maze",
description = """
The circuit controls a robot moving through a maze (2d grid). 
The robot faces in a cardinal direction (up, right, down, left). 
To win, find the door and open it.
INPUT: contents of the cell in front of the robot. 
       [0 = empty, 1 = wall, 3 = door]
OUTPUT: action for the robot to take. 
       [0 = turn left, 1 = move forward, 2 = turn right, 4 = open door]
""",
solutions = {
    out := @ref u8.list(ast_alloc());
    components := @ref Component.list(ast_alloc());
    components.push_all(builtin_components);
    compile_defs(components);
    layout_components(components.items().rest(builtin_components.len()), out, temp());
    out.items()
},
quine = include_bytes(@source_file_name()),
);

init_program :: fn(self: *Self) void = {
    name := self.sim.circuit.name;
    is_defs := name == "overture" || name == "leg";
    non_defs := name == "LEG" || name == "OVERTURE" || name == "NANDverture";
    is_leg := name == "leg" || name == "LEG";
    known := is_defs || non_defs;
    
    if is_defs {
        self.shape = (out=0,out_used=1,in=3,in_used=2);
    } else {
        // TODO: else report error
        if find_io_shape(self.sim.circuit) { it |
            self.shape = it;
        };
    };
    
    @if(!known) return();
    Defs :: import("@/examples/circuit/defs.fr");
    program := @if(is_leg, Defs.the_maze_leg, Defs.the_maze);
    if is_defs {
        root := self.sim.circuit.compiled.unwrap();
        range(0, 256) { i |
            values := @slice(0, 0, 0, program[i].zext(), /*write program*/1);
            evaluate(self.sim.world, values, root, 0, false);
        };
    } else {
        c := self.sim.world[self.sim.circuit.compiled.unwrap()]&;
        i := c.gates.index_of(fn(it) => it.kind.group() == .Tc1 && Tc'gate_name(it.kind, .Tc1) == .Program).expect("program component");
        off := c.instance_offset_by_gate[i];
        self.sim.world.storage.subslice(off, 256/8).interpret_as_bytes().copy_from(program);
    };
}

#use("@/examples/circuit/compile.fr");
#use("@/examples/circuit/parse_defs.fr");
