// TODO: have it be wasm so somewhat sandboxed and can write them in other languages?
//       its just so tedious to do an api for all the poking at the circuit you might want to do. 
//       but even how im doing it now ive typed the signeture for put_text 4 times so its not like it could get much worse. 

Exports :: @struct {
    title: Str = "";
    description: Str = "";
    solutions: []u8 = "";  // save.fr circuit format
    quine: Str = "";
    static_userdata := 0;
    userdata := zeroed(rawptr);  // result of start()
    // called on reset
    start: (@FnPtr(sim: *Simulation) rawptr) = (fn(_0)=zeroed(rawptr));
    end: (@FnPtr(userdata: rawptr) void) = (fn(_0)=());
    // called once per tick
    before: (@FnPtr(userdata: rawptr, values: []i64) void) = (fn(_0,_1)=());
    after: (@FnPtr(userdata: rawptr, values: []i64) bool) = (fn(_0,_1)=false);
    // called once per frame
    render: (@FnPtr(userdata: rawptr) void) = (fn(_0)=());
};

ComponentRef :: @struct(graphical: *Tc.Circuit.Gate, logical: *Component.Gate, instance: i64, data: []u8);
fn find_labeled_component(sim: *Simulation, label: Str) ?ComponentRef = {
    i := sim.circuit.gates.index_of(fn(it) => it.label.items() == label) || return(.None);
    sim.get_component_by_graphical_index(i)
}

fn get_component_by_graphical_index(sim: *Simulation, i: i64) ?ComponentRef = {
    root := sim.circuit.compiled || return(.None);
    c := sim.world[root]&;
    @if(i.uge(sim.circuit.gates.len)) return(.None);
    g := sim.circuit.gates[i]&;
    @if(g.logical_gate_index == -1) return(.None);
    instance := c.instance_offset_by_gate[g.logical_gate_index];
    l := c.gates[g.logical_gate_index]&;
    n := get_storage_count(sim.world.components, l);
    data := sim.world.storage.rest(instance).slice(0, n).interpret_as_bytes();
    (Some = (graphical = g, logical = l, instance = instance, data = data))
}

fn find_io_shape(circ: *Tc.Circuit) ?IoShape = {
    (Some = (
        out = circ.pin_names.index_of("out") || return(.None),
        out_used = circ.pin_names.index_of("out#on") || return(.None),
        in = circ.pin_names.index_of("in") || return(.None),
        in_used = circ.pin_names.index_of("in#on") || return(.None),
    ))
}

fn make_level_sequence(level_spec: *Exports, level_text: []Str, names: []Str) []*Exports = {
    @assert_eq(names.len(), level_text.len(), "level count mismatch");
    ast_alloc().alloc_init(*Exports, level_text.len(), fn(i) => {
        it := level_spec[];
        it.static_userdata = i;
        it.title = names[i];
        it.description = level_text[i];
        ast_alloc().boxed(Exports, it)
    })
}

fn put_text(sim: *Simulation, pos: Vec2, c: u32, msg: Str) void =
    sim'put_text(sim, pos, c, msg);

Imports :: @rec @struct {
    put_text: @FnPtr(self: *Simulation, pos: Vec2, c: u32, msg: Str) void;
};
Simulation :: @rec @struct {
    fns: *Imports #use;
    world: *World;
    circuit: *Tc.Circuit;
    circuits: []Tc.Circuit;
    static_userdata: i64;
    text: List(Text);
};
Text :: @struct(pos: Vec2, c: u32, msg: Str);

IoShape :: @struct {
    out: i64; out_used: i64; in: i64; in_used: i64;
};

impl :: @struct {

put_text :: fn(self, pos, c, msg) = {
    self.text&.push(pos = pos, c = c, msg = msg);
};

};

#use("@/graphics/vec.fr");
#reexport("@/graphics/vec.fr");
#use("@/examples/circuit/eval.fr");
