max_gate_text_fields :: 4;
reserved_buffers :: 1;

fn text_box_consumes_event(e: *EditState, event: *Sapp.Event) bool = {
    @if(!e.enable && e.show_info_box.is_none()) return(false);
    @if(event.key_code == .ESCAPE) return(false);  // i want it for closing the field
    
    t := e.text_box&;
    if event.type == .MOUSE_DOWN && event.mouse_button != .MIDDLE {
        Terminal'push_state(t) {
            e.active_buffer_index = .None;
            each(t.buffers, fn(buf) => { buf.active = false; });
            done := false;
            pos: Terminal.Pos = (x = event.mouse_x.cast(), y = event.mouse_y.cast());
            enumerate t.buffers& { i, buf |
                if buf.at.contains(pos) {
                I := reserved_buffers;
                ok := false 
                || (i < I && e.show_info_box.is_some())
                || (i >= I && i - I < e.field_names.len && e.field_names[i - I] != "" && e.show_info_box.is_none())
                ;
                
                if !done && ok {
                    t.selected_buffer = i;
                    done = true;
                    buf.active = true;
                    e.active_buffer_index = (Some = t.selected_buffer);
                };
                };
            };
            if e.active_buffer_index.is_none() {
                t.dirty = true;
            };
        };
    };
    if e.active_buffer_index { i |
        @if(i == 0 && !e.info_box_is_settings, t.features&.unset(.Edit), t.features&.set(.Edit));  // TODO: have features per buffer?
        on_event(t, t.app, event);
        return true;
    };
    false
}

// TODO: pass in the sdtx so can use the same one (silly to compile the shader twice)
fn draw_text_boxes(e: *EditState, sg: *Sg.Self) void = {
    @if(!e.enable && e.show_info_box.is_none()) return();
    t := e.text_box&;
    Terminal'push_state(t) {
        sdtx := t.text.default_context&;
        I := reserved_buffers;
        enumerate t.buffers& { i, b |
            if i >= I {
                name := @if(e.field_names.len > i-I, e.field_names[i-I], "");
                if name != "" {
                    sdtx.set_layer(i);
                    with(b.line_lock&, => draw_text(b[]));
                    sdtx.set_layer(i + t.buffers.len);
                    sdtx.pos = vec2(0.5 + cast((b.at.pos.x + b.at.w) / t.scale), sdtx.pos.y - 1);
                    sdtx.put(name);
                };
            } else {
                if e.show_info_box { _ |
                    sdtx.set_layer(i);
                    with(b.line_lock&, => draw_text(b[]));
                };
            };
        };
        
        range(I, t.buffers.len) { i |
            sdtx.draw_layer(i + t.buffers.len);
        };
        
        enumerate t.buffers& { i, b |
            r := b.at;
            sg.apply_scissor_rect(r.pos.x.cast(), r.pos.y.cast(), r.w.cast(), r.h.cast(), true);
            sdtx.draw_layer(i);
            i += 1;
        };
    };
}

// TODO: make sure this can't happen while loader.progress==.Loading because circuit_arena will be used on the other thread
fn hover_gate(e: *EditState, i: ?i64, c: *Circuit) void = {
    t := e.text_box&;
    @if((e.hovered_gate || -1) == (i || -1)) return();
    @if(!e.enable) return();
    
    e.field_names.set_zeroed();
    if e.field_names.len == 0 {
        e.field_names = e.circuit_arena.alloc_zeroed(Str, max_gate_text_fields);
    };
    
    I := reserved_buffers;
    @if(e.has_text_field) if e.hovered_gate { old_i |
        g := c.gates[old_i]&;
        
        out := @ref u8.list(temp());
        shape := get_builtin_shape(g.kind);
        a := e.circuit_arena;
        enumerate shape.fields { i, field |
            continue :: local_return;
            out.clear(); get_string(t.buffers[i+I], out); text := out.items();
            
            old := get_field_string(e, c, g, field);
            @if(old == text) continue();
            e.undo&.push((SetGateField = (i = old_i, field = i, value = old.shallow_copy(a))), a);
            set_field_string(e, c, g, field, text);
        };
    };

    for t.buffers { buf |
        buf.clear_text();
    };
    
    e.hovered_gate = i;
    e.has_text_field = false;
    i := i || return();
    g := c.gates[i]&;
    shape := get_builtin_shape(g.kind);
    enumerate shape.fields { i, field |
        e.field_names[i] = field.name;
        buf := t.buffers[i+I];
        buf.append_string(get_field_string(e, c, g, field));
    };
    e.has_text_field = shape.fields.len > 0;
}

// TODO: warning if it didn't parse
// TODO: bounds (width <= 64, endian 0/1, abs(shift) < 64). especially because bit_fields.set will debug assert
fn set_field_string(e: *EditState, c: *Circuit, g: *Circuit.Gate, field: *Tc.Builtin.EditField, text: Str) void = {
    @if(field.data_string) { g.data&.clear(); g.data&.push_all(text, e.circuit_arena); };
    @if(field.label_string) { g.label&.clear(); g.label&.push_all(text, e.circuit_arena); };
    if field.setting { settings_index |
        if settings_index >= g.settings.len {
            s := e.circuit_arena.alloc_zeroed(i64, settings_index+1);
            s.slice(0, g.settings.len).copy_from(g.settings);
            g.settings = s;
        };
        @if_let(Tc'Asm'constant_eval_expression(text)) fn Ok(value) => {
            g.settings&[settings_index] = value;
        };
        @if(field.allow_auto) if text == "auto" || g.settings&[settings_index] < 0 {
            g.settings&[settings_index] = MIN_i64;
        };
    };
    
    if field.is_link_label {
        g.watched.set_zeroed();
        @if(text != "") if c.gates.find(fn(it) => it.label.items() == text) { target |
            if target.link_id == 0 || target.link_id == -1 {
                target.link_id = realtime_ns();
            };
            w := e.circuit_arena.alloc_zeroed(Circuit.Watched, 1);
            g.watched = w;
            w[0].id = target.link_id;
        };
    };
}

fn get_field_string(e: *EditState, c: *Circuit, g: *Circuit.Gate, field: *Tc.Builtin.EditField) Str = {
        @if(field.label_string) return(g.label.items());
        @if(g.data.len == 0 || !field.data_string) if field.setting { settings_index |
            n := @if(settings_index < g.settings.len, g.settings&[settings_index], 0);
            if field.allow_auto && n == MIN_i64 {
                return "auto";
            } else {
                return @tfmt("%", n);
            };
        };
        @if(field.data_string) return(g.data.items()); 
        
        if field.is_link_label && g.watched.len > 0 && g.watched[0].id != 0 {
            if c.gates.find(fn(it) => it.link_id == g.watched[0].id) { target |
                if target.label.items() == "" {
                    target.label&.push_all(@tfmt("%", g.watched[0].id), e.circuit_arena);
                };
                return(target.label.items());
            };
        };
    
    ""
}

fn text_box_selection(self: *Draw) bool = {
    state := self.state;
    e, sapp := (state.edit&, state.sapp);
    no_code := e.enable || state.loader.progress != .Idle;
    // note: the "\n" ones are computed later
    names := @slice(
        ("Component Docs", include_bytes("examples/circuit/docs.md")),
        ("Level Instructions", state.level.description), 
        ("Level Code", state.level.quine), 
        ("Settings", @if(state.loader.progress == .Idle, "\n", "")), 
        ("This Circuit", @if(state.loader.progress == .Loading, "", "\n")),
        ("All Circuits", @if(state.loader.progress == .Loading, "", "\n")),
        ("Circuit Code", @if(no_code, "", state.current_jitted_source)), 
        ("Warnings", @if(no_code, "", state.warnings.items())), 
        ("New Circuit", "\n"),
    );
    prev := e.show_info_box;
    if state.clicked || state.either_clicked {
        e.show_info_box = .None;
    };
    range(0, names.len) { i |
        pos := vec2(-20, (7 + i.float().cast()));
        if names[i]._1 != "" {
            self.do_option(pos, names[i]._0, e.show_info_box.is_some() && e.show_info_box.Some == i, i, e.show_info_box&);
        };
    };
    if ((prev || -1) != (e.show_info_box || -1)) {
        state.dirty = true;
        t := e.text_box&;
        buf := t.buffers[0];
        @if(e.info_box_is_settings) do_settings(state, buf, false);
        buf.clear_text();
        e.active_buffer_index = .None;
        each(t.buffers, fn(buf) => { buf.active = false; });
        if e.show_info_box { i |
            if names[i]._0 == "New Circuit" {
                e.show_info_box = .None;
                state.set_edit_mode(true);
                state.new_circuit();
                return true;
            };
            
            e.active_buffer_index = (Some = 0);
            t.lock_to_bottom = false;
            buf.active = true;
            pad := 75.0;
            buf.at = (pos = (x = pad, y = pad), w = sapp.width().float() - pad*2, h = sapp.height().float() - pad*2);
            @if(names[i]._0 == "Level Instructions") buf.append_string(state.level.title);
            buf.append_string(names[i]._1);
            
            if names[i]._0 == "This Circuit" || names[i]._0 == "All Circuits" {
                state.stash_undo();
                out := @ref u8.list(temp());
                i: ?i64 = @if(names[i]._0 == "All Circuits", .None, state.tree[0].diagram_circuit);
                Save'write_save(state.circuit, state.world.tc_file_loader_device, i, out, true);
                buf.append_string(out.items());
                state.unstash_undo();
            };
            e.info_box_is_settings = names[i]._0 == "Settings";
            @if(e.info_box_is_settings) do_settings(state, buf, true);
        };
    };
    false
};

// TODO: warning if it didn't parse (number expressions / boolean other than "true"/"false")
// TODO: bounds (ex. ticks_per_frame is positive, bit_width <=64)
do_settings :: fn(state: *State, buf: *Terminal.TextBuffer, read: bool) void = {
    @if(state.tree.len == 0) return();
    c := state.tree[state.tree.len - 1].diagram_circuit || return();
    c := state.circuit[c]&;
    out := @ref u8.list(temp());
    if read {
        @fmt(out, "# you can edit these values\n\n");
        @fmt(out, "# circuit settings (saved in the circuit file)\n");
        walk_settings_fields c { name, p |
            @fmt(out, "%=%\n", name, p[]);
        };
        @fmt(out, "\n# simulator settings (not saved)\n");
        walk_state_settings_fields state { name, p |
            @fmt(out, "%=%\n", name, p[]);
        };
        buf.append_string(out.items());
    } else {
        state.dirty = true;
        get_string(buf, out);
        lines := out.items().split("\n", temp());
        walk_settings_fields c { name, p |
            WRITE(name, p);
        };
        walk_state_settings_fields state { name, p |
            WRITE(name, p);
        };
        
        WRITE :: fn(name, p) #duplicated => {
            for lines { it | 
                if it&.pop_prefix(name) && it&.pop_prefix("=") && it.len != 0 {
                    @inline_switch(@type p[]) {
                        @case(f32) => {
                            @if_let(Tc'Asm'constant_eval_expression(it)) fn Ok(value) => {
                                p[] = value.float().cast();
                            };
                        };
                        @case(Str) => if p[] != it {
                            p[] = it.shallow_copy(state.edit.circuit_arena);
                        };
                        @case(i64) => {
                            @if_let(Tc'Asm'constant_eval_expression(it)) fn Ok(value) => {
                                p[] = value;
                            };
                        };
                        @case(bool) => { p[] = it == "true"; };
                        @default => @run @panic("TODO: new settings type: %", (@type p[]).typename().str());
                    };
                };
            };
        };
        
    };
    
    walk_settings_fields :: fn(c: *Circuit, $X: FuncId #duplicated) void = {
        X("name", c.name&);
        X("default_ticks_per_frame", c.default_tick_rate&);
        X("max_x", c.max.x&);
        X("max_y", c.max.y&);
        X("min_x", c.min.x&);
        X("min_y", c.min.y&);
        // TODO: but if you set it wrong i crash about the pins so can't let you just fuck around
        // X("is_arch", c.is_arch&);
    };
    
    walk_state_settings_fields :: fn(s: *State, $X: FuncId #duplicated) void = {
        X("ticks_per_frame", s.ticks_per_eval&);
        X("adapt_tick_rate", s.adapt_tick_rate&);
        X("new_component_default_bit_width", s.edit.default_word_width&);
        X("show_suggested_components", s.show_suggested_components&);
        // TODO: selected level/circuit/edit_mode but they need to do something on change
    };
};

fn set_edit_mode(state: *State, new_edit_mode: bool) void = {
    e := state.edit&;
    @if(e.enable == new_edit_mode) return();
    @if(state.loader.progress != .Idle) return();
    @if(state.tree.len == 0) return();
    i := state.tree[0].diagram_circuit || return();
    state.end_level();
    
    if e.enable {
        state.stash_undo();
        if state.tree[state.tree.len - 1].diagram_circuit { i |
            c := state.circuit[i]&;
            hover_gate(e, .None, c);
            e.select_gate(.None, c);
        };
    };
    e[] = (enable = !e.enable, dont_reset = e.dont_reset);
    if e.enable {
        state.unstash_undo();
        return();
    };
    
    // recompile when exiting edit mode. 
    // TODO: this leaks arena space forever so eventually need to dump save and reload to reset it
    state.warnings&.clear();
    // forget that loaded it before
    each state.circuit { c |
        if c.compiled.is_some() {
            each c.gates { it |
                it.logical_gate_index = -1;
            };
            each c.wires { it |
                it.logical.id = 0xFFFFFFFF;
            };
        }
    };
    
    load_circuit_index_async(state, i, state.world.tc_file_loader_device);
}

fn new_circuit(state: *State) void = {
    @if(state.loader.progress != .Idle) return();
    a := state.edit.circuit_arena;
    c := a.alloc_uninit(Tc.Circuit, state.circuit.len + 1);
    c.slice(0, state.circuit.len).copy_from(state.circuit);
    c[c.len-1] = (
        id = (id = realtime_ns()),
        name = @afmt(a, "Untitled_%", c.len),
        gates = empty(),
        wires = empty(),
        programs = empty(),
        min = vec2(0),
        max = vec2(100),
        dependencies = empty(),
        v2 = false,
        default_tick_rate = 1,
        is_arch = true,
    );
    state.circuit = c;
    state.tree&.clear();
    state.tree&.push(diagram_circuit = (Some = c.len-1));
}

// these are named for the reverse of the action you perform to create one. 
// ex. creating a gate pushes a UndoEntry.DeleteGate
// TODO: at this point, this struct is so big i should just store it as the serialized form all the time. would be less than 160 bytes
UndoEntry :: Tc.Circuit.UndoEntry;

// TODO: visual indicator of which gate you're changing?
fn apply_undo(state: *State, is_undo: bool) void = {
    e := state.edit&;
    // TODO: need to track when you change circuits
    @if(state.tree.len == 0) return();
    c := state.tree[state.tree.len - 1].diagram_circuit || return();
    c := state.circuit[c]&;
    
    // can't be holding on to a gate index while undoing
    e.select_gate(.None, c);
    hover_gate(e, .None, c);
    // TODO: same for placing_wire_start
    
    it := @if(is_undo, e.undo&, e.redo&);
    u := it.pop() || return();
    inverse := perform_action(e, c, u);
    it := @if(is_undo, e.redo&, e.undo&);
    it.push(inverse, e.circuit_arena);
}

// TODO: now that i always need to re-copy out of the fields, should just be immutable Str not a rawlist (would save one direction of copy)
fn perform_action(e: *EditState, c: *Circuit, u: UndoEntry) UndoEntry = {
    @match(u&) {
        fn SetGateField(it) => {
            g := c.gates[it.i]&;
            shape := get_builtin_shape(g.kind);
            f := shape.fields.index(it.field);
            old := get_field_string(e, c, g, f).shallow_copy(e.circuit_arena);
            set_field_string(e, c, g, f, it.value);
            (SetGateField = (i = it.i, field = it.field, value = old))
        }
        fn SetGatePosition(it) => {
            g := c.gates[it.i]&;
            p, r := (g.pos, g.rotation);
            g.pos = it.pos;
            g.rotation = it.rotation;
            (SetGatePosition = (i = it.i, pos = p, rotation = r))
        }
        fn DeleteGate(it) => {
            g := c.gates[it.i]&;
            gate := g[];
            g.kind.id = trunc(component_offset(.Tc1) + GateName(.Tc1)._0.raw().zext());
            g.pos = vec2(-10000);
            (UndeleteGate = (i = it.i, gate = gate))
        }
        fn UndeleteGate(it) => {
            c.gates[it.i] = it.gate;
            (DeleteGate = (i = it.i))
        }
        fn UndeleteWire(it) => {
            c.wires[it.i] = it.wire;
            (DeleteWire = (i = it.i))
        }
        fn DeleteWire(it) => {
            wire := c.wires[it.i];
            c.wires[it.i].path.len = 0;
            (UndeleteWire = (i = it.i, wire = wire))
        }
    }
}

fn stash_undo(state: *State) void = {
    c, e := (state.current_diagram() || return(), state.edit&);
    @if(!e.enable) return();
    t := c.undo; c.undo = e.undo; e.undo = t;
    t := c.redo; c.redo = e.redo; e.redo = t;
}

fn unstash_undo(state: *State) void = {
    state.stash_undo();
}

fn branch_redo(e: *EditState) void = {
    @if(!e.enable) return();
    // TODO: save it so can do non-linear and never delete anything
    e.redo&.clear();
    
}

