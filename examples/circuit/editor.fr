max_gate_text_fields :: 4;
reserved_buffers :: 1;

fn text_box_consumes_event(e: *EditState, event: *Sapp.Event) bool = {
    @if(!e.enable && e.show_info_box.is_none()) return(false);
    @if(event.key_code == .ESCAPE) return(false);  // i want it for closing the field
    
    t := e.text_box&;
    if event.type == .MOUSE_DOWN && event.mouse_button != .MIDDLE {
        Terminal'push_state(t) {
            e.active_buffer_index = .None;
            each(t.buffers, fn(buf) => { buf.active = false; });
            done := false;
            pos: Terminal.Pos = (x = event.mouse_x.cast(), y = event.mouse_y.cast());
            enumerate t.buffers& { i, buf |
                if buf.at.contains(pos) {
                I := reserved_buffers;
                ok := false 
                || (i < I && e.show_info_box.is_some())
                || (i >= I && i - I < e.field_names.len && e.field_names[i - I] != "" && e.show_info_box.is_none())
                ;
                
                if !done && ok {
                    t.selected_buffer = i;
                    done = true;
                    buf.active = true;
                    e.active_buffer_index = (Some = t.selected_buffer);
                };
                };
            };
            if e.active_buffer_index.is_none() {
                t.dirty = true;
            };
        };
    };
    if e.active_buffer_index { i |
        @if(i == 0 && !e.info_box_is_settings, t.features&.unset(.Edit), t.features&.set(.Edit));  // TODO: have features per buffer?
        on_event(t, t.app, event);
        return true;
    };
    false
}

// TODO: pass in the sdtx so can use the same one (silly to compile the shader twice)
fn put_text_boxes(e: *EditState) void = {
    t := e.text_box&;
    @if(!e.enable && e.show_info_box.is_none()) return();
    sdtx := t.text.default_context&;
    Terminal'push_state(t) {
        I := reserved_buffers;
        enumerate t.buffers& { i, b |
            if i >= I {
                name := @if(e.field_names.len > i-I, e.field_names[i-I], "");
                if name != "" {
                    sdtx.set_layer(i);
                    with(b.line_lock&, => draw_text(b[]));
                    sdtx.set_layer(i + t.buffers.len);
                    sdtx.pos = vec2(0.5 + cast((b.at.pos.x + b.at.w) / t.scale), sdtx.pos.y - 1);
                    sdtx.put(name);
                };
            } else {
                if e.show_info_box { _ |
                    sdtx.set_layer(i);
                    with(b.line_lock&, => draw_text(b[]));
                };
            };
        };
    };
}

fn draw_text_boxes(e: *EditState, sg: *Sg.Self, frame_size: Vec2) void = {
    t := e.text_box&;
    sdtx := t.text.default_context&;
    @if(!e.enable && e.show_info_box.is_none()) return();
        I := reserved_buffers;
        range(I, t.buffers.len) { i |
            sdtx.draw_layer(i + t.buffers.len);
        };
        
        enumerate t.buffers& { i, b |
            r := b.at;
            sg.apply_scissor_rect(r.pos.x.cast(), r.pos.y.cast(), r.w.cast(), r.h.cast(), true);
            sdtx.draw_layer(i);
        };
    sg.apply_scissor_rect(@as(f32) 0, 0, frame_size.x, frame_size.y, true);
}

fn hover_gate(e: *EditState, i: ?i64, c: *Circuit) void = {
    t := e.text_box&;
    @if((e.hovered_gate || -1) == (i || -1)) return();
    @if(!e.enable) return();
    
    e.field_names.set_zeroed();
    if e.field_names.len == 0 {
        e.field_names = e.circuit_arena.alloc_zeroed(Str, max_gate_text_fields);
    };
    
    I := reserved_buffers;
    @if(e.has_text_field) if e.hovered_gate { old_i |
        g := c.gates[old_i]&;
        
        out := @ref u8.list(temp());
        shape := get_builtin_shape(g.kind);
        a := e.circuit_arena;
        enumerate shape.fields { i, field |
            continue :: local_return;
            out.clear(); get_string(t.buffers[i+I], out); text := out.items();
            
            old := get_field_string(e, c, g, field);
            @if(old == text) continue();
            e.push_undo(SetGateField = (i = old_i, field = i, value = old.shallow_copy(a)));
            set_field_string(e, c, g, field, text);
        };
    };

    for t.buffers { buf |
        buf.clear_text();
    };
    
    e.hovered_gate = i;
    e.has_text_field = false;
    i := i || return();
    g := c.gates[i]&;
    shape := get_builtin_shape(g.kind);
    enumerate shape.fields { i, field |
        e.field_names[i] = field.name;
        buf := t.buffers[i+I];
        buf.append_string(get_field_string(e, c, g, field));
    };
    e.has_text_field = shape.fields.len > 0;
}

// TODO: warning if it didn't parse
// TODO: bounds (width <= 64, endian 0/1, abs(shift) < 64). especially because bit_fields.set will debug assert
fn set_field_string(e: *EditState, c: *Circuit, g: *Circuit.Gate, field: *Tc.Builtin.EditField, text: Str) void = {
    @if(field.data_string) { g.data&.clear(); g.data&.push_all(text, e.circuit_arena); };
    @if(field.label_string) { g.label&.clear(); g.label&.push_all(text, e.circuit_arena); };
    if field.setting { settings_index |
        if settings_index >= g.settings.len {
            s := e.circuit_arena.alloc_zeroed(i64, settings_index+1);
            s.slice(0, g.settings.len).copy_from(g.settings);
            g.settings = s;
        };
        @if_let(Tc'Asm'constant_eval_expression(text)) fn Ok(value) => {
            g.settings&[settings_index] = value;
        };
        @if(field.allow_auto) if text == "auto" || g.settings&[settings_index] < 0 {
            g.settings&[settings_index] = MIN_i64;
        };
    };
    
    if field.is_link_label {
        g.watched.set_zeroed();
        @if(text != "") if c.gates.find(fn(it) => it.label.items() == text) { target |
            if target.link_id == 0 || target.link_id == -1 {
                target.link_id = realtime_ns();
            };
            w := e.circuit_arena.alloc_zeroed(Circuit.Watched, 1);
            g.watched = w;
            w[0].id = target.link_id;
        };
    };
}

fn get_field_string(e: *EditState, c: *Circuit, g: *Circuit.Gate, field: *Tc.Builtin.EditField) Str = {
        @if(field.label_string) return(g.label.items());
        @if(g.data.len == 0 || !field.data_string) if field.setting { settings_index |
            n := @if(settings_index < g.settings.len, g.settings&[settings_index], 0);
            if field.allow_auto && n == MIN_i64 {
                return "auto";
            } else {
                return @tfmt("%", n);
            };
        };
        @if(field.data_string) return(g.data.items()); 
        
        if field.is_link_label && g.watched.len > 0 && g.watched[0].id != 0 {
            if c.gates.find(fn(it) => it.link_id == g.watched[0].id) { target |
                if target.label.items() == "" {
                    target.label&.push_all(@tfmt("%", g.watched[0].id), e.circuit_arena);
                };
                return(target.label.items());
            };
        };
    
    ""
}

// TODO: split apart the select from the execute. a) key binds can call the same code. b) dont have to have_logic=false, can delay until the end of the frame without dealing with font size changing
fn text_box_selection(self: *Draw) bool = {
    state := self.state;
    e, sapp := (state.edit&, state.sapp);
    idle := state.loader.progress != .Loading;
    Action :: @tagged(Show: Str, Toggle: *bool, Settings, EditMode, LevelMap, NewCircuit, ThisCircuit, AllCircuits, None, Fetch, Reset);
    no_sim := e.enable || !idle;
    // TODO: make more of these work while compiling (be able to cancel). (and while loading, be able to queue)
    names := @slice(@as(Ty(Str, Action))
        ("Component Docs", (Show = include_bytes("examples/circuit/docs.md"))),
        ("Level Instructions", (Show = state.level.description)), 
        ("Settings", @if(idle, .Settings, .None)), 
        ("Edit Mode", @if(idle, .EditMode, .None)),
        ("Run", @if(no_sim, .None, (Toggle = state.auto_eval&))),
        ("Step", @if(no_sim, .None, (Toggle = state.want_eval&))),
        ("Undo Tree", @if(e.enable, (Toggle = e.show_undo_tree&), .None)),
        ("Reset", @if(no_sim, .None, .Reset)),
        ("Level Map", @if(idle && !e.enable, .LevelMap, .None)),
        ("New Circuit", @if(idle, .NewCircuit, .None)),
        ("Warnings", @if(no_sim, .None, (Show = state.warnings.items()))), 
        ("Export One", @if(!idle, .None, .ThisCircuit)),
        ("Export All", @if(!idle, .None, .AllCircuits)),
        ("Circuit Code", @if(no_sim, .None, (Show = state.current_jitted_source))), 
        ("Level Code", (Show = state.level.quine)), 
        ("Credits", (Show = credits)), 
        ("Fetch Examples", @if(idle && !e.enable, .Fetch, .None)),
    );
    prev := e.show_info_box;
    if state.clicked || state.either_clicked {
        e.show_info_box = .None;
    };
    range(0, names.len) { i |
        pos := vec2(-23, (2 - i.float().cast()));
        name, action := names[i];
        if !action&.is(.None) && (!action&.is(.Show) || action.Show.len > 0) {
            active := false 
            || (action&.is(.Toggle) && action.Toggle[])
            || (action&.is(.EditMode) && e.enable)
            || (action&.is(.Fetch) && state.looking_at_examples)
            || (action&.is(.LevelMap) && state.current_diagram().is_some() && state.current_diagram().unwrap()[].is_level_map)
            || ((e.show_info_box || -1) == i);
            self.do_option(pos, name, active, i, e.show_info_box&);
        };
    };
    if ((prev || -1) != (e.show_info_box || -1)) {
        state.dirty = true;
        t := e.text_box&;
        buf := t.buffers[0];
        @if(e.info_box_is_settings&.take()) do_settings(state, buf, false);
        buf.clear_text();
        e.active_buffer_index = .None;
        each(t.buffers, fn(buf) => { buf.active = false; });
        if e.show_info_box { i |
            action := names[i]._1&;
            @match(action) {
            fn NewCircuit() => {
                state.set_edit_mode(true);
                state.prepare_async();
                state.new_circuit();
            };
            fn Toggle(it) => {
                it[][] = !it[][];
            };
            fn EditMode() => {
                state.set_edit_mode(!e.enable);
            };
            fn LevelMap() => {
                if state.looking_at_examples&.take() {
                    state.load_path_async(circuit_save_path, false);
                } else { 
                // TODO: track which circuit you clicked a level gate in to get here so can have multiple and go back to the right one
                if state.circuit.index_of(fn(it) => it.is_level_map) { i |
                    // TODO: but this does load async to recompile: state.set_edit_mode(false);
                    state.end_level();
                    state.level_index = 0;
                    state.level = state.levels[0].level;
                    load_circuit_index_async(state, i, state.world.tc_file_loader_device);
                };
                };
            };
            fn Fetch() => {
                state.autosave();
                state.looking_at_examples = true;
                state.last_auto_save_time = 0;
                state.download_schematic_archive_before_trying_to_load = true;
                state.load_path_async("Mandelbrot", false);
            }
            fn Settings() => {
                e.info_box_is_settings = true;
                do_settings(state, buf, true);
            }
            fn Show(msg) => buf.append_string(msg[]);
            fn Reset() => {
                state.end_level();
                state.reset();
            }
            @default => ();
            };
            
            if @is(action.tag(), .NewCircuit, .EditMode, .LevelMap, .Fetch, .Toggle, .Reset) {
                e.show_info_box = .None;
                return !@is(action.tag(), .Toggle, .Reset);
            };
            
            e.active_buffer_index = (Some = 0);
            t.lock_to_bottom = false;
            buf.active = true;
            pad := 75.0;
            buf.at = (pos = (x = pad, y = pad), w = sapp.width().float() - pad*2, h = sapp.height().float() - pad*2);
            
            // TODO: i can't copy non-utf8 so need to do the b64 thing 
            if @is(action.tag(), .ThisCircuit, .AllCircuits) {
                state.stash_undo();
                i: ?i64 = @if(action.is(.AllCircuits) || state.tree.len == 0, .None, state.tree[0].diagram_circuit);
                out := state.write_save(i, action.is(.AllCircuits));
                buf.append_string(out);
                state.unstash_undo();
            };
            buf.render = (x = 0, y = 0); 
        };
    };
    false
};

// TODO: warning if it didn't parse (number expressions / boolean other than "true"/"false")
// TODO: bounds (ex. ticks_per_frame is positive, bit_width <=64)
do_settings :: fn(state: *State, buf: *Terminal.TextBuffer, read: bool) void = {
    out := @ref u8.list(temp());
    @if(!read) get_string(buf, out);
    do_settings_raw(state, out, read);
    @if(read) buf.append_string(out.items());
};

do_settings_raw :: fn(state: *State, out: *List(u8), read: bool) void = {
    if read {
        if state.current_diagram() { c |
        @fmt(out, "# circuit settings\n");
        walk_settings_fields c { name, p |
            @fmt(out, "%=%\n", name, p[]);
        };
        };
        @fmt(out, "\n# simulator settings\n");  // :magic
        walk_state_settings_fields state { name, p |
            @fmt(out, "%=%\n", name, p[]);
        };
        @fmt(out, "\n\n# debug info\n");  // :magic
        @fmt(out, "# adapted_ticks_per_frame=%\n", state.ticks_per_eval);
        @fmt(out, "# arenas: circuit(used=%kb, allocated=%kb) simulation(allocated=%kb) ", state.circuit_arena&.current_used_size()/1024, state.circuit_arena&.current_allocated_size()/1024, state.world.buf.cap*8/1024);
        if state.loader.fr.it { fr, m |
            arena := fr.data.cast()[][].ast_alloc;
            @fmt(out, "compile(used=%kb, allocated=%kb) jit(allocated=%kb+%kb) ", arena.current_used_size()/1024, arena.current_allocated_size()/1024, m.segment_allocation.len/1024, m.forever_storage&.current_allocated_size()/1024);
        };
        @fmt(out, "\n");
        @if(state.last_auto_save_time != 0) @fmt(out, "# circuits saved % ago\n", format_seconds((realtime_ns() - state.last_auto_save_time) / NS_PER_S));
        @fmt(out, "# current_level=%\n", state.level.title);
    } else {
        state.dirty = true;
        lines := out.items().split("\n", temp());
        if state.current_diagram() { c |
        walk_settings_fields c { name, p |
            WRITE(name, p);
        };
        };
        // TODO: bit silly that these won't save until you win/switchcircuit a level
        walk_state_settings_fields state { name, p |
            WRITE(name, p);
        };
        
        WRITE :: fn(name, p) #duplicated => {
            for lines { it | 
                if it&.pop_prefix(name) && it&.pop_prefix("=") && it.len != 0 {
                    @inline_switch(@type p[]) {
                        @case(f32) => {
                            @if_let(Tc'Asm'constant_eval_expression(it)) fn Ok(value) => {
                                p[] = value.float().cast();
                            };
                        };
                        @case(Str) => if p[] != it {
                            p[] = it.shallow_copy(state.edit.circuit_arena);
                        };
                        @case(i64) => {
                            @if_let(Tc'Asm'constant_eval_expression(it)) fn Ok(value) => {
                                p[] = value;
                            };
                        };
                        @case(bool) => { p[] = it == "true"; };
                        @default => @run @panic("TODO: new settings type: %", (@type p[]).typename().str());
                    };
                };
            };
        };
        
    };
    
    walk_settings_fields :: fn(c: *Circuit, $X: FuncId #duplicated) void = {
        X("name", c.name&);
        X("default_ticks_per_frame", c.default_tick_rate&);
        X("max_x", c.max.x&);
        X("max_y", c.max.y&);
        X("min_x", c.min.x&);
        X("min_y", c.min.y&);
        // TODO: but if you set it wrong i crash about the pins so can't let you just fuck around
        // X("is_arch", c.is_arch&);
    };
    
    walk_state_settings_fields :: fn(s: *State, $X: FuncId #duplicated) void = {
        X("max_ticks_per_frame", s.max_ticks_per_eval&);
        X("new_component_default_bit_width", s.edit.default_word_width&);
        X("show_suggested_components", s.show_suggested_components&);
        X("show_wire_comments", s.show_wire_comments&);
        X("show_logic_trace", s.show_logic_trace&);
        X("circuit_arena_gc_threshold_kb", s.edit.arena_gc_threshold_kb&);
    };
};

fn set_edit_mode(state: *State, new_edit_mode: bool) void = {
    e := state.edit&;
    @if(e.enable == new_edit_mode) return();
    @if(state.tree.len == 0) return();
    i := state.tree[0].diagram_circuit || return();
    
    if e.enable {
        state.ensure_holding_nothing();
        state.autosave();  // TODO: this is a bit excessive since i do it on quit anyway im just afraid of crashes
        state.stash_undo();
    } else {
        @if(state.loader.progress == .Loading) return();
    };
    state.end_level();
    e[] = (enable = !e.enable, dont_reset = e.dont_reset);
    if e.enable {
        state.unstash_undo();
        return();
    };
    
    // recompile when exiting edit mode. 
    // can only simulate at top level for now anyway so going back to tree[0] is fine
    // TODO: resetting max_ticks_per_eval when you toggle edit mode is annoying (in worker_prepare_interp)

    // compile_circuit leaks arena space forever so eventually need to dump save and reload to reset it
    if state.circuit_arena&.current_used_size()/1024 >= e.arena_gc_threshold_kb {
        out := state.write_save(.None, false);
        load_path_async(state, out, true, (Some = i));
        return();
    };
    
    state.warnings&.clear();
    load_circuit_index_async(state, i, state.world.tc_file_loader_device);
}

fn forget_already_compiled(circuits: []Tc.Circuit) void = {
    each circuits { c | 
        if c.compiled.is_some() {
            each c.gates { it |
                it.logical_gate_index = -1;
                it.inline_record = 0xFFFFFFFF;
            };
            each c.wires { it |
                it.logical.id = 0xFFFFFFFF;
            };
        };
        c.compiled = .None;
        c.inlined&.clear();
    };
}

fn new_circuit(state: *State) void = {
    a := state.edit.circuit_arena;
    state.ensure_holding_nothing();
    state.stash_undo();
    c := a.alloc_uninit(Tc.Circuit, state.circuit.len + 1);
    c.slice(0, state.circuit.len).copy_from(state.circuit);
    c[c.len-1] = (
        id = (id = realtime_ns()),
        name = @afmt(a, "Untitled_%", c.len),
        gates = empty(),
        wires = empty(),
        min = vec2(0),
        max = state.level.default_size,
        dependencies = empty(),
        is_arch = true,
    );
    c[c.len-1].undo&.push((transitions = empty(), time = realtime_ns() / NS_PER_S), a);
    state.circuit = c;
    state.tree&.clear();
    state.tree&.push(diagram_circuit = (Some = c.len-1));
    state.unstash_undo();
    default := state.levels[state.level_index].default_circuit&;
    default[] = (Some = c[c.len-1].id);
}

UndoEntry :: Tc.Circuit.UndoEntry;

fn ensure_holding_nothing(state: *State) void = {
    e := state.edit&;
    @if(!e.enable) return();
    c := state.current_diagram() || return();
    e.select_gate(.None, c, false);
    hover_gate(e, .None, c);
    // TODO: same for placing_wire_start
}

// TODO: visual indicator of which gate you're changing?
fn apply_undo(state: *State, is_undo: bool) void = {
    e := state.edit&;
    state.ensure_holding_nothing();
    parent_id := e.current_undo_state_id;
    node := e.undo[parent_id]&;
    i := intcast(node.do&[int(is_undo)]);
    @if(i == -1) return();
    apply_transition(state, i);
}
    
fn apply_transition(state: *State, i: i64) void = {
    e := state.edit&;
    c := state.current_diagram() || return();
    parent_id := e.current_undo_state_id;
    node := e.undo[parent_id]&;
    u := node.transitions[i]&;
    child_id := u.action.child_state_id;
    inverse := perform_action_inner(e, c, u.action.data);
    child := e.undo[child_id]&;
    if i == node.do&[0].intcast() {
        child.do&[1] = child.transitions.len.intcast();
    };
    if i == node.do&[1].intcast() {
        child.do&[0] = child.transitions.len.intcast();
    };
    child.transitions&.push((action = (data = inverse, child_state_id = parent_id)), e.circuit_arena);
    node.transitions&.ordered_remove(i);
    each node.do& { it |
        if it[] == i.intcast() {
            it[] = -1;
        };
        if it[] > i.intcast() {
            it[] -= 1;
        };
    };
    e.current_undo_state_id = child_id;
}

fn push_undo(e: *EditState, data: Circuit.UndoPayload) void = {
    new := atomic_inc(i64, e.next_undo_state_id&);
    e.undo&.push((transitions = empty(), time = realtime_ns() / NS_PER_S), e.circuit_arena);
    node := e.undo[new]&;
    node.do&[1] = node.transitions.len.intcast();
    node.transitions&.push((
        action = (data = data, child_state_id = e.current_undo_state_id),
    ), e.circuit_arena);
    e.current_undo_state_id = new;
}

fn perform_new_action(e: *EditState, c: *Circuit, u: Circuit.UndoPayload) void = {
    new := atomic_inc(i64, e.next_undo_state_id&);
    e.undo&.push((transitions = empty(), time = realtime_ns() / NS_PER_S), e.circuit_arena);
    it: Circuit.UndoEntry = (data = u, child_state_id = new);
    parent_id := e.current_undo_state_id;
    parent_state_id := e.current_undo_state_id;
    inverse := perform_action_inner(e, c, u);
    e.undo[new].do&[1] = e.undo[new].transitions.len.intcast();
    e.undo[new].transitions&.push((action = (data = inverse, child_state_id = parent_id)), e.circuit_arena);
    e.current_undo_state_id = new;
}

fn perform_action(e: *EditState, c: *Circuit, u: UndoEntry) UndoEntry = {
    parent_state_id := e.current_undo_state_id;
    inverse := perform_action_inner(e, c, u.data);
    e.current_undo_state_id = u.child_state_id;
    (data = inverse, child_state_id = parent_state_id)
}

// TODO: now that i always need to re-copy out of the fields, should just be immutable Str not a rawlist (would save one direction of copy)
fn perform_action_inner(e: *EditState, c: *Circuit, u: Circuit.UndoPayload) Circuit.UndoPayload = {
    @match(u) {
        fn SetGateField(it) => {
            g := c.gates[it.i]&;
            shape := get_builtin_shape(g.kind);
            f := shape.fields.index(it.field);
            old := get_field_string(e, c, g, f).shallow_copy(e.circuit_arena);
            set_field_string(e, c, g, f, it.value);
            (SetGateField = (i = it.i, field = it.field, value = old))
        }
        fn SetGatePosition(it) => {
            g := c.gates[it.i]&;
            p, r := (g.pos, g.rotation);
            g.pos = it.pos;
            g.rotation = it.rotation;
            (SetGatePosition = (i = it.i, pos = p, rotation = r))
        }
        fn CopyGate(it) => {
            g := c.gates[it.i];
            a := e.circuit_arena;
            g.watched = g.watched.shallow_copy(a);
            g.data = g.data.items().shallow_copy(a).as_raw_list();
            g.label = g.label.items().shallow_copy(a).as_raw_list();
            g.settings = g.settings.shallow_copy(a);
            c.gates[it.dest] = g;
            // TODO: copy entries in .programs
            (DeleteGate = (i = it.dest, inverse_is_copy_of = it.i))
        }
        fn DeleteGate(it) => {
            g := c.gates[it.i]&;
            gate := g[];
            g.kind.id = trunc(component_offset(.Tc1) + GateName(.Tc1)._0.raw().zext());
            g.pos = vec2(-10000);
            @if(it.inverse_is_copy_of != -1, 
                (CopyGate = (i = it.inverse_is_copy_of, dest = it.i)), 
                (UndeleteGate = (i = it.i, gate = gate)))
        }
        fn UndeleteGate(it) => {
            c.gates[it.i] = it.gate;
            (DeleteGate = (i = it.i))
        }
        fn UndeleteWire(it) => {
            c.wires[it.i] = it.wire;
            (DeleteWire = (i = it.i))
        }
        fn DeleteWire(it) => {
            wire := c.wires[it.i];
            c.wires[it.i].path.len = 0;
            (UndeleteWire = (i = it.i, wire = wire))
        }
    }
}

fn stash_undo(state: *State) void = {
    c, e := (state.current_diagram() || return(), state.edit&);
    @if(!e.enable) return();
    t := c.undo; c.undo = e.undo; e.undo = t;
    t := c.next_undo_state_id; c.next_undo_state_id = e.next_undo_state_id; e.next_undo_state_id = t;
    t := c.current_undo_state_id; c.current_undo_state_id = e.current_undo_state_id; e.current_undo_state_id = t;
}

fn unstash_undo(state: *State) void = {
    state.stash_undo();
}

fn write_save(state: *State, i: ?i64, spec: bool) []u8 = {
    out := @ref u8.list(temp());
    Save'write_save(state.circuit, state.world.tc_file_loader_device, i, out, spec);
    out.items()
}

circuit_save_path :: "target/circuit.txt";
progress_save_path :: "target/circuitprogress.data";
fn save_progress(state: *State) void = {
    settings := {
        out := @ref u8.list(temp());
        do_settings_raw(state, out, true);
        out := out.items();
        // HACK
        while => out.len > 0 && !out.starts_with("# simulator settings") {  // :magic
            out = out.rest(1);
        };
        while => out.len > 0 && !out.ends_with("# debug info") {  // :magic
            out.len -= 1;
        };
        out
    };
    out := @ref u8.list(temp());
    Save'write_progress(out, state.levels.items(), settings);
    state.save_gracefully(progress_save_path, out.items());
}

fn autosave(state: *State) void = {
    @if(state.looking_at_examples || state.loader.progress == .Loading) return();
    state.stash_undo();
    out := state.write_save(.None, true);
    state.save_gracefully(circuit_save_path, out);
    state.unstash_undo();
    state.last_auto_save_time = realtime_ns();
}

fn save_gracefully(state: *State, path: Str, data: Str) void = {
    @if(write_entire_file(path, data)) return();
    _ := make_dirs(path.pop_path_segment());
    @if(write_entire_file(path, data)) return();
    if state.loader.progress != .Loading {
        @fmt(state.warnings&, "failed to write file: %", path);
    };
}

// TODO: do i want to do something like this for the sandbox examples too?
build_level_map :: fn(levels: []*LevelApi.Exports, indices: []i64, c: *Tc.Circuit, arena: Alloc) void = {
    gates := @ref Tc.Circuit.Gate.list(arena);
    wires := @ref Tc.Circuit.Wire.list(arena);
    level_gate, on, probe := (get_component_by_name("Level_gate", builtin_components), get_component_by_name("On_v2", builtin_components), get_component_by_name("Probe_wire_bit", builtin_components));
    min_pos := vec2(0);
    names := @const_slice("Tutorial", "Clockwork Devices", "Basic Foundations");
    make_wire :: fn(a, b) => wires.push(path = (@slice(@as(Tc.Circuit.WireNode) (pos = a), (pos = b)) arena).as_raw_list());
    range(0, indices.len - 1) { y |
        start, end := (indices[y], indices[y+1]);
        Y := y.float().cast()*-16;
        if y == indices.len - 2 {
            make_wire(vec2(-18, Y-7), vec2(2, Y-7));
            wires[wires.len-1].comment = "click a yellow square to open a level";
            make_wire(vec2(-18, Y-8), vec2(2, Y-8));
            wires[wires.len-1].comment = "scroll to zoom";
        };
        w := vec2(2, Y+4);
        gates.push(pos = w, kind = on, rotation = 2);
        make_wire(w+vec2(-1,0), w + vec2(-2,0));
        width := (end - start).float().cast() * -8;
        make_wire(vec2(width+8-4, Y-5), vec2(0+4, Y-5));
        wires[wires.len-1].comment = names[names.len-1-y];
        range(0, end - start) { x |
            name := levels[start + x].title;
            pos := vec2(x.float().cast()*-8, Y);
            gates.push(pos = pos, kind = level_gate, rotation = 3);
            g := gates[gates.len - 1]&;
            g.label&.push_all(name, arena);
            make_wire(pos + vec2(4, 5), pos + vec2(-4, 5));
            wires[wires.len-1].comment = name;
            a, b := (g.pos + vec2(0, -4), g.pos + vec2(-8, 4));
            if x != end - start - 1 {
                make_wire(a, b);
                min_pos = min(g.pos, min_pos);
            };
        };
        w := vec2(width + 5, Y -4);
        gates.push(pos = w, kind = probe, rotation = 2);
        make_wire(w+ vec2(3,0), w + vec2(2,0));
    };
    c[] = (
        id = (id = 1234567),
        wires = wires.as_raw(),
        gates = gates.as_raw(),
        min = min_pos - vec2(12, 8),
        max = vec2(4, 8),
        dependencies = empty(),
        name = "Level Map",
        is_level_map = true, is_synthetic_level_map = true, is_arch = true,
    );
    c.undo&.push((transitions = empty(), time = realtime_ns() / NS_PER_S), arena);
};

format_seconds :: fn(s0: i64) Str = {
    m0, s1 := s0.div_mod(60);
    h0, m1 := m0.div_mod(60);
    d0, h1 := h0.div_mod(24);
    @tfmt("%d%h%m%s", d0, h1, m1, s1)
};

