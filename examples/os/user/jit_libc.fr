// when dlsym->temporary_libc_import is called for a symbol not in libc_exports, 
// try to compile it from source. so don't need to include as much in the initial user binary. 
// TODO: move more functions here (anything that doesn't call vfs internals)
// TODO: several of the float things are one instruction on arm: floor/ceil/round/trunc/fma
//       i don't have an assembler so can't use musl's arch specific versions of those 
//       but i could just type the bits in as an AsmFunction here instead of getting them from musl. 

// TODO: use `name` to not jit everything if you just want one thing? 
//       but it's faster to do one compile than many if you do end up wanting more. 
// TODO: general_allocator being the one from whoever called dlsym is a bit sketchy
find_symbol :: fn(libc_exports: *RawHashMap(Str, rawptr), name: Str) ?rawptr = {
    // TODO: __franca_aot_debug_info getting here is annoying :( (why does it? ex. when runing examples/prospero.fr (in import_wasm if that matters))
    @if(name.starts_with("__franca")) return(.None);
    @if(!functions.contains(name)) return(.None);  // :SLOW
    
    first :: @static_mut true;
    @if(!first[]) return(.None);
    first[] = false;
    
    // (in web and import_wasm, can use js_fetch to get the dep. in vzf it will only be there if target dir is shared. anything else can't use deps at all)
    // TODO: be able to check if the musl dep is there without pasting the hash again
    if query_current_arch() != .wasm32 && !file_exists("target/franca/fetch/a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4.out") {
        @trace("error: not built with 'examples/os/build.fr -share -lm' so can't jit(%)", name);
        return(.None);
    };
    
    @trace("jit_libc/find_symbol(initial = %)", name);
    
    if query_current_arch() != .wasm32 {
        // going to insert. can't free static memory. 
        libc_exports.arr = libc_exports.arr.shallow_copy(general_allocator());
    };
    
    // TODO: on wasm this is sad because it pulls in a bit of the temporary shell thing that isn't used otherwise. 
    push_tls_value(.comptime, zeroed(rawptr)) {
        decode_and_run_cmd(@source_file_name());
    };
    
    m := @static_mut Qbe.Module.zeroed(); 
    Qbe'backend'init_module(m, (
        type = .JitOnly, os = query_current_os(), arch = query_current_arch(), 
    ));
    H :: *Qbe.Incremental.Header;
    ::Result(H, Str);
    src := read_entire_file_or_crash(temp(), ir_output_path);
    h: H = check(src).unwrap();
    Qbe'backend'load_all(h, m);
    m.Qbe'backend'compile_suspended();
    
    // :SLOW
    // TODO: dont mangle the names. exportwithnames doesnt work for import_c-ed things?
    // notabley before fill_from_libc so self references work
    for(h, h.all(Qbe.Incremental.Sym)) { _, it |
        check := h.get(it.name);
        @if(it.segment == .Code)
        for functions { real_name |
            if check.starts_with(real_name) && check.rest(real_name.len()).starts_with("__") {
                lnk := Qbe.Lnk.zeroed();
                lnk.id = m.intern(real_name);
                declare_alias(m, m.intern(check), lnk&);
            };
        };
    };
    
    m.Qbe'fill_from_libc();
    m.make_exec();
    // mem::forget(m);
    
    for functions { name |
        if !name.starts_with("__") {
            f := m.get_addr(name) 
                || @panic("couldn't find %", name);
            libc_exports.insert(name, f, general_allocator());
        };
    };
    
    libc_exports.get(name)
}

// doing this indirection means import_c doesn't need to be compiled into the init user binary. 
// decode_and_run_cmd drops the compiler at the end so that's why making an ir module instead of just jit. 
ir_output_path :: "target/franca/jit_libc.frc";

main :: fn() void = @run {
    c := current_compiler_context();
    fns := temp().alloc_init(FuncId, functions.len(), fn(i) => Musl(functions[i]));
    m := @uninitialized Qbe.Module;
    init_default_module_dyn(m&, c.vtable, (
        os = query_current_os(), 
        arch = query_current_arch(), 
        type = .CachedEarly,
    ));
    bytes := c'vtable'emit_qbe_included(Qbe.Module.raw_from_ptr(m&), c&, fns, .ExportWithNames);
    bytes := bytes.concat(temp());
    write_entire_file_or_crash(ir_output_path, bytes);
    c'vtable'drop_qbe_module(Qbe.Module.raw_from_ptr(m&));
}

functions :: @const_slice(
    "floor", "ceil", "fmod", "cos", "sin",
    // TODO: don't make me write out the callgraph :(
    "__cos", "__sin", "__rem_pio2", "__rem_pio2_large", "scalbn",
);

// TODO: cope with needing to discard_static_scope for each musl file. 
//       new module for each function is stupid!!
Musl :: fn(name: Str) FuncId = {
    root := Foreign'musl();
    src := @ref u8.list(temp());
    @fmt(src, includes_src, root, root, root, root, root, root, root, root, root, root);
    @fmt(src, "#include \"math/%.c\"\n", name);
    init_once DoNotClearOnAotBake {
        generate_alltypes_h(root);
    };
    
    S := import("@/examples/import_c/ffi.fr")'include(src.items());
    FuncId.get_constant(S, name.sym())
        || @panic("failed to get symbol from %.c", name)
}

// TODO: don't hardcode arch
includes_src :: """
    #add_include_path "%/src"
    #add_include_path "%/arch/aarch64"
    #add_include_path "%/arch/generic"
    #add_include_path "%/obj/src/internal"
    #add_include_path "%/src/include"
    #add_include_path "%/src/internal"
    #add_include_path "%/include"
    #add_include_path "%/src/internal"
    #add_include_path "%/obj/include"
    #add_include_path "%/include"
""";

#use("@/lib/sys/fs.fr");
Qbe :: import("@/backend/ir.fr");

// i have a religious exemption from running musl/tools/mkalltypes.sed even if this is more shitty code
generate_alltypes_h :: fn(root: Str) void = {
    out_path := @tfmt("%/obj/include/bits/alltypes.h", root);
    @if(file_exists(out_path)) return();
    
    in, out := (@ref u8.list(temp()), @ref u8.list(temp()));
    // TODO: don't hardcode arch
    read_and_push_or_crash(in, @tfmt("%/arch/aarch64/bits/alltypes.h.in", root));
    read_and_push_or_crash(in, @tfmt("%/include/alltypes.h.in", root));
    
    for in.items().split("\n", temp()) { line |
        j := 0;
        while => j < line.len && !line[j].is_ascii_whitespace() {
            j += 1;
        };
        tag := line.slice(0, j);
        name, value := ("", "");
        if line.ends_with(";") {
            if tag == "TYPEDEF" {
                i := line.len - 1;
                while => !line[i].is_ascii_whitespace() {
                    i -= 1;
                };
                name = line.slice(i+1, line.len-1);
                value = line.slice(j, i);
            } else {
                i := j + 1;
                while => !line[i].is_ascii_whitespace() {
                    i += 1;
                };
                name = line.slice(j+1, i);
                value = line.slice(i+1, line.len-1);
            };
        };
        
        kw, macro_kw, ok := @switch(tag) {
            @case("TYPEDEF") => ("typedef", "", true);
            @case("STRUCT") => ("struct", "_struct", true);
            @case("UNION") => ("union", "_union", true);
            @default => ("", "", false);
        };
        if ok {
            @fmt(out, """
                #if defined(__NEED%_%) && !defined(__DEFINED%_%)
                % % %;
                #define __DEFINED%_%
                #endif
            """, macro_kw, name, macro_kw, name, kw, value, name, macro_kw, name);
        } else {
            @fmt(out, "%\n", line);
        };
    };
    make_dirs_or_crash(@tfmt("%/obj/include/bits", root));
    write_entire_file_or_crash(out_path, out.items());
};
