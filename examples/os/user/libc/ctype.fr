
toupper :: fn(c: i32) i32 #static = {
    c := c.intcast();
    intcast(@if(c >= "a".char() && c <= "x".char(), c.bit_xor(0x20), c))
}

isspace :: fn(c: i32) i32 #static = { c := c.intcast(); (c == " ".char()).int().intcast() }
isdigit :: fn(c: i32) i32 #static = { c: u8 = c.intcast().trunc(); c.is_ascii_digit().int().intcast() }
isalnum :: fn(c: i32) i32 #static = { c: u8 = c.intcast().trunc(); (c.is_ascii_digit() || c.is_ascii_alpha()).int().intcast() }
