// TODO: keyboard/mouse input.
//       translate some virtio thing to @/graphics/app.fr/Event. 
//       but sadly i think vzf won't give you a virtio keyboard/mouse, just usb which is a massive pain in the ass. 
// TODO: sane way to make same program work in -vzf-graphics (framebuffer) and web playground (webgpu). 
//       rn you need to have to versions (this one and tests/external/nuklear.fr), same problem for ./doom.fr
//       the easy direction is write a Screen'bind using @/graphics. 

main :: fn() void = {
    fb := Screen'bind() || {
        @eprintln("DeviceFile: failed to bind framebuffer");
        return();
    };
    
    fb_rect := fb.r;

    tex_scratch := u8.raw_from_ptr(temp().alloc_uninit(u8, 512*512).as_ptr());
    context := Nuklear'nk_rawfb_init(u32.raw_from_ptr(fb.buf.ptr), tex_scratch, fb.r.width, fb.r.height, fb.r.width*4,
        (bytesPerPixel = 4, ashift=24,rshift=16,gshift=8,bshift=0, rloss=0,gloss=0,bloss=0,aloss=0));    
    ctx := context.ctx&;
    
    Screen'run_loop(fb) { _0, _1 |
        Nuklear'nk_input_begin(ctx);
        Nuklear'nk_input_end(ctx);
        ctx := bit_cast_unchecked(*Nuklear.nk_context, *Demo.nk_context, ctx);  // HACK
        Demo'examples(ctx, false);
        Nuklear'nk_rawfb_render(context, (r=0,g=0,b=0,a=0), 1);
    };
}

Screen :: import("@/examples/os/bin/test_screen.fr");
Ui :: import("@/graphics/deps/nuklear.fr");
Nuklear :: Ui.Nuklear;
Demo :: import("@/tests/external/nuklear.fr").Demo;

// TODO: annoying that overloads reference these even tho none are actually used
GRAPHICS_TARGET_WEB :: false;
SOKOL_BACKEND :: RenderBackend.NONE;
#use("@/graphics/lib.fr");
