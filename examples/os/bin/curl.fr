
// TODO: spawning for this one function call is super inefficient 
//       but i'd rather the special case be here than in fetch.fr
main :: fn() void = {
    @assert_eq(query_current_arch(), .wasm32);
    
    sha256_hash := "";
    for cli_args() { it |
        it := it.str();
        if it.ends_with(".out") {
            it = it.slice(it.len - 4, it.len);
        };
        if it.len > 64 {
            sha256_hash = it.slice(it.len - 64, it.len);
        };
    };
    for(sha256_hash, fn(c) => @assert(hex_digit(c).is_some(), "expected hash at end of url"));
    
    print(fetch(sha256_hash) || panic("failed js fetch"));
}

fetch :: fn(path: Str) ?[]u8 = { 
    @if(path.len > 64) return(.None);
    dest := temp().alloc_uninit(u8, 64);  // will be mutated if the file is tiny
    dest.slice(0, path.len).copy_from(path);
    dest.rest(path.len).set_bytes("?".ascii());
    path := dest;
    
    js_write :: fn(id: i64, ptr: *u8, len: i64) i64 #weak #import("libc");
    result := js_write(0xBBBB0002, path.ptr, path.len);
    @if(result < 0) return(.None);
    @if(result <= path.len) return(Some = path.slice(0, result));
    dest = temp().alloc_uninit(u8, result);
    dest.slice(0, 64).copy_from(path);
    result := js_write(0xBBBB0002, dest.ptr, dest.len);
    @if(result != dest.len) return(.None);
    (Some = dest)
};

#use("@/lib/sys/process.fr");
