fn EnumMap($Key: Type, $Value: Type) Type = {
    info :: get_type_info_ref(Key);
    :: {
        assert(info.is(.Enum), "EnumMap key must be enum");  // TODO: fmt type 
        assert(info[].Enum.sequential, "for now, EnumMap requires sequential integer values");
    };
    
    Self :: @struct(data: Array(Value, info[].Enum.fields.len));
    
    fn len(self: *Self) i64 = 
        self.data&.len();
    
    fn init(copied: Value) Self = {
        (data = init(copied))
    }
    
    fn insert(self: *Self, key: Key, value: Value) void = {
        self.data&[key.raw().int()] = value;
    }
    
    fn index(self: *Self, key: Key) *Value = {
        self.data&.index(key.raw().int())
    }
    
    fn get(self: *Self, key: Key) Value = {
        self.data&.index(key.raw().int())[]
    }
    
    fn each(self: *Self, $body: @Fn(k: Key, v: *Value) void) void = {
        enumerate self.data& { k, v |
            k := bit_cast_unchecked(i64, Key, k);
            body(k, v);
        };
    }
    
    Self
}

// like EnumMap but also stores the absence of a value 
// so can give api like a hashmap without wasting an 8 byte tag on storing a ?Value.
fn OptionalEnumMap($Key: Type, $Value: Type) Type = {
    Self :: @struct {
        data: EnumMap(Key, Value);
        valid: EnumSet(Key);
    };
    
    fn empty() Self = zeroed(Self);
    fn len(self: *Self) i64 = self.valid&.count_ones();
    
    fn insert(self: *Self, key: Key, value: Value) ?Value = {
        prev := self.data&[key];
        self.data&[key] = value;
        if self.valid&.get_set(key) {
            return(Some = prev);
        };
        .None
    }
    
    fn get(self: *Self, key: Key) ?Value = {
        @if(!self.valid&.get_set(key), .None, (Some = self.data&[key]))
    }
    
    fn each(self: *Self, $body: @Fn(k: Key, v: *Value) void) void = {
        each self.data& { k, v |
            if self.valid&.get(k) {
                body(k, v);
            };
        };
    }
    
    Self
}

fn EnumSet($Key: Type) Type = {
    Self :: @struct(data: import("@/lib/collections/bit_set.fr")'StaticBitSet(Key.enum_count()));
    
    @run {
        info := get_type_info_ref(Key);
        assert(info.is(.Enum), "EnumMap key must be enum");
        assert(info[].Enum.sequential, "for now, EnumSet requires sequential integer values");
    };
    
    fn empty() Self = zeroed(Self);
    fn get(self: *Self, i: Key) bool = self.data&.get(i.raw().int());
    fn set(self: *Self, i: Key) void = self.data&.set(i.raw().int());
    fn get_set(self: *Self, i: Key) bool = self.data&.get_set(i.raw().int());
    fn count_ones(self: *Self) i64 = self.data&.count_ones();
    
    Self
}
